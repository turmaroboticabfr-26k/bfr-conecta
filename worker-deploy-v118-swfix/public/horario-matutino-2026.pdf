    const occurrenceModal = document.getElementById('occurrenceModal');
     document.getElementById('occurrenceBtn').addEventListener('click', () => { if (parentView?.querySelector('#ocorrenciasPanel')?.dataset.occurrenceId) occurrenceModal.classList.remove('hidden'); });
     document.getElementById('closeOccurrence').addEventListener('click', () => occurrenceModal.classList.add('hidden'));
     occurrenceModal.addEventListener('click', event => { if (event.target === occurrenceModal) occurrenceModal.classList.add('hidden'); });
     document.getElementById('ackOccurrence').addEventListener('click', async event => {
       const panel = parentView?.querySelector('#ocorrenciasPanel');
       const occurrenceId = panel?.dataset.occurrenceId;
       if (!occurrenceId || !supabaseClient || !currentUser) return;
       event.currentTarget.disabled = true;
        const { error } = await supabaseClient.rpc('acknowledge_occurrence', { target_occurrence: occurrenceId });
       if (error) { event.currentTarget.disabled = false; return; }
       event.currentTarget.classList.add('hidden');
       document.getElementById('occurrenceAck').classList.remove('hidden');
       panel.querySelector('.occurrence-status').textContent = 'lida';
       panel.querySelector('.occurrence-status').style.color = '#16826f';
       panel.querySelector('.occurrence-status').style.background = '#eaf6ef';
       panel.querySelector('#occurrenceBtn').textContent = 'Ver detalhes da ocorrência →';
       document.querySelector('[data-section="ocorrencias"] .nav-badge')?.classList.add('hidden');
     });
     document.addEventListener('click', async event => {
       const button = event.target.closest('[data-announcement-read], #readAnnouncement');
       if (!button || !button.dataset.announcementRead || !supabaseClient || !currentUser) return;
       button.disabled = true;
       const { error } = await supabaseClient.from('announcement_reads').upsert({ announcement_id:button.dataset.announcementRead, profile_id:currentUser.id }, { onConflict:'announcement_id,profile_id' });
       if (error) { button.disabled = false; button.textContent = 'Não foi possível marcar'; return; }
       button.textContent = '✓ Comunicado lido';
       button.style.color = '#16826f';
       document.querySelector('[data-section="comunicados"] .nav-badge')?.classList.add('hidden');
     });
     document.getElementById('pollForm').addEventListener('submit', async event => {
       event.preventDefault();
       const form = event.currentTarget;
       const result = document.getElementById('pollResult');
       const answer = form.querySelector('input[name="poll"]:checked')?.value;
       if (!answer || !currentUser || !supabaseClient) { result.textContent = 'Entre no portal para responder à enquete.'; result.classList.remove('hidden'); return; }
       result.textContent = 'Salvando resposta...';
       result.classList.remove('hidden');
       const { data:poll, error:pollError } = await supabaseClient.from('school_polls').select('id').eq('slug','family-meeting-theme').eq('active',true).maybeSingle();
       if (pollError || !poll) { result.textContent = 'Esta enquete ainda não foi publicada pela escola.'; return; }
       const { error } = await supabaseClient.from('school_poll_responses').upsert({ poll_id:poll.id, respondent_id:currentUser.id, answer }, { onConflict:'poll_id,respondent_id' });
       if (error) { result.textContent = 'Não foi possível registrar sua resposta. Tente novamente.'; return; }
       form.classList.add('hidden');
       result.textContent = '✓ Obrigada por participar. Sua resposta foi registrada.';
     });
     document.getElementById('teacherMessageForm').addEventListener('submit', async event => {
       event.preventDefault();
       const form = event.currentTarget;
        const studentId = parentDataState.activeStudentId || parentDataState.students[0]?.id;
       const body = form.querySelector('textarea').value.trim();
       const category = { Alimentação:'food', Medicamento:'medicine', 'Recado geral':'general', 'Autorização de passeio':'trip_authorization' }[form.querySelector('select').value] || 'general';
       if (!studentId || !currentUser || !supabaseClient || !body) return;
       const button = form.querySelector('button[type="submit"]');
       button.disabled = true;
       const { error } = await supabaseClient.from('student_messages').insert({ student_id:studentId, sender_id:currentUser.id, recipient_id:null, category, body });
       if (error) { button.disabled = false; document.getElementById('teacherMessageSent').textContent = 'Não foi possível enviar o recado. Tente novamente.'; document.getElementById('teacherMessageSent').classList.remove('hidden'); return; }
       event.currentTarget.classList.add('hidden');
       document.getElementById('teacherMessageSent').textContent = '✓ Recado enviado para a professora da turma';
       document.getElementById('teacherMessageSent').classList.remove('hidden');
     });
       let currentUser = null;
       let currentProfile = null;
       let profileLoadingId = null;
       let authCallbackPending = false;
      const loginScreen = document.getElementById('loginScreen');
      const appShell = document.getElementById('appShell');
      const googleLogin = document.getElementById('googleLogin');
     const authStatus = document.getElementById('authStatus');
     const preferredNameState = { promise:null, skippedUserId:null };
     function normalizePreferredName(value) { return String(value || '').replace(/\s+/g,' ').trim(); }
     function preferredDisplayName(profile = window.BFR_CURRENT_PROFILE || null) {
       const custom = normalizePreferredName(profile?.display_name_custom);
       if (custom) return custom;
       const official = normalizePreferredName(profile?.full_name || window.BFR_CURRENT_USER?.user_metadata?.full_name || window.BFR_CURRENT_USER?.user_metadata?.name || window.BFR_CURRENT_USER?.email?.split('@')[0]);
       return official.split(' ')[0] || 'pessoa';
     }
     function preferredNameError(value) {
       const name = normalizePreferredName(value);
       if (name.length < 2) return 'Digite pelo menos 2 caracteres.';
       if (name.length > 40) return 'Use no máximo 40 caracteres.';
       if (!/[\p{L}]/u.test(name)) return 'Use pelo menos uma letra.';
       return '';
     }
      function syncAccountIdentity() {
        const name = preferredDisplayName(currentProfile);
        document.querySelectorAll('[data-account-display-name]').forEach(element => { element.textContent = name; });
        document.querySelectorAll('.mini-person .avatar.small, .top-actions > .avatar.small').forEach(avatar => { avatar.textContent = currentUserInitials(); });
        document.querySelectorAll('[data-parent-dashboard-greeting]').forEach(element => { element.textContent = `Olá, ${name}!`; });
        document.querySelectorAll('#bfrHomeDock h2').forEach(element => { element.textContent = `Olá, ${name}! 👋`; });
