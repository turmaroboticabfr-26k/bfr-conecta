</style>

<script id="bfr-mobile-a11y">
  (() => {
    const menu = document.getElementById('mobileMoreMenu');
    const buttons = [...document.querySelectorAll('[data-mobile-more],[data-mobile-more-legacy]')];
    if (!menu || !buttons.length) return;
    const close = menu.querySelector('[data-mobile-more-close]');
    buttons.forEach(button => {
      button.setAttribute('aria-controls', 'mobileMoreMenu');
      button.setAttribute('aria-haspopup', 'dialog');
      button.setAttribute('aria-expanded', 'false');
      button.addEventListener('click', () => setTimeout(() => { if (!menu.classList.contains('hidden')) close?.focus(); }, 0));
    });
    const sync = () => {
      const open = !menu.classList.contains('hidden');
      menu.setAttribute('aria-hidden', String(!open));
      buttons.forEach(button => button.setAttribute('aria-expanded', String(open)));
    };
    new MutationObserver(sync).observe(menu, { attributes:true, attributeFilter:['class'] });
    close?.addEventListener('click', () => setTimeout(() => buttons[0]?.focus(), 0));
    sync();
  })();
</script>

<style id="bfr-parent-teachers-v1">
  .bfr-parent-teachers-panel{margin:0 0 18px;border:1px solid #dbe5f0;border-radius:16px;background:#fff;box-shadow:0 8px 24px rgba(23,35,59,.05);padding:18px}
