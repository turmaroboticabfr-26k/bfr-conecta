mas</option></select></div><div class="coordinator-list" data-coordinator-list><div class="coordinator-empty">Carregando lista de chegada...</div></div><p class="publish-status" data-coordinator-status></p></section><section class="panel" data-coordinator-alerts><div class="panel-heading"><div><div class="eyebrow">Portaria · ação necessária</div><h2 style="margin-top:4px">Alertas de entrada</h2></div><span class="occurrence-status">ao vivo</span></div><div class="coordinator-alert-list" data-coordinator-alert-list><div class="coordinator-empty">Nenhum alerta aberto.</div></div></section></div><div class="coordinator-summary"><section class="panel"><div class="panel-heading"><div><div class="eyebrow">Resumo operacional</div><h2 style="margin-top:4px">Visão das turmas</h2></div></div><div class="coordinator-summary-card"><div class="eyebrow">Alunos cadastrados</div><strong id="coordinatorStudentCount">—</strong><span>na lista oficial ativa</span></div><div class="coordinator-summary-card"><div class="eyebrow">Turmas acompanhadas</div><strong id="coordinatorClassCount">—</strong><span>com registro de chegada</span></div><p class="publish-status" data-coordinator-updated>Atualizando...</p></section><section class="panel" style="background:var(--teal-deep);color:#fff"><div class="eyebrow" style="color:#8fc9ba">Fluxo recomendado</div><h2 style="font:600 20px 'Playfair Display',serif;line-height:1.15;margin:8px 0 13px">Portaria registra. A coordenação acompanha.</h2><p style="color:#c0ded6;font-size:10px;line-height:1.5">Cada leitura de QR aparece aqui automaticamente. A lista de frequência oficial continua podendo ser confirmada pela equipe pedagógica.</p><button class="text-button" type="button" data-coordinator-refresh style="color:#fff;margin-top:12px;padding-left:0">Verificar novas entradas →</button></section></div></div>`;
       const publishingMarkup = `<section class="panel" id="publishingPanel"><div class="panel-heading"><div><div class="eyebrow">Comunicação oficial</div><h2 style="margin-top:4px">Publicar para a comunidade</h2></div><span class="paperless-tag">● ADMIN</span></div><p class="agenda-intro">Os textos publicados aqui aparecem para contas aprovadas. Revise antes de salvar.</p><div class="main-grid" style="margin-top:14px"><form id="announcementPublishForm" class="publish-form"><h3>Novo comunicado</h3><label>Título<input name="title" required maxlength="120" placeholder="Ex.: Reunião de responsáveis"></label><label>Mensagem<textarea name="body" required maxlength="2000" placeholder="Escreva o comunicado da escola."></textarea></label><label class="publish-check"><input name="important" type="checkbox"> Marcar como importante</label><button class="primary-button" type="submit">Publicar comunicado</button><p class="publish-status" id="announcementPublishStatus"></p></form><form id="eventPublishForm" class="publish-form"><h3>Novo evento</h3><label>Título<input name="title" required maxlength="120" placeholder="Ex.: Feira de Ciências"></label><label>Data e hora<input name="starts_at" type="datetime-local" required></label><label>Local<input name="location" maxlength="120" placeholder="Ex.: Ginásio"></label><label>Descrição<textarea name="description" maxlength="500" placeholder="Detalhes para as famílias."></textarea></label><button class="primary-button" type="submit">Publicar evento</button><p class="publish-status" id="eventPublishStatus"></p></form></div></section>`;
