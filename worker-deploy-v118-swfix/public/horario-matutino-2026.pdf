            .sidebar > .nav-list:first-of-type:has(.nav-item[data-admin-nav]:not(.hidden), .nav-item[data-coordinator-nav]:not(.hidden), .nav-item[data-monitor-nav]:not(.hidden), .nav-item[data-gate-nav]:not(.hidden)) { grid-template-columns:repeat(6,minmax(0,1fr)); }
            .topbar { height:64px; padding:0 16px; }
