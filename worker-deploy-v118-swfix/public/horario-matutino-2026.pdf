  <script id="bfr-coordination-command">
    (() => {
      const root = () => document.getElementById('coordinatorView');
      const state = { loaded:false, loading:false, errors:[], students:[], classes:[], attendance:[], occurrences:[], activities:[], projects:[], announcements:[] };
      const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
      const db = () => typeof supabaseClient !== 'undefined' ? supabaseClient : null;
       const isoToday = () => typeof schoolTodayIso === 'function' ? schoolTodayIso() : new Intl.DateTimeFormat('en-CA',{timeZone:'America/Maceio',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
       const timeNow = () => typeof schoolClock === 'function' ? schoolClock() : new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Maceio',hour:'2-digit',minute:'2-digit'}).format(new Date());
      const safe = async (label, request) => { try { const result = await request; if (result?.error) state.errors.push(label); return result?.data || []; } catch { state.errors.push(label); return []; } };
      function style() {
        if (document.getElementById('bfr-coordination-command-style')) return;
        const sheet = document.createElement('style'); sheet.id = 'bfr-coordination-command-style';
        sheet.textContent = `#coordinatorView .bfr-coordination-command{display:grid;gap:14px;margin-bottom:18px}.bfr-coordination-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;padding:22px 24px;border-radius:18px;color:#fff;background:linear-gradient(120deg,#10295f,#1769d2 56%,#22a997);box-shadow:0 14px 30px rgba(16,41,95,.16)}.bfr-coordination-hero h2{margin:5px 0;color:#fff;font:700 clamp(24px,3vw,36px) 'Playfair Display',serif}.bfr-coordination-hero p{max-width:690px;margin:0;color:rgba(255,255,255,.84);font-size:11px;line-height:1.5}.bfr-coordination-kicker{color:#ccecff;font:10px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}.bfr-coordination-hero-side{display:flex;align-items:flex-end;flex-direction:column;gap:10px;min-width:145px}.bfr-coordination-clock{color:#fff;font:700 26px 'DM Mono',monospace}.bfr-coordination-sync{color:rgba(255,255,255,.7);font-size:9px;text-align:right}.bfr-coordination-refresh{border:1px solid rgba(255,255,255,.35);border-radius:9px;padding:9px 11px;color:#10295f;background:#fff;font-size:10px;font-weight:800;cursor:pointer}.bfr-coordination-nav{display:flex;gap:7px;overflow:auto;padding:1px 0 4px}.bfr-coordination-nav button{white-space:nowrap;border:1px solid #d9e5f2;border-radius:999px;padding:8px 11px;color:#536681;background:#fff;font-size:10px;font-weight:800;cursor:pointer}.bfr-coordination-nav button:hover{border-color:#80b5f5;color:#1769d2;background:#f3f8ff}.bfr-coordination-metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}.bfr-coordination-metric{min-width:0;padding:12px;border:1px solid #d8e3f1;border-radius:13px;background:#fff}.bfr-coordination-metric span,.bfr-coordination-metric strong,.bfr-coordination-metric small{display:block}.bfr-coordination-metric span{color:#71809a;font-size:9px}.bfr-coordination-metric strong{margin-top:5px;color:#10295f;font:700 23px 'DM Mono',monospace}.bfr-coordination-metric small{min-height:13px;margin-top:3px;color:#94a3b8;font-size:9px;line-height:1.3}.bfr-coordination-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:12px}.bfr-coordination-panel{min-width:0;padding:16px;border:1px solid #d8e3f1;border-radius:14px;background:#fff}.bfr-coordination-panel h3{margin:4px 0;color:#20385d;font-size:16px}.bfr-coordination-panel p{margin:0;color:#71809a;font-size:10px;line-height:1.45}.bfr-coordination-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.bfr-coordination-label{color:#1769d2;font:9px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}.bfr-coordination-list{display:grid;gap:8px;margin-top:12px}.bfr-coordination-item{display:flex;align-items:flex-start;gap:9px;padding:10px;border:1px solid #e4ebf3;border-radius:10px;background:#fbfdff}.bfr-coordination-item i{display:grid;place-items:center;flex:0 0 22px;width:22px;height:22px;border-radius:50%;color:#fff;background:#1769d2;font-style:normal;font-size:11px}.bfr-coordination-item.warning i{background:#d89225}.bfr-coordination-item.danger i{background:#c85b55}.bfr-coordination-item.good i{background:#16826f}.bfr-coordination-item strong{display:block;color:#29436a;font-size:10px}.bfr-coordination-item span{display:block;margin-top:3px;color:#71809a;font-size:9px;line-height:1.4}.bfr-coordination-empty{padding:15px;border:1px dashed #cbd8e8;border-radius:10px;color:#71809a;background:#fbfdff;font-size:10px;line-height:1.5}.bfr-coordination-class-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.bfr-coordination-class{padding:10px;border:1px solid #e1e9f3;border-radius:10px;background:#fbfdff}.bfr-coordination-class strong{display:block;color:#29436a;font-size:11px}.bfr-coordination-class span{display:block;margin-top:4px;color:#71809a;font-size:9px;line-height:1.35}.bfr-coordination-evidence{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.bfr-coordination-evidence article{padding:11px;border-radius:10px;background:#f6f9fd}.bfr-coordination-evidence strong{display:block;color:#29436a;font-size:10px}.bfr-coordination-evidence span{display:block;margin-top:4px;color:#71809a;font-size:9px;line-height:1.35}.bfr-coordination-status{color:#71809a;font-size:9px}.bfr-coordination-status.is-partial{color:#9b6d13}@media(max-width:1100px){.bfr-coordination-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:800px){.bfr-coordination-hero{display:block;padding:18px}.bfr-coordination-hero-side{align-items:flex-start;margin-top:14px}.bfr-coordination-sync{text-align:left}.bfr-coordination-layout{grid-template-columns:1fr}.bfr-coordination-class-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-coordination-evidence{grid-template-columns:1fr 1fr}}@media(max-width:480px){.bfr-coordination-metrics,.bfr-coordination-class-grid,.bfr-coordination-evidence{grid-template-columns:1fr}.bfr-coordination-panel{padding:13px}}`;
         sheet.textContent += `#coordinatorView .coordinator-welcome{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:0;padding:11px 14px;border:1px solid #dfe8f3;border-radius:14px;background:#fff;box-shadow:0 7px 18px rgba(43,67,115,.045)}#coordinatorView .coordinator-welcome h1{margin:0;color:#24446e;font-size:16px}#coordinatorView .coordinator-welcome p{max-width:520px;margin:4px 0 0;color:#7b899c;font-size:10px;line-height:1.35}#coordinatorView .coordinator-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:7px}.bfr-coordination-command .bfr-coordination-metric{box-shadow:0 5px 14px rgba(43,67,115,.035)}.bfr-coordination-command .bfr-coordination-panel{box-shadow:0 7px 18px rgba(43,67,115,.04)}@media(max-width:980px){#coordinatorView .bfr-coordination-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:650px){#coordinatorView .bfr-coordination-hero{display:block;padding:18px}.bfr-coordination-hero-side{align-items:flex-start;margin-top:15px}.bfr-coordination-sync{text-align:left}.bfr-coordination-command .bfr-coordination-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}#coordinatorView .coordinator-welcome{display:block;padding:12px}#coordinatorView .coordinator-actions{justify-content:flex-start;margin-top:10px}}`;
         document.head.appendChild(sheet);
      }
      function commandMarkup() { return `<section class="bfr-coordination-command" data-bfr-coordination-command><div class="bfr-coordination-hero"><div><div class="bfr-coordination-kicker">Coordenação escolar · centro de comando pedagógico</div><h2>Como está a escola hoje?</h2><p>Uma leitura rápida de alunos, turmas, frequência, ocorrências e projetos. Os indicadores abaixo usam somente registros reais da escola.</p></div><div class="bfr-coordination-hero-side"><strong class="bfr-coordination-clock" data-coord-clock>--:--</strong><span class="bfr-coordination-sync" data-coord-sync>Carregando dados...</span><button type="button" class="bfr-coordination-refresh" data-coord-command-refresh>Atualizar dados</button></div></div><nav class="bfr-coordination-nav" aria-label="Atalhos da Coordenação"><button type="button" data-coord-command-target="[data-coordinator-attendance]">Alunos e presença</button><button type="button" data-coord-command-target="#adminStudentDirectoryPanel">Alunos e perfis</button><button type="button" data-coord-command-target="[data-schedule-panel]">Horários</button><button type="button" data-coord-command-target=".coordinator-alert-list">Ocorrências e alertas</button><button type="button" data-coord-command-target="[data-experience-panel]">Projetos e experiências</button></nav><div class="bfr-coordination-metrics" data-coord-metrics></div><div class="bfr-coordination-layout"><section class="bfr-coordination-panel"><div class="bfr-coordination-panel-head"><div><span class="bfr-coordination-label">Atenção da coordenação</span><h3>O que merece acompanhamento</h3></div><span class="bfr-coordination-status" data-coord-data-status></span></div><div class="bfr-coordination-list" data-coord-attention></div></section><section class="bfr-coordination-panel"><div class="bfr-coordination-panel-head"><div><span class="bfr-coordination-label">Hoje na escola</span><h3>Visão do dia</h3></div><span class="bfr-coordination-status" data-coord-today-status></span></div><div class="bfr-coordination-list" data-coord-today></div></section></div><section class="bfr-coordination-panel"><div class="bfr-coordination-panel-head"><div><span class="bfr-coordination-label">Turmas</span><h3>Situação por turma</h3></div><span class="bfr-coordination-status">Sem estimativas</span></div><div class="bfr-coordination-class-grid" data-coord-classes></div></section><section class="bfr-coordination-panel"><div class="bfr-coordination-panel-head"><div><span class="bfr-coordination-label">Acompanhamento pedagógico</span><h3>Registros que já existem no sistema</h3></div><button type="button" class="bfr-coordination-nav-link" data-coord-command-target="#adminStudentDirectoryPanel">Abrir ficha de alunos</button></div><div class="bfr-coordination-evidence" data-coord-evidence></div></section></section>`; }
      function metric(label, value, note) { return `<article class="bfr-coordination-metric"><span>${label}</span><strong>${value == null ? '—' : esc(value)}</strong><small>${esc(note || (value == null ? 'Sem dados registrados' : 'registro real da escola'))}</small></article>`; }
      function classSummary() { return state.classes.map(item => { const students = state.students.filter(student => student.class_id === item.id); const marked = state.attendance.filter(row => students.some(student => student.id === row.student_id)); const absent = marked.filter(row => ['absent','late'].includes(row.status)).length; return { item, students, marked, absent }; }); }
      function render() {
        const panel = root()?.querySelector('[data-bfr-coordination-command]'); if (!panel) return;
         const activeProjects = state.projects.length + state.activities.length || null;
         const attendanceData = state.attendance.length > 0;
         const present = state.attendance.filter(row => ['present','late'].includes(row.status)).length;
         const absent = state.attendance.filter(row => row.status === 'absent').length;
         const openOccurrences = state.occurrences.filter(row => !row.acknowledged_at).length;
         const missingAttendance = state.students.length && attendanceData ? state.students.filter(student => !state.attendance.some(row => row.student_id === student.id)).length : null;
         const attendanceRate = attendanceData ? `${Math.round((present / state.attendance.length) * 100)}%` : null;
        panel.querySelector('[data-coord-clock]').textContent = timeNow();
        panel.querySelector('[data-coord-sync]').textContent = state.loading ? 'Atualizando...' : state.errors.length ? 'Dados parciais · verifique as permissões' : state.loaded ? 'Dados reais · atualizado agora' : 'Aguardando dados...';
        panel.querySelector('[data-coord-sync]').classList.toggle('is-partial', Boolean(state.errors.length));
        panel.querySelector('[data-coord-metrics]').innerHTML = [metric('Alunos ativos',state.students.length || null,state.students.length ? 'cadastro oficial' : null),metric('Turmas',state.classes.length || null,state.classes.length ? 'cadastro oficial' : null),metric('Presença hoje',attendanceRate,attendanceData ? `${present} registro(s) presente(s)` : null),metric('Faltas hoje',attendanceData ? absent : null,attendanceData ? 'frequência lançada hoje' : null),metric('Ocorrências abertas',state.occurrences.length ? openOccurrences : null,state.occurrences.length ? 'sem confirmação de acolhimento' : null),metric('Projetos e atividades',activeProjects,activeProjects ? 'publicados pela escola' : null)].join('');
        const attention = [];
        if (!state.students.length) attention.push(['','Sem dados registrados','A lista de alunos ainda não está disponível para esta conta.', '']);
        if (state.students.length && !attendanceData) attention.push(['!','Frequência de hoje sem registros','Nenhum lançamento de frequência foi encontrado para hoje.', 'warning']);
        if (missingAttendance) attention.push(['!','Alunos sem lançamento de hoje',`${missingAttendance} aluno(s) ainda não possuem registro de frequência hoje.`, 'warning']);
        if (openOccurrences) attention.push(['!','Ocorrências aguardando acompanhamento',`${openOccurrences} registro(s) sem confirmação de acolhimento.`, 'danger']);
        if (!attention.length) attention.push(['✓','Nenhuma pendência calculada','Os dados disponíveis não indicam uma pendência aberta neste momento.', 'good']);
        panel.querySelector('[data-coord-attention]').innerHTML = attention.map(item => `<article class="bfr-coordination-item ${item[3]}"><i>${item[0] || '·'}</i><div><strong>${esc(item[1])}</strong><span>${esc(item[2])}</span></div></article>`).join('');
         const today = [['Agora',timeNow(),'Atualização do painel em tempo real.'],['Frequência',attendanceData ? `${present} presença(s) e ${absent} falta(s)` : 'Sem dados registrados','Registros oficiais lançados para hoje.'],['Ocorrências',state.occurrences.length ? `${state.occurrences.length} ocorrência(s) aberta(s)` : 'Sem dados registrados','Consulte a área de ocorrências quando houver registros.'],['Projetos',activeProjects ? `${activeProjects} item(ns) publicado(s)` : 'Sem dados registrados','Projetos e atividades publicados pela escola.']];
        panel.querySelector('[data-coord-today]').innerHTML = today.map(item => `<article class="bfr-coordination-item"><i>•</i><div><strong>${esc(item[0])} · ${esc(item[1])}</strong><span>${esc(item[2])}</span></div></article>`).join('');
        const summaries = classSummary();
        panel.querySelector('[data-coord-classes]').innerHTML = summaries.length ? summaries.map(({item,students,marked,absent}) => `<article class="bfr-coordination-class"><strong>${esc(item.year)}º ano ${esc(item.class_code)}</strong><span>${students.length} aluno(s) · ${marked.length ? `${marked.length} lançamento(s) hoje` : 'sem frequência hoje'}</span><span>${marked.length ? `${absent} falta(s)/atraso(s)` : 'Sem dados registrados'}</span></article>`).join('') : '<div class="bfr-coordination-empty">Sem dados registrados para turmas.</div>';
         const evidence = [['Frequência',attendanceData ? `${state.attendance.length} lançamento(s) hoje` : 'Sem dados registrados','Fonte: attendance'],['Acompanhamento',state.occurrences.length ? `${state.occurrences.length} ocorrência(s) aberta(s)` : 'Sem dados registrados','Fonte: occurrences'],['Projetos',activeProjects ? `${activeProjects} publicação(ões)` : 'Sem dados registrados','Fonte: projects / school_activities']];
        panel.querySelector('[data-coord-evidence]').innerHTML = evidence.map(item => `<article><strong>${esc(item[0])}</strong><span>${esc(item[1])}</span><span>${esc(item[2])}</span></article>`).join('');
        panel.querySelector('[data-coord-data-status]').textContent = state.errors.length ? 'acesso parcial' : state.loaded ? 'sincronizado' : 'carregando';
        panel.querySelector('[data-coord-today-status]').textContent = `Atualizado às ${timeNow()}`;
      }
      async function load(force = false) {
        if (state.loading || state.loaded && !force) return;
        const client = db(); if (!client || !root()) { state.loaded = true; render(); return; }
        state.loading = true; state.errors = []; render();
        const today = isoToday();
        const [students,classes,attendance,occurrences,activities,projects,announcements] = await Promise.all([
          safe('alunos',client.from('students').select('id,official_name,class_id').eq('active',true).order('official_name')),
          safe('turmas',client.from('classes').select('id,year,class_code').order('year').order('class_code')),
          safe('frequência',client.from('attendance').select('student_id,attendance_date,status').eq('attendance_date',today)),
           safe('ocorrências',client.from('occurrences').select('id,student_id,title,description,occurred_at,acknowledged_at').is('acknowledged_at',null).order('occurred_at',{ascending:false}).limit(30)),
          safe('atividades',client.from('school_activities').select('id,title,subject,description,due_date,published_at').order('published_at',{ascending:false}).limit(30)),
          safe('projetos',client.from('projects').select('id,title,summary,published').eq('published',true).order('title')),
          safe('comunicados',client.from('announcements').select('id,title,body,published_at,important').order('published_at',{ascending:false}).limit(12))
        ]);
        state.students = students; state.classes = classes; state.attendance = attendance; state.occurrences = occurrences; state.activities = activities; state.projects = projects; state.announcements = announcements; state.loaded = true; state.loading = false; render();
      }
      function enhance() {
        const host = root(); if (!host || host.classList.contains('hidden')) return;
        style();
        if (!host.querySelector('[data-bfr-coordination-command]')) { const anchor = host.querySelector('.coordinator-welcome') || host.firstElementChild; if (anchor) anchor.insertAdjacentHTML('beforebegin',commandMarkup()); }
        if (!state.loaded && !state.loading) { render(); load(); } else render();
      }
       document.addEventListener('click', event => { const refresh = event.target.closest('[data-coord-command-refresh]'); if (refresh) { state.loaded = false; load(true); return; } const target = event.target.closest('[data-coord-command-target]'); if (target) { if (target.dataset.coordCommandTarget === '#adminStudentDirectoryPanel') window.bfrPrepareAdminStudentDirectory?.(); const destination = root()?.querySelector(target.dataset.coordCommandTarget); destination?.scrollIntoView({behavior:'smooth',block:'start'}); } });
       window.bfrCoordinationCommand = {enhance,load};
      setInterval(() => { const clock = root()?.querySelector('[data-coord-clock]'); if (clock) clock.textContent = timeNow(); }, 30000);
      setTimeout(enhance,900);
    })();
  </script>
  <script id="bfr-parent-refinement">
    (() => {
      const parent = () => document.getElementById('parentView');
      const secondarySelectors = [
        '#weatherWidget', '.lia-home-card', '#bfrHomeDock', '.growth-hub',
        '[data-bfr-reading-panel]', '[data-bfr-reading-assist-usage]', '[data-bfr-birthdays]',
        '[data-schedule-panel]', '[data-school-activities-panel]', '[data-games-panel]',
        '[data-badge-panel]', '[data-projects-panel]', '[data-experience-panel]',
        '[data-growth-notifications]', '[data-growth-calendar]', '[data-growth-school]',
        '[data-growth-messages]', '[data-growth-documents]', '[data-growth-requests]',
        '[data-growth-profile]', '[data-growth-achievements]'
      ];
      let scheduled = false;
      function injectParentStyles() {
        if (document.getElementById('bfr-parent-refinement-style')) return;
        const style = document.createElement('style');
        style.id = 'bfr-parent-refinement-style';
        style.textContent = `
          #parentView{display:flex;flex-direction:column}
          #parentView>*{order:100}
          #parentView>.welcome{order:10}
          #parentView>.child-card{order:20}
          #parentView>[data-parent-focus-heading]{order:30}
          #parentView>.overview-grid{order:40}
          #parentView>[data-parent-data-status]{order:45}
          #parentView>.main-grid{order:50}
          #parentView>.communication-grid{order:60}
          #parentView>#weatherWidget,#parentView>.lia-home-card,#parentView>#bfrHomeDock,#parentView>.growth-hub,#parentView>[data-bfr-reading-panel],#parentView>[data-bfr-reading-assist-usage],#parentView>[data-bfr-birthdays],#parentView>[data-schedule-panel],#parentView>[data-school-activities-panel],#parentView>[data-games-panel],#parentView>[data-badge-panel],#parentView>[data-projects-panel],#parentView>[data-experience-panel],#parentView>[data-growth-notifications],#parentView>[data-growth-calendar],#parentView>[data-growth-school],#parentView>[data-growth-messages],#parentView>[data-growth-documents],#parentView>[data-growth-requests],#parentView>[data-growth-profile],#parentView>[data-growth-achievements]{order:100}
          #parentView .parent-focus-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 12px;padding:0 2px}
          #parentView .parent-focus-heading h2{margin:4px 0 0;color:#173b79;font:700 20px 'Playfair Display',serif}
          #parentView .parent-focus-heading>span{color:#8290a3;font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.04em}
          #parentView>.child-card{margin-bottom:12px}
          #parentView>.child-card .child-info small{display:block;margin-top:5px;color:#d8f4e9;font:9px 'DM Mono',monospace;letter-spacing:.03em}
          #parentView>.overview-grid{margin-top:0}
          #parentView>.overview-grid .metric-card{min-height:112px;padding:14px}
          #parentView .data-empty-inline,#parentView .roster-empty,#parentView .project-empty{min-height:0;margin:0;padding:10px 12px;border:1px dashed #d6e2ef;border-radius:10px;color:#7b899c;background:#fbfdff;font-size:10px;line-height:1.4}
          #parentView .attendance-chart:has(.data-empty-inline){display:block;height:auto;min-height:0;padding:0;border:0}
          #parentView .notice:has(.data-empty-inline),#parentView .activity-list:has(.data-empty-inline){min-height:0;padding:0}
          #parentView .panel:has(>.data-empty-inline),#parentView .panel:has(.project-list>.data-empty-inline),#parentView .panel:has(.activity-list>.data-empty-inline){min-height:0}
          #parentView>.lia-home-card{margin-top:14px}
          #parentView>.growth-hub,#parentView>#bfrHomeDock{margin-top:14px}
          @media(max-width:700px){#parentView .parent-focus-heading{display:block}#parentView .parent-focus-heading>span{display:block;margin-top:7px}#parentView>.overview-grid .metric-card{min-height:0;padding:12px}#parentView>.child-card .child-info small{color:#187b68}}
        `;
        document.head.appendChild(style);
      }
         function normalizeStaticExtras() {
           const root = parent();
           root?.querySelectorAll('[data-bfr-reading-panel],[data-bfr-reading-assist-usage]').forEach(panel => panel.remove());
           root?.querySelectorAll('[data-bfr-birthdays],[data-games-panel]').forEach(panel => panel.remove());
        const dock = root?.querySelector(':scope > #bfrHomeDock');
        dock?.querySelectorAll('.bfr-platform-card').forEach(card => {
          const title = card.querySelector('h3')?.textContent.trim();
          const copy = card.querySelector('p');
          if (title === 'Agenda' && copy) copy.textContent = 'Consulte os próximos eventos publicados pela escola.';
          if (title === 'Últimos avisos' && copy) copy.textContent = 'Comunicados oficiais aparecerão aqui.';
        });
      }
      function reorder() {
        const view = parent();
        if (!view || view.classList.contains('hidden')) return;
        const welcome = view.querySelector(':scope > .welcome');
        const child = view.querySelector(':scope > .child-card');
        const heading = view.querySelector(':scope > [data-parent-focus-heading]');
        const overview = view.querySelector(':scope > .overview-grid');
        if (welcome && child && welcome.nextElementSibling !== child) welcome.after(child);
        if (child && heading && child.nextElementSibling !== heading) child.after(heading);
        if (heading && overview && heading.nextElementSibling !== overview) heading.after(overview);
        const main = view.querySelector(':scope > .main-grid');
        const communications = view.querySelector(':scope > .communication-grid');
        let cursor = communications || main || overview || heading || child || welcome;
        if (!cursor) return;
        secondarySelectors.forEach(selector => {
          const node = view.querySelector(`:scope > ${selector}`);
           if (!node || node === cursor) return;
           if (cursor.nextElementSibling !== node) cursor.after(node);
           cursor = node;
        });
      }
      function refresh() {
        injectParentStyles();
        normalizeStaticExtras();
        reorder();
      }
      function syncPlatformNavigation() {
        const areaByView = {platformLearnView:'aprender',platformEvolveView:'evoluir',platformSchoolView:'escola',platformSpaceView:'meu-espaco'};
        const visible = document.querySelector('#appShell .content:not(.hidden)[id^="platform"]');
        const area = visible && areaByView[visible.id];
        if (area && typeof persistNavigationState === 'function' && activeSection !== area) persistNavigationState(area);
      }
      function startPlatformNavigationSync() {
        const app = document.getElementById('appShell');
        if (!app || app.dataset.platformNavigationSync) return;
        app.dataset.platformNavigationSync = 'true';
        const observer = new MutationObserver(syncPlatformNavigation);
        observer.observe(app, {subtree:true, attributes:true, attributeFilter:['class']});
        setInterval(syncPlatformNavigation, 500);
        syncPlatformNavigation();
      }
       function start() {
         if (!parent()) return;
         refresh();
         setTimeout(refresh, 2500);
       }
      setTimeout(startPlatformNavigationSync, 0);
      setTimeout(start, 1000);
    })();
  </script>
  <script id="bfr-parent-navigation-v2">
    (() => {
      const areas = {
        aprender: { title:'Aprender', copy:'Atividades, boletim, biblioteca, leitura e projetos em um só lugar.', items:[['Atividades','atividades'],['Notas e frequência','notas'],['Boletim','boletim'],['Biblioteca','biblioteca'],['Leitura','biblioteca'],['Projetos','experiencias']] },
        evoluir: { title:'Evoluir', copy:'Acompanhe o desenvolvimento do aluno sem misturar detalhes com o resumo inicial.', items:[['Acompanhamento','scroll:[data-growth-profile]'],['Conquistas','scroll:[data-growth-achievements]'],['Participação','scroll:[data-experience-panel]'],['Crachá QR','cracha']] },
        escola: { title:'Escola', copy:'Agenda, comunicados, horários e informações oficiais da escola.', items:[['Agenda escolar','agenda'],['Comunicados','comunicados'],['Momentos da turma','mural'],['Horários das turmas','horarios'],['Informações da escola','noticias'],['Alimentação','alimentacao']] },
        'meu-espaco': { title:'Meu Espaço', copy:'Perfil, documentos, solicitações e preferências da família.', items:[['Meu perfil','scroll:[data-growth-profile]'],['Perfil do aluno','scroll:.child-card'],['Documentos','scroll:[data-growth-documents]'],['Solicitações à secretaria','secretaria'],['Preferências','preferences'],['Ajuda e suporte','support'],['Agenda do aluno','agenda-aluno'],['Ocorrências','ocorrencias']] }
      };
      const targets = { notas:'#boletimPanel', agenda:'[data-growth-calendar]', calendario:'[data-growth-calendar]', horarios:'[data-schedule-panel]', cracha:'[data-badge-panel]', mural:'.activity-list', comunicados:'#comunicadosPanel', noticias:'#noticiasPanel', 'agenda-aluno':'#agendaAlunoPanel', experiencias:'[data-experience-panel]', boletim:'#boletimPanel', ocorrencias:'#ocorrenciasPanel' };
      const getParent = () => document.getElementById('parentView');
      const getApp = () => document.getElementById('appShell');
       const isParent = () => { try { return activeView === 'parent' || (getApp()?.classList.contains('ready') && getParent() && !getParent().classList.contains('hidden')); } catch { return false; } };
      const setAreaState = area => { try { window.BFRPlatform.state.lastArea = area; localStorage.setItem(window.BFRPlatform.storageKey, JSON.stringify(window.BFRPlatform.state)); } catch {} };
      const markHidden = node => { if (!node) return; node.classList.add('parent-detail-hidden'); node.dataset.parentDetailHidden = 'true'; };
      const clearHidden = node => { if (!node) return; node.classList.remove('parent-detail-hidden'); delete node.dataset.parentDetailHidden; };
      function clearParentDetails() { getParent()?.querySelectorAll('[data-parent-detail-hidden]').forEach(clearHidden); }
      function parentDetailRoots(view = getParent()) {
        if (!view) return [];
        return [':scope > .main-grid', ':scope > .communication-grid', ':scope > [data-schedule-panel]', ':scope > [data-school-activities-panel]', ':scope > [data-projects-panel]', ':scope > [data-experience-panel]', ':scope > [data-badge-panel]', ':scope > [data-growth-notifications]', ':scope > [data-growth-calendar]', ':scope > [data-growth-school]', ':scope > [data-growth-messages]', ':scope > [data-growth-documents]', ':scope > [data-growth-requests]', ':scope > [data-growth-profile]', ':scope > [data-growth-achievements]'].flatMap(selector => [...view.querySelectorAll(selector)]);
      }
      function hideParentDetails() { clearParentDetails(); parentDetailRoots().forEach(markHidden); }
      function revealParentTarget(target) {
        if (!target) return;
        const container = target.closest('.main-grid,.communication-grid');
        if (!container) { clearHidden(target.closest('.panel') || target); return; }
        clearHidden(container);
        const column = target.closest('.main-grid > div,.communication-grid > div');
        [...container.children].forEach(item => item === column ? clearHidden(item) : markHidden(item));
        if (column) [...column.children].forEach(item => { if (item.classList.contains('panel') && !item.contains(target)) markHidden(item); });
        clearHidden(target.closest('.panel') || target);
      }
      function showParentHome() {
        document.querySelectorAll('#appShell .content').forEach(view => view.classList.add('hidden'));
        const view = getParent();
        if (!view) return;
        view.classList.remove('hidden');
        view.dataset.parentSection = 'inicio';
        hideParentDetails();
        document.querySelectorAll('.bfr-platform-nav-item').forEach(item => item.classList.toggle('active', item.dataset.platformArea === 'inicio'));
        document.querySelector('.breadcrumb b')?.replaceChildren(document.createTextNode('Hoje'));
        setAreaState('inicio');
        try { persistNavigationState('inicio'); } catch {}
      }
       function openParentLegacy(section) {
         if (section === 'inicio') { showParentHome(); return true; }
         if (section === 'support' || section === 'preferences') { document.querySelector(`[data-account-tool="${section}"]`)?.click(); return true; }
         if (section === 'agenda' || section === 'calendario') {
           showParentHome();
           window.BFRParentDashboard?.setHomeMode?.(false);
           const target = getParent()?.querySelector(targets.calendario);
           if (target) { clearHidden(target); target.scrollIntoView({behavior:'smooth',block:'start'}); }
           return true;
         }
        if (section.startsWith('scroll:')) {
          showParentHome();
          const target = getParent()?.querySelector(section.slice(7));
          if (target) { revealParentTarget(target); target.scrollIntoView({behavior:'smooth',block:'start'}); }
          return true;
        }
        if (['biblioteca','atividades','alimentacao'].includes(section)) { hideParentDetails(); if (typeof navigateToSection === 'function') navigateToSection(section); return true; }
        const target = getParent()?.querySelector(targets[section]);
        hideParentDetails();
        if (target) revealParentTarget(target);
        if (typeof navigateToSection === 'function') navigateToSection(section);
        return true;
      }
      function renderParentArea(area) {
        if (!isParent() || !areas[area]) return false;
        const config = areas[area];
        document.querySelectorAll('#appShell .content').forEach(view => view.classList.add('hidden'));
        const host = document.getElementById({aprender:'platformLearnView',evoluir:'platformEvolveView',escola:'platformSchoolView','meu-espaco':'platformSpaceView'}[area]);
        if (!host) return false;
        host.classList.remove('hidden');
        host.innerHTML = `<div class="bfr-platform-view bfr-parent-area-view"><section class="bfr-platform-hero"><div><div class="eyebrow">BFR Conecta · área do responsável</div><h1>${config.title}</h1><p>${config.copy}</p></div><div class="bfr-platform-hero-art" aria-hidden="true">${area === 'aprender' ? '📚' : area === 'evoluir' ? '🏆' : area === 'escola' ? '🏫' : '👤'}</div></section><section class="bfr-platform-panel"><div class="bfr-platform-toolbar"><div><h2>Escolha uma seção</h2><p>Os detalhes continuam usando os registros e permissões da escola.</p></div></div><div class="bfr-parent-area-grid">${config.items.map(item => `<button type="button" class="bfr-platform-button bfr-parent-area-link" data-parent-route="${item[1]}">${item[0]} <span aria-hidden="true">↗</span></button>`).join('')}</div></section></div>`;
        host.dataset.parentAreaRendered = area;
        document.querySelectorAll('.bfr-platform-nav-item').forEach(item => item.classList.toggle('active', item.dataset.platformArea === area));
        document.querySelector('.breadcrumb b')?.replaceChildren(document.createTextNode(config.title));
        setAreaState(area);
        try { persistNavigationState(area); } catch {}
        return true;
      }
       function install() {
         const api = window.BFRPlatform;
         if (!api || api.__bfrParentNavigationV2) return;
         const originalOpen = api.open;
          window.BFRParentNavigationV2 = { openArea: area => isParent() && (area === 'inicio' ? openParentLegacy('inicio') : renderParentArea(area)), openLegacy: section => isParent() && openParentLegacy(section) };
         api.open = area => isParent() && area !== 'inicio' && areas[area] ? renderParentArea(area) : isParent() && area === 'inicio' ? openParentLegacy('inicio') : originalOpen(area);
        api.__bfrParentNavigationV2 = true;
        document.addEventListener('click', event => {
          const link = event.target.closest('[data-parent-route]');
          if (!link || !isParent()) return;
          event.preventDefault();
          openParentLegacy(link.dataset.parentRoute);
        });
         if (!document.getElementById('bfr-parent-navigation-v2-style')) {
           const style = document.createElement('style');
           style.id = 'bfr-parent-navigation-v2-style';
           style.textContent = `.parent-detail-hidden{display:none!important}#appShell.ready[data-parent-nav="true"] .bfr-legacy-label,#appShell.ready[data-parent-nav="true"] .bfr-legacy-nav{display:none!important}.bfr-parent-area-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(138px,1fr));gap:8px;margin-top:16px}.bfr-parent-area-link{display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:9px 11px;border:1px solid #cfe0fb;border-radius:9px;color:#1d4ed8;background:linear-gradient(180deg,#fbfdff,#eff6ff);box-shadow:0 3px 9px rgba(37,99,235,.06);font-size:10px;font-weight:800;line-height:1.2;text-align:left;transition:transform .18s,border-color .18s,background .18s}.bfr-parent-area-link:hover,.bfr-parent-area-link:focus-visible{transform:translateY(-1px);border-color:#93c5fd;background:#e8f1ff}.bfr-parent-area-link span{color:#1769d2;font-size:13px;line-height:1;opacity:.78}@media(max-width:600px){.bfr-parent-area-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.bfr-parent-area-link{min-height:38px;padding:9px 10px;font-size:9px}}`;
           document.head.appendChild(style);
         }
        const shell = getApp();
        const syncMode = () => {
          if (!shell) return;
          const parentMode = isParent();
          shell.dataset.parentNav = parentMode ? 'true' : 'false';
          if (!parentMode) return;
          const area = window.BFRPlatform.state.lastArea;
          if (area && area !== 'inicio' && areas[area]) {
            const host = document.getElementById({aprender:'platformLearnView',evoluir:'platformEvolveView',escola:'platformSchoolView','meu-espaco':'platformSpaceView'}[area]);
            if (!host?.querySelector('.bfr-parent-area-view')) renderParentArea(area);
          } else if (!area || area === 'inicio') hideParentDetails();
        };
        setTimeout(syncMode,900);
        setTimeout(syncMode,3000);
        document.querySelectorAll('[data-role]').forEach(button => button.addEventListener('click', () => setTimeout(syncMode,80)));
      }
      setTimeout(install,0);
    })();
  </script>
  <style id="bfr-parent-dashboard-v3-style">
    #parentView{display:flex;flex-direction:column}
    #parentView>[data-parent-dashboard-v3]{order:1!important}
    #parentView[data-parent-compact-home="true"]> :not([data-parent-dashboard-v3]){display:none!important}
    #parentView[data-parent-compact-home="false"]>[data-parent-dashboard-v3]{display:none!important}
    .bfr-parent-dashboard-v3{display:grid;gap:14px;padding-bottom:28px}
    .bfr-parent-dashboard-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:22px 24px;border:1px solid #d9e6f5;border-radius:18px;color:#fff;background:linear-gradient(120deg,#10295f,#1769d2 58%,#24b7a1);box-shadow:0 14px 30px rgba(16,41,95,.14)}
    .bfr-parent-dashboard-head .eyebrow{color:#ccecff}
    .bfr-parent-dashboard-head h1{margin:5px 0 0;color:#fff;font:700 clamp(25px,3vw,38px) 'Playfair Display',serif;letter-spacing:-.7px}
    .bfr-parent-dashboard-head p{max-width:650px;margin-top:7px;color:rgba(255,255,255,.82);font-size:11px;line-height:1.5}
    .bfr-parent-dashboard-sync{flex:0 0 auto;color:rgba(255,255,255,.78);font:9px 'DM Mono',monospace;text-align:right}
     .bfr-parent-dashboard-student{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:12px 16px;padding:16px 18px;border:1px solid #d8e3f1;border-radius:15px;background:#fff;box-shadow:0 8px 20px rgba(43,67,115,.05)}
    .bfr-parent-dashboard-student-main{display:flex;align-items:center;gap:12px;min-width:0}
    .bfr-parent-dashboard-avatar{display:grid;place-items:center;width:48px;height:48px;flex:0 0 auto;border-radius:15px;color:#fff;background:linear-gradient(145deg,#24b7a1,#1769d2);font-size:14px;font-weight:800}
    .bfr-parent-dashboard-student strong{display:block;overflow:hidden;color:#173b79;font:700 17px 'Playfair Display',serif;text-overflow:ellipsis;white-space:nowrap}
    .bfr-parent-dashboard-student span{display:block;margin-top:3px;color:#71809a;font-size:10px}
     .bfr-parent-dashboard-student select{max-width:230px;border:1px solid #d8e3f1;border-radius:9px;padding:9px 10px;color:#29436a;background:#fff;font-size:10px}
     .bfr-parent-dashboard-student-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}
     .bfr-parent-dashboard-link{border:1px solid #9bc7ef;border-radius:9px;padding:9px 11px;color:#1769d2;background:#eff7ff;font-size:10px;font-weight:800;cursor:pointer}
     .bfr-parent-dashboard-link:hover{border-color:#4f9de8;background:#e1f0ff}
     .bfr-parent-dashboard-status{grid-column:1/-1;margin:0;color:#71809a;font-size:10px}
     .bfr-parent-dashboard-metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
     .bfr-parent-dashboard-metric{min-width:0;padding:13px;border:1px solid #d8e3f1;border-radius:13px;background:#fff;cursor:pointer;transition:transform .18s,border-color .18s,box-shadow .18s}
     .bfr-parent-dashboard-metric:hover,.bfr-parent-dashboard-metric:focus-visible{transform:translateY(-2px);border-color:#90bff0;box-shadow:0 9px 20px rgba(37,99,235,.09);outline:0}
     .bfr-parent-dashboard-metric-head{display:flex;align-items:center;justify-content:space-between;gap:6px}
     .bfr-parent-dashboard-metric span,.bfr-parent-dashboard-metric strong,.bfr-parent-dashboard-metric small{display:block}
     .bfr-parent-dashboard-metric span{color:#71809a;font-size:10px}
     .bfr-parent-dashboard-metric strong{margin-top:7px;color:#10295f;font:700 23px 'DM Mono',monospace}
     .bfr-parent-dashboard-metric small{min-height:14px;margin-top:4px;color:#8a98aa;font-size:9px;line-height:1.35}
     .bfr-parent-dashboard-metric-icon{font-size:16px;opacity:.75}
     .bfr-parent-dashboard-metric.attention strong{color:#bd6b3d}
    .bfr-parent-dashboard-two{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .bfr-parent-dashboard-card{min-width:0;padding:16px;border:1px solid #d8e3f1;border-radius:14px;background:#fff}
    .bfr-parent-dashboard-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .bfr-parent-dashboard-card h2{margin:4px 0 0;color:#173b79;font:700 17px 'Playfair Display',serif}
    .bfr-parent-dashboard-card p{margin-top:9px;color:#71809a;font-size:11px;line-height:1.45}
    .bfr-parent-dashboard-card time{color:#1769d2;font:10px 'DM Mono',monospace}
    .bfr-parent-dashboard-shortcuts{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}
    .bfr-parent-dashboard-shortcut{min-height:64px;padding:10px;border:1px solid #d8e3f1;border-radius:11px;color:#29436a;background:#fff;text-align:left;font-size:10px;font-weight:700}
    .bfr-parent-dashboard-shortcut:hover{border-color:#7eb7ef;color:#1769d2;background:#f4f8ff;transform:translateY(-1px)}
     @media(max-width:1050px){.bfr-parent-dashboard-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}
     @media(max-width:800px){.bfr-parent-dashboard-head{display:block;padding:18px}.bfr-parent-dashboard-sync{display:block;margin-top:13px;text-align:left}.bfr-parent-dashboard-student{grid-template-columns:1fr}.bfr-parent-dashboard-student-actions{justify-content:flex-start}.bfr-parent-dashboard-student select{max-width:none;width:100%}.bfr-parent-dashboard-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-parent-dashboard-two{grid-template-columns:1fr}.bfr-parent-dashboard-shortcuts{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:430px){.bfr-parent-dashboard-metrics{gap:8px}.bfr-parent-dashboard-metric{padding:12px}.bfr-parent-dashboard-metric strong{font-size:21px}.bfr-parent-dashboard-shortcuts{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>
  <script id="bfr-parent-dashboard-v3">
    (() => {
      const root = () => document.getElementById('parentView');
      const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
       const content = { announcements:[], events:[], loaded:false };
       let calendarRequested = false;
       let messagesRequested = false;
       const dashboardMarkup = () => `<section class="bfr-parent-dashboard-v3" data-parent-dashboard-v3>
         <header class="bfr-parent-dashboard-head"><div><div class="eyebrow">Área do Responsável</div><h1 data-parent-dashboard-greeting>Olá, responsável!</h1><p>Acompanhe a vida escolar do seu filho em um só lugar.</p></div><span class="bfr-parent-dashboard-sync" data-parent-dashboard-sync>Carregando dados...</span></header>
         <section class="bfr-parent-dashboard-student"><div class="bfr-parent-dashboard-student-main"><div class="bfr-parent-dashboard-avatar" data-parent-dashboard-avatar>—</div><div><span>Aluno acompanhado</span><strong data-parent-dashboard-student-name>Aluno não vinculado</strong><span data-parent-dashboard-student-class>Aguardando vínculo da escola</span></div></div><div class="bfr-parent-dashboard-student-actions"><select data-parent-dashboard-student-select aria-label="Escolher aluno"><option value="">Nenhum aluno vinculado</option></select><button type="button" class="bfr-parent-dashboard-link" data-parent-dashboard-link-student>Vincular aluno</button></div><p class="bfr-parent-dashboard-status" data-parent-dashboard-status>Para acompanhar notas, frequência, atividades e comunicados, vincule um aluno à sua conta.</p></section>
         <div class="bfr-parent-dashboard-metrics"><article class="bfr-parent-dashboard-metric" role="button" tabindex="0" data-parent-dashboard-route="scroll:#boletimPanel"><div class="bfr-parent-dashboard-metric-head"><span>Desempenho</span><i class="bfr-parent-dashboard-metric-icon">📊</i></div><strong data-parent-dashboard-average>—</strong><small data-parent-dashboard-average-note>Sem notas lançadas</small></article><article class="bfr-parent-dashboard-metric" role="button" tabindex="0" data-parent-dashboard-route="scroll:.attendance-chart"><div class="bfr-parent-dashboard-metric-head"><span>Frequência</span><i class="bfr-parent-dashboard-metric-icon">📅</i></div><strong data-parent-dashboard-attendance>—</strong><small data-parent-dashboard-attendance-note>Sem registros disponíveis</small></article><article class="bfr-parent-dashboard-metric" role="button" tabindex="0" data-parent-dashboard-route="atividades"><div class="bfr-parent-dashboard-metric-head"><span>Atividades</span><i class="bfr-parent-dashboard-metric-icon">📝</i></div><strong data-parent-dashboard-activities>—</strong><small data-parent-dashboard-activities-note>Carregando atividades</small></article><article class="bfr-parent-dashboard-metric" role="button" tabindex="0" data-parent-dashboard-route="comunicados"><div class="bfr-parent-dashboard-metric-head"><span>Avisos</span><i class="bfr-parent-dashboard-metric-icon">📢</i></div><strong data-parent-dashboard-announcements>—</strong><small data-parent-dashboard-announcements-note>Carregando comunicados</small></article><article class="bfr-parent-dashboard-metric" role="button" tabindex="0" data-parent-dashboard-route="scroll:[data-growth-messages]"><div class="bfr-parent-dashboard-metric-head"><span>Mensagens</span><i class="bfr-parent-dashboard-metric-icon">💬</i></div><strong data-parent-dashboard-messages>—</strong><small data-parent-dashboard-messages-note>Carregando comunicação</small></article><article class="bfr-parent-dashboard-metric" role="button" tabindex="0" data-parent-dashboard-route="agenda"><div class="bfr-parent-dashboard-metric-head"><span>Calendário</span><i class="bfr-parent-dashboard-metric-icon">📆</i></div><strong data-parent-dashboard-calendar>—</strong><small data-parent-dashboard-calendar-note>Carregando agenda escolar</small></article><article class="bfr-parent-dashboard-metric attention" role="button" tabindex="0" data-parent-dashboard-route="scroll:[data-growth-notifications]"><div class="bfr-parent-dashboard-metric-head"><span>Atenção</span><i class="bfr-parent-dashboard-metric-icon">!</i></div><strong data-parent-dashboard-attention>—</strong><small data-parent-dashboard-attention-note>Sem registros disponíveis</small></article></div>
         <div class="bfr-parent-dashboard-two"><article class="bfr-parent-dashboard-card"><div class="bfr-parent-dashboard-card-head"><div><div class="eyebrow">Hoje</div><h2 data-parent-dashboard-today-title>Frequência do aluno</h2></div><time data-parent-dashboard-today-time>—</time></div><p data-parent-dashboard-today-copy>O registro de presença aparecerá quando for lançado pela escola.</p></article><article class="bfr-parent-dashboard-card"><div class="bfr-parent-dashboard-card-head"><div><div class="eyebrow">Próximo compromisso</div><h2 data-parent-dashboard-event-title>Nenhum evento publicado</h2></div><time data-parent-dashboard-event-time>—</time></div><p data-parent-dashboard-event-copy>Os próximos eventos da escola aparecerão aqui.</p></article><article class="bfr-parent-dashboard-card"><div class="bfr-parent-dashboard-card-head"><div><div class="eyebrow">Aviso recente</div><h2 data-parent-dashboard-notice-title>Nenhum comunicado publicado</h2></div><time data-parent-dashboard-notice-time>—</time></div><p data-parent-dashboard-notice-copy>Os comunicados oficiais da escola aparecerão aqui.</p></article></div>
          <section class="bfr-parent-dashboard-card"><div class="bfr-parent-dashboard-card-head"><div><div class="eyebrow">Atalhos</div><h2>Ir direto ao que importa</h2></div></div><div class="bfr-parent-dashboard-shortcuts"><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="notas">Notas e frequência</button><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="agenda">Agenda escolar</button><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="atividades">Central de atividades</button><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="scroll:[data-growth-messages]">Mensagens</button><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="biblioteca">Biblioteca</button><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="comunicados">Comunicados</button><button type="button" class="bfr-parent-dashboard-shortcut" data-parent-dashboard-route="secretaria">Secretaria</button></div></section>
       </section>`;
      function profileName() { try { return String(currentProfile?.full_name || 'Família').split(/\s+/)[0] || 'Família'; } catch { return 'Família'; } }
      function average(values) { const nums = values.map(Number).filter(Number.isFinite); return nums.length ? (nums.reduce((sum, value) => sum + value, 0) / nums.length).toFixed(1).replace('.', ',') : '—'; }
      function studentData() { const state = typeof parentDataState !== 'undefined' ? parentDataState : {}; const student = (state.students || []).find(item => item.id === state.activeStudentId) || state.students?.[0]; return { state, student }; }
      function eventDate(value) { return value ? new Date(value).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.','') : '—'; }
       function render() {
          const host = root()?.querySelector('[data-parent-dashboard-v3]'); if (!host) return;
          const displayName = typeof preferredDisplayName === 'function' ? preferredDisplayName() : profileName();
          host.querySelector('[data-parent-dashboard-greeting]').textContent = `Olá, ${displayName}!`;
         const { state, student } = studentData();
         const students = state.students || [];
         const select = host.querySelector('[data-parent-dashboard-student-select]');
         const linkStudent = host.querySelector('[data-parent-dashboard-link-student]');
         select.innerHTML = students.length ? students.map(item => `<option value="${esc(item.id)}">${esc(item.official_name)}</option>`).join('') : '<option value="">Nenhum aluno vinculado</option>';
         select.value = student?.id || '';
         select.hidden = students.length < 2;
         linkStudent.hidden = Boolean(student);
         const nameEl = host.querySelector('[data-parent-dashboard-student-name]');
         const classEl = host.querySelector('[data-parent-dashboard-student-class]');
         const avatar = host.querySelector('[data-parent-dashboard-avatar]');
         const status = host.querySelector('[data-parent-dashboard-status]');
         if (!student) { nameEl.textContent = 'Aluno não vinculado'; classEl.textContent = 'Aguardando vínculo da escola'; avatar.textContent = '—'; status.textContent = state.loaded ? 'Para acompanhar notas, frequência, atividades e comunicados, vincule um aluno à sua conta.' : 'Carregando os dados vinculados à conta...'; }
         else { const classData = (state.classes || []).find(item => item.id === student.class_id); nameEl.textContent = student.official_name; classEl.textContent = classData ? `${classData.year}º ano ${classData.class_code} · Ensino Fundamental` : 'Turma ainda não informada'; avatar.textContent = student.official_name.split(/\s+/).map(part => part[0]).slice(0,2).join('').toUpperCase(); status.textContent = 'Dados atualizados pela escola.'; }
         host.querySelector('[data-parent-dashboard-sync]').textContent = state.loaded ? `Atualizado às ${typeof schoolClock === 'function' ? schoolClock() : 'agora'}` : 'Carregando dados...';
         const emptyStudentNote = student ? '' : 'Vincule um aluno para acompanhar';
         const attendance = student ? (state.attendance || []).filter(item => item.student_id === student.id) : [];
         const present = attendance.filter(item => ['present','late'].includes(item.status)).length;
         const grades = student ? (state.grades || []).filter(item => item.student_id === student.id) : [];
         host.querySelector('[data-parent-dashboard-attendance]').textContent = attendance.length ? `${((present / attendance.length) * 100).toFixed(1).replace('.', ',')}%` : '—';
         host.querySelector('[data-parent-dashboard-attendance-note]').textContent = attendance.length ? `${present} de ${attendance.length} registros com presença` : emptyStudentNote || 'Sem registros disponíveis';
         host.querySelector('[data-parent-dashboard-average]').textContent = average(grades.map(item => item.score));
         host.querySelector('[data-parent-dashboard-average-note]').textContent = grades.length ? `${grades.length} lançamento${grades.length === 1 ? '' : 's'} no boletim` : emptyStudentNote || 'Sem notas lançadas';
         const activityItems = typeof activityState !== 'undefined' ? activityState.items || [] : [];
         const activitiesReady = typeof activityState !== 'undefined' && activityState.loaded;
         const visibleActivities = student ? activityItems.filter(item => !item.class_id || item.class_id === student.class_id) : [];
         const openActivities = visibleActivities.filter(item => !item.due_date || item.due_date >= (typeof schoolTodayIso === 'function' ? schoolTodayIso() : ''));
         host.querySelector('[data-parent-dashboard-activities]').textContent = student && activitiesReady ? String(openActivities.length) : '—';
         host.querySelector('[data-parent-dashboard-activities-note]').textContent = !student ? emptyStudentNote : activitiesReady ? (openActivities.length ? 'pendentes ou próximas' : 'Nenhuma pendência publicada') : 'Carregando atividades';
         const announcementsReady = content.loaded;
         host.querySelector('[data-parent-dashboard-announcements]').textContent = announcementsReady ? String(content.announcements.length) : '—';
         host.querySelector('[data-parent-dashboard-announcements-note]').textContent = announcementsReady ? (content.announcements.length ? 'comunicado(s) recente(s)' : 'Nenhum aviso novo') : 'Carregando comunicados';
         const messagesReady = typeof growthState !== 'undefined' && growthState.messagesLoaded;
         host.querySelector('[data-parent-dashboard-messages]').textContent = messagesReady ? String(growthState.messages.length) : '—';
         host.querySelector('[data-parent-dashboard-messages-note]').textContent = messagesReady ? (growthState.messages.length ? 'mensagem(ns) no histórico' : 'Nenhuma mensagem neste vínculo') : 'Carregando comunicação';
         const calendar = typeof growthState !== 'undefined' && growthState.calendarLoaded ? growthState.calendar || [] : null;
         host.querySelector('[data-parent-dashboard-calendar]').textContent = calendar ? String(calendar.length) : '—';
         host.querySelector('[data-parent-dashboard-calendar-note]').textContent = calendar ? (calendar.length ? 'eventos e atividades próximos' : 'Nenhum item publicado') : 'Carregando agenda escolar';
         const occurrences = student ? (state.occurrences || []).filter(item => item.student_id === student.id && !item.acknowledged_at) : [];
         const gateAttention = student && typeof parentGateState !== 'undefined' ? (parentGateState.records || []).filter(item => item.student_id === student.id && (item.entry_status === 'blocked' || item.entry_allowed === false)).length : 0;
         const attention = occurrences.length + gateAttention;
         host.querySelector('[data-parent-dashboard-attention]').textContent = student ? String(attention) : '—';
         host.querySelector('[data-parent-dashboard-attention-note]').textContent = student ? (attention ? 'registro(s) aguardando acompanhamento' : 'Nenhum registro pendente') : 'Sem registros disponíveis';
         const today = student ? attendance.find(item => item.attendance_date === (typeof schoolTodayIso === 'function' ? schoolTodayIso() : '')) : null;
         const todayLabels = {present:'Presença confirmada',late:'Entrada com atraso',absent:'Falta registrada',justified:'Falta justificada'};
         host.querySelector('[data-parent-dashboard-today-title]').textContent = today ? todayLabels[today.status] || 'Frequência registrada' : 'Frequência do aluno';
         host.querySelector('[data-parent-dashboard-today-time]').textContent = today ? 'hoje' : '—';
         host.querySelector('[data-parent-dashboard-today-copy]').textContent = today ? 'A escola registrou a frequência deste aluno hoje.' : 'O registro de presença aparecerá quando for lançado pela escola.';
         const event = content.events[0];
         host.querySelector('[data-parent-dashboard-event-title]').textContent = event?.title || 'Nenhum evento publicado';
         host.querySelector('[data-parent-dashboard-event-time]').textContent = event ? eventDate(event.starts_at) : '—';
         host.querySelector('[data-parent-dashboard-event-copy]').textContent = event ? `${event.location || 'Local a confirmar'} · compromisso publicado pela escola.` : 'Os próximos eventos da escola aparecerão aqui.';
         const announcement = content.announcements[0];
         host.querySelector('[data-parent-dashboard-notice-title]').textContent = announcement?.title || 'Nenhum comunicado publicado';
         host.querySelector('[data-parent-dashboard-notice-time]').textContent = announcement ? eventDate(announcement.published_at) : '—';
         host.querySelector('[data-parent-dashboard-notice-copy]').textContent = announcement?.body || 'Os comunicados oficiais da escola aparecerão aqui.';
       }
       function setHomeMode(home) { const view = root(); if (!view) return; view.dataset.parentCompactHome = home ? 'true' : 'false'; if (home) document.querySelectorAll('#appShell .content').forEach(item => { if (item !== view) item.classList.add('hidden'); }); const dashboard = view.querySelector('[data-parent-dashboard-v3]'); if (dashboard) dashboard.hidden = !home; }
       function ensure() { const view = root(); const appShell = document.getElementById('appShell'); if (!view || !appShell?.classList.contains('ready')) return; const parentRole = typeof activeView !== 'undefined' && activeView === 'parent'; appShell.dataset.parentNav = parentRole ? 'true' : 'false'; if (!parentRole) return; if (!view.querySelector('[data-parent-dashboard-v3]')) view.insertAdjacentHTML('afterbegin', dashboardMarkup()); if (!view.dataset.parentCompactHome) setHomeMode(true); render(); if (!calendarRequested && typeof loadGrowthCalendar === 'function' && typeof currentProfile !== 'undefined' && ['parent','developer'].includes(currentProfile?.role)) { calendarRequested = true; loadGrowthCalendar().then(render); } if (!messagesRequested && typeof loadGrowthMessages === 'function' && typeof currentProfile !== 'undefined' && ['parent','developer'].includes(currentProfile?.role)) { messagesRequested = true; loadGrowthMessages().then(render); } }
       function revealRouteTarget(target) { if (!target) return; const container = target.closest('.main-grid,.communication-grid'); if (container) { container.classList.remove('parent-detail-hidden'); const column = target.closest('.main-grid > div,.communication-grid > div'); [...container.children].forEach(item => item.classList.toggle('parent-detail-hidden', item !== column)); if (column) [...column.children].forEach(item => { if (item.classList.contains('panel')) item.classList.toggle('parent-detail-hidden', !item.contains(target)); }); } target.closest('[data-parent-detail-hidden]')?.classList.remove('parent-detail-hidden'); target.classList.remove('parent-detail-hidden'); target.scrollIntoView({behavior:'smooth',block:'start'}); }
       function openRoute(route) { if (route === 'inicio') { window.BFRParentNavigationV2?.openArea?.('inicio'); setHomeMode(true); return; } setHomeMode(false); if (route.startsWith('scroll:')) { revealRouteTarget(root()?.querySelector(route.slice(7))); return; } if (route === 'calendario') { revealRouteTarget(root()?.querySelector('[data-growth-calendar]')); return; } if (window.BFRParentNavigationV2?.openLegacy?.(route)) return; if (route === 'biblioteca' && typeof window.bfrOpenReadingLibrary === 'function') { window.bfrOpenReadingLibrary(); return; } if (route === 'atividades' && typeof window.bfrOpenActivityCenter === 'function') { window.bfrOpenActivityCenter(); return; } if (route === 'alimentacao' && typeof window.bfrOpenHealthyFood === 'function') { window.bfrOpenHealthyFood(); return; } document.querySelector(`.bfr-legacy-nav [data-section="${route}"]`)?.click(); }
      document.addEventListener('change', event => { const select = event.target.closest('[data-parent-dashboard-student-select]'); if (!select || typeof parentDataState === 'undefined') return; parentDataState.activeStudentId = select.value; if (typeof renderParentStudentData === 'function') renderParentStudentData(); if (typeof renderParentOccurrences === 'function') renderParentOccurrences(parentDataState.occurrences.filter(item => item.student_id === select.value)); render(); });
       document.addEventListener('click', event => { const linkStudent = event.target.closest('[data-parent-dashboard-link-student]'); if (linkStudent) { event.preventDefault(); if (typeof openResponsibleRegistration === 'function') openResponsibleRegistration(); return; } const route = event.target.closest('[data-parent-dashboard-route]'); if (route) { event.preventDefault(); openRoute(route.dataset.parentDashboardRoute); return; } const parentRoute = event.target.closest('[data-parent-route]'); if (parentRoute) { if (parentRoute.dataset.parentRoute.startsWith('scroll:')) setTimeout(() => setHomeMode(false), 0); return; } const nav = event.target.closest('.bfr-legacy-nav .nav-item[data-section],.bfr-platform-nav-item'); if (nav && root()) setHomeMode(nav.dataset.section === 'inicio' || nav.dataset.platformArea === 'inicio'); });
        window.BFRParentDashboard = { render, setHomeMode, updateContent(announcements, events) { content.announcements = announcements || []; content.events = events || []; content.loaded = true; render(); } };
      const app = document.getElementById('appShell');
      if (app) new MutationObserver(ensure).observe(app, { attributes:true, attributeFilter:['class'] });
      const parentView = root();
      if (parentView) new MutationObserver(() => { if (!parentView.classList.contains('hidden') && document.getElementById('appShell')?.dataset.parentNav === 'true' && parentView.dataset.parentCompactHome === 'false') setHomeMode(true); }).observe(parentView, { attributes:true, attributeFilter:['class'] });
      function isLibraryDocument(item) { const category = String(item.category || '').toLocaleLowerCase('pt-BR'); const description = String(item.description || '').toLocaleLowerCase('pt-BR'); return category.startsWith('biblioteca') || description.includes('livro da biblioteca') || description.includes('biblioteca virtual'); }
       function parentDocumentsScope() { const view = document.getElementById('parentView'); const parentActive = typeof activeView !== 'undefined' && activeView === 'parent'; return parentActive && view && !view.classList.contains('hidden') ? view : null; }
       function normalizeDocumentPanels(scope = parentDocumentsScope()) { if (!scope) return; scope.querySelectorAll('[data-growth-documents]').forEach(panel => { const title = panel.querySelector('.panel-heading h2'); const intro = panel.querySelector('.agenda-intro'); if (title) title.textContent = 'Documentos da Secretaria'; if (intro) intro.textContent = 'Declarações, históricos, autorizações e documentos emitidos pela Secretaria.'; const list = panel.querySelector('[data-growth-document-list]'); if (list && !panel.querySelector('[data-growth-target="growth-requests"]')) list.insertAdjacentHTML('beforebegin','<div class="growth-actions"><button class="growth-action" type="button" data-growth-target="growth-requests">Solicitar documento à Secretaria</button></div>'); }); }
       function filterDocumentPanels() { const scope = parentDocumentsScope(); if (!scope) return; normalizeDocumentPanels(scope); scope.querySelectorAll('[data-growth-document-list]').forEach(list => { [...list.children].forEach(item => { const category = item.querySelector('.growth-item-top small')?.textContent || ''; const description = item.textContent || ''; if (category.toLocaleLowerCase('pt-BR').startsWith('biblioteca') || description.toLocaleLowerCase('pt-BR').includes('livro da biblioteca')) item.remove(); }); const count = list.closest('[data-growth-documents]')?.querySelector('[data-growth-document-count]'); if (count) count.textContent = String(list.querySelectorAll('.growth-item').length); if (!list.querySelector('.growth-item') && !list.querySelector('.project-empty') && list.children.length === 0) list.innerHTML = '<div class="project-empty">Nenhum documento da Secretaria publicado ainda.</div>'; }); }
        function installFamilyDocumentLoader() { if (typeof loadGrowthDocuments !== 'function' || loadGrowthDocuments.__bfrFamilyScope) return; const originalLoader = loadGrowthDocuments; const scopedLoader = async function() { const scope = parentDocumentsScope(); if (!scope) return originalLoader(); if (!supabaseClient || !currentUser) return; const result = await supabaseClient.from('school_documents').select('id,title,category,description,storage_path,student_id,request_id,recipient_id,published,created_at').eq('published',true).order('created_at',{ascending:false}); const linkedStudentIds = new Set((typeof parentDataState !== 'undefined' ? parentDataState.students : []).map(item => item.id)); const documents = (result.data || []).filter(item => !isLibraryDocument(item) && (!item.recipient_id || item.recipient_id === currentUser.id) && (!item.student_id || linkedStudentIds.has(item.student_id))); scope.querySelectorAll('[data-growth-document-list]').forEach(list => { list.innerHTML = result.error ? '<div class="project-empty">A central da Secretaria ainda não foi configurada.</div>' : documents.length ? documents.map(item => `<article class="growth-item"><div class="growth-item-top"><strong>📄 ${escapeHtml(item.title)}</strong><small>${escapeHtml(item.category || 'Documento da Secretaria')}</small></div><p>${escapeHtml(item.description || 'Documento emitido pela Secretaria.')}</p><button class="growth-action" type="button" data-growth-document-path="${escapeHtml(item.storage_path)}">Abrir documento</button></article>`).join('') : '<div class="project-empty">Nenhum documento da Secretaria publicado ainda.</div>'; }); scope.querySelectorAll('[data-growth-document-count]').forEach(item => { item.textContent = String(result.error ? 0 : documents.length); }); if (typeof growthState !== 'undefined') growthState.documentsLoaded = true; normalizeDocumentPanels(scope); }; scopedLoader.__bfrFamilyScope = true; loadGrowthDocuments = scopedLoader; }
      installFamilyDocumentLoader();
      setInterval(() => { installFamilyDocumentLoader(); filterDocumentPanels(); }, 1200);
      setTimeout(() => { installFamilyDocumentLoader(); filterDocumentPanels(); }, 0);
      setInterval(ensure, 1200);
      setTimeout(ensure, 0);
    })();
  </script>
  <style id="bfr-internal-chat-style">
    #internalChatView { padding-top: 28px; }
    .bfr-internal-chat { display:grid; gap:16px; min-width:0; }
    .bfr-chat-hero { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; padding:22px 24px; border:1px solid #cfe0f5; border-radius:18px; color:#fff; background:linear-gradient(120deg,#10295f,#1769d2 58%,#24b7a1); box-shadow:0 14px 30px rgba(16,41,95,.14); }
    .bfr-chat-hero .eyebrow { color:#ccecff; }
    .bfr-chat-hero h1 { margin-top:5px; color:#fff; font:700 clamp(25px,3vw,38px) 'Playfair Display',serif; letter-spacing:-.7px; }
    .bfr-chat-hero p { max-width:650px; margin-top:7px; color:rgba(255,255,255,.82); font-size:11px; line-height:1.5; }
    .bfr-chat-hero-actions { display:flex; align-items:center; justify-content:flex-end; gap:10px; flex-wrap:wrap; }
    .bfr-chat-connection { color:rgba(255,255,255,.82); font:9px 'DM Mono',monospace; white-space:nowrap; }
    .bfr-chat-connection.is-ready:before { content:'●'; color:#8ef0c8; margin-right:5px; }
    .bfr-chat-connection.is-pending:before { content:'○'; color:#ffd166; margin-right:5px; }
    .bfr-chat-hero .primary-button { white-space:nowrap; }
    .bfr-chat-schema-status { padding:12px 14px; border:1px solid #f0d8a7; border-radius:11px; color:#765b2d; background:#fff9e9; font-size:10px; line-height:1.45; }
    .bfr-chat-layout { display:grid; grid-template-columns:230px minmax(0,1fr) 210px; gap:12px; min-height:560px; }
    .bfr-chat-column { min-width:0; border:1px solid #d8e3f1; border-radius:15px; background:#fff; box-shadow:0 8px 20px rgba(43,67,115,.05); }
    .bfr-chat-room-column, .bfr-chat-people-column { padding:14px; }
    .bfr-chat-column-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; margin-bottom:12px; }
    .bfr-chat-column-heading h2 { margin-top:4px; color:#173b79; font:700 17px 'Playfair Display',serif; }
    .bfr-chat-search { width:100%; margin-bottom:10px; border:1px solid #d8e3f1; border-radius:9px; padding:9px 10px; color:#29436a; background:#fbfdff; font-size:10px; outline:0; }
    .bfr-chat-search:focus, .bfr-chat-composer textarea:focus, .bfr-chat-new-form select:focus { border-color:#78afe8; box-shadow:0 0 0 3px rgba(37,99,235,.1); }
    .bfr-chat-room-list, .bfr-chat-people-list { display:grid; gap:5px; }
    .bfr-chat-room { width:100%; display:flex; align-items:center; gap:9px; padding:10px; border:1px solid transparent; border-radius:10px; color:#29436a; background:transparent; text-align:left; }
    .bfr-chat-room:hover { background:#f4f8ff; border-color:#d7e7fb; }
    .bfr-chat-room.is-active { border-color:#b9d5f4; background:#edf5ff; color:#1558b8; }
    .bfr-chat-room-icon { display:grid; place-items:center; width:30px; height:30px; flex:0 0 auto; border-radius:9px; color:#1769d2; background:#e8f1ff; font-size:14px; }
    .bfr-chat-room strong, .bfr-chat-room small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bfr-chat-room strong { font-size:10px; }
    .bfr-chat-room small { margin-top:3px; color:#8a98aa; font-size:9px; }
    .bfr-chat-empty { padding:12px; border:1px dashed #d8e3f1; border-radius:10px; color:#7b899c; background:#fbfdff; font-size:10px; line-height:1.45; }
    .bfr-chat-conversation { display:grid; grid-template-rows:auto minmax(0,1fr) auto; overflow:hidden; }
    .bfr-chat-conversation-head { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:72px; padding:15px 17px; border-bottom:1px solid #e6edf5; }
    .bfr-chat-conversation-head h2 { margin-top:4px; color:#10295f; font:700 19px 'Playfair Display',serif; }
    .bfr-chat-conversation-head p { margin-top:4px; color:#7b899c; font-size:10px; }
    .bfr-chat-message-list { min-height:300px; max-height:560px; overflow:auto; padding:18px; background:linear-gradient(180deg,#fbfdff,#f5f8fc); }
    .bfr-chat-message { display:flex; align-items:flex-end; gap:8px; margin:0 0 12px; }
    .bfr-chat-message.is-own { justify-content:flex-end; }
    .bfr-chat-avatar { display:grid; place-items:center; width:28px; height:28px; flex:0 0 auto; border-radius:50%; color:#fff; background:linear-gradient(145deg,#24b7a1,#1769d2); font-size:9px; font-weight:800; }
    .bfr-chat-bubble { max-width:min(78%,520px); padding:10px 11px; border:1px solid #d9e5f2; border-radius:13px 13px 13px 4px; color:#29436a; background:#fff; box-shadow:0 3px 10px rgba(43,67,115,.04); }
    .bfr-chat-message.is-own .bfr-chat-bubble { border-color:#b8d5f2; border-radius:13px 13px 4px 13px; color:#173b79; background:#eaf3ff; }
    .bfr-chat-bubble strong { display:block; margin-bottom:4px; font-size:9px; }
    .bfr-chat-bubble p { white-space:pre-wrap; font-size:11px; line-height:1.45; }
    .bfr-chat-bubble time { display:block; margin-top:6px; color:#8a98aa; font:9px 'DM Mono',monospace; }
    .bfr-chat-bubble button { margin-top:6px; border:0; padding:0; color:#6b7c93; background:transparent; font-size:9px; text-decoration:underline; }
    .bfr-chat-attachment { display:block; margin-top:7px; color:#1769d2; font-size:10px; font-weight:700; text-decoration:none; }
    .bfr-chat-attachment:hover { text-decoration:underline; }
    .bfr-chat-composer { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:8px; align-items:end; padding:13px 15px; border-top:1px solid #e6edf5; background:#fff; }
    .bfr-chat-composer textarea { width:100%; min-height:42px; max-height:130px; resize:vertical; border:1px solid #d8e3f1; border-radius:10px; padding:10px; color:#29436a; background:#fbfdff; font-size:11px; outline:0; }
    .bfr-chat-attach { display:grid; place-items:center; width:38px; height:38px; border:1px solid #d8e3f1; border-radius:10px; color:#1769d2; background:#f4f8ff; cursor:pointer; font-size:16px; }
    .bfr-chat-attach:hover { background:#eaf3ff; border-color:#9bc7ef; }
    .bfr-chat-file-name { grid-column:2/-1; color:#7b899c; font-size:9px; }
    .bfr-chat-people-list { max-height:420px; overflow:auto; }
    .bfr-chat-person { display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid #edf1f6; }
    .bfr-chat-person:last-child { border-bottom:0; }
    .bfr-chat-person-avatar { display:grid; place-items:center; width:27px; height:27px; border-radius:50%; color:#1558b8; background:#e8f1ff; font-size:8px; font-weight:800; }
    .bfr-chat-person strong, .bfr-chat-person small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bfr-chat-person strong { color:#29436a; font-size:10px; }
    .bfr-chat-person small { margin-top:3px; color:#8a98aa; font-size:8px; }
    .bfr-chat-person-status { width:6px; height:6px; margin-left:auto; border-radius:50%; background:#c8d3df; }
    .bfr-chat-person-status.is-online { background:#24b78d; box-shadow:0 0 0 3px #e4f7f0; }
    .bfr-chat-new-modal { position:fixed; inset:0; z-index:80; display:grid; place-items:center; padding:18px; background:rgba(8,25,38,.45); backdrop-filter:blur(4px); }
    .bfr-chat-new-modal.hidden { display:none; }
    .bfr-chat-new-card { width:min(100%,460px); padding:21px; border:1px solid #d8e3f1; border-radius:16px; background:#fff; box-shadow:0 20px 60px rgba(8,25,38,.2); }
    .bfr-chat-new-card h2 { margin-top:5px; color:#173b79; font:700 21px 'Playfair Display',serif; }
    .bfr-chat-new-card p { margin-top:7px; color:#7b899c; font-size:10px; line-height:1.45; }
    .bfr-chat-new-form { display:grid; gap:9px; margin-top:15px; }
    .bfr-chat-new-form label { display:grid; gap:5px; color:#71809a; font-size:10px; }
    .bfr-chat-new-form select { width:100%; border:1px solid #d8e3f1; border-radius:9px; padding:10px; color:#29436a; background:#fbfdff; font-size:10px; outline:0; }
    .bfr-chat-new-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:7px; }
    .bfr-chat-secondary { border:1px solid #d8e3f1; border-radius:9px; padding:9px 11px; color:#29436a; background:#fff; font-size:10px; }
    .bfr-chat-secondary:hover { background:#f4f8ff; }
    @media(max-width:1050px){.bfr-chat-layout{grid-template-columns:205px minmax(0,1fr)}.bfr-chat-people-column{display:none}}
    @media(max-width:800px){#internalChatView{padding-top:16px}.bfr-chat-hero{display:block;padding:18px}.bfr-chat-hero-actions{justify-content:flex-start;margin-top:14px}.bfr-chat-layout{grid-template-columns:1fr;min-height:0}.bfr-chat-room-column{max-height:230px;overflow:auto}.bfr-chat-conversation{min-height:520px}.bfr-chat-message-list{max-height:none}.bfr-chat-bubble{max-width:86%}.bfr-chat-composer{grid-template-columns:auto minmax(0,1fr)}.bfr-chat-composer .primary-button{grid-column:2;justify-self:end}.bfr-chat-file-name{grid-column:1/-1}}
  </style>
  <script id="bfr-internal-chat">
    (() => {
      const STAFF_ROLES = ['pedagogical','aee','coordinator','director','secretary','developer'];
      const state = { booted:false, userId:null, configured:false, rooms:[], profiles:[], messages:[], selectedRoomId:'', search:'', onlineIds:new Set(), roomChannel:null, presenceChannel:null, presenceTimer:null };
      const root = () => document.getElementById('internalChatView');
      const client = () => typeof supabaseClient !== 'undefined' ? supabaseClient : null;
      const user = () => typeof currentUser !== 'undefined' ? currentUser : null;
      const role = () => typeof currentProfile !== 'undefined' ? currentProfile?.role : '';
      const allowed = () => STAFF_ROLES.includes(role()) || (typeof activeView !== 'undefined' && ['teacher','coordinator','director','secretary','aee','admin'].includes(activeView));
      const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
      const initials = value => String(value || 'BFR').split(/\s+/).filter(Boolean).map(part => part[0]).slice(0,2).join('').toUpperCase();
      const label = value => String(value || '').replace('_',' ');
      const time = value => value ? new Date(value).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '';
      const withTimeout = (promise, ms = 8000) => Promise.race([Promise.resolve(promise), new Promise(resolve => setTimeout(() => resolve({ data:null, error:{ message:'Tempo esgotado ao consultar o chat.' } }), ms))]);
      const query = async request => { try { return await withTimeout(request); } catch (error) { return { data:null, error:{ message:error?.message || 'Não foi possível consultar o chat.' } }; } };
      const profileName = id => state.profiles.find(item => item.id === id)?.full_name || (id === user()?.id ? (currentProfile?.full_name || 'Você') : 'Equipe escolar');
      const selectedRoom = () => state.rooms.find(room => room.id === state.selectedRoomId) || null;

      function ensureNavigation() {
        const grid = document.querySelector('#mobileMoreMenu .mobile-more-grid');
        if (!grid || grid.querySelector('[data-mobile-chat-option]')) return;
        grid.insertAdjacentHTML('beforeend','<button type="button" class="mobile-more-option hidden" data-mobile-chat-option data-section="chat-interno"><span>💬</span>Chat interno</button>');
        grid.querySelector('[data-mobile-chat-option]').addEventListener('click', () => {
          document.getElementById('mobileMoreMenu')?.classList.add('hidden');
          document.querySelector('.mobile-more-item[data-mobile-more]')?.classList.add('active');
          document.querySelector('.bfr-platform-nav [data-section="chat-interno"]')?.classList.add('active');
          navigateToSection('chat-interno');
        });
      }

      function shellMarkup() {
        return `<div class="bfr-internal-chat">
          <header class="bfr-chat-hero"><div><div class="eyebrow">Comunicação profissional · BFR Conecta</div><h1>Chat interno.</h1><p>Converse com a equipe autorizada da escola em um espaço separado de comunicados, mensagens de responsáveis e registros acadêmicos.</p></div><div class="bfr-chat-hero-actions"><span class="bfr-chat-connection is-pending" data-chat-connection>aguardando conexão</span><button class="primary-button" type="button" data-chat-new>+ Nova conversa</button></div></header>
          <div class="bfr-chat-schema-status hidden" data-chat-schema-status role="status"></div>
          <div class="bfr-chat-layout">
            <aside class="bfr-chat-column bfr-chat-room-column"><div class="bfr-chat-column-heading"><div><div class="eyebrow">Conversas</div><h2>Seus canais</h2></div><span class="agenda-count" data-chat-room-count>0</span></div><input class="bfr-chat-search" data-chat-search type="search" placeholder="Buscar conversa" aria-label="Buscar conversa"><div class="bfr-chat-room-list" data-chat-room-list><div class="bfr-chat-empty">Carregando conversas autorizadas...</div></div></aside>
            <section class="bfr-chat-column bfr-chat-conversation"><header class="bfr-chat-conversation-head"><div><div class="eyebrow">Canal profissional</div><h2 data-chat-room-title>Chat interno</h2><p data-chat-room-subtitle>Selecione uma conversa para começar.</p></div><span class="agenda-count" data-chat-room-kind>privado</span></header><div class="bfr-chat-message-list" data-chat-message-list><div class="bfr-chat-empty">As mensagens desta conversa aparecerão aqui.</div></div><form class="bfr-chat-composer" data-chat-form><label class="bfr-chat-attach" title="Anexar arquivo"><span aria-hidden="true">📎</span><input type="file" data-chat-file hidden accept="application/pdf,image/jpeg,image/png,image/webp,text/plain,.docx,.xlsx"></label><textarea name="body" rows="2" maxlength="4000" placeholder="Escreva uma mensagem..." disabled></textarea><button class="primary-button" type="submit" disabled>Enviar</button><span class="bfr-chat-file-name hidden" data-chat-file-name></span></form></section>
            <aside class="bfr-chat-column bfr-chat-people-column"><div class="bfr-chat-column-heading"><div><div class="eyebrow">Equipe autorizada</div><h2>Disponibilidade</h2></div><span class="agenda-count" data-chat-online-count>0 online</span></div><div class="bfr-chat-people-list" data-chat-people-list><div class="bfr-chat-empty">A equipe aparecerá quando o cadastro estiver disponível.</div></div></aside>
          </div>
          <div class="bfr-chat-new-modal hidden" data-chat-new-modal role="dialog" aria-modal="true" aria-label="Nova conversa"><div class="bfr-chat-new-card"><div class="eyebrow">Chat interno</div><h2>Começar uma conversa</h2><p>Escolha uma pessoa da equipe autorizada. A conversa será privada e visível somente aos participantes.</p><form class="bfr-chat-new-form" data-chat-new-form><label>Profissional<select name="profile_id" data-chat-new-profile required><option value="">Carregando equipe...</option></select></label><div class="bfr-chat-new-actions"><button class="bfr-chat-secondary" type="button" data-chat-close-new>Cancelar</button><button class="primary-button" type="submit">Criar conversa</button></div><p class="publish-status" data-chat-new-status></p></form></div></div>
        </div>`;
      }

      function renderShell() {
        const host = root();
        if (!host) return;
        if (!host.querySelector('[data-chat-room-list]')) host.innerHTML = shellMarkup();
        render();
      }

      function setConnection(text, ready = false) {
        const item = root()?.querySelector('[data-chat-connection]');
        if (!item) return;
        item.textContent = text;
        item.classList.toggle('is-ready', ready);
        item.classList.toggle('is-pending', !ready);
      }

      function setSchemaMessage(message = '') {
        const status = root()?.querySelector('[data-chat-schema-status]');
        if (!status) return;
        status.textContent = message;
        status.classList.toggle('hidden', !message);
      }

      function renderRooms() {
        const host = root();
        const list = host?.querySelector('[data-chat-room-list]');
        if (!list) return;
        const search = state.search.toLocaleLowerCase('pt-BR').trim();
        const rooms = state.rooms.filter(room => !search || String(room.title || room.kind).toLocaleLowerCase('pt-BR').includes(search));
        host.querySelector('[data-chat-room-count]').textContent = String(state.rooms.length);
        list.innerHTML = rooms.length ? rooms.map(room => `<button type="button" class="bfr-chat-room ${room.id === state.selectedRoomId ? 'is-active' : ''}" data-chat-room="${esc(room.id)}"><span class="bfr-chat-room-icon">${room.kind === 'general' ? '◉' : '◌'}</span><span><strong>${esc(room.title || 'Conversa interna')}</strong><small>${room.kind === 'general' ? 'Toda a equipe autorizada' : 'Conversa privada'}</small></span></button>`).join('') : '<div class="bfr-chat-empty">Nenhuma conversa encontrada.</div>';
      }

      function renderPeople() {
        const host = root();
        const list = host?.querySelector('[data-chat-people-list]');
        if (!list) return;
        const people = state.profiles.filter(item => STAFF_ROLES.includes(item.role));
        const online = people.filter(item => state.onlineIds.has(item.id)).length;
        host.querySelector('[data-chat-online-count]').textContent = `${online} online`;
        list.innerHTML = people.length ? people.map(item => `<div class="bfr-chat-person"><span class="bfr-chat-person-avatar">${esc(initials(item.full_name || item.email))}</span><span><strong>${esc(item.full_name || 'Conta profissional')}</strong><small>${esc(label(item.role || 'equipe'))}</small></span><i class="bfr-chat-person-status ${state.onlineIds.has(item.id) ? 'is-online' : ''}" aria-label="${state.onlineIds.has(item.id) ? 'online' : 'offline'}"></i></div>`).join('') : '<div class="bfr-chat-empty">Nenhum perfil profissional foi carregado.</div>';
      }

      function renderMessages() {
        const host = root();
        const list = host?.querySelector('[data-chat-message-list]');
        const room = selectedRoom();
        if (!list) return;
        host.querySelector('[data-chat-room-title]').textContent = room?.title || 'Chat interno';
        host.querySelector('[data-chat-room-subtitle]').textContent = room ? (room.kind === 'general' ? 'Canal compartilhado entre profissionais autorizados.' : 'Conversa privada entre profissionais autorizados.') : 'Selecione uma conversa para começar.';
        host.querySelector('[data-chat-room-kind]').textContent = room?.kind === 'general' ? 'geral' : 'privado';
        if (!state.messages.length) { list.innerHTML = '<div class="bfr-chat-empty">Ainda não há mensagens nesta conversa.</div>'; return; }
        list.innerHTML = state.messages.map(message => {
          const own = message.sender_id === user()?.id;
          const deleted = Boolean(message.deleted_at);
          const body = deleted ? 'Mensagem excluída.' : (message.body || 'Arquivo anexado.');
          const attachment = message.attachment_path && !deleted ? `<a class="bfr-chat-attachment" href="#" data-chat-attachment="${esc(message.attachment_path)}">📎 ${esc(message.attachment_name || 'Abrir anexo')}</a>` : '';
          const remove = own && !deleted ? `<button type="button" data-chat-message-delete="${esc(message.id)}">Excluir mensagem</button>` : '';
          return `<article class="bfr-chat-message ${own ? 'is-own' : ''}">${own ? '' : `<span class="bfr-chat-avatar">${esc(initials(profileName(message.sender_id)))}</span>`}<div class="bfr-chat-bubble"><strong>${esc(own ? 'Você' : profileName(message.sender_id))}</strong><p>${esc(body)}</p>${attachment}<time>${esc(time(message.created_at))}</time>${remove}</div></article>`;
        }).join('');
        list.scrollTop = list.scrollHeight;
      }

      function renderComposer() {
        const form = root()?.querySelector('[data-chat-form]');
        if (!form) return;
        const active = Boolean(state.configured && state.selectedRoomId && user());
        form.querySelector('textarea').disabled = !active;
        form.querySelector('button[type="submit"]').disabled = !active;
        form.querySelector('[data-chat-file]').disabled = !active;
         if (!active) form.querySelector('textarea').placeholder = 'Selecione uma conversa para começar.';
      }

      function render() { renderRooms(); renderPeople(); renderMessages(); renderComposer(); }

      async function loadProfiles() {
        const result = await query(client().from('profiles').select('id,full_name,email,role').in('role', STAFF_ROLES).order('full_name'));
        state.profiles = result.error ? [] : (result.data || []);
        if (user() && !state.profiles.some(item => item.id === user().id)) state.profiles.push({ id:user().id, full_name:currentProfile?.full_name || 'Você', email:currentProfile?.email || user()?.email, role:role() });
      }

      async function loadPresence() {
        const result = await query(client().from('internal_chat_presence').select('profile_id,status').in('status',['online','away']));
        if (!result.error) state.onlineIds = new Set((result.data || []).map(item => item.profile_id));
        if (user()) await client().from('internal_chat_presence').upsert({ profile_id:user().id, status:'online', last_seen_at:new Date().toISOString(), updated_at:new Date().toISOString() }, { onConflict:'profile_id' });
        renderPeople();
      }

      function startRealtime() {
        const db = client();
        if (!db || !user()) return;
        if (state.roomChannel) db.removeChannel(state.roomChannel);
        state.roomChannel = db.channel(`bfr-internal-chat-${user().id}`).on('postgres_changes',{ event:'*', schema:'public', table:'internal_chat_messages' }, payload => { if (payload.new?.room_id === state.selectedRoomId || payload.old?.room_id === state.selectedRoomId) loadMessages(state.selectedRoomId); loadRooms(); }).subscribe();
        if (state.presenceChannel) db.removeChannel(state.presenceChannel);
        state.presenceChannel = db.channel('bfr-internal-chat-presence',{ config:{ presence:{ key:user().id } } }).on('presence',{ event:'sync' }, () => { const snapshot = state.presenceChannel.presenceState(); state.onlineIds = new Set(Object.keys(snapshot)); renderPeople(); }).subscribe(async status => { if (status === 'SUBSCRIBED') await state.presenceChannel.track({ profile_id:user().id, status:'online' }); });
        if (!state.presenceTimer) state.presenceTimer = setInterval(() => { if (allowed()) loadPresence(); }, 60000);
      }

      async function loadMessages(roomId) {
        if (!roomId || !client()) return;
        const result = await query(client().from('internal_chat_messages').select('id,room_id,sender_id,body,attachment_path,attachment_name,attachment_type,reply_to_id,deleted_at,created_at').eq('room_id',roomId).order('created_at',{ascending:true}).limit(200));
         if (result.error) { setSchemaMessage('Não foi possível carregar esta conversa. Tente novamente.'); return; }
        state.messages = result.data || [];
        renderMessages();
        await client().from('internal_chat_room_members').update({ last_read_at:new Date().toISOString() }).eq('room_id',roomId).eq('profile_id',user().id);
      }

      async function loadRooms() {
        if (!client() || !user() || !allowed()) return;
        const [roomsResult] = await Promise.all([query(client().from('internal_chat_threads').select('id,kind,title,created_by,updated_at').order('updated_at',{ascending:false})), loadProfiles()]);
        if (roomsResult.error) {
          state.configured = false;
           setConnection('indisponível');
           setSchemaMessage('O chat profissional está temporariamente indisponível. Tente novamente mais tarde.');
          render();
          return;
        }
        state.configured = true;
        state.rooms = roomsResult.data || [];
        setConnection('chat conectado', true);
        setSchemaMessage('');
        if (!state.selectedRoomId || !state.rooms.some(room => room.id === state.selectedRoomId)) state.selectedRoomId = state.rooms.find(room => room.kind === 'general')?.id || state.rooms[0]?.id || '';
        render();
        if (state.selectedRoomId) await loadMessages(state.selectedRoomId);
        await loadPresence();
        startRealtime();
      }

      async function sendMessage(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const body = form.body.value.trim();
        const file = form.querySelector('[data-chat-file]').files?.[0];
        const status = root()?.querySelector('[data-chat-schema-status]');
        if (!state.configured || !state.selectedRoomId || (!body && !file) || !client() || !user()) return;
        if (file?.size > 10 * 1024 * 1024) { if (status) { status.textContent = 'O anexo precisa ter até 10 MB.'; status.classList.remove('hidden'); } return; }
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        let attachment = {};
        if (file) {
          const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]+/g,'-').slice(-90) || 'anexo';
          const path = `${user().id}/${crypto.randomUUID()}-${safeName}`;
          const upload = await client().storage.from('internal-chat-media').upload(path,file,{ contentType:file.type || 'application/octet-stream', upsert:false });
           if (upload.error) { button.disabled = false; if (status) { status.textContent = 'Não foi possível enviar o anexo. Tente novamente.'; status.classList.remove('hidden'); } return; }
          attachment = { attachment_path:path, attachment_name:file.name, attachment_type:file.type || null };
        }
        const result = await client().from('internal_chat_messages').insert({ room_id:state.selectedRoomId, sender_id:user().id, body, ...attachment });
        button.disabled = false;
         if (result.error) { if (status) { status.textContent = 'Não foi possível enviar a mensagem. Tente novamente.'; status.classList.remove('hidden'); } return; }
        form.reset();
        root()?.querySelector('[data-chat-file-name]')?.classList.add('hidden');
        await loadMessages(state.selectedRoomId);
      }

      async function createConversation(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const profileId = form.profile_id.value;
        const status = form.querySelector('[data-chat-new-status]');
        if (!profileId || !client() || !user()) return;
        status.textContent = 'Criando conversa...';
        const target = state.profiles.find(item => item.id === profileId);
        const created = await query(client().from('internal_chat_threads').insert({ kind:'direct', title:`Conversa com ${target?.full_name || 'profissional'}`, created_by:user().id }).select('id,kind,title,created_by,updated_at').single());
        if (created.error || !created.data) { status.textContent = 'Não foi possível criar a conversa.'; return; }
        const members = await query(client().from('internal_chat_room_members').insert([{ room_id:created.data.id, profile_id:user().id },{ room_id:created.data.id, profile_id:profileId }]));
        if (members.error) { status.textContent = 'A conversa foi criada, mas os participantes não puderam ser associados.'; return; }
        state.rooms.unshift(created.data);
        state.selectedRoomId = created.data.id;
        root()?.querySelector('[data-chat-new-modal]')?.classList.add('hidden');
        render();
        await loadMessages(state.selectedRoomId);
      }

      async function openNewConversation() {
        const modal = root()?.querySelector('[data-chat-new-modal]');
        const select = modal?.querySelector('[data-chat-new-profile]');
        if (!modal || !select) return;
        const people = state.profiles.filter(item => item.id !== user()?.id && STAFF_ROLES.includes(item.role));
        select.innerHTML = people.length ? `<option value="">Escolha um profissional</option>${people.map(item => `<option value="${esc(item.id)}">${esc(item.full_name || item.email || 'Conta profissional')} · ${esc(label(item.role))}</option>`).join('')}` : '<option value="">Nenhum profissional disponível</option>';
        modal.classList.remove('hidden');
        select.focus();
      }

      async function openAttachment(path) {
        const result = await client().storage.from('internal-chat-media').createSignedUrl(path,3600);
        if (result.error || !result.data?.signedUrl) return;
        window.open(result.data.signedUrl,'_blank','noopener,noreferrer');
      }

      async function deleteMessage(id) {
        if (!id || !client() || !user()) return;
        const result = await client().from('internal_chat_messages').update({ deleted_at:new Date().toISOString(), body:'Mensagem excluída.' }).eq('id',id).eq('sender_id',user().id);
        if (!result.error) await loadMessages(state.selectedRoomId);
      }

      function bindEvents() {
        const host = root();
        if (!host || host.dataset.chatReady) return;
        host.dataset.chatReady = 'true';
        host.addEventListener('click', event => {
          const room = event.target.closest('[data-chat-room]');
          if (room) { state.selectedRoomId = room.dataset.chatRoom; state.messages = []; render(); loadMessages(state.selectedRoomId); return; }
          if (event.target.closest('[data-chat-new]')) { openNewConversation(); return; }
          if (event.target.closest('[data-chat-close-new]') || event.target === host.querySelector('[data-chat-new-modal]')) { host.querySelector('[data-chat-new-modal]')?.classList.add('hidden'); return; }
          const attachment = event.target.closest('[data-chat-attachment]');
          if (attachment) { event.preventDefault(); openAttachment(attachment.dataset.chatAttachment); return; }
          const remove = event.target.closest('[data-chat-message-delete]');
          if (remove) deleteMessage(remove.dataset.chatMessageDelete);
        });
        host.addEventListener('submit', event => { if (event.target.closest('[data-chat-form]')) sendMessage(event); if (event.target.closest('[data-chat-new-form]')) createConversation(event); });
        host.querySelector('[data-chat-search]').addEventListener('input', event => { state.search = event.target.value; renderRooms(); });
        host.querySelector('[data-chat-file]').addEventListener('change', event => { const name = host.querySelector('[data-chat-file-name]'); name.textContent = event.target.files?.[0]?.name || ''; name.classList.toggle('hidden', !event.target.files?.[0]); });
      }

      function open() {
        if (!allowed()) return;
        ensureNavigation();
        renderShell();
        bindEvents();
        if (state.userId !== user()?.id) { state.userId = user()?.id || null; state.booted = false; state.configured = false; state.rooms = []; state.selectedRoomId = ''; state.messages = []; }
         if (!state.booted) { state.booted = true; setConnection('conectando'); loadRooms(); }
      }

      window.BFRInternalChat = { open };
      ensureNavigation();
    })();
  </script>
  <script id="bfr-audit-hardening">
    (() => {
      let queued = false;
      const schedulePanels = () => [...document.querySelectorAll('[data-schedule-panel]')];
      const normalizeScheduleIds = () => schedulePanels().forEach((panel, index) => {
        const panelId = `bfr-schedule-panel-${index + 1}`;
        panel.id = panelId;
        panel.querySelectorAll('button[data-schedule-shift]').forEach(button => {
          const shift = button.dataset.scheduleShift;
          const view = panel.querySelector(`[data-schedule-view="${shift}"]`);
          button.id = `${panelId}-tab-${shift}`;
          button.setAttribute('aria-controls', `${panelId}-${shift}`);
          if (view) {
            view.id = `${panelId}-${shift}`;
            view.setAttribute('aria-labelledby', button.id);
          }
        });
      });
      const labelControls = () => {
        document.querySelectorAll('textarea[name="note"]').forEach(control => control.setAttribute('aria-label', 'Nota da prioridade'));
        document.querySelectorAll('[data-bfr-staff-birthday-form]').forEach(form => {
          form.querySelector('select[name="profile_id"]')?.setAttribute('aria-label', 'Professor ou membro da equipe');
          form.querySelector('input[name="birth_date"]')?.setAttribute('aria-label', 'Data de nascimento');
        });
      };
      const repairScheduleLinks = () => {
        const replacements = [
          ['horario-matutino-2026.pdf', 'horario-matutino-2026.png', 'Abrir imagem do horário matutino ↗'],
          ['horario-vespertino-2026.pdf', 'horario-vespertino-2026.png', 'Abrir imagem do horário vespertino ↗']
        ];
        replacements.forEach(([from, to, label]) => document.querySelectorAll(`a[href$="${from}"]`).forEach(link => {
          link.href = to;
          link.textContent = label;
        }));
        document.querySelectorAll('a[href$="calendario-letivo-2026.pdf"], a[aria-disabled="true"]').forEach(link => {
          if (!/calendário/i.test(link.textContent || '')) return;
          link.href = 'calendario-letivo-2026.pdf';
          link.removeAttribute('aria-disabled');
          link.removeAttribute('tabindex');
          link.textContent = 'Abrir calendário letivo 2026 ↗';
        });
      };
      const run = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          normalizeScheduleIds();
          labelControls();
          repairScheduleLinks();
        });
      };
      run();
      new MutationObserver(run).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
  <script>
    (() => {
      const enableCalendarLink = () => document.querySelectorAll('a[aria-disabled="true"]').forEach(link => {
        if (!/calendário/i.test(link.textContent || '')) return;
        link.href = 'calendario-letivo-2026.pdf';
        link.removeAttribute('aria-disabled');
        link.removeAttribute('tabindex');
        link.textContent = 'Abrir calendário letivo 2026 ↗';
      });
      enableCalendarLink();
      new MutationObserver(enableCalendarLink).observe(document.body, { childList:true, subtree:true });
    })();
  </script>
  <script>
    (() => {
      const updatePrivacy = () => document.querySelectorAll('.legal-copy').forEach(copy => {
        const title = copy.parentElement?.querySelector('h2');
        if (!title || title.textContent.trim() !== 'Privacidade e LGPD' || copy.dataset.lgpdReady) return;
        copy.dataset.lgpdReady = 'true';
        copy.innerHTML = `<p>O BFR Conecta deve ser usado somente pela comunidade escolar autorizada.</p><p>Os dados de alunos, responsáveis, notas, frequência, fotos, inclusão, AEE, ocorrências e portaria são tratados apenas para educação, comunicação escolar, segurança e cumprimento das obrigações da rede.</p><h3>Base e finalidade</h3><p>O tratamento deve se apoiar nas bases legais aplicáveis ao poder público e à educação, no cumprimento de obrigação legal e na proteção da vida e da segurança. Consentimento deve ser solicitado quando realmente necessário, como em usos opcionais de imagem ou notificações.</p><h3>Compartilhamento e proteção</h3><p>O acesso é separado por perfil e limitado à necessidade de cada função. Os dados podem ser compartilhados somente com a escola, a Secretaria de Educação e fornecedores contratados que precisem operar o serviço. Não há venda de dados.</p><h3>Direitos da comunidade</h3><p>O titular ou responsável pode solicitar confirmação, acesso, correção, informação sobre compartilhamentos e demais direitos previstos na LGPD, observadas as obrigações de guarda. Procure a secretaria ou a coordenação da Escola Benício Ferreira Reis.</p><h3>Retenção e contato</h3><p>Os dados devem ser mantidos pelo período necessário à matrícula, ao acompanhamento escolar e às obrigações legais, seguindo a política de retenção da rede. O controlador e o encarregado pelo tratamento devem ser identificados pela Secretaria Municipal de Educação em um canal institucional antes da entrada em produção.</p>`;
      });
      updatePrivacy();
      new MutationObserver(updatePrivacy).observe(document.body, { childList:true, subtree:true });
    })();
  </script>
  <script id="bfr-core-fallbacks">
    (() => {
      const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
      const client = () => window.BFR_SUPABASE_CLIENT || (typeof supabaseClient !== 'undefined' ? supabaseClient : null);
      const userId = () => typeof currentUser !== 'undefined' ? currentUser?.id : null;
      const role = () => typeof currentProfile !== 'undefined' ? currentProfile?.role : '';
      const fallbackStyle = () => {
        if (document.getElementById('bfr-core-fallback-style')) return;
        const style = document.createElement('style');
        style.id = 'bfr-core-fallback-style';
        style.textContent = `.bfr-fallback-hero{padding:25px;border-radius:18px;color:#fff;background:linear-gradient(120deg,#10295f,#1769d2 58%,#24b7a1);box-shadow:0 15px 32px rgba(16,41,95,.14)}.bfr-fallback-hero h1{margin-top:6px;color:#fff;font:700 clamp(25px,3vw,38px) 'Playfair Display',serif}.bfr-fallback-hero p{max-width:680px;margin-top:8px;color:rgba(255,255,255,.82);font-size:11px;line-height:1.55}.bfr-fallback-kpis,.bfr-fallback-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:11px;margin-top:16px}.bfr-fallback-kpi,.bfr-fallback-card{padding:15px;border:1px solid #dbe5f1;border-radius:14px;background:#fff;box-shadow:0 7px 18px rgba(43,67,115,.05)}.bfr-fallback-kpi span,.bfr-fallback-card small{display:block;color:#71809a;font-size:10px}.bfr-fallback-kpi strong{display:block;margin-top:6px;color:#1558bd;font:700 25px 'DM Mono',monospace}.bfr-fallback-card h3{margin:6px 0;color:#173b79;font:700 17px 'Playfair Display',serif}.bfr-fallback-card p{margin:0;color:#63738f;font-size:10px;line-height:1.5}.bfr-fallback-card button{margin-top:12px;border:1px solid #cfe0fb;border-radius:9px;padding:8px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:800}.bfr-fallback-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.bfr-fallback-toolbar input,.bfr-fallback-toolbar select{min-width:170px;border:1px solid #dbe5f1;border-radius:9px;padding:9px;color:#243856;background:#fff;font-size:10px}.bfr-fallback-note{margin-top:12px;padding:11px 13px;border:1px solid #d7e8e3;border-radius:10px;color:#35675c;background:#f3fbf8;font-size:10px;line-height:1.45}.bfr-fallback-empty{padding:15px;border:1px dashed #cbdceb;border-radius:11px;color:#71809a;background:#fbfdff;font-size:10px}.bfr-fallback-hidden{display:none!important}@media(max-width:600px){.bfr-fallback-hero{padding:20px}.bfr-fallback-kpis,.bfr-fallback-grid{grid-template-columns:1fr 1fr}.bfr-fallback-toolbar input,.bfr-fallback-toolbar select{min-width:0;width:100%}}@media(max-width:420px){.bfr-fallback-kpis,.bfr-fallback-grid{grid-template-columns:1fr}}`;
        document.head.appendChild(style);
      };
      const hideContent = except => document.querySelectorAll('#appShell .content').forEach(view => view.classList.toggle('hidden', view !== except));

      const foodState = { filter:'all', query:'' };
      const foodCards = [
        ['water','💧','Hidratação','Tenha água por perto e observe como a hidratação ajuda na atenção durante o dia.'],
        ['color','🌈','Prato colorido','Combine cores e grupos de alimentos para conversar sobre variedade e equilíbrio.'],
        ['movement','🏃','Movimento','Inclua pausas ativas e movimentos seguros entre os momentos de estudo.'],
        ['lunch','🍎','Lanche consciente','Escolha o lanche com calma, respeitando a rotina e as orientações da família.']
      ];
      const foodProgress = () => { try { return JSON.parse(localStorage.getItem('bfr-food-progress') || '{}'); } catch { return {}; } };
      function renderFoodCards(view) {
        const progress = foodProgress();
        const term = foodState.query.toLocaleLowerCase('pt-BR');
        view.querySelector('[data-food-grid]').innerHTML = foodCards.map(([id,icon,title,copy]) => {
          const visible = (foodState.filter === 'all' || (foodState.filter === 'done') === Boolean(progress[id])) && (!term || `${title} ${copy}`.toLocaleLowerCase('pt-BR').includes(term));
          return `<article class="bfr-fallback-card ${visible ? '' : 'bfr-fallback-hidden'}" data-food-card><small>${icon} trilha de aprendizagem</small><h3>${title}</h3><p>${copy}</p><button type="button" data-food-action="${id}">${progress[id] ? '✓ Registrado hoje' : 'Registrar hoje'}</button></article>`;
        }).join('') || '<div class="bfr-fallback-empty">Nenhum conteúdo encontrado.</div>';
        view.querySelector('[data-food-count]').textContent = `${Object.keys(progress).length}/${foodCards.length} registros de hoje`;
      }
      function openHealthyFood() {
        const view = document.getElementById('healthyFoodView');
        if (!view) return;
        fallbackStyle();
        hideContent(view);
        view.classList.remove('hidden');
        if (!view.dataset.foodReady) {
          view.dataset.foodReady = 'true';
          view.innerHTML = `<div class="bfr-fallback-hero"><div class="eyebrow" style="color:#bfe7e0">Projetos da escola · aprendizagem para a vida</div><h1>Alimentação Saudável</h1><p>Conteúdos educativos para conversar sobre hidratação, variedade, movimento e escolhas possíveis, sempre respeitando a realidade de cada família.</p></div><div class="bfr-fallback-kpis"><div class="bfr-fallback-kpi"><span>Trilhas disponíveis</span><strong>${foodCards.length}</strong></div><div class="bfr-fallback-kpi"><span>Registro local de hoje</span><strong data-food-count>0/${foodCards.length}</strong></div></div><section class="panel" style="margin-top:16px"><div class="panel-heading"><div><div class="eyebrow">Explorar</div><h2 style="margin-top:4px">Pequenas escolhas, bons hábitos</h2></div></div><div class="bfr-fallback-toolbar"><select data-food-filter aria-label="Filtrar conteúdos"><option value="all">Todos os conteúdos</option><option value="done">Registrados hoje</option><option value="open">Ainda não registrados</option></select><input type="search" data-food-search placeholder="Buscar conteúdo" aria-label="Buscar conteúdo"></div><div class="bfr-fallback-grid" data-food-grid></div><p class="bfr-fallback-note">Este registro fica somente neste dispositivo. Ele não substitui orientação profissional nem cria informação médica.</p></section>`;
          view.addEventListener('click', event => {
            const action = event.target.closest('[data-food-action]');
            if (!action) return;
            const progress = foodProgress();
            if (progress[action.dataset.foodAction]) delete progress[action.dataset.foodAction]; else progress[action.dataset.foodAction] = true;
            localStorage.setItem('bfr-food-progress', JSON.stringify(progress));
            renderFoodCards(view);
          });
          view.querySelector('[data-food-filter]').addEventListener('change', event => { foodState.filter = event.target.value; renderFoodCards(view); });
          view.querySelector('[data-food-search]').addEventListener('input', event => { foodState.query = event.target.value; renderFoodCards(view); });
        }
        renderFoodCards(view);
        document.querySelector('.breadcrumb b')?.replaceChildren(document.createTextNode('Alimentação Saudável'));
        window.scrollTo({top:0,behavior:'instant'});
      }
      window.bfrOpenHealthyFood = openHealthyFood;

      const aeeActivities = [
        ['Língua Portuguesa','Notícia em três pistas','Localizar informações e organizar uma notícia curta.'],
        ['Matemática','Mercado das frações','Comparar frações em situações de compra e escolha.'],
        ['Ciências','Sistema em equilíbrio','Relacionar sono, alimentação, movimento e atenção.'],
        ['História','Linha do tempo falante','Organizar acontecimentos e explicar relações temporais.'],
        ['Geografia','Mapa do território vivido','Identificar lugares e trajetos da comunidade.'],
        ['Educação Inclusiva','Jornal da inclusão','Reconhecer barreiras e propor soluções acessíveis.']
      ];
      const aeeRows = { items:[], loading:false, error:'' };
      function renderAeeRoster(view) {
        const panel = view.querySelector('[data-bfr-aee-roster]');
        const grid = panel?.querySelector('[data-aee-roster-grid]');
        if (!panel || !grid) return;
        const term = panel.querySelector('[data-aee-roster-search]').value.toLocaleLowerCase('pt-BR').trim();
        const rows = aeeRows.items.filter(item => !term || `${item.name} ${item.class_code} ${item.observation}`.toLocaleLowerCase('pt-BR').includes(term));
        panel.querySelector('[data-aee-roster-count]').textContent = `${rows.length} aluno${rows.length === 1 ? '' : 's'}`;
        grid.innerHTML = aeeRows.error ? `<div class="bfr-fallback-empty">${esc(aeeRows.error)}</div>` : rows.length ? rows.map(item => `<article class="bfr-fallback-card"><small>${esc(item.year)}º ano · Turma ${esc(item.class_code)}</small><h3>${esc(item.name)}</h3><p>${esc(item.observation || 'Acompanhamento AEE ativo.')}</p></article>`).join('') : '<div class="bfr-fallback-empty">Nenhum aluno disponível para esta conta ou filtro.</div>';
      }
      async function loadAeeRoster(view) {
        const db = client();
        if (!db || !userId()) { aeeRows.error = 'A lista protegida aparece após a autenticação da equipe autorizada.'; renderAeeRoster(view); return; }
        aeeRows.loading = true;
        const result = await db.from('aee_student_roster').select('id,year,class_code,observation,students(official_name)').eq('active',true).order('year').order('class_code');
        aeeRows.loading = false;
        aeeRows.error = result.error ? 'A lista AEE não pôde ser carregada. Verifique a permissão do perfil.' : '';
        aeeRows.items = (result.data || []).map(item => ({ name:item.students?.official_name || 'Aluno sem nome', year:item.year || '—', class_code:item.class_code || '—', observation:item.observation || '' }));
        renderAeeRoster(view);
      }
      function setupAeeModule() {
        const view = document.getElementById('aeeView');
        if (!view) return;
        fallbackStyle();
        view.classList.remove('hidden');
        if (view.dataset.aeeFallbackReady) { renderAeeRoster(view); return; }
        view.dataset.aeeFallbackReady = 'true';
        view.innerHTML = `<section class="bfr-fallback-hero aee-hero"><div class="eyebrow" style="color:#bfe7e0">Atendimento Educacional Especializado · BFR Conecta</div><h1>AEE com acompanhamento protegido.</h1><p>Organize os recursos, a rotina e os registros necessários para apoiar a participação e a aprendizagem dos estudantes acompanhados pela equipe autorizada.</p></section><div class="bfr-fallback-kpis"><div class="bfr-fallback-kpi"><span>Recursos adaptados</span><strong>${aeeActivities.length}</strong></div><div class="bfr-fallback-kpi"><span>Dados sensíveis</span><strong>Protegidos</strong></div><div class="bfr-fallback-kpi"><span>Ano letivo</span><strong>2026</strong></div></div><section class="panel" data-aee-section="schedule" style="margin-top:16px"><div class="panel-heading"><div><div class="eyebrow">Rotina escolar</div><h2 style="margin-top:4px">Horários oficiais</h2></div></div><p class="agenda-intro">Consulte a Central de Horários para confirmar turma, turno, dia e período. O AEE não replica nem altera a grade oficial.</p><button class="text-button" type="button" data-aee-go-schedule>Ver horários das aulas ↗</button></section><section class="panel" data-aee-section="library" data-bfr-aee-library><div class="panel-heading"><div><div class="eyebrow">Recursos prontos</div><h2 style="margin-top:4px">Atividades adaptadas multidisciplinares</h2></div><span class="agenda-count">${aeeActivities.length} propostas</span></div><div class="bfr-fallback-grid">${aeeActivities.map((item,index) => `<article class="bfr-fallback-card"><small>${esc(item[0])}</small><h3>${esc(item[1])}</h3><p>${esc(item[2])}</p><button type="button" data-aee-activity="${index}">Ver orientação</button><p class="bfr-fallback-note bfr-fallback-hidden" data-aee-detail="${index}">Use apoio visual, tempo flexível e resposta em texto, áudio ou imagem conforme a necessidade do estudante.</p></article>`).join('')}</div></section><section class="panel" data-aee-section="family" style="margin-top:16px"><div class="panel-heading"><div><div class="eyebrow">Comunicação responsável</div><h2 style="margin-top:4px">Orientações para a família</h2></div></div><p class="agenda-intro">Registros pedagógicos devem ser compartilhados somente pelos canais autorizados da escola. Procure a coordenação ou a Secretaria para atualizar vínculos e documentos.</p></section><section class="panel" data-bfr-aee-roster style="margin-top:16px"><div class="panel-heading"><div><div class="eyebrow">Cadastro protegido · AEE 2026</div><h2 style="margin-top:4px">Alunos acompanhados pelo AEE</h2></div><span class="agenda-count" data-aee-roster-count>0 alunos</span></div><div class="bfr-fallback-toolbar"><input type="search" data-aee-roster-search placeholder="Buscar aluno ou observação" aria-label="Buscar aluno AEE"></div><div class="bfr-fallback-grid" data-aee-roster-grid><div class="bfr-fallback-empty">Carregando lista protegida...</div></div></section>`;
        view.addEventListener('click', event => {
          const activity = event.target.closest('[data-aee-activity]');
          if (activity) view.querySelector(`[data-aee-detail="${activity.dataset.aeeActivity}"]`)?.classList.toggle('bfr-fallback-hidden');
          if (event.target.closest('[data-aee-go-schedule]')) document.querySelector('[data-section="horarios"]')?.click();
        });
        view.querySelector('[data-aee-roster-search]').addEventListener('input', () => renderAeeRoster(view));
        loadAeeRoster(view);
      }
      window.setupAeeModule = setupAeeModule;
    })();
  </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon="{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;7d60e9752e974792a90fee9c6959f13f&quot;,&quot;r&quot;:1,&quot;spa&quot;:2}" crossorigin="anonymous"></script>

<style id="bfr-mobile-final">
  @media (max-width:800px) {
    :root { --bfr-mobile-gutter: clamp(14px, 4vw, 20px); }
    html, body { min-width:0; overflow-x:hidden; }
    body:has(#appShell.ready) { background:#f5f7fb; }
    #appShell.ready { min-height:100vh; padding-bottom:92px !important; }
    #appShell.ready main { width:100%; min-width:0; margin-left:0; }
    #appShell.ready .sidebar { position:fixed !important; top:auto !important; right:0 !important; bottom:0 !important; left:0 !important; z-index:40; width:auto !important; height:80px !important; min-height:80px !important; max-height:none !important; padding:7px 10px calc(7px + env(safe-area-inset-bottom)) !important; border:1px solid #dbe5f1 !important; border-bottom:0 !important; border-radius:22px 22px 0 0 !important; background:rgba(255,255,255,.97) !important; box-shadow:0 -12px 32px rgba(22,55,108,.14) !important; backdrop-filter:blur(16px) saturate(1.08); overflow:visible !important; }
    #appShell.ready .sidebar > .brand,
    #appShell.ready .sidebar > .school-switch,
    #appShell.ready .sidebar > .nav-label,
    #appShell.ready .sidebar > .bfr-legacy-nav,
    #appShell.ready .sidebar > .sidebar-foot { display:none !important; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav { display:grid !important; grid-template-columns:repeat(6,minmax(0,1fr)); gap:2px; width:100%; height:64px; margin:0; padding:0; border:0; background:transparent; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .nav-item { display:none !important; position:relative; min-width:0; width:100%; height:64px; padding:6px 2px !important; border:1px solid transparent; border-radius:13px; background:transparent; color:#71809a; font-size:0 !important; line-height:1; white-space:nowrap; overflow:hidden; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .bfr-platform-nav-item,
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .bfr-platform-more { display:flex !important; align-items:center; justify-content:center; gap:4px; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .nav-icon { display:block !important; width:auto; color:inherit; font-size:18px !important; line-height:1; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .nav-icon:before { display:none !important; content:none !important; }
    #appShell.ready .sidebar > .nav-list:first-of-type .nav-icon { display:block !important; width:auto !important; font-size:18px !important; line-height:1 !important; }
    #appShell.ready .sidebar > .nav-list:first-of-type .nav-icon:before { display:none !important; content:none !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type .nav-icon { font-size:18px !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type .nav-icon:before { display:none !important; content:none !important; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .nav-item:after { display:block !important; position:static !important; width:auto !important; height:auto !important; margin-top:1px; border:0 !important; border-radius:0 !important; background:none !important; color:inherit; transform:none !important; font-size:7px; font-weight:800; line-height:1.1; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type .nav-item:after { display:block !important; position:static !important; width:auto !important; height:auto !important; background:none !important; transform:none !important; font-size:7px !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="inicio"]:after { content:'Início' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="aprender"]:after { content:'Aprender' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="evoluir"]:after { content:'Evoluir' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="escola"]:after { content:'Escola' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="meu-espaco"]:after { content:'Espaço' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type .bfr-platform-more:after { content:'Mais' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="inicio"].active:after { content:'Início' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="aprender"].active:after { content:'Aprender' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="evoluir"].active:after { content:'Evoluir' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="escola"].active:after { content:'Escola' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type [data-platform-area="meu-espaco"].active:after { content:'Espaço' !important; }
    #appShell.ready:not(.teacher-mode) .sidebar > .nav-list:first-of-type .bfr-platform-more.active:after { content:'Mais' !important; display:block !important; }
    #appShell.ready .sidebar > .nav-list:first-of-type .nav-item:not([data-section="inicio"]):not([data-section="notas"]):not([data-section="agenda"]):not([data-section="horarios"]):not([data-section="comunicados"]):not(.mobile-more-item):not(.hidden).bfr-platform-nav-item { display:flex !important; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .nav-item.active { color:#1769d2 !important; background:#edf4ff !important; border-color:#dbe9ff !important; box-shadow:0 5px 12px rgba(37,99,235,.11) !important; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .bfr-platform-more { color:#1769d2; background:#f4f8ff; border-color:#dce9fb; }
    #appShell.ready .sidebar > .nav-list.bfr-platform-nav .bfr-platform-more.active { color:#fff; background:linear-gradient(145deg,#2878e4,#1555ac); border-color:#2878e4; }
