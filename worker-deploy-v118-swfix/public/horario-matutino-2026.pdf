 <script id="bfr-lia-image-avatar">
   (() => {
     const avatarPath = 'lia-avatar.png';
     const containers = '.lia-fab-avatar,.lia-avatar,.lia-home-icon,.lia-message:not(.user) .lia-message-avatar';
     const images = '.lia-fab-avatar img,.lia-avatar img,.lia-home-icon img,.lia-message:not(.user) .lia-message-avatar img';
     const style = document.createElement('style');
     style.id = 'bfr-lia-image-avatar-style';
     style.textContent = '.lia-fab-avatar img,.lia-avatar img,.lia-home-icon img,.lia-message-avatar img{position:static!important;left:auto!important;top:auto!important;width:100%!important;height:100%!important;max-width:100%!important;object-fit:cover!important;transform:none!important}';
     document.body.appendChild(style);
     const apply = () => {
       document.querySelectorAll(images).forEach(image => {
         if (image.getAttribute('src') !== avatarPath) image.setAttribute('src', avatarPath);
         image.alt = 'Logo da LIA';
       });
       document.querySelectorAll(containers).forEach(container => {
         if (!container.querySelector('img')) container.innerHTML = `<img src="${avatarPath}" alt="Logo da LIA">`;
       });
     };
     apply();
      new MutationObserver(apply).observe(document.body, {childList:true, subtree:true, attributes:true, attributeFilter:['src']});
     window.bfrApplyLiaImageAvatar = apply;
   })();
 </script>
<script id="bfr-aee-pdi-entry">
  (() => {
    const inject = () => {
      const hero = document.querySelector('#aeeView .aee-hero');
      if (!hero || hero.querySelector('[data-aee-pdi-lia]')) return;
      hero.insertAdjacentHTML('beforeend', '<div class="bfr-direction-actions" data-aee-pdi-lia><button type="button" data-lia-open>🧩 Criar PDI ou adaptação curricular com a LIA</button></div>');
    };
    inject();
    new MutationObserver(inject).observe(document.body, { childList:true, subtree:true });
  })();
 </script>
 <script id="bfr-final-published-asset-fix">(()=>{const style=document.createElement('style');style.textContent='.login-message:before,.login-message:after,.login-message,.login-form,.login-layout,.school-symbol-wrap{background-image:none!important}';document.head.appendChild(style);document.querySelectorAll('#teacherMessageForm textarea:not([aria-label])').forEach(el=>el.setAttribute('aria-label','Recado para a professora da turma'));})();</script>
<script id="bfr-coordination-realtime-v2">
  (() => {
    const start = () => {
      const view = document.getElementById('coordinatorView');
      const client = window.BFR_SUPABASE_CLIENT;
      if (!view || view.classList.contains('hidden') || !client?.channel) { setTimeout(start, 1500); return; }
      if (window.__bfrCoordinationRealtime) return;
      const live = () => view.querySelector('[data-coord-live-status]');
      const host = view.querySelector('[data-bfr-coordination-command]');
      if (host && !live()) host.querySelector('[data-coord-sync]')?.insertAdjacentHTML('afterend', '<span class="bfr-coordination-sync" data-coord-live-status>Conectando ao vivo...</span>');
       const subscribe = window.BFRSubscribeWithRecovery;
       if (typeof subscribe !== 'function') { setTimeout(start, 1500); return; }
       const channel = subscribe('bfr-coordination-command-live-v2', channel => channel
         .on('postgres_changes',{event:'*',schema:'public',table:'attendance'},() => window.bfrCoordinationCommand?.load(true))
         .on('postgres_changes',{event:'*',schema:'public',table:'occurrences'},() => window.bfrCoordinationCommand?.load(true))
         .on('postgres_changes',{event:'*',schema:'public',table:'school_activities'},() => window.bfrCoordinationCommand?.load(true))
         .on('postgres_changes',{event:'*',schema:'public',table:'projects'},() => window.bfrCoordinationCommand?.load(true))
         .on('postgres_changes',{event:'*',schema:'public',table:'announcements'},() => window.bfrCoordinationCommand?.load(true)), status => { const target = live(); if (target) target.textContent = status === 'SUBSCRIBED' ? '● ao vivo' : status === 'CLOSED' ? '○ offline' : '○ reconectando'; });
      window.__bfrCoordinationRealtime = channel;
    };
    start();
  })();
</script>
</body></html>
