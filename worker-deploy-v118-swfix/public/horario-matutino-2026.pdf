     @keyframes bfrSectionSwap { from { opacity:.58; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
     @keyframes bfrModalFade { from { opacity:0; } to { opacity:1; } }
     @keyframes bfrModalCard { from { opacity:0; transform:translateY(14px) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }
     @keyframes bfrRipple { to { opacity:0; transform:translate(-50%,-50%) scale(18); } }
