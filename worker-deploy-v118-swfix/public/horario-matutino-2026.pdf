        const gameState = { subject:null, index:0, score:0, answered:false, finished:false };
        function renderGameQuestion(panel) {
          const questions = gameQuestionBank[gameState.subject] || [];
          const play = panel?.querySelector('[data-game-play]');
          if (!play || !questions.length) return;
          play.classList.remove('hidden');
          play.querySelector('[data-game-title]').textContent = gameState.subject;
          play.querySelector('[data-game-score]').textContent = `Pergunta ${gameState.index + 1} de ${questions.length} · ${gameState.score} ponto${gameState.score === 1 ? '' : 's'}`;
          const question = questions[gameState.index];
          play.querySelector('[data-game-question]').textContent = question.q;
          play.querySelector('[data-game-options]').innerHTML = question.o.map((option,index) => `<button class="game-option" type="button" data-game-option="${index}">${escapeHtml(option)}</button>`).join('');
          play.querySelector('[data-game-feedback]').textContent = '';
          const next = play.querySelector('[data-game-next]');
          next.style.display = 'none';
          next.textContent = 'Próxima pergunta';
          gameState.answered = false;
          gameState.finished = false;
        }
        function renderGameResult(panel) {
          const play = panel.querySelector('[data-game-play]');
          const total = gameQuestionBank[gameState.subject]?.length || 0;
          play.querySelector('[data-game-score]').textContent = `${gameState.score} de ${total} pontos`;
          play.querySelector('[data-game-question]').textContent = 'Parabéns por participar! Quer tentar novamente?';
          play.querySelector('[data-game-options]').innerHTML = '';
          play.querySelector('[data-game-feedback]').textContent = 'Escolha outra matéria ou jogue novamente para revisar.';
           const next = play.querySelector('[data-game-next]');
           next.style.display = 'inline-block';
           next.textContent = 'Jogar novamente';
           recordStudentGameResult();
           gameState.finished = true;
        }
        function setupGames() {
          ensureLearningViews();
          if (document.body.dataset.gamesReady) return;
          document.body.dataset.gamesReady = 'true';
          document.addEventListener('click', event => {
            const subjectButton = event.target.closest('[data-game-subject]');
            if (subjectButton) {
              gameState.subject = subjectButton.dataset.gameSubject;
              gameState.index = 0;
              gameState.score = 0;
              document.querySelectorAll('[data-game-subject]').forEach(button => button.classList.toggle('active', button === subjectButton));
              renderGameQuestion(subjectButton.closest('[data-games-panel]'));
              return;
            }
            const option = event.target.closest('[data-game-option]');
            if (option && !gameState.answered) {
              const question = gameQuestionBank[gameState.subject]?.[gameState.index];
              if (!question) return;
              gameState.answered = true;
               const correct = Number(option.dataset.gameOption) === question.a;
               option.classList.add(correct ? 'correct' : 'wrong');
               const play = option.closest('[data-game-play]');
               if (!correct) play.querySelector(`[data-game-option="${question.a}"]`)?.classList.add('correct');
               if (correct) gameState.score += 1;
               play.querySelector('[data-game-feedback]').textContent = correct ? 'Resposta certa!' : `A resposta correta é “${question.o[question.a]}”.`;
              const next = play.querySelector('[data-game-next]');
              next.style.display = 'inline-block';
              next.textContent = gameState.index === (gameQuestionBank[gameState.subject].length - 1) ? 'Ver resultado' : 'Próxima pergunta';
              play.querySelector('[data-game-score]').textContent = `Pergunta ${gameState.index + 1} de ${gameQuestionBank[gameState.subject].length} · ${gameState.score} ponto${gameState.score === 1 ? '' : 's'}`;
              return;
            }
            const next = event.target.closest('[data-game-next]');
            if (next) {
              const panel = next.closest('[data-games-panel]');
              if (gameState.finished) { gameState.index = 0; gameState.score = 0; renderGameQuestion(panel); return; }
              if (gameState.index >= (gameQuestionBank[gameState.subject]?.length || 1) - 1) { renderGameResult(panel); return; }
              gameState.index += 1;
              renderGameQuestion(panel);
            }
          });
        }
        const officialSubjects = ['Língua Portuguesa','Matemática','Ciências','História','Geografia','Língua Inglesa','Arte','Educação Física','Ensino Religioso'];
       const academicState = { classId:null, students:[], grades:[], attendance:[], tab:'grades' };
      function renderAcademicTable() {
        const table = document.getElementById('academicTable');
        const empty = document.getElementById('academicEmpty');
        if (!table || !empty) return;
        const isAttendance = academicState.tab === 'attendance';
        document.getElementById('attendanceControls')?.classList.toggle('hidden', !isAttendance);
        table.querySelector('thead').innerHTML = isAttendance ? '<tr><th>Aluno</th><th>Dias registrados</th><th>Presença</th><th>Faltas</th><th>Hoje</th></tr>' : '<tr><th>Aluno</th><th>Média</th><th>Última avaliação</th><th>Bimestre</th></tr>';
        if (!academicState.students.length) {
          table.classList.add('hidden');
          empty.textContent = isAttendance ? 'Nenhum aluno ativo nesta turma.' : 'Nenhum aluno ativo nesta turma.';
          empty.classList.remove('hidden');
          return;
        }
        table.classList.remove('hidden');
        empty.classList.add('hidden');
        table.querySelector('tbody').innerHTML = academicState.students.map(student => {
          const grades = academicState.grades.filter(grade => grade.student_id === student.id);
          const attendance = academicState.attendance.filter(item => item.student_id === student.id);
          const average = grades.length ? (grades.reduce((sum, grade) => sum + Number(grade.score), 0) / grades.length).toFixed(1).replace('.', ',') : '—';
          const latest = [...grades].sort((a,b) => new Date(b.created_at) - new Date(a.created_at))[0];
          const present = attendance.filter(item => item.status === 'present' || item.status === 'late').length;
          const absent = attendance.filter(item => item.status === 'absent').length;
          const rate = attendance.length ? `${Math.round((present / attendance.length) * 1000) / 10}%` : '—';
          const date = document.getElementById('attendanceDate')?.value;
           const todayStatus = attendance.find(item => item.attendance_date === date)?.status || '';
           const statusOptions = `<option value="" ${todayStatus ? '' : 'selected'}>Não registrado</option>${[['present','Presente'],['late','Atrasado'],['absent','Falta'],['justified','Justificada']].map(([value,label]) => `<option value="${value}" ${todayStatus === value ? 'selected' : ''}>${label}</option>`).join('')}`;
          const name = escapeHtml(student.official_name);
          return isAttendance ? `<tr><td><div class="student-name"><span class="avatar">${escapeHtml(student.official_name.split(/\s+/).map(part => part[0]).slice(0,2).join(''))}</span>${name}</div></td><td>${attendance.length || '—'}</td><td><span class="attendance-pill">${rate}</span></td><td>${absent || '—'}</td><td><select class="attendance-select" data-attendance-student="${student.id}" aria-label="Frequência de ${name}">${statusOptions}</select></td></tr>` : `<tr><td><div class="student-name"><span class="avatar">${escapeHtml(student.official_name.split(/\s+/).map(part => part[0]).slice(0,2).join(''))}</span>${name}</div></td><td><span class="grade">${average}</span></td><td>${latest ? `${escapeHtml(latest.subject)} · ${Number(latest.score).toFixed(1).replace('.', ',')}` : 'Sem lançamentos'}</td><td>${latest ? `${latest.term}º` : '—'}</td></tr>`;
        }).join('');
      }
      async function saveAttendance() {
        const date = document.getElementById('attendanceDate')?.value;
        const button = document.getElementById('saveAttendanceBtn');
        const message = document.getElementById('attendanceSaveStatus');
         const entries = [...document.querySelectorAll('[data-attendance-student]')].filter(select => select.value).map(select => ({ student_id:select.dataset.attendanceStudent, attendance_date:date, status:select.value, entered_by:currentUser.id }));
        if (!date || !entries.length) return;
        button.disabled = true;
        message.textContent = 'Salvando...';
        const { data, error } = await supabaseClient.from('attendance').upsert(entries, { onConflict:'student_id,attendance_date' }).select('student_id,attendance_date,status');
        if (error) {
          message.textContent = 'Não foi possível salvar. Tente novamente.';
          button.disabled = false;
          return;
        }
        academicState.attendance = academicState.attendance.filter(item => item.attendance_date !== date).concat(data || entries);
        message.textContent = 'Frequência salva.';
        button.disabled = false;
        renderAcademicTable();
      }
      function setupGradeForm() {
        const form = document.getElementById('activityForm');
        if (!form || form.dataset.realGradeForm) return;
        form.dataset.realGradeForm = 'true';
        document.querySelector('#activityModal .eyebrow').textContent = 'Notas · 6º ano A';
        document.querySelector('#activityModal h2').textContent = 'Lançar nota';
        document.getElementById('activitySuccess').textContent = 'Nota registrada no Supabase. A turma já pode consultar o lançamento.';
         form.innerHTML = `<label>Aluno<select id="gradeStudent" required></select></label><label>Componente curricular<select id="gradeSubject" required>${officialSubjects.map(subject => `<option>${subject}</option>`).join('')}</select></label><label>Nome da avaliação<input id="gradeAssessment" required placeholder="Ex.: Prova de frações"></label><label>Nota (0 a 10)<input id="gradeScore" type="number" min="0" max="10" step="0.1" required placeholder="Ex.: 8,5"></label><label>Bimestre<select id="gradeTerm" required><option value="1">1º bimestre</option><option value="2">2º bimestre</option><option value="3">3º bimestre</option><option value="4">4º bimestre</option></select></label><button class="primary-button" type="submit" style="width:100%;margin-top:8px">Salvar nota</button><p id="gradeFormError" class="hidden" style="font-size:11px;color:#b8644f;margin-top:10px"></p>`;
        const select = document.getElementById('gradeStudent');
        select.innerHTML = academicState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)}</option>`).join('');
      }
      async function submitGrade(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const error = document.getElementById('gradeFormError');
        const scoreField = document.getElementById('gradeScore');
        if (!scoreField) return;
         const score = Number(scoreField.value.replace(',', '.'));
         if (!academicState.classId || !currentUser || !Number.isFinite(score) || score < 0 || score > 10) {
           error.textContent = 'Informe uma nota entre 0 e 10.';
           error.classList.remove('hidden');
           return;
         }
         const term = Number(document.getElementById('gradeTerm').value);
         if (!Number.isInteger(term) || term < 1 || term > 4) {
           error.textContent = 'Selecione um bimestre entre o 1º e o 4º.';
           error.classList.remove('hidden');
           return;
         }
         const payload = { student_id:document.getElementById('gradeStudent').value, subject:document.getElementById('gradeSubject').value, assessment:document.getElementById('gradeAssessment').value.trim(), score, term, entered_by:currentUser.id };
        const { data, error: insertError } = await supabaseClient.from('grades').insert(payload).select('student_id,subject,assessment,score,term,created_at').single();
        if (insertError) {
          error.textContent = 'Não foi possível salvar a nota. Tente novamente.';
          error.classList.remove('hidden');
          return;
        }
        academicState.grades.unshift(data);
        document.getElementById('academicStatus').textContent = `${academicState.students.length} alunos · ${academicState.grades.length} notas`;
        renderAcademicTable();
        form.classList.add('hidden');
        document.getElementById('activitySuccess').classList.remove('hidden');
      }
      function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value;
        return element.innerHTML;
      }
         function normalizeSubjectDisplays() {
          const report = document.querySelector('#boletimPanel .report-table');
          if (report) report.innerHTML = '<div class="report-row report-header"><span>Componente</span><span>1º bim.</span><span>2º bim.</span><span>3º bim.</span><span>4º bim.</span><span>Média</span></div><div class="data-empty-inline">As notas aparecerão após o lançamento pela escola.</div>';
        const activitySubject = document.querySelector('#activityForm select');
        if (activitySubject) activitySubject.innerHTML = officialSubjects.map(subject => `<option>${subject}</option>`).join('');
       }
        normalizeSubjectDisplays();
         async function reportPdfBlob(rows) {
           const JsPDF = await getPdfConstructor();
          const doc = new JsPDF({ unit:'mm', format:'a4' });
          const pageWidth = 210;
          const columns = [
            { label:'Aluno', width:43 },
            { label:'Componente curricular', width:42 },
            { label:'Avaliação', width:40 },
            { label:'Nota', width:22 },
            { label:'Bimestre', width:32 }
          ];
          const left = 15;
          const tableWidth = columns.reduce((sum,column) => sum + column.width,0);
          doc.setFillColor(239,247,243);
          doc.rect(0,0,pageWidth,297,'F');
          doc.setFillColor(255,255,255);
          doc.roundedRect(10,10,190,277,5,5,'F');
          doc.setTextColor(22,86,167);
          doc.setFont('helvetica','bold');
          doc.setFontSize(11);
          doc.text('BFR CONECTA',left,25);
          doc.setTextColor(23,33,31);
          doc.setFontSize(22);
          doc.text('Boletim Escolar',left,37);
          doc.setTextColor(115,129,126);
          doc.setFont('helvetica','normal');
          doc.setFontSize(9);
          doc.text(`Gerado em ${new Date().toLocaleDateString('pt-BR')}`,left,45);
          let y = 54;
          const drawHeader = () => {
            doc.setFillColor(22,86,167);
            doc.roundedRect(left,y,tableWidth,9,2,2,'F');
            doc.setTextColor(255,255,255);
            doc.setFont('helvetica','bold');
            doc.setFontSize(8);
            let x = left;
            columns.forEach(column => { doc.text(column.label,x + 2,y + 5.8); x += column.width; });
            y += 9;
          };
          drawHeader();
          rows.slice(1).forEach((row,index) => {
            const values = columns.map((_,columnIndex) => String(row[columnIndex] ?? ''));
            const lines = values.map((value,columnIndex) => doc.splitTextToSize(value,columns[columnIndex].width - 4));
            const rowHeight = Math.max(8, ...lines.map(line => line.length * 3.7 + 4));
            if (y + rowHeight > 276) { doc.addPage(); y = 18; drawHeader(); }
            if (index % 2 === 0) { doc.setFillColor(246,250,248); doc.rect(left,y,tableWidth,rowHeight,'F'); }
            doc.setDrawColor(218,231,224);
            doc.setLineWidth(0.2);
            doc.line(left,y + rowHeight,left + tableWidth,y + rowHeight);
            doc.setTextColor(23,33,31);
            doc.setFontSize(8);
            let x = left;
            lines.forEach((line,columnIndex) => { doc.setFont('helvetica',columnIndex === 0 ? 'bold' : 'normal'); doc.text(line,x + 2,y + 5); x += columns[columnIndex].width; });
            y += rowHeight;
          });
          doc.setTextColor(115,129,126);
          doc.setFont('helvetica','normal');
          doc.setFontSize(8);
          doc.text('Documento emitido pelo BFR Conecta.',left,279);
          return doc.output('blob');
        }
       async function setupAdminView() {
         const results = await Promise.all([
           supabaseClient.from('students').select('id',{count:'exact',head:true}).eq('active',true),
           supabaseClient.from('classes').select('id',{count:'exact',head:true}),
           supabaseClient.from('profiles').select('id',{count:'exact',head:true})
         ]);
         const [studentsResult, classesResult, accountsResult] = results;
         if (studentsResult.error || classesResult.error || accountsResult.error) return;
         document.getElementById('adminStudentCount').textContent = (studentsResult.count || 0).toLocaleString('pt-BR');
         document.getElementById('adminClassCount').textContent = classesResult.count || 0;
         document.getElementById('adminAccountCount').textContent = accountsResult.count || 0;
         ensureRoleManagementView();
          setupRoleManagement();
        }
           const adminStudentState = { students:[], classes:[], selectedId:'', profile:null, profiles:[], programs:[], loaded:false, loading:false };
          const adminStudentDraftKey = 'bfr-admin-student-draft';
          let adminStudentFormDirty = false;
         function saveAdminStudentDraft(form) {
           if (!form) return;
            const names = ['student_id','official_name','class_id','birth_date','guardian_name','guardian_cpf','guardian_phone','emergency_contact','address_line','inclusion_needs','inclusion_plan','inclusion_observations'];
           const draft = { programs:[...form.querySelectorAll('[name="program_slug"]:checked')].map(input => input.value) };
           names.forEach(name => { const field = form.elements.namedItem(name); if (field) draft[name] = field.value; });
           try { sessionStorage.setItem(adminStudentDraftKey, JSON.stringify(draft)); } catch {}
         }
         function restoreAdminStudentDraft(form, studentId = '') {
           let draft;
           try { draft = JSON.parse(sessionStorage.getItem(adminStudentDraftKey) || 'null'); } catch { draft = null; }
           if (!draft || String(draft.student_id || '') !== String(studentId || '')) return false;
           Object.entries(draft).forEach(([name,value]) => { if (name === 'programs') return; const field = form.elements.namedItem(name); if (field) field.value = value || ''; });
            form.querySelectorAll('[name="program_slug"]').forEach(input => { input.checked = (draft.programs || []).includes(input.value); });
            adminStudentFormDirty = true;
            return true;
          }
          function clearAdminStudentDraft() { adminStudentFormDirty = false; try { sessionStorage.removeItem(adminStudentDraftKey); } catch {} }
         function adminStudentClassLabel(student) {
          const nested = Array.isArray(student?.classes) ? student.classes[0] : student?.classes;
          const classData = nested || adminStudentState.classes.find(item => item.id === student?.class_id);
          return classData ? `${classData.year}º ano ${classData.class_code}` : 'Turma não informada';
        }
         function adminStudentInitials(name) { return String(name || 'Aluno').split(/\s+/).filter(Boolean).map(part => part[0]).slice(0,2).join('').toUpperCase(); }
         function adminStudentInitial(name) { return importPersonName(name).charAt(0).toUpperCase() || '#'; }
         function studentBirthLabel(value) { return value ? new Date(`${value}T12:00:00`).toLocaleDateString('pt-BR') : 'Não informado'; }
        function studentDirectoryPanel() {
          const host = { admin:adminView, coordinator:coordinatorView, teacher:teacherView }[activeView];
          return host?.querySelector('#adminStudentDirectoryPanel');
        }
         function canManageStudentDirectory() {
            return ['developer','coordinator'].includes(currentProfile?.role);
         }
         function ensureAdminGuardianCpfField(form) {
           if (!form || form.elements.namedItem('guardian_cpf')) return;
           const nameInput = form.elements.namedItem('guardian_name');
           const nameLabel = nameInput?.closest('label');
           if (!nameLabel) return;
           const label = document.createElement('label');
           label.innerHTML = 'CPF do responsável<input name="guardian_cpf" type="text" inputmode="numeric" maxlength="14" autocomplete="off" placeholder="Necessário para liberar acesso da família"><small class="field-hint">O CPF é armazenado apenas como código protegido para validação.</small>';
           nameLabel.after(label);
           label.querySelector('input').addEventListener('input', event => { const digits = normalizeCpfDigits(event.currentTarget.value).slice(0,11); event.currentTarget.value = digits.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2'); });
         }
        function resetAdminStudentForm() {
          const panel = studentDirectoryPanel();
          const form = panel?.querySelector('[data-admin-student-form]');
           if (!form) return;
           form.reset();
           clearAdminStudentDraft();
           form.student_id.value = '';
           form.querySelector('[data-admin-student-form-title]').textContent = 'Novo aluno';
           panel.querySelector('[data-admin-photo-preview]')?.classList.add('hidden');
           panel.querySelector('[data-admin-student-profile-summary]')?.classList.add('hidden');
          adminStudentState.selectedId = '';
          adminStudentState.profile = null;
          adminStudentState.programs = [];
          panel.querySelector('[data-admin-student-status]').textContent = '';
          renderAdminStudentDirectory();
        }
         async function renderAdminStudentPhoto(path) {
          const image = studentDirectoryPanel()?.querySelector('[data-admin-photo-preview]');
          if (!image) return;
          if (!path || !supabaseClient) { image.classList.add('hidden'); image.removeAttribute('src'); return; }
          const { data, error } = await supabaseClient.storage.from('student-photos').createSignedUrl(path, 600);
          if (error || !data?.signedUrl) { image.classList.add('hidden'); return; }
          image.src = data.signedUrl;
           image.classList.remove('hidden');
         }
         async function renderAdminStudentProfileSummary(student, profile) {
           const panel = studentDirectoryPanel();
           const summary = panel?.querySelector('[data-admin-student-profile-summary]');
           if (!summary) return;
           if (!student) { summary.classList.add('hidden'); return; }
           summary.classList.remove('hidden');
           summary.innerHTML = `<div class="student-profile-photo" data-admin-profile-photo>Foto não cadastrada</div><div><h4>${escapeHtml(student.official_name)}</h4><p>${escapeHtml(adminStudentClassLabel(student))} · ${student.active === false ? 'Cadastro inativo' : 'Cadastro ativo'}</p></div><div class="student-profile-data"><div><span>Nascimento</span><strong>${escapeHtml(studentBirthLabel(profile?.birth_date))}</strong></div><div><span>Responsável</span><strong>${escapeHtml(profile?.guardian_name || 'Não informado')}</strong></div><div><span>Telefone</span><strong>${escapeHtml(profile?.guardian_phone || 'Não informado')}</strong></div><div><span>Emergência</span><strong>${escapeHtml(profile?.emergency_contact || 'Não informado')}</strong></div><div><span>Endereço</span><strong>${escapeHtml(profile?.address_line || 'Não informado')}</strong></div><div><span>Necessidade de inclusão</span><strong>${escapeHtml(profile?.inclusion_needs || 'Não informada')}</strong></div><div><span>Plano de inclusão</span><strong>${escapeHtml(profile?.inclusion_plan || 'Não informado')}</strong></div><div><span>Observações</span><strong>${escapeHtml(profile?.inclusion_observations || 'Não informadas')}</strong></div></div>`;
           const url = await getStudentPhotoUrl(profile?.photo_path || '');
           const photo = summary.querySelector('[data-admin-profile-photo]');
           if (url && photo) photo.innerHTML = `<img src="${escapeHtml(url)}" alt="Foto de ${escapeHtml(student.official_name)}">`;
         }
        function fillAdminStudentForm(student, profile = {}, programs = []) {
           const panel = studentDirectoryPanel();
           const form = panel?.querySelector('[data-admin-student-form]');
           if (!form) return;
           ensureAdminGuardianCpfField(form);
           form.student_id.value = student?.id || '';
          form.official_name.value = student?.official_name || '';
          form.class_id.value = student?.class_id || '';
           form.birth_date.value = profile?.birth_date || '';
           form.guardian_name.value = profile?.guardian_name || '';
           form.guardian_cpf.value = '';
           form.guardian_phone.value = profile?.guardian_phone || '';
          form.emergency_contact.value = profile?.emergency_contact || '';
          form.address_line.value = profile?.address_line || '';
          form.inclusion_needs.value = profile?.inclusion_needs || '';
          form.inclusion_plan.value = profile?.inclusion_plan || '';
           form.inclusion_observations.value = profile?.inclusion_observations || '';
           form.querySelectorAll('[name="program_slug"]').forEach(input => { input.checked = programs.some(item => item.program_slug === input.value); });
           restoreAdminStudentDraft(form, student?.id || '');
           panel.querySelector('[data-admin-student-form-title]').textContent = student ? `Editar ${student.official_name}` : 'Novo aluno';
           renderAdminStudentPhoto(profile?.photo_path);
           renderAdminStudentProfileSummary(student, profile);
         }
         function renderAdminStudentDirectory() {
           const panel = studentDirectoryPanel();
           if (!panel) return;
           const toolbar = panel.querySelector('.admin-student-toolbar');
           let initialFilter = panel.querySelector('[data-admin-student-initial-filter]');
           if (toolbar && !initialFilter) {
             initialFilter = document.createElement('select');
             initialFilter.dataset.adminStudentInitialFilter = 'true';
             initialFilter.setAttribute('aria-label','Filtrar pela inicial do nome');
             initialFilter.innerHTML = '<option value="all">Todas as iniciais</option>';
             toolbar.insertBefore(initialFilter, toolbar.querySelector('[data-admin-new-student]'));
             initialFilter.addEventListener('change', renderAdminStudentDirectory);
           }
           if (initialFilter && initialFilter.options.length === 1) {
             const initials = [...new Set(adminStudentState.students.map(student => adminStudentInitial(student.official_name)).filter(Boolean))].sort();
             initialFilter.insertAdjacentHTML('beforeend', initials.map(initial => `<option value="${escapeHtml(initial)}">Inicial: ${escapeHtml(initial)}</option>`).join(''));
           }
           const search = String(panel.querySelector('[data-admin-student-search]')?.value || '').toLocaleLowerCase('pt-BR').trim();
           const classFilter = panel.querySelector('[data-admin-student-class-filter]')?.value || 'all';
           const initial = initialFilter?.value || 'all';
           const items = adminStudentState.students.filter(student => (!search || normalizePersonName(student.official_name).includes(normalizePersonName(search))) && (classFilter === 'all' || student.class_id === classFilter) && (initial === 'all' || adminStudentInitial(student.official_name) === initial));
          const list = panel.querySelector('[data-admin-student-list]');
          if (list) list.innerHTML = items.length ? items.map(student => `<button class="admin-student-row ${student.id === adminStudentState.selectedId ? 'is-selected' : ''}" type="button" data-admin-pick-student="${student.id}"><span class="admin-student-avatar">${escapeHtml(adminStudentInitials(student.official_name))}</span><span><strong>${escapeHtml(student.official_name)}</strong><span>${escapeHtml(adminStudentClassLabel(student))}</span></span><span>Editar →</span></button>`).join('') : '<div class="project-empty">Nenhum aluno encontrado.</div>';
          const studentSelect = panel.querySelector('[data-admin-student-select]');
          if (studentSelect) { const selected = studentSelect.value || adminStudentState.selectedId || ''; studentSelect.innerHTML = `<option value="">Novo cadastro</option>${adminStudentState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)} · ${escapeHtml(adminStudentClassLabel(student))}</option>`).join('')}`; studentSelect.value = selected; }
          const classFilterSelect = panel.querySelector('[data-admin-student-class-filter]');
          if (classFilterSelect && classFilterSelect.options.length === 1) classFilterSelect.insertAdjacentHTML('beforeend', adminStudentState.classes.map(item => `<option value="${item.id}">${escapeHtml(item.year)}º ano ${escapeHtml(item.class_code)}</option>`).join(''));
          const classSelect = panel.querySelector('[data-admin-class-select]');
          if (classSelect && classSelect.options.length === 1) classSelect.insertAdjacentHTML('beforeend', adminStudentState.classes.map(item => `<option value="${item.id}">${escapeHtml(item.year)}º ano ${escapeHtml(item.class_code)}</option>`).join(''));
        }
        async function loadAdminStudentRecord(studentId) {
          const student = adminStudentState.students.find(item => item.id === studentId);
          adminStudentState.selectedId = studentId || '';
          if (!studentId || !student) { adminStudentState.profile = null; adminStudentState.programs = []; fillAdminStudentForm(null); renderAdminStudentDirectory(); return; }
           let profileResult = await supabaseClient.from('student_school_profiles').select('student_id,birth_date,photo_path,address_line,guardian_name,guardian_cpf_hash,guardian_phone,emergency_contact,inclusion_needs,inclusion_plan,inclusion_observations,updated_at').eq('student_id',studentId).order('updated_at',{ascending:false}).limit(1);
           if (profileResult.error) profileResult = await supabaseClient.from('student_school_profiles').select('student_id,birth_date,photo_path,address_line,guardian_name,guardian_cpf_hash,guardian_phone,emergency_contact,inclusion_needs,inclusion_plan,inclusion_observations').eq('student_id',studentId).limit(1);
           const { data:programs, error:programError } = await supabaseClient.from('student_programs').select('program_slug,participation_status,notes').eq('student_id',studentId);
           adminStudentState.profile = profileResult.error ? null : profileResult.data?.[0] || null;
          adminStudentState.programs = programError ? [] : programs || [];
          fillAdminStudentForm(student, adminStudentState.profile, adminStudentState.programs);
           const status = studentDirectoryPanel()?.querySelector('[data-admin-student-status]');
           if (profileResult.error || programError) status.textContent = 'O perfil ampliado ainda não está disponível. Verifique a tabela de perfis dos alunos no Supabase.';
          renderAdminStudentDirectory();
        }
         async function loadAdminStudentDirectory() {
           if (!studentDirectoryPanel() || !supabaseClient || !canManageStudentDirectory() || adminStudentState.loading) return;
          adminStudentState.loading = true;
          const [{ data:students, error:studentsError }, { data:classes, error:classesError }] = await Promise.all([
            supabaseClient.from('students').select('id,official_name,class_id,active,classes(year,class_code)').eq('active',true).order('official_name'),
            supabaseClient.from('classes').select('id,year,class_code').order('year').order('class_code')
          ]);
          adminStudentState.students = studentsError ? [] : students || [];
          adminStudentState.classes = classesError ? [] : classes || [];
          adminStudentState.loaded = true;
          renderAdminStudentDirectory();
          if (adminStudentState.selectedId) await loadAdminStudentRecord(adminStudentState.selectedId); else fillAdminStudentForm(null);
           const status = studentDirectoryPanel()?.querySelector('[data-admin-student-status]');
          if (studentsError || classesError) status.textContent = 'Não foi possível carregar a lista oficial de alunos.';
          adminStudentState.loading = false;
        }
        async function saveAdminStudent(event) {
          event.preventDefault();
          const form = event.currentTarget;
          const status = form.querySelector('[data-admin-student-status]');
           const name = form.official_name.value.trim();
           const classId = form.class_id.value;
           if (!name || !classId) { status.textContent = 'Informe o nome oficial e a turma.'; return; }
           const guardianCpf = normalizeCpfDigits(form.guardian_cpf?.value || '');
           if (guardianCpf && !validCpfDigits(guardianCpf)) { status.textContent = 'Informe um CPF válido para o responsável.'; form.guardian_cpf.focus(); return; }
           const button = form.querySelector('button[type="submit"]');
          button.disabled = true;
          status.textContent = 'Salvando cadastro...';
          let studentId = form.student_id.value;
          let studentResult;
          if (studentId) studentResult = await supabaseClient.from('students').update({ official_name:name, class_id:classId, active:true }).eq('id',studentId).select('id,official_name,class_id,active,classes(year,class_code)').single();
          else studentResult = await supabaseClient.from('students').insert({ official_name:name, class_id:classId, active:true }).select('id,official_name,class_id,active,classes(year,class_code)').single();
          if (studentResult.error || !studentResult.data) { status.textContent = 'Não foi possível salvar o aluno. Verifique o acesso administrativo.'; button.disabled = false; return; }
           const student = studentResult.data;
           studentId = student.id;
           let existingProfile = adminStudentState.profile;
           if (studentId && !existingProfile) {
             let existing = await supabaseClient.from('student_school_profiles').select('student_id,photo_path').eq('student_id',studentId).order('updated_at',{ascending:false}).limit(1);
             if (existing.error) existing = await supabaseClient.from('student_school_profiles').select('student_id,photo_path').eq('student_id',studentId).limit(1);
             existingProfile = existing.data?.[0] || null;
           }
           let photoPath = existingProfile?.photo_path || null;
           const file = form.photo.files?.[0];
          if (file?.size) {
            const extension = (file.name.split('.').pop() || 'jpg').toLowerCase().replace(/[^a-z0-9]/g,'') || 'jpg';
            photoPath = `${currentUser.id}/${studentId}/${crypto.randomUUID()}.${extension}`;
            const upload = await supabaseClient.storage.from('student-photos').upload(photoPath,file,{contentType:file.type || 'image/jpeg',upsert:false});
            if (upload.error) { status.textContent = 'Aluno salvo, mas a foto não foi enviada.'; button.disabled = false; await loadAdminStudentDirectory(); return; }
          }
           const guardianCpfHash = guardianCpf ? await hashCpf(guardianCpf) : existingProfile?.guardian_cpf_hash || null;
            const profilePayload = { student_id:studentId, birth_date:form.birth_date.value || null, photo_path:photoPath, address_line:form.address_line.value.trim() || null, guardian_name:form.guardian_name.value.trim() || null, guardian_cpf_hash:guardianCpfHash, guardian_phone:form.guardian_phone.value.trim() || null, emergency_contact:form.emergency_contact.value.trim() || null, inclusion_needs:form.inclusion_needs.value.trim() || null, inclusion_plan:form.inclusion_plan.value.trim() || null, inclusion_observations:form.inclusion_observations.value.trim() || null, updated_by:currentUser.id, updated_at:new Date().toISOString() };
           let profileResult = await supabaseClient.from('student_school_profiles').upsert(profilePayload, { onConflict:'student_id' });
           if (profileResult.error) {
             const updated = await supabaseClient.from('student_school_profiles').update(profilePayload).eq('student_id',studentId).select('student_id').limit(1);
             if (!updated.error && updated.data?.length) profileResult = updated;
             else profileResult = await supabaseClient.from('student_school_profiles').insert(profilePayload).select('student_id').limit(1);
           }
           if (profileResult.error) { status.textContent = `Aluno salvo, mas o perfil não foi atualizado: ${profileResult.error.message || 'verifique a tabela de perfis dos alunos.'}`; button.disabled = false; await loadAdminStudentDirectory(); return; }
          const selectedPrograms = [...form.querySelectorAll('[name="program_slug"]:checked')].map(input => input.value);
          const deletePrograms = await supabaseClient.from('student_programs').delete().eq('student_id',studentId);
          let programError = deletePrograms.error;
          if (!programError && selectedPrograms.length) { const result = await supabaseClient.from('student_programs').insert(selectedPrograms.map(program_slug => ({ student_id:studentId, program_slug, participation_status:'active', updated_by:currentUser.id }))); programError = result.error; }
          adminStudentState.selectedId = studentId;
           adminStudentState.profile = { birth_date:form.birth_date.value || null, photo_path:photoPath, address_line:form.address_line.value.trim(), guardian_name:form.guardian_name.value.trim(), guardian_cpf_hash:guardianCpfHash, guardian_phone:form.guardian_phone.value.trim(), emergency_contact:form.emergency_contact.value.trim(), inclusion_needs:form.inclusion_needs.value.trim(), inclusion_plan:form.inclusion_plan.value.trim(), inclusion_observations:form.inclusion_observations.value.trim() };
           adminStudentState.programs = selectedPrograms.map(program_slug => ({ program_slug }));
            status.textContent = programError ? 'Cadastro salvo, mas os projetos não foram atualizados.' : 'Cadastro do aluno salvo com segurança.';
            clearAdminStudentDraft();
           button.disabled = false;
          await loadAdminStudentDirectory();
        }
        function setupAdminStudentDirectory() {
            const panel = studentDirectoryPanel();
            if (!panel || panel.dataset.ready) return;
            panel.dataset.ready = 'true';
            const form = panel.querySelector('[data-admin-student-form]');
            if (form && !panel.querySelector('[data-admin-student-profile-summary]')) { const summary = document.createElement('div'); summary.className = 'student-profile-summary hidden'; summary.dataset.adminStudentProfileSummary = 'true'; form.parentNode.insertBefore(summary, form); }
           if (form && !form.dataset.draftReady) { form.dataset.draftReady = 'true'; ['input','change'].forEach(type => form.addEventListener(type, () => { adminStudentFormDirty = true; saveAdminStudentDraft(form); })); }
           panel.querySelector('[data-admin-student-search]')?.addEventListener('input', renderAdminStudentDirectory);
          panel.querySelector('[data-admin-student-class-filter]')?.addEventListener('change', renderAdminStudentDirectory);
          panel.querySelector('[data-admin-student-select]')?.addEventListener('change', event => loadAdminStudentRecord(event.currentTarget.value));
          panel.querySelector('[data-admin-new-student]')?.addEventListener('click', resetAdminStudentForm);
           form?.addEventListener('submit', saveAdminStudent);
          panel.addEventListener('click', event => { const button = event.target.closest('[data-admin-pick-student]'); if (button) loadAdminStudentRecord(button.dataset.adminPickStudent); });
          if (adminStudentState.loaded) { renderAdminStudentDirectory(); if (adminStudentState.selectedId) loadAdminStudentRecord(adminStudentState.selectedId); else fillAdminStudentForm(null); }
            else loadAdminStudentDirectory();
           }
            function ensureAdminStudentDirectoryView() {
              const host = { admin:adminView, coordinator:coordinatorView, teacher:teacherView }[activeView];
              if (!host) return;
              if (!host.querySelector('#adminStudentDirectoryPanel')) host.insertAdjacentHTML('beforeend', adminStudentMarkup);
              setupAdminStudentDirectory();
              if (activeView === 'admin') setupAdminStudentImport();
            }
            window.bfrPrepareAdminStudentDirectory = ensureAdminStudentDirectoryView;
           const globalStudentSearchState = { students:[], classes:[], loaded:false, loading:false, selectedId:'' };
           function globalSearchCanViewAll() { return ['developer','coordinator'].includes(currentProfile?.role); }
          function globalSearchStudentClass(student, classes = globalStudentSearchState.classes) {
            const nested = Array.isArray(student?.classes) ? student.classes[0] : student?.classes;
            const classData = nested || classes.find(item => item.id === student?.class_id);
            return classData ? `${classData.year}º ano ${classData.class_code}` : 'Turma não informada';
          }
          async function loadGlobalStudentSearch(force = false) {
            if (!supabaseClient || !currentUser || (globalStudentSearchState.loaded && !force) || globalStudentSearchState.loading) return;
            globalStudentSearchState.loading = true;
            let students = [];
            let classes = [];
             if (currentProfile?.role === 'pedagogical') {
               await loadProfessionalTeacherData();
               students = teacherProfessionalState.students || [];
               classes = teacherProfessionalState.classes || [];
             } else if (globalSearchCanViewAll()) {
              const [{ data:studentRows }, { data:classRows }] = await Promise.all([
                supabaseClient.from('students').select('id,official_name,class_id,active,classes(year,class_code)').eq('active',true).order('official_name'),
                supabaseClient.from('classes').select('id,year,class_code').order('year').order('class_code')
              ]);
              students = studentRows || [];
              classes = classRows || [];
            } else {
              const { data:links } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id',currentUser.id);
              const ids = (links || []).map(item => item.student_id);
              if (ids.length) { const { data } = await supabaseClient.from('students').select('id,official_name,class_id,active,classes(year,class_code)').in('id',ids).eq('active',true).order('official_name'); students = data || []; }
            }
             const profiles = currentProfile?.role === 'pedagogical' ? [] : await loadStudentProfiles(students.map(student => student.id));
            globalStudentSearchState.students = mergeStudentProfiles(students, profiles);
            globalStudentSearchState.classes = classes.length ? classes : adminStudentState.classes;
            globalStudentSearchState.loaded = true;
            globalStudentSearchState.loading = false;
            renderGlobalStudentSearch();
          }
          function renderGlobalStudentFilters() {
            const classSelect = document.getElementById('globalStudentClass');
            const initialSelect = document.getElementById('globalStudentInitial');
            if (classSelect && classSelect.options.length === 1) classSelect.insertAdjacentHTML('beforeend', globalStudentSearchState.classes.map(item => `<option value="${escapeHtml(item.id)}">${escapeHtml(item.year)}º ano ${escapeHtml(item.class_code)}</option>`).join(''));
            if (initialSelect && initialSelect.options.length === 1) [...new Set(globalStudentSearchState.students.map(student => adminStudentInitial(student.official_name)).filter(Boolean))].sort().forEach(initial => initialSelect.insertAdjacentHTML('beforeend', `<option value="${escapeHtml(initial)}">Inicial: ${escapeHtml(initial)}</option>`));
          }
          async function renderGlobalStudentProfile(student) {
           const profile = document.getElementById('globalStudentProfile');
           if (!profile || !student) return;
           globalStudentSearchState.selectedId = student.id;
            if (!student.student_profile) student.student_profile = await loadStudentProfile(student.id);
           profile.classList.remove('hidden');
            profile.innerHTML = `<div class="student-profile-summary"><div class="student-profile-photo" data-global-profile-photo>Foto não cadastrada</div><div><h4>${escapeHtml(student.official_name)}</h4><p>${escapeHtml(globalSearchStudentClass(student))} · ${student.active === false ? 'Cadastro inativo' : 'Cadastro ativo'}</p></div><div class="student-profile-data"><div><span>Nascimento</span><strong>${escapeHtml(studentBirthLabel(student.student_profile?.birth_date))}</strong></div><div><span>Responsável</span><strong>${escapeHtml(student.student_profile?.guardian_name || 'Não informado')}</strong></div><div><span>Telefone</span><strong>${escapeHtml(student.student_profile?.guardian_phone || 'Não informado')}</strong></div><div><span>Emergência</span><strong>${escapeHtml(student.student_profile?.emergency_contact || 'Não informado')}</strong></div><div><span>Endereço</span><strong>${escapeHtml(student.student_profile?.address_line || 'Não informado')}</strong></div><div><span>Necessidade de inclusão</span><strong>${escapeHtml(student.student_profile?.inclusion_needs || 'Não informada')}</strong></div><div><span>Plano de inclusão</span><strong>${escapeHtml(student.student_profile?.inclusion_plan || 'Não informado')}</strong></div><div><span>Observações</span><strong>${escapeHtml(student.student_profile?.inclusion_observations || 'Não informadas')}</strong></div></div></div>`;
             const url = await getStudentPhotoDataUrl(studentPhotoPath(student));
            const photo = profile.querySelector('[data-global-profile-photo]');
            if (url && photo) photo.innerHTML = `<img src="${escapeHtml(url)}" alt="Foto de ${escapeHtml(student.official_name)}">`;
            renderGlobalStudentSearch();
          }
          function renderGlobalStudentSearch() {
            const results = document.getElementById('globalStudentResults');
            if (!results) return;
            renderGlobalStudentFilters();
            const search = normalizePersonName(document.getElementById('globalStudentSearch')?.value || '');
            const classId = document.getElementById('globalStudentClass')?.value || 'all';
            const initial = document.getElementById('globalStudentInitial')?.value || 'all';
            const items = globalStudentSearchState.students.filter(student => (!search || normalizePersonName(student.official_name).includes(search)) && (classId === 'all' || student.class_id === classId) && (initial === 'all' || adminStudentInitial(student.official_name) === initial));
            if (!items.length) { results.innerHTML = '<div class="project-empty">Nenhum aluno encontrado com esses filtros.</div>'; return; }
            results.innerHTML = items.slice(0,80).map(student => `<button type="button" class="global-search-result ${student.id === globalStudentSearchState.selectedId ? 'is-selected' : ''}" data-global-student-id="${escapeHtml(student.id)}"><span class="admin-student-avatar">${escapeHtml(adminStudentInitials(student.official_name))}</span><span><strong>${escapeHtml(student.official_name)}</strong><span>${escapeHtml(globalSearchStudentClass(student))}</span></span><b>Ver ficha →</b></button>`).join('');
          }
          function setupGlobalStudentSearch() {
            const modal = document.getElementById('globalSearchModal');
            const open = document.getElementById('globalSearchBtn');
            const close = document.getElementById('closeGlobalSearch');
            const input = document.getElementById('globalStudentSearch');
              if (!modal || !open || modal.dataset.runtimeReady === 'true') return;
              modal.dataset.runtimeReady = 'true';
            open.addEventListener('click', async () => { modal.classList.remove('hidden'); await loadGlobalStudentSearch(); input?.focus(); });
            close?.addEventListener('click', () => modal.classList.add('hidden'));
            modal.addEventListener('click', event => { if (event.target === modal) modal.classList.add('hidden'); });
            input?.addEventListener('input', renderGlobalStudentSearch);
            document.getElementById('globalStudentClass')?.addEventListener('change', renderGlobalStudentSearch);
            document.getElementById('globalStudentInitial')?.addEventListener('change', renderGlobalStudentSearch);
             document.getElementById('globalStudentResults')?.addEventListener('click', event => { const result = event.target.closest('[data-global-student-id]'); if (!result) return; event.preventDefault(); const student = globalStudentSearchState.students.find(item => item.id === result.dataset.globalStudentId); renderGlobalStudentProfile(student).then(() => document.getElementById('globalStudentProfile')?.scrollIntoView({ behavior:'smooth', block:'nearest' })); });
          }
          setupGlobalStudentSearch();
          const adminStudentImportState = { rows:[], fileName:'', loading:false };
         const adminStudentImportDraftKey = 'bfr-admin-student-import-draft';
         function saveAdminStudentImportDraft() { try { sessionStorage.setItem(adminStudentImportDraftKey, JSON.stringify({ rows:adminStudentImportState.rows, fileName:adminStudentImportState.fileName })); } catch {} }
         function restoreAdminStudentImportDraft() { try { const draft = JSON.parse(sessionStorage.getItem(adminStudentImportDraftKey) || 'null'); if (draft?.rows?.length) { adminStudentImportState.rows = draft.rows; adminStudentImportState.fileName = draft.fileName || ''; } } catch {} }
         function clearAdminStudentImportDraft() { try { sessionStorage.removeItem(adminStudentImportDraftKey); } catch {} }
         function importPersonName(value) { return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('pt-BR').replace(/[^a-z0-9]+/g,' ').trim(); }
        function importCellText(cell) { return [...cell.getElementsByTagNameNS('http://schemas.openxmlformats.org/wordprocessingml/2006/main','t')].map(node => node.textContent).join('').replace(/\s+/g,' ').trim(); }
        function importBirthDate(value) {
          const match = String(value || '').match(/\b(\d{1,2})[\/-](\d{1,2})[\/-](\d{2,4})\b/);
          if (!match) return null;
          const day = match[1].padStart(2,'0');
          const month = match[2].padStart(2,'0');
          const year = match[3].length === 2 ? `20${match[3]}` : match[3];
          return `${year}-${month}-${day}`;
        }
         async function parseStudentDocx(file) {
           if (!window.JSZip) await loadExternalScript('https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js','JSZip');
           const zip = await window.JSZip.loadAsync(file);
          const xmlText = await zip.file('word/document.xml')?.async('string');
          if (!xmlText) throw new Error('O arquivo não contém um documento Word válido.');
          const xml = new DOMParser().parseFromString(xmlText,'application/xml');
          if (xml.querySelector('parsererror')) throw new Error('Não foi possível ler o documento Word.');
          const ns = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
          const body = xml.getElementsByTagNameNS(ns,'body')[0];
          let currentClass = null;
          const rows = [];
          for (const block of [...(body?.children || [])]) {
            const blockText = [...block.getElementsByTagNameNS(ns,'t')].map(node => node.textContent).join(' ').replace(/\s+/g,' ').trim();
            const classMatch = blockText.match(/\b([6-9])\s*(?:º|°)?\s*A\s*N\s*O\s+([A-Z])(?:\s+(MATUTINO|VESPERTINO))?/i);
             if (block.localName === 'p' && classMatch) { currentClass = { year:Number(classMatch[1]), class_code:classMatch[2].toUpperCase(), shift:(classMatch[3] || '').toUpperCase() }; continue; }
             if (block.localName === 'p') {
               const dateMatch = blockText.match(/\b\d{1,2}[\/-]\d{1,2}[\/-]\d{2,4}\b/);
               if (!dateMatch) continue;
               const officialName = blockText.slice(0, dateMatch.index).replace(/[\-\u2013\u2014\s]+$/,'').replace(/^\d+\s*/,'').trim();
               const birthDate = importBirthDate(dateMatch[0]);
               if (officialName.length >= 3 && birthDate && !importPersonName(officialName).includes('nome do aluno')) rows.push({ official_name:officialName, birth_date:birthDate, year:null, class_code:'', shift:'', source_index:rows.length });
               continue;
             }
             if (block.localName !== 'tbl') continue;
            const tableRows = [...block.children].filter(row => row.localName === 'tr');
            let nameIndex = -1;
            let birthIndex = -1;
            for (const row of tableRows) {
              const cells = [...row.children].filter(cell => cell.localName === 'tc').map(importCellText);
              const headers = cells.map(importPersonName);
              if (nameIndex < 0) nameIndex = headers.findIndex(value => value.includes('nome do aluno') || value === 'nome');
              if (birthIndex < 0) birthIndex = headers.findIndex(value => value === 'nascimento' || value.includes('data de nascimento'));
              if (nameIndex < 0 || birthIndex < 0) continue;
              const name = cells[nameIndex] || '';
              const birthDate = importBirthDate(cells[birthIndex]);
              const officialName = name.replace(/^\d+\s*/,'').trim();
              if (!officialName || officialName.length < 3 || importPersonName(officialName).includes('nome do aluno')) continue;
              rows.push({ official_name:officialName, birth_date:birthDate, year:currentClass?.year || null, class_code:currentClass?.class_code || '', shift:currentClass?.shift || '' });
            }
          }
           if (rows.length && rows.every(row => row.source_index != null) && adminStudentState.classes?.length) {
             let sourceIndex = 0;
             for (const classData of adminStudentState.classes) {
               const classCount = adminStudentState.students.filter(student => student.class_id === classData.id).length;
               for (let index = 0; index < classCount && sourceIndex < rows.length; index++, sourceIndex++) {
                 rows[sourceIndex].year = Number(classData.year);
                 rows[sourceIndex].class_code = classData.class_code;
                 rows[sourceIndex].shift = classData.shift || '';
               }
             }
           }
           const unique = new Map();
          rows.forEach(row => unique.set(`${importPersonName(row.official_name)}|${row.year}|${row.class_code}`,row));
          return [...unique.values()];
        }
         function importClassForRow(row) {
           if (row.year == null && !row.class_code) {
             const existing = adminStudentState.students.find(item => importPersonName(item.official_name) === importPersonName(row.official_name));
             return adminStudentState.classes.find(item => item.id === existing?.class_id);
           }
           return adminStudentState.classes.find(item => Number(item.year) === row.year && importPersonName(item.class_code) === importPersonName(row.class_code));
         }
         function importExistingStudent(row, classData) { return adminStudentState.students.find(item => item.class_id === classData?.id && importPersonName(item.official_name) === importPersonName(row.official_name)); }
        function studentImportMarkup() { return `<section class="panel" id="adminStudentImportPanel"><div class="panel-heading"><div><div class="eyebrow">Importação segura · administração</div><h2 style="margin-top:4px">Lista oficial de alunos</h2></div><span class="paperless-tag">● REVISÃO ANTES DE SALVAR</span></div><p class="agenda-intro">Selecione a lista Word oficial. O sistema lê nome, turma e nascimento, mostra uma prévia e só grava depois da sua confirmação. Nenhum aluno é removido.</p><label class="file-drop-label">Arquivo DOCX<input type="file" data-admin-import-file accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"><small class="field-hint" data-admin-import-file-name>Nenhum arquivo selecionado.</small></label><div class="import-summary" data-admin-import-summary></div><div class="import-preview" data-admin-import-preview><div class="project-empty">A prévia aparecerá aqui.</div></div><div class="admin-import-actions"><button class="primary-button" type="button" data-admin-import-confirm disabled>Confirmar importação</button><p class="publish-status" data-admin-import-status></p></div></section>`; }
        function renderAdminStudentImportPreview() {
          const panel = adminView?.querySelector('#adminStudentImportPanel');
          if (!panel) return;
          const rows = adminStudentImportState.rows;
          const summary = panel.querySelector('[data-admin-import-summary]');
          const preview = panel.querySelector('[data-admin-import-preview]');
          const confirm = panel.querySelector('[data-admin-import-confirm]');
          const resolved = rows.map(row => ({ row, classData:importClassForRow(row), existing:importExistingStudent(row,importClassForRow(row)) }));
          const missing = resolved.filter(item => !item.classData).length;
          const missingBirthdays = rows.filter(item => !item.birth_date).length;
          const missingBirthdayNames = rows.filter(item => !item.birth_date).map(item => item.official_name).join(', ');
          if (summary) summary.textContent = rows.length ? `${rows.length} alunos encontrados · ${resolved.filter(item => item.existing).length} atualizarão cadastro · ${resolved.filter(item => !item.existing).length} serão adicionados${missing ? ` · ${missing} sem turma correspondente` : ''}${missingBirthdays ? ` · ${missingBirthdays} sem nascimento` : ''}` : '';
          if (preview) preview.innerHTML = rows.length ? `<table class="import-preview-table"><thead><tr><th>Aluno</th><th>Nascimento</th><th>Turma</th><th>Situação</th></tr></thead><tbody>${resolved.slice(0,30).map(item => `<tr><td>${escapeHtml(item.row.official_name)}</td><td>${escapeHtml(item.row.birth_date ? item.row.birth_date.split('-').reverse().join('/') : 'Não informada')}</td><td>${escapeHtml(item.classData ? `${item.classData.year}º ano ${item.classData.class_code}` : `${item.row.year || '?'}º ano ${item.row.class_code || 'sem turma'}`)}</td><td>${!item.classData ? 'Revisar turma' : !item.row.birth_date ? 'Sem nascimento' : item.existing ? 'Atualizar' : 'Novo'}</td></tr>`).join('')}</tbody></table>${rows.length > 30 ? `<small class="field-hint">Mostrando os primeiros 30 de ${rows.length} registros.</small>` : ''}${missingBirthdays ? `<small class="field-hint import-warning">Sem data de nascimento: ${escapeHtml(missingBirthdayNames)}. A importação continuará e não substituirá uma data já cadastrada.</small>` : ''}` : '<div class="project-empty">A prévia aparecerá aqui.</div>';
          if (confirm) confirm.disabled = !rows.length || missing > 0 || adminStudentImportState.loading;
        }
        async function confirmAdminStudentImport() {
          const panel = adminView?.querySelector('#adminStudentImportPanel');
          const status = panel?.querySelector('[data-admin-import-status]');
          const button = panel?.querySelector('[data-admin-import-confirm]');
          if (!panel || !status || !button || currentProfile?.role !== 'developer' || !adminStudentImportState.rows.length) return;
          const resolved = adminStudentImportState.rows.map(row => ({ row, classData:importClassForRow(row), existing:importExistingStudent(row,importClassForRow(row)) }));
          if (resolved.some(item => !item.classData)) { status.textContent = 'Revise as turmas que não foram encontradas.'; return; }
          adminStudentImportState.loading = true;
          button.disabled = true;
          let created = 0;
          let updated = 0;
          let failed = 0;
          for (const [index,item] of resolved.entries()) {
            status.textContent = `Salvando ${index + 1} de ${resolved.length}...`;
            const studentResult = item.existing ? await supabaseClient.from('students').update({ official_name:item.row.official_name, class_id:item.classData.id, active:true }).eq('id',item.existing.id).select('id,official_name,class_id,active,classes(year,class_code)').single() : await supabaseClient.from('students').insert({ official_name:item.row.official_name, class_id:item.classData.id, active:true }).select('id,official_name,class_id,active,classes(year,class_code)').single();
            if (studentResult.error || !studentResult.data) { failed++; continue; }
            if (item.existing) updated++; else created++;
            const profilePayload = { student_id:studentResult.data.id, updated_by:currentUser.id, updated_at:new Date().toISOString() };
            if (item.row.birth_date) profilePayload.birth_date = item.row.birth_date;
            const profileResult = await supabaseClient.from('student_school_profiles').upsert(profilePayload, { onConflict:'student_id' });
            if (profileResult.error) failed++;
          }
           adminStudentImportState.loading = false;
           adminStudentState.loaded = false;
           await loadAdminStudentDirectory();
           status.textContent = failed ? `Importação concluída com ${created} novos, ${updated} atualizados e ${failed} falhas.` : `Importação concluída: ${created} novos e ${updated} atualizados.`;
           if (!failed) clearAdminStudentImportDraft();
           renderAdminStudentImportPreview();
        }
        function setupAdminStudentImport() {
          if (currentProfile?.role !== 'developer' || !adminView || adminView.querySelector('#adminStudentImportPanel')) return;
           adminView.insertAdjacentHTML('beforeend',studentImportMarkup());
           const panel = adminView.querySelector('#adminStudentImportPanel');
           restoreAdminStudentImportDraft();
           const fileInput = panel.querySelector('[data-admin-import-file]');
           if (adminStudentImportState.fileName) panel.querySelector('[data-admin-import-file-name]').textContent = adminStudentImportState.fileName;
          fileInput.addEventListener('change', async event => {
            const file = event.currentTarget.files?.[0];
            adminStudentImportState.rows = [];
            adminStudentImportState.fileName = file?.name || '';
            panel.querySelector('[data-admin-import-file-name]').textContent = file?.name || 'Nenhum arquivo selecionado.';
            panel.querySelector('[data-admin-import-status]').textContent = file ? 'Lendo a lista...' : '';
            if (!file) { clearAdminStudentImportDraft(); renderAdminStudentImportPreview(); return; }
            try { adminStudentImportState.rows = await parseStudentDocx(file); panel.querySelector('[data-admin-import-status]').textContent = adminStudentImportState.rows.length ? 'Confira a prévia antes de confirmar.' : 'Nenhum aluno com nascimento foi encontrado.'; }
            catch (error) { panel.querySelector('[data-admin-import-status]').textContent = error.message || 'Não foi possível ler a lista.'; }
            saveAdminStudentImportDraft();
            renderAdminStudentImportPreview();
          });
          panel.querySelector('[data-admin-import-confirm]').addEventListener('click',confirmAdminStudentImport);
          renderAdminStudentImportPreview();
        }
        const profileRoleOptions = [
         ['parent','Responsável'],
          ['student','Aluno'],
          ['pedagogical','Professor / equipe pedagógica'],
          ['coordinator','Coordenador(a) escolar'],
          ['monitor','Monitor'],
         ['gatekeeper','Porteiro'],
            ['developer','Administrador'],
            ['director','Direção escolar'],
             ['secretary','Secretaria escolar'],
             ['pedagogical','Professor(a)'],
             ['aee','Professor(a) do AEE'],
           ['pending','Aguardando aprovação']
       ];
        const roleSectionAccess = {
              parent:['inicio','escola-historia','notas','agenda','atividades','comunicados','secretaria','ocorrencias','meu-espaco','coordenacao-chat'],
             student:['inicio','escola-historia','notas','agenda','atividades','horarios','jogos','videos-aprender','comunicados','biblioteca','boletim','meu-espaco'],
               teacher:['professor-inicio','professor-turmas','professor-atividades','professor-avaliacoes','professor-frequencia','professor-agenda','professor-agenda-hoje','professor-biblioteca','professor-comunicacao','chat-interno','professor-espaco','escola-historia'],
              coordinator:['inicio','coordenacao','horarios','cadastro-alunos','comunicados','ocorrencias','atividades','escola-historia','coordenacao-chat'],
               admin:['inicio','escola-historia','chat-interno','notas','agenda','atividades','horarios','jogos','videos-aprender','comunicados','ocorrencias','coordenacao','monitor','gate','administracao','cadastro-alunos','aee','direcao','coordenacao-chat'],
               director:['inicio','direcao','horarios','comunicados','coordenacao','escola-historia','coordenacao-chat'],
              monitor:['inicio','monitor','ocorrencias','horarios','escola-historia'],
              gatekeeper:['inicio','gate','horarios','comunicados','escola-historia'],
               secretary:['inicio','secretaria','comunicados','escola-historia','coordenacao-chat'],
               aee:['inicio','aee','atividades','horarios','comunicados','escola-historia','meu-espaco']
        };
        const roleManagementState = { profiles:[], teachers:[], loaded:false, loading:false };
       function ensureRoleManagementView() {
         if (!adminView || adminView.querySelector('#roleManagementPanel')) return;
           const markup = `<section class="panel" id="roleManagementPanel"><div class="panel-heading"><div><div class="eyebrow">Acessos da escola</div><h2 style="margin-top:4px">Contas e cargos</h2></div><span class="paperless-tag">● ADMIN</span></div><p class="agenda-intro">Altere o cargo de cada conta. Para professores, selecione também o nome oficial correspondente na grade de horários.</p><div class="role-management-list" data-role-management-list><div class="project-empty">Carregando contas...</div></div><p class="publish-status" data-role-management-status></p></section>`;
          const hero = adminView.querySelector('.teacher-welcome');
          (hero || adminView).insertAdjacentHTML(hero ? 'afterend' : 'afterbegin', markup);
       }
       function renderRoleManagement() {
         const panel = adminView?.querySelector('#roleManagementPanel');
         const list = panel?.querySelector('[data-role-management-list]');
         if (!panel || !list) return;
          list.innerHTML = roleManagementState.profiles.length ? roleManagementState.profiles.map(profile => {
            const self = profile.id === currentUser?.id;
            const options = profileRoleOptions.map(([value,label]) => `<option value="${value}" ${profile.role === value ? 'selected' : ''}>${label}</option>`).join('');
            const canLinkTeacher = ['pedagogical','aee'].includes(profile.role);
            const linkedTeacher = roleManagementState.teachers.find(item => item.profile_id === profile.id);
            const teacherOptions = canLinkTeacher ? `<label style="display:grid;gap:4px;min-width:220px"><span style="color:#71809a;font-size:9px">Professor oficial da grade</span><select data-profile-teacher aria-label="Professor oficial de ${escapeHtml(profile.full_name || profile.email || 'conta')}"><option value="">Sem vínculo oficial</option>${roleManagementState.teachers.map(item => `<option value="${escapeHtml(item.id)}" ${linkedTeacher?.id === item.id ? 'selected' : ''}>${escapeHtml(item.display_name || item.source_name)}</option>`).join('')}</select></label>` : '';
            return `<article class="role-management-row" data-role-profile="${profile.id}"><div class="role-management-account"><strong>${escapeHtml(profile.full_name || 'Conta sem nome')}${self ? ' · você' : ''}</strong><span>${escapeHtml(profile.email || '')}</span></div><div style="display:grid;gap:7px;min-width:220px"><select data-profile-role aria-label="Cargo de ${escapeHtml(profile.full_name || profile.email || 'conta')}" ${self ? 'disabled' : ''}>${options}</select>${teacherOptions}</div><span class="role-management-status">${self ? 'Administrador principal' : 'Cargo atual: ' + escapeHtml(profileRoleOptions.find(([value]) => value === profile.role)?.[1] || profile.role || 'não definido')}</span></article>`;
          }).join('') : '<div class="project-empty">Nenhuma conta cadastrada.</div>';
       }
       async function loadRoleManagement(force = false) {
         if (!adminView || !supabaseClient || !currentUser || currentProfile?.role !== 'developer' || (!force && (roleManagementState.loaded || roleManagementState.loading))) { renderRoleManagement(); return; }
         roleManagementState.loading = true;
          const [profilesResult, teachersResult] = await Promise.all([
            supabaseClient.from('profiles').select('id,full_name,email,role').order('full_name'),
            supabaseClient.from('bfr_teacher_directory').select('id,source_name,display_name,profile_id').order('source_name')
          ]);
          roleManagementState.loading = false;
          roleManagementState.loaded = true;
          roleManagementState.profiles = profilesResult.error ? [] : profilesResult.data || [];
          roleManagementState.teachers = teachersResult.error ? [] : teachersResult.data || [];
          renderRoleManagement();
          const status = adminView.querySelector('[data-role-management-status]');
          if ((profilesResult.error || teachersResult.error) && status) status.textContent = 'Não foi possível carregar contas ou professores da grade.';
       }
       async function updateProfileRole(select) {
         const row = select.closest('[data-role-profile]');
         const profile = roleManagementState.profiles.find(item => item.id === row?.dataset.roleProfile);
         const status = row?.querySelector('.role-management-status');
         const nextRole = select.value;
         if (!profile || !status || !nextRole || profile.id === currentUser?.id || currentProfile?.role !== 'developer') return;
         const previousRole = profile.role;
         if (nextRole === previousRole) return;
         select.disabled = true;
         status.className = 'role-management-status';
         status.textContent = 'Salvando alteração...';
         const { error } = await supabaseClient.from('profiles').update({ role:nextRole }).eq('id',profile.id);
         select.disabled = false;
         if (error) {
           select.value = previousRole;
           status.className = 'role-management-status is-error';
           status.textContent = 'Não foi possível alterar o cargo.';
           return;
         }
          profile.role = nextRole;
          status.className = 'role-management-status is-success';
          status.textContent = 'Cargo atualizado.';
          renderRoleManagement();
        }
        async function updateProfileTeacher(select) {
          const row = select.closest('[data-role-profile]');
          const profile = roleManagementState.profiles.find(item => item.id === row?.dataset.roleProfile);
          if (!profile || currentProfile?.role !== 'developer' || !['pedagogical','aee'].includes(profile.role)) return;
          const teacherId = select.value || null;
          select.disabled = true;
          const previous = roleManagementState.teachers.find(item => item.profile_id === profile.id);
          if (previous && previous.id !== teacherId) {
            const clearResult = await supabaseClient.from('bfr_teacher_directory').update({ profile_id:null }).eq('id', previous.id);
            if (clearResult.error) { select.disabled = false; select.value = previous.id; return; }
          }
          if (teacherId) {
            const result = await supabaseClient.from('bfr_teacher_directory').update({ profile_id:profile.id }).eq('id', teacherId);
            if (result.error) { select.disabled = false; select.value = previous?.id || ''; return; }
          }
          roleManagementState.teachers = roleManagementState.teachers.map(item => ({ ...item, profile_id:item.id === teacherId ? profile.id : item.profile_id === profile.id ? null : item.profile_id }));
          select.disabled = false;
          renderRoleManagement();
        }
       function setupRoleManagement() {
         ensureRoleManagementView();
         if (!document.body.dataset.roleManagementActions) {
           document.body.dataset.roleManagementActions = 'true';
            document.addEventListener('change', event => { const roleSelect = event.target.closest('[data-profile-role]'); if (roleSelect) updateProfileRole(roleSelect); const teacherSelect = event.target.closest('[data-profile-teacher]'); if (teacherSelect) updateProfileTeacher(teacherSelect); });
         }
         loadRoleManagement();
       }
       function setupPermissionPreview() {
         const toggle = document.querySelector('.role-toggle');
         if (!toggle || currentProfile?.role !== 'developer' || toggle.dataset.previewReady) return;
         toggle.dataset.previewReady = 'true';
           toggle.innerHTML = '<button data-preview-role="admin">Admin</button><button data-preview-role="director">Direção</button><button data-preview-role="parent">Pais</button><button data-preview-role="student">Aluno</button><button data-preview-role="teacher">Professor</button><button data-preview-role="coordinator">Coordenação</button><button data-preview-role="secretary">Secretaria</button><button data-preview-role="monitor">Monitor</button><button data-preview-role="gatekeeper">Portaria</button>';
         toggle.querySelectorAll('[data-preview-role]').forEach(button => button.addEventListener('click', () => setRole(button.dataset.previewRole)));
       }
         const preferenceDefaults = { showClock:true, reduceMotion:false, emailAlerts:false, whatsappAlerts:false, pushAlerts:false };
         function accountStorageKey(name) { return currentUser?.id ? `${name}:${currentUser.id}` : name; }
         function readPreferences() {
           try { return { ...preferenceDefaults, ...JSON.parse(localStorage.getItem(accountStorageKey('bfr-preferences')) || '{}') }; }
           catch { return { ...preferenceDefaults }; }
         }
        async function loadNotificationPreferences() {
          const local = readPreferences();
          if (!supabaseClient || !currentUser) return local;
          const { data } = await supabaseClient.from('notification_preferences').select('email_enabled,whatsapp_enabled,push_enabled').eq('profile_id',currentUser.id).maybeSingle();
          if (!data) return local;
          const next = { ...local, emailAlerts:Boolean(data.email_enabled), whatsappAlerts:Boolean(data.whatsapp_enabled), pushAlerts:Boolean(data.push_enabled) };
           localStorage.setItem(accountStorageKey('bfr-preferences'), JSON.stringify(next));
          return next;
        }
         async function saveNotificationPreferences(preferences) {
           if (!supabaseClient || !currentUser) return null;
           const { error } = await supabaseClient.from('notification_preferences').upsert({ profile_id:currentUser.id, email_enabled:Boolean(preferences.emailAlerts), whatsapp_enabled:Boolean(preferences.whatsappAlerts), push_enabled:Boolean(preferences.pushAlerts), updated_at:new Date().toISOString() }, { onConflict:'profile_id' });
           return error || null;
         }
          async function getFirebaseMessaging() {
            if (firebaseMessaging) return firebaseMessaging;
            if (!window.firebase) await loadExternalScript('https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js','firebase');
            if (!window.firebase?.messaging) await loadExternalScript('https://www.gstatic.com/firebasejs/10.14.1/firebase-messaging-compat.js','firebase');
            if (!window.firebase?.messaging) throw new Error('O serviço de push não carregou.');
           const app = window.firebase.apps?.find(item => item.name === 'bfrPush') || window.firebase.initializeApp(FIREBASE_CONFIG, 'bfrPush');
           firebaseMessaging = window.firebase.messaging(app);
           return firebaseMessaging;
         }
         async function registerPushSubscription(requestPermission = true) {
           if (!currentUser || !supabaseClient) return 'Entre na sua conta para ativar o push.';
           if (!('Notification' in window) || !('serviceWorker' in navigator)) return 'Este navegador não oferece push.';
           let permission = Notification.permission;
           if (permission === 'default' && requestPermission) permission = await Notification.requestPermission();
           if (permission !== 'granted') return 'Permissão de notificações não autorizada.';
           try {
                  const registration = await navigator.serviceWorker.register(`${APP_ORIGIN}/sw-v4.js?v=14`);
              const token = await (await getFirebaseMessaging()).getToken({ vapidKey:FIREBASE_VAPID_KEY, serviceWorkerRegistration:registration });
             if (!token) return 'Não foi possível criar o dispositivo de push.';
             const { error } = await supabaseClient.from('push_subscriptions').upsert({ profile_id:currentUser.id, endpoint:`fcm:${token}`, fcm_token:token, p256dh:'firebase', auth:'firebase', user_agent:navigator.userAgent, last_seen_at:new Date().toISOString() }, { onConflict:'endpoint' });
             if (error) return 'O dispositivo foi autorizado, mas não foi salvo na conta.';
             return 'Push ativado neste dispositivo.';
           } catch (error) { return error?.message || 'Não foi possível ativar o push neste dispositivo.'; }
         }
         function syncPushSubscription() {
           const preferences = readPreferences();
           if (preferences.pushAlerts && 'Notification' in window && Notification.permission === 'granted') registerPushSubscription(false);
         }
        function applyPreferences() {
         const preferences = readPreferences();
         document.body.classList.toggle('reduced-motion', Boolean(preferences.reduceMotion));
         document.querySelectorAll('[data-live-clock]').forEach(clock => clock.classList.toggle('hidden', !preferences.showClock));
       }
        function legalPageMarkup(tool) {
          const pages = {
            about:`<div class="eyebrow">Informações do aplicativo</div><h2>Sobre o BFR Conecta</h2><div class="help-list"><div class="help-item"><strong>Criado por</strong><p>Raull Macedo</p></div><div class="help-item"><strong>Finalidade</strong><p>Projeto desenvolvido de forma independente por Raull Macedo para uso educacional na Escola Benício Ferreira Reis.</p></div><div class="help-item"><strong>Versão</strong><p>1.1.0 · Atualizado em 05/09/2026</p></div><div class="help-item"><strong>Identidade</strong><p>BFR Conecta · Escola Benício Ferreira Reis · Limoeiro de Anadia, AL.</p></div></div><div class="login-legal-links"><button type="button" data-legal-page="privacy">Privacidade / LGPD</button><button type="button" data-legal-page="terms">Termos de uso</button><button type="button" data-legal-page="contact">Contato</button></div>`,
            privacy:`<div class="eyebrow">Proteção de dados</div><h2>Privacidade e LGPD</h2><div class="legal-copy"><p>O BFR Conecta deve ser usado somente pela comunidade escolar autorizada.</p><p>Os dados de alunos, responsáveis, notas, frequência, fotos e ocorrências devem ser utilizados apenas para acompanhamento pedagógico, comunicação escolar e segurança da comunidade.</p><p>O acesso é separado por perfil. A escola deve manter os vínculos atualizados, limitar permissões e atender solicitações de correção ou exclusão conforme a legislação aplicável.</p><p>Para dúvidas sobre seus dados, procure a secretaria ou a coordenação da Escola Benício Ferreira Reis.</p></div><div class="login-legal-links"><button type="button" data-legal-page="about">Sobre o aplicativo</button><button type="button" data-legal-page="terms">Termos de uso</button></div>`,
            terms:`<div class="eyebrow">Uso responsável</div><h2>Termos de uso</h2><div class="legal-copy"><p>O acesso ao BFR Conecta é individual e destinado às atividades da comunidade escolar.</p><p>Não compartilhe sua conta, crachás QR, fotos, notas, documentos ou informações de outros alunos.</p><p>Responsáveis devem manter seus dados e vínculos corretos. A administração pode revisar acessos e corrigir cadastros para proteger os estudantes.</p><p>O aplicativo pode receber atualizações, correções e períodos de indisponibilidade para manutenção.</p></div><div class="login-legal-links"><button type="button" data-legal-page="about">Sobre o aplicativo</button><button type="button" data-legal-page="privacy">Privacidade / LGPD</button></div>`,
            contact:`<div class="eyebrow">Atendimento</div><h2>Contato</h2><div class="legal-copy"><p>Para dúvidas de acesso, atualização cadastral, vínculos de alunos ou documentos, procure a secretaria da Escola Benício Ferreira Reis.</p><p>Para questões pedagógicas ou ocorrências, procure a coordenação escolar.</p><p><strong>Autoria do aplicativo:</strong> Raull Macedo.</p></div><div class="login-legal-links"><button type="button" data-legal-page="about">Sobre o aplicativo</button><button type="button" data-legal-page="privacy">Privacidade / LGPD</button></div>`
          };
          return `<div class="modal-card account-tool-card"><button class="modal-close" type="button" data-close-account-tool aria-label="Fechar informações">×</button>${pages[tool] || pages.about}</div>`;
        }
        function openAccountTool(tool) {
         let modal = document.getElementById('accountToolModal');
         if (!modal) {
           modal = document.createElement('div');
           modal.id = 'accountToolModal';
           modal.className = 'modal hidden';
            modal.setAttribute('role','dialog');
            modal.setAttribute('aria-modal','true');
           document.body.appendChild(modal);
           modal.addEventListener('click', event => { if (event.target === modal || event.target.closest('[data-close-account-tool]')) modal.classList.add('hidden'); });
         }
            if (['about','privacy','terms','contact'].includes(tool)) {
              modal.innerHTML = legalPageMarkup(tool);
            } else if (tool === 'profile') {
              const displayName = normalizePreferredName(currentProfile?.display_name_custom);
              const officialName = normalizePreferredName(currentProfile?.full_name || currentUser?.user_metadata?.full_name || currentUser?.email || 'Não informado');
              modal.innerHTML = `<div class="modal-card account-tool-card preferred-name-card"><button class="modal-close" type="button" data-close-account-tool aria-label="Fechar Meu Perfil">×</button><div class="eyebrow">Conta e identidade</div><h2>Meu Perfil</h2><p>Escolha como quer ser chamado no aplicativo. O nome oficial do cadastro escolar não será alterado.</p><form data-profile-display-name-form novalidate><label>Nome de tratamento<input name="display_name_custom" type="text" maxlength="40" minlength="2" autocomplete="nickname" required value="${escapeHtml(displayName)}" placeholder="Ex.: Gabi"><small class="field-hint">De 2 a 40 caracteres. Usado nas saudações.</small></label><label>Nome oficial do cadastro<input type="text" value="${escapeHtml(officialName)}" readonly><small class="field-hint">Somente a escola pode corrigir este cadastro.</small></label><button class="primary-button" type="submit">Salvar nome de tratamento</button><p class="publish-status" data-profile-display-name-status aria-live="polite"></p></form></div>`;
              const profileForm = modal.querySelector('[data-profile-display-name-form]');
              profileForm.addEventListener('submit', async event => {
                event.preventDefault();
                const status = profileForm.querySelector('[data-profile-display-name-status]');
                const button = profileForm.querySelector('button[type="submit"]');
                const name = normalizePreferredName(profileForm.display_name_custom.value);
                const validationError = preferredNameError(name);
                if (validationError) { status.textContent = validationError; profileForm.display_name_custom.focus(); return; }
                button.disabled = true;
                status.textContent = 'Salvando...';
                let result;
                try { result = await savePreferredName(name); } catch (error) { result = { error }; }
                button.disabled = false;
                status.textContent = result.error ? (result.error.message || 'Não foi possível salvar agora.') : 'Nome de tratamento atualizado.';
              });
            } else if (tool === 'preferences') {
            const preferences = readPreferences();
            modal.innerHTML = `<div class="modal-card account-tool-card"><button class="modal-close" type="button" data-close-account-tool aria-label="Fechar preferências">×</button><div class="eyebrow">Personalização e avisos</div><h2>Preferências</h2><p>Escolha como o BFR Conecta deve aparecer e por onde você quer receber avisos da escola.</p><div class="preference-section"><div class="eyebrow">Canais externos</div><p class="field-hint">Os avisos serão enviados somente depois que a escola conectar os serviços correspondentes.</p><label class="preference-row"><span><strong>WhatsApp</strong><small>Usa o telefone cadastrado</small></span><input type="checkbox" name="whatsappAlerts" ${preferences.whatsappAlerts ? 'checked' : ''}></label><label class="preference-row"><span><strong>E-mail</strong><small>Usa o e-mail da conta</small></span><input type="checkbox" name="emailAlerts" ${preferences.emailAlerts ? 'checked' : ''}></label><label class="preference-row"><span><strong>Push no celular</strong><small>Alerta no navegador ou aplicativo</small></span><input type="checkbox" name="pushAlerts" ${preferences.pushAlerts ? 'checked' : ''}></label></div><form data-preferences-form><div class="preference-section"><div class="eyebrow">Aparência</div><label class="preference-row"><span>Mostrar relógio de atualização</span><input type="checkbox" name="showClock" ${preferences.showClock ? 'checked' : ''}></label><label class="preference-row"><span>Reduzir animações</span><input type="checkbox" name="reduceMotion" ${preferences.reduceMotion ? 'checked' : ''}></label></div><button class="primary-button" type="submit">Salvar preferências</button><p class="publish-status" data-preferences-status></p></form></div>`;
            const preferenceForm = modal.querySelector('[data-preferences-form]');
            modal.querySelectorAll('[name="emailAlerts"],[name="whatsappAlerts"],[name="pushAlerts"],[name="showClock"],[name="reduceMotion"]').forEach(input => input.addEventListener('change', () => { preferenceForm.dataset.dirty = 'true'; }));
            loadNotificationPreferences().then(next => { if (preferenceForm.dataset.dirty === 'true') return; ['emailAlerts','whatsappAlerts','pushAlerts','showClock','reduceMotion'].forEach(name => { const input = modal.querySelector(`[name="${name}"]`); if (input) input.checked = Boolean(next[name]); }); });
            preferenceForm.addEventListener('submit', async event => {
              event.preventDefault();
              const form = event.currentTarget;
              const next = { showClock:form.showClock.checked, reduceMotion:form.reduceMotion.checked, emailAlerts:modal.querySelector('[name="emailAlerts"]').checked, whatsappAlerts:modal.querySelector('[name="whatsappAlerts"]').checked, pushAlerts:modal.querySelector('[name="pushAlerts"]').checked };
               localStorage.setItem(accountStorageKey('bfr-preferences'), JSON.stringify(next));
              applyPreferences();
               const error = await saveNotificationPreferences(next);
               const pushStatus = next.pushAlerts ? await registerPushSubscription(true) : '';
               modal.querySelector('[data-preferences-status]').textContent = error ? 'Preferências salvas neste dispositivo. A sincronização da conta ainda não está disponível.' : pushStatus || 'Preferências salvas para esta conta.';
            });
         } else {
           modal.innerHTML = '<div class="modal-card account-tool-card"><button class="modal-close" type="button" data-close-account-tool aria-label="Fechar ajuda">×</button><div class="eyebrow">Orientação rápida</div><h2>Ajuda e suporte</h2><p>Veja os passos mais comuns para usar o portal da escola.</p><div class="help-list"><div class="help-item"><strong>Como entrar</strong><p>Toque em “Continuar com Google” e escolha se a conta será de aluno ou responsável.</p></div><div class="help-item"><strong>Como acessar o crachá</strong><p>Abra “Crachá QR”. O responsável ou aluno vinculado pode exibir o código; a administração pode emitir para qualquer aluno.</p></div><div class="help-item"><strong>Não encontro o aluno</strong><p>Peça à administração para vincular a conta Google ao cadastro oficial do estudante.</p></div><div class="help-item"><strong>Precisa de atendimento</strong><p>Procure a secretaria ou a coordenação da Escola Benício Ferreira Reis.</p></div></div></div>';
         }
         modal.classList.remove('hidden');
         modal.querySelector('.modal-close')?.focus();
       }
         function setupAccountTools() {
           document.querySelectorAll('[data-account-tool]').forEach(button => button.addEventListener('click', () => openAccountTool(button.dataset.accountTool)));
           document.querySelectorAll('[data-legal-page]').forEach(button => {
              if (button.dataset.runtimeLegalReady === 'true') return;
              button.dataset.runtimeLegalReady = 'true';
             button.addEventListener('click', () => openAccountTool(button.dataset.legalPage));
           });
            if (document.body.dataset.runtimeLegalLinksReady !== 'true') {
             document.body.dataset.runtimeLegalLinksReady = 'true';
            document.addEventListener('click', event => { const button = event.target.closest('[data-legal-page]'); if (button) openAccountTool(button.dataset.legalPage); });
          }
          document.addEventListener('keydown', event => { if (event.key === 'Escape') document.getElementById('accountToolModal')?.classList.add('hidden'); });
         applyPreferences();
       }
       function formatEventDate(value) {
        const date = new Date(value);
        return { day:date.toLocaleDateString('pt-BR',{day:'2-digit'}), month:date.toLocaleDateString('pt-BR',{month:'short'}).replace('.', ''), time:date.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) };
      }
         function renderLiveContent(announcements, events) {
         if (window.BFRParentDashboard?.updateContent) window.BFRParentDashboard.updateContent(announcements || [], events || []);
         const note = parentView.querySelector('#comunicadosPanel .digital-note');
          if (note) note.innerHTML = announcements.length ? announcements.slice(0,2).map(item => `<div class="digital-note-top"><span class="note-type">${item.important ? 'Comunicado importante' : 'Comunicado oficial'}</span><time>${new Date(item.published_at).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.', '')}</time></div><h3>${escapeHtml(item.title)}</h3><p>${escapeHtml(item.body)}</p><div class="digital-note-foot"><span>Publicado pela escola</span><button class="text-button" type="button" data-announcement-read="${item.id}">Marcar como lido ✓</button></div>`).join('') : '<div class="roster-empty">Nenhum comunicado publicado no momento.</div>';
         const calendar = parentView.querySelector('.project-list');
          if (calendar) calendar.innerHTML = events.length ? events.slice(0,3).map(item => { const date = formatEventDate(item.starts_at); return `<div class="project"><div class="project-date"><b>${date.day}</b><span>${date.month}</span></div><div><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.location || 'A confirmar')} · ${date.time}</p></div><span class="project-arrow">›</span></div>`; }).join('') : '<div class="roster-empty">Nenhum evento publicado no momento.</div>';
         const news = parentView.querySelector('#noticiasPanel');
         if (news) news.innerHTML = `<div class="news-heading"><h3>Notícias da escola</h3><button class="text-button" type="button" data-news-all>Ver todas →</button></div>${announcements.length ? announcements.slice(0,4).map(item => `<div class="news-item"><span class="news-bullet blue-bullet">✦</span><div><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.body)}</p></div><time>${new Date(item.published_at).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.','')}</time></div>`).join('') : '<div class="roster-empty">Nenhuma notícia publicada no momento.</div>'}`;
         const studentNotice = studentView.querySelector('.notice');
        if (studentNotice) studentNotice.innerHTML = announcements.length ? `<div class="notice-mark">!</div><div><strong>${escapeHtml(announcements[0].title)}</strong><p>${escapeHtml(announcements[0].body)}</p></div>` : '<div class="notice-mark">i</div><div><strong>Sem novos comunicados</strong><p>A escola ainda não publicou avisos para a comunidade.</p></div>';
        const studentAgenda = studentView.querySelectorAll('.project-list')[1];
          if (studentAgenda) studentAgenda.innerHTML = events.length ? events.slice(0,3).map(item => { const date = formatEventDate(item.starts_at); return `<div class="project"><div class="project-date"><b>${date.day}</b><span>${date.month}</span></div><div><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.location || 'A confirmar')} · ${date.time}</p></div></div>`; }).join('') : '<div class="roster-empty">Nenhum evento publicado no momento.</div>';
        }
        function renderParentOccurrences(occurrences) {
          const panel = parentView?.querySelector('#ocorrenciasPanel');
          const item = occurrences?.[0];
          if (!panel || !item) { panel?.classList.add('hidden'); showParentDataStatus(''); return; }
          panel.classList.remove('hidden');
          panel.dataset.occurrenceId = item.id;
          panel.querySelector('.occurrence-status').textContent = item.acknowledged_at ? 'lida' : '1 nova';
          panel.querySelector('.occurrence-body strong').textContent = item.title;
          panel.querySelector('.occurrence-body p').textContent = new Date(item.occurred_at).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.','');
          panel.querySelector('.occurrence-body span').textContent = item.description;
          panel.querySelector('#occurrenceBtn').textContent = item.acknowledged_at ? 'Ver detalhes da ocorrência →' : 'Ler ocorrência e confirmar →';
          const modal = document.getElementById('occurrenceModal');
          modal.querySelector('.eyebrow').textContent = `Ocorrência · ${new Date(item.occurred_at).toLocaleDateString('pt-BR',{day:'2-digit',month:'long'})}`;
          modal.querySelector('h2').textContent = item.title;
          modal.querySelector('.occurrence-detail strong').textContent = item.title;
          modal.querySelector('.occurrence-detail p').textContent = item.description;
          modal.querySelector('#ackOccurrence').classList.toggle('hidden', Boolean(item.acknowledged_at));
          modal.querySelector('#occurrenceAck').classList.toggle('hidden', !item.acknowledged_at);
          document.querySelector('[data-section="ocorrencias"] .nav-badge')?.classList.toggle('hidden', Boolean(item.acknowledged_at));
          showParentDataStatus('');
        }
        function startLiveContentUpdates() {
         if (liveContentTimer) return;
         liveContentTimer = setInterval(() => { if (document.visibilityState !== 'hidden') { setupLiveContent(); loadSchoolActivities(true); } }, 60000);
         if (supabaseClient?.channel) {
            liveContentChannel = subscribeWithRecovery('bfr-school-content-live', channel => channel
              .on('postgres_changes', { event:'*', schema:'public', table:'announcements' }, () => setupLiveContent())
              .on('postgres_changes', { event:'*', schema:'public', table:'school_events' }, () => setupLiveContent())
              .on('postgres_changes', { event:'*', schema:'public', table:'school_activities' }, () => loadSchoolActivities(true)));
         }
         document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') setupLiveContent(); }, { once:false });
       }
       async function setupLiveContent() {
         if (!supabaseClient || !currentProfile || currentProfile.role === 'pending') return;
         startLiveContentUpdates();
         setupParentRealtime(true);
         const [{ data: announcements, error: announcementsError }, { data: events, error: eventsError }] = await Promise.all([
           supabaseClient.from('announcements').select('id,title,body,published_at,important').order('published_at',{ascending:false}).limit(5),
          supabaseClient.from('school_events').select('title,description,starts_at,location').gte('starts_at',new Date().toISOString()).order('starts_at',{ascending:true}).limit(5)
        ]);
        if (announcementsError || eventsError) return;
        renderLiveContent(announcements || [], events || []);
      }
      function setupPublishing() {
        const announcementForm = document.getElementById('announcementPublishForm');
        const eventForm = document.getElementById('eventPublishForm');
        if (!announcementForm || announcementForm.dataset.ready) return;
        announcementForm.dataset.ready = 'true';
        announcementForm.addEventListener('submit', async event => {
          event.preventDefault();
          const form = event.currentTarget;
          const status = document.getElementById('announcementPublishStatus');
          const data = new FormData(form);
          const { error } = await supabaseClient.from('announcements').insert({ title:data.get('title').trim(), body:data.get('body').trim(), important:data.has('important'), published_by:currentUser.id });
          status.textContent = error ? 'Não foi possível publicar. Tente novamente.' : 'Comunicado publicado.';
          if (!error) { form.reset(); setupLiveContent(); }
        });
        eventForm.addEventListener('submit', async event => {
          event.preventDefault();
          const form = event.currentTarget;
          const status = document.getElementById('eventPublishStatus');
          const data = new FormData(form);
          const { error } = await supabaseClient.from('school_events').insert({ title:data.get('title').trim(), description:data.get('description').trim() || null, starts_at:data.get('starts_at'), location:data.get('location').trim() || null, event_type:'school' });
          status.textContent = error ? 'Não foi possível publicar. Tente novamente.' : 'Evento publicado.';
          if (!error) { form.reset(); setupLiveContent(); }
        });
      }
      function setupGatekeeperRegistration() {
        const form = document.getElementById('gatekeeperRegistrationForm');
        if (!form || form.dataset.ready) return;
        form.dataset.ready = 'true';
        form.addEventListener('submit', async event => {
          event.preventDefault();
          const status = document.getElementById('gatekeeperRegistrationStatus');
          const data = new FormData(form);
          const email = String(data.get('email') || '').trim().toLowerCase();
          const fullName = String(data.get('full_name') || '').trim();
          if (!email || !supabaseClient || !currentUser) { status.textContent = 'Informe um email válido.'; return; }
          status.textContent = 'Autorizando a conta...';
          const { data:pending, error:pendingError } = await supabaseClient.from('access_requests').select('id').ilike('email',email).eq('status','approved').order('reviewed_at',{ascending:false}).limit(1).maybeSingle();
          if (pendingError) { status.textContent = 'Não foi possível consultar as autorizações.'; return; }
          const requestPayload = { email, requested_role:'gatekeeper', approved_role:'gatekeeper', status:'approved', reviewed_by:currentUser.id, reviewed_at:new Date().toISOString() };
          const requestResult = pending ? await supabaseClient.from('access_requests').update(requestPayload).eq('id',pending.id) : await supabaseClient.from('access_requests').insert(requestPayload);
          if (requestResult.error) { status.textContent = 'Não foi possível salvar a autorização.'; return; }
          const { data:profile, error:profileError } = await supabaseClient.from('profiles').select('id').ilike('email',email).limit(1).maybeSingle();
          if (profileError) { status.textContent = 'Autorização salva, mas não foi possível consultar a conta.'; return; }
          if (profile) {
            const update = { role:'gatekeeper' };
            if (fullName) update.full_name = fullName;
            const { error } = await supabaseClient.from('profiles').update(update).eq('id',profile.id);
            if (error) { status.textContent = 'Autorização salva, mas a função da conta não foi atualizada.'; return; }
            status.textContent = 'Conta atualizada. O porteiro já pode entrar com o Google.';
          } else {
            status.textContent = 'Email autorizado. No primeiro login Google, a função Portaria QR será aplicada.';
          }
          form.reset();
        });
      }
       const carroceataVerifiedProject = {
         summary:'Uma tradição escolar do Distrito Pé Leve que transforma carroças ornamentadas em arte, memória e participação comunitária.',
         information:'A Carroceata é uma tradição cultural e escolar do Distrito Pé Leve/Pé Leve Novo, em Limoeiro de Anadia-AL. A memória pública do evento aparece pelo menos desde 2009 e está ligada à Escola Municipal de Educação Básica Prefeito Benício Ferreira Reis.\n\nEstudantes, professores, famílias e moradores participam da criação das carroças: durante as semanas de preparação, as turmas pesquisam temas, produzem os elementos visuais e apresentam personagens, histórias e referências culturais no desfile. Em 2025, a programação informou início às 16h30 e destacou temas étnicos, culturais e econômicos da identidade brasileira.\n\nA edição de 2022 trabalhou o tema “Minha Cidade – Cantos, Encantos e Diversidade Cultural”. Em 2025, o tema foi “Raízes do Brasil: história e tradições que constroem a nossa identidade”. Em 2026, a celebração foi apresentada como “Arte que Transforma”, com desfile, premiação e apresentações musicais.\n\nO objetivo da escola é valorizar a cultura local, estimular pesquisa e criatividade, fortalecer a convivência e aproximar a comunidade da vida escolar. As colocações, turmas, temas específicos das equipes e fotos ficam reservados para publicação pelo administrador.'
       };
       const carroceataSources = [
         ['Cada Minuto · edição 2026','https://www.cadaminuto.com.br/noticia/2026/08/17/carroceata-2026-celebra-cultura-criatividade-e-musica-em-limoeiro-de-anadia'],
         ['Cada Minuto · edição 2025','https://www.cadaminuto.com.br/noticia/2025/08/18/limoeiro-de-anadia-carroceata-2025-encanta-moradores-do-distrito-pe-leve-e-celebra-raizes-culturais-do-brasil'],
         ['Prefeitura de Limoeiro · edição 2022','https://www.limoeirodeanadia.al.gov.br/noticia/2279/carroceata-de-limoeiro-levara-cultura-tradicao-e-criatividade-as-ruas-do-distrito-pe-leve/'],
         ['Cada Minuto · histórico de 2013','https://www.cadaminuto.com.br/noticia/2013/06/22/carroceata-e-resgate-da-cultura-nordestina-marcam-festejos-juninos-em-limoeiro-de-anadia']
       ];
        const projectState = { projects:[], photos:[], results:[], students:[], classes:[], activeSlug:'alimentacao-saudavel', loaded:false, loading:false };
        async function projectMediaUrl(path) {
           if (!path || !supabaseClient) return '';
           const { data, error } = await supabaseClient.storage.from('project-media').createSignedUrl(path, 3600);
           return error ? '' : data?.signedUrl || '';
         }
        function hydrateCarroceataProject(project) { return project.slug === 'carroceata' && project.information === 'Espaço para registrar a preparação, o percurso e os momentos da Carroceata.' ? { ...project, ...carroceataVerifiedProject } : project; }
       function carroceataLevelLabel(level) { return level === 1 ? 'Nível 1 · 8º e 9º ano' : 'Nível 2 · 6º e 7º ano'; }
       function currentScheduleMarkup() { return scheduleMarkup.replaceAll('documento-enviado','2026').replaceAll('documento enviado','2026').replaceAll('Horário vespertino do 2026','Horário vespertino 2026').replaceAll('Observação: o próprio PDF vespertino está identificado como 2025.','Horário vespertino atualizado para 2026.'); }
        const schoolClockSchedules = {
          morning: {
            title:'Horários de relógio · turno matutino',
            days:[
              { label:'Segunda-feira, quarta-feira e sexta-feira', weekdays:[1,3,5], rows:[
                {label:'1ª aula',start:'07:00',end:'08:00'}, {label:'2ª aula',start:'08:00',end:'09:00'}, {label:'Intervalo',start:'09:00',end:'09:20',kind:'break'}, {label:'3ª aula',start:'09:20',end:'10:20'}, {label:'4ª aula',start:'10:20',end:'11:20'}
              ]},
              { label:'Terça-feira e quinta-feira', weekdays:[2,4], rows:[
                {label:'1ª aula',start:'07:00',end:'07:50'}, {label:'2ª aula',start:'07:50',end:'08:40'}, {label:'3ª aula',start:'08:40',end:'09:30'}, {label:'Intervalo',start:'09:30',end:'09:50',kind:'break'}, {label:'4ª aula',start:'09:50',end:'10:40'}, {label:'5ª aula',start:'10:40',end:'11:30'}
              ]}
            ]
          },
          afternoon: {
            title:'Horários de relógio · turno vespertino',
            days:[
              { label:'Segunda, quarta e sexta', weekdays:[1,3,5], rows:[
                {label:'1ª aula',start:'13:00',end:'14:00'}, {label:'2ª aula',start:'14:00',end:'15:20'}, {label:'3ª aula',start:'15:20',end:'16:20'}, {label:'4ª aula',start:'16:20',end:'17:20'}
              ]},
              { label:'Terça e quinta', weekdays:[2,4], rows:[
                {label:'1ª aula',start:'13:00',end:'13:50'}, {label:'2ª aula',start:'13:50',end:'14:40'}, {label:'3ª aula',start:'14:40',end:'15:30'}, {label:'Intervalo',start:'15:30',end:'15:50',kind:'break'}, {label:'4ª aula',start:'15:50',end:'16:40'}, {label:'5ª aula',start:'16:40',end:'17:30'}
              ]}
            ],
            note:'Na segunda, quarta e sexta, a indicação segue os horários de início informados pela escola; a duração foi organizada para sinalizar a aula atual.'
          }
        };
         let scheduleNowTimer = null;
         function scheduleTimeLabel(value) { const [hour,minute] = String(value || '').split(':').map(Number); return `${hour}h${minute ? String(minute).padStart(2,'0') : ''}`; }
         function scheduleRangeLabel(row) { return `${scheduleTimeLabel(row.start)} às ${scheduleTimeLabel(row.end)}`; }
         function parentScheduleShift(value) { const shift = String(value || '').toLocaleLowerCase('pt-BR'); if (!shift) return null; return shift.includes('vesp') || shift.includes('tarde') || shift.includes('afternoon') ? 'afternoon' : 'morning'; }
         function ensureParentScheduleSummary() {
           if (!parentView || parentView.querySelector('[data-parent-schedule-summary]')) return;
           if (!document.getElementById('parent-live-styles')) {
             const style = document.createElement('style');
             style.id = 'parent-live-styles';
             style.textContent = '.parent-schedule-student{padding:13px 0;border-top:1px solid var(--line)}.parent-schedule-student:first-child{border-top:0;padding-top:0}.parent-schedule-student-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.parent-schedule-student-head strong,.parent-entry-row strong{display:block;font-size:12px}.parent-schedule-student-head span,.parent-entry-row span{display:block;margin-top:4px;color:var(--muted);font-size:10px}.parent-schedule-student-head>b{color:#1558dc;font-size:10px;text-align:right}.parent-schedule-rows{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:6px;margin-top:10px}.parent-schedule-rows span{display:flex;justify-content:space-between;gap:5px;padding:7px 8px;border:1px solid var(--line);border-radius:8px;background:#fbfcff;font-size:9px}.parent-schedule-rows small{color:var(--muted)}.parent-schedule-rows b{color:var(--ink);font-size:9px}.parent-entry-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--line)}.parent-entry-row:first-child{border-top:0;padding-top:0}.parent-entry-row.is-blocked{background:#fffaf8;border-radius:8px;padding:11px}.parent-entry-row .gate-direction-pill{flex:0 0 auto}.parent-entry-row .gate-direction-pill:not(.is-blocked){color:#35755e;background:#eaf6ef}.parent-entry-row .gate-direction-pill.is-blocked{color:#a24f3d;background:#fff0eb}@media(max-width:600px){.parent-schedule-student-head{display:grid}.parent-schedule-student-head>b{text-align:left}.parent-entry-row{align-items:flex-start;display:grid}.parent-entry-row .gate-direction-pill{justify-self:start}}';
             document.head.appendChild(style);
           }
           ensureScheduleViews();
           const schedulePanel = parentView.querySelector('[data-schedule-panel]');
           if (!schedulePanel) return;
           const panel = document.createElement('section');
           panel.className = 'panel parent-schedule-summary';
           panel.dataset.parentScheduleSummary = 'true';
           panel.innerHTML = '<div class="panel-heading"><div><div class="eyebrow">Acompanhamento da turma</div><h2 style="margin-top:4px">Horários dos seus filhos</h2></div><span class="online-dot">● atualizado</span></div><p class="agenda-intro">O horário é organizado pelo turno cadastrado na turma. A aula atual muda automaticamente pelo relógio da escola.</p><div data-parent-schedule-list><div class="project-empty">Carregando horários vinculados...</div></div>';
           schedulePanel.before(panel);
         }
         function renderParentScheduleSummary() {
           const host = parentView?.querySelector('[data-parent-schedule-list]');
           if (!host) return;
           const students = parentDataState.students || [];
           const classes = parentDataState.classes || [];
           const now = typeof schoolClockNow === 'function' ? schoolClockNow() : null;
           host.innerHTML = students.length ? students.map(student => {
             const classData = classes.find(item => item.id === student.class_id);
             const shift = parentScheduleShift(classData?.shift);
             const schedule = shift ? schoolClockSchedules[shift] : null;
             const day = schedule?.days.find(item => item.weekdays.includes(now?.weekday));
             const rows = day?.rows || [];
             const active = now && rows.find(row => now.minutes >= Number(row.start.slice(0,2)) * 60 + Number(row.start.slice(3)) && now.minutes < Number(row.end.slice(0,2)) * 60 + Number(row.end.slice(3)));
             const next = now && rows.find(row => now.minutes < Number(row.start.slice(0,2)) * 60 + Number(row.start.slice(3)));
             const current = active ? (active.kind === 'break' ? 'Intervalo agora' : `Aula atual · ${active.label}`) : next ? `Próxima aula · ${next.label}` : day ? 'Aulas encerradas hoje' : 'Sem aulas hoje';
             const classLabel = classData ? `${classData.year}º ano ${classData.class_code}` : 'Turma ainda não informada';
             const shiftLabel = shift === 'afternoon' ? 'Vespertino' : shift === 'morning' ? 'Matutino' : 'Turno não informado';
             return `<article class="parent-schedule-student"><div class="parent-schedule-student-head"><div><strong>${escapeHtml(student.official_name)}</strong><span>${escapeHtml(classLabel)} · ${shiftLabel}</span></div><b>${escapeHtml(current)}</b></div>${rows.length ? `<div class="parent-schedule-rows">${rows.map(row => `<span><small>${escapeHtml(row.label)}</small><b>${scheduleRangeLabel(row)}</b></span>`).join('')}</div>` : '<div class="project-empty">O turno desta turma ainda não foi informado pela escola.</div>'}</article>`;
           }).join('') : '<div class="project-empty">Nenhum aluno vinculado a esta conta.</div>';
         }
         function ensureParentEntryLivePanel() {
           if (!parentView || parentView.querySelector('[data-parent-entry-live]')) return;
           const child = parentView.querySelector('.child-card');
           if (!child) return;
           child.insertAdjacentHTML('afterend', '<section class="panel parent-entry-live" data-parent-entry-live><div class="panel-heading"><div><div class="eyebrow">Portaria · acompanhamento em tempo real</div><h2 style="margin-top:4px">Entrada na escola</h2></div><span class="online-dot">● ao vivo</span></div><p class="agenda-intro">Quando a portaria confirmar o QR Code, a entrada ou saída aparece aqui automaticamente.</p><div class="growth-actions"><button class="growth-action" type="button" data-enable-browser-alerts>Ativar alertas neste navegador</button></div><div data-parent-entry-live-list><div class="project-empty">Aguardando leituras de hoje...</div></div></section>');
         }
         function renderParentEntryLive() {
           const host = parentView?.querySelector('[data-parent-entry-live-list]');
           if (!host) return;
           const today = schoolTodayIso();
           const records = (parentGateState.records || []).filter(item => item.checked_at && schoolTodayIso(new Date(item.checked_at)) === today);
           const students = parentDataState.students || [];
           host.innerHTML = parentGateState.error ? '<div class="project-empty">A portaria ainda não disponibilizou os registros para esta conta.</div>' : students.length ? students.map(student => {
             const record = records.find(item => item.student_id === student.id);
             if (!record) return `<article class="parent-entry-row"><div><strong>${escapeHtml(student.official_name)}</strong><span>Nenhuma passagem registrada hoje.</span></div><b class="gate-direction-pill">Aguardando</b></article>`;
             const time = schoolClock(new Date(record.checked_at));
             const blocked = record.entry_status === 'blocked' || record.entry_allowed === false;
             const label = blocked ? 'Atenção' : record.direction === 'exit' ? 'Saiu' : 'Entrou';
             return `<article class="parent-entry-row ${blocked ? 'is-blocked' : ''}"><div><strong>${escapeHtml(student.official_name)}</strong><span>${blocked ? escapeHtml(record.restriction_reason || 'Entrada pendente de conferência') : `${label} na escola às ${time}.`}</span></div><b class="gate-direction-pill ${blocked ? 'is-blocked' : ''}">${blocked ? 'Atenção' : label}</b></article>`;
           }).join('') : '<div class="project-empty">Nenhum aluno vinculado a esta conta.</div>';
         }
         async function loadParentGateCheckins(force = false) {
           if (!supabaseClient || !currentUser || !['parent','developer'].includes(currentProfile?.role) || parentGateState.loading || (!force && parentGateState.loaded)) { renderParentEntryLive(); return; }
           const ids = (parentDataState.students || []).map(item => item.id).filter(Boolean);
           if (!ids.length) { renderParentEntryLive(); return; }
           parentGateState.loading = true;
           const result = await supabaseClient.from('gate_checkins').select('id,student_id,direction,checked_at,entry_status,entry_allowed,restriction_reason,guardian_present,guardian_confirmed_at').in('student_id', ids).order('checked_at',{ascending:false}).limit(40);
           parentGateState.error = Boolean(result.error);
           parentGateState.records = result.error ? [] : result.data || [];
           parentGateState.loaded = true;
           parentGateState.loading = false;
           renderParentEntryLive();
         }
         function startParentGateRealtime() {
           if (!supabaseClient?.channel || !currentUser || parentGateState.channel) return;
           parentGateState.channel = supabaseClient.channel(`bfr-parent-gate-${currentUser.id}`).on('postgres_changes', { event:'*', schema:'public', table:'gate_checkins' }, payload => {
             const ids = new Set((parentDataState.students || []).map(item => item.id));
             if (!ids.has(payload.new?.student_id)) return;
             parentGateState.loaded = false;
             loadParentGateCheckins(true);
             if (typeof loadGrowthNotifications === 'function') loadGrowthNotifications();
           }).subscribe();
           if (!parentGateState.refreshTimer) parentGateState.refreshTimer = setInterval(() => { if (document.visibilityState !== 'hidden') loadParentGateCheckins(true); }, 15000);
         }
        function ensureScheduleClockMarkup() {
          Object.entries(schoolClockSchedules).forEach(([shift,schedule]) => document.querySelectorAll(`[data-schedule-view="${shift}"]`).forEach(view => {
            if (view.querySelector('[data-schedule-clock]')) return;
            const card = document.createElement('div');
            card.className = 'schedule-clock-card';
            card.dataset.scheduleClock = 'true';
            card.dataset.scheduleShift = shift;
            const days = schedule.days.map(day => `<div class="schedule-clock-day" data-weekdays="${day.weekdays.join(',')}"><strong>${day.label}</strong><table>${day.rows.map(row => `<tr data-schedule-row data-label="${row.label}" data-start="${row.start}" data-end="${row.end}" data-schedule-kind="${row.kind || 'lesson'}"><td>${row.label}</td><td>${scheduleRangeLabel(row)}</td></tr>`).join('')}</table></div>`).join('');
            card.innerHTML = `<h3>${schedule.title}</h3><p>Horários informados pela escola para 2026.</p><div class="schedule-now is-off" data-schedule-now aria-live="polite"><span class="schedule-now-dot"></span><div><strong data-schedule-now-label>Consultando a aula atual...</strong><small data-schedule-now-detail>Horário de Brasília · atualizando automaticamente</small></div><time data-schedule-now-time>--:--</time></div><div class="schedule-clock-grid">${days}</div>${schedule.note ? `<div class="schedule-clock-note">${schedule.note}</div>` : ''}`;
            view.appendChild(card);
          }));
        }
        function schoolClockNow() {
          const parts = new Intl.DateTimeFormat('en-US',{timeZone:schoolTimeZone,weekday:'short',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());
          const values = Object.fromEntries(parts.filter(item => item.type !== 'literal').map(item => [item.type,item.value]));
          const weekdays = {Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6};
          const hour = Number(values.hour) === 24 ? 0 : Number(values.hour);
          return { weekday:weekdays[values.weekday], minutes:(hour * 60) + Number(values.minute || 0), clock:`${String(hour).padStart(2,'0')}:${String(values.minute || 0).padStart(2,'0')}` };
        }
        function scheduleCountdown(minutes) { if (minutes < 60) return `${minutes} min`; const hours = Math.floor(minutes / 60); const rest = minutes % 60; return `${hours}h${rest ? ` ${rest} min` : ''}`; }
        function updateScheduleNow() {
          const now = schoolClockNow();
          document.querySelectorAll('[data-schedule-clock]').forEach(card => {
            const shift = card.dataset.scheduleShift;
            const schedule = schoolClockSchedules[shift];
            const day = schedule?.days.find(item => item.weekdays.includes(now.weekday));
            const nowBox = card.querySelector('[data-schedule-now]');
            const label = card.querySelector('[data-schedule-now-label]');
            const detail = card.querySelector('[data-schedule-now-detail]');
            const time = card.querySelector('[data-schedule-now-time]');
            card.querySelectorAll('.schedule-clock-day').forEach(dayBox => {
              const isToday = day && dayBox.dataset.weekdays.split(',').map(Number).includes(now.weekday);
              dayBox.classList.toggle('is-today', Boolean(isToday));
              dayBox.querySelectorAll('[data-schedule-row]').forEach(row => row.classList.remove('schedule-current','schedule-upcoming','schedule-complete'));
            });
            if (!day) {
              nowBox?.classList.remove('is-live','is-break'); nowBox?.classList.add('is-off');
              if (label) label.textContent = 'Sem aulas hoje';
              if (detail) detail.textContent = 'O horário escolar volta no próximo dia letivo.';
              if (time) time.textContent = now.clock;
              return;
            }
            const dayBox = [...card.querySelectorAll('.schedule-clock-day')].find(item => item.dataset.weekdays.split(',').map(Number).includes(now.weekday));
            const rows = [...(dayBox?.querySelectorAll('[data-schedule-row]') || [])];
            const active = rows.find(row => now.minutes >= (Number(row.dataset.start.slice(0,2)) * 60 + Number(row.dataset.start.slice(3))) && now.minutes < (Number(row.dataset.end.slice(0,2)) * 60 + Number(row.dataset.end.slice(3))));
            const next = rows.find(row => now.minutes < (Number(row.dataset.start.slice(0,2)) * 60 + Number(row.dataset.start.slice(3))));
            rows.forEach(row => {
              const start = Number(row.dataset.start.slice(0,2)) * 60 + Number(row.dataset.start.slice(3));
              const end = Number(row.dataset.end.slice(0,2)) * 60 + Number(row.dataset.end.slice(3));
              if (active === row) row.classList.add('schedule-current');
              else if (next === row) row.classList.add('schedule-upcoming');
              else if (now.minutes >= end) row.classList.add('schedule-complete');
            });
            nowBox?.classList.remove('is-off','is-break','is-live');
            if (active) {
              const isBreak = active.dataset.scheduleKind === 'break';
              nowBox?.classList.add(isBreak ? 'is-break' : 'is-live');
              if (label) label.textContent = isBreak ? 'Intervalo agora' : `Aula atual · ${active.dataset.label}`;
              if (detail) detail.textContent = `${day.label} · termina às ${scheduleTimeLabel(active.dataset.end)}`;
              if (time) time.textContent = now.clock;
            } else if (next) {
              const start = Number(next.dataset.start.slice(0,2)) * 60 + Number(next.dataset.start.slice(3));
              nowBox?.classList.add('is-off');
              if (label) label.textContent = `Próxima aula · ${next.dataset.label}`;
              if (detail) detail.textContent = `Começa em ${scheduleCountdown(start - now.minutes)} · ${scheduleRangeLabel({start:next.dataset.start,end:next.dataset.end})}`;
              if (time) time.textContent = now.clock;
            } else {
              nowBox?.classList.add('is-off');
              if (label) label.textContent = 'Aulas encerradas hoje';
              if (detail) detail.textContent = `Último horário do ${shift === 'morning' ? 'turno matutino' : 'turno vespertino'} concluído.`;
              if (time) time.textContent = now.clock;
             }
           });
           if (parentDataState.loaded) renderParentScheduleSummary();
         }
         function ensureScheduleViews() {
           [parentView, teacherView, coordinatorView, studentView, adminView, directorView, monitorView, gatekeeperView].forEach(view => { if (view?.innerHTML && !view.querySelector('[data-schedule-panel]')) view.insertAdjacentHTML('beforeend', currentScheduleMarkup()); });
        }
        function setupScheduleViews() {
           ensureScheduleClockMarkup();
          document.querySelectorAll('[data-schedule-panel]').forEach(panel => {
             if (panel.dataset.runtimeReady === 'true') return;
             panel.dataset.runtimeReady = 'true';
             const intro = panel.querySelector('.agenda-intro');
             if (intro) intro.textContent = 'Consulte os horários de cada turno. O quadro abaixo destaca a aula atual e os intervalos.';
             panel.querySelectorAll('[data-school-calendar-link]').forEach(link => link.closest('.school-resource-links')?.remove());
             if (intro && !panel.querySelector('[data-school-calendar-link]')) intro.insertAdjacentHTML('afterend', '<div class="school-resource-links"><a data-school-calendar-link href="calendario-letivo-2026.pdf" target="_blank" rel="noopener noreferrer"><span class="school-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18"></path><path d="M7 14h2M11 14h2M15 14h2M7 17h2M11 17h2"></path></svg></span><span>Baixar calendário letivo 2026 ↗</span></a></div>');
            const panelId = `schedule-panel-${[...document.querySelectorAll('[data-schedule-panel]')].indexOf(panel) + 1}`;
           panel.id = panelId;
            panel.querySelectorAll('button[data-schedule-shift]').forEach(button => {
             const shift = button.dataset.scheduleShift;
             const view = panel.querySelector(`[data-schedule-view="${shift}"]`);
             if (view) { view.id = `${panelId}-${shift}`; view.setAttribute('role','tabpanel'); view.setAttribute('aria-labelledby',`${panelId}-tab-${shift}`); view.toggleAttribute('hidden', !button.classList.contains('active')); }
             button.id = `${panelId}-tab-${shift}`;
             button.setAttribute('aria-controls', `${panelId}-${shift}`);
              button.addEventListener('click', () => {
                 panel.querySelectorAll('button[data-schedule-shift]').forEach(item => { const selected = item === button; item.classList.toggle('active', selected); item.setAttribute('aria-selected', String(selected)); });
                panel.querySelectorAll('[data-schedule-view]').forEach(item => { const selected = item.dataset.scheduleView === shift; item.classList.toggle('active', selected); item.toggleAttribute('hidden', !selected); });
                updateScheduleNow();
              });
            });
             panel.querySelectorAll('.schedule-image').forEach(image => image.addEventListener('error', () => { const frame = image.closest('.schedule-frame'); if (frame) frame.innerHTML = '<div class="schedule-fallback">Não foi possível carregar a imagem do horário. Verifique se o arquivo foi publicado.</div>'; }, { once:true }));
          });
          updateScheduleNow();
          if (!scheduleNowTimer) scheduleNowTimer = window.setInterval(updateScheduleNow, 15000);
        }
       function setupPublicSchedule() {
         const button = document.getElementById('publicScheduleBtn');
         const modal = document.getElementById('publicScheduleModal');
         const host = document.getElementById('publicScheduleContent');
         const close = document.getElementById('closePublicSchedule');
           if (!button || !modal || !host || button.dataset.runtimeReady === 'true') return;
           button.dataset.runtimeReady = 'true';
         host.innerHTML = currentScheduleMarkup();
         setupScheduleViews();
         const hide = () => modal.classList.add('hidden');
         button.addEventListener('click', () => { modal.classList.remove('hidden'); close?.focus(); });
         close?.addEventListener('click', hide);
         modal.addEventListener('click', event => { if (event.target === modal) hide(); });
         document.addEventListener('keydown', event => { if (event.key === 'Escape' && !modal.classList.contains('hidden')) hide(); });
       }
       function ensureProjectViews() {
         [parentView, studentView, teacherView].forEach(view => { if (view && (view.id === 'parentView' || view.innerHTML) && !view.querySelector('[data-projects-panel]')) view.insertAdjacentHTML('beforeend', currentSchoolYearMarkup(projectsMarkup)); });
         if (adminView?.querySelector('.teacher-welcome') && !adminView.querySelector('#adminProjectsPanel')) adminView.insertAdjacentHTML('beforeend', adminProjectsMarkup);
      }
      function projectForSlug(slug = projectState.activeSlug) { return projectState.projects.find(project => project.slug === slug); }
      function projectTabsReady() {
         setupProjectPhotoOrdering();
         document.querySelectorAll('[data-project-tabs]').forEach(tabs => {
           if (tabs.dataset.ready) return;
           tabs.dataset.ready = 'true';
            tabs.querySelectorAll('[data-project-tab]').forEach(button => button.addEventListener('click', () => { projectState.activeSlug = button.dataset.projectTab; renderProjectPanels(); }));
          });
          const form = document.querySelector('[data-project-admin-form]');
          if (form && !form.dataset.ready) { form.dataset.ready = 'true'; form.addEventListener('submit', saveProject); }
          const podiumButton = document.querySelector('[data-save-podium]');
          if (podiumButton && !podiumButton.dataset.ready) { podiumButton.dataset.ready = 'true'; podiumButton.addEventListener('click', savePodium); }
          const carroceataButton = document.querySelector('[data-save-carroceata]');
          if (carroceataButton && !carroceataButton.dataset.ready) { carroceataButton.dataset.ready = 'true'; carroceataButton.addEventListener('click', saveCarroceata); }
        }
       async function renderPublicProjects() {
         const project = projectForSlug();
         await Promise.all([...document.querySelectorAll('.projects-panel:not(#adminProjectsPanel)')].map(async panel => {
           panel.querySelectorAll('[data-project-tab]').forEach(button => button.classList.toggle('active', button.dataset.projectTab === project?.slug));
           if (!project) return;
           panel.querySelector('[data-project-title]').textContent = project.title;
           panel.querySelector('[data-project-summary]').textContent = project.summary;
           panel.querySelector('[data-project-information]').textContent = project.information;
           const sources = panel.querySelector('[data-project-sources]');
           if (project.slug === 'carroceata') { sources.classList.remove('hidden'); sources.innerHTML = `<strong>Fontes consultadas</strong>${carroceataSources.map(([label,url]) => `<a href="${url}" target="_blank" rel="noreferrer">${label} ↗</a>`).join(' · ')}`; } else { sources.classList.add('hidden'); sources.innerHTML = ''; }
            const photos = projectState.photos.filter(photo => photo.project_id === project.id).sort((a,b) => (a.display_order ?? 999999) - (b.display_order ?? 999999) || new Date(b.created_at) - new Date(a.created_at));
           const photoMarkup = await Promise.all(photos.map(async photo => { const url = await projectMediaUrl(photo.storage_path); return url ? `<div class="project-photo"><img src="${escapeHtml(url)}" alt="${escapeHtml(photo.caption || project.title)}" tabindex="0" role="button"></div>` : ''; }));
           panel.querySelector('[data-project-photos]').innerHTML = photoMarkup.filter(Boolean).join('') || '<div class="project-empty">Nenhuma foto publicada neste projeto.</div>';
           const podium = panel.querySelector('[data-project-podium]');
           const results = projectState.results.filter(result => result.project_id === project.id).sort((a,b) => a.position - b.position);
           if (project.slug === 'jogos-escolares') {
             podium.classList.remove('hidden');
             panel.querySelector('[data-project-podium-list]').innerHTML = results.length ? [1,2,3].map(position => { const result = results.find(item => item.position === position); return `<div class="podium-place"><b>${position}º</b>${result ? `<strong>${escapeHtml(result.winner_name || 'Resultado registrado')}</strong><span>${escapeHtml(result.class_label || 'Turma não informada')}</span>` : '<span>A definir</span>'}</div>`; }).join('') : '<div class="project-empty">O pódio ainda não foi publicado.</div>';
           } else podium.classList.add('hidden');
           const ranking = panel.querySelector('[data-project-ranking]');
           if (project.slug !== 'carroceata') { ranking.classList.add('hidden'); return; }
           ranking.classList.remove('hidden');
            const levelMarkup = await Promise.all([1,2].map(async level => {
              const placeMarkup = await Promise.all([1,2,3].map(async position => {
                const result = results.find(item => item.level === level && item.position === position);
                const photoUrl = result?.photo_path ? await projectMediaUrl(result.photo_path) : '';
                return `<div class="podium-place"><b>${position}º</b>${result ? `<strong>${escapeHtml(result.class_label || 'Turma não informada')}</strong><span>${escapeHtml(result.theme || result.note || 'Tema não informado')}</span>${photoUrl ? `<img src="${escapeHtml(photoUrl)}" alt="Foto da equipe da ${escapeHtml(result.class_label || 'turma cadastrada')}">` : ''}` : '<span>A definir pelo administrador</span>'}</div>`;
              }));
              return `<div class="ranking-level"><div class="ranking-level-title">${carroceataLevelLabel(level)}</div><div class="podium-list">${placeMarkup.join('')}</div></div>`;
            }));
            ranking.querySelector('[data-project-ranking-levels]').innerHTML = levelMarkup.join('');
          }));
         }
       async function renderAdminProject() {
        const panel = document.getElementById('adminProjectsPanel');
        const project = projectForSlug();
        if (!panel || !project) return;
        panel.querySelectorAll('[data-project-tab]').forEach(button => button.classList.toggle('active', button.dataset.projectTab === project.slug));
        const form = panel.querySelector('[data-project-admin-form]');
        form.elements.title.value = project.title;
        form.elements.summary.value = project.summary;
        form.elements.information.value = project.information;
         form.elements.photo.value = '';
         const photos = projectState.photos.filter(photo => photo.project_id === project.id).sort((a,b) => (a.display_order ?? 999999) - (b.display_order ?? 999999) || new Date(b.created_at) - new Date(a.created_at));
         const photoList = panel.querySelector('[data-admin-project-photos]');
         photoList.dataset.projectId = project.id;
         photoList.classList.toggle('orderable', Boolean(photos.length));
           const photoMarkup = await Promise.all(photos.map(async (photo,index) => { const url = await projectMediaUrl(photo.storage_path); return url ? `<div class="admin-project-photo" draggable="true" data-project-photo-id="${photo.id}"><img src="${escapeHtml(url)}" alt="${escapeHtml(photo.caption || project.title)}" tabindex="0" role="button"><div class="admin-project-photo-foot"><span>${index + 1}ª posição</span><div class="photo-move-buttons"><button type="button" data-photo-move="up" aria-label="Mover foto para cima">↑</button><button type="button" data-photo-move="down" aria-label="Mover foto para baixo">↓</button></div></div></div>` : ''; }));
           photoList.innerHTML = photoMarkup.filter(Boolean).join('') || '<div class="project-empty">Nenhuma foto cadastrada.</div>';
         const editor = panel.querySelector('[data-podium-editor]');
         editor.classList.toggle('hidden', project.slug !== 'jogos-escolares');
         if (project.slug === 'jogos-escolares') renderPodiumEditor();
         const carroceataEditor = panel.querySelector('[data-carroceata-editor]');
         carroceataEditor.classList.toggle('hidden', project.slug !== 'carroceata');
         if (project.slug === 'carroceata') renderCarroceataEditor();
       }
      function renderPodiumEditor() {
        const project = projectForSlug();
        const rows = [1,2,3].map(position => { const result = projectState.results.find(item => item.project_id === project.id && item.position === position); const student = projectState.students.find(item => item.id === result?.student_id); const selectedClass = result?.class_id || student?.class_id || ''; const options = projectState.classes.map(item => `<option value="${item.id}" ${item.id === selectedClass ? 'selected' : ''}>${item.year}º ano ${item.class_code}</option>`).join(''); return `<div class="podium-editor-row"><b>${position}º</b><input list="projectStudentOptions" data-podium-student="${position}" value="${escapeHtml(student?.official_name || result?.winner_name || '')}" placeholder="Nome do aluno"><select data-podium-class="${position}" aria-label="Turma do ${position}º lugar"><option value="">Escolha a turma</option>${options}</select></div>`; }).join('');
         document.querySelector('[data-podium-rows]').innerHTML = rows;
         document.querySelector('#projectStudentOptions').innerHTML = projectState.students.map(student => `<option value="${escapeHtml(student.official_name)}"></option>`).join('');
       }
       async function renderCarroceataEditor() {
         const project = projectForSlug();
         const levels = await Promise.all([1,2].map(async level => {
           const rows = await Promise.all([1,2,3].map(async position => {
             const key = `${level}-${position}`;
             const result = projectState.results.find(item => item.project_id === project.id && item.level === level && item.position === position);
             const photoUrl = result?.photo_path ? await projectMediaUrl(result.photo_path) : '';
             return `<div class="carroceata-editor-row"><b>${position}º</b><input data-carroceata-class="${key}" value="${escapeHtml(result?.class_label || '')}" maxlength="120" placeholder="Ex.: 8º A, B e C" aria-label="Turma do nível ${level}, ${position}º lugar"><input data-carroceata-theme="${key}" value="${escapeHtml(result?.theme || result?.note || '')}" maxlength="160" placeholder="Tema da equipe" aria-label="Tema do nível ${level}, ${position}º lugar"><div><input data-carroceata-photo="${key}" type="file" accept="image/*" aria-label="Foto do nível ${level}, ${position}º lugar">${photoUrl ? `<div class="ranking-photo-note"><img src="${escapeHtml(photoUrl)}" alt="Foto atual"><label class="ranking-remove-photo"><input data-carroceata-remove="${key}" type="checkbox"> remover foto</label></div>` : ''}</div><span></span></div>`;
           }));
           return `<div class="carroceata-level-editor"><h5>${carroceataLevelLabel(level)}</h5><div class="carroceata-editor-head"><span></span><span>Turma(s)</span><span>Tema da equipe</span><span>Foto</span><span></span></div>${rows.join('')}</div>`;
         }));
            document.querySelector('[data-carroceata-levels]').innerHTML = levels.join('');
        }
        function persistProjectPhotoOrder(container) {
          const cards = [...container.querySelectorAll('[data-project-photo-id]')];
          const updates = cards.map((card,index) => {
            const photo = projectState.photos.find(item => item.id === card.dataset.projectPhotoId);
            if (photo) photo.display_order = index;
            return supabaseClient.from('project_photos').update({ display_order:index }).eq('id',card.dataset.projectPhotoId);
          });
          Promise.all(updates).then(results => { const status = document.querySelector('[data-project-save-status]'); if (results.some(result => result.error)) { if (status) status.textContent = 'A ordem mudou na tela, mas não foi salva.'; return; } if (status) status.textContent = 'Ordem das fotos salva.'; renderPublicProjects(); });
        }
        function reorderProjectPhoto(card, direction) {
          const container = card.closest('[data-admin-project-photos]');
          const cards = [...container.querySelectorAll('[data-project-photo-id]')];
          const index = cards.indexOf(card);
          const targetIndex = direction === 'up' ? index - 1 : index + 1;
          if (targetIndex < 0 || targetIndex >= cards.length) return;
          if (direction === 'up') cards[targetIndex].before(card); else cards[targetIndex].after(card);
          persistProjectPhotoOrder(container);
        }
        function setupProjectPhotoOrdering() {
          if (document.body.dataset.photoOrderingReady) return;
          document.body.dataset.photoOrderingReady = 'true';
          document.addEventListener('click', event => { const button = event.target.closest('[data-photo-move]'); if (button) reorderProjectPhoto(button.closest('[data-project-photo-id]'),button.dataset.photoMove); });
          document.addEventListener('dragstart', event => { const card = event.target.closest('[data-project-photo-id]'); if (!card) return; card.classList.add('dragging'); event.dataTransfer.effectAllowed = 'move'; event.dataTransfer.setData('text/plain',card.dataset.projectPhotoId); });
          document.addEventListener('dragend', event => event.target.closest('[data-project-photo-id]')?.classList.remove('dragging'));
          document.addEventListener('dragover', event => { if (event.target.closest('[data-project-photo-id]')) event.preventDefault(); });
          document.addEventListener('drop', event => {
            const target = event.target.closest('[data-project-photo-id]');
            if (!target) return;
            event.preventDefault();
            const container = target.closest('[data-admin-project-photos]');
            const source = container.querySelector(`[data-project-photo-id="${event.dataTransfer.getData('text/plain')}"]`);
            if (!source || source === target) return;
            if (event.clientY > target.getBoundingClientRect().top + target.getBoundingClientRect().height / 2) target.after(source); else target.before(source);
            persistProjectPhotoOrder(container);
          });
        }
       function renderProjectPanels() { projectTabsReady(); renderPublicProjects(); renderAdminProject(); }
       async function fetchProjectResults() {
         let results = await supabaseClient.from('project_results').select('id,project_id,level,position,student_id,class_id,winner_name,class_label,note,theme,photo_path').order('level').order('position');
         if (results.error) {
           const legacy = await supabaseClient.from('project_results').select('id,project_id,position,student_id,class_id,winner_name,class_label,note').order('position');
           results = { ...legacy, data:(legacy.data || []).map(item => ({ ...item, level:1, theme:item.note || null, photo_path:null })) };
         }
         return results;
       }
       async function setupProjects() {
        ensureProjectViews();
        if (projectState.loaded || projectState.loading) { renderProjectPanels(); return; }
        projectState.loading = true;
         const base = await Promise.all([
           supabaseClient.from('projects').select('id,slug,title,summary,information,published').eq('published',true).order('title'),
            supabaseClient.from('project_photos').select('id,project_id,storage_path,caption,display_order,created_at').order('created_at',{ascending:false})
         ]);
         const results = await fetchProjectResults();
         if (base.some(result => result.error) || results.error) { projectState.loading = false; return; }
          projectState.projects = (base[0].data || []).map(hydrateCarroceataProject);
         projectState.photos = base[1].data || [];
         projectState.results = results.data || [];
        if (currentProfile?.role === 'developer') {
          const [{ data: students }, { data: classes }] = await Promise.all([
            supabaseClient.from('students').select('id,official_name,class_id').eq('active',true).order('official_name'),
            supabaseClient.from('classes').select('id,year,class_code').order('year').order('class_code')
          ]);
          projectState.students = students || [];
          projectState.classes = classes || [];
        }
        projectState.loading = false;
        projectState.loaded = true;
        renderProjectPanels();
      }
      async function saveProject(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const project = projectForSlug();
        const status = document.querySelector('[data-project-save-status]');
        const data = new FormData(form);
        const { data: updated, error } = await supabaseClient.from('projects').update({ title:data.get('title').trim(), summary:data.get('summary').trim(), information:data.get('information').trim(), updated_at:new Date().toISOString() }).eq('id',project.id).select('id,slug,title,summary,information,published').single();
        if (error) { status.textContent = 'Não foi possível salvar as informações.'; return; }
        projectState.projects = projectState.projects.map(item => item.id === updated.id ? updated : item);
         const files = data.getAll('photo').filter(file => file?.size);
         const currentPhotos = projectState.photos.filter(photo => photo.project_id === project.id);
         const nextOrder = currentPhotos.reduce((max, photo) => Math.max(max, Number(photo.display_order ?? -1)), -1) + 1;
         let uploaded = 0;
         let failed = 0;
         for (const [index,file] of files.entries()) {
           const extension = (file.name.split('.').pop() || 'jpg').toLowerCase().replace(/[^a-z0-9]/g,'') || 'jpg';
           const storagePath = `${currentUser.id}/${project.slug}/${crypto.randomUUID()}.${extension}`;
           const upload = await supabaseClient.storage.from('project-media').upload(storagePath,file,{contentType:file.type || 'image/jpeg',upsert:false});
           if (upload.error) { failed += 1; continue; }
           const photo = await supabaseClient.from('project_photos').insert({ project_id:project.id, storage_path:storagePath, caption:data.get('caption')?.trim() || null, display_order:nextOrder + index, uploaded_by:currentUser.id }).select('id,project_id,storage_path,caption,display_order,created_at').single();
           if (photo.error) { await supabaseClient.storage.from('project-media').remove([storagePath]); failed += 1; continue; }
           projectState.photos.push(photo.data);
           uploaded += 1;
         }
         status.textContent = failed ? `Projeto salvo. ${uploaded} foto(s) adicionada(s); ${failed} falhou.` : uploaded ? `Projeto salvo com ${uploaded} foto(s).` : 'Projeto salvo.';
         renderProjectPanels();
       }
      async function savePodium() {
        const project = projectForSlug();
        const status = document.querySelector('[data-podium-status]');
        const rows = [1,2,3].map(position => ({ position, studentName:document.querySelector(`[data-podium-student="${position}"]`).value.trim(), classId:document.querySelector(`[data-podium-class="${position}"]`).value }));
        const invalid = rows.find(row => row.studentName && (!projectState.students.find(student => student.official_name.toLocaleLowerCase('pt-BR') === row.studentName.toLocaleLowerCase('pt-BR')) || !row.classId));
        if (invalid) { status.textContent = 'Escolha um aluno válido e uma turma para cada colocação preenchida.'; return; }
         const operations = rows.map(row => row.studentName ? (() => { const student = projectState.students.find(item => item.official_name.toLocaleLowerCase('pt-BR') === row.studentName.toLocaleLowerCase('pt-BR')); const classData = projectState.classes.find(item => item.id === row.classId); const payload = { project_id:project.id, level:1, position:row.position, student_id:student.id, class_id:row.classId, winner_name:student.official_name, class_label:`${classData.year}º ano ${classData.class_code}`, updated_by:currentUser.id, updated_at:new Date().toISOString() }; return supabaseClient.from('project_results').upsert(payload,{onConflict:'project_id,level,position'}).then(result => { if (!result.error) return result; const { level, ...legacyPayload } = payload; return supabaseClient.from('project_results').upsert(legacyPayload,{onConflict:'project_id,position'}); }); })() : supabaseClient.from('project_results').delete().eq('project_id',project.id).eq('level',1).eq('position',row.position).then(result => result.error ? supabaseClient.from('project_results').delete().eq('project_id',project.id).eq('position',row.position) : result));
        const results = await Promise.all(operations);
        if (results.some(result => result.error)) { status.textContent = 'Não foi possível salvar o pódio.'; return; }
         const refreshed = await fetchProjectResults();
         projectState.results = refreshed.data || [];
         status.textContent = 'Pódio salvo.';
         renderProjectPanels();
       }
       async function saveCarroceata() {
         const project = projectForSlug('carroceata');
         const status = document.querySelector('[data-carroceata-status]');
         const rows = [1,2].flatMap(level => [1,2,3].map(position => { const key = `${level}-${position}`; const current = projectState.results.find(item => item.project_id === project.id && item.level === level && item.position === position); return { level, position, classLabel:document.querySelector(`[data-carroceata-class="${key}"]`).value.trim(), theme:document.querySelector(`[data-carroceata-theme="${key}"]`).value.trim(), file:document.querySelector(`[data-carroceata-photo="${key}"]`).files[0], removePhoto:document.querySelector(`[data-carroceata-remove="${key}"]`)?.checked, current }; }));
         if (rows.some(row => (row.classLabel && !row.theme) || (!row.classLabel && row.theme))) { status.textContent = 'Preencha a turma e o tema de cada colocação iniciada.'; return; }
         for (const row of rows) {
           if (!row.classLabel) {
             const { error } = await supabaseClient.from('project_results').delete().eq('project_id',project.id).eq('level',row.level).eq('position',row.position);
             if (error) { status.textContent = 'Não foi possível salvar a classificação.'; return; }
             continue;
           }
           let photoPath = row.removePhoto ? null : row.current?.photo_path || null;
           if (row.file?.size) {
             const extension = (row.file.name.split('.').pop() || 'jpg').toLowerCase().replace(/[^a-z0-9]/g,'') || 'jpg';
             photoPath = `${currentUser.id}/${project.slug}/ranking-${row.level}-${row.position}-${crypto.randomUUID()}.${extension}`;
             const upload = await supabaseClient.storage.from('project-media').upload(photoPath,row.file,{contentType:row.file.type || 'image/jpeg',upsert:false});
             if (upload.error) { status.textContent = 'A classificação não foi salva porque uma foto falhou no envio.'; return; }
           }
           const { error } = await supabaseClient.from('project_results').upsert({ project_id:project.id, level:row.level, position:row.position, student_id:null, class_id:null, winner_name:null, class_label:row.classLabel, theme:row.theme, note:row.theme, photo_path:photoPath, updated_by:currentUser.id, updated_at:new Date().toISOString() },{onConflict:'project_id,level,position'});
           if (error) { status.textContent = 'Não foi possível salvar a classificação. Confira se a atualização do banco foi executada.'; return; }
         }
         const refreshed = await supabaseClient.from('project_results').select('id,project_id,level,position,student_id,class_id,winner_name,class_label,note,theme,photo_path').order('level').order('position');
         if (refreshed.error) { status.textContent = 'Classificação salva, mas não foi possível atualizar a tela.'; return; }
         projectState.results = refreshed.data || [];
         status.textContent = 'Classificação salva.';
         renderProjectPanels();
       }
           function setRole(role) {
              const allowed = role === 'parent' ? ['parent','developer'].includes(currentProfile?.role) : role === 'teacher' ? ['pedagogical','developer'].includes(currentProfile?.role) : role === 'coordinator' ? ['coordinator','developer'].includes(currentProfile?.role) : role === 'student' ? ['student','developer'].includes(currentProfile?.role) : role === 'monitor' ? ['monitor','developer'].includes(currentProfile?.role) : role === 'gatekeeper' ? ['gatekeeper','developer'].includes(currentProfile?.role) : role === 'secretary' ? ['secretary','developer'].includes(currentProfile?.role) : role === 'aee' ? ['aee','developer'].includes(currentProfile?.role) : role === 'director' ? ['director','developer'].includes(currentProfile?.role) : role === 'admin' && currentProfile?.role === 'developer';
         if (!allowed) return;
         if (role === 'parent' && !parentDataState.loaded) clearParentDemoView();
          const previousView = activeView;
          activeView = role;
         appShell.classList.toggle('teacher-mode', role === 'teacher');
         document.querySelector('[data-teacher-nav]')?.classList.toggle('hidden', role !== 'teacher');
       roleButtons.forEach(button => button.classList.toggle('active', button.dataset.role === role));
       document.querySelectorAll('[data-preview-role]').forEach(button => button.classList.toggle('active', button.dataset.previewRole === role));
         parentView.classList.toggle('hidden', role !== 'parent');
         coordinatorView.classList.toggle('hidden', role !== 'coordinator');
         teacherView.classList.toggle('hidden', role !== 'teacher');
        studentView.classList.toggle('hidden', role !== 'student');
           adminView.classList.toggle('hidden', role !== 'admin');
           directorView.classList.toggle('hidden', role !== 'director');
          monitorView.classList.toggle('hidden', role !== 'monitor');
            gatekeeperView.classList.toggle('hidden', role !== 'gatekeeper');
            aeeView.classList.toggle('hidden', role !== 'aee');
            secretaryView.classList.toggle('hidden', role !== 'secretary');
             internalChatView?.classList.add('hidden');
             healthyFoodView.classList.add('hidden');
            readingLibraryView.classList.add('hidden');
             document.querySelectorAll('#appShell #platformLearnView,#appShell #platformEvolveView,#appShell #platformSchoolView,#appShell #platformSpaceView').forEach(view => view.classList.add('hidden'));
            if (role === 'coordinator' && !coordinatorView.querySelector('.coordinator-welcome')) { coordinatorView.innerHTML = currentSchoolYearMarkup(coordinatorAdminMarkup); setupCoordinatorView(); }
             if (role === 'coordinator') window.bfrCoordinationCommand?.enhance();
             if (role === 'teacher' && !teacherView.innerHTML) {
          teacherView.innerHTML = teacherProfessionalMarkup;
           const classPanel = teacherView.querySelector('.student-table')?.closest('.panel');
            if (classPanel) { classPanel.id = 'academicPanel'; classPanel.innerHTML = currentSchoolYearMarkup(academicMarkup); }
            setupProfessionalTeacherView();
             setupAcademicPanel();
             clearTeacherDemoView();
          }
           if (role === 'student' && !studentView.querySelector('.welcome')) { studentView.innerHTML = currentSchoolYearMarkup(studentMarkup); setupStudentRealtime(); }
          if (role === 'monitor' && !monitorView.innerHTML) { monitorView.innerHTML = monitorMarkup; setupMonitorView(); }
           if (role === 'gatekeeper' && !gatekeeperView.innerHTML) { gatekeeperView.innerHTML = gatekeeperMarkup; setupGatekeeperView(); }
           if (role === 'aee' && typeof window.setupAeeModule === 'function') window.setupAeeModule();
            if (role === 'aee') window.ensureAeeRoster?.();
          if (role === 'parent' || role === 'secretary') setupSecretaryView();
          if (role === 'director' && !directorView.innerHTML) {
