         const adminStudentMarkup = `<section class="panel" id="adminStudentDirectoryPanel"><div class="panel-heading"><div><div class="eyebrow">Cadastro escolar · acesso administrativo</div><h2 style="margin-top:4px">Alunos e perfis</h2></div><span class="paperless-tag">● ADMIN</span></div><p class="agenda-intro">Cadastre nome, turma, foto, nascimento, responsável, inclusão e participação em projetos. Endereço e telefone ficam restritos ao administrador; a portaria recebe somente a foto necessária à conferência.</p><div class="admin-student-layout"><section><div class="admin-student-toolbar"><input type="search" data-admin-student-search placeholder="Buscar aluno pelo nome" aria-label="Buscar aluno pelo nome"><select data-admin-student-class-filter aria-label="Filtrar por turma"><option value="all">Todas as turmas</option></select><button class="primary-button" type="button" data-admin-new-student>+ Novo aluno</button></div><div class="admin-student-list" data-admin-student-list><div class="project-empty">Carregando alunos...</div></div></section><section class="panel" style="margin:0;background:#fbfdfb"><div class="panel-heading"><div><div class="eyebrow">Ficha individual</div><h3 style="margin-top:4px" data-admin-student-form-title>Novo aluno</h3></div><span class="agenda-count">privado</span></div><form class="admin-student-form" data-admin-student-form><label>Aluno já cadastrado<select name="student_id" data-admin-student-select><option value="">Novo cadastro</option></select></label><div class="admin-student-form-grid"><label>Nome oficial<input name="official_name" required maxlength="160" placeholder="Nome completo do aluno"></label><label>Turma<select name="class_id" data-admin-class-select required><option value="">Selecione a turma</option></select></label></div><div class="admin-student-form-grid"><label>Data de nascimento<input name="birth_date" type="date"></label><label>Nome do responsável<input name="guardian_name" maxlength="160" placeholder="Responsável principal"></label></div><div class="admin-student-form-grid"><label>Telefone do responsável<input name="guardian_phone" type="tel" maxlength="30" placeholder="(82) 99999-9999"></label><label>Contato de emergência<input name="emergency_contact" maxlength="200" placeholder="Nome e telefone"></label></div><label>Endereço completo<input name="address_line" maxlength="300" placeholder="Rua, número, bairro, cidade"></label><label>Necessidades de inclusão<textarea name="inclusion_needs" maxlength="1200" placeholder="Informações necessárias para o atendimento pedagógico"></textarea></label><label>Plano e apoios combinados<textarea name="inclusion_plan" maxlength="1200" placeholder="Adaptações, apoios e orientações autorizadas"></textarea></label><label>Observações de inclusão<textarea name="inclusion_observations" maxlength="1200" placeholder="Observações internas da equipe autorizada"></textarea></label><label>Foto do aluno<input name="photo" type="file" accept="image/*"><small class="field-hint">A foto será privada e usada na conferência da portaria.</small></label><img class="admin-photo-preview hidden" data-admin-photo-preview alt="Prévia da foto do aluno"><fieldset style="border:0;padding:0;margin:0"><legend class="field-hint" style="margin-bottom:7px">Participação em projetos</legend><div class="admin-program-grid"><label class="admin-program-option"><input type="checkbox" name="program_slug" value="music"> Aula de Música</label><label class="admin-program-option"><input type="checkbox" name="program_slug" value="entrepreneurship"> Empreendedorismo</label><label class="admin-program-option"><input type="checkbox" name="program_slug" value="inclusive_education"> Educação Inclusiva</label><label class="admin-program-option"><input type="checkbox" name="program_slug" value="robotics"> Robótica</label></div></fieldset><button class="primary-button" type="submit">Salvar cadastro do aluno</button><p class="publish-status" data-admin-student-status></p></form></section></div></section>`;
        const gateCoordinationMarkup = `<section class="panel gate-coordination-panel" data-gate-coordination><div class="panel-heading"><div><div class="eyebrow">Semi presença · portaria</div><h2 style="margin-top:4px">Chegadas registradas</h2></div><span class="agenda-count">tempo real</span></div><p class="agenda-intro">A passagem pelo portão é um registro de acompanhamento. A frequência oficial continua sendo confirmada pela equipe pedagógica.</p><div class="gate-history-list" data-gate-coordination-list><div class="project-empty">Carregando leituras...</div></div></section>`;
        const schoolActivitiesMarkup = `<section class="panel school-activities-panel" data-school-activities-panel><div class="panel-heading"><div><div class="eyebrow">Atividades da escola</div><h2 style="margin-top:4px">Aprender fazendo</h2></div><button class="text-button hidden" type="button" data-open-activity>+ Criar atividade</button></div><p class="agenda-intro">Atividades publicadas pelos professores, com orientações e anexos.</p><div class="school-activities-list" data-school-activities-list><div class="project-empty">Carregando atividades...</div></div></section>`;
       const gamesMarkup = `<section class="panel games-panel" data-games-panel><div class="panel-heading"><div><div class="eyebrow">Recreio inteligente</div><h2 style="margin-top:4px">Jogos educativos</h2></div><span class="agenda-count">6º ao 9º ano</span></div><p class="agenda-intro">Escolha uma matéria e enfrente desafios alinhados ao conteúdo do 6º ao 9º ano.</p><div class="game-subjects">${['Língua Portuguesa','Matemática','Ciências','História','Geografia','Língua Inglesa','Arte','Educação Física','Ensino Religioso'].map(subject => `<button class="game-subject" type="button" data-game-subject="${subject}"><b>${subject}</b><span>Jogar agora ↗</span></button>`).join('')}</div><div class="game-play hidden" data-game-play><div class="game-score" data-game-score></div><h3 data-game-title></h3><div class="game-question" data-game-question></div><div class="game-options" data-game-options></div><div class="game-feedback" data-game-feedback></div><button class="primary-button game-next" type="button" data-game-next>Próxima pergunta</button></div></section>`;
         const coordinatorAdminMarkup = `<section class="coordinator-welcome"><div><div class="eyebrow">Coordenação escolar · visão administrativa</div><h1>Painel da coordenação.</h1><p>Acompanhe as entradas registradas pela portaria, identifique pendências e consulte a situação dos alunos sem acessar áreas de estudante.</p></div><div class="coordinator-actions"><span class="coordinator-admin-badge">● controle administrativo</span><button class="primary-button" type="button" data-coordinator-refresh>Atualizar agora</button><button class="text-button" type="button" data-coordinator-export>Baixar planilha CSV ↓</button><button class="text-button" type="button" data-coordinator-pdf>Baixar relatório PDF ↓</button></div></section><section class="overview-grid"><div class="metric-card"><div class="metric-head"><span>Chegaram hoje</span><span class="metric-icon mint">✓</span></div><div class="metric-value"><strong id="coordinatorPresentCount">—</strong><span id="coordinatorPresentRate">—</span></div><div class="metric-foot">Alunos com entrada confirmada</div></div><div class="metric-card"><div class="metric-head"><span>Passagens hoje</span><span class="metric-icon blue">◷</span></div><div class="metric-value"><strong id="coordinatorCheckinCount">—</strong><span>registros</span></div><div class="metric-foot">Leituras feitas pela portaria</div></div><div class="metric-card"><div class="metric-head"><span>Alertas abertos</span><span class="metric-icon sun">!</span></div><div class="metric-value"><strong id="coordinatorAlertCount">—</strong><span>atenção</span></div><div class="metric-foot">Entradas que precisam de acompanhamento</div></div></section><div class="coordinator-layout"><section class="panel" data-coordinator-attendance><div class="panel-heading"><div><div class="eyebrow">Portaria · lista de hoje</div><h2 style="margin-top:4px">Presença de chegada</h2></div><span class="coordinator-live-status" data-coordinator-live-status>● conectando</span></div><div class="coordinator-filters"><input type="search" data-coordinator-search placeholder="Buscar aluno pelo nome" aria-label="Buscar aluno pelo nome"><select data-coordinator-class aria-label="Filtrar por turma"><option value="all">Todas as turmas</option></select></div><div class="coordinator-table-wrap"><div class="coordinator-table" role="table" aria-label="Presença de chegada"><div class="coordinator-row coordinator-row-head" role="row"><span>Horário</span><span>Aluno</span><span>Turma</span><span>Ano</span><span>Situação</span><span>Passagem</span></div><div class="coordinator-list" data-coordinator-list></div></div></div><p class="field-hint" data-coordinator-status>Carregando lista...</p><p class="field-hint" data-coordinator-updated></p></section><aside class="coordinator-summary"><section class="panel" data-coordinator-alerts><div class="panel-heading"><div><div class="eyebrow">Acompanhamento</div><h2 style="margin-top:4px">Alertas de entrada</h2></div><span class="agenda-count">coordenação</span></div><div class="coordinator-alert-list" data-coordinator-alert-list><div class="coordinator-empty">Carregando alertas...</div></div></section><div class="coordinator-admin-note"><strong>Visão administrativa</strong><br>Boletim escolar, enquetes e agenda do aluno ficam disponíveis apenas nos perfis correspondentes.</div></aside></div>`;
         function secretaryFamilyMarkup() { return `<section class="secretary-hero"><div><div class="eyebrow">Serviços escolares · canal oficial</div><h1>Secretaria digital.</h1><p>Resolva solicitações, acompanhe protocolos e baixe documentos sem depender de papel ou WhatsApp.</p></div><div class="secretary-actions"><span class="coordinator-admin-badge">● atendimento por protocolo</span></div></section><section class="panel" id="secretariaPanel"><div class="panel-heading"><div><div class="eyebrow">Atendimento da escola</div><h2 style="margin-top:4px">Secretaria</h2></div><span class="secretary-filter-chip">serviços digitais</span></div><div class="secretary-service-card"><div class="secretary-service-icon">▤</div><div><strong>Solicitar documento ou serviço</strong><p>Declarações, históricos, transferência, atualização cadastral e atendimento.</p></div><button class="primary-button" type="button" data-secretary-open-wizard>Nova solicitação</button></div><div class="secretary-summary-grid" style="margin-top:16px"><div class="secretary-stat"><span>Solicitações em andamento</span><strong id="secretaryOpenCount">0</strong><small>Aguardando análise ou informação</small></div><div class="secretary-stat"><span>Documentos disponíveis</span><strong id="secretaryReadyCount">0</strong><small>Prontos para visualizar ou baixar</small></div><div class="secretary-stat"><span>Ação necessária</span><strong id="secretaryActionCount">0</strong><small>Responda para a secretaria continuar</small></div></div></section><div class="secretary-grid"><div><section class="panel" id="secretaryRequestsPanel"><div class="panel-heading"><div><div class="eyebrow">Histórico com protocolo</div><h2 style="margin-top:4px">Minhas solicitações</h2></div><button class="text-button" type="button" data-secretary-open-wizard>Nova solicitação</button></div><p class="agenda-intro">Cada pedido recebe protocolo, prazo e histórico de andamento.</p><div class="secretary-list" data-secretary-request-list><div class="project-empty">Carregando solicitações...</div></div></section><section class="panel hidden" id="secretaryWizardPanel"><div class="panel-heading"><div><div class="eyebrow">Nova solicitação · etapa <span data-secretary-step-label>1</span> de 5</div><h2 style="margin-top:4px">O que você precisa?</h2></div><button class="text-button" type="button" data-secretary-close-wizard>Cancelar</button></div><form class="secretary-wizard" id="secretaryRequestForm"><div class="secretary-step active" data-secretary-step="1"><h3>1. Selecione o aluno</h3><p>Escolha o aluno vinculado ao seu cadastro.</p><select name="student_id" data-secretary-student required><option value="">Carregando alunos...</option></select></div><div class="secretary-step" data-secretary-step="2"><h3>2. Escolha o serviço</h3><p>Selecione o documento ou solicitação administrativa.</p><input type="hidden" name="request_type" data-secretary-type-value required><div class="secretary-option-grid"><button type="button" class="secretary-option" data-secretary-type="Declaração de matrícula"><strong>Declaração de matrícula</strong><span>Comprova a matrícula no ano letivo.</span></button><button type="button" class="secretary-option" data-secretary-type="Declaração de frequência"><strong>Declaração de frequência</strong><span>Informa a frequência registrada.</span></button><button type="button" class="secretary-option" data-secretary-type="Declaração de escolaridade"><strong>Declaração de escolaridade</strong><span>Comprova a etapa escolar do aluno.</span></button><button type="button" class="secretary-option" data-secretary-type="Histórico escolar"><strong>Histórico escolar</strong><span>Solicite o histórico completo.</span></button><button type="button" class="secretary-option" data-secretary-type="Boletim escolar"><strong>Boletim escolar</strong><span>Peça uma cópia do boletim.</span></button><button type="button" class="secretary-option" data-secretary-type="Comprovante de vínculo"><strong>Comprovante de vínculo</strong><span>Documento para benefício ou transporte.</span></button><button type="button" class="secretary-option" data-secretary-type="Solicitar transferência"><strong>Solicitar transferência</strong><span>Inicie o atendimento de transferência.</span></button><button type="button" class="secretary-option" data-secretary-type="Mudança de turma"><strong>Mudança de turma</strong><span>Envie um pedido para análise.</span></button><button type="button" class="secretary-option" data-secretary-type="Solicitar atendimento"><strong>Solicitar atendimento</strong><span>Peça um horário com a escola.</span></button><button type="button" class="secretary-option" data-secretary-type="Atualização cadastral"><strong>Atualização cadastral</strong><span>Solicite alteração de telefone, endereço ou responsável.</span></button><button type="button" class="secretary-option" data-secretary-type="Outro serviço"><strong>Outro serviço</strong><span>Explique uma necessidade diferente.</span></button></div></div><div class="secretary-step" data-secretary-step="3"><h3>3. Informe a finalidade</h3><p>Isso ajuda a secretaria a preparar o documento correto.</p><label>Finalidade<select name="purpose" required><option value="">Selecione uma finalidade</option><option>Transferência escolar</option><option>Inscrição</option><option>Benefício</option><option>Transporte</option><option>Comprovação</option><option>Atendimento da escola</option><option>Outro</option></select></label></div><div class="secretary-step" data-secretary-step="4"><h3>4. Acrescente detalhes</h3><label>Informação específica<textarea name="details" maxlength="1500" placeholder="Existe alguma informação que precisa constar? (opcional)"></textarea></label><label>Forma de recebimento<select name="receiving_method" required><option value="digital">Documento digital</option><option value="secretaria">Retirar na secretaria</option></select></label><label>Anexo opcional<input name="attachment" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"></label></div><div class="secretary-step" data-secretary-step="5"><h3>5. Revise antes de enviar</h3><div class="secretary-review"><div>Aluno: <b data-secretary-review-student>—</b></div><div>Serviço: <b data-secretary-review-type>—</b></div><div>Finalidade: <b data-secretary-review-purpose>—</b></div><div>Recebimento: <b data-secretary-review-receiving>—</b></div><div>Detalhes: <b data-secretary-review-details>—</b></div></div></div><div class="secretary-wizard-actions"><button class="text-button hidden" type="button" data-secretary-prev>← Voltar</button><button class="primary-button secretary-next" type="button" data-secretary-next>Continuar →</button><button class="primary-button hidden" type="submit" data-secretary-submit>Enviar solicitação</button></div><div class="growth-status" data-secretary-form-status></div></form></section></div><aside><section class="panel"><div class="panel-heading"><div><div class="eyebrow">Biblioteca pessoal</div><h2 style="margin-top:4px">Meus documentos</h2></div><span class="agenda-count">privados</span></div><p class="agenda-intro">Documentos emitidos para seus alunos e arquivos publicados pela escola.</p><div class="secretary-list" data-secretary-document-list><div class="project-empty">Carregando documentos...</div></div></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">Canal interno</div><h2 style="margin-top:4px">Atendimento</h2></div><span class="agenda-count">por protocolo</span></div><p class="agenda-intro">Envie uma mensagem para a secretaria e acompanhe a resposta no histórico.</p><div class="secretary-list" data-secretary-message-list><div class="project-empty">Nenhuma conversa iniciada.</div></div><form class="secretary-form" data-secretary-message-form><label>Assunto<select name="subject"><option>Documentação escolar</option><option>Transferência</option><option>Atualização cadastral</option><option>Atendimento</option><option>Outro</option></select></label><label>Mensagem<textarea name="body" rows="3" maxlength="1500" required placeholder="Digite sua mensagem para a secretaria"></textarea></label><button class="primary-button" type="submit">Enviar mensagem</button><div class="growth-status" data-secretary-message-status></div></form></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">Meus dados</div><h2 style="margin-top:4px">Atualização cadastral</h2></div><span class="paperless-tag">aprovação necessária</span></div><p class="agenda-intro">Alterações sensíveis entram como solicitação e só são aplicadas após conferência da secretaria.</p><form class="secretary-form" data-secretary-profile-form><div class="secretary-form-grid"><label>Telefone<input name="phone" type="tel" placeholder="(82) 99999-9999"></label><label>E-mail<input name="email" type="email" placeholder="familia@exemplo.com"></label></div><label>Endereço<input name="address" placeholder="Rua, número, bairro"></label><label>Contato de emergência<input name="emergency" placeholder="Nome e telefone"></label><button class="text-button" type="submit">Solicitar atualização</button><div class="growth-status" data-secretary-profile-status></div></form></section></aside></div>`; }
         function secretaryStaffMarkup() { return `<section class="secretary-hero"><div><div class="eyebrow">Secretaria · atendimento interno</div><h1>Painel da Secretaria.</h1><p>Organize solicitações, documentos e conversas em um fluxo único com protocolo e prazo.</p></div><div class="secretary-actions"><span class="coordinator-admin-badge">● equipe autorizada</span></div></section><section class="secretary-summary-grid"><div class="secretary-stat"><span>Solicitações pendentes</span><strong data-secretary-staff-count="pending">0</strong><small>Recebidas ou em análise</small></div><div class="secretary-stat"><span>Aguardando responsável</span><strong data-secretary-staff-count="waiting">0</strong><small>Precisam de informação</small></div><div class="secretary-stat"><span>Concluídas</span><strong data-secretary-staff-count="closed">0</strong><small>Finalizadas pela equipe</small></div></section><div class="secretary-staff-layout"><section class="panel"><div class="panel-heading"><div><div class="eyebrow">Fila de atendimento</div><h2 style="margin-top:4px">Solicitações recentes</h2></div><span class="agenda-count" data-secretary-staff-updated>ao vivo</span></div><div class="secretary-staff-toolbar"><select data-secretary-staff-filter aria-label="Filtrar solicitações"><option value="all">Todos os status</option><option value="received">Recebidas</option><option value="reviewing">Em análise</option><option value="waiting_information">Aguardando informação</option><option value="preparing">Documento em preparação</option><option value="ready">Prontas</option><option value="closed">Concluídas</option><option value="cancelled">Canceladas</option></select><input type="search" data-secretary-staff-search placeholder="Buscar protocolo ou aluno" aria-label="Buscar solicitação"></div><div class="secretary-list" data-secretary-staff-list><div class="project-empty">Carregando solicitações...</div></div></section><section class="panel secretary-detail" data-secretary-detail><div class="panel-heading"><div><div class="eyebrow">Detalhe do protocolo</div><h2 style="margin-top:4px" data-secretary-detail-title>Selecione uma solicitação</h2></div><span class="secretary-status" data-secretary-detail-badge>—</span></div><dl><dt>Aluno</dt><dd data-secretary-detail-student>—</dd><dt>Responsável</dt><dd data-secretary-detail-requester>—</dd><dt>Turma</dt><dd data-secretary-detail-class>—</dd><dt>Finalidade</dt><dd data-secretary-detail-purpose>—</dd><dt>Solicitado em</dt><dd data-secretary-detail-date>—</dd><dt>Prazo</dt><dd data-secretary-detail-deadline>—</dd></dl><div class="secretary-timeline" data-secretary-detail-timeline><div class="project-empty">O histórico aparecerá aqui.</div></div><label style="display:grid;gap:5px;margin-top:14px;color:#70809b;font-size:10px">Status<select data-secretary-detail-status><option value="received">Recebida</option><option value="reviewing">Em análise</option><option value="waiting_information">Aguardando informação</option><option value="preparing">Documento em preparação</option><option value="ready">Pronta</option><option value="closed">Concluída</option><option value="cancelled">Cancelada</option></select></label><label style="display:grid;gap:5px;margin-top:10px;color:#70809b;font-size:10px">Observação para o responsável<textarea class="secretary-staff-note" data-secretary-detail-note placeholder="Informe o andamento ou peça uma informação."></textarea></label><label style="display:grid;gap:5px;margin-top:10px;color:#70809b;font-size:10px">Anexar documento<input type="file" data-secretary-detail-file accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"></label><div class="secretary-staff-actions"><button class="primary-button" type="button" data-secretary-save-detail>Salvar atualização</button><button class="text-button" type="button" data-secretary-generate-document>Gerar declaração PDF</button></div><form class="secretary-form" data-secretary-staff-message-form><label>Mensagem para o responsável<textarea name="body" rows="2" maxlength="1500" placeholder="Escreva uma resposta"></textarea></label><button class="text-button" type="submit">Enviar mensagem</button><div class="growth-status" data-secretary-staff-message-status></div></form></section></div>`; }
         const parentView = document.getElementById('parentView');
        const coordinatorView = document.getElementById('coordinatorView');
        const teacherView = document.getElementById('teacherView');
       const studentView = document.getElementById('studentView');
          const adminView = document.getElementById('adminView');
          const directorView = document.getElementById('directorView');
         const monitorView = document.getElementById('monitorView');
          const gatekeeperView = document.getElementById('gatekeeperView');
          const aeeView = document.getElementById('aeeView');
          const secretaryView = document.getElementById('secretaryView');
          const healthyFoodView = document.getElementById('healthyFoodView');
           const readingLibraryView = document.getElementById('readingLibraryView');
          const activityCenterView = document.getElementById('activityCenterView');
          const internalChatView = document.getElementById('internalChatView');
         const roleButtons = document.querySelectorAll('[data-role]');
          let activeView = 'parent';
          let activeSection = 'inicio';
          const navigationStorageKey = 'bfr-active-navigation-v2';
          function navigationStorage() { try { return window.localStorage; } catch { return window.sessionStorage; } }
          function navigationStorageKeyForUser() { return `${navigationStorageKey}:${currentUser?.id || 'anonymous'}`; }
          function readNavigationState() {
            try {
              const store = navigationStorage();
              return JSON.parse(store.getItem(navigationStorageKeyForUser()) || sessionStorage.getItem(navigationStorageKey) || 'null') || {};
            } catch { return {}; }
          }
          function persistNavigationState(section) {
            activeSection = section || 'inicio';
            const value = JSON.stringify({ role:activeView, section:activeSection, updatedAt:Date.now() });
            try { navigationStorage().setItem(navigationStorageKeyForUser(), value); sessionStorage.setItem(navigationStorageKey, value); } catch {}
          }
          function syncActiveNavigation(section) { document.querySelectorAll('.nav-item[data-section]').forEach(item => item.classList.toggle('active', item.dataset.section === section)); document.querySelector('[data-mobile-more]')?.classList.remove('active'); }
           function restoreNavigationState() {
            if (activeView === 'teacher') {
              const savedTeacher = readNavigationState();
               const teacherSection = savedTeacher.section && (savedTeacher.section.startsWith('professor-') || savedTeacher.section === 'chat-interno') ? savedTeacher.section : 'professor-inicio';
               syncActiveNavigation(teacherSection);
               if (teacherSection === 'chat-interno') document.querySelector('[data-section="chat-interno"]')?.click();
               else navigateToSection(teacherSection);
              return;
            }
            const saved = readNavigationState();
            if (saved.role && saved.role !== activeView) {
              const fallbackByRole = { parent:'inicio', admin:'inicio', director:'inicio', coordinator:'inicio', student:'inicio', monitor:'inicio', gatekeeper:'inicio', secretary:'inicio', aee:'inicio' };
              const fallback = fallbackByRole[activeView] || 'inicio';
              syncActiveNavigation(fallback);
              persistNavigationState(fallback);
              navigateToSection(fallback);
              return;
            }
             const platformArea = activeView === 'parent' ? window.BFRPlatform?.state?.lastArea : null;
            if (platformArea && platformArea !== 'inicio' && typeof window.BFRPlatform?.open === 'function') {
              window.BFRPlatform.open(platformArea);
              persistNavigationState(platformArea);
              return;
            }
            const section = saved.section || 'inicio';
           const item = document.querySelector(`.nav-item[data-section="${section}"]`);
           if (!item || item.classList.contains('hidden')) { syncActiveNavigation('inicio'); persistNavigationState('inicio'); return; }
           syncActiveNavigation(section);
           navigateToSection(section);
         }
         let rosterReady = false;
        let liveContentTimer = null;
         let liveContentChannel = null;
         function subscribeWithRecovery(name, configure, onStatus) {
           let channel = null;
           let retryTimer = null;
           let monitorTimer = null;
           let generation = 0;
           let connecting = false;
           let attempt = 0;
           let connectionTimer = null;
           const retryable = new Set(['CHANNEL_ERROR','TIMED_OUT','CLOSED']);
           const scheduleRetry = () => {
             clearInterval(monitorTimer);
             clearTimeout(retryTimer);
             onStatus?.('CHANNEL_ERROR');
             retryTimer = setTimeout(connect, 4000);
           };
           const connect = () => {
             if (connecting) return;
             connecting = true;
             const token = ++generation;
             clearTimeout(retryTimer);
             clearInterval(monitorTimer);
             clearTimeout(connectionTimer);
             const previous = channel;
             channel = null;
             const create = () => {
               if (token !== generation) { connecting = false; return; }
               if (!supabaseClient?.channel) { connecting = false; return; }
               try {
                 if (previous && supabaseClient.realtime?.connect && !supabaseClient.realtime.conn) {
                   supabaseClient.realtime.connect();
                   connectionTimer = setTimeout(create, 1200);
                   return;
                 }
                 const topic = attempt++ ? `${name}-recovery-${attempt}` : name;
                 channel = configure(supabaseClient.channel(topic));
                 channel.subscribe(status => {
                   if (token !== generation) return;
                   onStatus?.(status);
                   if (retryable.has(status)) scheduleRetry();
                 });
                 monitorTimer = setInterval(() => {
                   if (token === generation && (channel?.state !== 'joined' || !supabaseClient.realtime?.conn)) scheduleRetry();
                 }, 5000);
               } catch { retryTimer = setTimeout(connect, 4000); }
               connecting = false;
             };
             if (previous?.unsubscribe) Promise.resolve(previous.unsubscribe()).catch(() => {});
             create();
           };
           const registry = window.__BFR_RECOVERY_ENTRIES || (window.__BFR_RECOVERY_ENTRIES = new Set());
           const entry = { force:() => { clearTimeout(retryTimer); clearInterval(monitorTimer); clearTimeout(connectionTimer); generation++; connecting = false; connect(); } };
           registry.add(entry);
           if (!window.__BFR_RECOVERY_WATCHDOG) {
             window.__BFR_RECOVERY_WATCHDOG = setInterval(() => {
               const realtime = supabaseClient?.realtime;
               if (!realtime || realtime.conn || window.__BFR_RECOVERY_ACTIVE) return;
               window.__BFR_RECOVERY_ACTIVE = true;
               realtime.connect?.();
               [...registry].forEach((item,index) => setTimeout(item.force, 1200 + index * 150));
               setTimeout(() => { window.__BFR_RECOVERY_ACTIVE = false; }, 6000);
             }, 5000);
           }
           connect();
           return channel;
         }
         window.BFRSubscribeWithRecovery = subscribeWithRecovery;
           const parentDataState = { loaded:false, loading:false, students:[], activeStudentId:null, classes:[], grades:[], attendance:[], occurrences:[] };
           const parentGateState = { loaded:false, loading:false, records:[], channel:null, refreshTimer:null, error:false };
        const schoolTimeZone = 'America/Maceio';
        const currentSchoolYearMarkup = markup => markup.replaceAll('2026', String(new Date().getFullYear()));
        function schoolDateParts(date = new Date()) {
          return new Intl.DateTimeFormat('pt-BR', { timeZone:schoolTimeZone, weekday:'long', day:'numeric', month:'long', year:'numeric' }).format(date);
        }
        function schoolShortDate(date = new Date()) {
          return new Intl.DateTimeFormat('pt-BR', { timeZone:schoolTimeZone, day:'numeric', month:'long' }).format(date);
        }
        function schoolClock(date = new Date()) {
          return new Intl.DateTimeFormat('pt-BR', { timeZone:schoolTimeZone, hour:'2-digit', minute:'2-digit' }).format(date);
        }
        function schoolTodayIso(date = new Date()) {
           const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone:schoolTimeZone, year:'numeric', month:'2-digit', day:'2-digit' }).formatToParts(date).map(part => [part.type, part.value]));
           return `${parts.year}-${parts.month}-${parts.day}`;
         }
         function setEmptyContent(host, message) {
           if (host) host.innerHTML = `<div class="data-empty-inline" role="status">${escapeHtml(message)}</div>`;
         }
         function showParentDataStatus(message) {
           if (!parentView) return;
           let status = parentView.querySelector('[data-parent-data-status]');
           if (!status) {
             status = document.createElement('p');
             status.dataset.parentDataStatus = 'true';
             status.className = 'publish-status';
             parentView.querySelector('.child-card')?.after(status);
           }
           status.textContent = message;
           status.classList.toggle('hidden', !message);
         }
         function clearParentDemoView() {
           parentDataState.students = [];
           const child = parentView?.querySelector('.child-card');
           if (child) {
              child.querySelector('.child-info strong').textContent = 'Aluno não vinculado';
              child.querySelector('.child-info span').textContent = 'Aguardando vínculo da escola';
              child.querySelector('[data-child-school-status]')?.classList.add('hidden');
              child.querySelector('.avatar').textContent = '—';
             child.querySelector('[data-live-attendance-status]').textContent = '—';
           }
           const cards = parentView?.querySelectorAll('.overview-grid .metric-card') || [];
           [['—','sem dados','Aguardando frequência da escola'],['—','sem dados','A escola ainda não lançou notas'],['—','sem dados','Nenhuma atividade disponível']].forEach((values,index) => {
             const card = cards[index];
             if (!card) return;
             card.querySelector('.metric-value strong').textContent = values[0];
             card.querySelector('.metric-value span').textContent = values[1];
             card.querySelector('.metric-foot').textContent = values[2];
           });
           setEmptyContent(parentView?.querySelector('.attendance-chart'), 'A frequência aparecerá quando a escola registrar os dados.');
           setEmptyContent(parentView?.querySelector('.activity-list'), 'Nenhuma atualização disponível.');
           setEmptyContent(parentView?.querySelector('.notice'), 'Nenhum aviso publicado no momento.');
           setEmptyContent(parentView?.querySelector('.main-grid .project-list'), 'Nenhum evento publicado no momento.');
           const report = parentView?.querySelector('#boletimPanel .report-table');
             if (report) report.innerHTML = '<div class="report-row report-header"><span>Componente</span><span>1º bim.</span><span>2º bim.</span><span>3º bim.</span><span>4º bim.</span><span>Média</span></div><div class="data-empty-inline">Nenhuma nota lançada.</div>';
           const reportAverage = parentView?.querySelector('#boletimPanel .report-average strong');
           if (reportAverage) reportAverage.textContent = '—';
           const note = parentView?.querySelector('#comunicadosPanel .digital-note');
           setEmptyContent(note, 'Nenhum comunicado publicado no momento.');
           parentView?.querySelector('#noticiasPanel')?.classList.add('hidden');
           parentView?.querySelector('#enquetesPanel')?.classList.add('hidden');
           setEmptyContent(parentView?.querySelector('#photoStrip'), 'Nenhuma foto publicada.');
           renderParentOccurrences([]);
           const badge = document.querySelector('[data-section="ocorrencias"] .nav-badge');
           badge?.classList.add('hidden');
           showParentDataStatus('Carregando os dados vinculados à conta...');
         }
          function clearTeacherDemoView() {
            teacherView?.querySelectorAll('.teacher-metric strong').forEach(value => { value.textContent = '—'; });
           const highlight = teacherView?.querySelector('.side-highlight');
           if (highlight) {
             highlight.querySelector('h2').textContent = 'Projeto da turma';
             highlight.querySelector('p').textContent = 'Os projetos publicados pela escola aparecerão aqui.';
             highlight.querySelector('.progress-row b').textContent = '—';
              highlight.querySelector('.progress-track i').style.width = '0';
            }
          }
           const teacherProfessionalState = { classes:[], students:[], grades:[], attendance:[], activities:[], scheduleEntries:[], selectedClassId:null, classTab:'alunos', loaded:false, loading:false, error:'' };
          function teacherClassLabel(group) { return group ? `${group.year}º ano ${group.class_code}` : 'Turma não informada'; }
          function teacherStudentAverage(studentId) { const values = teacherProfessionalState.grades.filter(item => item.student_id === studentId).map(item => Number(item.score)).filter(Number.isFinite); return values.length ? values.reduce((sum,value) => sum + value, 0) / values.length : null; }
          function teacherStudentAttendance(studentId) { const rows = teacherProfessionalState.attendance.filter(item => item.student_id === studentId); if (!rows.length) return null; const present = rows.filter(item => item.status === 'present' || item.status === 'late').length; return Math.round((present / rows.length) * 1000) / 10; }
          function teacherInitials(name) { return String(name || 'P').split(/\s+/).filter(Boolean).map(item => item[0]).slice(0,2).join('').toLocaleUpperCase('pt-BR'); }
          function teacherCount(value) { return Number.isFinite(value) ? String(value) : '—'; }
          function teacherRenderMetrics() {
            const root = teacherView?.querySelector('[data-teacher-professional]');
            if (!root) return;
            const name = currentProfile?.full_name || currentUser?.user_metadata?.full_name || currentUser?.email?.split('@')[0] || 'Professor';
             root.querySelector('[data-teacher-greeting]').textContent = `${schoolGreeting()}, ${preferredDisplayName(currentProfile)}!`;
            root.querySelector('[data-teacher-name]').textContent = name;
            root.querySelector('[data-teacher-profile-name]').textContent = name;
            root.querySelector('[data-teacher-profile-role]').textContent = currentProfile?.role === 'developer' ? 'Administrador em modo professor' : 'Equipe pedagógica';
            root.querySelector('[data-teacher-profile-subjects]').textContent = currentProfile?.subjects || 'Disciplinas ainda não cadastradas.';
            root.querySelector('[data-teacher-subjects]').textContent = currentProfile?.subjects || 'Disciplinas ainda não cadastradas';
            const metricValue = value => teacherProfessionalState.error ? '—' : teacherCount(value);
            root.querySelector('[data-teacher-metric="classes"]').textContent = metricValue(teacherProfessionalState.classes.length);
            root.querySelector('[data-teacher-metric="students"]').textContent = metricValue(teacherProfessionalState.students.length);
            root.querySelector('[data-teacher-metric="activities"]').textContent = metricValue(teacherProfessionalState.activities.length);
            const assessments = new Set(teacherProfessionalState.grades.map(item => `${item.assessment || 'Avaliação'}|${item.subject || ''}`));
            root.querySelector('[data-teacher-metric="assessments"]').textContent = metricValue(assessments.size);
            root.querySelector('[data-teacher-metric="attendance"]').textContent = metricValue(teacherProfessionalState.attendance.length);
          }
          function teacherRenderClassList() {
            const list = teacherView?.querySelector('[data-teacher-class-list]');
            if (!list) return;
            if (!teacherProfessionalState.classes.length) { list.innerHTML = `<div class="teacher-pro-empty">${teacherProfessionalState.error || 'Nenhuma turma autorizada para este perfil.'}</div>`; return; }
            const classMap = new Map(teacherProfessionalState.classes.map(item => [item.id,item]));
            list.innerHTML = teacherProfessionalState.classes.map(group => { const students = teacherProfessionalState.students.filter(item => item.class_id === group.id); const ids = new Set(students.map(item => item.id)); const grades = teacherProfessionalState.grades.filter(item => ids.has(item.student_id)); const attendance = teacherProfessionalState.attendance.filter(item => ids.has(item.student_id)); const present = attendance.filter(item => item.status === 'present' || item.status === 'late').length; const rate = attendance.length ? `${Math.round((present / attendance.length) * 1000) / 10}%` : '—'; return `<article class="teacher-pro-class-card"><div class="eyebrow">${escapeHtml(group.shift || 'Turma autorizada')}</div><h3>${escapeHtml(teacherClassLabel(group))}</h3><p>${students.length} aluno${students.length === 1 ? '' : 's'} · ${grades.length} lançamento${grades.length === 1 ? '' : 's'}</p><div class="teacher-pro-class-stats"><span>Frequência <b>${rate}</b></span><span>Registros <b>${attendance.length}</b></span></div><button type="button" data-teacher-class-id="${escapeHtml(group.id)}">Abrir central da turma →</button></article>`; }).join('');
            if (!teacherProfessionalState.selectedClassId || !classMap.has(teacherProfessionalState.selectedClassId)) teacherProfessionalState.selectedClassId = teacherProfessionalState.classes[0].id;
          }
          function teacherRenderClassDetail() {
            const detail = teacherView?.querySelector('[data-teacher-class-detail]');
