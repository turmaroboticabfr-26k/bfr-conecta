    <style id="bfr-schedule-now">
      .schedule-panel .schedule-frame,.schedule-panel .schedule-caption { display:none !important; }
      .schedule-clock-card { position:relative; overflow:hidden; }
     .schedule-now { display:flex; align-items:center; gap:10px; margin-top:12px; padding:10px 12px; border:1px solid #cfe3d9; border-radius:12px; background:linear-gradient(120deg,#fff,#eefaf4); color:var(--ink); transition:background .3s ease,border-color .3s ease,box-shadow .3s ease,transform .3s ease; }
     .schedule-now.is-live { border-color:#7bc5a7; box-shadow:0 9px 22px rgba(39,137,102,.12); }
     .schedule-now.is-break { border-color:#e5c47e; background:linear-gradient(120deg,#fffdf6,#fff7df); }
     .schedule-now.is-off { border-color:#dbe4ec; background:linear-gradient(120deg,#fff,#f5f8fb); }
     .schedule-now-dot { flex:0 0 10px; width:10px; height:10px; border-radius:50%; background:#21a36f; box-shadow:0 0 0 5px rgba(33,163,111,.12); animation:schedulePulse 1.9s ease-in-out infinite; }
     .schedule-now.is-break .schedule-now-dot { background:#d39b2c; box-shadow:0 0 0 5px rgba(211,155,44,.13); }
     .schedule-now.is-off .schedule-now-dot { background:#94a3b8; box-shadow:none; animation:none; }
     .schedule-now > div { min-width:0; flex:1; }
     .schedule-now strong, .schedule-now small { display:block; }
     .schedule-now strong { color:#17694f; font-size:11px; line-height:1.25; }
     .schedule-now.is-break strong { color:#9a6b19; }
     .schedule-now.is-off strong { color:#52647a; }
     .schedule-now small { margin-top:3px; color:var(--muted); font-size:9px; line-height:1.35; }
     .schedule-now time { flex:0 0 auto; color:var(--teal); font-size:9px; font-weight:700; text-align:right; white-space:nowrap; }
     .schedule-clock-day.is-today { border-color:#9bcdb8; box-shadow:0 8px 18px rgba(45,130,98,.08); }
     .schedule-clock-day.is-today > strong:after { content:' · hoje'; color:#1d9b6a; font-weight:700; }
     .schedule-clock-day tr[data-schedule-row] { transition:background .22s ease,color .22s ease,opacity .22s ease; }
     .schedule-clock-day tr[data-schedule-row].schedule-current td { background:#e5f7ed; color:#17694f; font-weight:700; }
     .schedule-clock-day tr[data-schedule-row].schedule-current td:first-child { border-radius:6px 0 0 6px; }
     .schedule-clock-day tr[data-schedule-row].schedule-current td:last-child { border-radius:0 6px 6px 0; }
     .schedule-clock-day tr[data-schedule-row].schedule-upcoming td { color:#286eb1; }
     .schedule-clock-day tr[data-schedule-row].schedule-complete { opacity:.56; }
     @keyframes schedulePulse { 0%,100% { transform:scale(.9); opacity:.68; } 50% { transform:scale(1.14); opacity:1; } }
     @media (max-width:600px) { .schedule-now { align-items:flex-start; } .schedule-now time { padding-top:1px; } }
     @media (prefers-reduced-motion:reduce) { .schedule-now-dot { animation:none; } }
   </style>
   <style id="bfr-motion-v2">
