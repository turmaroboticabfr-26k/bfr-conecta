       #appShell.ready .logout-top-button { display:grid !important; place-items:center; width:34px; height:34px; padding:0 !important; font-size:0 !important; color:#2563eb !important; border-radius:10px; }
       #appShell.ready .logout-top-button:after { content:'↪'; font-size:18px; line-height:1; }
       .bfr-motion-ready #appShell.ready .content > .bfr-motion-item { animation-duration:.42s; animation-delay:var(--bfr-delay,0ms); }
     }
     @media (prefers-reduced-motion:reduce) {
       html { scroll-behavior:auto; }
       .login-card:before, #appShell.ready:before, #appShell.ready:after { display:none; }
       .bfr-motion-ready #appShell.ready .content > .bfr-motion-item, .bfr-motion-ready #appShell.ready.bfr-section-switching .content, .bfr-motion-ready .modal:not(.hidden), .bfr-motion-ready .modal:not(.hidden) .modal-card { animation:none !important; }
       .bfr-ripple { display:none; }
     }
   </style>
   <script id="bfr-motion-runtime">
     (() => {
       const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
       const appShell = document.getElementById('appShell');
       let sectionTimer = 0;
       let contentFrame = 0;
       function decorateContent() {
         if (!appShell?.classList.contains('ready')) return;
         appShell.querySelectorAll('main .content > *').forEach((item,index) => {
           item.classList.add('bfr-motion-item');
           item.style.setProperty('--bfr-index', String(index));
           item.style.setProperty('--bfr-delay', `${Math.min(index,8) * 55}ms`);
         });
       }
       function scheduleContentDecoration() {
         if (contentFrame) return;
         contentFrame = requestAnimationFrame(() => { contentFrame = 0; decorateContent(); });
       }
       function addRipple(action,event) {
         if (reduceMotion || action.matches('[data-no-ripple]')) return;
         const rect = action.getBoundingClientRect();
         const ripple = document.createElement('span');
         ripple.className = 'bfr-ripple';
         ripple.style.left = `${event.clientX - rect.left}px`;
         ripple.style.top = `${event.clientY - rect.top}px`;
         action.appendChild(ripple);
         ripple.addEventListener('animationend', () => ripple.remove(), { once:true });
       }
       function resetTilt(card) {
         card.classList.remove('bfr-tilt-enabled');
         card.style.removeProperty('--bfr-tilt-x');
         card.style.removeProperty('--bfr-tilt-y');
       }
       document.addEventListener('pointermove', event => {
         if (reduceMotion || event.pointerType === 'touch' || !(event.target instanceof Element)) return;
         const zone = event.target.closest('.login-screen,#appShell');
         if (zone) {
           const rect = zone.getBoundingClientRect();
           const normalizedX = ((event.clientX - rect.left) / rect.width) - .5;
           const normalizedY = ((event.clientY - rect.top) / rect.height) - .5;
           zone.style.setProperty('--bfr-parallax-x', normalizedX.toFixed(3));
           zone.style.setProperty('--bfr-parallax-y', normalizedY.toFixed(3));
           zone.style.setProperty('--bfr-parallax-x-px', `${(normalizedX * 12).toFixed(2)}px`);
           zone.style.setProperty('--bfr-parallax-y-px', `${(normalizedY * 12).toFixed(2)}px`);
           zone.style.setProperty('--bfr-parallax-deep-x-px', `${(normalizedX * 16).toFixed(2)}px`);
           zone.style.setProperty('--bfr-parallax-deep-y-px', `${(normalizedY * 16).toFixed(2)}px`);
           zone.style.setProperty('--bfr-parallax-reverse-x-px', `${(normalizedX * -12).toFixed(2)}px`);
           zone.style.setProperty('--bfr-parallax-reverse-y-px', `${(normalizedY * -12).toFixed(2)}px`);
         }
         const card = event.target.closest('.metric-card,.teacher-metric,.side-highlight,.game-subject,.growth-badge,.project');
         if (!card || !card.closest('#appShell')) return;
         const rect = card.getBoundingClientRect();
         const x = ((event.clientX - rect.left) / rect.width) - .5;
         const y = ((event.clientY - rect.top) / rect.height) - .5;
         card.classList.add('bfr-tilt-enabled');
         card.style.setProperty('--bfr-tilt-x', `${(y * -2.2).toFixed(2)}deg`);
         card.style.setProperty('--bfr-tilt-y', `${(x * 2.8).toFixed(2)}deg`);
       }, { passive:true });
       document.addEventListener('pointerout', event => {
         if (!(event.target instanceof Element)) return;
         const card = event.target.closest('.metric-card,.teacher-metric,.side-highlight,.game-subject,.growth-badge,.project');
         if (card && (!event.relatedTarget || !card.contains(event.relatedTarget))) resetTilt(card);
       });
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element)) return;
          const action = event.target.closest('button,a,[role="button"]');
         if (action && action.closest('.login-screen,#appShell')) addRipple(action,event);
         const navigation = event.target.closest('[data-section],[data-section-link],.mobile-more-option,.project-tab,.class-tab,.schedule-shift,.experience-tab,[data-game-subject]');
         if (navigation && appShell?.classList.contains('ready')) {
           appShell.classList.remove('bfr-section-switching');
           requestAnimationFrame(() => appShell.classList.add('bfr-section-switching'));
           clearTimeout(sectionTimer);
           sectionTimer = window.setTimeout(() => appShell.classList.remove('bfr-section-switching'), 420);
           window.setTimeout(scheduleContentDecoration, 40);
         }
       });
       const statusObserver = new MutationObserver(records => {
         records.forEach(record => {
           const target = record.target.nodeType === 1 ? record.target : record.target.parentElement;
           if (!target?.matches?.('.publish-status,.auth-status,.game-feedback,.growth-status,.role-management-status')) return;
           target.classList.remove('bfr-status-pop');
           requestAnimationFrame(() => target.classList.add('bfr-status-pop'));
         });
       });
       statusObserver.observe(document.body,{subtree:true,childList:true,characterData:true});
       const appObserver = new MutationObserver(() => scheduleContentDecoration());
       if (appShell) appObserver.observe(appShell,{attributes:true,attributeFilter:['class']});
       function enableMotion() {
         document.body.classList.add('bfr-motion-ready');
         scheduleContentDecoration();
       }
       if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded',enableMotion,{once:true});
       else enableMotion();
       window.addEventListener('load',enableMotion,{once:true});
     })();
    </script>
    <style id="bfr-install-ui">
      .install-app-floating-wrap { position:fixed; right:22px; bottom:22px; z-index:70; display:grid; justify-items:end; gap:6px; width:min(220px,calc(50vw - 28px)); }
      .install-app-floating { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:36px; padding:8px 12px; border:1px solid rgba(255,255,255,.34); border-radius:10px; background:linear-gradient(135deg,#10295f,#1769d2); color:#fff; font:700 10px 'DM Sans',sans-serif; box-shadow:0 10px 22px rgba(16,41,95,.22); cursor:pointer; }
      .install-app-floating:hover { transform:translateY(-2px); box-shadow:0 18px 34px rgba(16,41,95,.3); }
      .install-app-floating span:first-child { display:grid; place-items:center; width:18px; height:18px; border-radius:6px; background:rgba(255,255,255,.18); font-size:14px; line-height:1; }
      .install-app-hint { margin:0; padding:7px 9px; border:1px solid rgba(37,99,235,.15); border-radius:8px; background:rgba(255,255,255,.94); color:#52617a; font-size:9px; line-height:1.3; text-align:right; box-shadow:0 6px 16px rgba(22,55,108,.1); }
      .install-app-panel { display:flex; align-items:center; justify-content:space-between; gap:14px; margin:15px 0; padding:14px; border:1px solid #dbe7f5; border-radius:14px; background:linear-gradient(135deg,#f4f8ff,#fff); }
      .install-app-panel strong, .install-app-panel small { display:block; }
      .install-app-panel strong { color:#1e3f87; font-size:13px; }
      .install-app-panel small { margin-top:4px; color:#71809a; font-size:10px; line-height:1.35; }
      .install-app-panel button { flex:0 0 auto; border:0; border-radius:9px; padding:10px 12px; background:#1769d2; color:#fff; font-size:11px; font-weight:700; cursor:pointer; }
      .install-app-panel button:hover { background:#10295f; transform:translateY(-1px); }
      .install-app-panel .install-app-hint { flex-basis:100%; padding:0; border:0; background:transparent; box-shadow:none; text-align:left; }
       @media (max-width:800px) {
         .install-app-floating-wrap { position:absolute; right:12px; left:auto; top:16px; bottom:auto; width:min(210px,calc(50vw - 20px)); }
        .install-app-floating { width:auto; }
        .install-app-hint { text-align:right; }
        .install-app-panel { align-items:flex-start; flex-wrap:wrap; }
       .install-app-panel button { width:100%; }
       }
       @media (max-width:800px) {
         body:has(#loginScreen:not(.hidden)) { background:#0755c7 !important; overflow-x:hidden !important; }
         .login-screen { width:100% !important; height:100svh !important; min-height:100svh !important; padding:0 !important; background:#0755c7 !important; overflow:hidden !important; }
         .login-card { width:100% !important; height:100% !important; min-height:0 !important; padding:0 !important; }
         .login-layout { display:grid !important; grid-template-columns:minmax(0,1fr) minmax(0,1fr) !important; width:100% !important; height:100% !important; min-height:0 !important; border-radius:0 !important; overflow:hidden !important; background:#0755c7 !important; }
         .login-message { position:relative !important; inset:auto !important; display:flex !important; flex-direction:column !important; width:auto !important; height:100% !important; min-height:0 !important; padding:clamp(30px,7vw,68px) clamp(14px,3vw,38px) 0 !important; background:linear-gradient(145deg,#063b93,#0755c7 64%,#0785eb) !important; overflow:hidden !important; }
         .login-message:before { display:none !important; }
          .login-message:after { display:block !important; content:'' !important; z-index:0 !important; position:absolute !important; left:0 !important; right:0 !important; bottom:0 !important; width:auto !important; height:27% !important; background:none !important; opacity:.95 !important; }
         .login-message > * { position:relative !important; z-index:1 !important; visibility:visible !important; }
         .login-message > .eyebrow, .login-message > .school-symbol-wrap { display:none !important; }
         .login-message h1 { max-width:100% !important; margin:0 !important; padding:0 !important; font-size:clamp(25px,6vw,40px) !important; line-height:1.04 !important; letter-spacing:-.045em !important; }
         .login-message > p { max-width:100% !important; margin-top:16px !important; font-size:clamp(11px,2.8vw,18px) !important; line-height:1.35 !important; }
         .login-benefits { display:grid !important; grid-template-columns:1fr !important; gap:8px !important; max-width:100% !important; margin-top:18px !important; padding:0 !important; font-size:clamp(9px,1.8vw,13px) !important; }
         .login-benefits > span { display:flex !important; min-height:44px !important; padding:7px 9px !important; border:1px solid rgba(255,255,255,.24) !important; border-radius:12px !important; background:rgba(255,255,255,.08) !important; }
         .login-benefits > span > span { min-width:0 !important; }
         .login-benefits b { flex:0 0 clamp(38px,7vw,54px) !important; width:clamp(38px,7vw,54px) !important; height:clamp(38px,7vw,54px) !important; margin-right:8px !important; border:1px solid rgba(255,255,255,.3) !important; border-radius:50% !important; background:rgba(255,255,255,.18) !important; color:#fff !important; font-size:0 !important; }
         .login-benefits b:after { font-size:clamp(18px,3vw,27px) !important; }
          .login-benefits > span:nth-child(1) b:after { content:'' !important; position:absolute !important; top:7px !important; left:50% !important; width:11px !important; height:11px !important; border:2px solid #fff !important; border-radius:50% !important; transform:translateX(-50%) !important; font-size:0 !important; }
          .login-benefits > span:nth-child(1) b { position:relative !important; }
          .login-benefits > span:nth-child(1) b:before { content:'' !important; position:absolute !important; left:50% !important; bottom:7px !important; width:22px !important; height:11px !important; border:2px solid #fff !important; border-radius:13px 13px 7px 7px !important; transform:translateX(-50%) !important; }
         .login-benefits > span:nth-child(2) b:after { content:'👪' !important; }
         .login-benefits > span:nth-child(3) b:after { content:'🎓' !important; }
         .login-benefits > span:nth-child(4) b:after { content:'📋' !important; }
         .login-benefits strong { font-size:1em !important; }
         .login-benefits small { margin-top:2px !important; font-size:.82em !important; }
         .login-form { position:relative !important; inset:auto !important; display:flex !important; width:auto !important; height:100% !important; min-height:0 !important; margin:0 !important; padding:clamp(20px,5vw,48px) clamp(14px,3vw,38px) 84px !important; border:0 !important; border-radius:0 !important; background:#fff !important; overflow-y:auto !important; justify-content:flex-start !important; }
         .login-form > * { visibility:visible !important; }
          .login-form > .eyebrow { display:none !important; }
          .login-form > h2, .login-form > p { display:block !important; }
         .login-product-logo { width:min(100%,170px) !important; margin:54px auto clamp(18px,4vw,32px) !important; }
         .login-form h2 { font-size:clamp(22px,4.4vw,32px) !important; line-height:1.08 !important; }
         .login-form > p { max-width:100% !important; margin-top:9px !important; font-size:clamp(13px,2.6vw,20px) !important; line-height:1.28 !important; }
          .google-button { height:clamp(48px,10vw,68px) !important; margin-top:22px !important; padding:10px 12px !important; border-width:2px !important; border-radius:11px !important; font-size:clamp(13px,2.4vw,20px) !important; gap:10px !important; }
          .login-form #googleLogin { position:static !important; left:auto !important; top:auto !important; width:100% !important; opacity:1 !important; }
          .login-form #googleLogin { order:0 !important; }
          .login-form .auth-status { order:1 !important; }
          .login-form .login-privacy, .login-form .login-creator-credit, .login-form .login-legal-links, .login-form .school-links { order:2 !important; }
         .google-g { font-size:clamp(27px,5vw,38px) !important; }
         .login-privacy { gap:9px !important; margin-top:24px !important; font-size:clamp(10px,1.9vw,14px) !important; line-height:1.3 !important; }
         .login-privacy:before { flex:0 0 32px !important; width:32px !important; height:40px !important; border-width:2px !important; border-radius:9px 9px 15px 15px !important; font-size:18px !important; }
         .login-creator-credit { display:block !important; margin-top:16px !important; font-size:9px !important; }
         .login-legal-links { display:flex !important; gap:6px !important; margin-top:8px !important; }
         .login-legal-links button { font-size:9px !important; }
         .school-links { display:grid !important; gap:5px !important; margin-top:8px !important; }
         .school-links a { font-size:9px !important; }
       }
       @media (max-width:520px) {
         #loginScreen { position:relative !important; }
         .install-app-floating-wrap { position:absolute !important; right:12px !important; top:14px !important; bottom:auto !important; z-index:100 !important; }
         .login-screen { height:100svh !important; min-height:0 !important; overflow:hidden !important; }
         .login-card { height:100% !important; min-height:0 !important; }
         .login-layout { display:flex !important; flex-direction:column !important; height:100% !important; min-height:0 !important; overflow:hidden !important; }
         .login-message { flex:0 0 47% !important; height:auto !important; min-height:0 !important; padding:18px 18px 10px !important; }
         .login-message:after { height:20% !important; }
         .login-message h1 { max-width:280px !important; font-size:clamp(25px,7.5vw,30px) !important; }
         .login-message > p { max-width:310px !important; margin-top:9px !important; font-size:13px !important; line-height:1.25 !important; }
         .login-benefits { gap:4px !important; max-width:310px !important; margin-top:10px !important; font-size:10px !important; }
         .login-benefits > span { min-height:34px !important; padding:4px 7px !important; }
         .login-benefits b { flex-basis:34px !important; width:34px !important; height:34px !important; margin-right:7px !important; }
         .login-benefits b:after { font-size:16px !important; }
         .login-benefits > span:nth-child(1) b:after { top:5px !important; width:9px !important; height:9px !important; }
         .login-benefits > span:nth-child(1) b:before { bottom:5px !important; width:18px !important; height:9px !important; }
         .login-form { flex:1 1 53% !important; height:auto !important; min-height:0 !important; padding:10px 18px 12px !important; overflow:hidden !important; }
         .login-product-logo { width:min(100%,145px) !important; margin-top:44px !important; margin-bottom:7px !important; }
         .login-form h2 { font-size:22px !important; }
         .login-form > p { font-size:14px !important; margin-top:5px !important; }
         .google-button { height:44px !important; margin-top:12px !important; font-size:14px !important; }
         .login-form #googleLogin { width:100% !important; }
         .login-privacy { display:none !important; }
         .login-creator-credit, .login-legal-links, .school-links { display:none !important; }
         .install-app-floating-wrap { width:min(165px,calc(50vw - 18px)) !important; right:12px !important; top:14px !important; bottom:auto !important; }
         .install-app-floating { min-height:32px !important; padding:7px 9px !important; font-size:9px !important; }
         .install-app-hint { padding:6px 8px !important; font-size:8px !important; }
       }
     </style>
    <script id="bfr-install-runtime">
      (() => {
        let deferredPrompt = null;
        const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const isStandalone = () => window.matchMedia?.('(display-mode: standalone)').matches || navigator.standalone === true;
        function installHint() {
          if (isIOS) return 'No iPhone/iPad, toque em Compartilhar e depois em Adicionar à Tela de Início.';
          return 'Abra o menu do navegador e escolha Instalar BFR Conecta ou Adicionar à tela inicial.';
        }
        function updateInstallUi(message = '') {
          const installed = isStandalone();
          document.querySelectorAll('[data-install-app]').forEach(button => {
            button.classList.toggle('hidden', installed);
            const label = button.querySelector('[data-install-label]');
             const nextLabel = deferredPrompt ? 'Instalar aplicativo' : 'Como instalar';
            if (label && label.textContent !== nextLabel) label.textContent = nextLabel;
          });
          document.querySelectorAll('[data-install-hint]').forEach(hint => {
            const text = installed ? 'O aplicativo já está instalado neste dispositivo.' : (message || (deferredPrompt ? 'Instale para abrir o BFR Conecta em uma janela própria.' : installHint()));
            if (hint.textContent !== text) hint.textContent = text;
            hint.classList.toggle('hidden', !text);
          });
        }
         function ensureLoginInstallControl() {
           const screen = document.getElementById('loginScreen');
           const form = screen?.querySelector('.login-form');
           const existing = screen?.querySelector('.install-app-floating-wrap');
           if (form && existing && !form.contains(existing)) form.appendChild(existing);
           if (!screen || screen.querySelector('[data-install-app]')) return;
           (form || screen).insertAdjacentHTML('beforeend', '<div class="install-app-floating-wrap"><button type="button" class="install-app-floating" data-install-app><span aria-hidden="true">↓</span><span data-install-label>Instalar aplicativo</span></button><p class="install-app-hint hidden" data-install-hint></p></div>');
         }
        function ensurePreferencesInstallControl() {
          document.querySelectorAll('.account-tool-card').forEach(card => {
            const form = card.querySelector('[data-preferences-form]');
            if (!form || card.querySelector('[data-install-app-panel]')) return;
            form.insertAdjacentHTML('beforebegin', '<div class="install-app-panel" data-install-app-panel><div><strong>Instalar aplicativo</strong><small>Tenha o BFR Conecta na tela inicial e abra o portal em uma janela própria.</small></div><button type="button" data-install-app><span data-install-label>Instalar aplicativo</span></button><p class="install-app-hint hidden" data-install-hint></p></div>');
          });
        }
        async function installApp() {
          if (isStandalone()) { updateInstallUi('O aplicativo já está instalado neste dispositivo.'); return; }
           if (!deferredPrompt) {
             updateInstallUi(isIOS ? installHint() : 'Abra o menu ⋮ do navegador e toque em “Instalar aplicativo” ou “Adicionar à tela inicial”.');
             return;
           }
          const promptEvent = deferredPrompt;
          deferredPrompt = null;
           try {
             await promptEvent.prompt();
             const choice = await promptEvent.userChoice;
             updateInstallUi(choice.outcome === 'accepted' ? 'Aplicativo instalado. Você pode abri-lo pela tela inicial.' : 'A instalação foi cancelada. Você pode tentar novamente quando quiser.');
           } catch {
             updateInstallUi('Abra o menu ⋮ do navegador e escolha “Instalar aplicativo”.');
           }
        }
        window.addEventListener('beforeinstallprompt', event => { event.preventDefault(); deferredPrompt = event; updateInstallUi(); });
        window.addEventListener('appinstalled', () => { deferredPrompt = null; updateInstallUi('Aplicativo instalado.'); });
        document.addEventListener('click', event => {
          if (event.target.closest('[data-install-app]')) installApp();
        });
         ensureLoginInstallControl();
         ensurePreferencesInstallControl();
        updateInstallUi();
              if ('serviceWorker' in navigator) navigator.serviceWorker.register(`${APP_ORIGIN}/sw-v4.js?v=14`).catch(() => {});
      })();
     </script>
     <style id="bfr-lia-style">
       :root { --lia-blue:#1769d2; --lia-navy:#10295f; --lia-mint:#eaf7f3; --lia-violet:#745bd4; }
       body.lia-open { overflow:hidden; }
        .lia-fab { position:fixed; right:22px; bottom:88px; z-index:72; display:inline-flex; align-items:center; gap:7px; min-height:46px; padding:6px 12px 6px 7px; border:1px solid rgba(255,255,255,.45); border-radius:15px; color:#fff; background:linear-gradient(135deg,#10295f,#1769d2 72%,#745bd4); box-shadow:0 14px 30px rgba(16,41,95,.25); font:700 11px 'DM Sans',sans-serif; transition:transform .2s,box-shadow .2s,opacity .2s; }
       .lia-fab:hover { transform:translateY(-3px); box-shadow:0 20px 40px rgba(16,41,95,.34); }
        .lia-fab-avatar, .lia-avatar, .lia-home-icon, .lia-message-avatar { display:grid; place-items:center; overflow:hidden; border-radius:13px; color:#fff; background:linear-gradient(145deg,#24b7a1,#1769d2 68%,#745bd4); box-shadow:inset 0 0 0 1px rgba(255,255,255,.25); }
        .lia-fab-avatar img, .lia-avatar img, .lia-home-icon img, .lia-message-avatar img { display:block; width:100%; height:100%; object-fit:cover; border-radius:inherit; }
        .lia-fab-avatar { width:29px; height:29px; font-size:15px; border-radius:11px; }
       .lia-fab-copy { display:grid; gap:1px; text-align:left; }
        .lia-fab-copy small { color:#bfe7e0; font:8px 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.05em; }
        .lia-fab-status { width:6px; height:6px; border-radius:50%; background:#6de3a4; box-shadow:0 0 0 3px rgba(109,227,164,.14); }
       .lia-overlay { position:fixed; inset:0; z-index:100; display:flex; justify-content:flex-end; align-items:flex-end; padding:24px; background:rgba(12,28,58,.2); opacity:0; pointer-events:none; transition:opacity .2s; }
       .lia-overlay.is-open { opacity:1; pointer-events:auto; }
       .lia-chat { width:min(430px,100%); height:min(720px,calc(100vh - 48px)); display:grid; grid-template-rows:auto 1fr auto; overflow:hidden; border:1px solid rgba(37,99,235,.18); border-radius:24px; background:#f8fbff; box-shadow:0 28px 80px rgba(16,41,95,.27); transform:translateY(18px) scale(.98); transition:transform .25s; }
       .lia-overlay.is-open .lia-chat { transform:none; }
       .lia-chat-head { display:flex; align-items:center; gap:11px; padding:17px 18px; color:#fff; background:linear-gradient(135deg,#10295f,#1769d2 72%,#745bd4); }
       .lia-avatar { width:42px; height:42px; flex:0 0 auto; font-size:22px; }
       .lia-chat-head-copy { min-width:0; flex:1; }
       .lia-chat-head-copy strong, .lia-chat-head-copy small { display:block; }
       .lia-chat-head-copy strong { font:700 18px 'Playfair Display',serif; letter-spacing:-.3px; }
       .lia-chat-head-copy small { margin-top:3px; color:#c9e9e4; font-size:10px; }
       .lia-online { display:inline-flex; align-items:center; gap:5px; margin-top:6px; color:#a7f1c4; font:9px 'DM Mono',monospace; text-transform:uppercase; }
       .lia-online i { width:6px; height:6px; border-radius:50%; background:#6de3a4; }
       .lia-close { width:31px; height:31px; border:1px solid rgba(255,255,255,.3); border-radius:10px; color:#fff; background:rgba(255,255,255,.1); font-size:20px; line-height:1; }
       .lia-close:hover { background:rgba(255,255,255,.2); }
       .lia-chat-body { min-height:0; overflow:auto; padding:18px 15px 12px; background:linear-gradient(180deg,#f7fbff,#f9fbfd); }
       .lia-message { display:flex; gap:9px; align-items:flex-start; margin:0 0 14px; }
       .lia-message.user { justify-content:flex-end; }
       .lia-message-avatar { display:grid; place-items:center; width:27px; height:27px; flex:0 0 auto; border-radius:9px; color:#fff; background:linear-gradient(145deg,#24b7a1,#1769d2); font-size:13px; }
       .lia-message.user .lia-message-avatar { order:2; background:#e7edf9; color:#1769d2; font-size:10px; font-weight:700; }
       .lia-bubble { max-width:82%; padding:10px 12px; border:1px solid #e1eaf5; border-radius:15px 15px 15px 4px; color:#263957; background:#fff; font-size:12px; line-height:1.52; box-shadow:0 5px 16px rgba(28,65,117,.06); }
       .lia-message.user .lia-bubble { border-color:#cfe0fb; border-radius:15px 15px 4px 15px; color:#fff; background:#1769d2; }
       .lia-bubble p { margin:0 0 8px; }
       .lia-bubble p:last-child { margin-bottom:0; }
       .lia-bubble ul { margin:6px 0 2px 17px; padding:0; }
       .lia-bubble li { margin:3px 0; }
       .lia-bubble strong { color:#163c83; font-weight:700; }
       .lia-message.user .lia-bubble strong { color:#fff; }
       .lia-suggestions { display:flex; flex-wrap:wrap; gap:7px; margin:2px 0 15px 36px; }
       .lia-suggestion { border:1px solid #cfe0fb; border-radius:13px; padding:8px 10px; color:#1e579f; background:#f1f7ff; font-size:10px; text-align:left; transition:.18s; }
       .lia-suggestion:hover { border-color:#1769d2; background:#e5f1ff; transform:translateY(-1px); }
       .lia-thinking { display:flex; align-items:center; gap:7px; margin:0 0 11px 36px; color:#71809a; font-size:10px; }
       .lia-thinking-dots { display:flex; gap:3px; }
       .lia-thinking-dots i { width:5px; height:5px; border-radius:50%; background:#1769d2; animation:lia-pulse 1s infinite ease-in-out; }
       .lia-thinking-dots i:nth-child(2) { animation-delay:.15s; }
       .lia-thinking-dots i:nth-child(3) { animation-delay:.3s; }
       @keyframes lia-pulse { 0%,80%,100% { opacity:.3; transform:translateY(0); } 40% { opacity:1; transform:translateY(-3px); } }
       .lia-chat-foot { padding:10px 12px 12px; border-top:1px solid #e1eaf5; background:#fff; }
       .lia-chat-form { display:flex; align-items:flex-end; gap:8px; padding:6px; border:1px solid #cfe0fb; border-radius:15px; background:#f8fbff; }
       .lia-chat-form:focus-within { border-color:#1769d2; box-shadow:0 0 0 3px rgba(23,105,210,.1); }
       .lia-chat-input { min-height:35px; max-height:112px; flex:1; resize:none; border:0; outline:0; color:#263957; background:transparent; font-size:12px; line-height:1.45; }
       .lia-chat-input::placeholder { color:#91a0b6; }
       .lia-send { display:grid; place-items:center; width:35px; height:35px; border:0; border-radius:11px; color:#fff; background:#1769d2; font-size:16px; }
       .lia-send:disabled { opacity:.5; cursor:not-allowed; }
       .lia-privacy-note { margin:7px 3px 0; color:#91a0b6; font:9px 'DM Mono',monospace; }
       .lia-home-card { position:relative; display:flex; align-items:center; justify-content:space-between; gap:18px; margin:0 0 18px; padding:17px 19px; overflow:hidden; border:1px solid #d8e7f8; border-radius:16px; background:linear-gradient(120deg,#eef6ff,#fbfaff); box-shadow:0 10px 28px rgba(36,82,145,.06); }
       .lia-home-card:after { content:''; position:absolute; width:150px; height:150px; right:-34px; top:-76px; border:1px solid rgba(116,91,212,.2); border-radius:50%; box-shadow:0 0 0 22px rgba(23,105,210,.04),0 0 0 45px rgba(23,105,210,.03); }
       .lia-home-copy { display:flex; align-items:center; gap:12px; position:relative; z-index:1; }
       .lia-home-icon { display:grid; place-items:center; width:40px; height:40px; flex:0 0 auto; border-radius:13px; color:#fff; background:linear-gradient(145deg,#24b7a1,#1769d2 68%,#745bd4); font-size:20px; }
       .lia-home-copy strong, .lia-home-copy span { display:block; }
       .lia-home-copy strong { color:#1c3e82; font:700 16px 'Playfair Display',serif; }
       .lia-home-copy span { margin-top:3px; color:#71809a; font-size:11px; }
       .lia-home-action { position:relative; z-index:1; flex:0 0 auto; border:0; border-radius:11px; padding:10px 13px; color:#fff; background:#1769d2; font-size:11px; font-weight:700; }
       .lia-home-action:hover { background:#10295f; transform:translateY(-1px); }
       @media (max-width:800px) {
          .lia-fab { right:14px; bottom:166px; min-height:44px; padding:5px 10px 5px 6px; }
         .lia-overlay { align-items:stretch; padding:0; background:#f8fbff; }
         .lia-chat { width:100%; height:100%; max-height:none; border:0; border-radius:0; }
         .lia-chat-head { padding:16px 15px; }
         .lia-chat-body { padding:17px 12px 12px; }
         .lia-bubble { max-width:88%; }
         .lia-home-card { align-items:flex-start; flex-direction:column; gap:13px; }
         .lia-home-action { width:100%; }
       }
       @media (prefers-reduced-motion:reduce) { .lia-fab, .lia-chat, .lia-overlay, .lia-home-action, .lia-suggestion { transition:none; } .lia-thinking-dots i { animation:none; } }
     </style>
     <button class="lia-fab hidden" id="liaFab" type="button" aria-label="Abrir a LIA">
       <span class="lia-fab-avatar" aria-hidden="true"><img src="data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20128%20128%22%3E%3Crect%20width%3D%22128%22%20height%3D%22128%22%20rx%3D%2228%22%20fill%3D%22%231769d2%22%2F%3E%3Ccircle%20cx%3D%2264%22%20cy%3D%2264%22%20r%3D%2243%22%20fill%3D%22%23fff%22%2F%3E%3Ctext%20x%3D%2264%22%20y%3D%2275%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%2Csans-serif%22%20font-size%3D%2227%22%20font-weight%3D%22700%22%20fill%3D%22%231769d2%22%3ELIA%3C%2Ftext%3E%3C%2Fsvg%3E" alt="Logo da LIA"></span>
       <span class="lia-fab-copy"><b>LIA</b><small>Assistente escolar</small></span>
       <i class="lia-fab-status" aria-label="Online"></i>
     </button>
     <div class="lia-overlay" id="liaOverlay" aria-hidden="true">
       <section class="lia-chat" role="dialog" aria-modal="true" aria-labelledby="liaTitle">
         <header class="lia-chat-head">
           <div class="lia-avatar" aria-hidden="true"><img src="data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20128%20128%22%3E%3Crect%20width%3D%22128%22%20height%3D%22128%22%20rx%3D%2228%22%20fill%3D%22%231769d2%22%2F%3E%3Ccircle%20cx%3D%2264%22%20cy%3D%2264%22%20r%3D%2243%22%20fill%3D%22%23fff%22%2F%3E%3Ctext%20x%3D%2264%22%20y%3D%2275%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%2Csans-serif%22%20font-size%3D%2227%22%20font-weight%3D%22700%22%20fill%3D%22%231769d2%22%3ELIA%3C%2Ftext%3E%3C%2Fsvg%3E" alt="Logo da LIA"></div>
           <div class="lia-chat-head-copy"><strong id="liaTitle">LIA</strong><small>Assistente inteligente do BFR Conecta</small><span class="lia-online"><i></i>Online</span></div>
           <button class="lia-close" id="liaClose" type="button" aria-label="Fechar LIA">×</button>
         </header>
         <div class="lia-chat-body" id="liaMessages" aria-live="polite"><article class="lia-message assistant"><span class="lia-message-avatar" aria-hidden="true"><img src="data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20128%20128%22%3E%3Crect%20width%3D%22128%22%20height%3D%22128%22%20rx%3D%2228%22%20fill%3D%22%231769d2%22%2F%3E%3Ccircle%20cx%3D%2264%22%20cy%3D%2264%22%20r%3D%2243%22%20fill%3D%22%23fff%22%2F%3E%3Ctext%20x%3D%2264%22%20y%3D%2275%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%2Csans-serif%22%20font-size%3D%2227%22%20font-weight%3D%22700%22%20fill%3D%22%231769d2%22%3ELIA%3C%2Ftext%3E%3C%2Fsvg%3E" alt="Logo da LIA"></span><div class="lia-bubble"><p>Olá! Eu sou a LIA 🤖✨, a assistente inteligente do BFR Conecta. Estou aqui para ajudar você com estudos, atividades, dúvidas e informações da escola. Como posso ajudar?</p></div></article><div class="lia-suggestions"><button class="lia-suggestion" type="button" data-lia-suggestion="Como estão minhas notas?">📊 Como estão minhas notas?</button><button class="lia-suggestion" type="button" data-lia-suggestion="Ver minha agenda">📅 Ver minha agenda</button><button class="lia-suggestion" type="button" data-lia-suggestion="Ver comunicados">📢 Ver comunicados</button><button class="lia-suggestion" type="button" data-lia-suggestion="Informações da escola">🏫 Informações da escola</button></div></div>
         <footer class="lia-chat-foot">
           <form class="lia-chat-form" id="liaForm">
             <textarea class="lia-chat-input" id="liaInput" rows="1" maxlength="4000" placeholder="Digite sua pergunta..." aria-label="Mensagem para a LIA"></textarea>
             <button class="lia-send" id="liaSend" type="submit" aria-label="Enviar mensagem" disabled="">↑</button>
           </form>
           <p class="lia-privacy-note">A LIA usa somente o contexto autorizado da sua conta.</p>
         </footer>
        </section>
      </div>
      <script id="bfr-lia-runtime">
        (() => {
          const fab = document.getElementById('liaFab');
          const overlay = document.getElementById('liaOverlay');
          const messagesEl = document.getElementById('liaMessages');
          const form = document.getElementById('liaForm');
          const input = document.getElementById('liaInput');
           const send = document.getElementById('liaSend');
           if (!fab || !overlay || !messagesEl || !form || !input) return;
           overlay.inert = true;

          const state = { messages:[], pending:false, open:false };
          const endpoint = window.BFR_LIA_API_URL || (typeof SUPABASE_URL !== 'undefined' ? `${SUPABASE_URL}/functions/v1/lia-chat` : '');
           const suggestionsByRole = {
             student:['📚 Explicar um assunto','📝 Ajudar em uma atividade','🎓 Quero estudar','🎯 Fazer um quiz'],
             parent:['📊 Como estão minhas notas?','📅 Ver minha agenda','📢 Ver comunicados','🏫 Informações da escola'],
                pedagogical:['👪 Preparar reunião de pais','🧪 Gerar avaliação com gabarito','🪜 Diferenciar atividade','💬 Gerar feedback individual','🧭 Organizar conselho de classe','📝 Criar uma atividade','🎯 Criar um quiz','📘 Montar um plano de aula'],
              aee:['🧩 Criar PDI ou adaptação curricular','📚 Criar atividade adaptada','📝 Registrar acompanhamento','💡 Preciso de ajuda'],
             coordinator:['🧭 Organizar conselho de classe','📅 Consultar a agenda','📢 Ver comunicados','💡 Preciso de ajuda'],
             director:['🧭 Organizar conselho de classe','📊 Ver dados autorizados','📢 Ver comunicados','💡 Preciso de ajuda'],
             secretary:['📢 Ver comunicados','📅 Consultar a agenda','🏫 Informações da escola','💡 Preciso de ajuda'],
             monitor:['🏫 Informações da escola','📅 Consultar a agenda','💡 Preciso de ajuda'],
             gatekeeper:['🏫 Informações da escola','📅 Consultar a agenda','💡 Preciso de ajuda'],
             developer:['🧭 Organizar conselho de classe','📊 Ver dados autorizados','🏫 Informações da escola','💡 Preciso de ajuda']
           };
           const councilClassPrompt = [
             'Atue como um Coordenador Pedagógico organizando o conselho de classe do bimestre.',
             'Estruture o conselho para produzir decisões e encaminhamentos, não um desfile de queixas sobre alunos.',
             '',
             'Dados para análise:',
             '- Contexto: segmento, número de turmas e tempo disponível por turma.',
             '- Dados disponíveis: notas, frequência, ocorrências e registros dos professores.',
             '- Problemas recorrentes: atrasos, julgamento moral ou falta de registro.',
             '- Participantes: professores, direção, orientação e, se aplicável, representantes de alunos.',
             '',
             'Estruture a resposta em: 1) pré-conselho com painel de dados e formulário docente; 2) pauta com tempos realistas e combinado de conduta; 3) roteiro de condução com perguntas que transformem queixas em encaminhamentos; 4) critérios explícitos para apoio pedagógico, orientação e contato com a família; 5) ata enxuta com decisão, responsável e prazo; 6) devolutiva para professores, famílias e alunos.',
             'Inclua uma pauta adaptada para conselho participativo quando houver representantes de alunos.',
             'Não invente dados. Quando faltarem informações, indique os campos que precisam ser preenchidos.'
           ].join('\n');
           const pdiAeePrompt = [
             'Atue como um Coordenador Pedagógico especialista em Educação Inclusiva e Gestão da Aprendizagem.',
             'Estruture um Plano de Desenvolvimento Individualizado (PDI) ou uma Adaptação Curricular para um aluno específico.',
             '',
             'Use somente os dados fornecidos pela equipe autorizada:',
             '1. Perfil do aluno: diagnóstico, laudo ou observações comportamentais, sem inferir informações ausentes.',
             '2. Série/ano e componente curricular em foco.',
             '3. Objetivos de aprendizagem previstos para a turma, alinhados à BNCC quando informados.',
             '4. Principais dificuldades e potencialidades identificadas no estudante.',
             '',
             'Gere um documento com: objetivos de aprendizagem prioritários; estratégias de flexibilização, como instruções multissensoriais, enunciados acessíveis e organizadores gráficos; adaptação de materiais e avaliação; ações de mediação para favorecer autonomia; e cronograma de acompanhamento com datas ou periodicidade para revisar as metas.',
             'Use tom profissional, orientador e alinhado às diretrizes de educação inclusiva vigentes no Brasil.',
             'Não transforme o texto em diagnóstico médico, não reduza o estudante ao laudo e não compartilhe dados sensíveis além do necessário. Quando faltarem dados, peça os campos ausentes e sinalize o que precisa ser validado pela equipe escolar.'
           ].join('\n');
           const adaptedActivityAeePrompt = [
             'Atue como um Professor experiente em educação inclusiva.',
             'Adapte uma atividade existente para um estudante com TDAH ou TEA, mudando o acesso à tarefa e nunca rebaixando o objetivo de aprendizagem.',
             '',
             'Dados para análise:',
             '- Turma: ano/série, disciplina e tamanho da turma.',
             '- Atividade original: texto da atividade ou descrição do que os alunos farão.',
             '- Objetivo de aprendizagem: o que a atividade avalia ou desenvolve.',
             '- Estudante: perfil informado de TDAH, TEA ou ambos; dados autorizados de laudo/PEI; o que funciona e o que dispara desregulação.',
             '- Recursos da escola: apoio em sala, materiais e tempo disponível.',
             '',
             'Estruture a resposta em: 1) Análise de barreiras, considerando instrução longa, tempo, estímulos, abstração e transições para o estudante real; 2) Atividade adaptada completa, pronta para aplicar, com instruções segmentadas, apoios visuais descritos e tempo ajustado; 3) O que se manteve, demonstrando que o objetivo e a expectativa de aprendizagem são os mesmos; 4) Estratégias de aplicação, incluindo apresentação, posicionamento, sinais combinados e resposta à desregulação; 5) Avaliação da mesma aprendizagem por evidências alternativas e registro para PEI/relatórios; 6) Para a turma toda, destacando adaptações úteis pelo Desenho Universal para a Aprendizagem.',
             'Evite estereótipos. Aponte o que o professor deve observar no estudante real em vez de aplicar uma receita do diagnóstico.',
             'Não invente dados, não faça diagnóstico clínico e não exponha informações sensíveis. Se faltarem campos, peça-os antes de concluir a adaptação.'
           ].join('\n');
           const parentMeetingReportPrompt = [
             'Atue como um Professor preparando uma reunião de pais.',
             'Transforme as observações fornecidas em um relatório de acompanhamento individual honesto sobre as dificuldades, concreto nos exemplos e utilizável pela família.',
             '',
             'Dados para análise:',
             '- Aluno: ano/série e disciplina(s) que o professor leciona.',
             '- Desempenho: notas, produções recentes e participação.',
             '- Observações de sala: comportamento, interações e hábitos de estudo, sempre com episódios concretos.',
             '- Pontos de atenção: o que preocupa e desde quando.',
             '- Contexto da família: o que se sabe sobre a relação com a escola e a receptividade.',
             '',
             'Estruture a resposta em: 1) Síntese de abertura, com duas ou três frases equilibradas que mostrem que a família e o professor conhecem o momento do aluno; 2) Avanços com evidências, ancorados em produção, episódio ou data, evitando frases vagas; 3) Pontos de atenção sem rótulos, descrevendo comportamento observável e acrescentando a leitura pedagógica; 4) O que a escola fará no próximo período; 5) Combinados com a família, com duas ou três ações pequenas, específicas e realistas; 6) Roteiro da conversa para 15 minutos, incluindo como reagir se a família se defender ou se emocionar.',
             'Use tom de parceria e linguagem sem tecnicismo pedagógico. Se houver necessidade de avaliação especializada, comunique com cuidado, partindo de observações concretas, sem diagnosticar ou alarmar.',
              'Não invente notas, datas, episódios, intenções ou informações familiares. Não use rótulos como desinteressado, preguiçoso ou desestruturado; peça os dados ausentes e sinalize o que precisa ser confirmado pelo professor.'
            ].join('\n');
           const evaluationAssessmentPrompt = [
              'Atue como um(a) Professor sênior, com postura consultiva, visão prática e alto padrão de excelência.',
              'Execute a função Avaliacao com foco em gerar uma avaliação com gabarito e rubrica, equilibrada por nível de dificuldade.',
              'Entrada principal: tema informado pelo usuário. Use o contexto informado e complemente apenas com inferências explicitamente marcadas como premissas.',
              '',
              'Objetivo original a preservar: produzir uma avaliação sobre o tema com 10 questões, combinando múltipla escolha e discursivas, distribuídas por dificuldade fácil, média e difícil, com gabarito comentado e rubrica para correção das dissertativas.',
              '',
              'Método obrigatório:',
              '1. Reenquadre a demanda em uma frase clara, confirmando objetivo, público, restrições e resultado esperado.',
              '2. Liste premissas, lacunas de informação e perguntas críticas antes de concluir; quando faltar dado, indique como obtê-lo.',
              '3. Aplique raciocínio específico de avaliação educacional, evitando respostas genéricas. Mostre método profissional, visão crítica, aplicabilidade, critérios de qualidade, riscos e próximos passos.',
              '4. Priorize o que gera impacto, reduz risco ou aumenta qualidade, justificando as escolhas com critérios explícitos.',
              '5. Entregue uma avaliação pronta para uso, objetiva, acionável e adequada ao nível do público.',
              '',
              'Formato de saída:',
              '- Diagnóstico ou entendimento da demanda.',
              '- Pontos críticos, riscos e oportunidades.',
              '- Entrega principal estruturada: distribuição das 10 questões por dificuldade e tipo, prova completa, gabarito comentado e rubrica para as dissertativas.',
              '- Recomendações priorizadas com justificativa.',
              '- Próximas ações, responsáveis sugeridos, prazo ou ordem de execução e critério de sucesso.',
              '- Validações necessárias e limites da resposta.',
              '- Checklist curto para confirmar se a avaliação está pronta para aplicação.',
              '',
             'Critérios de qualidade: seja específico, completo, verificável, adaptado ao contexto e orientado a desempenho. Não use placeholders vagos quando puder propor conteúdo concreto. Sinalize premissas, lacunas e pontos que exigem validação humana. Mantenha precisão, ética profissional e rastreabilidade; não invente dados.'
           ].join('\n');
           const feedbackPrompt = [
             'Atue como um(a) Professor sênior, com postura consultiva, visão prática e alto padrão de excelência.',
             'Execute a função Feedback com foco em gerar feedback individual construtivo para alunos, produzindo uma devolutiva prática e motivadora.',
             'Entrada principal: dados de desempenho informados pelo usuário. Use o contexto informado e complemente apenas com inferências explicitamente marcadas como premissas.',
             '',
             'Objetivo original a preservar: atue como professor tutor. Com base no desempenho do aluno, escreva feedback individual com pontos fortes, pontos a desenvolver, sugestões de estudo e meta da próxima semana. Use linguagem acolhedora e objetiva.',
             '',
             'Método obrigatório:',
             '1. Reenquadre a demanda em uma frase clara, confirmando objetivo, público, restrições e resultado esperado.',
             '2. Liste premissas, lacunas de informação e perguntas críticas antes de concluir; quando faltar dado, indique como obtê-lo.',
             '3. Aplique raciocínio específico de tutoria e feedback formativo, evitando elogios ou críticas genéricas. Mostre método profissional, visão crítica, aplicabilidade, critérios de qualidade, riscos e próximos passos.',
             '4. Priorize o que gera mais impacto, reduz risco ou aumenta qualidade, justificando as escolhas com critérios explícitos.',
             '5. Entregue uma devolutiva pronta para uso, objetiva, acionável e adequada à idade e ao contexto do aluno.',
             '',
             'Formato de saída:',
             '- Diagnóstico ou entendimento da demanda.',
             '- Pontos críticos, riscos e oportunidades.',
             '- Feedback principal estruturado em: síntese acolhedora; pontos fortes com evidências; pontos a desenvolver em linguagem observável; sugestões de estudo específicas; meta da próxima semana com indicador verificável.',
             '- Recomendações priorizadas com justificativa.',
             '- Próximas ações, responsáveis sugeridos, prazo ou ordem de execução e critério de sucesso.',
             '- Validações necessárias e limites da resposta.',
             '- Checklist curto para confirmar se o feedback está pronto para ser entregue ao aluno.',
             '',
             'Critérios de qualidade: seja específico, completo, verificável, adaptado ao contexto e orientado a evolução. Não compare alunos, não rotule, não invente desempenho e não transforme a meta em punição. Sinalize premissas, lacunas e pontos que exigem validação humana. Mantenha precisão, ética profissional e rastreabilidade.'
           ].join('\n');
           const differentiatedActivityPrompt = [
             'Atue como um(a) Professor sênior, com postura consultiva, visão prática e alto padrão de excelência.',
             'Execute a função Atividade diferenciada com foco em adaptar uma atividade para níveis diferentes da turma, personalizando a proposta para inclusão e evolução.',
             'Entrada principal: atividade informada pelo usuário. Use o contexto informado e complemente apenas com inferências explicitamente marcadas como premissas.',
             '',
             'Objetivo original a preservar: dada a atividade-base, crie três versões: apoio, para alunos com dificuldade; padrão; e avançada. Para cada versão, descreva objetivo, instruções, critérios de sucesso e tempo estimado.',
             '',
             'Método obrigatório:',
             '1. Reenquadre a demanda em uma frase clara, confirmando objetivo, público, restrições e resultado esperado.',
             '2. Liste premissas, lacunas de informação e perguntas críticas antes de concluir; quando faltar dado, indique como obtê-lo.',
             '3. Aplique raciocínio específico de diferenciação pedagógica, evitando respostas genéricas. Mostre método profissional, visão crítica, aplicabilidade, critérios de qualidade, riscos e próximos passos.',
             '4. Priorize o que gera impacto, reduz risco ou aumenta qualidade, justificando as escolhas com critérios explícitos.',
             '5. Entregue uma resposta pronta para uso, organizada e adequada ao nível do usuário.',
             '',
             'Formato de saída:',
             '- Diagnóstico ou entendimento da demanda.',
             '- Pontos críticos, riscos e oportunidades.',
             '- Entrega principal em quadro com as versões apoio, padrão e avançada; cada uma deve conter objetivo, instruções, critérios de sucesso, tempo estimado, apoios ou extensões e forma de acompanhamento.',
             '- Recomendações priorizadas com justificativa.',
             '- Próximas ações, responsáveis sugeridos, ordem de execução e critério de sucesso.',
             '- Validações necessárias e limites da resposta.',
             '- Checklist curto para confirmar se as três versões estão prontas para aplicação.',
             '',
             'Critérios de qualidade: seja específico, completo, verificável, adaptado ao contexto e orientado a desempenho. Não use placeholders vagos quando puder propor conteúdo concreto. Sinalize premissas, lacunas e pontos que exigem validação humana. Mantenha precisão, ética profissional e rastreabilidade; não invente dados.'
           ].join('\n');

          function liaEscape(value) {
            return String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
          }
          function richText(value) {
            const safe = liaEscape(value).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
            return safe.split(/\n{2,}/).map(block => {
              const lines = block.split('\n');
              if (lines.every(line => /^\s*[-•]\s+/.test(line))) return `<ul>${lines.map(line => `<li>${line.replace(/^\s*[-•]\s+/,'')}</li>`).join('')}</ul>`;
              return `<p>${lines.join('<br>')}</p>`;
            }).join('');
          }
          function currentRole() {
            const role = typeof currentProfile !== 'undefined' ? currentProfile?.role : '';
            return role || (document.querySelector('[data-role="teacher"].active') ? 'pedagogical' : 'parent');
          }
          function userInitials() {
            try { return typeof currentUserInitials === 'function' ? currentUserInitials() : 'EU'; } catch { return 'EU'; }
          }
          function activeSection() {
            return document.querySelector('#appShell .content:not(.hidden)')?.id || 'parentView';
          }
          function currentSuggestions() {
            return suggestionsByRole[currentRole()] || suggestionsByRole.parent;
          }
          function renderSuggestions() {
            messagesEl.querySelector('.lia-suggestions')?.remove();
            const wrap = document.createElement('div');
            wrap.className = 'lia-suggestions';
            wrap.innerHTML = currentSuggestions().map(text => `<button class="lia-suggestion" type="button" data-lia-suggestion="${liaEscape(text.replace(/^\S+\s/,''))}">${liaEscape(text)}</button>`).join('');
            messagesEl.appendChild(wrap);
          }
          function render() {
            messagesEl.innerHTML = state.messages.map(message => `<article class="lia-message ${message.role === 'user' ? 'user' : 'assistant'}"><span class="lia-message-avatar" aria-hidden="true">${message.role === 'user' ? liaEscape(userInitials()) : '✦'}</span><div class="lia-bubble">${richText(message.content)}</div></article>`).join('');
            if (state.pending) messagesEl.insertAdjacentHTML('beforeend','<div class="lia-thinking"><span class="lia-thinking-dots"><i></i><i></i><i></i></span><span>LIA está pensando...</span></div>');
            renderSuggestions();
            messagesEl.scrollTop = messagesEl.scrollHeight;
            send.disabled = state.pending || !input.value.trim();
          }
          function resetConversation() {
            state.messages = [{ role:'assistant', content:'Olá! Eu sou a LIA 🤖✨, a assistente inteligente do BFR Conecta. Estou aqui para ajudar você com estudos, atividades, dúvidas e informações da escola. Como posso ajudar?' }];
            state.pending = false;
            render();
          }
           function openLia(prefill = '') {
             state.open = true;
             document.body.classList.add('lia-open');
             overlay.classList.add('is-open');
             overlay.inert = false;
             overlay.setAttribute('aria-hidden','false');
            if (!state.messages.length) resetConversation();
            if (prefill) { input.value = prefill; input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight,112)}px`; }
            render();
            setTimeout(() => input.focus(),80);
          }
           function closeLia() {
             state.open = false;
             document.body.classList.remove('lia-open');
             overlay.classList.remove('is-open');
             overlay.inert = true;
             overlay.setAttribute('aria-hidden','true');
          }
          function ensureHomeCard() {
            const view = document.getElementById('parentView');
            const welcome = view?.querySelector('.welcome');
            if (!view || !welcome || view.querySelector('.lia-home-card')) return;
            welcome.insertAdjacentHTML('afterend','<section class="lia-home-card"><div class="lia-home-copy"><span class="lia-home-icon" aria-hidden="true">✦</span><div><strong>Converse com a LIA</strong><span>Tem alguma dúvida? A assistente do BFR Conecta pode ajudar.</span></div></div><button class="lia-home-action" type="button" data-lia-open>Perguntar à LIA</button></section>');
          }
          function syncAvailability() {
            ensureHomeCard();
            const ready = document.getElementById('appShell')?.classList.contains('ready');
            fab.classList.toggle('hidden',!ready);
          }
            function contextForRequest(question = '') {
              const text = String(question).toLocaleLowerCase('pt-BR');
              const isCouncilClass = /conselho de classe|conselho participativo/.test(text);
              const isPdiAee = /\bpdi\b|plano de desenvolvimento individualizado|adaptação curricular|adaptacao curricular/.test(text);
              const isAdaptedActivity = /atividade adaptada|adaptar (uma )?atividade|adapte (uma )?atividade|acesso à tarefa|acesso a tarefa/.test(text);
              const isParentMeetingReport = /reunião de pais|reuniao de pais|reunião com a família|reuniao com a familia|relatório de acompanhamento individual|relatorio de acompanhamento individual|preparar (uma )?reunião|preparar (uma )?reuniao/.test(text);
              const isEvaluation = /gerar (uma )?avalia[cç][aã]o|gerar avaliacao|criar (uma )?avalia[cç][aã]o|criar (uma )?prova|prova com gabarito|gabarito e rubrica|avalia[cç][aã]o educacional|avaliacao educacional|avalia[cç][aã]o com gabarito/.test(text);
              const isDifferentiatedActivity = /atividade diferenciada|diferenciar (uma |a )?atividade|3 versões|3 versoes|versões de apoio|versoes de apoio|níveis diferentes da turma|niveis diferentes da turma/.test(text);
              const isFeedback = /gerar feedback|feedback individual|devolutiva pr[aá]tica|pontos a desenvolver|meta da pr[oó]xima semana/.test(text);
              const workflow = isFeedback ? 'feedback_individual' : isDifferentiatedActivity ? 'atividade_diferenciada' : isEvaluation ? 'avaliacao_educacional' : isParentMeetingReport ? 'relatorio_reuniao_pais' : isAdaptedActivity ? 'atividade_adaptada_aee' : isPdiAee ? 'pdi_aee' : isCouncilClass ? 'conselho_de_classe' : null;
              return { role:currentRole(), section:activeSection(), language:'pt-BR', workflow, workflowPrompt:isFeedback ? feedbackPrompt : isDifferentiatedActivity ? differentiatedActivityPrompt : isEvaluation ? evaluationAssessmentPrompt : isParentMeetingReport ? parentMeetingReportPrompt : isAdaptedActivity ? adaptedActivityAeePrompt : isPdiAee ? pdiAeePrompt : isCouncilClass ? councilClassPrompt : null, instruction:'Use somente dados autorizados. Se um dado escolar não estiver no contexto, diga que não está disponível.' };
            }
           async function remoteAnswer(question) {
             if (!endpoint || !supabaseClient || !currentUser) return null;
             const sessionResult = await supabaseClient.auth.getSession();
             const token = sessionResult?.data?.session?.access_token;
             if (!token) return null;
             const controller = new AbortController();
             const timeout = setTimeout(() => controller.abort(), 4000);
             let response;
             try {
                response = await fetch(endpoint,{ method:'POST', headers:{'Content-Type':'application/json',Authorization:`Bearer ${token}`,apikey:SUPABASE_PUBLISHABLE_KEY}, body:JSON.stringify({ messages:state.messages.slice(-12).map(item => ({role:item.role,content:item.content})), context:contextForRequest(question) }), signal:controller.signal });
             } finally {
               clearTimeout(timeout);
             }
             if (!response.ok) throw new Error(`LIA API ${response.status}`);
            const payload = await response.json();
            return typeof payload.message === 'string' && payload.message.trim() ? payload.message.trim() : null;
          }
          function localAnswer(question) {
            const text = question.toLocaleLowerCase('pt-BR');
            const role = currentRole();
            if (/^(oi|olá|ola|bom dia|boa tarde|boa noite)\b/.test(text)) return 'Olá! Que bom ter você aqui. Posso explicar conteúdos, ajudar a organizar os estudos e orientar sobre os recursos do BFR Conecta.';
            if (text.includes('revolução francesa')) return 'Claro! A Revolução Francesa começou em 1789, quando a população questionou a monarquia e os privilégios sociais. As ideias de liberdade e igualdade ganharam força e transformaram a política. Posso resumir, explicar de forma mais simples ou criar perguntas para você praticar.';
              if (text.includes('egito antigo')) return 'O Egito Antigo se desenvolveu às margens do rio Nilo. A agricultura, a organização do Estado, a religião e a escrita hieroglífica eram partes importantes daquela sociedade. Quer um resumo, uma linha do tempo ou um quiz?';
              if (/fraç|matemática|matematica/.test(text)) return 'Vamos por partes. Em Matemática, posso explicar o conceito com um exemplo, acompanhar seu raciocínio e depois propor um exercício parecido. Envie a questão ou diga qual assunto está estudando.';
              if (/gerar feedback|feedback individual|devolutiva pr[aá]tica|pontos a desenvolver|meta da pr[oó]xima semana/.test(text)) return 'Posso gerar uma devolutiva individual acolhedora e objetiva. Envie os dados de desempenho, produções ou evidências, pontos fortes, pontos a desenvolver, estratégias já tentadas, idade/ano e o prazo da próxima semana. Vou propor sugestões de estudo e uma meta verificável, sem comparar, rotular ou inventar informações.';
              if (/atividade diferenciada|diferenciar (uma |a )?atividade|3 versões|3 versoes|versões de apoio|versoes de apoio|níveis diferentes da turma|niveis diferentes da turma/.test(text)) return 'Posso diferenciar uma atividade em três versões sem perder o objetivo: apoio, padrão e avançada. Envie a atividade-base, ano/série, disciplina, objetivo, tempo, recursos e o que já sabe sobre os diferentes níveis da turma. Vou incluir instruções, critérios de sucesso, apoios, extensões e um checklist de aplicação, sinalizando as premissas.';
              if (/gerar (uma )?avalia[cç][aã]o|gerar avaliacao|criar (uma )?avalia[cç][aã]o|criar (uma )?prova|prova com gabarito|gabarito e rubrica|avalia[cç][aã]o educacional|avaliacao educacional|avalia[cç][aã]o com gabarito/.test(text)) return 'Posso gerar uma avaliação equilibrada com 10 questões, combinando múltipla escolha e discursivas, níveis fácil, médio e difícil, gabarito comentado e rubrica. Envie o tema, ano/série, disciplina, público, objetivo de aprendizagem, tempo, restrições e conteúdos que devem ou não entrar. Se algo faltar, vou marcar como premissa ou pedir confirmação antes da aplicação.';
              if (/reunião de pais|reuniao de pais|reunião com a família|reuniao com a familia|relatório de acompanhamento individual|relatorio de acompanhamento individual|preparar (uma )?reunião|preparar (uma )?reuniao/.test(text)) return 'Posso transformar suas observações em um relatório de acompanhamento para a reunião de pais, com linguagem de parceria e exemplos concretos. Envie o ano/série, as disciplinas, o desempenho, episódios observáveis de sala, os pontos de atenção, o que já foi tentado e o contexto conhecido da família. Vou organizar avanços, dificuldades sem rótulos, ações da escola, combinados realistas e um roteiro de 15 minutos. Não vou inventar dados, diagnosticar ou atribuir intenções.';
              if (/atividade adaptada|adaptar (uma )?atividade|adapte (uma )?atividade|acesso à tarefa|acesso a tarefa/.test(text)) return 'Posso adaptar uma atividade existente para um estudante com TDAH ou TEA sem reduzir o objetivo de aprendizagem. Envie a turma, a atividade original, o objetivo, o perfil autorizado do estudante, o que funciona ou dispara desregulação e os recursos e tempo disponíveis. Vou entregar análise de barreiras, atividade pronta, comprovação do objetivo mantido, estratégias de aplicação, avaliação por evidências alternativas e sugestões de DUA. Não vou usar estereótipos nem inventar dados.';
              if (/\bpdi\b|plano de desenvolvimento individualizado|adaptação curricular|adaptacao curricular/.test(text)) return 'Posso estruturar um PDI ou uma adaptação curricular para a equipe do AEE. Envie o perfil do estudante com as observações autorizadas, a série/ano, o componente curricular, os objetivos da turma e as dificuldades e potencialidades identificadas. Vou organizar objetivos prioritários, estratégias de flexibilização, materiais e avaliação, mediação e cronograma. Não vou inferir diagnóstico nem inventar dados.';
             if (/conselho de classe|conselho participativo/.test(text)) return 'Posso estruturar um conselho de classe orientado a decisões. Vou organizar o pré-conselho, a pauta com tempos, o roteiro de condução, critérios para casos críticos, a ata com responsáveis e prazos e a devolutiva. Para personalizar, envie o segmento, o número de turmas, o tempo por turma, os dados disponíveis, os problemas recorrentes e os participantes. Não vou inventar dados.';
             if (/nota|média|media|frequência|frequencia|atividade pendente|agenda|comunicado|ocorrência|ocorrencia/.test(text)) return 'Ainda não encontrei esse dado escolar conectado à conversa. Não vou inventar uma resposta. Abra o módulo correspondente no BFR Conecta ou peça à escola para disponibilizar essa informação à LIA.';
            if (role === 'pedagogical' && /crie|criar|elabore|atividade|questões|questoes|quiz|plano de aula/.test(text)) return 'Posso preparar um rascunho pedagógico. Envie a turma, a disciplina, o assunto, o nível de dificuldade e o tipo de atividade. Depois você poderá revisar antes de publicar no BFR Conecta.';
            if (/quiz|perguntas para praticar/.test(text)) return 'Posso criar um quiz interativo. Diga a disciplina, o assunto, a turma e quantas perguntas você quer. A LIA vai priorizar explicações, não apenas respostas.';
            if (/ajuda|socorro|não sei|nao sei/.test(text)) return 'Estou aqui para ajudar. Você pode enviar uma dúvida de matéria, uma atividade, uma pergunta sobre o BFR Conecta ou dizer se quer estudar, revisar ou fazer um quiz.';
            return 'Posso ajudar com estudos, atividades e informações do BFR Conecta. Para começar, diga a disciplina ou explique o que você precisa entender. Se a pergunta depender de um dado escolar, só responderei quando ele estiver disponível e autorizado.';
          }
          async function submitQuestion(question) {
            const value = question.trim();
            if (!value || state.pending) return;
            state.messages.push({role:'user',content:value});
            input.value = '';
            input.style.height = 'auto';
            state.pending = true;
            render();
            let answer = null;
             try { answer = await remoteAnswer(value); } catch { answer = null; }
            state.messages.push({role:'assistant',content:answer || localAnswer(value)});
            state.pending = false;
            render();
          }
          fab.addEventListener('click',() => openLia());
          document.addEventListener('click',event => {
            const openButton = event.target.closest('[data-lia-open]');
            const suggestion = event.target.closest('[data-lia-suggestion]');
            if (openButton) openLia();
            if (suggestion) submitQuestion(suggestion.dataset.liaSuggestion || suggestion.textContent.replace(/^\S+\s/,''));
            if (event.target === overlay) closeLia();
          });
          document.getElementById('liaClose')?.addEventListener('click',closeLia);
          form.addEventListener('submit',event => { event.preventDefault(); submitQuestion(input.value); });
          input.addEventListener('input',() => { input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight,112)}px`; send.disabled = state.pending || !input.value.trim(); });
          input.addEventListener('keydown',event => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); form.requestSubmit(); } });
          document.addEventListener('keydown',event => { if (event.key === 'Escape' && state.open) closeLia(); });
          const appShell = document.getElementById('appShell');
          if (appShell) new MutationObserver(syncAvailability).observe(appShell,{subtree:true,attributes:true,attributeFilter:['class']});
          resetConversation();
          syncAvailability();
        })();
      </script>
    <script id="bfr-product-enhancements">
      (() => {
         const liaAvatarPath = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><rect width="128" height="128" rx="28" fill="#1769d2"/><circle cx="64" cy="64" r="43" fill="#fff"/><text x="64" y="75" text-anchor="middle" font-family="Arial,sans-serif" font-size="27" font-weight="700" fill="#1769d2">LIA</text></svg>');
         const staffRoles = ['pedagogical','aee','coordinator','developer','director','secretary'];
         const managerRoles = ['coordinator','developer','director'];
        const readingLabels = { reads:'Lê com autonomia', difficulty:'Lê com dificuldade', not_yet:'Ainda não lê' };
        const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
        const appReady = () => document.getElementById('appShell')?.classList.contains('ready');
        const role = () => typeof currentProfile !== 'undefined' ? currentProfile?.role || '' : '';
        const user = () => typeof currentUser !== 'undefined' ? currentUser : null;
        const db = () => typeof supabaseClient !== 'undefined' ? supabaseClient : null;
        const activeView = () => document.querySelector('#appShell .content:not(.hidden)');
        const monthName = () => new Intl.DateTimeFormat('pt-BR',{month:'long'}).format(new Date());
         const className = item => item.class_label || (item.classes ? `${item.classes.year}º ano · ${item.classes.class_code}` : 'Turma não informada');
         const birthdayDay = item => String(item.birthday_day || item.birth_date?.slice(8,10) || '—').padStart(2,'0');
         const birthdayDateLabel = item => `${birthdayDay(item)} de ${monthName()}`;

        function injectStyles() {
          if (document.getElementById('bfr-product-enhancements-style')) return;
          const style = document.createElement('style'); style.id = 'bfr-product-enhancements-style';
          style.textContent = `
            .bfr-enhancement-panel{margin-top:18px;border:1px solid #dfe8f3;border-radius:17px;background:#fff;box-shadow:0 10px 26px rgba(43,67,115,.06);padding:18px}.bfr-enhancement-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.bfr-enhancement-head h2{margin:4px 0;color:#173b79;font:700 20px 'Playfair Display',serif}.bfr-enhancement-head p{margin:6px 0;color:#71809a;font-size:11px;line-height:1.45}.bfr-enhancement-chip{display:inline-flex;align-items:center;white-space:nowrap;border:1px solid #f0deb2;border-radius:999px;padding:7px 10px;color:#9b6d13;background:#fffaf0;font:10px 'DM Mono',monospace}.bfr-birthday-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:9px;margin-top:14px}.bfr-birthday-card{display:flex;align-items:center;gap:10px;padding:11px;border:1px solid #f0deb2;border-radius:12px;background:#fffaf0}.bfr-birthday-day{display:grid;place-items:center;width:40px;height:40px;flex:0 0 auto;border-radius:12px;color:#9b6d13;background:#ffe9aa;font:700 17px 'DM Mono',monospace}.bfr-birthday-card strong,.bfr-birthday-card span{display:block}.bfr-birthday-card strong{color:#6c5324;font-size:11px}.bfr-birthday-card span{margin-top:3px;color:#967b4a;font-size:9px}.bfr-birthday-type{margin-left:auto;color:#a78139;font:9px 'DM Mono',monospace}.bfr-staff-birthday-form{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid #f2e7c9}.bfr-staff-birthday-form select,.bfr-staff-birthday-form input,.bfr-reading-table select,.bfr-reading-table textarea,.bfr-avatar-builder button{border:1px solid #dbe5f1;border-radius:9px;padding:9px;color:#243856;background:#fff;font-size:11px}.bfr-staff-birthday-form select{flex:1 1 220px}.bfr-staff-birthday-form input{flex:0 1 145px}.bfr-reading-table{width:100%;margin-top:14px;border-collapse:collapse;font-size:11px}.bfr-reading-table th,.bfr-reading-table td{padding:10px 7px;border-top:1px solid #e7edf4;text-align:left;vertical-align:top}.bfr-reading-table th{color:#71809a;font:10px 'DM Mono',monospace;text-transform:uppercase}.bfr-reading-table td strong{display:block;color:#213656}.bfr-reading-table td small{display:block;margin-top:3px;color:#71809a}.bfr-reading-table select{min-width:180px}.bfr-reading-table textarea{width:100%;min-width:170px;min-height:44px;resize:vertical}.bfr-reading-save{border:0;border-radius:9px;padding:8px 10px;color:#fff;background:#1769d2;font-size:10px;font-weight:700}.bfr-reading-save:disabled{opacity:.55}.bfr-reading-status{margin-top:10px;color:#16826f;font-size:10px}.bfr-avatar-builder{display:grid;grid-template-columns:180px 1fr;gap:18px;align-items:center;margin-top:15px}.bfr-avatar-preview{display:grid;place-items:center;min-height:150px;border-radius:18px;background:linear-gradient(145deg,#edf5ff,#f6f0ff)}.bfr-avatar-art{position:relative;display:grid;place-items:center;width:105px;height:105px;border-radius:50%;border:5px solid #fff;box-shadow:0 10px 22px rgba(36,75,133,.18);font-size:48px}.bfr-avatar-art .hair{position:absolute;top:4px;font-size:37px;transform:translateY(-8px)}.bfr-avatar-art .shirt{position:absolute;bottom:-7px;font-size:33px}.bfr-avatar-art .face{position:relative;z-index:1;margin-top:10px}.bfr-avatar-options{display:grid;gap:11px}.bfr-avatar-options strong{display:block;margin-bottom:6px;color:#213656;font-size:11px}.bfr-avatar-option-row{display:flex;flex-wrap:wrap;gap:6px}.bfr-avatar-option-row button{min-width:38px;min-height:35px;padding:5px;font-size:19px}.bfr-avatar-option-row button.is-selected{border-color:#1769d2;background:#edf5ff;box-shadow:0 0 0 2px rgba(23,105,210,.12)}.bfr-avatar-save{width:max-content;border:0;border-radius:9px;padding:10px 13px;color:#fff;background:#1769d2;font-size:11px;font-weight:700}.bfr-resource-toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.bfr-resource-toolbar input,.bfr-resource-toolbar select{flex:1 1 190px;border:1px solid #dbe5f1;border-radius:9px;padding:10px;color:#243856;background:#fff;font-size:11px}.bfr-resource-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(235px,1fr));gap:10px;margin-top:14px}.bfr-resource-card{display:flex;flex-direction:column;gap:7px;padding:13px;border:1px solid #dfe8f3;border-radius:13px;background:#fbfdff}.bfr-resource-card h3{margin:0;color:#173b79;font-size:13px}.bfr-resource-card p{margin:0;color:#71809a;font-size:10px;line-height:1.45}.bfr-resource-meta{display:flex;justify-content:space-between;gap:8px;color:#1769d2;font:9px 'DM Mono',monospace}.bfr-resource-actions{display:flex;gap:6px;margin-top:auto;padding-top:5px}.bfr-resource-actions button{border:1px solid #cfe0fb;border-radius:8px;padding:8px 9px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:700}.bfr-resource-card.is-hidden{display:none}.lia-fab-avatar img,.lia-avatar img,.lia-message-avatar img,.lia-home-icon img{width:100%;height:100%;object-fit:cover;border-radius:inherit}.lia-fab-avatar,.lia-avatar,.lia-message-avatar,.lia-home-icon{overflow:hidden}
            @media(max-width:700px){.bfr-enhancement-head{display:block}.bfr-enhancement-chip{margin-top:8px}.bfr-avatar-builder{grid-template-columns:1fr}.bfr-avatar-preview{min-height:130px}.bfr-reading-table{display:block;overflow:auto}.bfr-reading-table select{min-width:150px}}
          `;
          style.textContent += `.bfr-direction-hero{padding:22px;border-radius:18px;color:#fff;background:linear-gradient(135deg,#10295f,#1769d2 65%,#24b7a1);box-shadow:0 16px 34px rgba(16,41,95,.18)}.bfr-direction-hero h1{margin:5px 0;font:700 clamp(25px,3vw,36px) 'Playfair Display',serif}.bfr-direction-hero p{max-width:640px;margin:7px 0 0;color:#d7eff0;font-size:12px;line-height:1.5}.bfr-direction-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:14px}.bfr-direction-kpi{padding:14px;border:1px solid #dfe8f3;border-radius:14px;background:#fff}.bfr-direction-kpi span,.bfr-direction-kpi small{display:block;color:#71809a;font-size:10px}.bfr-direction-kpi strong{display:block;margin:7px 0 3px;color:#1558bd;font-size:25px}.bfr-direction-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;margin-top:14px}.bfr-direction-list{display:grid;gap:8px;margin-top:12px}.bfr-direction-list article{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:11px;border:1px solid #e2eaf4;border-radius:11px;background:#fbfdff}.bfr-direction-list strong{display:block;color:#213656;font-size:11px}.bfr-direction-list small{display:block;margin-top:3px;color:#71809a;font-size:10px}.bfr-direction-status{border-radius:999px;padding:5px 8px;color:#16826f;background:#e8f7ef;font:9px 'DM Mono',monospace;white-space:nowrap}.bfr-direction-status.warning{color:#9b6d13;background:#fff4cf}.bfr-direction-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}.bfr-direction-actions button{border:1px solid #cfe0fb;border-radius:9px;padding:9px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:700}.bfr-direction-note{width:100%;min-height:100px;margin-top:11px;border:1px solid #dbe5f1;border-radius:10px;padding:10px;color:#243856;background:#fff;font:11px 'DM Sans',sans-serif;resize:vertical}.bfr-direction-save{margin-top:8px;border:0;border-radius:9px;padding:9px 11px;color:#fff;background:#1769d2;font-size:10px;font-weight:700}@media(max-width:900px){.bfr-direction-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.bfr-direction-grid{grid-template-columns:1fr}}@media(max-width:600px){.bfr-direction-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-direction-hero{padding:18px}}
            #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-direction-nav]{display:flex!important}`;
          style.textContent += '#appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-support-nav]{display:flex!important}';
          document.head.appendChild(style);
        }

        async function loadBirthdays() {
          if (!db() || !user()) return {students:[],staff:[],staffProfiles:[]};
          let students = [], staff = [], staffProfiles = [];
          const studentResult = await db().rpc('list_current_month_birthdays',{target_month:new Date().getMonth()+1});
          if (!studentResult.error) students = studentResult.data || [];
           if (staffRoles.includes(role())) {
             const staffResult = await db().rpc('bfr_list_staff_birthdays',{target_month:new Date().getMonth()+1});
             if (!staffResult.error) staff = (staffResult.data || []).map(item => ({...item,type:'Professor/equipe'}));
           }
          if (managerRoles.includes(role())) {
            const profilesResult = await db().from('profiles').select('id,full_name,role').in('role',staffRoles).order('full_name');
            if (!profilesResult.error) staffProfiles = profilesResult.data || [];
          }
          return {students,staff,staffProfiles};
        }

        function renderBirthdayPanel(data) {
          const entries = [...data.students.map(item => ({...item,type:'Aluno'})), ...data.staff];
           return `<section class="bfr-enhancement-panel" data-bfr-birthdays><div class="bfr-enhancement-head"><div><div class="eyebrow">Comunidade BFR · ${esc(monthName())}</div><h2>🎂 Aniversariantes do mês</h2><p>Uma celebração simples para valorizar estudantes, professores e equipe escolar.</p></div><span class="bfr-enhancement-chip">nome · turma · dia</span></div><div class="bfr-birthday-grid">${entries.length ? entries.map(item => `<article class="bfr-birthday-card"><span class="bfr-birthday-day" aria-label="Aniversário em ${esc(birthdayDateLabel(item))}">${birthdayDay(item)}</span><div><strong>${esc(item.full_name || item.official_name)}</strong><span>${esc(birthdayDateLabel(item))} · ${esc(item.class_label || (item.type === 'Aluno' ? className(item) : item.role || 'Equipe escolar'))}</span></div><small class="bfr-birthday-type">${esc(item.type)}</small></article>`).join('') : '<div class="project-empty">Nenhum aniversário cadastrado para este mês.</div>'}</div>${managerRoles.includes(role()) && data.staffProfiles.length ? `<form class="bfr-staff-birthday-form" data-bfr-staff-birthday-form><select name="profile_id" required><option value="">Cadastrar aniversário de professor/equipe</option>${data.staffProfiles.map(item => `<option value="${esc(item.id)}">${esc(item.full_name || 'Sem nome')} · ${esc(item.role)}</option>`).join('')}</select><input name="birth_date" type="date" required><button class="primary-button" type="submit">Salvar aniversário</button><span class="bfr-reading-status" data-bfr-birthday-status></span></form>` : ''}</section>`;
        }

         function injectBirthdayStyles() {
           if (document.getElementById('bfr-birthday-style')) return;
           const style = document.createElement('style');
           style.id = 'bfr-birthday-style';
           style.textContent = `
             .bfr-birthday-panel{position:relative;overflow:hidden;padding:0;border-color:#d9e7f4;background:#fbfdff;box-shadow:0 16px 36px rgba(32,68,116,.08)}
             .bfr-birthday-panel:before{content:'';position:absolute;top:-120px;right:-90px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(141,208,255,.24),transparent 68%);pointer-events:none}
             .bfr-birthday-hero{position:relative;display:flex;justify-content:space-between;gap:24px;padding:25px 25px 22px;background:linear-gradient(135deg,#f5faff,#fff 62%,#f4fbfa);border-bottom:1px solid #e4edf6}
             .bfr-birthday-kicker{display:flex;align-items:center;gap:7px;color:#1769d2;font:10px 'DM Mono',monospace;letter-spacing:.07em;text-transform:uppercase}
             .bfr-birthday-kicker i{width:7px;height:7px;border-radius:50%;background:#f0b429;box-shadow:0 0 0 4px rgba(240,180,41,.14)}
             .bfr-birthday-hero h2{margin:7px 0 0;color:#173b79;font:700 clamp(24px,3vw,34px) 'Playfair Display',serif;letter-spacing:-.025em}
             .bfr-birthday-hero h2 span{font-family:'DM Sans',sans-serif;font-size:.65em;color:#e0a315;vertical-align:12%}
             .bfr-birthday-hero p{max-width:620px;margin:8px 0 0;color:#6d7d93;font-size:12px;line-height:1.5}
             .bfr-birthday-hero-meta{position:relative;display:grid;align-content:center;justify-items:end;gap:11px;min-width:148px}
             .bfr-birthday-period{color:#71849b;font:10px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
             .bfr-birthday-total{display:flex;align-items:baseline;gap:7px;color:#1558bd;font:700 24px 'DM Mono',monospace}
             .bfr-birthday-total small{color:#71849b;font:10px 'DM Sans',sans-serif;line-height:1.25;text-align:right}
             .bfr-birthday-today{position:relative;margin:18px 25px 0;padding:17px;border:1px solid #f1dca2;border-radius:16px;background:linear-gradient(135deg,#fffaf0,#fff 72%);box-shadow:0 10px 22px rgba(187,142,38,.09);animation:bfrBirthdayIn .45s ease both}
             .bfr-birthday-today.hidden{display:none}
             .bfr-birthday-today-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
             .bfr-birthday-today-head strong{color:#8c6818;font:700 12px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase}
             .bfr-birthday-today-head span{color:#a78139;font-size:10px}
             .bfr-birthday-today-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
             .bfr-birthday-today-card{display:flex;align-items:center;gap:12px;padding:11px;border:1px solid rgba(240,205,124,.72);border-radius:13px;background:rgba(255,255,255,.72)}
             .bfr-birthday-today-card .bfr-birthday-person-avatar{width:52px;height:52px;flex-basis:52px}
             .bfr-birthday-today-card strong{display:block;color:#263f62;font-size:13px;line-height:1.2}
             .bfr-birthday-today-card span{display:block;margin-top:4px;color:#71809a;font-size:10px}
             .bfr-birthday-today-card small{display:block;margin-top:5px;color:#b47e16;font-size:10px}
             .bfr-birthday-filter-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:18px 25px 0;padding:9px;border:1px solid #e0e9f3;border-radius:13px;background:#fff}
             .bfr-birthday-filter-scroll{display:flex;gap:5px;overflow-x:auto;scrollbar-width:none}
             .bfr-birthday-filter-scroll::-webkit-scrollbar{display:none}
             .bfr-birthday-filter{min-height:32px;border:1px solid transparent;border-radius:9px;padding:7px 10px;color:#71809a;background:transparent;font-size:10px;font-weight:700;white-space:nowrap;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
             .bfr-birthday-filter:hover{color:#1558bd;background:#f1f7ff}
             .bfr-birthday-filter.is-active{border-color:#cfe0fb;color:#1558bd;background:#edf5ff}
             .bfr-birthday-search{display:flex;align-items:center;gap:7px;flex:0 1 230px;min-width:170px;border:1px solid #e0e9f3;border-radius:9px;padding:7px 9px;color:#8090a5;background:#fbfdff}
             .bfr-birthday-search span{font-size:13px}
             .bfr-birthday-search input{width:100%;min-width:0;border:0;outline:0;color:#243856;background:transparent;font:10px 'DM Sans',sans-serif}
             .bfr-birthday-search input::placeholder{color:#93a0b2}
             .bfr-birthday-results{padding:20px 25px 25px}
             .bfr-birthday-week + .bfr-birthday-week{margin-top:22px}
             .bfr-birthday-week-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:10px}
             .bfr-birthday-week-kicker{display:block;color:#1769d2;font:10px 'DM Mono',monospace;letter-spacing:.07em;text-transform:uppercase}
             .bfr-birthday-week-head h3{margin:4px 0 0;color:#23436d;font:700 17px 'Playfair Display',serif}
             .bfr-birthday-week-count{color:#8a98aa;font-size:10px;white-space:nowrap}
             .bfr-birthday-person-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}
             .bfr-birthday-person-card{position:relative;display:flex;min-width:0;min-height:206px;flex-direction:column;align-items:center;padding:14px 12px 13px;border:1px solid #e0e9f3;border-radius:17px;background:#fff;box-shadow:0 7px 18px rgba(43,67,115,.045);text-align:center;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;animation:bfrBirthdayCardIn .42s ease both}
             .bfr-birthday-person-card:hover{transform:translateY(-4px);border-color:#b8d2ee;box-shadow:0 15px 28px rgba(43,84,135,.12)}
             .bfr-birthday-person-top{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:29px}
             .bfr-birthday-day-number{display:inline-grid;place-items:center;min-width:37px;height:29px;padding:0 7px;border-radius:999px;color:#9b6d13;background:#fff3ce;font:700 15px 'DM Mono',monospace}
             .bfr-birthday-spark{color:#e0a315;font-size:13px}
             .bfr-birthday-person-avatar{display:grid;place-items:center;width:64px;height:64px;flex:0 0 64px;margin:9px 0 10px;border:3px solid #edf5fc;border-radius:50%;color:#1769d2;background:linear-gradient(145deg,#e7f3ff,#d7f4ee);font:700 17px 'DM Sans',sans-serif;overflow:hidden}
             .bfr-birthday-person-avatar img{display:block;width:100%;height:100%;object-fit:cover}
             .bfr-birthday-person-name{display:-webkit-box;min-height:34px;overflow:hidden;color:#213a60;font-size:12px;font-weight:800;line-height:1.35;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:2}
             .bfr-birthday-person-detail{display:block;min-height:15px;margin-top:6px;color:#71809a;font-size:10px;line-height:1.35;overflow-wrap:anywhere}
             .bfr-birthday-person-type{display:inline-flex;margin-top:auto;padding:5px 8px;border-radius:999px;color:#5e7897;background:#f0f6fc;font:9px 'DM Mono',monospace;letter-spacing:.02em}
             .bfr-birthday-empty{display:grid;place-items:center;min-height:190px;padding:25px;border:1px dashed #cbdceb;border-radius:16px;color:#71809a;background:#fbfdff;text-align:center}
             .bfr-birthday-empty strong{display:block;margin-top:8px;color:#365578;font-size:13px}
             .bfr-birthday-empty span{display:block;margin-top:4px;font-size:10px}
             .bfr-birthday-skeleton-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}
             .bfr-birthday-skeleton-card{height:206px;border-radius:17px;background:linear-gradient(100deg,#f0f5fa 30%,#fafcff 45%,#f0f5fa 60%);background-size:220% 100%;animation:bfrBirthdayShimmer 1.3s linear infinite}
             .bfr-birthday-admin-form{margin:0 25px 25px!important;border-top:1px solid #e5edf6!important;padding-top:18px!important}
             @keyframes bfrBirthdayIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
             @keyframes bfrBirthdayCardIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
             @keyframes bfrBirthdayShimmer{to{background-position:-220% 0}}
             @media(max-width:1100px){.bfr-birthday-person-grid,.bfr-birthday-skeleton-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
             @media(max-width:760px){.bfr-birthday-hero{display:block;padding:21px 18px 19px}.bfr-birthday-hero-meta{display:flex;align-items:center;justify-content:space-between;margin-top:16px}.bfr-birthday-total small{text-align:left}.bfr-birthday-today{margin:14px 18px 0;padding:14px}.bfr-birthday-filter-bar{display:block;margin:14px 18px 0;padding:8px}.bfr-birthday-filter-scroll{margin-bottom:8px}.bfr-birthday-search{max-width:none;min-width:0}.bfr-birthday-results{padding:17px 18px 20px}.bfr-birthday-person-grid,.bfr-birthday-skeleton-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-birthday-admin-form{margin:0 18px 20px!important}}
             @media(max-width:480px){.bfr-birthday-hero h2{font-size:26px}.bfr-birthday-hero p{font-size:11px}.bfr-birthday-person-grid,.bfr-birthday-skeleton-grid{grid-template-columns:1fr}.bfr-birthday-person-card{min-height:194px}.bfr-birthday-week-head{align-items:start;display:block}.bfr-birthday-week-count{display:block;margin-top:4px}.bfr-birthday-today-grid{grid-template-columns:1fr}}
             @media(prefers-reduced-motion:reduce){.bfr-birthday-today,.bfr-birthday-person-card,.bfr-birthday-skeleton-card{animation:none}.bfr-birthday-person-card{transition:none}}
            `;
            style.textContent += `.bfr-coord-birthday-compact{margin-top:14px;padding:15px 16px;border:1px solid #dfe8f3;border-radius:16px;background:linear-gradient(135deg,#fff,#f8fbff);box-shadow:0 8px 22px rgba(43,67,115,.055)}.bfr-coord-birthday-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.bfr-coord-birthday-head h2{margin:4px 0 2px;color:#173b79;font:700 19px 'Playfair Display',serif}.bfr-coord-birthday-period{color:#8190a4;font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.04em}.bfr-coord-birthday-open{border:1px solid #cfe0fb;border-radius:9px;padding:8px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:800;cursor:pointer}.bfr-coord-birthday-open:hover{border-color:#80b5f5;background:#e9f3ff}.bfr-coord-birthday-columns{display:grid;grid-template-columns:1.05fr 1fr;gap:10px;margin-top:13px}.bfr-coord-birthday-columns>div{min-width:0;padding:10px 11px;border:1px solid #e4ebf4;border-radius:12px;background:#fbfdff}.bfr-coord-birthday-columns>div>strong{display:block;color:#63738f;font:700 10px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase}.bfr-coord-birthday-columns ul{display:grid;gap:7px;margin:8px 0 0;padding:0;list-style:none}.bfr-coord-birthday-columns li{display:flex;justify-content:space-between;gap:10px;align-items:baseline;padding-top:7px;border-top:1px solid #edf1f6}.bfr-coord-birthday-columns li:first-child{padding-top:0;border-top:0}.bfr-coord-birthday-columns li strong{min-width:0;overflow:hidden;color:#263f62;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.bfr-coord-birthday-columns li span{flex:0 0 auto;color:#8593a6;font:9px 'DM Mono',monospace;text-align:right}.bfr-coord-birthday-empty{margin:8px 0 0;color:#8996a8;font-size:10px}@media(max-width:620px){.bfr-coord-birthday-head{display:block}.bfr-coord-birthday-open{margin-top:10px}.bfr-coord-birthday-columns{grid-template-columns:1fr}.bfr-coord-birthday-columns li{display:block}.bfr-coord-birthday-columns li span{display:block;margin-top:3px;text-align:left}}`;
            style.textContent += `.bfr-reading-filters{display:flex;flex-wrap:wrap;align-items:end;gap:10px;margin-top:16px;padding:12px;border:1px solid #e1eaf4;border-radius:12px;background:#f8fbff}.bfr-reading-filters label{display:grid;gap:5px;min-width:170px;color:#63738f;font-size:10px;font-weight:700}.bfr-reading-filters select{border:1px solid #dbe5f1;border-radius:9px;padding:9px;color:#243856;background:#fff;font-size:11px}.bfr-reading-selection{align-self:center;margin-left:auto;color:#1769d2;font:10px 'DM Mono',monospace}.bfr-reading-empty{padding:24px 10px!important;text-align:center!important;color:#71809a;font-size:11px}`;
           document.head.appendChild(style);
         }
         function birthdayCalendarInfo() {
           const now = new Date();
           const month = new Intl.DateTimeFormat('pt-BR',{month:'long'}).format(now);
           return { month, monthUpper:month.toLocaleUpperCase('pt-BR'), year:now.getFullYear(), day:now.getDate(), days:new Date(now.getFullYear(),now.getMonth()+1,0).getDate() };
         }
         const birthdayPanelState = { panel:null, entries:[], filter:'all', query:'' };
         function birthdayEntryName(item) { return item.full_name || item.official_name || 'Nome não informado'; }
         function birthdayEntryType(item) { return item.type || (item.role === 'pedagogical' ? 'Professor' : 'Equipe escolar'); }
         function birthdayEntryFilterType(item) { return item.type === 'Aluno' ? 'student' : item.role === 'pedagogical' ? 'teacher' : 'team'; }
         function birthdayEntryDetail(item) { return item.class_label || (item.type === 'Aluno' ? className(item) : item.role || 'Equipe escolar'); }
         function birthdayEntryPhoto(item) { return [item.photo_url,item.avatar_url,item.photo].find(value => typeof value === 'string' && /^(https?:|data:image\/)/i.test(value)) || ''; }
         function birthdayEntryInitials(item) { return birthdayEntryName(item).split(/\s+/).filter(Boolean).slice(0,2).map(part => part[0]).join('').toUpperCase() || 'BFR'; }
         function birthdayPersonMarkup(item, featured = false) {
           const name = birthdayEntryName(item);
           const photo = birthdayEntryPhoto(item);
           const avatar = photo ? `<span class="bfr-birthday-person-avatar"><img src="${esc(photo)}" alt="Foto de ${esc(name)}"></span>` : `<span class="bfr-birthday-person-avatar" aria-hidden="true">${esc(birthdayEntryInitials(item))}</span>`;
           return `<article class="${featured ? 'bfr-birthday-today-card' : 'bfr-birthday-person-card'}" data-birthday-entry data-birthday-type="${birthdayEntryFilterType(item)}" data-birthday-search="${esc(`${name} ${birthdayEntryDetail(item)} ${birthdayEntryType(item)}`.toLocaleLowerCase('pt-BR'))}">${featured ? `${avatar}<div><strong>${esc(name)}</strong><span>${esc(birthdayEntryDetail(item))} · ${esc(birthdayEntryType(item))}</span><small>Feliz aniversário! ✦</small></div>` : `<div class="bfr-birthday-person-top"><span class="bfr-birthday-day-number">${esc(birthdayDay(item))}</span><span class="bfr-birthday-spark" aria-hidden="true">✦</span></div>${avatar}<strong class="bfr-birthday-person-name">${esc(name)}</strong><span class="bfr-birthday-person-detail">${esc(birthdayEntryDetail(item))}</span><small class="bfr-birthday-person-type">${esc(birthdayEntryType(item))}</small>`}</article>`;
         }
         function birthdayWeekGroups(entries) {
           const calendar = birthdayCalendarInfo();
           const groups = [];
           for (let start = 1, index = 1; start <= calendar.days; start += 7, index += 1) {
             const end = Math.min(start + 6, calendar.days);
             const groupEntries = entries.filter(item => { const day = Number(birthdayDay(item)); return day >= start && day <= end; });
             if (groupEntries.length) groups.push({ index, start, end, entries:groupEntries });
           }
           return groups;
         }
         function renderBirthdayToday(panel, entries) {
           const todayEntries = entries.filter(item => Number(birthdayDay(item)) === birthdayCalendarInfo().day);
           const host = panel.querySelector('[data-bfr-birthday-today]');
           if (!host) return;
           host.classList.toggle('hidden', !todayEntries.length);
           host.innerHTML = todayEntries.length ? `<div class="bfr-birthday-today-head"><strong>🎂 Hoje é dia de comemorar!</strong><span>${todayEntries.length} celebração${todayEntries.length === 1 ? '' : 'ões'} hoje</span></div><div class="bfr-birthday-today-grid">${todayEntries.map(item => birthdayPersonMarkup(item,true)).join('')}</div>` : '';
         }
         function renderBirthdayResults(panel) {
           const results = panel.querySelector('[data-bfr-birthday-results]');
           if (!results) return;
           if (panel.dataset.birthdayLoading === 'true') { results.innerHTML = `<div class="bfr-birthday-skeleton-grid">${[1,2,3,4].map(() => '<div class="bfr-birthday-skeleton-card" aria-hidden="true"></div>').join('')}</div>`; return; }
           const query = birthdayPanelState.query.trim().toLocaleLowerCase('pt-BR');
           const filtered = birthdayPanelState.entries.filter(item => (birthdayPanelState.filter === 'all' || birthdayEntryFilterType(item) === birthdayPanelState.filter) && (!query || `${birthdayEntryName(item)} ${birthdayEntryDetail(item)} ${birthdayEntryType(item)}`.toLocaleLowerCase('pt-BR').includes(query)));
           const groups = birthdayWeekGroups(filtered);
           results.innerHTML = groups.length ? groups.map(group => `<section class="bfr-birthday-week"><div class="bfr-birthday-week-head"><div><span class="bfr-birthday-week-kicker">✦ ${group.index}ª semana</span><h3>${String(group.start).padStart(2,'0')} — ${String(group.end).padStart(2,'0')} de ${esc(birthdayCalendarInfo().month)}</h3></div><span class="bfr-birthday-week-count">${group.entries.length} aniversariante${group.entries.length === 1 ? '' : 's'}</span></div><div class="bfr-birthday-person-grid">${group.entries.map(item => birthdayPersonMarkup(item)).join('')}</div></section>`).join('') : '<div class="bfr-birthday-empty"><div aria-hidden="true" style="font-size:25px;color:#e0a315">✦</div><strong>Nenhum aniversariante encontrado</strong><span>Tente outro filtro ou termo de pesquisa.</span></div>';
         }
         function renderBirthdayAdminForm(panel, data) {
           if (!managerRoles.includes(role()) || !data.staffProfiles.length || panel.querySelector('[data-bfr-staff-birthday-form]')) return;
           panel.insertAdjacentHTML('beforeend', `<form class="bfr-staff-birthday-form bfr-birthday-admin-form" data-bfr-staff-birthday-form><select name="profile_id" required><option value="">Cadastrar aniversário de professor/equipe</option>${data.staffProfiles.map(item => `<option value="${esc(item.id)}">${esc(item.full_name || 'Sem nome')} · ${esc(item.role)}</option>`).join('')}</select><input name="birth_date" type="date" required><button class="primary-button" type="submit">Salvar aniversário</button><span class="bfr-reading-status" data-bfr-birthday-status></span></form>`);
         }
         function setupBirthdayPanel(panel, data) {
           if (!panel) return;
           const entries = [...(data.students || []).map(item => ({...item,type:'Aluno'})), ...(data.staff || [])];
           birthdayPanelState.panel = panel;
           birthdayPanelState.entries = entries;
           birthdayPanelState.filter = 'all';
           birthdayPanelState.query = '';
           panel.dataset.birthdayLoading = 'false';
           const calendar = birthdayCalendarInfo();
           panel.querySelector('[data-bfr-birthday-period]').textContent = `${calendar.monthUpper} · ${calendar.year}`;
           panel.querySelector('[data-bfr-birthday-total]').textContent = String(entries.length);
           panel.querySelector('[data-bfr-birthday-search]').value = '';
           renderBirthdayToday(panel, entries);
           renderBirthdayResults(panel);
           renderBirthdayAdminForm(panel, data);
           panel.querySelectorAll('[data-bfr-birthday-filter]').forEach(button => button.addEventListener('click', () => { birthdayPanelState.filter = button.dataset.birthdayFilter; panel.querySelectorAll('[data-bfr-birthday-filter]').forEach(item => { const active = item === button; item.classList.toggle('is-active',active); item.setAttribute('aria-pressed',String(active)); }); renderBirthdayResults(panel); }));
           panel.querySelector('[data-bfr-birthday-search]')?.addEventListener('input', event => { birthdayPanelState.query = event.target.value; renderBirthdayResults(panel); });
         }
          function renderBirthdayPanelModern(data) {
            const calendar = birthdayCalendarInfo();
            return `<section class="bfr-enhancement-panel bfr-birthday-panel" data-bfr-birthdays><div class="bfr-birthday-hero"><div><span class="bfr-birthday-kicker"><i aria-hidden="true"></i> Comunidade BFR</span><h2><span aria-hidden="true">🎉</span> Aniversariantes de ${esc(calendar.month)}</h2><p>Celebrando quem faz parte da nossa comunidade escolar.</p></div><div class="bfr-birthday-hero-meta"><span class="bfr-birthday-period" data-bfr-birthday-period>${calendar.monthUpper} · ${calendar.year}</span><strong class="bfr-birthday-total"><span data-bfr-birthday-total>0</span><small>aniversariantes<br>este mês</small></strong></div></div><div class="bfr-birthday-today hidden" data-bfr-birthday-today></div><div class="bfr-birthday-filter-bar" role="toolbar" aria-label="Filtrar aniversariantes"><div class="bfr-birthday-filter-scroll"><button class="bfr-birthday-filter is-active" type="button" data-bfr-birthday-filter data-birthday-filter="all" aria-pressed="true">Todos</button><button class="bfr-birthday-filter" type="button" data-bfr-birthday-filter data-birthday-filter="student" aria-pressed="false">Alunos</button><button class="bfr-birthday-filter" type="button" data-bfr-birthday-filter data-birthday-filter="teacher" aria-pressed="false">Professores</button><button class="bfr-birthday-filter" type="button" data-bfr-birthday-filter data-birthday-filter="team" aria-pressed="false">Equipe</button></div><label class="bfr-birthday-search"><span aria-hidden="true">⌕</span><input type="search" data-bfr-birthday-search placeholder="Pesquisar aniversariante..." aria-label="Pesquisar aniversariante"></label></div><div class="bfr-birthday-results" data-bfr-birthday-results>${data.loading ? '<div class="bfr-birthday-skeleton-grid"><div class="bfr-birthday-skeleton-card"></div><div class="bfr-birthday-skeleton-card"></div><div class="bfr-birthday-skeleton-card"></div><div class="bfr-birthday-skeleton-card"></div></div>' : ''}</div></section>`;
          }
          function birthdayCompactAge(item) {
            const value = item.birth_date || item.date_of_birth;
            if (!value) return '';
            const birth = new Date(`${value}T12:00:00`);
            const now = new Date();
            let age = now.getFullYear() - birth.getFullYear();
            if (now.getMonth() < birth.getMonth() || (now.getMonth() === birth.getMonth() && now.getDate() < birth.getDate())) age -= 1;
            return age > 0 && age < 120 ? `${age} anos` : '';
          }
          function renderBirthdayCompactPanel(data) {
            const calendar = birthdayCalendarInfo();
            const entries = [...(data.students || []).map(item => ({...item,type:'Aluno'})), ...(data.staff || [])].sort((a,b) => Number(birthdayDay(a)) - Number(birthdayDay(b)));
            const today = entries.filter(item => Number(birthdayDay(item)) === calendar.day);
             const upcoming = entries.filter(item => Number(birthdayDay(item)) > calendar.day).sort((a,b) => Number(birthdayDay(a)) - Number(birthdayDay(b))).reverse().slice(0,3);
            const line = item => `<li><strong>${esc(birthdayEntryName(item))}</strong><span>${esc(birthdayCompactAge(item) || birthdayEntryDetail(item))} · ${esc(birthdayDay(item))}/${String(new Date().getMonth() + 1).padStart(2,'0')}</span></li>`;
            const list = (items, empty) => items.length ? `<ul>${items.map(line).join('')}</ul>` : `<p class="bfr-coord-birthday-empty">${empty}</p>`;
            return `<section class="bfr-coord-birthday-compact" data-bfr-birthdays data-bfr-birthday-compact><div class="bfr-coord-birthday-head"><div><span class="bfr-coordination-label">Informação secundária</span><h2>🎂 Aniversariantes</h2><span class="bfr-coord-birthday-period">${esc(calendar.month)} · ${calendar.year}</span></div><button type="button" class="bfr-coord-birthday-open" data-birthday-compact-open>Ver todos</button></div><div class="bfr-coord-birthday-columns"><div><strong>Hoje</strong>${list(today,'Nenhum aniversário hoje.')}</div><div><strong>Próximos</strong>${list(upcoming,'Nenhum próximo aniversário neste mês.')}</div></div></section>`;
          }
          function setupBirthdayCompactPanel(panel, data) {
            if (!panel) return;
            const holder = document.createElement('div');
            holder.innerHTML = renderBirthdayCompactPanel(data);
            const next = holder.firstElementChild;
            panel.replaceWith(next);
            next.querySelector('[data-birthday-compact-open]')?.addEventListener('click', () => {
              const fullHolder = document.createElement('div');
              fullHolder.innerHTML = renderBirthdayPanelModern(data);
              const full = fullHolder.firstElementChild;
              next.replaceWith(full);
              setupBirthdayPanel(full, data);
            });
          }
          async function ensureBirthdays() {
             if (!appReady() || !db() || !user() || role() === 'director' || role() === 'parent') return;
            const view = activeView(); if (!view || view.querySelector('[data-bfr-birthdays]')) return;
             const anchor = view.id === 'coordinatorView'
               ? view.querySelector('[data-bfr-coordination-command]')
               : view.querySelector('.welcome,.teacher-welcome,.coordinator-welcome,.aee-hero,.monitor-welcome,.gate-welcome');
            if (!anchor) return;
            injectBirthdayStyles();
            const compact = view.id === 'coordinatorView' || view.id === 'parentView';
            anchor.insertAdjacentHTML('afterend',compact ? renderBirthdayCompactPanel({students:[],staff:[],staffProfiles:[],loading:true}) : renderBirthdayPanelModern({students:[],staff:[],staffProfiles:[],loading:true}));
            const panel = anchor.nextElementSibling;
            const data = await loadBirthdays();
            if (compact) setupBirthdayCompactPanel(panel, data);
            else setupBirthdayPanel(panel, data);
          }

        const avatarDefaults = {face:'🙂',hair:'🧑🏽‍🦱',shirt:'👕',skin:'#f4bd91'};
        let avatarState = {...avatarDefaults};
        function avatarData() { try { return JSON.parse(localStorage.getItem(`bfr-avatar-${user()?.id || 'student'}`)) || avatarDefaults; } catch { return avatarDefaults; } }
        function avatarArt(data) { return `<div class="bfr-avatar-art" style="background:${esc(data.skin)}"><span class="hair">${esc(data.hair)}</span><span class="face">${esc(data.face)}</span><span class="shirt">${esc(data.shirt)}</span></div>`; }
        function renderAvatarPanel() {
          avatarState = {...avatarDefaults,...avatarData()};
          const faces=['🙂','😎','🤓','🤩','😄','🧑‍🎨'], hairs=['🧑🏽‍🦱','👩🏽‍🦱','🧑🏻‍🎤','👩🏾‍🎤','🧑🏼‍🚀'], shirts=['👕','🧥','🥋','🎽'], skins=['#f4bd91','#d89462','#8d5524','#f7d7bd'];
          const optionRow = (name,items) => items.map(item => `<button type="button" class="${avatarState[name]===item?'is-selected':''}" data-avatar-option="${name}" data-avatar-value="${item}">${item}</button>`).join('');
          return `<section class="bfr-enhancement-panel" data-bfr-avatar-panel><div class="bfr-enhancement-head"><div><div class="eyebrow">Meu perfil · identidade do estudante</div><h2>✨ Crie seu avatar</h2><p>Escolha uma combinação divertida para deixar seu perfil mais parecido com você.</p></div><span class="bfr-enhancement-chip">salvo neste dispositivo</span></div><div class="bfr-avatar-builder"><div class="bfr-avatar-preview" data-avatar-preview>${avatarArt(avatarState)}</div><div class="bfr-avatar-options"><div><strong>Rosto</strong><div class="bfr-avatar-option-row">${optionRow('face',faces)}</div></div><div><strong>Cabelo</strong><div class="bfr-avatar-option-row">${optionRow('hair',hairs)}</div></div><div><strong>Roupa</strong><div class="bfr-avatar-option-row">${optionRow('shirt',shirts)}</div></div><div><strong>Tom de pele</strong><div class="bfr-avatar-option-row">${skins.map(item => `<button type="button" class="${avatarState.skin===item?'is-selected':''}" style="background:${item}" aria-label="Tom de pele" data-avatar-option="skin" data-avatar-value="${item}"></button>`).join('')}</div></div><button type="button" class="bfr-avatar-save" data-avatar-save>Salvar meu avatar</button><span class="bfr-reading-status" data-avatar-status></span></div></div></section>`;
        }
        function ensureStudentAvatar() {
          if (!appReady() || role() !== 'student') return;
          const view = document.getElementById('studentView'); if (!view || view.querySelector('[data-bfr-avatar-panel]')) return;
          const anchor = view.querySelector('.welcome'); if (anchor) anchor.insertAdjacentHTML('afterend',renderAvatarPanel());
        }

          const readingState = {loaded:false,rows:[],students:[],assisted:[],year:'',classCode:'',loading:false};
         async function loadReading() {
           if (!db() || !user()) return;
           readingState.year = ''; readingState.classCode = '';
           let ids = null;
          if (role() === 'parent') { const links = await db().from('guardian_students').select('student_id').eq('profile_id',user().id); ids = (links.data || []).map(item => item.student_id); if (!ids.length) return; }
          const studentsQuery = db().from('students').select('id,official_name,class_id,classes(year,class_code)').eq('active',true).order('official_name');
          const studentsResult = ids ? await db().from('students').select('id,official_name,class_id,classes(year,class_code)').in('id',ids).order('official_name') : await studentsQuery;
          readingState.students = studentsResult.data || [];
          const levelQuery = ids ? db().from('student_reading_levels').select('student_id,level,note,updated_at').in('student_id',ids) : db().from('student_reading_levels').select('student_id,level,note,updated_at');
          const levels = await levelQuery; readingState.rows = levels.data || []; readingState.loaded = true;
        }
         function readingClassEntries() {
           const classes = new Map();
           readingState.students.forEach(student => { const data = student.classes || {}; if (data.year == null || !data.class_code) return; const key = `${data.year}|${data.class_code}`; if (!classes.has(key)) classes.set(key,{year:String(data.year),code:String(data.class_code)}); });
           return [...classes.values()].sort((a,b) => Number(a.year) - Number(b.year) || a.code.localeCompare(b.code,'pt-BR'));
         }
         function readingStudentsForSelection() {
           return readingState.students.filter(student => { const data = student.classes || {}; return readingState.year && readingState.classCode && String(data.year) === String(readingState.year) && String(data.class_code) === String(readingState.classCode); });
         }
         function renderReadingPanel() {
           const editable = ['pedagogical','aee','coordinator','developer'].includes(role());
           const classEntries = readingClassEntries();
           const years = [...new Set(classEntries.map(item => item.year))];
           const classEntriesForYear = classEntries.filter(item => item.year === String(readingState.year));
           const selectedStudents = readingStudentsForSelection();
           const columns = editable ? 4 : 3;
           const rows = selectedStudents.map(student => { const item = readingState.rows.find(row => row.student_id === student.id) || {}; return `<tr><td><strong>${esc(student.official_name)}</strong><small>${esc(className(student))}</small></td><td>${editable ? `<select data-reading-level="${esc(student.id)}"><option value="">Ainda não informado</option>${Object.entries(readingLabels).map(([key,label]) => `<option value="${key}" ${item.level===key?'selected':''}>${label}</option>`).join('')}</select>` : `<span class="bfr-enhancement-chip">${esc(readingLabels[item.level] || 'Ainda não informado')}</span>`}</td><td>${editable ? `<textarea data-reading-note="${esc(student.id)}" placeholder="Observação para coordenação e família">${esc(item.note || '')}</textarea>` : `<small>${esc(item.note || 'Sem observação registrada.')}</small>`}</td>${editable ? `<td><button class="bfr-reading-save" type="button" data-reading-save="${esc(student.id)}">Salvar</button></td>` : ''}</tr>`; }).join('');
           const emptyMessage = !readingState.year || !readingState.classCode ? 'Selecione o ano e a turma para visualizar os alunos.' : 'Nenhum aluno encontrado nessa turma.';
           return `<section class="bfr-enhancement-panel" data-bfr-reading-panel><div class="bfr-enhancement-head"><div><div class="eyebrow">Acompanhamento pedagógico</div><h2>📖 Leitura dos alunos</h2><p>Escolha uma turma para registrar o nível de leitura e uma observação objetiva por estudante.</p></div><span class="bfr-enhancement-chip">${readingState.year && readingState.classCode ? `${selectedStudents.length} aluno${selectedStudents.length === 1 ? '' : 's'}` : 'selecione a turma'}</span></div><div class="bfr-reading-filters" role="group" aria-label="Selecionar ano e turma"><label>Ano<select data-reading-year aria-label="Selecionar ano"><option value="">Selecione o ano</option>${years.map(year => `<option value="${esc(year)}" ${String(readingState.year)===String(year)?'selected':''}>${esc(year)}º ano</option>`).join('')}</select></label><label>Turma<select data-reading-class aria-label="Selecionar turma" ${readingState.year ? '' : 'disabled'}><option value="">${readingState.year ? 'Selecione a turma' : 'Escolha o ano primeiro'}</option>${classEntriesForYear.map(item => `<option value="${esc(item.code)}" ${String(readingState.classCode)===String(item.code)?'selected':''}>Turma ${esc(item.code)}</option>`).join('')}</select></label>${readingState.year && readingState.classCode ? `<span class="bfr-reading-selection">${esc(readingState.year)}º ano · Turma ${esc(readingState.classCode)}</span>` : ''}</div><div style="overflow:auto"><table class="bfr-reading-table"><thead><tr><th>Aluno</th><th>Nível de leitura</th><th>Observação</th>${editable?'<th>Ação</th>':''}</tr></thead><tbody>${rows || `<tr><td colspan="${columns}" class="bfr-reading-empty">${emptyMessage}</td></tr>`}</tbody></table></div><div class="bfr-reading-status" data-reading-status></div></section>`;
         }
          function renderReadingAssistUsage() { const rows = readingState.assisted || []; return `<section class="bfr-enhancement-panel" data-bfr-reading-assist-usage><div class="bfr-enhancement-head"><div><div class="eyebrow">Acompanhamento sem diagnóstico</div><h2>🎧 Uso da Leitura Assistida</h2><p>Mostra somente o uso pedagógico registrado: livro, posição, percentual, tempo e última atualização.</p></div><span class="bfr-enhancement-chip">apoio pedagógico</span></div><div class="bfr-reading-table-wrap" style="overflow:auto"><table class="bfr-reading-table"><thead><tr><th>Aluno</th><th>Livro / posição</th><th>Progresso</th><th>Tempo ouvindo</th><th>Atualização</th></tr></thead><tbody>${rows.length ? rows.map(row => `<tr><td><strong>${esc(row.studentName || 'Aluno')}</strong><small>${esc(row.classLabel || '')}</small></td><td>${esc(row.assist_progress?.book || 'Nenhum registro')}</td><td>${row.assist_progress?.percentage != null ? `${Number(row.assist_progress.percentage)}%` : '—'}</td><td>${Math.round(Number(row.assist_seconds || 0) / 60)} min</td><td>${row.assist_updated_at ? new Date(row.assist_updated_at).toLocaleDateString('pt-BR') : '—'}</td></tr>`).join('') : '<tr><td colspan="5" class="bfr-reading-empty">Nenhum uso remoto da Leitura Assistida foi registrado ainda.</td></tr>'}</tbody></table></div></section>`; }
          async function loadReadingAssistUsage(view) { if (!db() || !readingState.students.length) return; try { const ids = readingState.students.map(student => student.id); const result = await db().from('student_reading_levels').select('student_id,assist_progress,assist_seconds,assist_updated_at').in('student_id',ids); if (result.error) return; readingState.assisted = (result.data || []).map(row => { const student = readingState.students.find(item => item.id === row.student_id); const classData = student?.classes || {}; return {...row,studentName:student?.official_name,classLabel:classData.year && classData.class_code ? `${classData.year}º ano · Turma ${classData.class_code}` : ''}; }); const panel = view.querySelector('[data-bfr-reading-assist-usage]'); if (panel) { const holder = document.createElement('div'); holder.innerHTML = renderReadingAssistUsage(); panel.replaceWith(holder.firstElementChild); } else { view.querySelector('[data-bfr-reading-panel]')?.insertAdjacentHTML('afterend',renderReadingAssistUsage()); } } catch {} }
          function refreshReadingPanel(panel) { const holder = document.createElement('div'); holder.innerHTML = renderReadingPanel(); const next = holder.firstElementChild; panel.replaceWith(next); bindReadingFilters(next); }
         function bindReadingFilters(panel) {
           panel.querySelector('[data-reading-year]')?.addEventListener('change', event => { readingState.year = event.target.value; readingState.classCode = ''; refreshReadingPanel(panel); });
           panel.querySelector('[data-reading-class]')?.addEventListener('change', event => { readingState.classCode = event.target.value; refreshReadingPanel(panel); });
         }
          async function ensureReadingPanel() {
             if (!appReady() || !db() || !user() || role() === 'director' || !['parent','coordinator','developer','pedagogical','aee'].includes(role()) || readingState.loading) return;
             const view = activeView();
             if (!view || view.id === 'parentView') {
               view?.querySelectorAll('[data-bfr-reading-panel],[data-bfr-reading-assist-usage]').forEach(panel => panel.remove());
               return;
             }
             if (view.querySelector('[data-bfr-reading-panel]')) return;
               readingState.loading = true;
               try {
                 await loadReading();
                 const anchor = view.id === 'parentView'
                   ? (view.querySelector('#weatherWidget') || view.querySelector('.welcome,.teacher-welcome,.coordinator-welcome,.aee-hero'))
                   : view.querySelector('.welcome,.teacher-welcome,.coordinator-welcome,.aee-hero');
                 if (anchor) { anchor.insertAdjacentHTML('afterend',renderReadingPanel()); bindReadingFilters(view.querySelector('[data-bfr-reading-panel]')); }
               await loadReadingAssistUsage(view);
             } finally { readingState.loading = false; }
          }

        const activities = [
          {subject:'Língua Portuguesa',grade:'6º–9º',title:'Notícia em três pistas',objective:'Localizar informações explícitas e organizar uma notícia curta.',online:'Leia o texto projetado, destaque título, data e fato principal e reorganize três pistas na ordem correta.',adaptation:'Use texto ampliado, leitura compartilhada e banco de palavras.'},
          {subject:'Língua Portuguesa',grade:'6º–9º',title:'Roteiro de podcast acessível',objective:'Planejar fala, sequência e revisão de um roteiro de até um minuto.',online:'Escolha um tema da escola, grave ou simule a abertura e revise o roteiro com marcadores visuais.',adaptation:'Ofereça modelo de frase, tempo adicional e opção de resposta em áudio.'},
          {subject:'Matemática',grade:'6º–7º',title:'Mercado das frações',objective:'Comparar frações e resolver situações de compra.',online:'Arraste ou anote preços fictícios, compare metades e quartos e explique uma escolha de compra.',adaptation:'Use imagens de alimentos, denominadores pequenos e material concreto.'},
          {subject:'Matemática',grade:'8º–9º',title:'Porcentagem na escola',objective:'Calcular porcentagens simples em situações do cotidiano escolar.',online:'Analise uma tabela de descontos e responda quatro desafios passo a passo.',adaptation:'Disponibilize tabela de apoio, calculadora e exemplo resolvido.'},
          {subject:'Ciências',grade:'6º–9º',title:'Sistema em equilíbrio',objective:'Relacionar hábitos, corpo e ambiente em uma cadeia de causa e efeito.',online:'Monte um mapa visual conectando sono, alimentação, movimento e atenção.',adaptation:'Permita selecionar imagens em vez de escrever e reduza a quantidade de conexões.'},
          {subject:'História',grade:'6º–9º',title:'Linha do tempo falante',objective:'Organizar acontecimentos históricos e explicar uma relação temporal.',online:'Coloque cinco cartões na linha do tempo e grave uma frase sobre cada marco.',adaptation:'Use cores para períodos e ofereça frases iniciadoras.'},
          {subject:'Geografia',grade:'6º–9º',title:'Mapa do território vivido',objective:'Identificar lugares, trajetos e elementos da paisagem local.',online:'Marque no mapa digital escola, casa, praça e um lugar importante da comunidade.',adaptation:'Use mapa impresso, símbolos prontos e apoio para orientação espacial.'},
          {subject:'Língua Inglesa',grade:'6º–9º',title:'Daily routine cards',objective:'Reconhecer vocabulário de rotina e montar uma sequência simples.',online:'Associe imagens às palavras e organize uma rotina usando cinco cartões em inglês.',adaptation:'Use áudio, repetição, imagens e apenas três cartões na primeira rodada.'},
          {subject:'Arte',grade:'6º–9º',title:'Cores que comunicam',objective:'Explorar cor, contraste e intenção em uma composição.',online:'Escolha uma emoção, selecione três cores e crie um cartaz digital com título.',adaptation:'Ofereça paleta pronta, modelos e possibilidade de colagem.'},
          {subject:'Educação Física',grade:'6º–9º',title:'Circuito de movimentos',objective:'Planejar uma sequência segura de movimentos e perceber o próprio ritmo.',online:'Escolha quatro movimentos, organize a ordem e registre como o corpo se sentiu.',adaptation:'Adapte amplitude, tempo, posição sentada e nível de apoio.'},
          {subject:'Projeto de Vida',grade:'6º–9º',title:'Meu próximo passo',objective:'Reconhecer uma meta possível e as etapas para realizá-la.',online:'Escolha uma meta escolar, divida em três passos e marque um apoio necessário.',adaptation:'Use pictogramas, escolhas fechadas e mediação individual.'},
          {subject:'Interdisciplinar',grade:'6º–9º',title:'Jornal da inclusão',objective:'Pesquisar uma barreira e propor uma solução acessível para a escola.',online:'Observe uma situação, registre a barreira e apresente uma solução em três quadros.',adaptation:'Aceite desenho, áudio, vídeo curto ou seleção de imagens.'}
        ];
        function activityDocument(item) { return `<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>${esc(item.title)}</title><style>body{font:16px Arial;color:#17233f;max-width:780px;margin:40px auto;line-height:1.5}h1{color:#173b79}h2{font-size:17px;border-bottom:1px solid #dbe5f1;padding-bottom:5px}li{margin:8px 0}.box{padding:15px;border:1px solid #dbe5f1;border-radius:10px;background:#f7fbff}@media print{body{margin:18mm}}</style></head><body><p>BFR Conecta · Atividade Adaptada Multidisciplinar AEE</p><h1>${esc(item.title)}</h1><p><strong>Componente:</strong> ${esc(item.subject)} · <strong>Ano:</strong> ${esc(item.grade)}</p><h2>Objetivo</h2><p>${esc(item.objective)}</p><h2>Modo online</h2><div class="box">${esc(item.online)}</div><h2>Adaptação pedagógica</h2><p>${esc(item.adaptation)}</p><h2>Resposta do estudante</h2><p style="height:180px;border-bottom:1px solid #9aa8bc">&nbsp;</p><script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script></body></html>`; }
        function openActivity(item) { const win = window.open('', '_blank', 'width=850,height=780'); if (!win) return; win.document.write(activityDocument(item)); win.document.close(); }
         function ensureAeeLibrary() {
           if (!appReady() || role() !== 'aee') return;
           const view = document.getElementById('aeeView'); if (!view || view.querySelector('[data-bfr-aee-library]')) return;
          const cards = activities.map((item,index) => `<article class="bfr-resource-card" data-bfr-resource-card data-subject="${esc(item.subject)}"><div class="bfr-resource-meta"><span>${esc(item.subject)}</span><span>${esc(item.grade)}</span></div><h3>${esc(item.title)}</h3><p>${esc(item.objective)}</p><div class="bfr-resource-actions"><button type="button" data-bfr-activity-online="${index}">Ver atividade online</button><button type="button" data-bfr-activity-print="${index}">Imprimir / PDF</button></div></article>`).join('');
           view.insertAdjacentHTML('beforeend',`<section class="bfr-enhancement-panel" data-bfr-aee-library><div class="bfr-enhancement-head"><div><div class="eyebrow">Recursos prontos · AEE</div><h2>📚 Atividades Adaptadas Multidisciplinares</h2><p>Atividades para consulta online, do 6º ao 9º ano, com possibilidades de adaptação e impressão.</p></div><span class="bfr-enhancement-chip">${activities.length} propostas</span></div><div class="bfr-resource-toolbar"><input type="search" data-bfr-resource-search placeholder="Buscar atividade ou componente" aria-label="Buscar atividade"><select data-bfr-resource-subject><option value="all">Todos os componentes</option>${[...new Set(activities.map(item=>item.subject))].map(item=>`<option>${esc(item)}</option>`).join('')}</select></div><div class="bfr-resource-grid" data-bfr-resource-grid>${cards}</div></section>`);
         }

         const aeeRosterState = { loaded:false, loading:false, error:'', rows:[] };
         function renderAeeRoster() { const panel = document.querySelector('[data-bfr-aee-roster]'); if (!panel) return; const grid = panel.querySelector('[data-bfr-aee-roster-grid]'); if (!grid) return; if (aeeRosterState.error) { grid.innerHTML = `<div class="project-empty">${esc(aeeRosterState.error)}</div>`; return; } const search = panel.querySelector('[data-aee-roster-search]')?.value.toLocaleLowerCase('pt-BR').trim() || ''; const classFilter = panel.querySelector('[data-aee-roster-class]')?.value || 'all'; const rows = aeeRosterState.rows.filter(row => { const haystack = `${row.name} ${row.observation} ${row.year} ${row.class_code}`.toLocaleLowerCase('pt-BR'); return (!search || haystack.includes(search)) && (classFilter === 'all' || `${row.year}${row.class_code}` === classFilter); }); grid.innerHTML = rows.length ? rows.map(row => `<article class="bfr-resource-card"><div class="bfr-resource-meta"><span>${esc(row.year)}º ano · Turma ${esc(row.class_code)}</span><span>AEE</span></div><h3>${esc(row.name)}</h3><p>${esc(row.observation)}</p></article>`).join('') : '<div class="project-empty">Nenhum aluno encontrado com esses filtros.</div>'; panel.querySelector('[data-aee-roster-count]').textContent = `${rows.length} aluno${rows.length === 1 ? '' : 's'}`; }
         async function ensureAeeRoster() { if (!appReady() || !db() || !user() || !['aee','developer'].includes(role()) || aeeRosterState.loading) return; const view = document.getElementById('aeeView'); if (!view || view.querySelector('[data-bfr-aee-roster]')) return; aeeRosterState.loading = true; const result = await db().from('aee_student_roster').select('id,student_id,year,class_code,observation,students(official_name)').eq('active',true).order('year').order('class_code').order('observation'); aeeRosterState.loading = false; aeeRosterState.loaded = true; if (result.error) { aeeRosterState.error = 'A lista AEE não pôde ser carregada. Verifique a permissão do perfil.'; } else { aeeRosterState.rows = (result.data || []).map(row => ({ name:row.students?.official_name || 'Aluno sem nome', year:row.year, class_code:row.class_code, observation:row.observation || 'AEE' })); } const classes = [...new Set(aeeRosterState.rows.map(row => `${row.year}${row.class_code}`))].sort(); const anchor = view.querySelector('[data-bfr-aee-library]') || view.querySelector('.aee-hero') || view.firstElementChild; const markup = `<section class="bfr-enhancement-panel" data-bfr-aee-roster><div class="bfr-enhancement-head"><div><div class="eyebrow">Cadastro protegido · AEE 2026</div><h2>🧩 Alunos acompanhados pelo AEE</h2><p>Lista oficial para uso da equipe autorizada. Observações internas não aparecem para contas de família.</p></div><span class="bfr-enhancement-chip" data-aee-roster-count>${aeeRosterState.rows.length} alunos</span></div><div class="bfr-resource-toolbar"><input type="search" data-aee-roster-search placeholder="Buscar aluno ou observação" aria-label="Buscar aluno AEE"><select data-aee-roster-class aria-label="Filtrar por turma"><option value="all">Todas as turmas</option>${classes.map(item => `<option value="${esc(item)}">${esc(item.slice(0,-1))}º ano · Turma ${esc(item.slice(-1))}</option>`).join('')}</select></div><div class="bfr-resource-grid" data-bfr-aee-roster-grid>${aeeRosterState.error ? `<div class="project-empty">${esc(aeeRosterState.error)}</div>` : ''}</div></section>`; if (anchor) anchor.insertAdjacentHTML('afterend', markup); const panel = view.querySelector('[data-bfr-aee-roster]'); panel?.querySelector('[data-aee-roster-search]')?.addEventListener('input', renderAeeRoster); panel?.querySelector('[data-aee-roster-class]')?.addEventListener('change', renderAeeRoster); renderAeeRoster(); }

         function enhanceLiaAvatar() {
          document.querySelectorAll('.lia-fab-avatar,.lia-avatar,.lia-home-icon').forEach(el => { if (!el.querySelector('img')) el.innerHTML = `<img src="${liaAvatarPath}" alt="Avatar da LIA">`; });
          document.querySelectorAll('.lia-message:not(.user) .lia-message-avatar').forEach(el => { if (!el.querySelector('img')) el.innerHTML = `<img src="${liaAvatarPath}" alt="LIA">`; });
        }

        document.addEventListener('click', event => {
          const avatarOption = event.target.closest('[data-avatar-option]');
          if (avatarOption) { avatarState[avatarOption.dataset.avatarOption] = avatarOption.dataset.avatarValue; const panel=avatarOption.closest('[data-bfr-avatar-panel]'); panel.querySelector('[data-avatar-preview]').innerHTML=avatarArt(avatarState); panel.querySelectorAll('[data-avatar-option]').forEach(b=>b.classList.toggle('is-selected',b.dataset.avatarValue===avatarState[b.dataset.avatarOption])); }
          if (event.target.closest('[data-avatar-save]')) { localStorage.setItem(`bfr-avatar-${user()?.id || 'student'}`,JSON.stringify(avatarState)); event.target.closest('[data-bfr-avatar-panel]').querySelector('[data-avatar-status]').textContent='Avatar salvo neste dispositivo.'; }
          const readingSave = event.target.closest('[data-reading-save]');
          if (readingSave) { const id=readingSave.dataset.readingSave, panel=readingSave.closest('[data-bfr-reading-panel]'), level=panel.querySelector(`[data-reading-level="${id}"]`).value; if (!level) { panel.querySelector('[data-reading-status]').textContent='Escolha um nível antes de salvar.'; return; } readingSave.disabled=true; db().from('student_reading_levels').upsert({student_id:id,level,note:panel.querySelector(`[data-reading-note="${id}"]`).value.trim(),updated_by:user().id,updated_at:new Date().toISOString()},{onConflict:'student_id'}).then(result=>{readingSave.disabled=false; panel.querySelector('[data-reading-status]').textContent=result.error?'Não foi possível salvar o nível de leitura.':'Registro de leitura salvo para coordenação e família.';}); }
          const online = event.target.closest('[data-bfr-activity-online]'); if (online) openActivity(activities[Number(online.dataset.bfrActivityOnline)]);
          const print = event.target.closest('[data-bfr-activity-print]'); if (print) openActivity(activities[Number(print.dataset.bfrActivityPrint)]);
        });
        document.addEventListener('submit', event => { const form=event.target.closest('[data-bfr-staff-birthday-form]'); if (!form) return; event.preventDefault(); db().rpc('bfr_set_staff_birthday',{target_profile:form.profile_id.value,birthday:form.birth_date.value}).then(result=>{form.querySelector('[data-bfr-birthday-status]').textContent=result.error?'Não foi possível salvar.':'Aniversário da equipe atualizado.'; if(!result.error) setTimeout(()=>location.reload(),500);}); });
        document.addEventListener('input', event => { if (event.target.matches('[data-bfr-resource-search]')) filterResources(); });
        document.addEventListener('change', event => { if (event.target.matches('[data-bfr-resource-subject]')) filterResources(); });
        function filterResources() { const panel=document.querySelector('[data-bfr-aee-library]'); if(!panel)return; const term=panel.querySelector('[data-bfr-resource-search]').value.toLocaleLowerCase('pt-BR'); const subject=panel.querySelector('[data-bfr-resource-subject]').value; panel.querySelectorAll('[data-bfr-resource-card]').forEach(card=>card.classList.toggle('is-hidden',Boolean((term&&!card.textContent.toLocaleLowerCase('pt-BR').includes(term))||(subject!=='all'&&card.dataset.subject!==subject)))); }
         window.ensureAeeRoster = ensureAeeRoster;
         let directionLoading = false;
        async function directionCount(query) { try { const result = await query; return result.error ? 0 : result.count || 0; } catch { return 0; } }
        async function loadDirectionMetrics() {
          const today = new Date().toISOString().slice(0,10);
          const [students,classes,staff,attendance,links,reading,requests,alerts] = await Promise.all([
            directionCount(db().from('students').select('id',{count:'exact',head:true}).eq('active',true)),
            directionCount(db().from('classes').select('id',{count:'exact',head:true})),
            directionCount(db().from('profiles').select('id',{count:'exact',head:true}).in('role',staffRoles)),
            directionCount(db().from('attendance').select('student_id',{count:'exact',head:true}).eq('attendance_date',today)),
            directionCount(db().from('aee_student_links').select('student_id',{count:'exact',head:true}).eq('status','active')),
            db().from('student_reading_levels').select('level'),
            db().from('secretary_requests').select('status').limit(300),
            directionCount(db().from('gate_entry_alerts').select('id',{count:'exact',head:true}).is('resolved_at',null))
          ]);
          const readingRows = reading.data || [];
          const requestRows = requests.data || [];
          const pending = requestRows.filter(item => ['received','in_review','awaiting_info','pending'].includes(item.status)).length;
          return {students,classes,staff,attendance,links,reading:readingRows.length,readingMissing:Math.max(0,students-readingRows.length),pending,alerts,birthdays:await loadBirthdays()};
        }
        function directionMarkup(metrics) {
          const birthdayEntries = [...(metrics.birthdays.students || []).map(item => ({name:item.official_name,detail:item.class_label || className(item),day:birthdayDay(item)})), ...(metrics.birthdays.staff || []).map(item => ({name:item.full_name,detail:'Professor/equipe',day:birthdayDay(item)}))].slice(0,6);
          const note = localStorage.getItem('bfr-direction-note') || '';
          return `<section class="bfr-enhancement-panel" id="bfrDirectionPanel" data-bfr-direction><div class="bfr-direction-hero"><div class="eyebrow" style="color:#bfe7e0">Gestão estratégica · BFR Conecta</div><h1>Direção escolar</h1><p>Uma visão rápida para acompanhar aprendizagem, presença, inclusão, comunicação e as prioridades da escola.</p></div><div class="bfr-direction-kpis"><div class="bfr-direction-kpi"><span>Alunos ativos</span><strong>${metrics.students}</strong><small>cadastro oficial</small></div><div class="bfr-direction-kpi"><span>Turmas</span><strong>${metrics.classes}</strong><small>ano letivo atual</small></div><div class="bfr-direction-kpi"><span>Equipe escolar</span><strong>${metrics.staff}</strong><small>perfis autorizados</small></div><div class="bfr-direction-kpi"><span>Presenças hoje</span><strong>${metrics.attendance}</strong><small>lançamentos registrados</small></div><div class="bfr-direction-kpi"><span>Vínculos AEE</span><strong>${metrics.links}</strong><small>acompanhamentos ativos</small></div></div><div class="bfr-direction-grid"><section class="panel" style="margin:0"><div class="eyebrow">Sinais para acompanhamento</div><h2 style="margin-top:4px">Atenção da gestão</h2><div class="bfr-direction-list"><article><div><strong>Leitura acompanhada</strong><small>${metrics.readingMissing ? `${metrics.readingMissing} aluno(s) ainda sem registro` : 'Todos os alunos possuem registro'}</small></div><span class="bfr-direction-status ${metrics.readingMissing?'warning':''}">${metrics.readingMissing?'revisar':'em dia'}</span></article><article><div><strong>Solicitações da secretaria</strong><small>${metrics.pending} solicitação(ões) aguardando análise</small></div><span class="bfr-direction-status ${metrics.pending?'warning':''}">${metrics.pending?'pendente':'em dia'}</span></article><article><div><strong>Alertas de entrada</strong><small>${metrics.alerts} alerta(s) ainda não resolvido(s)</small></div><span class="bfr-direction-status ${metrics.alerts?'warning':''}">${metrics.alerts?'revisar':'em dia'}</span></article></div><div class="bfr-direction-actions"><button type="button" data-direction-open="cadastro-alunos">Abrir cadastros</button><button type="button" data-direction-open="coordenacao">Ver coordenação</button><button type="button" data-direction-open="aee">Acompanhar AEE</button><button type="button" data-direction-open="comunicados">Publicar comunicado</button></div></section><section class="panel" style="margin:0"><div class="eyebrow">Pertencimento e comunidade</div><h2 style="margin-top:4px">Próximos aniversariantes</h2><div class="bfr-direction-list">${birthdayEntries.length ? birthdayEntries.map(item => `<article><div><strong>${esc(item.name)}</strong><small>${esc(item.detail)}</small></div><span class="bfr-direction-status">dia ${esc(item.day)}</span></article>`).join('') : '<div class="project-empty">Nenhum aniversário cadastrado neste mês.</div>'}</div></section></div><section class="panel" style="margin:14px 0 0"><div class="eyebrow">Registro interno da direção</div><h2 style="margin-top:4px">Prioridade da semana</h2><p class="agenda-intro">Anote uma decisão ou prioridade para consultar durante a gestão. Este registro fica neste dispositivo.</p><form data-direction-note-form><textarea class="bfr-direction-note" name="note" placeholder="Ex.: acompanhar a devolutiva das avaliações de leitura do 7º ano.">${esc(note)}</textarea><button class="bfr-direction-save" type="submit">Salvar prioridade</button><span class="bfr-reading-status" data-direction-note-status></span></form></section></section>`;
        }
        async function ensureDirectionPanel() {
           if (!appReady() || !db() || !user() || !['developer','director'].includes(role()) || directionLoading) return;
           const view = role() === 'director' ? document.getElementById('directorView') : document.getElementById('adminView'); if (!view || view.querySelector('[data-bfr-direction]')) return;
          directionLoading = true;
          const metrics = await loadDirectionMetrics();
          const anchor = view.querySelector('.teacher-welcome');
          if (anchor) anchor.insertAdjacentHTML('afterend',directionMarkup(metrics));
          directionLoading = false;
        }
        function setupDirectionNav() {
           const nav = document.querySelector('[data-direction-nav]'); if (!nav) return;
           const visible = ['developer','director'].includes(role()); nav.classList.toggle('hidden',!visible); if (!visible || nav.dataset.ready) return;
           nav.dataset.ready = 'true';
           nav.addEventListener('click', event => { event.preventDefault(); event.stopPropagation(); if (role() === 'director') setRole('director'); else document.querySelector('[data-section="administracao"]')?.click(); setTimeout(() => { ensureDirectionPanel(); setTimeout(() => document.getElementById('bfrDirectionPanel')?.scrollIntoView({behavior:'smooth',block:'start'}),350); },180); });
          const grid = document.querySelector('#mobileMoreMenu .mobile-more-grid');
          if (grid && !grid.querySelector('[data-direction-mobile]')) { const button=document.createElement('button'); button.type='button'; button.className='mobile-more-option'; button.dataset.directionMobile='true'; button.innerHTML='<span>🏫</span>Direção escolar'; button.addEventListener('click',()=>nav.click()); grid.appendChild(button); }
        }
        document.addEventListener('click', event => { const action=event.target.closest('[data-direction-open]'); if (action) document.querySelector(`[data-section="${action.dataset.directionOpen}"]`)?.click(); });
        document.addEventListener('submit', event => { const form=event.target.closest('[data-direction-note-form]'); if (!form) return; event.preventDefault(); localStorage.setItem('bfr-direction-note',form.note.value.trim()); form.querySelector('[data-direction-note-status]').textContent='Prioridade salva neste dispositivo.'; });
        let tries = 0;
         const timer = setInterval(() => { tries++; if (appReady() && db() && user()) { injectStyles(); setupDirectionNav(); const view = activeView(); const isAdminShell = view?.id === 'adminView'; if (!isAdminShell) { ensureDirectionPanel(); ensureBirthdays(); ensureReadingPanel(); ensureAeeLibrary(); } ensureStudentAvatar(); enhanceLiaAvatar(); } if (tries > 180) clearInterval(timer); }, 1200);
       })();
    </script>
    <script id="bfr-support-runtime">
      (() => {
        const supportRoles = ['parent','student','pedagogical','aee','coordinator','developer','secretary'];
         const staffRoles = ['pedagogical','aee','coordinator','developer','director','secretary'];
         const managerRoles = ['coordinator','developer','director'];
        const fallbackServices = [
          {name:'Psicologia',icon:'🧠',description:'Apoio e acompanhamento socioemocional no contexto escolar.'},
          {name:'Psicopedagogia',icon:'📚',description:'Apoio relacionado aos processos de aprendizagem e desenvolvimento escolar.'},
          {name:'AEE',icon:'♿',description:'Atendimento Educacional Especializado e apoio à inclusão.'},
          {name:'Assistência Social',icon:'🤝',description:'Orientação e apoio às famílias e estudantes em questões sociais.'},
          {name:'Fonoaudiologia',icon:'🗣️',description:'Apoio relacionado à comunicação e linguagem, quando disponível.'},
          {name:'Orientação Educacional',icon:'👥',description:'Acompanhamento e orientação relacionados à vida escolar.'},
          {name:'Outros apoios',icon:'❤️',description:'Outros serviços cadastrados pela escola.'}
        ];
        const state = {services:[],professionals:[],students:[],requests:[],appointments:[],messages:[],loading:false,loaded:false,selectedProfessional:null};
        const supportView = () => document.getElementById('supportView');
        const profile = () => typeof currentProfile !== 'undefined' ? currentProfile : null;
        const user = () => typeof currentUser !== 'undefined' ? currentUser : null;
        const db = () => typeof supabaseClient !== 'undefined' ? supabaseClient : null;
        const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
        const role = () => profile()?.role || '';
        const isStaff = () => staffRoles.includes(role());
        const isManager = () => managerRoles.includes(role());
        const dateTime = value => value ? new Date(value).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
        const dateOnly = value => value ? new Date(`${value}T12:00:00`).toLocaleDateString('pt-BR') : '—';
        const studentName = id => state.students.find(item => item.id === id)?.official_name || 'Aluno vinculado';
        const serviceName = id => state.services.find(item => item.id === id)?.name || 'Área de apoio';
        const professionalName = id => state.professionals.find(item => item.id === id)?.full_name || 'Equipe de apoio';
        const className = item => item?.classes ? `${item.classes.year}º ano · ${item.classes.class_code}` : 'Turma não informada';
        const statusLabels = {pending:'Pendente',in_review:'Em análise',scheduled:'Agendado',in_follow_up:'Em acompanhamento',completed:'Concluído',cancelled:'Cancelado'};
        const priorityLabels = {low:'Baixa',normal:'Normal',high:'Alta',urgent:'Urgente'};

        function supportStyles() {
          if (document.getElementById('bfr-support-style')) return;
          const style = document.createElement('style'); style.id = 'bfr-support-style';
          const navStyle = document.createElement('style'); navStyle.textContent = '#appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-support-nav]{display:flex!important}'; document.head.appendChild(navStyle);
          style.textContent = `.support-hero{display:flex;justify-content:space-between;gap:18px;align-items:flex-end;padding:24px;border:1px solid #dbe7f5;border-radius:20px;background:linear-gradient(135deg,#eef8f4,#fff 58%,#eef4ff);box-shadow:0 14px 34px rgba(37,82,145,.08)}.support-hero h1{margin-top:6px;color:#173b79;font-size:clamp(27px,3vw,40px);letter-spacing:-.8px}.support-hero p{max-width:700px;margin-top:8px;color:#63738f;line-height:1.55}.support-hero-badge{display:flex;gap:7px;align-items:center;white-space:nowrap;padding:9px 12px;border:1px solid #bde5d4;border-radius:999px;color:#16826f;background:#fff;font-size:10px;font-weight:700}.support-hero-badge i{width:8px;height:8px;border-radius:50%;background:#27b27a;box-shadow:0 0 0 4px #dcf8ea}.support-actions{display:flex;flex-wrap:wrap;gap:8px;margin:15px 0}.support-section-title{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.support-section-title h2{margin:4px 0;color:#173b79;font:700 20px 'Playfair Display',serif}.support-section-title p{margin:5px 0;color:#71809a;font-size:11px;line-height:1.45}.support-intro{margin:14px 0;color:#536783;font-size:12px;line-height:1.55}.support-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:14px}.support-card{display:flex;flex-direction:column;gap:7px;min-height:145px;padding:14px;border:1px solid #dfe8f3;border-radius:15px;background:#fff;box-shadow:0 8px 22px rgba(43,67,115,.05);transition:.2s}.support-card:hover{border-color:#9dd4c1;transform:translateY(-2px);box-shadow:0 12px 25px rgba(43,120,104,.1)}.support-card-icon{font-size:25px}.support-card h3{margin:0;color:#213656;font-size:13px}.support-card p{margin:0;color:#71809a;font-size:10px;line-height:1.45}.support-card button,.support-link-button{width:max-content;margin-top:auto;border:1px solid #cfe0fb;border-radius:8px;padding:8px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:700}.support-columns{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.support-list{display:grid;gap:8px;margin-top:12px}.support-list article{padding:12px;border:1px solid #e2eaf4;border-radius:12px;background:#fbfdff}.support-list-top{display:flex;justify-content:space-between;gap:9px;align-items:flex-start}.support-list strong{color:#213656;font-size:11px}.support-list small{color:#71809a;font-size:9px}.support-list p{margin:7px 0 0;color:#536783;font-size:10px;line-height:1.45}.support-status{display:inline-flex;align-items:center;border-radius:999px;padding:5px 8px;color:#1769d2;background:#edf5ff;font:9px 'DM Mono',monospace;white-space:nowrap}.support-status.warning{color:#9b6d13;background:#fff4cf}.support-status.success{color:#16826f;background:#e8f7ef}.support-professional-card{min-height:190px}.support-professional-avatar{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;color:#fff;background:linear-gradient(145deg,#24b7a1,#1769d2);font-weight:700}.support-form{display:grid;gap:10px;margin-top:13px}.support-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.support-form label{display:grid;gap:5px;color:#536783;font-size:10px;font-weight:700}.support-form input,.support-form select,.support-form textarea{width:100%;border:1px solid #dbe5f1;border-radius:9px;padding:10px;color:#243856;background:#fff;font-size:11px}.support-form textarea{min-height:72px;resize:vertical}.support-form .full{grid-column:1/-1}.support-form-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.support-form-status{color:#16826f;font-size:10px}.support-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:15px}.support-kpi{padding:13px;border:1px solid #dfe8f3;border-radius:14px;background:#fff}.support-kpi span,.support-kpi small{display:block;color:#71809a;font-size:10px}.support-kpi strong{display:block;margin:7px 0 3px;color:#1558bd;font-size:25px}.support-table-wrap{overflow:auto;margin-top:12px}.support-table{width:100%;border-collapse:collapse;font-size:10px}.support-table th,.support-table td{padding:9px 7px;border-top:1px solid #e7edf4;text-align:left;vertical-align:top}.support-table th{color:#71809a;font:9px 'DM Mono',monospace;text-transform:uppercase}.support-table td strong{display:block;color:#213656}.support-table td small{display:block;margin-top:3px;color:#71809a}.support-table select{border:1px solid #dbe5f1;border-radius:7px;padding:6px;font-size:10px}.support-modal{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:20px;background:rgba(12,28,58,.3)}.support-modal-card{width:min(560px,100%);max-height:calc(100vh - 40px);overflow:auto;padding:20px;border-radius:19px;background:#fff;box-shadow:0 28px 80px rgba(16,41,95,.27)}.support-modal-close{float:right;width:30px;height:30px;border:0;border-radius:9px;color:#526782;background:#eef4fb;font-size:20px}.support-modal-card h2{margin:8px 0;color:#173b79;font:700 23px 'Playfair Display',serif}.support-empty{padding:15px;border:1px dashed #cdd9e7;border-radius:12px;color:#71809a;background:#fbfdff;font-size:11px}.support-private-note{color:#8a6d31;font-size:9px}.support-dashboard-note{margin-top:11px;padding:10px;border-radius:10px;color:#526782;background:#f5f8fc;font-size:10px;line-height:1.45}@media(max-width:900px){.support-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.support-columns{grid-template-columns:1fr}.support-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.support-hero{display:block;padding:18px}.support-hero-badge{display:inline-flex;margin-top:13px}.support-grid{grid-template-columns:1fr}.support-form-grid{grid-template-columns:1fr}.support-form .full{grid-column:auto}.support-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}`;
          document.head.appendChild(style);
        }

        async function loadSupport() {
          if (!db() || !user() || state.loading) return;
          state.loading = true;
           const services = await db().from('support_services').select('id,name,icon,description,active,sort_order').eq('active',true).order('sort_order');
          state.services = services.error ? fallbackServices : (services.data || []);
           const professionals = await db().from('support_professionals').select('id,profile_id,full_name,profession,area,description,formation,schedule,location,audience,can_receive_requests,active').eq('active',true).order('full_name');
          state.professionals = professionals.data || [];
          let ids = [];
          if (role() === 'parent') {
            const links = await db().from('guardian_students').select('student_id').eq('profile_id',user().id);
            ids = (links.data || []).map(item => item.student_id);
          } else if (role() === 'student' && typeof studentDataState !== 'undefined' && studentDataState.student) ids = [studentDataState.student.id];
          const students = ids.length ? await db().from('students').select('id,official_name,class_id,classes(year,class_code)').in('id',ids).order('official_name') : isStaff() ? await db().from('students').select('id,official_name,class_id,classes(year,class_code)').eq('active',true).order('official_name') : {data:[],error:null};
          state.students = students.data || [];
           let requestQuery = db().from('support_requests').select('id,student_id,requester_id,source,service_id,professional_id,reason,description,priority,status,created_at,updated_at').order('created_at',{ascending:false}).limit(100);
          if (role() === 'parent') requestQuery = requestQuery.eq('requester_id',user().id);
          else if (role() === 'student') requestQuery = requestQuery.in('student_id',ids.length ? ids : ['00000000-0000-0000-0000-000000000000']);
          const requests = await requestQuery; state.requests = requests.data || [];
           let appointmentQuery = db().from('support_appointments').select('id,request_id,student_id,professional_id,starts_at,status,location,created_at').order('starts_at',{ascending:true}).limit(100);
          if (['parent','student'].includes(role())) appointmentQuery = appointmentQuery.in('student_id',ids.length ? ids : ['00000000-0000-0000-0000-000000000000']);
          const appointments = await appointmentQuery; state.appointments = appointments.data || [];
           let messageQuery = db().from('support_messages').select('id,request_id,student_id,sender_id,recipient_id,body,created_at').order('created_at',{ascending:false}).limit(50);
          if (role() === 'parent') messageQuery = messageQuery.or(`sender_id.eq.${user().id},recipient_id.eq.${user().id}`);
          const messages = await messageQuery; state.messages = messages.data || [];
          state.loaded = true; state.loading = false;
        }

        function initials(name) { return String(name || 'Apoio').split(/\s+/).filter(Boolean).map(item=>item[0]).slice(0,2).join('').toUpperCase(); }
        function serviceCards() { return state.services.map(service => `<article class="support-card"><span class="support-card-icon">${esc(service.icon || '🤝')}</span><h3>${esc(service.name)}</h3><p>${esc(service.description)}</p><button type="button" data-support-service="${esc(service.id || service.name)}">Conhecer serviço</button></article>`).join(''); }
        function professionalCards() { return state.professionals.length ? state.professionals.map((item,index) => `<article class="support-card support-professional-card"><span class="support-professional-avatar">${esc(initials(item.full_name))}</span><h3>${esc(item.full_name)}</h3><p><strong>${esc(item.profession)}</strong><br>${esc(item.area || 'Área de apoio escolar')}</p><p>${esc(item.description || 'Profissional disponível para conhecer e orientar a comunidade escolar.')}</p><button type="button" data-support-professional="${index}">Conhecer</button></article>`).join('') : '<div class="support-empty">A escola ainda não cadastrou profissionais. A administração poderá adicionar a equipe nesta área.</div>'; }
        function studentOptions() { return state.students.map(item => `<option value="${esc(item.id)}">${esc(item.official_name)} · ${esc(className(item))}</option>`).join(''); }
        function serviceOptions() { return state.services.map(item => `<option value="${esc(item.id || '')}">${esc(item.name)}</option>`).join(''); }
        function professionalOptions() { return `<option value="">Definir depois</option>${state.professionals.map(item => `<option value="${esc(item.id)}">${esc(item.full_name)} · ${esc(item.profession)}</option>`).join('')}`; }
        function requestCards() { return state.requests.length ? state.requests.map(item => `<article><div class="support-list-top"><div><strong>${esc(studentName(item.student_id))}</strong><small>${esc(serviceName(item.service_id))} · ${esc(dateTime(item.created_at))}</small></div><span class="support-status ${item.status==='completed'?'success':item.status==='pending'?'warning':''}">${esc(statusLabels[item.status] || item.status)}</span></div><p>${esc(item.reason)}${item.description ? ` · ${esc(item.description)}` : ''}</p><small>Prioridade: ${esc(priorityLabels[item.priority] || item.priority)} · Profissional: ${esc(professionalName(item.professional_id))}</small>${isStaff() ? `<div class="support-form-actions" style="margin-top:9px"><select data-support-status="${esc(item.id)}"><option value="pending" ${item.status==='pending'?'selected':''}>Pendente</option><option value="in_review" ${item.status==='in_review'?'selected':''}>Em análise</option><option value="scheduled" ${item.status==='scheduled'?'selected':''}>Agendado</option><option value="in_follow_up" ${item.status==='in_follow_up'?'selected':''}>Em acompanhamento</option><option value="completed" ${item.status==='completed'?'selected':''}>Concluído</option><option value="cancelled" ${item.status==='cancelled'?'selected':''}>Cancelado</option></select><select data-support-professional-select="${esc(item.id)}">${state.professionals.map(pro=>`<option value="${esc(pro.id)}" ${pro.id===item.professional_id?'selected':''}>${esc(pro.full_name)}</option>`).join('')}</select><button class="support-link-button" type="button" data-support-update-request="${esc(item.id)}">Atualizar</button></div>` : ''}</article>`).join('') : '<div class="support-empty">Nenhuma solicitação registrada ainda.</div>'; }
        function appointmentCards() { return state.appointments.length ? state.appointments.slice(0,12).map(item => `<article><div class="support-list-top"><div><strong>${esc(studentName(item.student_id))}</strong><small>${esc(dateTime(item.starts_at))}</small></div><span class="support-status">${esc(item.status || 'scheduled')}</span></div><p>${esc(professionalName(item.professional_id))} · ${esc(item.location || 'Local a confirmar')}</p></article>`).join('') : '<div class="support-empty">Nenhum atendimento agendado.</div>'; }

        function supportHome() {
          const appointmentForm = isStaff() ? `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Agenda protegida</div><h2>📅 Agendar atendimento</h2><p>O responsável verá somente atendimentos relacionados aos seus filhos.</p></div></div><form class="support-form" data-support-appointment-form><div class="support-form-grid"><label>Demanda<select name="request_id" required><option value="">Escolha uma demanda</option>${state.requests.map(item=>`<option value="${esc(item.id)}">${esc(studentName(item.student_id))} · ${esc(item.reason.slice(0,55))}</option>`).join('')}</select></label><label>Profissional<select name="professional_id">${professionalOptions()}</select></label><label>Data e hora<input name="starts_at" type="datetime-local" required></label><label>Local<input name="location" placeholder="Ex.: Sala de apoio"></label></div><div class="support-form-actions"><button class="primary-button" type="submit">Agendar</button><span class="support-form-status" data-support-appointment-status></span></div></form></section>` : '';
          const family = ['parent','student'].includes(role());
          const title = role()==='student' ? 'Meu Espaço de Apoio' : family ? 'Meu Espaço de Apoio' : isManager() ? 'Gestão do Espaço de Apoio' : 'Meu Espaço de Apoio';
          const supportAreas = [['🧠','Apoio emocional','Acolhimento e orientação para sentimentos, convivência e bem-estar.'],['📚','Apoio à aprendizagem','Estratégias para aprender, estudar e participar das atividades.'],['♿','Inclusão e acessibilidade','Apoios e adaptações para garantir participação e pertencimento.'],['🤝','Orientação social','Informações e encaminhamentos para estudantes e famílias.'],['🗣️','Comunicação e desenvolvimento','Apoio à linguagem, comunicação e expressão.'],['👥','Orientação educacional','Acompanhamento da vida escolar e dos próximos passos.']];
          const supportAreasMarkup = `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Acolhimento e orientação</div><h2>Como podemos ajudar?</h2><p>Escolha o tipo de apoio que deseja conhecer.</p></div></div><div class="support-grid">${supportAreas.map(item=>`<article class="support-card"><span class="support-card-icon">${item[0]}</span><h3>${esc(item[1])}</h3><p>${esc(item[2])}</p></article>`).join('')}</div></section>`;
          const requestForm = family ? `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Atendimento protegido</div><h2>➕ Solicitar atendimento</h2><p>A solicitação será analisada pela equipe. Ela não representa diagnóstico nem atendimento automático.</p></div></div><form class="support-form" data-support-request-form><div class="support-form-grid"><label>Área de apoio<select name="service_id" required><option value="">Escolha uma área</option>${serviceOptions()}</select></label><label>Aluno<select name="student_id" required><option value="">Escolha o aluno</option>${studentOptions()}</select></label><label>Prioridade<select name="priority"><option value="normal">Normal</option><option value="high">Alta</option><option value="urgent">Urgente</option></select></label><label>Profissional, se desejar<select name="professional_id">${professionalOptions()}</select></label><label class="full">Motivo da solicitação<textarea name="reason" required maxlength="500" placeholder="Conte brevemente o motivo da solicitação."></textarea></label></div><div class="support-form-actions"><button class="primary-button" type="submit">Enviar solicitação</button><span class="support-form-status" data-support-request-status></span></div></form></section>` : '';
          const referralForm = role()==='pedagogical' ? `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Apoio à equipe docente</div><h2>➕ Encaminhar aluno</h2><p>Envie somente informações necessárias à análise do profissional autorizado.</p></div></div><form class="support-form" data-support-referral-form><div class="support-form-grid"><label>Aluno<select name="student_id" required><option value="">Escolha o aluno</option>${studentOptions()}</select></label><label>Área de apoio<select name="service_id" required><option value="">Escolha uma área</option>${serviceOptions()}</select></label><label>Prioridade<select name="priority"><option value="normal">Normal</option><option value="high">Alta</option><option value="urgent">Urgente</option></select></label><label class="full">Motivo<textarea name="reason" required maxlength="500" placeholder="Ex.: dificuldade recorrente na realização das atividades."></textarea></label><label class="full">Descrição<textarea name="description" maxlength="1200" placeholder="Descreva a situação observada de forma objetiva."></textarea></label></div><div class="support-form-actions"><button class="primary-button" type="submit">Enviar encaminhamento</button><span class="support-form-status" data-support-referral-status></span></div></form></section>` : '';
          const managerForm = isManager() ? `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Configuração da equipe</div><h2>👥 Cadastrar profissional</h2><p>Adicione profissionais e deixe os serviços disponíveis para a comunidade.</p></div></div><form class="support-form" data-support-professional-form><div class="support-form-grid"><label>Nome<input name="full_name" required maxlength="160" placeholder="Nome do profissional"></label><label>Profissão/função<input name="profession" required maxlength="120" placeholder="Ex.: Psicóloga escolar"></label><label>Área de atuação<input name="area" maxlength="160" placeholder="Ex.: Acolhimento socioemocional"></label><label>Horário de atendimento<input name="schedule" maxlength="160" placeholder="Ex.: Terças, 8h às 12h"></label><label>Local<input name="location" maxlength="160" placeholder="Ex.: Sala de apoio"></label><label>Público atendido<input name="audience" maxlength="160" value="Estudantes e famílias"></label><label class="full">Descrição<textarea name="description" maxlength="600" placeholder="Como este profissional pode ajudar?"></textarea></label><label class="full">Formação e especialidade<textarea name="formation" maxlength="300" placeholder="Informações institucionais, sem dados sensíveis."></textarea></label></div><div class="support-form-actions"><button class="primary-button" type="submit">Cadastrar profissional</button><span class="support-form-status" data-support-professional-status></span></div></form><form class="support-form" data-support-service-form><div class="support-form-grid"><label>Nome do serviço<input name="name" required placeholder="Novo serviço de apoio"></label><label>Ícone<input name="icon" value="🤝" maxlength="4"></label><label class="full">Descrição<textarea name="description" required placeholder="Explique como o serviço ajuda."></textarea></label></div><button class="text-button" type="submit">Adicionar serviço</button><span class="support-form-status" data-support-service-status></span></form></section>` : '';
          const professionalForm = isStaff() && !isManager() ? `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Rotina do profissional</div><h2>📌 Registrar acompanhamento</h2><p>Registre apenas informações necessárias à sua atuação. Observações privadas ficam protegidas.</p></div></div><form class="support-form" data-support-followup-form><div class="support-form-grid"><label>Demanda<select name="request_id" required><option value="">Escolha uma demanda</option>${state.requests.map(item=>`<option value="${esc(item.id)}">${esc(studentName(item.student_id))} · ${esc(item.reason.slice(0,60))}</option>`).join('')}</select></label><label>Data de retorno<input name="return_date" type="date"></label><label class="full">Observação<textarea name="observation" required placeholder="Registro objetivo do acompanhamento."></textarea></label><label class="full">Orientação e próxima ação<textarea name="guidance" placeholder="Orientação compartilhável e próxima ação."></textarea></label></div><label class="support-private-note"><input type="checkbox" name="is_private" checked> Manter observação privada para a equipe autorizada</label><div class="support-form-actions"><button class="primary-button" type="submit">Salvar acompanhamento</button><span class="support-form-status" data-support-followup-status></span></div></form></section>` : '';
          return `<section class="support-hero"><div><div class="eyebrow" style="color:#5e8b72">BFR Conecta · Rede de cuidado</div><h1>🤝 ${esc(title)}</h1><p><strong>Cuidado, orientação e acompanhamento para nossos alunos.</strong><br>Na escola, cada aluno possui necessidades, desafios e formas diferentes de aprender. Conte com nossa equipe para apoiar o desenvolvimento, a aprendizagem, a inclusão e o bem-estar.</p></div><span class="support-hero-badge"><i></i> atendimento escolar protegido</span></section><div class="support-actions"><button class="primary-button" type="button" data-support-scroll="services">🤝 Conhecer serviços</button>${family ? '<button class="primary-button secondary-action" type="button" data-support-scroll="request">➕ Solicitar atendimento</button>' : ''}<button class="text-button" type="button" data-lia-open>✨ Perguntar à LIA</button></div><section class="panel" data-support-anchor="services"><div class="support-section-title"><div><div class="eyebrow">Acolhimento e orientação</div><h2>Como podemos ajudar?</h2><p>Conheça os serviços disponíveis e escolha o apoio mais adequado.</p></div></div><div class="support-grid">${serviceCards()}</div></section><section class="panel"><div class="support-section-title"><div><div class="eyebrow">Equipe escolar</div><h2>👥 Conheça nossos profissionais</h2><p>Profissionais e serviços cadastrados pela escola, com informações institucionais.</p></div></div><div class="support-grid">${professionalCards()}</div></section><div class="support-columns"><section class="panel" data-support-anchor="request"><div class="support-section-title"><div><div class="eyebrow">Acompanhamento</div><h2>${family ? '📋 Minhas solicitações' : '📋 Minhas demandas'}</h2></div><span class="support-status">${state.requests.length} registro(s)</span></div><div class="support-list">${requestCards()}</div></section><section class="panel"><div class="support-section-title"><div><div class="eyebrow">Agenda</div><h2>📅 Atendimentos</h2></div></div><div class="support-list">${appointmentCards()}</div></section></div>${requestForm}${referralForm}${professionalForm}${managerForm}<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Comunicação profissional</div><h2>💬 Mensagens</h2><p>Use este canal para comunicação escolar autorizada. Não é uma rede social.</p></div></div><form class="support-form" data-support-message-form><div class="support-form-grid"><label>Demanda<select name="request_id"><option value="">Mensagem geral</option>${state.requests.map(item=>`<option value="${esc(item.id)}">${esc(studentName(item.student_id))} · ${esc(item.reason.slice(0,50))}</option>`).join('')}</select></label><label>Destinatário<select name="recipient_id"><option value="">Equipe responsável</option>${state.professionals.filter(item=>item.profile_id).map(item=>`<option value="${esc(item.profile_id)}">${esc(item.full_name)} · ${esc(item.profession)}</option>`).join('')}</select></label><label class="full"><textarea name="body" required maxlength="2000" placeholder="Escreva uma mensagem objetiva e respeitosa."></textarea></label></div><button class="primary-button" type="submit">Enviar mensagem</button><span class="support-form-status" data-support-message-status></span></form>${state.messages.length ? `<div class="support-list">${state.messages.slice(0,6).map(item=>`<article><div class="support-list-top"><strong>Mensagem registrada</strong><small>${esc(dateTime(item.created_at))}</small></div><p>${esc(item.body)}</p></article>`).join('')}</div>` : ''}</section><div data-support-modal-host></div>`;
        }

        async function saveRequest(form,source) { const status=form.querySelector('[data-support-request-status],[data-support-referral-status]'); const studentId=form.student_id.value; if(!studentId){status.textContent='Escolha o aluno.';return;} status.textContent='Enviando...'; const result=await db().from('support_requests').insert({student_id:studentId,requester_id:user().id,source,service_id:form.service_id.value||null,professional_id:form.professional_id?.value||null,reason:form.reason.value.trim(),description:form.description?.value.trim()||'',priority:form.priority.value,status:'pending'}); status.textContent=result.error?'Não foi possível enviar a solicitação.':'Solicitação enviada para análise.'; if(!result.error){form.reset();state.loaded=false;await loadSupport();render();} }
        async function updateRequest(button) { const id=button.dataset.supportUpdateRequest; const panel=button.closest('article'); const result=await db().from('support_requests').update({status:panel.querySelector(`[data-support-status="${id}"]`).value,professional_id:panel.querySelector(`[data-support-professional-select="${id}"]`).value||null,updated_at:new Date().toISOString()}).eq('id',id); button.textContent=result.error?'Erro':'Atualizado'; if(!result.error){state.loaded=false;await loadSupport();render();} }
        async function saveProfessional(form) { const status=form.querySelector('[data-support-professional-status]'); const result=await db().from('support_professionals').insert({full_name:form.full_name.value.trim(),profession:form.profession.value.trim(),area:form.area.value.trim(),description:form.description.value.trim(),formation:form.formation.value.trim(),schedule:form.schedule.value.trim(),location:form.location.value.trim(),audience:form.audience.value.trim(),created_by:user().id}); status.textContent=result.error?'Não foi possível cadastrar.':'Profissional cadastrado.'; if(!result.error){state.loaded=false;await loadSupport();render();} }
        async function saveService(form) { const status=form.querySelector('[data-support-service-status]'); const result=await db().from('support_services').insert({name:form.name.value.trim(),icon:form.icon.value.trim()||'🤝',description:form.description.value.trim(),created_by:user().id,sort_order:state.services.length+1}); status.textContent=result.error?'Não foi possível adicionar.':'Serviço adicionado.'; if(!result.error){state.loaded=false;await loadSupport();render();} }
        async function saveFollowup(form) { const request=state.requests.find(item=>item.id===form.request_id.value); const status=form.querySelector('[data-support-followup-status]'); if(!request){status.textContent='Escolha uma demanda.';return;} const professional=state.professionals.find(item=>item.profile_id===user().id); const result=await db().from('support_follow_ups').insert({request_id:request.id,student_id:request.student_id,professional_id:professional?.id||null,observation:form.observation.value.trim(),guidance:form.guidance.value.trim(),next_action:form.guidance.value.trim(),return_date:form.return_date.value||null,is_private:form.is_private.checked,created_by:user().id}); status.textContent=result.error?'Não foi possível salvar o acompanhamento.':'Acompanhamento registrado.'; if(!result.error){form.reset();} }
        async function saveAppointment(form) { const request=state.requests.find(item=>item.id===form.request_id.value); const status=form.querySelector('[data-support-appointment-status]'); if(!request){status.textContent='Escolha uma demanda.';return;} const result=await db().from('support_appointments').insert({request_id:request.id,student_id:request.student_id,professional_id:form.professional_id.value||null,starts_at:new Date(form.starts_at.value).toISOString(),location:form.location.value.trim(),created_by:user().id}); status.textContent=result.error?'Não foi possível agendar.':'Atendimento agendado.'; if(!result.error){state.loaded=false;await loadSupport();render();} }
        async function saveMessage(form) { const ids=state.students.map(item=>item.id); const studentId=state.requests.find(item=>item.id===form.request_id.value)?.student_id || ids[0]; const status=form.querySelector('[data-support-message-status]'); if(!studentId){status.textContent='Associe a mensagem a um aluno.';return;} const result=await db().from('support_messages').insert({request_id:form.request_id.value||null,student_id:studentId,sender_id:user().id,recipient_id:form.recipient_id.value||null,body:form.body.value.trim()}); status.textContent=result.error?'Não foi possível enviar.':'Mensagem enviada.'; if(!result.error){form.reset();state.loaded=false;await loadSupport();render();} }
        function openProfessional(index) { const item=state.professionals[index]; if(!item)return; state.selectedProfessional=item.id; const root=supportView(); const modal=root.querySelector('[data-support-modal-host]'); modal.innerHTML=`<div class="support-modal" data-support-modal><section class="support-modal-card"><button class="support-modal-close" type="button" data-support-modal-close>×</button><div class="support-professional-avatar">${esc(initials(item.full_name))}</div><h2>${esc(item.full_name)}</h2><p><strong>${esc(item.profession)}</strong> · ${esc(item.area || 'Área de apoio escolar')}</p><p>${esc(item.description || 'Informações institucionais do profissional.')}</p><div class="support-dashboard-note"><strong>Formação e especialidade:</strong><br>${esc(item.formation || 'Informação não cadastrada.')}<br><br><strong>Atendimento:</strong> ${esc(item.schedule || 'A combinar')} · ${esc(item.location || 'Local a confirmar')}<br><strong>Público:</strong> ${esc(item.audience || 'Estudantes e famílias')}</div>${item.can_receive_requests ? '<button class="primary-button" type="button" data-support-modal-request>Solicitar atendimento</button>' : ''}</section></div>`; }
        function renderSupportAreas() { const items=[['🧠','Apoio emocional','Acolhimento e orientação para sentimentos, convivência e bem-estar.'],['📚','Apoio à aprendizagem','Estratégias para aprender, estudar e participar das atividades.'],['♿','Inclusão e acessibilidade','Apoios e adaptações para garantir participação e pertencimento.'],['🤝','Orientação social','Informações e encaminhamentos para estudantes e famílias.'],['🗣️','Comunicação e desenvolvimento','Apoio à linguagem, comunicação e expressão.'],['👥','Orientação educacional','Acompanhamento da vida escolar e dos próximos passos.']]; return `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Acolhimento e orientação</div><h2>Como podemos ajudar?</h2><p>Escolha o tipo de apoio que deseja conhecer.</p></div></div><div class="support-grid">${items.map(item=>`<article class="support-card"><span class="support-card-icon">${item[0]}</span><h3>${esc(item[1])}</h3><p>${esc(item[2])}</p></article>`).join('')}</div></section>`; }
        function renderAppointmentForm() { return isStaff() ? `<section class="panel"><div class="support-section-title"><div><div class="eyebrow">Agenda protegida</div><h2>📅 Agendar atendimento</h2><p>O responsável verá somente atendimentos relacionados aos seus filhos.</p></div></div><form class="support-form" data-support-appointment-form><div class="support-form-grid"><label>Demanda<select name="request_id" required><option value="">Escolha uma demanda</option>${state.requests.map(item=>`<option value="${esc(item.id)}">${esc(studentName(item.student_id))} · ${esc(item.reason.slice(0,55))}</option>`).join('')}</select></label><label>Profissional<select name="professional_id">${professionalOptions()}</select></label><label>Data e hora<input name="starts_at" type="datetime-local" required></label><label>Local<input name="location" placeholder="Ex.: Sala de apoio"></label></div><div class="support-form-actions"><button class="primary-button" type="submit">Agendar</button><span class="support-form-status" data-support-appointment-status></span></div></form></section>` : ''; }
        function render() { const root=supportView(); if(!root)return; root.innerHTML=supportHome(); const hero=root.querySelector('.support-hero'); if(hero&&isStaff())hero.insertAdjacentHTML('afterend',`<div class="support-kpis"><div class="support-kpi"><span>Solicitações pendentes</span><strong>${state.requests.filter(item=>item.status==='pending'||item.status==='in_review').length}</strong><small>para analisar</small></div><div class="support-kpi"><span>Atendimentos hoje</span><strong>${state.appointments.filter(item=>item.starts_at?.slice(0,10)===new Date().toISOString().slice(0,10)).length}</strong><small>na agenda</small></div><div class="support-kpi"><span>Acompanhamentos ativos</span><strong>${state.requests.filter(item=>item.status==='in_follow_up').length}</strong><small>em andamento</small></div><div class="support-kpi"><span>Encaminhamentos</span><strong>${state.requests.filter(item=>item.source==='teacher').length}</strong><small>vindos de professores</small></div></div>`); const services=root.querySelector('[data-support-anchor="services"]'); if(services)services.insertAdjacentHTML('beforebegin',renderSupportAreas()); const columns=root.querySelector('.support-columns'); if(columns&&isStaff())columns.insertAdjacentHTML('afterend',renderAppointmentForm()); const requestPanel=root.querySelector('[data-support-anchor="request"]'); if(requestPanel){requestPanel.querySelector('.support-section-title')?.insertAdjacentHTML('beforeend','<select data-support-filter aria-label="Filtrar demandas"><option value="all">Todas</option><option value="pending">Pendentes</option><option value="in_review">Em análise</option><option value="scheduled">Agendadas</option><option value="in_follow_up">Em acompanhamento</option><option value="completed">Concluídas</option></select>');} }
        async function openSupport() { if(!supportRoles.includes(role()) || !db() || !user()) return; supportStyles(); const root=supportView(); document.querySelectorAll('.content').forEach(view=>view.classList.add('hidden')); root.classList.remove('hidden'); document.querySelectorAll('.nav-item[data-section]').forEach(item=>item.classList.toggle('active',item.dataset.section==='apoio')); const crumb=document.querySelector('.breadcrumb b'); if(crumb)crumb.textContent='Espaço de Apoio'; if(!state.loaded)await loadSupport(); render(); }
        function setupSupportNav() { const nav=document.querySelector('[data-support-nav]'); if(!nav)return; const visible=supportRoles.includes(role()); nav.classList.toggle('hidden',!visible); if(!visible||nav.dataset.ready)return; nav.dataset.ready='true'; nav.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();openSupport();}); const grid=document.querySelector('#mobileMoreMenu .mobile-more-grid'); if(grid&&!grid.querySelector('[data-support-mobile]')){const button=document.createElement('button');button.type='button';button.className='mobile-more-option';button.dataset.supportMobile='true';button.innerHTML='<span>🤝</span>Espaço de Apoio';button.addEventListener('click',openSupport);grid.appendChild(button);} }
        document.addEventListener('click',event=>{const target=event.target.closest('[data-section]'); if(target&&target.dataset.section!=='apoio')supportView()?.classList.add('hidden'); const pro=event.target.closest('[data-support-professional]');if(pro)openProfessional(Number(pro.dataset.supportProfessional)); if(event.target.closest('[data-support-modal-close]'))supportView()?.querySelector('[data-support-modal]')?.remove(); if(event.target.closest('[data-support-modal-request]')){supportView()?.querySelector('[data-support-modal]')?.remove();supportView()?.querySelector('[data-support-anchor="request"]')?.scrollIntoView({behavior:'smooth',block:'center'});} const update=event.target.closest('[data-support-update-request]');if(update)updateRequest(update); const service=event.target.closest('[data-support-service]');if(service)supportView()?.querySelector('[data-support-anchor="request"]')?.scrollIntoView({behavior:'smooth',block:'center'}); const scroll=event.target.closest('[data-support-scroll]');if(scroll)supportView()?.querySelector(`[data-support-anchor="${scroll.dataset.supportScroll}"]`)?.scrollIntoView({behavior:'smooth',block:'start'}); });
        document.addEventListener('click',event=>{if(event.target.closest('[data-support-modal-request]')){const select=supportView()?.querySelector('[data-support-request-form select[name="professional_id"]');if(select)select.value=state.selectedProfessional||'';}});
        document.addEventListener('change',event=>{if(!event.target.matches('[data-support-filter]'))return;const value=event.target.value;supportView()?.querySelectorAll('[data-support-anchor="request"] .support-list article').forEach(article=>{const status=article.querySelector('.support-status')?.textContent||'';article.hidden=value!=='all'&&!status.toLocaleLowerCase('pt-BR').includes((statusLabels[value]||'').toLocaleLowerCase('pt-BR'));});});
        document.addEventListener('submit',event=>{if(!supportView()?.contains(event.target))return;event.preventDefault();if(event.target.matches('[data-support-request-form]'))saveRequest(event.target,'family');if(event.target.matches('[data-support-referral-form]'))saveRequest(event.target,'teacher');if(event.target.matches('[data-support-professional-form]'))saveProfessional(event.target);if(event.target.matches('[data-support-service-form]'))saveService(event.target);if(event.target.matches('[data-support-followup-form]'))saveFollowup(event.target);if(event.target.matches('[data-support-appointment-form]'))saveAppointment(event.target);if(event.target.matches('[data-support-message-form]'))saveMessage(event.target);});
        function ensureSupportSearch() { const root=supportView(); if(!root||root.querySelector('[data-support-search]'))return; const heading=[...root.querySelectorAll('.support-section-title')].find(item=>item.textContent.includes('Conheça nossos profissionais')); if(heading)heading.insertAdjacentHTML('beforeend','<input data-support-search type="search" placeholder="Buscar profissional ou serviço" aria-label="Buscar profissional ou serviço" style="max-width:210px;border:1px solid #dbe5f1;border-radius:9px;padding:9px;color:#243856;background:#fff;font-size:10px">'); }
        document.addEventListener('input',event=>{if(!event.target.matches('[data-support-search]'))return;const term=event.target.value.toLocaleLowerCase('pt-BR');supportView()?.querySelectorAll('.support-professional-card').forEach(card=>card.classList.toggle('hidden',term&&!card.textContent.toLocaleLowerCase('pt-BR').includes(term)));});
        let tries=0; const timer=setInterval(()=>{tries++;if(typeof currentProfile!=='undefined'&&typeof currentUser!=='undefined'&&currentUser){setupSupportNav();if(!supportView()?.classList.contains('hidden')){supportStyles();ensureSupportSearch();}}if(tries>180)clearInterval(timer);},1200);
        window.bfrOpenSupport=openSupport;
      })();
    </script>
     <style id="bfr-lia-application-theme">
       :root {
         --teal:#1769d2;
         --teal-deep:#10295f;
         --mint:#eaf7f3;
         --lavender:#f0edff;
         --paper:#f6f9ff;
         --line:#dce6f3;
         --ink:#1b2b4a;
         --lia-violet:#745bd4;
       }
       body, #appShell.ready { background:var(--paper); color:var(--ink); }
       .sidebar { color:#eaf7f3; background:linear-gradient(180deg,#10295f 0%,#1769d2 74%,#745bd4 125%); border-right:0; box-shadow:8px 0 28px rgba(16,41,95,.12); }
       .brand, .brand-name { color:#fff; }
       .sidebar .eyebrow, .nav-label { color:#b9e8df; }
       .school-switch { border-color:rgba(234,247,243,.22); background:rgba(255,255,255,.09); }
       .school-switch strong, .mini-person strong { color:#fff; }
       .school-switch span, .mini-person span { color:#c6ebe4; }
       .nav-item { color:#c8eee7; }
       .nav-item:hover, .nav-item.active { color:#fff; background:rgba(255,255,255,.15); }
       .nav-badge { color:#10295f; background:#eaf7f3; }
       .sidebar-foot { border-top-color:rgba(234,247,243,.22); }
       .logout-button { color:#c8eee7; border-color:rgba(234,247,243,.25); }
       .logout-button:hover { color:#fff; background:rgba(255,255,255,.12); }
       .topbar { background:rgba(255,255,255,.94); border-bottom-color:#dce6f3; box-shadow:0 4px 18px rgba(16,41,95,.07); }
       .breadcrumb b, h1, h2, h3, .panel-heading h2, .modal-card h2 { color:#1b2b4a; }
       .role-toggle button.active, .icon-button, .logout-top-button { color:#1769d2; }
       .icon-button:hover, .logout-top-button:hover { background:#eef6ff; border-color:#bcd5f3; }
       .date-chip, .agenda-count { color:#1769d2; background:#eaf7f3; }
       .child-card { color:#fff; background:linear-gradient(135deg,#10295f,#1769d2 72%,#745bd4); border:0; box-shadow:0 14px 30px rgba(16,41,95,.18); }
       .child-info span, .child-stat span { color:#c7ece5; }
       .child-stat { border-left-color:rgba(234,247,243,.28); }
       .metric-card, .teacher-metric, .panel { border-color:#dce6f3; box-shadow:0 8px 22px rgba(16,41,95,.055); }
       .metric-icon.mint { color:#1769d2; background:#eaf7f3; }
       .metric-icon.lav { color:#745bd4; background:#f0edff; }
       .metric-value strong, .report-average strong { color:#1769d2; }
       .panel-heading a, .text-button, .project-sources a { color:#1769d2; }
       .bar { background:#c9eee6; }
       .bar.today, .legend-dot { background:#1769d2; }
       .bar:hover { background:#745bd4; }
       .legend-dot.light { background:#c9eee6; }
       .project-date { color:#6657a6; background:#f0edff; }
       .side-highlight { background:linear-gradient(135deg,#10295f,#1769d2 72%,#745bd4); box-shadow:0 12px 28px rgba(16,41,95,.18); }
       .primary-button { background:#1769d2 !important; box-shadow:0 7px 16px rgba(23,105,210,.18); }
       .primary-button:hover { background:#10295f !important; }
       .class-tabs, .project-tabs { border-bottom-color:#dce6f3; }
       .class-tab.active, .project-tab.active, .class-tabs .class-tab.active, .project-tabs .project-tab.active { color:#1769d2; border-color:#1769d2; }
       .schedule-shift.active, .experience-tab:hover, .experience-tab.is-active { color:#fff; background:#1769d2; border-color:#1769d2; }
       .schedule-shift { border-color:#dce6f3; background:#f7fbff; }
       .poll-option:has(input:checked) { color:#1769d2; border-color:#8ccfc2; background:#eaf7f3; }
       .poll-option input, .publish-check input, .secretary-step input[type=radio] { accent-color:#1769d2; }
       input:focus, select:focus, textarea:focus { border-color:#1769d2 !important; outline:0; box-shadow:0 0 0 3px rgba(23,105,210,.12); }
       .mobile-more-menu { border-color:#cfe0fb; box-shadow:0 18px 45px rgba(16,41,95,.2); }
       .mobile-more-heading strong, .mobile-more-option { color:#10295f; }
       .mobile-more-option { border-color:#dce6f3; background:#f7fbff; }
       .mobile-more-option span { color:#1769d2; }
       .mobile-more-option:hover, .mobile-more-option:active { background:#eaf7f3; border-color:#8ccfc2; }
       .bfr-enhancement-panel, .support-card, .support-hero, .support-list article { border-color:#dce6f3 !important; }
       .bfr-direction-hero, .support-hero { background:linear-gradient(135deg,#10295f,#1769d2 72%,#24b7a1) !important; }
       .bfr-resource-actions button, .support-card button, .support-link-button { color:#1769d2 !important; background:#f1f7ff !important; border-color:#cfe0fb !important; }
       .bfr-resource-actions button:hover, .support-card button:hover, .support-link-button:hover { color:#10295f !important; background:#eaf7f3 !important; border-color:#8ccfc2 !important; }
       @media (max-width:800px) {
         #appShell.ready .sidebar { background:linear-gradient(135deg,#10295f,#1769d2 72%,#745bd4); border-color:rgba(255,255,255,.22); box-shadow:0 -8px 24px rgba(16,41,95,.2); }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item { color:#d3f1eb; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item:hover { background:rgba(255,255,255,.12); }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active { color:#fff; background:rgba(255,255,255,.18); }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active:after { background:#8de4d3; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-badge { color:#10295f; background:#eaf7f3; }
         #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { color:#d3f1eb; background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.16); }
         #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item.active { background:rgba(255,255,255,.18); border-color:rgba(255,255,255,.28); }
         .login-form { text-align:center !important; align-items:center !important; }
         .login-form > h2, .login-form > p { width:100% !important; text-align:center !important; }
         .login-form > p { margin-left:auto !important; margin-right:auto !important; }
         .login-product-logo { width:min(100%,190px) !important; margin-left:auto !important; margin-right:auto !important; }
         .google-button { justify-content:center !important; text-align:center !important; }
       }
       @media (max-width:520px) {
         .login-message { flex-basis:43% !important; }
         .login-message:after { height:38% !important; background-size:auto 100% !important; background-position:right bottom !important; }
         .login-form { flex-basis:57% !important; padding:10px 18px 10px !important; }
         .login-product-logo { width:min(100%,210px) !important; margin:94px auto 8px !important; }
         .login-form h2 { margin-top:4px !important; }
         .login-form > p strong { display:block !important; margin-top:4px !important; }
         .google-button { height:56px !important; margin-top:34px !important; border:3px solid #1769d2 !important; border-radius:14px !important; color:#10295f !important; background:#fff !important; font-size:17px !important; font-weight:800 !important; gap:12px !important; box-shadow:0 8px 20px rgba(23,105,210,.16) !important; }
         .google-button #googleLabel { color:#10295f !important; font-size:17px !important; font-weight:800 !important; letter-spacing:-.01em; white-space:nowrap; }
         .google-button .google-g { font-size:38px !important; }
       }
      </style>
      <style id="bfr-login-viewport-fit">
        /* Keep the desktop login shell inside the viewport; mobile keeps natural reading flow. */
        @media (min-width:801px) {
          html:has(#loginScreen:not(.hidden)), body:has(#loginScreen:not(.hidden)) { overflow:hidden; }
          .login-screen, .login-card, .login-layout { height:100dvh !important; min-height:0 !important; }
          .login-screen { overflow:hidden !important; }
          .login-message { height:100%; min-height:0 !important; padding:clamp(34px,8vh,74px) clamp(28px,3.5vw,46px) 20px !important; }
          .login-form { height:100%; min-height:0 !important; margin:0 !important; padding:clamp(20px,4vh,40px) clamp(24px,3vw,58px) 16px !important; overflow:hidden !important; justify-content:center !important; }
          .login-product-logo { width:min(100%,clamp(220px,34vh,310px)) !important; max-height:clamp(220px,34vh,310px) !important; margin:0 auto clamp(8px,1.5vh,16px) !important; }
          .login-form h2 { font-size:clamp(28px,3.2vw,40px) !important; line-height:1.1 !important; }
          .login-form > p { font-size:clamp(17px,1.8vw,24px) !important; line-height:1.25 !important; margin-top:8px !important; }
          .google-button { height:clamp(62px,9vh,82px) !important; margin-top:clamp(18px,3.5vh,30px) !important; padding:12px 16px !important; font-size:clamp(18px,2vw,26px) !important; }
          .schedule-public-button { margin-top:6px !important; font-size:12px !important; }
          .login-privacy { height:auto !important; min-height:0 !important; margin-top:10px !important; gap:14px !important; font-size:clamp(14px,1.5vw,18px) !important; line-height:1.3 !important; }
          .login-privacy:before { flex-basis:42px !important; width:42px !important; height:52px !important; border-width:3px !important; font-size:25px !important; }
          .login-creator-credit { margin-top:12px !important; }
          .login-legal-links { margin-top:7px !important; gap:12px !important; }
          .school-links { margin-top:7px !important; gap:12px !important; }
          .school-links a { font-size:clamp(11px,1.2vw,14px) !important; }
          .install-app-floating-wrap { position:fixed; right:12px; bottom:12px; z-index:30; }
        }
        @media (min-width:801px) and (max-height:720px) {
          .login-message h1 { font-size:clamp(34px,5vw,48px) !important; }
          .login-message > p { font-size:clamp(16px,1.9vw,21px) !important; margin-top:12px !important; }
          .login-benefits { gap:8px !important; margin-top:12px !important; }
          .login-benefits > span { min-height:54px !important; }
          .login-benefits b { flex-basis:54px !important; width:54px !important; height:54px !important; margin-right:12px !important; }
          .login-benefits b:after { font-size:26px !important; }
          .login-form { padding-top:12px !important; padding-bottom:10px !important; }
          .login-product-logo { width:min(100%,220px) !important; max-height:220px !important; margin-bottom:6px !important; }
          .login-form h2 { font-size:30px !important; }
          .login-form > p { font-size:18px !important; }
          .google-button { height:60px !important; margin-top:12px !important; }
          .login-privacy { font-size:13px !important; }
          .login-privacy:before { width:36px !important; height:44px !important; flex-basis:36px !important; }
          .login-creator-credit, .login-legal-links, .school-links { margin-top:5px !important; }
        }
      </style>
  <style id="bfr-platform-style">
    .bfr-platform-label{margin-top:0;color:#2563eb;font-weight:800}
    .bfr-direction-hero h1{color:#fff!important}
    #appShell.ready .bfr-legacy-label{color:#475569!important}
    #appShell.ready .bfr-legacy-nav .nav-item{color:#334155!important}
    #appShell.ready .bfr-legacy-nav .nav-item:hover,#appShell.ready .bfr-legacy-nav .nav-item.active{color:#1d4ed8!important;background:#eff6ff!important}
    #appShell.ready .brand-name{color:#10295f!important}
    #appShell.ready .school-switch{background:#f7f9fd!important;border:1px solid #e2e8f0!important}
    #appShell.ready .school-switch .eyebrow{color:#64748b!important}
    #appShell.ready .school-switch strong{color:#1e293b!important}
    #appShell.ready .school-switch span{color:#475569!important}
    #appShell.ready .school-switch .school-social-link{color:#1d4ed8!important}
    #appShell.ready .school-switch .school-social-link:hover{color:#10295f!important}
     .bfr-platform-nav{gap:5px;margin-bottom:18px;padding-bottom:16px;border-bottom:1px solid #e6edf6}
     .bfr-platform-nav .nav-item{font-weight:700}
     #appShell.ready .bfr-platform-nav .nav-item{color:#334155!important;cursor:pointer;pointer-events:auto}
     #appShell.ready .bfr-platform-nav .nav-item:hover{color:#1d4ed8!important;background:#f1f6ff!important}
     .bfr-platform-nav .nav-icon{font-size:15px}
    .bfr-platform-nav .nav-item.active{color:#1d4ed8;background:#eaf2ff;box-shadow:inset 3px 0 #2563eb}
    .bfr-legacy-label{margin-top:0}
    .bfr-legacy-nav{max-height:315px;overflow:auto;padding-right:2px}
    .bfr-legacy-nav::-webkit-scrollbar{width:4px}
    .bfr-legacy-nav::-webkit-scrollbar-thumb{border-radius:8px;background:#cbd5e1}
    .bfr-platform-view{display:grid;gap:18px;padding-bottom:35px}
    .bfr-platform-hero{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px;border:1px solid #dbeafe;border-radius:22px;color:#fff;background:linear-gradient(135deg,#172554,#2563eb 62%,#0ea5a4);box-shadow:0 16px 36px rgba(37,99,235,.16);overflow:hidden;position:relative}
    .bfr-platform-hero:after{content:'';position:absolute;width:260px;height:260px;right:-88px;top:-110px;border:1px solid rgba(255,255,255,.2);border-radius:50%;box-shadow:0 0 0 26px rgba(255,255,255,.05),0 0 0 52px rgba(255,255,255,.035);pointer-events:none}
    .bfr-platform-hero > div{position:relative;z-index:1}
    .bfr-platform-hero .eyebrow{color:#bfdbfe}
    .bfr-platform-hero h1{margin:7px 0 8px;color:#fff;font:800 clamp(28px,4vw,46px) 'DM Sans',sans-serif;letter-spacing:-.055em}
    .bfr-platform-hero p{max-width:670px;color:#dbeafe;font-size:13px;line-height:1.55}
    .bfr-platform-hero-art{display:grid;place-items:center;flex:0 0 138px;width:138px;height:138px;border:1px solid rgba(255,255,255,.25);border-radius:38px;background:rgba(255,255,255,.13);font-size:64px;backdrop-filter:blur(8px)}
    .bfr-platform-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .bfr-platform-toolbar h2{color:#172554;font-size:20px}
    .bfr-platform-toolbar p{margin-top:5px;color:#64748b;font-size:11px}
    .bfr-platform-actions{display:flex;gap:8px;flex-wrap:wrap}
    .bfr-platform-button{min-height:40px;border:1px solid #cfe0fb;border-radius:10px;padding:10px 13px;color:#1d4ed8;background:#eff6ff;font-size:11px;font-weight:800;transition:transform .2s,background .2s,border-color .2s}
    .bfr-platform-button:hover,.bfr-platform-button:focus-visible{transform:translateY(-2px);border-color:#93c5fd;background:#dbeafe}
    .bfr-platform-button.primary{border-color:#2563eb;color:#fff;background:#2563eb;box-shadow:0 7px 15px rgba(37,99,235,.18)}
    .bfr-platform-button.ghost{color:#475569;background:#fff;border-color:#e2e8f0}
    .bfr-platform-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .bfr-platform-card{min-width:0;padding:16px;border:1px solid #e2e8f0;border-radius:17px;background:#fff;box-shadow:0 10px 25px rgba(15,23,42,.05);transition:transform .22s,box-shadow .22s,border-color .22s}
    .bfr-platform-card:hover{transform:translateY(-3px);border-color:#bfdbfe;box-shadow:0 16px 34px rgba(15,23,42,.1)}
    .bfr-platform-card .bfr-card-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#eff6ff;font-size:21px}
    .bfr-platform-card h3{margin:13px 0 5px;color:#1e3a8a;font-size:14px}
    .bfr-platform-card p{min-height:35px;color:#64748b;font-size:10px;line-height:1.45}
    .bfr-platform-card .bfr-card-link{display:inline-flex;margin-top:12px;color:#2563eb;border:0;background:transparent;padding:0;font-size:10px;font-weight:800}
    .bfr-platform-panel{padding:18px;border:1px solid #e2e8f0;border-radius:17px;background:#fff;box-shadow:0 9px 22px rgba(15,23,42,.045)}
    .bfr-platform-panel h2{color:#172554;font-size:17px}
    .bfr-platform-panel > p{margin-top:5px;color:#64748b;font-size:11px;line-height:1.5}
    .bfr-platform-stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}
    .bfr-platform-stat{padding:13px;border:1px solid #e2e8f0;border-radius:13px;background:#f8fbff}
    .bfr-platform-stat span,.bfr-platform-stat small{display:block;color:#64748b;font-size:10px}
    .bfr-platform-stat strong{display:block;margin:6px 0 2px;color:#2563eb;font:800 25px 'DM Sans',sans-serif}
    .bfr-platform-progress{height:8px;margin-top:12px;border-radius:99px;background:#e5edf8;overflow:hidden}.bfr-platform-progress i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#0ea5a4,#2563eb)}
    .bfr-platform-list{display:grid;gap:8px;margin-top:13px}.bfr-platform-list article{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px;border:1px solid #e2e8f0;border-radius:12px;background:#fbfdff}.bfr-platform-list strong{display:block;color:#243b63;font-size:11px}.bfr-platform-list span{display:block;margin-top:4px;color:#64748b;font-size:9px}.bfr-platform-badge{display:inline-flex;align-items:center;flex-shrink:0;border-radius:999px;padding:5px 8px;color:#1d4ed8;background:#eff6ff;font:9px 'DM Mono',monospace}.bfr-platform-badge.good{color:#15803d;background:#ecfdf5}.bfr-platform-badge.warn{color:#a16207;background:#fef3c7}
    .bfr-resource-icon{background:#f5f3ff!important}.bfr-resource-card:nth-child(3n) .bfr-card-icon{background:#ecfdf5}.bfr-resource-card:nth-child(4n) .bfr-card-icon{background:#fff7ed}
    .bfr-quiz-layout,.bfr-trail-layout,.bfr-school-layout,.bfr-space-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:14px;align-items:start}
    .bfr-quiz-question{margin-top:14px;padding:16px;border:1px solid #dbeafe;border-radius:14px;background:#f8fbff}.bfr-quiz-question h3{color:#1e3a8a;font-size:16px;line-height:1.35}.bfr-quiz-options{display:grid;gap:8px;margin-top:13px}.bfr-quiz-option{border:1px solid #dbe5f1;border-radius:10px;padding:11px;color:#243b63;background:#fff;text-align:left;font-size:11px}.bfr-quiz-option:hover,.bfr-quiz-option.is-selected{border-color:#60a5fa;background:#eff6ff}.bfr-quiz-feedback{margin-top:11px;padding:10px;border-radius:10px;color:#166534;background:#ecfdf5;font-size:10px;line-height:1.45}.bfr-quiz-feedback.is-error{color:#991b1b;background:#fef2f2}
    .bfr-trail-step{position:relative;display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;padding:11px 0;border-top:1px solid #edf2f7}.bfr-trail-step:first-child{border-top:0}.bfr-trail-dot{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;color:#2563eb;background:#eff6ff;font-size:11px;font-weight:800}.bfr-trail-step.is-done .bfr-trail-dot{color:#fff;background:#16a34a}.bfr-trail-step.is-locked .bfr-trail-dot{color:#94a3b8;background:#f1f5f9}.bfr-trail-step strong{color:#243b63;font-size:11px}.bfr-trail-step small{display:block;margin-top:3px;color:#64748b;font-size:9px}.bfr-trail-step button{border:0;color:#2563eb;background:transparent;font-size:10px;font-weight:800}
    .bfr-achievement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:13px}.bfr-achievement{padding:13px;border:1px solid #e2e8f0;border-radius:13px;background:#fbfdff}.bfr-achievement.is-locked{opacity:.62;filter:grayscale(.55)}.bfr-achievement-icon{font-size:27px}.bfr-achievement strong{display:block;margin-top:7px;color:#243b63;font-size:11px}.bfr-achievement span{display:block;margin-top:4px;color:#64748b;font-size:9px;line-height:1.4}
    .bfr-subnav{display:flex;gap:7px;overflow:auto;margin:14px 0 0;padding-bottom:3px}.bfr-subnav button{white-space:nowrap;border:1px solid #dbe5f1;border-radius:999px;padding:8px 11px;color:#64748b;background:#fff;font-size:10px;font-weight:700}.bfr-subnav button.is-active{color:#1d4ed8;border-color:#93c5fd;background:#eff6ff}
    .bfr-announce{position:relative;padding:14px;border:1px solid #e2e8f0;border-radius:13px;background:#fff}.bfr-announce.is-urgent{border-color:#fecaca;background:#fff7f7}.bfr-announce + .bfr-announce{margin-top:8px}.bfr-announce h3{color:#243b63;font-size:12px}.bfr-announce p{margin-top:6px;color:#64748b;font-size:10px;line-height:1.5}.bfr-announce small{display:block;margin-top:7px;color:#94a3b8;font-size:9px}.bfr-announce button{margin-top:9px;border:0;color:#2563eb;background:transparent;padding:0;font-size:10px;font-weight:800}
    .bfr-calendar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:13px}.bfr-calendar-event{padding:12px;border-left:3px solid #2563eb;border-radius:10px;background:#f8fbff}.bfr-calendar-event strong{display:block;color:#243b63;font-size:11px}.bfr-calendar-event span{display:block;margin-top:5px;color:#64748b;font-size:9px;line-height:1.45}
    .bfr-profile-card{display:flex;align-items:center;gap:12px;padding:15px;border:1px solid #dbeafe;border-radius:15px;background:linear-gradient(135deg,#eff6ff,#fff)}.bfr-profile-avatar{display:grid;place-items:center;width:54px;height:54px;border-radius:17px;color:#fff;background:linear-gradient(145deg,#2563eb,#0ea5a4);font-size:22px;font-weight:800}.bfr-profile-card strong{display:block;color:#172554;font-size:15px}.bfr-profile-card span{display:block;margin-top:4px;color:#64748b;font-size:10px}.bfr-toggle-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0;border-top:1px solid #edf2f7}.bfr-toggle-row:first-child{border-top:0}.bfr-toggle-row strong{color:#243b63;font-size:11px}.bfr-toggle-row small{display:block;margin-top:3px;color:#64748b;font-size:9px}.bfr-toggle{width:38px;height:22px;border:0;border-radius:99px;padding:3px;background:#cbd5e1}.bfr-toggle i{display:block;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .2s}.bfr-toggle.is-on{background:#2563eb}.bfr-toggle.is-on i{transform:translateX(16px)}
  .bfr-platform-view :focus-visible{outline:3px solid rgba(37,99,235,.25);outline-offset:2px}
    @media(max-width:1050px){.bfr-platform-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-platform-stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:800px){.bfr-platform-label,.bfr-legacy-label,.bfr-legacy-nav{display:none!important}.bfr-platform-nav{display:grid!important;grid-template-columns:repeat(6,minmax(0,1fr))!important;gap:2px!important;margin:0!important;padding:0!important;border:0!important}.bfr-platform-nav .nav-item{display:grid!important;min-width:0!important;width:100%!important;height:58px!important;padding:6px 2px!important;border:0!important;border-radius:10px!important;place-items:center!important;align-content:center!important;gap:3px!important;text-align:center!important;font-size:8px!important;line-height:1!important;white-space:nowrap!important;overflow:hidden!important}.bfr-platform-nav .nav-icon{display:block!important;width:auto!important;font-size:16px!important}.bfr-platform-nav .nav-item.active{box-shadow:none!important}.bfr-platform-nav .bfr-platform-more{display:grid!important}.bfr-platform-view{gap:13px;padding-bottom:95px}.bfr-platform-hero{display:block;padding:20px}.bfr-platform-hero-art{width:100%;height:72px;margin-top:15px}.bfr-platform-grid,.bfr-quiz-layout,.bfr-trail-layout,.bfr-school-layout,.bfr-space-layout{grid-template-columns:1fr}.bfr-platform-stat-grid{grid-template-columns:1fr 1fr}.bfr-platform-card p{min-height:0}.bfr-achievement-grid,.bfr-calendar-grid{grid-template-columns:1fr 1fr}.bfr-platform-toolbar{display:block}.bfr-platform-actions{margin-top:12px}}
    @media(max-width:430px){.bfr-platform-stat-grid,.bfr-achievement-grid,.bfr-calendar-grid{grid-template-columns:1fr}.bfr-platform-panel{padding:15px}}
    @media(prefers-reduced-motion:reduce){.bfr-platform-card,.bfr-platform-button{transition:none}.bfr-platform-card:hover,.bfr-platform-button:hover{transform:none}}
  </style>
  <script id="bfr-reading-library-inline">
    (() => {
      const root=()=>document.getElementById('readingLibraryView'), key='bfr-reading-library-v1';
      const books=[['prince','O Pequeno Príncipe','Antoine de Saint-Exupéry','Literatura mundial','🌟'],['island','A Ilha Perdida','Maria José Dupré','Aventura','🧭'],['alice','Alice no País das Maravilhas','Lewis Carroll','Fantasia','🐇'],['machado','Contos de Machado de Assis','Machado de Assis','Literatura brasileira','📝'],['poesia','Ou isto ou aquilo','Cecília Meireles','Poesia','🌈'],['misterio','O Mistério do Cinco Estrelas','Marcos Rey','Mistério','🔎']];
      const defaults={progress:{prince:80,island:35,machado:100},favorites:['prince'],completed:['machado'],history:['prince','island','machado'],category:'Todos',search:'',days:6,first:false,explorer:false,diary:'',reflections:0,quiz:'',comments:[],likes:0,large:false,night:false,fact:0};
      let state=(()=>{try{const saved=JSON.parse(localStorage.getItem(key)||'{}');return {...defaults,...saved,progress:{...defaults.progress,...(saved.progress||{})}};}catch{return {...defaults,progress:{...defaults.progress}};}})();
      const esc=value=>String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])), get=id=>books.find(book=>book[0]===id)||books[0], pct=id=>Number(state.progress[id]??get(id).progress??0), save=()=>{try{localStorage.setItem(key,JSON.stringify(state));}catch{}};
      function style(){if(document.getElementById('bfr-reading-library-inline-style'))return;const s=document.createElement('style');s.id='bfr-reading-library-inline-style';s.textContent=`#readingLibraryView .bfr-inline-lib{display:grid;gap:16px;padding-bottom:30px}#readingLibraryView .il-panel{padding:19px;border:1px solid #dce7f5;border-radius:17px;background:#fff;box-shadow:0 9px 23px rgba(43,67,115,.05)}#readingLibraryView .il-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:25px;border:1px solid #dce7f5;border-radius:20px;background:linear-gradient(135deg,#eef6ff,#fff 58%,#f4efff)}#readingLibraryView h1,#readingLibraryView h2{color:#10295f;font-family:'Playfair Display',serif}#readingLibraryView h1{margin:7px 0;font-size:clamp(27px,3vw,40px)}#readingLibraryView h2{margin:4px 0;font-size:21px}#readingLibraryView p{color:#71809a;font-size:11px;line-height:1.5}.il-art{display:grid;place-items:center;width:145px;height:105px;border-radius:17px;background:#f2f0ff;font-size:51px}.il-head{display:flex;justify-content:space-between;gap:12px}.il-kicker{color:#1769d2;font:10px 'DM Mono',monospace;letter-spacing:.08em}.il-chip{padding:7px 10px;border-radius:999px;color:#6759a1;background:#f6f3ff;font:10px 'DM Mono',monospace;white-space:nowrap}.il-grid,.il-books,.il-goals,.il-badges,.il-stats{display:grid;gap:10px;margin-top:14px}.il-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.il-books{grid-template-columns:repeat(3,minmax(0,1fr))}.il-goals{grid-template-columns:repeat(3,minmax(0,1fr))}.il-badges{grid-template-columns:repeat(5,minmax(0,1fr))}.il-stats{grid-template-columns:repeat(5,minmax(0,1fr))}.il-card,.il-book,.il-goal,.il-badge,.il-stat{min-width:0;padding:12px;border:1px solid #e2eaf4;border-radius:13px;background:#fbfdff}.il-card strong,.il-goal strong,.il-stat strong{color:#29436a;font-size:11px}.il-cover{display:grid;align-content:end;gap:3px;min-height:125px;margin:9px 0;padding:12px;border-radius:12px;color:#fff;background:linear-gradient(145deg,#2876d8,#173574)}.il-cover span{font-size:27px}.il-cover b{font:700 15px 'Playfair Display',serif;line-height:1.08}.il-cover small{font-size:9px}.il-cover.small{min-height:65px;padding:8px}.il-tools{display:flex;gap:8px;margin-top:14px}.il-tools input,.il-tools select,.il-form textarea,.il-comment input{width:100%;padding:10px;border:1px solid #dbe5f1;border-radius:9px;color:#243856;font-size:11px}.il-cats{display:flex;gap:6px;overflow:auto;margin:12px 0}.il-cat,.il-action,.il-small,.il-control,.il-comment button{border:0;border-radius:9px;padding:9px 12px;color:#1769d2;background:#edf5ff;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap}.il-cat.active,.il-action,.il-comment button{color:#fff;background:#1769d2}.il-book{position:relative}.il-book h3{margin:0;color:#203a64;font:700 17px 'Playfair Display',serif}.il-book small,.il-meta{color:#71809a;font-size:9px}.il-fav{position:absolute;right:10px;top:10px;border:0;background:transparent;color:#d19a26;font-size:20px;cursor:pointer}.il-bar{height:6px;margin:8px 0;border-radius:99px;background:#eaf0f7;overflow:hidden}.il-bar i{display:block;height:100%;background:linear-gradient(90deg,#4e9577,#1769d2)}.il-feature,.il-two,.il-curiosity{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:center}.il-feature{grid-template-columns:180px minmax(0,1fr)}.il-feature h2{font-size:26px}.il-badge{text-align:center}.il-badge b{display:grid;place-items:center;width:38px;height:38px;margin:auto;border-radius:50%;background:#edf1f6;font-size:20px}.il-badge.earned b{background:#fff3ce}.il-badge strong,.il-badge small,.il-stat span,.il-stat strong{display:block}.il-badge small,.il-stat span{margin-top:5px;color:#71809a;font-size:9px}.il-stat strong{margin-top:8px;color:#1769d2;font:700 23px 'DM Mono',monospace}.il-form textarea{min-height:105px;resize:vertical}.il-comment{display:flex}.il-comments{display:grid;gap:5px;margin:9px 0}.il-comments span{padding:7px;border-radius:8px;background:#f6f9ff;color:#63738f;font-size:10px}.il-controls{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.bfr-inline-lib.large{font-size:115%}.bfr-inline-lib.night .il-panel,.bfr-inline-lib.night .il-card,.bfr-inline-lib.night .il-book,.bfr-inline-lib.night .il-goal,.bfr-inline-lib.night .il-badge,.bfr-inline-lib.night .il-stat{background:#172641;color:#edf4ff;border-color:#2d4569}@media(max-width:900px){.il-grid,.il-books{grid-template-columns:repeat(2,minmax(0,1fr))}.il-badges,.il-stats{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:620px){#readingLibraryView .il-hero{display:block;padding:18px}.il-art{width:100%;height:70px;margin-top:13px}.il-grid,.il-books,.il-goals,.il-badges,.il-stats,.il-two,.il-curiosity,.il-feature{grid-template-columns:1fr}.il-tools{display:block}.il-tools select{margin-top:7px}}`;document.head.appendChild(s);}
      const cover=(book,small=false)=>`<div class="il-cover ${small?'small':''}"><span>${book[4]}</span><b>${esc(book[1])}</b><small>${esc(book[2])}</small></div>`, card=book=>`<article class="il-book">${cover(book)}<button class="il-fav" data-il-fav="${book[0]}">${state.favorites.includes(book[0])?'★':'☆'}</button><h3>${esc(book[1])}</h3><p>${esc(book[2])} · ${esc(book[3])}</p><small>${pct(book[0])}% de leitura</small><div class="il-bar"><i style="width:${Math.min(100,pct(book[0]))}%"></i></div><button class="il-small" data-il-read="${book[0]}">${pct(book[0])?'Continuar lendo':'Começar leitura'}</button></article>`;
      function render(){const el=root();if(!el)return;style();const found=books.filter(book=>(state.category==='Todos'||(state.category==='Destaques'&&book[0]==='prince')||book[3]===state.category)&&(!state.search||book.slice(1,4).join(' ').toLocaleLowerCase('pt-BR').includes(state.search.toLocaleLowerCase('pt-BR')))),daily=books[new Date().getDate()%books.length],current=get(state.history[0]),done=[state.first,state.explorer,state.days>=7].filter(Boolean).length;el.innerHTML=`<div class="bfr-inline-lib ${state.large?'large':''} ${state.night?'night':''}"><section class="il-hero"><div><div class="eyebrow">Leitura, imaginação e aprendizagem · BFR Conecta</div><h1>📚 Biblioteca &amp; Leitura</h1><p>Descubra histórias, compartilhe ideias e transforme cada leitura em uma nova experiência.</p><button class="il-action" data-il-explore>🔎 Explorar livros</button></div><div class="il-art">📚</div></section><section class="il-panel"><div class="il-head"><div><span class="il-kicker">📖 MINHA LEITURA</span><h2>Seu espaço para acompanhar descobertas</h2><p>Continue de onde parou, reveja seus favoritos e celebre cada livro concluído.</p></div><span class="il-chip">progresso individual</span></div><div class="il-grid"><article class="il-card"><strong>Continuar lendo</strong>${cover(current,true)}<div class="il-meta">${esc(current[1])} · ${pct(current[0])}%</div><button class="il-small" data-il-read="${current[0]}">Continuar lendo</button></article><article class="il-card"><strong>Meus favoritos</strong>${cover(get(state.favorites[0]),true)}<div class="il-meta">${state.favorites.length} favorito(s)</div></article><article class="il-card"><strong>Livros concluídos</strong><h2>${state.completed.length}</h2><div class="il-meta">histórias na sua jornada</div></article><article class="il-card"><strong>Histórico de leitura</strong><h2>${state.history.length}</h2><div class="il-meta">registro(s) neste dispositivo</div></article></div></section><section class="il-panel" id="bfrLibraryExplore"><div class="il-head"><div><span class="il-kicker">🔎 EXPLORAR LIVROS</span><h2>Encontre uma nova história</h2><p>Pesquise por livro, autor ou tema e navegue por categorias.</p></div></div><div class="il-tools"><input type="search" data-il-search value="${esc(state.search)}" placeholder="Buscar livro, autor ou tema..." aria-label="Buscar livro, autor ou tema"><select data-il-sort><option>Mais recomendados</option><option>Mais lidos</option></select></div><div class="il-cats">${['Todos','Destaques','Aventura','Fantasia','Mistério','Literatura brasileira','Literatura mundial','Poesia'].map(cat=>`<button class="il-cat ${state.category===cat?'active':''}" data-il-cat="${esc(cat)}">${esc(cat)}</button>`).join('')}</div><div class="il-books">${found.length?found.map(card).join(''):'<div class="data-empty-inline">Nenhum livro encontrado.</div>'}</div></section><section class="il-panel il-feature"><div>${cover(get('prince'))}</div><div><span class="il-kicker">⭐ LIVRO EM DESTAQUE</span><h2>O Pequeno Príncipe</h2><p>Uma leitura sobre amizade, cuidado e diferentes formas de olhar o mundo.</p><button class="il-action" data-il-read="prince">Começar leitura</button></div></section><section class="il-panel"><div class="il-head"><div><span class="il-kicker">🎯 DESAFIOS DE LEITURA</span><h2>Pequenos desafios, grandes descobertas</h2><p>Escolha metas pessoais e avance no seu ritmo.</p></div></div><div class="il-goals"><article class="il-goal"><strong>📖 Desafio 7 Dias</strong><p>Leia por 7 dias. Progresso: ${state.days}/7.</p><button class="il-small" data-il-challenge="days">Continuar desafio</button></article><article class="il-goal"><strong>📚 Desafio Primeiro Livro</strong><p>Conclua seu primeiro livro.</p><button class="il-small" data-il-challenge="first">${state.first?'Concluído ✓':'Marcar como concluído'}</button></article><article class="il-goal"><strong>🌟 Desafio Descobridor</strong><p>Conheça livros de 3 categorias.</p><button class="il-small" data-il-challenge="explorer">${state.explorer?'Concluído ✓':'Continuar desafio'}</button></article></div></section><section class="il-panel"><span class="il-kicker">🏆 MINHAS CONQUISTAS</span><h2>Conquistas que celebram sua jornada</h2><p>Sem rankings públicos: o foco é seu próprio caminho.</p><div class="il-badges">${[['🥉','Primeiro Passo',state.completed.length>0],['📚','Leitor Curioso',state.completed.length>=3],['🔥','Leitor Constante',state.days>=7],['🌟','Explorador Literário',state.explorer],['✍️','Voz Literária',state.reflections>=5]].map(item=>`<div class="il-badge ${item[2]?'earned':''}"><b>${item[0]}</b><strong>${item[1]}</strong><small>${item[2]?'Conquista registrada':'Continue explorando'}</small></div>`).join('')}</div></section><div class="il-two"><section class="il-panel"><span class="il-kicker">📝 MEU DIÁRIO DE LEITURA</span><h2>Registre suas ideias</h2><p>Escreva uma reflexão sobre uma leitura.</p><form class="il-form" data-il-diary><textarea name="diary" placeholder="O que achei da história? O que aprendi?">${esc(state.diary)}</textarea><button class="il-action">Salvar reflexão</button></form></section><section class="il-panel"><span class="il-kicker">🧠 QUIZ LITERÁRIO</span><h2>Teste sua compreensão</h2><p>Quem é o personagem principal de O Pequeno Príncipe?</p><div class="il-controls">${[['a','O Pequeno Príncipe'],['b','O aviador'],['c','A raposa'],['d','O rei']].map(item=>`<button class="il-control" data-il-quiz="${item[0]}">${item[0].toUpperCase()}. ${item[1]}</button>`).join('')}</div><p>${state.quiz?(state.quiz==='a'?'✅ Resposta correta!':'💡 Vamos tentar novamente!'):''}</p></section></div><section class="il-panel"><div class="il-head"><div><span class="il-kicker">💬 CLUBE DA LEITURA</span><h2>Converse sobre o livro da semana</h2><p>Compartilhe uma ideia com respeito e curiosidade.</p></div><span class="il-chip">moderação escolar</span></div><div class="il-comments">${state.comments.length?state.comments.map(item=>`<span>💬 ${esc(item)}</span>`).join(''):'<span>Seja o primeiro a compartilhar uma reflexão.</span>'}</div><form class="il-comment" data-il-comment><input name="comment" maxlength="240" placeholder="Compartilhe sua ideia..."><button>Publicar</button></form><button class="il-small" data-il-like>♡ ${state.likes} reação(ões)</button></section><div class="il-two"><section class="il-panel"><span class="il-kicker">👩‍🏫 INDICAÇÕES DOS PROFESSORES</span><h2>Uma recomendação para você</h2><div class="il-two">${cover(get('poesia'),true)}<button class="il-small" data-il-read="poesia">Conhecer livro</button></div></section><section class="il-panel"><span class="il-kicker">🔠 LEITURA ACESSÍVEL</span><h2>Ajuste sua experiência</h2><div class="il-controls"><button class="il-control" data-il-large>${state.large?'🔡 Fonte normal':'🔠 Aumentar fonte'}</button><button class="il-control" data-il-night>${state.night?'☀️ Modo claro':'🌙 Modo escuro'}</button><button class="il-control" data-il-audio>🔊 Ouvir texto</button></div></section></div><div class="il-curiosity"><section class="il-panel"><span class="il-kicker">💡 VOCÊ SABIA?</span><h2>Curiosidade literária</h2><p>${['A literatura brasileira reúne diferentes escolas literárias.','Um mesmo livro pode provocar perguntas diferentes em cada leitor.','A poesia também aparece em músicas, cordéis e textos cotidianos.'][state.fact%3]}</p><button class="il-small" data-il-fact>Ver outra curiosidade →</button></section><section class="il-panel"><span class="il-kicker">📖 LIVRO DO DIA</span><h2>${esc(daily[1])}</h2><p>${esc(daily[2])} · ${esc(daily[3])}</p><button class="il-small" data-il-read="${daily[0]}">Explorar livro</button></section></div><section class="il-panel"><span class="il-kicker">📊 MEU PROGRESSO</span><h2>Veja o caminho que você já percorreu</h2><div class="il-stats">${[['📚','Livros concluídos',state.completed.length],['📝','Reflexões',state.reflections],['🎯','Desafios concluídos',done],['🏆','Conquistas',1],['⭐','Favoritos',state.favorites.length]].map(item=>`<div class="il-stat"><span>${item[0]} ${item[1]}</span><strong>${item[2]}</strong></div>`).join('')}</div></section><section class="il-panel"><span class="il-kicker">🏫 BIBLIOTECA DA ESCOLA</span><h2>Um espaço pronto para crescer</h2><p>Futuramente, a escola poderá publicar livros, novidades, projetos, atividades e eventos literários aqui.</p><div class="il-controls"><span class="il-chip">📚 Livros disponíveis</span><span class="il-chip">✨ Novidades</span><span class="il-chip">🎭 Projetos literários</span><span class="il-chip">🗓️ Eventos</span></div></section></div>`;el.querySelectorAll('[data-il-read]').forEach(button=>button.addEventListener('click',()=>{const id=button.dataset.ilRead;state.progress[id]=Math.min(100,pct(id)+10);if(pct(id)>=100&&!state.completed.includes(id))state.completed.push(id);state.history=[id,...state.history.filter(item=>item!==id)].slice(0,8);save();render();}));el.querySelectorAll('[data-il-fav]').forEach(button=>button.addEventListener('click',()=>{const id=button.dataset.ilFav;state.favorites=state.favorites.includes(id)?state.favorites.filter(item=>item!==id):[...state.favorites,id];save();render();}));el.querySelector('[data-il-search]')?.addEventListener('input',event=>{state.search=event.target.value;save();render();requestAnimationFrame(()=>document.querySelector('#readingLibraryView [data-il-search]')?.focus());});el.querySelectorAll('[data-il-cat]').forEach(button=>button.addEventListener('click',()=>{state.category=button.dataset.ilCat;save();render();}));el.querySelectorAll('[data-il-explore]').forEach(button=>button.addEventListener('click',()=>el.querySelector('#bfrLibraryExplore')?.scrollIntoView({behavior:'smooth'})));el.querySelectorAll('[data-il-challenge]').forEach(button=>button.addEventListener('click',()=>{const type=button.dataset.ilChallenge;if(type==='days')state.days=Math.min(7,state.days+1);if(type==='first')state.first=true;if(type==='explorer')state.explorer=true;save();render();}));el.querySelector('[data-il-diary]')?.addEventListener('submit',event=>{event.preventDefault();state.diary=event.currentTarget.elements.diary.value.trim();if(state.diary)state.reflections=Math.min(99,state.reflections+1);save();render();});el.querySelectorAll('[data-il-quiz]').forEach(button=>button.addEventListener('click',()=>{state.quiz=button.dataset.ilQuiz;save();render();}));el.querySelector('[data-il-comment]')?.addEventListener('submit',event=>{event.preventDefault();const text=event.currentTarget.elements.comment.value.trim();if(text){state.comments=[...state.comments,text].slice(-5);save();render();}});el.querySelector('[data-il-like]')?.addEventListener('click',()=>{state.likes=Math.min(99,state.likes+1);save();render();});el.querySelector('[data-il-large]')?.addEventListener('click',()=>{state.large=!state.large;save();render();});el.querySelector('[data-il-night]')?.addEventListener('click',()=>{state.night=!state.night;save();render();});el.querySelector('[data-il-audio]')?.addEventListener('click',()=>{alert('O áudio ficará disponível quando houver gravação da escola.');});el.querySelector('[data-il-fact]')?.addEventListener('click',()=>{state.fact=(state.fact+1)%3;save();render();});}
       function open(){const el=root();if(!el)return;document.querySelectorAll('#appShell .content').forEach(view=>view.classList.add('hidden'));el.classList.remove('hidden');render();const crumb=document.querySelector('.breadcrumb b');if(crumb)crumb.textContent='Biblioteca';window.scrollTo({top:0,behavior:'auto'});}
      window.bfrOpenReadingLibrary=open;window.bfrReadingLibrary={open,render,storageKey:key};
    })();
  </script>
  <script id="bfr-activity-center-inline">
    (()=>{
      const root=()=>document.getElementById('activityCenterView'),key='bfr-activity-center-v1',origins={school:['📚','Atividade escolar','Escolar','agenda'],reading:['📖','Biblioteca & Leitura','Leitura','biblioteca'],food:['🥗','Alimentação Saudável','Alimentação','alimentacao'],games:['🎮','Jogos Educativos','Educativo','jogos']};
      const base={done:{},filters:{query:'',status:'all',origin:'all'},view:'list'};let saved={};try{saved=JSON.parse(localStorage.getItem(key)||'{}')}catch{};let state={...base,...saved,filters:{...base.filters,...(saved.filters||{})},items:[],loaded:false,loading:false,error:''};
      const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])),save=()=>{try{localStorage.setItem(key,JSON.stringify({done:state.done,filters:state.filters,view:state.view}))}catch{}},db=()=>typeof supabaseClient!=='undefined'?supabaseClient:null;
      const iso=()=>{const d=new Date();return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,10)},plus=n=>{const d=new Date(`${iso()}T12:00:00`);d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)},diff=v=>v?Math.round((new Date(`${v}T12:00:00`)-new Date(`${iso()}T12:00:00`))/86400000):999,date=v=>v?new Date(`${v}T12:00:00`).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.',''):'Sem prazo';
      const sample=()=>[{id:'reading:prince',subject:'O Pequeno Príncipe',title:'Leia os capítulos 1 a 3',description:'Continue sua leitura e registre uma ideia que chamou sua atenção.',due:plus(1),origin:'reading',defaultStatus:'in_progress',priority:'normal',progress:'2/3',owner:'Biblioteca & Leitura'},{id:'food:water',subject:'Desafio saudável',title:'Beber água durante o dia',description:'Registre seu progresso no desafio de hidratação.',due:plus(0),origin:'food',defaultStatus:'pending',priority:'high',progress:'4/6',owner:'Alimentação Saudável'},{id:'games:math',subject:'Desafio de Matemática',title:'Complete 10 questões',description:'Pratique no seu ritmo e acompanhe seu próprio avanço.',due:plus(4),origin:'games',defaultStatus:'in_progress',priority:'low',progress:'7/10',owner:'Jogos Educativos'}];
      const meta=item=>origins[item.origin]||origins.school,status=item=>{if(state.done[item.id])return'completed';const d=diff(item.due);if(d<0)return'overdue';if(item.defaultStatus==='in_progress')return'in_progress';return d===0?'today':d>0?'upcoming':'pending'},active=item=>status(item)!=='completed',label=item=>({completed:'Concluída',overdue:'Atrasada',today:'Vence hoje',upcoming:'Próxima',in_progress:'Em andamento',pending:'Pendente'}[status(item)]),priority=v=>({urgent:'🔴 Urgente',high:'🟠 Alta',normal:'🟡 Normal',low:'⚪ Baixa'}[v]||'🟡 Normal');
      function css(){if(document.getElementById('bfr-ac-inline-style'))return;const s=document.createElement('style');s.id='bfr-ac-inline-style';s.textContent=`#activityCenterView .bfr-ac-inline{display:grid;gap:16px;padding-bottom:30px}#activityCenterView .iac-panel{padding:19px;border:1px solid #dce7f5;border-radius:17px;background:#fff;box-shadow:0 9px 23px rgba(43,67,115,.05)}#activityCenterView .iac-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:25px;border:1px solid #dce7f5;border-radius:20px;background:linear-gradient(135deg,#eef6ff,#fff 58%,#fff5e9)}#activityCenterView .iac-hero h1{margin:7px 0;color:#10295f;font:700 clamp(27px,3vw,40px) 'Playfair Display',serif}#activityCenterView .iac-hero p{color:#63738f;font-size:12px;line-height:1.55}.iac-art{display:grid;place-items:center;width:145px;height:105px;border-radius:18px;background:#edf4ff;font-size:51px}.iac-action,.iac-small,.iac-filter,.iac-origin,.iac-toggle{border:0;border-radius:9px;padding:9px 12px;color:#1769d2;background:#edf5ff;font-size:10px;font-weight:700;cursor:pointer}.iac-action{margin-top:10px;color:#fff;background:#1769d2}.iac-head{display:flex;justify-content:space-between;gap:12px}.iac-kicker{color:#1769d2;font:10px 'DM Mono',monospace;letter-spacing:.08em}.iac-chip{padding:7px 10px;border-radius:999px;color:#6759a1;background:#f6f3ff;font:10px 'DM Mono',monospace;white-space:nowrap}.iac-stats,.iac-role,.iac-progress{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}.iac-stat,.iac-role-card,.iac-progress-card{padding:13px;border:1px solid #e2eaf4;border-radius:13px;background:#fbfdff}.iac-stat{cursor:pointer;text-align:left}.iac-stat span,.iac-stat strong,.iac-role-card span,.iac-role-card strong,.iac-progress-card span,.iac-progress-card strong{display:block}.iac-stat span,.iac-role-card span,.iac-progress-card span{color:#71809a;font-size:10px}.iac-stat strong,.iac-role-card strong,.iac-progress-card strong{margin-top:7px;color:#1769d2;font:700 24px 'DM Mono',monospace}.iac-alert strong{color:#c45d42}.iac-today strong{color:#b17b16}.iac-done strong{color:#3d8b68}.iac-attention{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px;border:1px solid #f0d5b6;border-radius:13px;background:#fff9ef}.iac-attention strong{color:#9a5d22;font-size:12px}.iac-attention p{margin:4px 0;color:#8a704f;font-size:10px}.iac-tools{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.iac-tools input{flex:1 1 240px;padding:10px 12px;border:1px solid #dbe5f1;border-radius:9px;color:#243856;font-size:11px}.iac-filter.active,.iac-origin.active,.iac-toggle.active{color:#fff;background:#1769d2}.iac-origins{display:flex;gap:6px;overflow:auto;margin-top:9px;padding-bottom:2px}.iac-origin{white-space:nowrap}.iac-list{display:grid;gap:10px;margin-top:14px}.iac-card{padding:15px;border:1px solid #e0e8f2;border-radius:14px;background:#fff}.iac-card.overdue{border-color:#e6b0a6;background:#fff9f8}.iac-card.completed{opacity:.72}.iac-card-top,.iac-card-meta,.iac-card-actions{display:flex;align-items:center;justify-content:space-between;gap:9px}.iac-card-top{color:#1769d2;font:10px 'DM Mono',monospace;text-transform:uppercase}.iac-priority{color:#71809a;font:10px 'DM Sans',sans-serif;text-transform:none}.iac-card h3{margin:8px 0 4px;color:#203a64;font:700 18px 'Playfair Display',serif}.iac-card p{margin:0;color:#71809a;font-size:11px;line-height:1.5}.iac-card-meta{justify-content:flex-start;flex-wrap:wrap;margin-top:10px;color:#71809a;font-size:10px}.iac-due.overdue{color:#b64d3e}.iac-due.today{color:#b17b16}.iac-due.completed{color:#3d8b68}.iac-status{padding:5px 8px;border-radius:999px;color:#1769d2;background:#edf5ff;font-size:9px;font-weight:700}.iac-status.overdue{color:#a63f35;background:#fff0ed}.iac-status.completed{color:#277251;background:#eaf7f0}.iac-status.today{color:#91620e;background:#fff6d9}.iac-status.in_progress{color:#6759a1;background:#f2efff}.iac-card-actions{justify-content:flex-start;margin-top:13px}.iac-calendar{display:grid;gap:8px;margin-top:13px}.iac-day{display:grid;grid-template-columns:70px 1fr;gap:12px;padding:10px 0;border-top:1px solid #edf1f6}.iac-day:first-child{border-top:0}.iac-day-date{color:#1769d2;font:700 11px 'DM Mono',monospace}.iac-day-items{display:grid;gap:5px}.iac-day-item{display:flex;justify-content:space-between;gap:8px;border:0;background:transparent;color:#29436a;text-align:left;font-size:11px;cursor:pointer}.iac-empty,.iac-loading{padding:25px;text-align:center;color:#71809a;font-size:11px}.iac-empty strong{display:block;margin-bottom:5px;color:#3d8b68;font:700 18px 'Playfair Display',serif}.iac-bar{height:7px;margin-top:13px;border-radius:99px;background:#eaf0f7;overflow:hidden}.iac-bar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#4e9577,#1769d2)}@media(max-width:900px){.iac-stats,.iac-role,.iac-progress{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){#activityCenterView .iac-hero{display:block;padding:18px}.iac-art{width:100%;height:70px;margin-top:13px}.iac-head{display:block}.iac-chip{display:inline-block;margin-top:8px}.iac-stats,.iac-role,.iac-progress{grid-template-columns:1fr}.iac-attention{display:block}.iac-attention .iac-action{width:100%}.iac-card-actions{align-items:stretch;flex-direction:column}.iac-card-actions button{width:100%}.iac-tools{display:grid}.iac-day{grid-template-columns:1fr}}`;document.head.appendChild(s)}
      async function load(){state.loading=true;render();const items=sample(),c=db();if(c&&typeof currentUser!=='undefined'&&currentUser){try{const {data}=await c.from('school_activities').select('id,title,subject,description,due_date,classes(year,class_code)').order('published_at',{ascending:false}).limit(60);(data||[]).forEach(item=>items.push({id:`school:${item.id}`,subject:item.subject||'Atividade escolar',title:item.title,description:item.description||'Atividade publicada pela escola.',due:item.due_date,origin:'school',defaultStatus:'pending',priority:'normal',owner:'Equipe pedagógica',classLabel:item.classes?.class_code?`${item.classes.year}º ano ${item.classes.class_code}`:'Turma vinculada'}))}catch{state.error='Algumas atividades da escola não puderam ser carregadas.'}}state.items=items;state.loaded=true;state.loading=false;render()}
      function filtered(){const f=state.filters,t=f.query.toLocaleLowerCase('pt-BR');return [...state.items].filter(item=>{const st=status(item),text=`${item.subject} ${item.title} ${item.description} ${item.owner}`.toLocaleLowerCase('pt-BR');if(t&&!text.includes(t)||f.origin!=='all'&&item.origin!==f.origin)return false;if(f.status==='pending'&&!active(item)||f.status==='today'&&st!=='today'||f.status==='upcoming'&&st!=='upcoming'||f.status==='overdue'&&st!=='overdue'||f.status==='in_progress'&&st!=='in_progress'||f.status==='completed'&&st!=='completed')return false;return true}).sort((a,b)=>({overdue:0,today:1,upcoming:2,in_progress:3,pending:4,completed:5}[status(a)]-{overdue:0,today:1,upcoming:2,in_progress:3,pending:4,completed:5}[status(b)])||String(a.due||'9999').localeCompare(String(b.due||'9999')))}
      const card=item=>{const m=meta(item),st=status(item);return `<article class="iac-card ${st}"><div class="iac-card-top"><span>${m[0]} ${m[1]}</span><b class="iac-priority">${priority(item.priority)}</b></div><h3>${esc(item.subject)} · ${esc(item.title)}</h3><p>${esc(item.description)}</p><div class="iac-card-meta"><span>📅 <b class="iac-due ${st}">${item.due?`${date(item.due)} · ${label(item).toLowerCase()}`:'Sem prazo'}</b></span><span>👤 ${esc(item.owner||'Equipe escolar')}</span>${item.classLabel?`<span>🏫 ${esc(item.classLabel)}</span>`:''}</div>${item.progress?`<div class="iac-card-meta"><span>Progresso: <b>${esc(item.progress)}</b></span></div>`:''}<div class="iac-card-actions"><span class="iac-status ${st}">${label(item)}</span><button class="iac-small" type="button" data-iac-open="${esc(item.id)}">Ver atividade</button>${st==='completed'?'':'<button class="iac-small" type="button" data-iac-done="'+esc(item.id)+'">Marcar concluída</button>'}</div></article>`};
      function render(){const el=root();if(!el)return;css();const all=state.items,items=filtered(),pending=all.filter(active).length,today=all.filter(i=>status(i)==='today').length,next=all.filter(i=>status(i)==='upcoming').length,done=all.filter(i=>status(i)==='completed').length,late=all.filter(i=>status(i)==='overdue').length,rate=all.length?Math.round(done/all.length*100):0,name=typeof currentProfile!=='undefined'&&currentProfile?.full_name?currentProfile.full_name.split(/\s+/)[0]:'estudante';const roleValue=typeof currentProfile!=='undefined'?currentProfile?.role:'parent';el.innerHTML=`<div class="bfr-ac-inline"><section class="iac-hero"><div><div class="eyebrow">Organização acadêmica · BFR Conecta</div><h1>🎯 Central de Atividades</h1><p>Olá, ${esc(name)}! 👋<br>Veja tudo o que precisa da sua atenção.</p><button class="iac-action" data-iac-explore>Ver atividades</button></div><div class="iac-art">🎯</div></section><div class="iac-stats"><button class="iac-stat iac-alert" data-iac-status="pending"><span>🔴 Pendentes</span><strong>${pending}</strong></button><button class="iac-stat iac-today" data-iac-status="today"><span>⚠️ Vence hoje</span><strong>${today}</strong></button><button class="iac-stat" data-iac-status="upcoming"><span>📅 Próximas</span><strong>${next}</strong></button><button class="iac-stat iac-done" data-iac-status="completed"><span>✅ Concluídas</span><strong>${done}</strong></button></div>${late||today?`<section class="iac-attention"><div><strong>🚨 ATENÇÃO</strong><p>${late?`${late} atividade${late===1?'':'s'} atrasada${late===1?'':'s'}`:`${today} atividade${today===1?'':'s'} vence hoje`}.</p></div><button class="iac-action" data-iac-status="${late?'overdue':'today'}">Ver agora</button></section>`:''}<section class="iac-panel"><div class="iac-head"><div><span class="iac-kicker">🔎 TAREFAS E COMPROMISSOS</span><h2>O que tenho para fazer?</h2><p>Atividades reunidas sem substituir suas áreas de origem.</p></div><span class="iac-chip">${state.loading?'carregando':'dados sincronizados'}</span></div><div class="iac-tools"><input type="search" data-iac-search value="${esc(state.filters.query)}" placeholder="🔎 Buscar atividade..." aria-label="Buscar atividade"><button class="iac-toggle" data-iac-view>${state.view==='calendar'?'☷ Lista':'📅 Calendário'}</button></div><div class="iac-tools">${[['all','Todas'],['pending','Pendentes'],['today','Hoje'],['upcoming','Próximas'],['overdue','Atrasadas'],['in_progress','Em andamento'],['completed','Concluídas']].map(f=>`<button class="iac-filter ${state.filters.status===f[0]?'active':''}" data-iac-status="${f[0]}">${f[1]}</button>`).join('')}</div><div class="iac-origins"><button class="iac-origin ${state.filters.origin==='all'?'active':''}" data-iac-origin="all">Todas as origens</button>${Object.entries(origins).map(([id,m])=>`<button class="iac-origin ${state.filters.origin===id?'active':''}" data-iac-origin="${id}">${m[0]} ${m[2]}</button>`).join('')}</div></section>${state.view==='calendar'?`<section class="iac-panel"><div class="iac-head"><div><span class="iac-kicker">📅 CALENDÁRIO DE ATIVIDADES</span><h2>Prazos da sua semana</h2><p>Clique em uma atividade para voltar à área de origem.</p></div></div><div class="iac-calendar">${Object.entries(all.filter(i=>i.due).reduce((groups,i)=>(groups[i.due]??=[]).push(i)&&groups,{})).sort().map(([d,g])=>`<div class="iac-day"><div class="iac-day-date">${date(d)}</div><div class="iac-day-items">${g.map(i=>`<button class="iac-day-item" data-iac-open="${i.id}"><span>${meta(i)[0]} ${esc(i.subject)}</span><b>${label(i)}</b></button>`).join('')}</div></div>`).join('')||'<div class="iac-empty">Nenhum prazo disponível no período.</div>'}</div></section>`:`<section class="iac-panel"><div class="iac-head"><div><span class="iac-kicker">📌 PRIORIDADE AUTOMÁTICA</span><h2>Atividades para sua atenção</h2><p>Atrasadas, hoje, amanhã, próximas, em andamento e concluídas.</p></div><span class="iac-chip">${items.length} item(ns)</span></div><div class="iac-list">${state.loading?'<div class="iac-loading">⏳ Carregando suas atividades...</div>':items.length?items.map(card).join(''):'<div class="iac-empty"><strong>🎉 Tudo em dia!</strong>Você não possui atividades pendentes para este filtro.</div>'}</div></section>`}${['pedagogical','developer'].includes(roleValue)?`<section class="iac-panel"><div class="iac-head"><div><span class="iac-kicker">👩‍🏫 PROFESSOR</span><h2>Minhas atividades</h2><p>A publicação continua usando o fluxo escolar existente.</p></div><button class="iac-action" data-iac-new>＋ Nova atividade</button></div><div class="iac-role"><div class="iac-role-card"><span>🟢 Entregues</span><strong>${done}</strong></div><div class="iac-role-card"><span>🟡 Em andamento</span><strong>${all.filter(i=>status(i)==='in_progress').length}</strong></div><div class="iac-role-card"><span>🔴 Pendentes</span><strong>${pending}</strong></div></div></section>`:`<section class="iac-panel"><div class="iac-head"><div><span class="iac-kicker">👨‍👩‍👧 ACOMPANHAMENTO</span><h2>Como está a semana escolar?</h2><p>Resumo simples das atividades visíveis para este perfil.</p></div></div><div class="iac-role"><div class="iac-role-card"><span>📚 Atividades</span><strong>${all.length}</strong></div><div class="iac-role-card"><span>🔴 Pendentes</span><strong>${pending}</strong></div><div class="iac-role-card"><span>⚠️ Atrasadas</span><strong>${late}</strong></div><div class="iac-role-card"><span>🟢 Concluídas</span><strong>${done}</strong></div></div></section>`}<section class="iac-panel"><div class="iac-head"><div><span class="iac-kicker">📊 MEU PROGRESSO</span><h2>Você está indo muito bem!</h2><p>Continue avançando sem comparações públicas.</p></div></div><div class="iac-bar"><i style="width:${rate}%"></i></div><div class="iac-progress"><div class="iac-progress-card"><span>Esta semana</span><strong>${all.length}</strong></div><div class="iac-progress-card"><span>Concluídas</span><strong>${done}</strong></div><div class="iac-progress-card"><span>Em andamento</span><strong>${all.filter(i=>status(i)==='in_progress').length}</strong></div><div class="iac-progress-card"><span>Progresso</span><strong>${rate}%</strong></div></div></section></div>`;el.querySelector('[data-iac-search]')?.addEventListener('input',e=>{state.filters.query=e.target.value;save();render();requestAnimationFrame(()=>document.querySelector('#activityCenterView [data-iac-search]')?.focus())});el.querySelectorAll('[data-iac-status]').forEach(b=>b.addEventListener('click',()=>{state.filters.status=b.dataset.iacStatus;save();render()}));el.querySelectorAll('[data-iac-origin]').forEach(b=>b.addEventListener('click',()=>{state.filters.origin=b.dataset.iacOrigin;save();render()}));el.querySelector('[data-iac-view]')?.addEventListener('click',()=>{state.view=state.view==='list'?'calendar':'list';save();render()});el.querySelectorAll('[data-iac-explore]').forEach(b=>b.addEventListener('click',()=>el.querySelector('.iac-panel')?.scrollIntoView({behavior:'smooth'})));el.querySelectorAll('[data-iac-open]').forEach(b=>b.addEventListener('click',()=>{const item=state.items.find(i=>i.id===b.dataset.iacOpen),route=origins[item?.origin]?.[3];if(route==='biblioteca'&&typeof window.bfrOpenReadingLibrary==='function')window.bfrOpenReadingLibrary();else if(route==='alimentacao'&&typeof window.bfrOpenHealthyFood==='function')window.bfrOpenHealthyFood();else if(typeof navigateToSection==='function')navigateToSection(route||'agenda')}));el.querySelectorAll('[data-iac-done]').forEach(b=>b.addEventListener('click',()=>{state.done[b.dataset.iacDone]=true;save();render()}));el.querySelector('[data-iac-new]')?.addEventListener('click',()=>document.querySelector('#addActivityBtn,[data-open-activity]')?.click())}
      function open(){const el=root();if(!el)return;document.querySelectorAll('#appShell .content').forEach(v=>v.classList.add('hidden'));el.classList.remove('hidden');render();const crumb=document.querySelector('.breadcrumb b');if(crumb)crumb.textContent='Central de Atividades';window.scrollTo({top:0,behavior:'auto'});if(!state.loaded&&!state.loading)load()};window.bfrOpenActivityCenter=open;window.bfrActivityCenter={open,render,load,storageKey:key};
    })();
  </script>
  <script id="bfr-platform-shell">
    (() => {
      const views={aprender:'platformLearnView',evoluir:'platformEvolveView',escola:'platformSchoolView','meu-espaco':'platformSpaceView'};
      const roleLabels={parent:'Responsável',student:'Aluno',pedagogical:'Professor',coordinator:'Coordenação',developer:'Administrador',director:'Direção',secretary:'Secretaria',aee:'Professor do AEE',monitor:'Monitor',gatekeeper:'Portaria'};
      const profile=()=>typeof currentProfile!=='undefined'?currentProfile:null;
      const userId=()=>typeof currentUser!=='undefined'&&currentUser?.id?currentUser.id:'anonymous';
      const key=name=>`bfr-platform-${name}-${userId()}`;
      const esc=value=>String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const store=(name,fallback)=>{try{return {...fallback,...JSON.parse(localStorage.getItem(key(name))||'{}')}}catch{return {...fallback}}};
      const write=(name,value)=>{try{localStorage.setItem(key(name),JSON.stringify(value))}catch{}};
      const defaultState={xp:180,streak:4,challengeDone:[],achievements:[],readNotices:[],quiz:{index:0,selected:null,correct:0,completed:0},trailStep:1,schoolTab:'overview',agendaMode:'week',spaceTab:'perfil',prefs:{notifications:true,weekly:true,compact:false},lastArea:'inicio'};
      const state=store('state',defaultState);let stateUser=userId();
      state.challengeDone ||= []; state.achievements ||= []; state.readNotices ||= []; state.quiz ||= {index:0,selected:null,correct:0,completed:0}; state.prefs ||= {notifications:true,weekly:true,compact:false};
      const save=()=>write('state',state);
      const levelFor=xp=>[{n:1,name:'Explorador',min:0,next:200},{n:2,name:'Aprendiz',min:200,next:450},{n:3,name:'Estudante',min:450,next:800},{n:4,name:'Destaque',min:800,next:1300},{n:5,name:'Mestre',min:1300,next:Infinity}].find(item=>xp>=item.min&&xp<item.next)||{n:5,name:'Mestre',min:1300,next:Infinity};
      const role=()=>profile()?.role||'parent', firstName=()=>String(profile()?.full_name||'Família BFR').split(/\s+/)[0], allowedStaff=()=>['pedagogical','coordinator','developer','director','secretary','aee'].includes(role()),
        manager=()=>['coordinator','developer','director'].includes(role());
      const xp=value=>{state.xp=Math.max(0,Number(state.xp||0)+value);syncAchievements();save();showToast(value>0?`+${value} XP recebido`:'Progresso atualizado')};
      const achievementDefs=[['first','🏅','Primeiro Passo','Comece uma atividade ou desafio.'],['reader','📚','Leitor','Visite sua biblioteca digital.'],['streak7','🔥','Sequência de 7 dias','Mantenha uma rotina de estudos.'],['focus','🎯','Foco Total','Conclua três etapas de uma trilha.'],['knowledge','🧠','Mestre do Conhecimento','Finalize três quizzes.'],['highlight','🏆','Destaque da Comunidade','Alcance 500 XP.']];
      function syncAchievements(){const unlocked=new Set(state.achievements);const conditions={first:state.xp>0,reader:state.achievements.includes('reader')||state.readNotices.length>0,streak7:Number(state.streak)>=7,focus:Number(state.trailStep)>=3,knowledge:Number(state.quiz.completed)>=3,highlight:Number(state.xp)>=500};Object.entries(conditions).forEach(([id,ok])=>{if(ok&&!unlocked.has(id)){state.achievements.push(id);showToast(`${achievementDefs.find(item=>item[0]===id)?.[1]||'🏅'} Conquista desbloqueada`)}})}
      function showToast(message){let toast=document.getElementById('bfr-platform-toast');if(!toast){toast=document.createElement('div');toast.id='bfr-platform-toast';toast.setAttribute('role','status');document.body.appendChild(toast)}toast.textContent=message;toast.classList.add('is-visible');clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>toast.classList.remove('is-visible'),2600)}
       function setAreaActive(area){document.querySelectorAll('.nav-item[data-section]').forEach(item=>item.classList.remove('active'));document.querySelectorAll('[data-platform-area]').forEach(item=>item.classList.toggle('active',item.dataset.platformArea===area));document.querySelectorAll('.bfr-platform-nav-item').forEach(item=>item.setAttribute('aria-current',item.dataset.platformArea===area?'page':'false'))}
      function hideAll(){document.querySelectorAll('#appShell .content').forEach(view=>view.classList.add('hidden'))}
      function openLegacy(section){const button=document.querySelector(`.bfr-legacy-nav [data-section="${section}"]`);if(button){button.click();return}if(section==='biblioteca'&&typeof window.bfrOpenReadingLibrary==='function')window.bfrOpenReadingLibrary();if(section==='atividades'&&typeof window.bfrOpenActivityCenter==='function')window.bfrOpenActivityCenter()}
      function button(label,action,extra=''){return `<button type="button" class="bfr-platform-button ${extra}" data-platform-action="${action}">${label}</button>`}
      function hero(icon,title,copy){return `<section class="bfr-platform-hero"><div><div class="eyebrow">BFR Conecta · Escola conectando pessoas</div><h1>${title}</h1><p>${copy}</p></div><div class="bfr-platform-hero-art" aria-hidden="true">${icon}</div></section>`}
      function panel(title,copy,body){return `<section class="bfr-platform-panel"><h2>${title}</h2>${copy?`<p>${copy}</p>`:''}${body||''}</section>`}
       const resources=[['atividades','🎯','Central de Atividades','Prazos, progresso, disciplina e XP.','legacy:atividades'],['biblioteca','📚','Biblioteca','Livros, acervo da escola e continue sua leitura.','legacy:biblioteca'],['quiz','📝','Quiz Interativo','Pergunte, responda, receba feedback e avance.','learn:quiz'],['trilhas','🧠','Trilhas de Aprendizagem','Uma jornada em etapas, com desbloqueios.','learn:trilhas'],['lab','🧪','Laboratório de Ciências','Experimentos seguros e explicações científicas.','learn:lab'],['arte','🎨','Arte e Cultura','Crie, observe e compartilhe repertórios.','learn:arte'],['mundo','🌎','Mundo e Atualidades','Conecte a escola ao que acontece no mundo.','learn:mundo']];
      const quizQuestions=[{q:'Qual atitude ajuda a tornar uma notícia mais confiável?',o:['Conferir a fonte e a data','Compartilhar sem ler','Escolher o título mais chamativo'],a:0,e:'A fonte e a data ajudam a verificar contexto e credibilidade.'},{q:'Verdadeiro ou falso: a água pode mudar de estado físico.',o:['Verdadeiro','Falso'],a:0,e:'A água pode ser sólida, líquida ou gasosa.'},{q:'Qual fração representa metade?',o:['1/2','1/3','3/4'],a:0,e:'Duas partes iguais, com uma escolhida, formam 1/2.'}];
      function renderLearnDetail(){const tab=state.learnTab||'overview';if(tab==='quiz')return renderQuiz();if(tab==='trilhas')return renderTrail();if(tab==='lab')return renderLab();const info={arte:['🎨 Arte e Cultura','A escola também aprende quando cria, observa e escuta.','Oficinas de desenho, música, memória da comunidade e curadoria de referências.'],mundo:['🌎 Mundo e Atualidades','Leia o mundo com curiosidade, respeito e pensamento crítico.','Rodas de conversa, notícias para jovens e desafios de cidadania digital.']}[tab];return info?panel(info[0],info[1],`<div class="bfr-platform-list"><article><div><strong>Próxima experiência</strong><span>${info[2]}</span></div><span class="bfr-platform-badge">em breve</span></article><article><div><strong>Como participar</strong><span>Escolha uma atividade e registre uma reflexão no seu histórico.</span></div><span class="bfr-platform-badge good">aberto</span></article></div>${button('Voltar para Aprender','learn:overview','ghost')}`):''}
      function renderQuiz(){const q=quizQuestions[state.quiz.index];if(!q)return panel('Resultado do quiz','Seu desempenho fica salvo nesta conta.',`<div class="bfr-platform-stat-grid"><div class="bfr-platform-stat"><span>Acertos</span><strong>${state.quiz.correct}</strong><small>de ${quizQuestions.length}</small></div><div class="bfr-platform-stat"><span>Percentual</span><strong>${Math.round(state.quiz.correct/quizQuestions.length*100)}%</strong><small>aproveitamento</small></div><div class="bfr-platform-stat"><span>Quizzes</span><strong>${state.quiz.completed}</strong><small>finalizados</small></div></div>${button('Tentar novamente','quiz:reset','primary')} ${button('Voltar para Aprender','learn:overview','ghost')}`);const selected=state.quiz.selected;return panel(`📝 Quiz · Questão ${state.quiz.index+1} de ${quizQuestions.length}`,'Responda no seu ritmo. O feedback aparece antes da próxima pergunta.',`<div class="bfr-quiz-question"><h3>${q.q}</h3><div class="bfr-quiz-options">${q.o.map((option,index)=>`<button type="button" class="bfr-quiz-option ${selected===index?'is-selected':''}" data-quiz-answer="${index}" ${selected!==null?'disabled':''}>${String.fromCharCode(65+index)}. ${option}</button>`).join('')}</div>${selected!==null?`<div class="bfr-quiz-feedback ${selected===q.a?'':'is-error'}">${selected===q.a?'✅ Correto! ':'💡 Quase lá. '}${q.e}</div><div class="bfr-platform-actions">${button(state.quiz.index===quizQuestions.length-1?'Ver resultado':'Próxima pergunta','quiz:next','primary')}</div>`:''}</div>`)}
      function renderTrail(){const steps=[['Introdução','Conheça o tema e formule uma pergunta.'],['Conteúdo','Explore um texto, vídeo ou material da escola.'],['Atividade','Pratique e registre uma descoberta.'],['Quiz','Verifique o que você aprendeu.'],['Desafio','Aplique o conhecimento em uma situação real.'],['Conclusão','Compartilhe sua síntese com a comunidade.']];return panel('🧠 Trilha de Português','Uma jornada educativa com etapas liberadas progressivamente.',`<div class="bfr-platform-progress"><i style="width:${Math.min(100,Math.round((state.trailStep-1)/(steps.length-1)*100))}%"></i></div><div class="bfr-platform-list">${steps.map((item,index)=>{const done=index<state.trailStep,locked=index>state.trailStep;return `<article class="bfr-trail-step ${done?'is-done':''} ${locked?'is-locked':''}"><span class="bfr-trail-dot">${done?'✓':index+1}</span><div><strong>${item[0]}</strong><small>${item[1]}</small></div>${locked?'<span class="bfr-platform-badge">bloqueada</span>':done?'<span class="bfr-platform-badge good">concluída</span>':`<button type="button" data-trail-complete>Concluir</button>`}</article>`}).join('')}</div>${button('Voltar para Aprender','learn:overview','ghost')}`)}
      function renderLab(){const experiments=[['🫁','Corpo humano','Observe como respiração e movimento mudam o corpo.'],['🌱','Meio ambiente','Investigue uma ação simples para cuidar da escola.'],['⚡','Energia','Compare fontes de energia e seus usos cotidianos.']];return panel('🧪 Laboratório de Ciências','Experimentos para aprender com segurança: objetivo, materiais, procedimento e explicação.',`<div class="bfr-platform-grid">${experiments.map(item=>`<article class="bfr-platform-card"><div class="bfr-card-icon">${item[0]}</div><h3>${item[1]}</h3><p>${item[2]}</p><button type="button" class="bfr-card-link" data-lab-open="${item[1]}">Abrir experimento ↗</button></article>`).join('')}</div>${button('Voltar para Aprender','learn:overview','ghost')}`)}
      function renderLearn(){const detail=state.learnTab&&state.learnTab!=='overview';const body=detail?renderLearnDetail():`<div class="bfr-platform-grid">${resources.map(item=>`<article class="bfr-platform-card bfr-resource-card"><div class="bfr-card-icon">${item[1]}</div><h3>${item[2]}</h3><p>${item[3]}</p><button type="button" class="bfr-card-link" data-platform-action="${item[4]}">Abrir recurso ↗</button></article>`).join('')}</div>${panel('Percurso recomendado','Comece por uma atividade, avance para um quiz e registre sua evolução.',`<div class="bfr-platform-stat-grid"><div class="bfr-platform-stat"><span>Atividades</span><strong>03</strong><small>para sua atenção</small></div><div class="bfr-platform-stat"><span>Trilhas</span><strong>01</strong><small>em andamento</small></div><div class="bfr-platform-stat"><span>XP disponível</span><strong>120</strong><small>nesta semana</small></div><div class="bfr-platform-stat"><span>Conquistas</span><strong>${state.achievements.length}</strong><small>desbloqueadas</small></div></div>`)}`;document.getElementById(views.aprender).innerHTML=`<div class="bfr-platform-view">${hero('🎓','Aprender','Conteúdos, desafios e experiências para aprender no seu ritmo, dentro e fora da sala de aula.')}<div class="bfr-platform-toolbar"><div><h2>${detail?'Aprender · '+({quiz:'Quiz Interativo',trilhas:'Trilhas de Aprendizagem',lab:'Laboratório de Ciências',arte:'Arte e Cultura',mundo:'Mundo e Atualidades'}[state.learnTab]||'Recurso'):'Escolha seu próximo passo'}</h2><p>${detail?'Continue sua jornada e registre o que descobriu.':'Recursos organizados para transformar curiosidade em aprendizagem.'}</p></div>${detail?button('Todos os recursos','learn:overview','ghost'):''}</div>${body}</div>`}
       const challenges=[['activity','🎯','Concluir uma atividade','Abra a Central e marque uma tarefa como concluída.'],['quiz','📝','Responder um quiz','Finalize uma rodada de perguntas.'],['reading','📚','Continuar uma leitura','Visite a Biblioteca e escolha um livro.'],['agenda','📅','Conferir a agenda','Veja os próximos compromissos da escola.']];
      function renderEvolve(){syncAchievements();const level=levelFor(state.xp),range=level.next===Infinity?100:level.next-level.min,pct=level.next===Infinity?100:Math.min(100,Math.round((state.xp-level.min)/range*100));document.getElementById(views.evoluir).innerHTML=`<div class="bfr-platform-view">${hero('🏆','Evoluir','Acompanhe conquistas, sequência de estudos, XP e sua evolução sem comparações públicas.')}<div class="bfr-platform-stat-grid"><div class="bfr-platform-stat"><span>Nível ${level.n}</span><strong>${level.name}</strong><small>${state.xp} XP acumulados</small></div><div class="bfr-platform-stat"><span>Sequência</span><strong>🔥 ${state.streak}</strong><small>dias de estudo</small></div><div class="bfr-platform-stat"><span>Desafios</span><strong>${state.challengeDone.length}</strong><small>concluídos</small></div><div class="bfr-platform-stat"><span>Conquistas</span><strong>${state.achievements.length}</strong><small>desbloqueadas</small></div></div>${panel('Progresso para o próximo nível',`${level.next===Infinity?'Você alcançou o nível máximo.':`${level.next-state.xp} XP para ${level.n+1} · ${level.n<5?['Explorador','Aprendiz','Estudante','Destaque','Mestre'][level.n]:'Mestre'}`}`,`<div class="bfr-platform-progress"><i style="width:${pct}%"></i></div>`)}<div class="bfr-quiz-layout">${panel('🎯 Desafios de hoje','Pequenos passos, grandes descobertas.',`<div class="bfr-platform-list">${challenges.map(item=>`<article><div><strong>${item[1]} ${item[2]}</strong><span>${item[3]}</span></div>${state.challengeDone.includes(item[0])?'<span class="bfr-platform-badge good">feito</span>':`<button type="button" class="bfr-platform-button" data-challenge="${item[0]}">Fazer agora</button>`}</article>`).join('')}</div>`)}${panel('🏅 Conquistas','Medalhas que reconhecem seu percurso.',`<div class="bfr-achievement-grid">${achievementDefs.map(item=>`<article class="bfr-achievement ${state.achievements.includes(item[0])?'':'is-locked'}"><div class="bfr-achievement-icon">${item[1]}</div><strong>${item[2]}</strong><span>${item[3]}</span></article>`).join('')}</div>`)}</div></div>`}
      const announcements=[['a1','Urgente','Reunião de responsáveis','A direção convida as famílias para conversar sobre os próximos passos da turma.','20 nov · 18h30 · Auditório',true],['a2','Acadêmico','Biblioteca ganhou novos livros','Mais de 120 títulos chegaram para as turmas neste mês.','Publicado ontem',false],['a3','Projeto','Feira de Ciências','As turmas apresentam suas descobertas, protótipos e perguntas para a comunidade.','14 nov · 14h30 · Ginásio',false]];
      const events=[['14 nov','Feira de Ciências','14h30 · Ginásio','Projeto escolar'],['20 nov','Reunião de responsáveis','18h30 · Auditório','Comunidade'],['22 nov','Dia da Família','09h00 · Quadra','Convivência'],['28 nov','Mostra cultural','15h00 · Escola','Arte e cultura'],['03 dez','Avaliação de Matemática','Durante a aula','6º ano A']];
      const projectPhases=['Ideia','Planejamento','Desenvolvimento','Apresentação','Concluído'];
      function schoolTabBody(){const tab=state.schoolTab||'overview';if(tab==='announcements')return panel('📢 Mural de Avisos','Comunicados organizados por prioridade e origem.',announcements.map(item=>`<article class="bfr-announce ${item[5]?'is-urgent':''}"><h3>${item[5]?'🚨 ':''}${item[2]}</h3><p>${item[3]}</p><small>${item[1]} · ${item[4]}</small><button type="button" data-ann-read="${item[0]}">${state.readNotices.includes(item[0])?'✓ Aviso lido':'Marcar como lido'}</button></article>`).join(''));if(tab==='agenda')return panel('📅 Agenda Escolar','Provas, trabalhos, reuniões, passeios e projetos em um só lugar.',`<div class="bfr-subnav">${['today','week','month'].map(mode=>`<button type="button" class="${state.agendaMode===mode?'is-active':''}" data-agenda-mode="${mode}">${mode==='today'?'Hoje':mode==='week'?'Semana':'Mês'}</button>`).join('')}</div><div class="bfr-calendar-grid">${events.map(item=>`<article class="bfr-calendar-event"><strong>${item[0]} · ${item[1]}</strong><span>${item[2]}<br>${item[3]}</span></article>`).join('')}</div>${button('Abrir agenda existente','legacy:agenda','primary')}`);if(tab==='projects')return panel('💡 Projetos Escolares','Acompanhe a jornada de um projeto da escola.',`<div class="bfr-platform-list">${projectPhases.map((phase,index)=>`<article><div><strong>${index+1}. ${phase}</strong><span>${index<2?'Etapa disponível para a comunidade escolar.':index===2?'Em desenvolvimento pelas turmas.':'Registros publicados pela escola.'}</span></div><span class="bfr-platform-badge ${index===2?'warn':index<2?'good':''}">${index<2?'concluída':index===2?'em andamento':'próxima'}</span></article>`).join('')}</div>${button('Ver projetos da escola','legacy:experiencias','primary')}`);if(tab==='gallery')return panel('📷 Momentos da Escola','Galeria institucional com publicação controlada pela equipe autorizada.',`<div class="bfr-platform-grid"><article class="bfr-platform-card"><div class="bfr-card-icon">🌱</div><h3>Horta da escola</h3><p>Projetos, oficinas e registros de aprendizagem.</p></article><article class="bfr-platform-card"><div class="bfr-card-icon">🎭</div><h3>Cultura e esportes</h3><p>Momentos de participação e convivência.</p></article><article class="bfr-platform-card"><div class="bfr-card-icon">🚌</div><h3>Passeios e eventos</h3><p>Memórias compartilhadas com privacidade.</p></article></div>${allowedStaff()?button('Gerenciar no módulo escolar','legacy:experiencias','primary'):'<p class="agenda-intro">Uploads ficam disponíveis somente nos módulos autorizados da escola.</p>'}`);if(tab==='life')return panel('🏫 Vida Escolar','A história, a equipe e os combinados da Escola Benício Ferreira Reis.',`<div class="bfr-platform-list"><article><div><strong>Escola conectando pessoas</strong><span>Uma comunidade que aprende com cuidado, participação e respeito.</span></div><span class="bfr-platform-badge good">BFR</span></article><article><div><strong>Horários e documentos</strong><span>Consulte calendários, turnos, regras e contatos oficiais.</span></div>${button('Abrir horários','legacy:horarios','ghost')}</article><article><div><strong>Equipe e projetos</strong><span>Conheça as experiências que aproximam escola e famílias.</span></div>${button('Ver experiências','legacy:experiencias','ghost')}</article></div>`);return `<div class="bfr-platform-grid"><article class="bfr-platform-card"><div class="bfr-card-icon">📢</div><h3>Últimos avisos</h3><p>${announcements.length} comunicados disponíveis, incluindo ${announcements.filter(item=>item[5]).length} urgente.</p><button type="button" class="bfr-card-link" data-platform-action="school:announcements">Ver mural ↗</button></article><article class="bfr-platform-card"><div class="bfr-card-icon">📅</div><h3>Próximos compromissos</h3><p>${events.slice(0,3).map(item=>item[1]).join(' · ')}</p><button type="button" class="bfr-card-link" data-platform-action="school:agenda">Ver agenda ↗</button></article><article class="bfr-platform-card"><div class="bfr-card-icon">💡</div><h3>Projetos escolares</h3><p>Ideias, desenvolvimento, apresentações e participação.</p><button type="button" class="bfr-card-link" data-platform-action="school:projects">Acompanhar ↗</button></article><article class="bfr-platform-card"><div class="bfr-card-icon">📷</div><h3>Momentos da escola</h3><p>Álbuns e destaques publicados com controle de privacidade.</p><button type="button" class="bfr-card-link" data-platform-action="school:gallery">Abrir galeria ↗</button></article></div>${panel('Participar também é aprender','Acesse as áreas existentes sem perder a experiência integrada.',`${button('Agenda existente','legacy:agenda')} ${button('Avisos existentes','legacy:comunicados')} ${button('Horários','legacy:horarios')} ${button('Vida escolar','school:life','ghost')}`)}`}
      function renderSchool(){document.getElementById(views.escola).innerHTML=`<div class="bfr-platform-view">${hero('🏫','Escola','Comunicados, agenda, projetos e momentos que fortalecem o sentimento de pertencer.')}<div class="bfr-subnav">${[['overview','Visão geral'],['announcements','Mural de Avisos'],['agenda','Agenda'],['projects','Projetos'],['gallery','Momentos'],['life','Vida Escolar']].map(item=>`<button type="button" class="${state.schoolTab===item[0]?'is-active':''}" data-school-tab="${item[0]}">${item[1]}</button>`).join('')}</div>${schoolTabBody()}</div>`}
      function renderSpace(){syncAchievements();const name=profile()?.full_name||'Família BFR',label=roleLabels[role()]||'Comunidade escolar';document.getElementById(views['meu-espaco']).innerHTML=`<div class="bfr-platform-view">${hero('👤','Meu Espaço','Seu perfil, preferências, notificações, histórico e conquistas em um só lugar.')}<div class="bfr-space-layout">${panel('Minha conta','Dados e preferências da sua experiência.',`<div class="bfr-profile-card"><div class="bfr-profile-avatar">${esc(name.split(/\s+/).map(item=>item[0]).slice(0,2).join('').toUpperCase())}</div><div><strong>${esc(name)}</strong><span>${esc(label)} · BFR Conecta</span></div></div><div class="bfr-platform-list"><article><div><strong>Minhas conquistas</strong><span>${state.achievements.length} medalhas desbloqueadas.</span></div><span class="bfr-platform-badge good">ver abaixo</span></article><article><div><strong>Histórico de aprendizagem</strong><span>${state.quiz.completed} quiz(s), ${state.challengeDone.length} desafio(s) e uma trilha em andamento.</span></div><span class="bfr-platform-badge">ativo</span></article></div>`)}${panel('⚙️ Preferências','Escolha como o BFR Conecta conversa com você.',`<div class="bfr-toggle-row"><div><strong>Notificações importantes</strong><small>Novas atividades, avisos e prazos.</small></div><button type="button" class="bfr-toggle ${state.prefs.notifications?'is-on':''}" data-space-pref="notifications" aria-pressed="${state.prefs.notifications}"><i></i></button></div><div class="bfr-toggle-row"><div><strong>Resumo semanal</strong><small>Receba um resumo da sua evolução.</small></div><button type="button" class="bfr-toggle ${state.prefs.weekly?'is-on':''}" data-space-pref="weekly" aria-pressed="${state.prefs.weekly}"><i></i></button></div><div class="bfr-toggle-row"><div><strong>Modo compacto</strong><small>Reduz espaçamentos em telas menores.</small></div><button type="button" class="bfr-toggle ${state.prefs.compact?'is-on':''}" data-space-pref="compact" aria-pressed="${state.prefs.compact}"><i></i></button></div>`)} </div>${panel('🔔 Minhas notificações','Alertas centralizados para não perder o que importa.',`<div class="bfr-platform-list"><article><div><strong>🎯 ${state.challengeDone.length?'Seu desafio continua':'Nova atividade disponível'}</strong><span>Confira sua Central de Atividades e veja o próximo passo.</span></div><span class="bfr-platform-badge ${state.prefs.notifications?'warn':''}">${state.prefs.notifications?'nova':'pausada'}</span></article><article><div><strong>📅 Próximo compromisso</strong><span>${events[0][0]} · ${events[0][1]} · ${events[0][2]}</span></div><span class="bfr-platform-badge">agenda</span></article></div>`)}${panel('🏅 Minhas conquistas','Seu percurso é individual, visível e feito de pequenas vitórias.',`<div class="bfr-achievement-grid">${achievementDefs.map(item=>`<article class="bfr-achievement ${state.achievements.includes(item[0])?'':'is-locked'}"><div class="bfr-achievement-icon">${item[1]}</div><strong>${item[2]}</strong><span>${item[3]}</span></article>`).join('')}</div>`)}${allowedStaff()?panel('👨‍🏫 Espaços autorizados','Recursos adicionais aparecem apenas para o perfil correspondente.',`${button('Espaço do Professor','legacy:cadastro-alunos')} ${manager()?button('Central de Gestão','legacy:administracao','primary'):''}`):''}</div>`}
       function renderHomeDock(){const host=document.querySelector('#appShell .content:not(.hidden)');if(!host||profile()?.role==='director'||host.querySelector('#bfrHomeDock'))return;const anchor=host.querySelector('.welcome,.teacher-welcome,.coordinator-welcome,.director-welcome,.monitor-welcome,.gate-welcome,.secretary-hero');if(!anchor)return;const name=firstName();anchor.insertAdjacentHTML('afterend',`<section class="bfr-platform-panel" id="bfrHomeDock"><div class="bfr-platform-toolbar"><div><div class="eyebrow">Seu próximo passo · BFR Conecta</div><h2>Olá, ${esc(name)}! 👋</h2><p>O que você quer fazer hoje?</p></div><div class="bfr-platform-actions">${button('🎯 Atividades','legacy:atividades','primary')} ${button('🏆 Conquistas','area:evoluir')}</div></div><div class="bfr-platform-grid" style="margin-top:14px"><article class="bfr-platform-card"><div class="bfr-card-icon">📚</div><h3>Biblioteca</h3><p>Continue uma leitura e registre uma descoberta.</p><button type="button" class="bfr-card-link" data-platform-action="legacy:biblioteca">Abrir ↗</button></article><article class="bfr-platform-card"><div class="bfr-card-icon">📝</div><h3>Quiz</h3><p>Teste seus conhecimentos e ganhe XP.</p><button type="button" class="bfr-card-link" data-platform-action="area:aprender:quiz">Começar ↗</button></article><article class="bfr-platform-card"><div class="bfr-card-icon">📅</div><h3>Agenda</h3><p>${events[0][0]} · ${events[0][1]}.</p><button type="button" class="bfr-card-link" data-platform-action="legacy:agenda">Ver agenda ↗</button></article><article class="bfr-platform-card"><div class="bfr-card-icon">📢</div><h3>Últimos avisos</h3><p>${announcements[0][2]} · ${announcements[0][4]}.</p><button type="button" class="bfr-card-link" data-platform-action="area:escola:announcements">Ver mural ↗</button></article></div></section>`)}
      function open(area){if(area==='inicio'){state.lastArea='inicio';save();openLegacy('inicio');return}const id=views[area];if(!id)return;hideAll();document.getElementById(id).classList.remove('hidden');state.lastArea=area;save();setAreaActive(area);({aprender:renderLearn,evoluir:renderEvolve,escola:renderSchool,'meu-espaco':renderSpace}[area])();document.querySelector('.breadcrumb b').textContent={aprender:'Aprender',evoluir:'Evoluir',escola:'Escola','meu-espaco':'Meu Espaço'}[area];window.scrollTo({top:0,behavior:'auto'})}
       function action(value){const parts=String(value||'').split(':');if(parts[0]==='legacy'){openLegacy(parts[1]);return}if(parts[0]==='area'){if(window.BFRParentNavigationV2?.openArea?.(parts[1]))return;open(parts[1]);if(parts[2]){if(parts[1]==='aprender')state.learnTab=parts[2];save();renderLearn()}return}if(parts[0]==='learn'){state.learnTab=parts[1];save();renderLearn();return}if(parts[0]==='school'){state.schoolTab=parts[1];save();renderSchool();return}if(value==='quiz:reset'){state.quiz={index:0,selected:null,correct:0,completed:state.quiz.completed};save();renderLearn();return}if(value==='quiz:next'){state.quiz.index+=1;state.quiz.selected=null;if(state.quiz.index>=quizQuestions.length){state.quiz.completed+=1;state.quiz.index=quizQuestions.length;xp(25)}save();renderLearn();return}if(value==='learn:overview'){state.learnTab='overview';save();renderLearn();return}}
      document.addEventListener('click',event=>{const done=event.target.closest('[data-iac-done]');if(done)xp(20);const read=event.target.closest('[data-il-read]');if(read){if(!state.achievements.includes('reader'))state.achievements.push('reader');xp(10)}const target=event.target.closest('[data-platform-action]');if(target){event.preventDefault();action(target.dataset.platformAction);return}const legacy=event.target.closest('[data-platform-legacy]');if(legacy){event.preventDefault();openLegacy(legacy.dataset.platformLegacy)}} ,true);
      document.addEventListener('click',event=>{const tab=event.target.closest('[data-school-tab]');if(tab){state.schoolTab=tab.dataset.schoolTab;save();renderSchool();return}const agenda=event.target.closest('[data-agenda-mode]');if(agenda){state.agendaMode=agenda.dataset.agendaMode;save();renderSchool();return}const read=event.target.closest('[data-ann-read]');if(read){if(!state.readNotices.includes(read.dataset.annRead))state.readNotices.push(read.dataset.annRead);save();renderSchool();return}const answer=event.target.closest('[data-quiz-answer]');if(answer&&state.quiz.selected===null){state.quiz.selected=Number(answer.dataset.quizAnswer);if(state.quiz.selected===quizQuestions[state.quiz.index]?.a){state.quiz.correct+=1;xp(15)}else save();renderLearn();return}if(event.target.closest('[data-quiz-reset]')){action('quiz:reset');return}if(event.target.closest('[data-quiz-next]')){action('quiz:next');return}const trail=event.target.closest('[data-trail-complete]');if(trail){state.trailStep=Math.min(6,Number(state.trailStep||1)+1);xp(20);save();renderLearn();return}const lab=event.target.closest('[data-lab-open]');if(lab){showToast(`Experimento aberto: ${lab.dataset.labOpen}`);return}const challenge=event.target.closest('[data-challenge]');if(challenge&&!state.challengeDone.includes(challenge.dataset.challenge)){state.challengeDone.push(challenge.dataset.challenge);xp(20);save();if(challenge.dataset.challenge==='activity')openLegacy('atividades');else if(challenge.dataset.challenge==='quiz'){state.learnTab='quiz';open('aprender')}else if(challenge.dataset.challenge==='reading')openLegacy('biblioteca');else if(challenge.dataset.challenge==='agenda')openLegacy('agenda');renderEvolve()}
        const pref=event.target.closest('[data-space-pref]');if(pref){const name=pref.dataset.spacePref;state.prefs[name]=!state.prefs[name];save();renderSpace()}}
      ,true);
       document.addEventListener('click',event=>{const nav=event.target.closest('[data-platform-area]');if(!nav)return;event.preventDefault();event.stopImmediatePropagation();if(!window.BFRParentNavigationV2?.openArea?.(nav.dataset.platformArea))window.BFRPlatform?.open?.(nav.dataset.platformArea)},true);
       function boot(){if(stateUser!==userId()){Object.keys(state).forEach(item=>delete state[item]);Object.assign(state,store('state',defaultState));stateUser=userId()}syncAchievements();document.querySelectorAll('.bfr-platform-nav-item').forEach(item=>item.setAttribute('aria-current','false'));const app=document.getElementById('appShell');if(app?.classList.contains('ready')){if(profile()?.role!=='secretary')renderHomeDock();if(state.lastArea&&state.lastArea!=='inicio'&&!document.querySelector('#appShell .content:not(.hidden)[id^="platform"]'))open(state.lastArea)}else setTimeout(boot,450)}
      window.BFRPlatform={open,renderHomeDock,state,storageKey:key('state'),awardXp:xp};setTimeout(boot,500);
    })();
  </script>
  <script id="bfr-reading-integration">
    (() => {
       const root = () => document.getElementById('readingLibraryView');
       const privateBooks = {loaded:false,loading:false,items:[],error:'',userId:'',grade:'6'};
      const storageKey = () => `bfr-reading-focus-${typeof currentUser !== 'undefined' && currentUser?.id ? currentUser.id : 'anonymous'}`;
       const words = [
         ['Aventura','Uma experiência emocionante ou uma viagem cheia de acontecimentos.'],
         ['Descoberta','Algo novo que passa a ser conhecido ou compreendido.'],
         ['Corajoso','Quem enfrenta uma situação difícil com coragem.']
       ];
       const esc = value => String(value ?? '').replace(/[&<>'"]/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]));
      const load = () => { try { return JSON.parse(localStorage.getItem(storageKey()) || '{}'); } catch { return {}; } };
      let state = load();
      const save = () => { try { localStorage.setItem(storageKey(), JSON.stringify(state)); } catch {} };
      const speech = text => { if ('speechSynthesis' in window) { window.speechSynthesis.cancel(); window.speechSynthesis.speak(new SpeechSynthesisUtterance(text)); } };
      function style() {
        if (document.getElementById('bfr-reading-integration-style')) return;
        const style = document.createElement('style'); style.id = 'bfr-reading-integration-style';
         style.textContent = `.bfr-reading-quick-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.bfr-reading-quick-actions button,.bfr-reading-word button,.bfr-private-book button{border:1px solid #cfe0fb;border-radius:9px;padding:8px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:700;cursor:pointer}.bfr-reading-quick-actions button:hover,.bfr-reading-word button:hover,.bfr-private-book button:hover{color:#10295f;background:#eaf7f3;border-color:#8ccfc2}.bfr-reading-dictionary{margin-top:16px}.bfr-reading-words{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}.bfr-reading-word{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;padding:11px;border:1px solid #e2eaf4;border-radius:12px;background:#fbfdff}.bfr-reading-word strong,.bfr-reading-word span{display:block}.bfr-reading-word strong{color:#29436a;font-size:11px}.bfr-reading-word span{margin-top:4px;color:#71809a;font-size:10px;line-height:1.4}.bfr-reading-word-actions{display:flex;flex-direction:column;gap:5px}.bfr-reading-word-actions button{padding:6px 7px}.bfr-reading-word-actions .is-saved{color:#16826f;background:#eaf7f3;border-color:#bde5d4}.bfr-private-library{margin-top:16px}.bfr-private-books{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}.bfr-private-book{display:flex;flex-direction:column;align-items:flex-start;gap:7px;padding:13px;border:1px solid #dbe7f4;border-radius:13px;background:linear-gradient(145deg,#fbfdff,#f4f8ff)}.bfr-private-book strong{color:#29436a;font-size:12px;line-height:1.35}.bfr-private-book p{margin:0;min-height:31px;color:#71809a;font-size:10px;line-height:1.45}.bfr-private-book small{color:#1769d2;font:9px 'DM Mono',monospace}.bfr-private-book button{margin-top:auto}.bfr-private-note{color:#71809a;font-size:10px;line-height:1.5}.bfr-private-status{margin-top:10px;color:#64748b;font-size:10px}@media(max-width:700px){.bfr-reading-words,.bfr-private-books{grid-template-columns:1fr}.bfr-reading-quick-actions{display:grid;grid-template-columns:1fr 1fr}}`;
        document.head.appendChild(style);
       }
       function spaceStyle() { if (document.getElementById('bfr-reading-space-style')) return; const style = document.createElement('style'); style.id = 'bfr-reading-space-style'; style.textContent = `.bfr-reading-space-map{margin-top:16px}.bfr-reading-space-map .il-head{align-items:flex-start}.bfr-reading-space-map-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px;margin-top:14px}.bfr-reading-space-map button{display:flex;min-height:82px;flex-direction:column;align-items:flex-start;gap:5px;padding:12px;border:1px solid #dbe7f4;border-radius:13px;color:#29436a;background:#fbfdff;text-align:left;cursor:pointer;transition:transform .2s,border-color .2s,box-shadow .2s}.bfr-reading-space-map button:hover,.bfr-reading-space-map button:focus-visible{transform:translateY(-2px);border-color:#8dbcf5;box-shadow:0 10px 20px rgba(37,99,235,.1);outline:none}.bfr-reading-space-map button span{font-size:19px}.bfr-reading-space-map button strong{font-size:11px}.bfr-reading-space-map button small{color:#71809a;font-size:9px;line-height:1.35}.bfr-series-tabs{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}.bfr-series-tabs button{border:1px solid #dbe7f4;border-radius:999px;padding:8px 12px;color:#64748b;background:#fff;font-size:10px;font-weight:800;cursor:pointer}.bfr-series-tabs button.is-active{border-color:#2563eb;color:#fff;background:#2563eb;box-shadow:0 6px 13px rgba(37,99,235,.16)}.bfr-series-current{display:flex;align-items:center;gap:8px;margin-top:12px;color:#1769d2;font:10px 'DM Mono',monospace}.bfr-series-current i{display:block;width:8px;height:8px;border-radius:50%;background:#16a34a}@media(max-width:900px){.bfr-reading-space-map-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.bfr-reading-space-map-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-reading-space-map button{min-height:74px}}`; document.head.appendChild(style); }
        function ensureBookCategoryOption() { const categories = ['6º','7º','8º','9º'].map(year => `Biblioteca · ${year} ano`); document.querySelectorAll('[data-growth-document-form] select[name="category"]').forEach(select => categories.forEach(category => { if (![...select.options].some(option => option.value === category)) select.insertAdjacentHTML('beforeend', `<option>${category}</option>`); })); }
       function relabel() { ensureBookCategoryOption();
         document.querySelectorAll('.bfr-resource-card h3').forEach(title => { if (title.textContent.trim() === 'Biblioteca Digital') { title.textContent = 'Biblioteca'; const copy = title.parentElement.querySelector('p'); if (copy) copy.textContent = 'Acervo digital, livros da escola e sua jornada de leitura.'; } });
         document.querySelectorAll('#bfrHomeDock .bfr-platform-card h3').forEach(title => { if (title.textContent.trim() === 'Biblioteca') { const copy = title.parentElement.querySelector('p'); if (copy) copy.textContent = 'Acervo digital, livros físicos e novas leituras.'; } });
      }
       function dictionaryMarkup() { return `<section class="il-panel bfr-reading-dictionary" data-bfr-reading-dictionary><div class="il-head"><div><span class="il-kicker">🔤 MEU DICIONÁRIO</span><h2>Palavras que você descobriu</h2><p>Salve palavras novas e revise seus significados no seu ritmo.</p></div><span class="il-chip">vocabulário pessoal</span></div><div class="bfr-reading-words">${words.map(item => `<article class="bfr-reading-word"><div><strong>${item[0]}</strong><span>${item[1]}</span></div><div class="bfr-reading-word-actions"><button type="button" class="${(state.words || []).includes(item[0]) ? 'is-saved' : ''}" data-reading-word="${item[0]}">${(state.words || []).includes(item[0]) ? '✓ Salva' : '☆ Salvar'}</button><button type="button" aria-label="Ouvir ${item[0]}" data-reading-speak="${item[0]}">🔊</button></div></article>`).join('')}</div></section>`; }
        function spaceNavigationMarkup() { const items = [['#bfrLibraryExplore','🔎','Explorar Livros','Encontre uma nova história'],['#bfrReadingSeries','📚','Por Série','6º · 7º · 8º · 9º ano'],['#bfrReadingRecommended','⭐','Recomendados','Escolhas para você'],['#bfrMyReading','❤️','Meus Favoritos','O que você salvou'],['#bfrMyReading','📖','Continuar Lendo','Retome sua jornada'],['#bfrReadingActivities','🧠','Atividades de Leitura','Leia e compreenda'],['#bfrReadingChallenges','🎯','Desafios','Metas no seu ritmo'],['#bfrReadingWords','🔤','Novas Palavras','Expanda seu vocabulário'],['#bfrReadingAchievements','🏆','Minhas Conquistas','Celebre seus avanços'],['#bfrReadingProgress','📈','Meu Progresso','Veja sua evolução']]; return `<section class="il-panel bfr-reading-space-map" data-reading-space-map><div class="il-head"><div><span class="il-kicker">📚 SEÇÕES DO ESPAÇO DE LEITURA</span><h2>Escolha seu próximo caminho</h2><p>Explore livros, pratique, registre descobertas e acompanhe cada etapa da sua leitura.</p></div><span class="il-chip">leia · descubra · aprenda</span></div><div class="bfr-reading-space-map-grid">${items.map(item => `<button type="button" data-reading-space-target="${item[0]}"><span>${item[1]}</span><strong>${item[2]}</strong><small>${item[3]}</small></button>`).join('')}</div></section>`; }
        function privateBooksMarkup() { return `<section class="il-panel bfr-library-context" data-bfr-library-context><div class="il-head"><div><span class="il-kicker">📚 BIBLIOTECA VIRTUAL · LIMOEIRO DE ANADIA</span><h2>Leitura para aprender, imaginar e transformar</h2><p>O principal objetivo da biblioteca é apoiar, incrementar e fortalecer o projeto pedagógico das escolas, além de valorizar a leitura literária em seu cotidiano e proporcionar condições para que o educador faça uso coletivo do texto escrito. Dessa forma, é possível desenvolver e promover o acesso ao conhecimento disponível nos livros e o domínio crítico da linguagem entre seus alunos.</p><p>Ciente da importância de práticas de incentivo à leitura e da competência de leitura e escrita para o acesso ao conhecimento e desenvolvimento da consciência crítica, a Prefeitura Municipal de Limoeiro de Anadia - AL promove o projeto Biblioteca Virtual, em parceria com a Secretaria Municipal de Educação.</p></div><span class="il-chip">projeto institucional</span></div></section><section class="il-panel bfr-private-library" id="bfrReadingSeries" data-bfr-private-library><div class="il-head"><div><span class="il-kicker">📚 POR SÉRIE</span><h2>Biblioteca por série</h2><p>Escolha o ano escolar para encontrar a coleção indicada para cada turma.</p></div><span class="il-chip">acesso protegido</span></div><div class="bfr-series-tabs" role="tablist" aria-label="Livros por série"><button type="button" class="is-active" data-reading-grade="6" role="tab" aria-selected="true">6º ano</button><button type="button" data-reading-grade="7" role="tab" aria-selected="false">7º ano</button><button type="button" data-reading-grade="8" role="tab" aria-selected="false">8º ano</button><button type="button" data-reading-grade="9" role="tab" aria-selected="false">9º ano</button></div><div class="bfr-series-current"><i></i><span data-bfr-series-label>6º ano · coleção protegida</span></div><div data-bfr-private-list><p class="bfr-private-status">Carregando livros protegidos...</p></div></section>`; }
       function renderPrivateBooks() {
         const panel = root()?.querySelector('[data-bfr-private-library]'); if (!panel) return;
         const list = panel.querySelector('[data-bfr-private-list]'); if (!list) return;
         if (!currentUser) { list.innerHTML = '<p class="bfr-private-note">Entre na sua conta escolar para visualizar os livros disponíveis.</p>'; return; }
         if (privateBooks.loading) { list.innerHTML = '<p class="bfr-private-status">Carregando livros protegidos...</p>'; return; }
          if (privateBooks.error) { list.innerHTML = '<p class="bfr-private-note">A biblioteca protegida não pôde ser carregada nesta conta.</p>'; return; }
          root()?.querySelectorAll('[data-reading-grade]').forEach(button => { const active = button.dataset.readingGrade === privateBooks.grade; button.classList.toggle('is-active', active); button.setAttribute('aria-selected', String(active)); });
           const gradeItems = privateBooks.items.filter(item => item.category === `Biblioteca · ${privateBooks.grade}º ano`);
           const recommendations = root()?.querySelector('[data-bfr-eighth-recommendations]'); if (recommendations) recommendations.hidden = privateBooks.grade !== '8';
          const gradeLabel = root()?.querySelector('[data-bfr-series-label]'); if (gradeLabel) gradeLabel.textContent = `${privateBooks.grade}º ano · ${gradeItems.length ? 'coleção protegida' : 'coleção em preparação'}`;
          if (!gradeItems.length) { list.innerHTML = `<p class="bfr-private-note">A coleção do ${privateBooks.grade}º ano está em preparação pela equipe escolar. Em breve, novos títulos serão publicados aqui.</p>`; return; }
          list.innerHTML = `<div class="bfr-private-books">${gradeItems.map(item => `<article class="bfr-private-book"><small>${privateBooks.grade}º ANO · ${esc(item.category || 'LEITURA')}</small><strong>${esc(item.title)}</strong><p>${esc(item.description || 'Livro publicado pela escola.')}</p><button type="button" data-private-book="${esc(item.storage_path)}">🔐 Ler PDF</button></article>`).join('')}</div>`;
       }
       async function loadPrivateBooks() {
         const client = typeof supabaseClient !== 'undefined' ? supabaseClient : null;
         const userId = typeof currentUser !== 'undefined' && currentUser?.id ? currentUser.id : 'anonymous';
         if (!client || userId === 'anonymous') { privateBooks.loaded = true; privateBooks.userId = userId; privateBooks.items = []; renderPrivateBooks(); return; }
         if (privateBooks.loaded && privateBooks.userId === userId) { renderPrivateBooks(); return; }
         privateBooks.userId = userId;
         privateBooks.loading = true; privateBooks.error = ''; renderPrivateBooks();
           const result = await client.from('school_documents').select('id,title,category,description,storage_path,created_at').eq('published',true).in('category',['Biblioteca · 6º ano','Biblioteca · 7º ano','Biblioteca · 8º ano','Biblioteca · 9º ano']).order('created_at',{ascending:false});
         privateBooks.loading = false; privateBooks.loaded = true; privateBooks.error = Boolean(result.error); privateBooks.items = result.data || []; renderPrivateBooks();
       }
        function eighthRecommendationsMarkup() { return `<section class="il-panel bfr-eighth-recommendations" data-bfr-eighth-recommendations hidden><div class="il-head"><div><span class="il-kicker">📙 8º ANO · REFLEXÃO SOCIAL E HUMANA</span><h2>Indicações de leitura</h2><p>Obras contemporâneas para trabalhar bullying, empatia, inclusão, diversidade e direitos humanos. A escola pode disponibilizar exemplares licenciados ou físicos.</p></div><span class="il-chip">leitura orientada</span></div><div class="bfr-private-books"><article class="bfr-private-book"><strong>A Cor da Ternura</strong><p>Geni Guimarães · identidade, diversidade e relações humanas.</p></article><article class="bfr-private-book"><strong>O Diário de Anne Frank</strong><p>Anne Frank · memória, direitos humanos e empatia.</p></article><article class="bfr-private-book"><strong>Extraordinário</strong><p>R. J. Palacio · inclusão, amizade e respeito.</p></article><article class="bfr-private-book"><strong>A Menina que Roubava Livros</strong><p>Markus Zusak · memória, coragem e humanidade.</p></article><article class="bfr-private-book"><strong>Meu Pé de Laranja Lima</strong><p>José Mauro de Vasconcelos · infância, afeto e superação.</p></article><article class="bfr-private-book"><strong>Corda Bamba</strong><p>Lygia Bojunga · identidade, imaginação e amadurecimento.</p></article><article class="bfr-private-book"><strong>Capitães da Areia</strong><p>Jorge Amado · desigualdade, direitos e pertencimento · trechos selecionados.</p></article></div><p class="bfr-private-note">Para leitura integral, use exemplares adquiridos ou autorizados pela escola.</p></section>`; }
        function enhance() {
        const host = root(); if (!host || host.classList.contains('hidden')) { relabel(); return; }
         style(); spaceStyle(); relabel();
          const title = host.querySelector('.il-hero h1'); if (title) title.textContent = '📚 Biblioteca';
          const intro = host.querySelector('.il-hero p'); if (intro) intro.textContent = 'Acervo virtual, livros da escola e sua jornada de leitura em um só lugar.';
        const hero = host.querySelector('.il-hero > div');
        if (hero && !hero.querySelector('[data-reading-integration]')) hero.insertAdjacentHTML('beforeend', `<div class="bfr-reading-quick-actions" data-reading-integration><button type="button" data-reading-link="lia">🤖 Perguntar à LIA</button><button type="button" data-reading-link="activities">📝 Minhas atividades</button><button type="button" data-reading-link="games">🎮 Jogar</button><button type="button" data-reading-link="experiences">✨ Criar experiência</button></div>`);
          const explore = host.querySelector('#bfrLibraryExplore');
          if (explore && !host.querySelector('[data-bfr-eighth-recommendations]')) explore.insertAdjacentHTML('afterend', eighthRecommendationsMarkup());
         if (explore && !host.querySelector('[data-bfr-private-library]')) explore.insertAdjacentHTML('afterend', privateBooksMarkup());
         if (explore && !host.querySelector('[data-bfr-reading-dictionary]')) explore.insertAdjacentHTML('afterend', dictionaryMarkup());
         const internal = [...host.querySelectorAll('.il-panel')].find(panel => panel.querySelector('.il-kicker')?.textContent.includes('MINHA LEITURA')); if (internal) { internal.id = 'bfrMyReading'; const internalTitle = internal.querySelector('h2'); if (internalTitle) internalTitle.textContent = 'Minha Leitura'; const internalCopy = internal.querySelector('.il-head p'); if (internalCopy) internalCopy.textContent = 'Os livros que você começou ou já concluiu.'; }
         const dictionary = host.querySelector('[data-bfr-reading-dictionary]'); if (dictionary) dictionary.id = 'bfrReadingWords';
         const mark = (needle,id) => { const section = [...host.querySelectorAll('section')].find(item => String(item.innerText).includes(needle)); if (section && !section.id) section.id = id; };
         mark('🎯 DESAFIOS DE LEITURA','bfrReadingChallenges'); mark('🧠 QUIZ LITERÁRIO','bfrReadingActivities'); mark('👩‍🏫 INDICAÇÕES DOS PROFESSORES','bfrReadingRecommended'); mark('🏆 MINHAS CONQUISTAS','bfrReadingAchievements'); mark('📊 MEU PROGRESSO','bfrReadingProgress');
         if (hero && !host.querySelector('[data-reading-space-map]')) hero.parentElement.insertAdjacentHTML('afterend', spaceNavigationMarkup());
         loadPrivateBooks();
      }
      function openLink(type) { if (type === 'lia') document.querySelector('[data-lia-open]')?.click(); if (type === 'activities') window.bfrOpenActivityCenter?.(); if (type === 'games') typeof navigateToSection === 'function' && navigateToSection('jogos'); if (type === 'experiences') typeof navigateToSection === 'function' && navigateToSection('experiencias'); }
       document.addEventListener('click', async event => {
         const spaceTarget = event.target.closest('[data-reading-space-target]'); if (spaceTarget) { const target = root()?.querySelector(spaceTarget.dataset.readingSpaceTarget); target?.scrollIntoView({behavior:'smooth',block:'start'}); return; }
         const grade = event.target.closest('[data-reading-grade]'); if (grade) { privateBooks.grade = grade.dataset.readingGrade; renderPrivateBooks(); return; }
         const link = event.target.closest('[data-reading-link]'); if (link) { openLink(link.dataset.readingLink); return; }
        const word = event.target.closest('[data-reading-word]'); if (word) { state.words = state.words || []; const value = word.dataset.readingWord; state.words = state.words.includes(value) ? state.words.filter(item => item !== value) : [...state.words, value]; const saved = state.words.includes(value); save(); word.classList.toggle('is-saved',saved); word.textContent = saved ? '✓ Salva' : '☆ Salvar'; return; }
         const speak = event.target.closest('[data-reading-speak]'); if (speak) { speech(`${speak.dataset.readingSpeak}. ${words.find(item => item[0] === speak.dataset.readingSpeak)?.[1] || ''}`); return; }
         const privateBook = event.target.closest('[data-private-book]'); if (privateBook) { privateBook.disabled = true; privateBook.textContent = 'Abrindo...'; const popup = window.open('about:blank', '_blank'); const client = typeof supabaseClient !== 'undefined' ? supabaseClient : null; const result = client ? await client.storage.from('school-documents').createSignedUrl(privateBook.dataset.privateBook, 900) : {error:true}; if (!result.error && result.data?.signedUrl) { if (popup && !popup.closed) { popup.opener = null; popup.location.replace(result.data.signedUrl); } else window.location.assign(result.data.signedUrl); } else { popup?.close(); privateBook.textContent = 'Acesso indisponível'; setTimeout(() => { privateBook.disabled = false; privateBook.textContent = '🔐 Ler PDF'; }, 1800); } return; }
        if (event.target.closest('#readingLibraryView [data-il-read],#readingLibraryView [data-il-fav],#readingLibraryView [data-il-category],#readingLibraryView [data-il-explore]')) setTimeout(enhance, 0);
      });
      const original = window.bfrOpenReadingLibrary;
      if (original && !original.__bfrReadingIntegration) { const wrapped = () => { original(); setTimeout(enhance, 0); }; wrapped.__bfrReadingIntegration = true; window.bfrOpenReadingLibrary = wrapped; }
       setTimeout(enhance, 700);
    })();
  </script>
  <script id="bfr-unified-library-catalog">
    (() => {
      const root = () => document.getElementById('readingLibraryView');
      const physicalCategory = 'Biblioteca Física';
      const managers = ['developer','director','coordinator','pedagogical','secretary'];
      const seeds = [
        ['prince','O Pequeno Príncipe','Antoine de Saint-Exupéry','Literatura mundial','6º ano','Literatura'],
        ['island','A Ilha Perdida','Maria José Dupré','Aventura','6º ano','Literatura'],
        ['alice','Alice no País das Maravilhas','Lewis Carroll','Fantasia','6º ano','Literatura'],
        ['machado','Contos de Machado de Assis','Machado de Assis','Literatura brasileira','8º ano','Literatura'],
        ['poesia','Ou isto ou aquilo','Cecília Meireles','Poesia','6º ano','Língua Portuguesa'],
        ['misterio','O Mistério do Cinco Estrelas','Marcos Rey','Mistério','7º ano','Literatura']
      ];
      const state = { loaded:false, loading:false, error:'', items:[], tab:'all', query:'', grade:'all', subject:'all', genre:'all', availability:'all', form:null };
      const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
      const db = () => typeof supabaseClient !== 'undefined' ? supabaseClient : null;
      const canManage = () => managers.includes(typeof currentProfile !== 'undefined' ? currentProfile?.role : '');
      const normalize = value => String(value || '').toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
      const seedItems = () => seeds.map(item => ({ id:`virtual:${item[0]}`, source:'virtual', kind:'digital', title:item[1], author:item[2], genre:item[3], grade:item[4], subject:item[5], description:'Livro disponível no espaço de leitura da escola.', published:true, readKey:item[0] }));
      function parsePhysical(row) {
        const raw = String(row.description || '');
        let meta = {};
        if (raw.startsWith('BFR_PHYSICAL::')) { try { meta = JSON.parse(raw.slice(14)); } catch {} }
        return { id:row.id, source:'school', kind:'physical', title:row.title || meta.title || 'Livro sem título', author:meta.author || '', isbn:meta.isbn || '', year:meta.year || '', grade:meta.grade || '', subject:meta.subject || '', genre:meta.genre || '', publisher:meta.publisher || '', location:meta.location || '', patrimony:meta.patrimony || '', description:meta.description || '', total:Number(meta.total || 0), available:Number(meta.available ?? meta.total ?? 0), published:row.published !== false, createdAt:row.created_at };
      }
      function parseDigital(row) {
        const grade = (String(row.category || '').match(/(6|7|8|9)/) || [])[1] || '';
        return { id:row.id, source:'school', kind:'digital', title:row.title || 'Livro publicado', author:'', grade:grade ? `${grade}º ano` : '', subject:'', genre:'', description:row.description || 'Livro publicado pela escola.', storagePath:row.storage_path || '', published:row.published !== false, createdAt:row.created_at };
      }
      function groupItems(items) {
        const groups = [];
        items.filter(item => item.published !== false || canManage()).forEach(item => {
          const key = item.isbn ? `isbn:${normalize(item.isbn)}` : `title:${normalize(item.title)}`;
          let group = groups.find(entry => entry.key === key);
          if (!group) { group = {key,title:item.title,author:item.author || '',isbn:item.isbn || '',year:item.year || '',grade:item.grade || '',subject:item.subject || '',genre:item.genre || '',publisher:item.publisher || '',description:item.description || '',digital:[],physical:[]}; groups.push(group); }
          ['author','isbn','year','grade','subject','genre','publisher','description'].forEach(field => { if (!group[field] && item[field]) group[field] = item[field]; });
          group[item.kind].push(item);
        });
        return groups;
      }
      function groups() { return groupItems(state.items); }
      function matches(group) {
        const text = normalize([group.title,group.author,group.isbn,group.publisher,group.subject,group.genre,group.description].join(' '));
        const allText = !state.query || text.includes(normalize(state.query));
        const tab = state.tab === 'all' || state.tab === 'virtual' && group.digital.length || state.tab === 'physical' && group.physical.length;
        const grade = state.grade === 'all' || group.grade === state.grade;
        const subject = state.subject === 'all' || group.subject === state.subject;
        const genre = state.genre === 'all' || group.genre === state.genre;
        const available = state.availability === 'all' || state.availability === 'available' && group.physical.some(item => item.available > 0) || state.availability === 'unavailable' && group.physical.length && group.physical.every(item => item.available <= 0);
        return Boolean(allText && tab && grade && subject && genre && available);
      }
      function catalogStyle() {
        if (document.getElementById('bfr-unified-library-style')) return;
        const style = document.createElement('style'); style.id = 'bfr-unified-library-style';
        style.textContent = `#readingLibraryView .bfr-unified-catalog{margin:16px 0;padding:20px;border:1px solid #d7e5f5;border-radius:20px;background:linear-gradient(145deg,#ffffff,#f5f9ff);box-shadow:0 10px 28px rgba(43,67,115,.06)}#readingLibraryView .bfr-catalog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}#readingLibraryView .bfr-catalog-head h2{margin:5px 0;color:#10295f;font:700 clamp(22px,2.6vw,31px) 'Playfair Display',serif}#readingLibraryView .bfr-catalog-head p{max-width:680px;margin:0;color:#71809a;font-size:11px;line-height:1.55}.bfr-catalog-mark{display:grid;place-items:center;min-width:86px;height:70px;border-radius:18px;color:#fff;background:linear-gradient(145deg,#1769d2,#24b7a1);font-size:33px}.bfr-catalog-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:16px}.bfr-catalog-stat{padding:11px;border:1px solid #e2eaf4;border-radius:12px;background:#fff}.bfr-catalog-stat span,.bfr-catalog-stat strong,.bfr-catalog-stat small{display:block}.bfr-catalog-stat span{color:#71809a;font-size:9px}.bfr-catalog-stat strong{margin-top:3px;color:#10295f;font-size:20px}.bfr-catalog-stat small{margin-top:2px;color:#94a3b8;font-size:9px}.bfr-catalog-tabs{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.bfr-catalog-tabs button,.bfr-catalog-filter,.bfr-catalog-admin button{border:1px solid #dbe7f4;border-radius:10px;padding:9px 11px;color:#536681;background:#fff;font-size:10px;font-weight:800;cursor:pointer}.bfr-catalog-tabs button.is-active{color:#fff;border-color:#1769d2;background:#1769d2;box-shadow:0 5px 12px rgba(23,105,210,.16)}.bfr-catalog-toolbar{display:grid;grid-template-columns:2fr repeat(4,1fr);gap:8px;margin-top:12px}.bfr-catalog-toolbar input,.bfr-catalog-toolbar select,.bfr-catalog-admin input,.bfr-catalog-admin select,.bfr-catalog-admin textarea{width:100%;border:1px solid #dbe5f1;border-radius:9px;padding:10px;color:#29436a;background:#fff;font:10px inherit}.bfr-catalog-toolbar input:focus,.bfr-catalog-toolbar select:focus,.bfr-catalog-admin input:focus,.bfr-catalog-admin select:focus,.bfr-catalog-admin textarea:focus{outline:3px solid rgba(37,99,235,.13);border-color:#8dbcf5}.bfr-catalog-results{margin-top:14px}.bfr-catalog-count{color:#71809a;font-size:10px}.bfr-catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:9px}.bfr-catalog-card{display:flex;flex-direction:column;min-width:0;padding:13px;border:1px solid #dbe7f4;border-radius:14px;background:#fff}.bfr-catalog-card-top{display:flex;justify-content:space-between;gap:8px}.bfr-catalog-card h3{margin:8px 0 3px;color:#10295f;font-size:14px;line-height:1.3}.bfr-catalog-card p{margin:0;color:#71809a;font-size:10px;line-height:1.45}.bfr-catalog-card small{color:#94a3b8;font-size:9px}.bfr-catalog-badge{padding:5px 7px;border-radius:999px;color:#1769d2;background:#edf5ff;font:9px 'DM Mono',monospace;white-space:nowrap}.bfr-catalog-badge.good{color:#16826f;background:#eaf7f3}.bfr-catalog-badge.warn{color:#a16207;background:#fff7db}.bfr-catalog-meta{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}.bfr-catalog-meta span{padding:4px 6px;border-radius:6px;color:#536681;background:#f5f8fc;font-size:9px}.bfr-catalog-detail{margin-top:10px;color:#536681;font-size:10px}.bfr-catalog-detail summary{cursor:pointer;color:#1769d2;font-weight:800}.bfr-catalog-detail div{display:grid;gap:4px;margin-top:7px;padding:9px;border-radius:9px;background:#f7faff}.bfr-catalog-sources{display:grid;gap:6px;margin-top:11px;padding-top:10px;border-top:1px solid #edf2f7}.bfr-catalog-source{display:flex;align-items:center;justify-content:space-between;gap:8px;color:#536681;font-size:10px}.bfr-catalog-source button{border:0;border-radius:7px;padding:6px 8px;color:#1769d2;background:#edf5ff;font-size:9px;font-weight:800;cursor:pointer}.bfr-catalog-empty{padding:20px;border:1px dashed #cbd8e8;border-radius:12px;color:#71809a;background:#fbfdff;font-size:10px;text-align:center}.bfr-catalog-admin{margin-top:16px;padding-top:16px;border-top:1px solid #dbe7f4}.bfr-catalog-admin h3{margin:0;color:#10295f;font-size:15px}.bfr-catalog-admin p{margin:4px 0;color:#71809a;font-size:10px;line-height:1.45}.bfr-catalog-admin-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:11px}.bfr-catalog-admin-form .wide{grid-column:span 2}.bfr-catalog-admin-form textarea{min-height:57px;resize:vertical}.bfr-catalog-admin-actions{display:flex;align-items:center;gap:8px;grid-column:1/-1}.bfr-catalog-admin button.primary{color:#fff;border-color:#1769d2;background:#1769d2}.bfr-catalog-admin button.danger{color:#b42318;border-color:#fecaca;background:#fff5f5}.bfr-catalog-admin-list{display:grid;gap:7px;margin-top:12px}.bfr-catalog-admin-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 10px;border:1px solid #e2eaf4;border-radius:10px;background:#fff}.bfr-catalog-admin-row strong,.bfr-catalog-admin-row small{display:block}.bfr-catalog-admin-row strong{color:#29436a;font-size:10px}.bfr-catalog-admin-row small{margin-top:3px;color:#71809a;font-size:9px}.bfr-catalog-admin-row-actions{display:flex;gap:5px}.bfr-catalog-status{grid-column:1/-1;min-height:15px;color:#16826f;font-size:10px}.bfr-catalog-status.error{color:#b42318}@media(max-width:900px){.bfr-catalog-toolbar{grid-template-columns:repeat(2,minmax(0,1fr))}.bfr-catalog-toolbar input{grid-column:1/-1}.bfr-catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){#readingLibraryView .bfr-catalog-head{display:block}.bfr-catalog-mark{width:70px;margin-top:13px}.bfr-catalog-stats,.bfr-catalog-grid{grid-template-columns:1fr 1fr}.bfr-catalog-admin-form{grid-template-columns:1fr 1fr}.bfr-catalog-admin-form .wide{grid-column:1/-1}}@media(max-width:430px){.bfr-catalog-toolbar,.bfr-catalog-stats,.bfr-catalog-grid,.bfr-catalog-admin-form{grid-template-columns:1fr}.bfr-catalog-admin-form .wide{grid-column:auto}}`;
        document.head.appendChild(style);
      }
      function filterOptions(items, field) { return [...new Set(items.map(item => item[field]).filter(Boolean))].sort((a,b) => String(a).localeCompare(String(b),'pt-BR')); }
      function formMarkup() {
        const value = state.form || {id:'',title:'',author:'',isbn:'',year:'',grade:'',subject:'',genre:'',publisher:'',total:1,available:1,location:'',patrimony:'',description:'',published:true};
        const input = (name,label,type='text',extra='') => `<label>${label}<input name="${name}" type="${type}" value="${esc(value[name])}" ${extra}></label>`;
        return `<div class="bfr-catalog-admin"><h3>Gestão do acervo físico</h3><p>Adicione livros que ficam na escola. Os registros podem ser editados, ocultados ou removidos sem alterar os livros virtuais.</p><form class="bfr-catalog-admin-form" data-library-admin-form><input type="hidden" name="id" value="${esc(value.id)}">${input('title','Título *','text','required')} ${input('author','Autor')} ${input('isbn','ISBN')} ${input('year','Ano','number','min="0" max="2100"')} ${input('grade','Ano/série','text','placeholder="Ex.: 8º ano"')} ${input('subject','Disciplina')} ${input('genre','Gênero')} ${input('publisher','Editora')} ${input('total','Exemplares','number','min="0" required')} ${input('available','Disponíveis','number','min="0" required')} ${input('location','Localização','text','placeholder="Ex.: Estante A3"')} ${input('patrimony','Patrimônio')}<label class="wide">Descrição<textarea name="description" placeholder="Sinopse ou observações do acervo">${esc(value.description)}</textarea></label><label><span>Visibilidade</span><select name="published"><option value="true" ${value.published !== false ? 'selected':''}>Visível para a escola</option><option value="false" ${value.published === false ? 'selected':''}>Oculto</option></select></label><div class="bfr-catalog-admin-actions"><button class="primary" type="submit">${value.id ? 'Salvar alterações' : 'Adicionar ao catálogo'}</button>${value.id ? '<button type="button" data-library-cancel>Cancelar edição</button>' : ''}</div><div class="bfr-catalog-status" data-library-admin-status></div></form>${adminListMarkup()}</div>`;
      }
      function adminListMarkup() { const rows = state.items.filter(item => item.kind === 'physical'); return `<div class="bfr-catalog-admin-list">${rows.length ? rows.map(item => `<div class="bfr-catalog-admin-row"><div><strong>${esc(item.title)}${item.published ? '' : ' · oculto'}</strong><small>${esc(item.author || 'Autor não informado')} · ${item.available}/${item.total} disponíveis${item.location ? ` · ${esc(item.location)}` : ''}</small></div><div class="bfr-catalog-admin-row-actions"><button type="button" data-library-edit="${esc(item.id)}">Editar</button><button type="button" class="danger" data-library-delete="${esc(item.id)}">Remover</button></div></div>`).join('') : '<div class="bfr-catalog-empty">Nenhum livro físico cadastrado. Comece pelo formulário acima.</div>'}</div>`; }
      function cardMarkup(group) {
        const physical = group.physical[0], digital = group.digital;
        const sources = [];
        if (digital.length) { const doc = digital.find(item => item.storagePath); sources.push(`<div class="bfr-catalog-source"><span>💻 Biblioteca Virtual${digital.length > 1 ? ` · ${digital.length} versões` : ''}</span>${doc ? `<button type="button" data-library-open-doc="${esc(doc.storagePath)}">Abrir livro</button>` : `<button type="button" data-library-read="${esc(digital[0].readKey || '')}">Abrir leitura</button>`}</div>`); }
        if (physical) sources.push(`<div class="bfr-catalog-source"><span>🏫 Biblioteca da Escola · ${physical.available > 0 ? `${physical.available} disponível${physical.available === 1 ? '' : 'is'}` : 'indisponível'}</span><span class="bfr-catalog-badge ${physical.available > 0 ? 'good' : 'warn'}">${physical.available > 0 ? 'disponível' : 'emprestado'}</span></div>`);
        const format = digital.length && physical ? 'Digital + físico' : digital.length ? 'Digital' : 'Físico';
        return `<article class="bfr-catalog-card"><div class="bfr-catalog-card-top"><span class="bfr-catalog-badge">${format}</span>${physical ? `<span class="bfr-catalog-badge ${physical.available > 0 ? 'good' : 'warn'}">${physical.available > 0 ? 'com exemplares' : 'sem exemplares'}</span>` : '<span class="bfr-catalog-badge good">online</span>'}</div><h3>${esc(group.title)}</h3><p>${esc(group.author || 'Autor não informado')}</p><div class="bfr-catalog-meta">${group.grade ? `<span>🎓 ${esc(group.grade)}</span>` : ''}${group.genre ? `<span>🏷 ${esc(group.genre)}</span>` : ''}${group.subject ? `<span>📘 ${esc(group.subject)}</span>` : ''}${group.isbn ? `<span>ISBN ${esc(group.isbn)}</span>` : ''}</div>${group.description ? `<p style="margin-top:8px">${esc(group.description)}</p>` : ''}<details class="bfr-catalog-detail"><summary>Ver ficha completa</summary><div>${group.publisher ? `<span><strong>Editora:</strong> ${esc(group.publisher)}</span>` : ''}${group.year ? `<span><strong>Ano:</strong> ${esc(group.year)}</span>` : ''}${physical ? `<span><strong>Exemplares:</strong> ${physical.available} disponíveis de ${physical.total}</span>` : ''}${physical?.location ? `<span><strong>Localização:</strong> ${esc(physical.location)}</span>` : ''}${physical?.patrimony ? `<span><strong>Patrimônio:</strong> ${esc(physical.patrimony)}</span>` : ''}<span><strong>Acesso:</strong> ${format}</span></div></details><div class="bfr-catalog-sources">${sources.join('')}</div></article>`;
      }
      function render() {
        const host = root()?.querySelector('[data-bfr-unified-catalog]'); if (!host) return;
        const all = groups(), visible = all.filter(matches), grades = filterOptions(state.items,'grade'), subjects = filterOptions(state.items,'subject'), genres = filterOptions(state.items,'genre');
        const digitalCount = all.filter(item => item.digital.length).length, physicalCount = all.filter(item => item.physical.length).length, availableCount = all.filter(item => item.physical.some(row => row.available > 0)).length;
        host.innerHTML = `<div class="bfr-catalog-head"><div><span class="il-kicker">📚 CATÁLOGO UNIFICADO DA ESCOLA</span><h2>Biblioteca para ler, consultar e emprestar</h2><p>Encontre livros virtuais e físicos em um só lugar. Títulos iguais aparecem agrupados para mostrar todas as formas de acesso.</p></div><div class="bfr-catalog-mark" aria-hidden="true">📚</div></div><div class="bfr-catalog-stats"><div class="bfr-catalog-stat"><span>Todos os títulos</span><strong>${all.length}</strong><small>catálogo reunido</small></div><div class="bfr-catalog-stat"><span>Biblioteca virtual</span><strong>${digitalCount}</strong><small>leitura online</small></div><div class="bfr-catalog-stat"><span>Acervo físico</span><strong>${physicalCount}</strong><small>livros da escola</small></div><div class="bfr-catalog-stat"><span>Disponíveis</span><strong>${availableCount}</strong><small>com exemplar para consulta</small></div></div><div class="bfr-catalog-tabs" role="tablist" aria-label="Tipo de acervo"><button type="button" class="${state.tab === 'all' ? 'is-active':''}" data-library-tab="all">Todos os livros</button><button type="button" class="${state.tab === 'virtual' ? 'is-active':''}" data-library-tab="virtual">Biblioteca Virtual</button><button type="button" class="${state.tab === 'physical' ? 'is-active':''}" data-library-tab="physical">Biblioteca da Escola</button></div><div class="bfr-catalog-toolbar"><input type="search" data-library-search value="${esc(state.query)}" placeholder="Buscar título, autor, ISBN ou palavra-chave" aria-label="Buscar no catálogo"><select data-library-filter="grade"><option value="all">Todos os anos/séries</option>${grades.map(value => `<option value="${esc(value)}" ${state.grade === value ? 'selected':''}>${esc(value)}</option>`).join('')}</select><select data-library-filter="subject"><option value="all">Todas as disciplinas</option>${subjects.map(value => `<option value="${esc(value)}" ${state.subject === value ? 'selected':''}>${esc(value)}</option>`).join('')}</select><select data-library-filter="genre"><option value="all">Todos os gêneros</option>${genres.map(value => `<option value="${esc(value)}" ${state.genre === value ? 'selected':''}>${esc(value)}</option>`).join('')}</select><select data-library-filter="availability"><option value="all">Qualquer disponibilidade</option><option value="available" ${state.availability === 'available' ? 'selected':''}>Com exemplar disponível</option><option value="unavailable" ${state.availability === 'unavailable' ? 'selected':''}>Sem exemplar disponível</option></select></div><div class="bfr-catalog-results"><span class="bfr-catalog-count">${visible.length} título${visible.length === 1 ? '' : 's'} encontrado${visible.length === 1 ? '' : 's'}</span><div class="bfr-catalog-grid">${state.loading ? '<div class="bfr-catalog-empty">Carregando o catálogo da escola...</div>' : visible.length ? visible.map(cardMarkup).join('') : '<div class="bfr-catalog-empty">Nenhum livro corresponde aos filtros atuais. Tente outra busca ou consulte a equipe escolar.</div>'}</div></div>${canManage() ? formMarkup() : ''}`;
      }
      async function load() {
        if (state.loading || state.loaded) return;
        state.loading = true; render();
        const client = db(); let rows = [];
        if (client && typeof currentUser !== 'undefined' && currentUser) {
          let query = client.from('school_documents').select('id,title,category,description,storage_path,published,created_at');
          if (!canManage()) query = query.eq('published',true);
          query = query.order('created_at',{ascending:false});
          const result = await query;
          if (!result.error) rows = result.data || []; else state.error = result.error.message || 'Não foi possível carregar os livros da escola.';
        }
        const relevant = rows.filter(row => row.category === physicalCategory || String(row.category || '').startsWith('Biblioteca · '));
        state.items = [...seedItems(), ...relevant.map(row => row.category === physicalCategory ? parsePhysical(row) : parseDigital(row))];
        state.loaded = true; state.loading = false; render();
      }
      async function openDocument(path, button) {
        const client = db(); if (!client || !path) return;
        if (button) { button.disabled = true; button.textContent = 'Abrindo...'; }
        const result = await client.storage.from('school-documents').createSignedUrl(path, 900);
        if (!result.error && result.data?.signedUrl) window.open(result.data.signedUrl,'_blank','noopener,noreferrer');
        else if (button) button.textContent = 'Acesso indisponível';
        if (button) setTimeout(() => { button.disabled = false; button.textContent = 'Abrir livro'; }, 1800);
      }
      async function savePhysical(form) {
        const status = form.querySelector('[data-library-admin-status]'), data = Object.fromEntries(new FormData(form).entries()), client = db();
        const total = Math.max(0, Number(data.total || 0)), available = Math.min(total, Math.max(0, Number(data.available || 0)));
        if (!data.title.trim() || !client || typeof currentUser === 'undefined' || !currentUser) { status.textContent = 'Entre em uma conta escolar para salvar o acervo.'; status.classList.add('error'); return; }
        const meta = {author:data.author,isbn:data.isbn,year:data.year,grade:data.grade,subject:data.subject,genre:data.genre,publisher:data.publisher,total,available,location:data.location,patrimony:data.patrimony,description:data.description};
        const payload = {title:data.title.trim(),category:physicalCategory,description:`BFR_PHYSICAL::${JSON.stringify(meta)}`,storage_path:`library/physical/${data.id || crypto.randomUUID()}`,published:data.published === 'true'};
        status.textContent = 'Salvando registro...'; status.classList.remove('error');
        const result = data.id ? await client.from('school_documents').update(payload).eq('id',data.id) : await client.from('school_documents').insert({...payload,created_by:currentUser.id});
        if (result.error) { status.textContent = 'Não foi possível salvar. Verifique a permissão da conta escolar.'; status.classList.add('error'); return; }
        state.form = null; state.loaded = false; await load();
      }
      async function removePhysical(id) {
        const client = db(); if (!client || !window.confirm('Remover este livro do catálogo físico?')) return;
        const result = await client.from('school_documents').delete().eq('id',id); if (result.error) { window.alert('Não foi possível remover este registro.'); return; }
        state.form = null; state.loaded = false; await load();
      }
      function enhance() {
        const host = root(); if (!host || host.classList.contains('hidden')) return;
        catalogStyle();
        if (!host.querySelector('[data-bfr-unified-catalog]')) { const hero = host.querySelector('.il-hero'); if (hero) hero.insertAdjacentHTML('afterend','<section class="bfr-unified-catalog" data-bfr-unified-catalog></section>'); }
        if (!state.loaded && !state.loading) { render(); load(); } else render();
      }
      document.addEventListener('click', async event => {
        const tab = event.target.closest('[data-library-tab]'); if (tab) { state.tab = tab.dataset.libraryTab; render(); return; }
        const filter = event.target.closest('[data-library-filter]'); if (filter) { state[filter.dataset.libraryFilter] = filter.value; render(); return; }
        const read = event.target.closest('[data-library-read]'); if (read) { document.querySelector(`#readingLibraryView [data-il-read="${CSS.escape(read.dataset.libraryRead)}"]`)?.click(); return; }
        const doc = event.target.closest('[data-library-open-doc]'); if (doc) { await openDocument(doc.dataset.libraryOpenDoc,doc); return; }
        const edit = event.target.closest('[data-library-edit]'); if (edit) { state.form = state.items.find(item => item.id === edit.dataset.libraryEdit) || null; render(); root()?.querySelector('[data-library-admin-form]')?.scrollIntoView({behavior:'smooth',block:'start'}); return; }
        const cancel = event.target.closest('[data-library-cancel]'); if (cancel) { state.form = null; render(); return; }
        const remove = event.target.closest('[data-library-delete]'); if (remove) { await removePhysical(remove.dataset.libraryDelete); return; }
      });
      document.addEventListener('input', event => { const input = event.target.closest('[data-library-search]'); if (!input) return; state.query = input.value; const position = input.selectionStart; render(); const next = root()?.querySelector('[data-library-search]'); if (next) { next.focus(); next.setSelectionRange(position,position); } });
      document.addEventListener('submit', async event => { const form = event.target.closest('[data-library-admin-form]'); if (!form) return; event.preventDefault(); await savePhysical(form); });
      const original = window.bfrOpenReadingLibrary;
      if (original && !original.__bfrUnifiedCatalog) { const wrapped = () => { original(); setTimeout(enhance,0); }; wrapped.__bfrUnifiedCatalog = true; window.bfrOpenReadingLibrary = wrapped; }
       window.bfrUnifiedLibrary = {enhance,load};
      setTimeout(enhance,900);
    })();
  </script>
<script>
  (() => {
    const avatar = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><defs><linearGradient id="bg" x1="28" y1="20" x2="228" y2="238" gradientUnits="userSpaceOnUse"><stop stop-color="#24b7a1"/><stop offset=".58" stop-color="#1769d2"/><stop offset="1" stop-color="#745bd4"/></linearGradient><linearGradient id="face" x1="86" y1="74" x2="171" y2="188" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset="1" stop-color="#dbeaff"/></linearGradient></defs><circle cx="128" cy="128" r="124" fill="#10295f"/><circle cx="128" cy="128" r="111" fill="url(#bg)"/><path d="M66 119c0-39 28-67 62-67s62 28 62 67v19c0 43-27 72-62 72s-62-29-62-72v-19Z" fill="url(#face)"/><path d="M74 112c4-41 29-66 61-66 34 0 57 25 61 66-17-16-34-23-59-23-25 0-43 7-63 23Z" fill="#10295f"/><circle cx="105" cy="132" r="7" fill="#10295f"/><circle cx="151" cy="132" r="7" fill="#10295f"/><path d="M107 161c12 10 26 10 41 0" fill="none" stroke="#1769d2" stroke-linecap="round" stroke-width="7"/><path d="M128 45V27" fill="none" stroke="#dffbff" stroke-linecap="round" stroke-width="7"/><circle cx="128" cy="20" r="9" fill="#facc15"/><circle cx="48" cy="96" r="9" fill="#facc15"/><circle cx="208" cy="96" r="9" fill="#facc15"/><path d="M48 96h18M190 96h18" stroke="#dffbff" stroke-linecap="round" stroke-width="5"/><path d="M84 207c13 10 28 15 44 15s31-5 44-15" fill="none" stroke="#dffbff" stroke-linecap="round" stroke-width="6"/></svg>');
    const applyLiaAvatar = () => {
      document.querySelectorAll('.lia-fab-avatar img,.lia-avatar img,.lia-home-icon img,.lia-message-avatar img').forEach(image => {
        if (image.getAttribute('src') !== avatar) image.src = avatar;
      });
      document.querySelectorAll('.lia-fab-avatar,.lia-avatar,.lia-home-icon,.lia-message-avatar').forEach(container => {
        if (!container.querySelector('img')) container.innerHTML = `<img src="${avatar}" alt="Avatar da LIA">`;
      });
      if (!document.getElementById('lia-avatar-fallback-style')) {
        const style = document.createElement('style');
        style.id = 'lia-avatar-fallback-style';
        style.textContent = `.login-message:before{background-image:url('${avatar}') !important}`;
        document.head.appendChild(style);
      }
    };
    applyLiaAvatar();
   })();
</script>
<script id="bfr-lia-official-identity">
  (() => {
    const logoPath = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><rect width="128" height="128" rx="28" fill="#1769d2"/><circle cx="64" cy="64" r="43" fill="#fff"/><text x="64" y="75" text-anchor="middle" font-family="Arial,sans-serif" font-size="27" font-weight="700" fill="#1769d2">LIA</text></svg>');
    const selector = '.lia-fab-avatar,.lia-avatar,.lia-home-icon,.lia-message-avatar';
    const apply = () => document.querySelectorAll(selector).forEach(container => {
      const image = container.querySelector('img');
      if (image) {
        if (image.getAttribute('src') !== logoPath) image.setAttribute('src', logoPath);
        image.alt = 'Logo da LIA';
      } else {
        container.innerHTML = `<img src="${logoPath}" alt="Logo da LIA">`;
      }
    });
    const schedule = () => requestAnimationFrame(apply);
    window.bfrApplyLiaIdentity = apply;
    apply();
    document.addEventListener('click', event => {
      if (event.target.closest('[data-lia-open],#liaFab,[data-lia-suggestion]')) schedule();
    }, true);
    const overlay = document.getElementById('liaOverlay');
    if (overlay) new MutationObserver(schedule).observe(overlay, { childList:true, subtree:true });
    const parentView = document.getElementById('parentView');
    if (parentView) new MutationObserver(schedule).observe(parentView, { childList:true, subtree:true });
  })();
</script>
<script id="bfr-direction-command-runtime">
  (() => {
    const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const emptyState = (title, copy) => `<div class="bfr-direction-empty"><strong>${esc(title)}</strong><span>${esc(copy)}</span></div>`;
    function trimDirectorExtras(panel) {
      const view = panel?.closest('#directorView');
      if (!view) return;
      view.classList.add('bfr-direction-mode');
      [...view.children].forEach(child => {
        if (child.classList.contains('director-welcome')) { child.classList.add('bfr-direction-hidden'); return; }
        if (child.id === 'bfrHomeDock' || child.classList.contains('bfr-compact-birthday-panel') || child.matches('[data-bfr-reading-panel],[data-bfr-reading-assist-usage],[data-bfr-birthdays]')) child.remove();
      });
    }
    function normalizeEmptyAttention(panel) {
      const students = panel.querySelector('.bfr-direction-kpi strong')?.textContent?.trim();
      if (students !== '0') return;
      const row = [...panel.querySelectorAll('.bfr-direction-list article')].find(item => (item.innerText || '').includes('Leitura acompanhada'));
      if (!row) return;
      const copy = row.querySelector('small');
      const status = row.querySelector('.bfr-direction-status');
      if (copy && copy.textContent !== 'Nenhum dado disponível no momento') copy.textContent = 'Nenhum dado disponível no momento';
      if (status) {
        if (status.textContent !== '—') status.textContent = '—';
        if (status.classList.contains('warning')) status.classList.remove('warning');
        if (!status.classList.contains('neutral')) status.classList.add('neutral');
      }
    }

    function injectCommandStyles() {
      if (document.getElementById('bfr-direction-command-style')) return;
      const style = document.createElement('style');
      style.id = 'bfr-direction-command-style';
      style.textContent = `
        #bfrDirectionPanel.bfr-direction-command{width:100%;max-width:none;margin-top:16px;padding:0;border:0;background:transparent;box-shadow:none}
        #bfrDirectionPanel .bfr-direction-hero{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding:24px 26px;border-radius:18px;background:linear-gradient(135deg,#10295f,#1769d2 68%,#167d83);box-shadow:0 16px 34px rgba(16,41,95,.16)}
        #bfrDirectionPanel .bfr-direction-hero h1{font-size:clamp(26px,3vw,38px);letter-spacing:-.02em}
        #bfrDirectionPanel .bfr-direction-hero p{max-width:650px;font-size:13px}
        .bfr-direction-hero-meta{display:flex;flex-direction:column;align-items:flex-end;gap:7px;min-width:170px;color:#d7eff0;font:10px 'DM Mono',monospace;text-align:right;text-transform:uppercase;letter-spacing:.05em}
        .bfr-direction-hero-meta strong{color:#fff;font:700 12px 'DM Sans',sans-serif;text-transform:none;letter-spacing:0}
        #bfrDirectionPanel .bfr-direction-kpis{grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin:14px 0 0}
        #bfrDirectionPanel .bfr-direction-kpi{min-height:92px;padding:13px 14px;box-shadow:0 5px 16px rgba(43,67,115,.05)}
        #bfrDirectionPanel .bfr-direction-kpi strong{font-size:27px}
        .bfr-direction-primary-grid{display:grid!important;grid-template-columns:minmax(0,1.18fr) minmax(280px,.82fr);gap:14px;margin-top:14px;align-items:start}
        .bfr-direction-primary-grid>.panel{min-width:0;align-self:start}
        .bfr-direction-primary-grid>.panel h2,.bfr-direction-command-grid h2{font-size:17px;color:#173b79}
        .bfr-direction-command-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(280px,.82fr);gap:14px;margin-top:14px}
        .bfr-direction-command-panel{min-width:0;margin:0;padding:16px;border:1px solid #dfe8f3;border-radius:15px;background:#fff;box-shadow:0 8px 22px rgba(43,67,115,.055);align-self:start}
        .bfr-direction-command-panel .eyebrow{color:#1769d2}
        .bfr-direction-panel-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
        .bfr-direction-panel-head h2{margin:4px 0 0}
        .bfr-direction-panel-badge{white-space:nowrap;border-radius:999px;padding:5px 8px;color:#1769d2;background:#edf5ff;font:9px 'DM Mono',monospace;text-transform:uppercase}
        .bfr-direction-empty{display:flex;flex-direction:column;gap:5px;margin-top:13px;padding:14px;border:1px dashed #cbd9ea;border-radius:11px;background:#f8fbff;color:#5e718e;font-size:11px;line-height:1.45}
        .bfr-direction-empty strong{color:#243856;font-size:12px}
        .bfr-direction-data-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:13px}
        .bfr-direction-data-strip>div{padding:11px;border-radius:11px;background:#f4f8fd}
        .bfr-direction-data-strip span{display:block;color:#71809a;font-size:10px}
        .bfr-direction-data-strip strong{display:block;margin-top:5px;color:#1769d2;font-size:22px}
        .bfr-direction-bars{display:grid;gap:9px;margin-top:14px}
        .bfr-direction-bar-row{display:grid;grid-template-columns:minmax(78px,.7fr) minmax(80px,1.5fr) 38px;gap:9px;align-items:center;font-size:10px;color:#405675}
        .bfr-direction-bar-track{height:8px;overflow:hidden;border-radius:999px;background:#e8eff7}
        .bfr-direction-bar-fill{height:100%;border-radius:inherit;background:linear-gradient(90deg,#1769d2,#24b7a1)}
        .bfr-direction-bar-row strong{text-align:right;color:#173b79;font-size:10px}
        .bfr-direction-table-wrap{margin-top:13px;overflow:auto;border:1px solid #e4ebf4;border-radius:11px}
        .bfr-direction-table{width:100%;min-width:430px;border-collapse:collapse;font-size:10px}
        .bfr-direction-table th{color:#71809a;background:#f7faff;font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.04em}
        .bfr-direction-table th,.bfr-direction-table td{padding:10px 9px;border-bottom:1px solid #e8eef5;text-align:left;white-space:nowrap}
        .bfr-direction-table tr:last-child td{border-bottom:0}
        .bfr-direction-table td{color:#304766}
        .bfr-direction-table td strong{color:#173b79}
         .bfr-direction-status-pill{display:inline-flex;border-radius:999px;padding:4px 7px;color:#16826f;background:#e8f7ef;font:9px 'DM Mono',monospace}
         .bfr-direction-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
         .bfr-direction-actions button{border:1px solid #cfe0fb;border-radius:9px;padding:9px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:700;cursor:pointer}
         #directorView .bfr-direction-hidden{display:none!important}
         .bfr-direction-status.neutral{color:#64748b;background:#f1f5f9}
         .bfr-direction-quick-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
          .bfr-direction-quick-links button{border:1px solid #cfe0fb;border-radius:9px;padding:9px 10px;color:#1769d2;background:#f1f7ff;font-size:10px;font-weight:700;cursor:pointer}
          .bfr-direction-quick-access{grid-column:auto}
          .bfr-direction-chart{margin-top:13px;padding:12px;border:1px solid #e1eaf4;border-radius:12px;background:#fbfdff}
          .bfr-direction-chart-head{display:flex;justify-content:space-between;gap:10px;align-items:center;color:#243856;font-size:11px}
          .bfr-direction-chart-head span{color:#71809a;font:9px 'DM Mono',monospace;text-transform:uppercase}
          .bfr-direction-chart svg{display:block;width:100%;height:auto;margin-top:9px;overflow:visible}
          .bfr-direction-chart-axis{stroke:#dbe5f1;stroke-width:1}
          .bfr-direction-chart-line{fill:none;stroke:#1769d2;stroke-linecap:round;stroke-linejoin:round;stroke-width:3}
          .bfr-direction-chart-dot{fill:#fff;stroke:#1769d2;stroke-width:2}
          .bfr-direction-chart-label{fill:#71809a;font:9px 'DM Mono',monospace}
          .bfr-direction-chart-note{margin-top:8px;color:#71809a;font-size:10px;line-height:1.4}
          .bfr-direction-distribution{display:grid;gap:8px;margin-top:11px}
          .bfr-direction-distribution-row{display:grid;grid-template-columns:minmax(90px,.8fr) minmax(80px,1.5fr) 34px;gap:8px;align-items:center;color:#405675;font-size:10px}
          .bfr-direction-distribution-row strong{text-align:right;color:#173b79;font-size:10px}
         .bfr-direction-secondary{margin-top:14px}
        #bfrDirectionPanel [data-bfr-birthdays]{margin-top:14px!important}
        @media(max-width:1000px){#bfrDirectionPanel .bfr-direction-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.bfr-direction-primary-grid,.bfr-direction-command-grid{grid-template-columns:1fr}}
        @media(max-width:650px){#bfrDirectionPanel .bfr-direction-hero{display:block;padding:19px}.bfr-direction-hero-meta{align-items:flex-start;margin-top:16px;text-align:left}.bfr-direction-hero-meta strong{font-size:11px}#bfrDirectionPanel .bfr-direction-kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}#bfrDirectionPanel .bfr-direction-kpi{min-height:82px;padding:11px}#bfrDirectionPanel .bfr-direction-kpi strong{font-size:23px}.bfr-direction-command-grid{gap:10px;margin-top:10px}.bfr-direction-command-panel{padding:13px}.bfr-direction-data-strip{grid-template-columns:1fr}.bfr-direction-bar-row{grid-template-columns:72px minmax(70px,1fr) 32px}}
      `;
      document.head.appendChild(style);
    }

    function directionDateLabel(value) {
      return new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'short'}).format(new Date(`${value}T12:00:00`)).replace('.','');
    }
    function directionLineSvg(points) {
      const width = 560, height = 190, left = 36, right = 12, top = 14, bottom = 34;
      const chartWidth = width - left - right, chartHeight = height - top - bottom;
      const x = index => left + (points.length === 1 ? chartWidth / 2 : index * chartWidth / (points.length - 1));
      const y = value => top + (100 - value) * chartHeight / 100;
      const polyline = points.map((item,index) => `${x(index).toFixed(1)},${y(item.value).toFixed(1)}`).join(' ');
      const labels = points.map((item,index) => index === 0 || index === points.length - 1 || index % Math.ceil(points.length / 5) === 0 ? `<text class="bfr-direction-chart-label" text-anchor="middle" x="${x(index).toFixed(1)}" y="${height - 10}">${esc(directionDateLabel(item.date))}</text>` : '').join('');
      const dots = points.map((item,index) => `<circle class="bfr-direction-chart-dot" cx="${x(index).toFixed(1)}" cy="${y(item.value).toFixed(1)}" r="4"><title>${esc(directionDateLabel(item.date))}: ${item.value.toFixed(1)}%</title></circle>`).join('');
      return `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Evolução real da frequência"><line class="bfr-direction-chart-axis" x1="${left}" y1="${y(100)}" x2="${width - right}" y2="${y(100)}"/><line class="bfr-direction-chart-axis" x1="${left}" y1="${y(50)}" x2="${width - right}" y2="${y(50)}"/><line class="bfr-direction-chart-axis" x1="${left}" y1="${y(0)}" x2="${width - right}" y2="${y(0)}"/><text class="bfr-direction-chart-label" x="0" y="${y(100) + 3}">100%</text><text class="bfr-direction-chart-label" x="7" y="${y(50) + 3}">50%</text><text class="bfr-direction-chart-label" x="12" y="${y(0) + 3}">0%</text><polyline class="bfr-direction-chart-line" points="${polyline}"/>${dots}${labels}</svg>`;
    }
    function directionBarRows(rows, max) {
      return `<div class="bfr-direction-bars">${rows.map(item => `<div class="bfr-direction-bar-row"><span>${esc(item.label)}</span><div class="bfr-direction-bar-track"><div class="bfr-direction-bar-fill" style="width:${Math.max(0,Math.min(100,item.value / max * 100))}%"></div></div><strong>${esc(item.display)}</strong></div>`).join('')}</div>`;
    }
    function renderDirectionAlertChart(panel) {
      const attention = panel.querySelector('.bfr-direction-primary-grid > .panel');
      if (!attention || attention.querySelector('[data-direction-alert-chart]')) return;
      const rows = [...attention.querySelectorAll('.bfr-direction-list article')].map(item => ({label:item.querySelector('strong')?.textContent?.trim() || 'Alerta',value:Number((item.innerText.match(/\d+/) || [0])[0]) || 0}));
      const active = rows.filter(item => item.value > 0);
      if (!active.length) return;
      const max = Math.max(...active.map(item => item.value),1);
      const chart = document.createElement('div');
      chart.className = 'bfr-direction-chart';
      chart.dataset.directionAlertChart = 'true';
      chart.innerHTML = `<div class="bfr-direction-chart-head"><strong>Atenção da direção</strong><span>ocorrências reais</span></div>${directionBarRows(active,max)}`;
      attention.appendChild(chart);
    }
    function renderDirectionCharts(panel, {students,attendance,grades}) {
      const academic = panel.querySelector('[data-direction-academic-chart]');
      if (!academic) return;
      const recordsByDate = new Map();
      (attendance || []).forEach(item => {
        if (!item.attendance_date) return;
        const row = recordsByDate.get(item.attendance_date) || {date:item.attendance_date,total:0,present:0};
        row.total += 1;
        if (item.status === 'present' || item.status === 'late') row.present += 1;
        recordsByDate.set(item.attendance_date,row);
      });
      const history = [...recordsByDate.values()].sort((a,b) => a.date.localeCompare(b.date)).map(item => ({...item,value:item.total ? item.present / item.total * 100 : 0}));
      const validGrades = (grades || []).filter(item => Number.isFinite(Number(item.score)));
      const academicBadge = academic.closest('.bfr-direction-command-panel')?.querySelector('.bfr-direction-panel-badge');
      if (history.length >= 2) {
        if (academicBadge) academicBadge.textContent = 'frequência real';
        academic.innerHTML = `<div class="bfr-direction-chart"><div class="bfr-direction-chart-head"><strong>Evolução da frequência</strong><span>${history.length} dias registrados</span></div>${directionLineSvg(history)}<div class="bfr-direction-chart-note">Como está a frequência? Cada ponto representa a proporção real de presença ou atraso entre os registros daquele dia.</div></div>`;
      } else if (validGrades.length >= 2) {
        if (academicBadge) academicBadge.textContent = 'notas reais';
        const bySubject = new Map();
        validGrades.forEach(item => { const key = item.subject || 'Componente não informado'; const row = bySubject.get(key) || {label:key,total:0,sum:0}; row.total += 1; row.sum += Number(item.score); bySubject.set(key,row); });
        let rows = [...bySubject.values()].map(item => ({label:item.label,value:item.sum / item.total,display:(item.sum / item.total).toFixed(1).replace('.',',')}));
        if (rows.length < 2) rows = validGrades.slice(-8).map(item => ({label:item.subject || item.assessment || 'Lançamento',value:Number(item.score),display:Number(item.score).toFixed(1).replace('.',',')}));
        rows = rows.filter(item => Number.isFinite(item.value));
        academic.innerHTML = `<div class="bfr-direction-chart"><div class="bfr-direction-chart-head"><strong>Desempenho acadêmico</strong><span>escala real de 0 a 10</span></div>${directionBarRows(rows,10)}<div class="bfr-direction-chart-note">Como está o desempenho? O gráfico usa somente notas já lançadas no sistema.</div></div>`;
      } else {
        if (academicBadge) academicBadge.textContent = 'aguardando dados';
        academic.innerHTML = emptyState('Dados insuficientes para gerar este gráfico','São necessários pelo menos dois dias de frequência ou dois lançamentos de notas reais.');
      }
      academic.querySelector('[data-direction-distribution-chart]')?.remove();
      if (!(attendance || []).length) return;
      const statusLabels = {present:'Presente',late:'Atrasado',absent:'Falta',justified:'Justificada'};
      const counts = new Map();
      attendance.forEach(item => { const key = statusLabels[item.status] || item.status || 'Sem situação informada'; counts.set(key,(counts.get(key) || 0) + 1); });
      const rows = [...counts.entries()].map(([label,value]) => ({label,value,display:String(value)}));
      const box = document.createElement('div');
      box.dataset.directionDistributionChart = 'true';
      box.className = 'bfr-direction-chart';
      box.innerHTML = rows.length >= 2 ? `<div class="bfr-direction-chart-head"><strong>Distribuição das situações</strong><span>registros de frequência</span></div>${directionBarRows(rows,Math.max(...rows.map(item => item.value),1))}` : emptyState('Dados insuficientes para a distribuição','Ainda não existem categorias suficientes de frequência para comparar.');
      academic.appendChild(box);
    }

    function addCommandPanels(panel) {
      if (!panel) return;
      trimDirectorExtras(panel);
      if (panel.dataset.directionCommandReady) { normalizeEmptyAttention(panel); return; }
      panel.dataset.directionCommandReady = 'true';
      injectCommandStyles();
      panel.classList.add('bfr-direction-command');
      const hero = panel.querySelector('.bfr-direction-hero');
      if (hero) {
        const eyebrow = hero.querySelector('.eyebrow');
        const title = hero.querySelector('h1');
        const copy = hero.querySelector('p');
        if (eyebrow) eyebrow.textContent = 'Centro de comando · Gestão escolar';
        if (title) title.textContent = 'Painel da direção';
        if (copy) copy.textContent = 'Visão geral da escola e dos principais indicadores para apoiar a tomada de decisão.';
        hero.insertAdjacentHTML('beforeend', `<div class="bfr-direction-hero-meta"><strong>Direção escolar</strong><span>Período: ${esc(new Intl.DateTimeFormat('pt-BR',{month:'long',year:'numeric'}).format(new Date()))}</span><span>Atualizado agora</span></div>`);
      }
      const kpis = [...panel.querySelectorAll('.bfr-direction-kpi')];
      const icons = ['👨‍🎓','🏫','👩‍🏫','✓','🧩'];
      kpis.forEach((kpi,index) => { if (!kpi.querySelector('.bfr-direction-kpi-icon')) kpi.insertAdjacentHTML('afterbegin',`<span class="bfr-direction-kpi-icon" aria-hidden="true">${icons[index] || '•'}</span>`); });
      const primary = panel.querySelector('.bfr-direction-grid');
      if (primary) {
        primary.classList.add('bfr-direction-primary-grid');
        const attention = primary.querySelector('.panel');
        const heading = attention?.querySelector('h2');
        const eyebrow = attention?.querySelector('.eyebrow');
        if (eyebrow) eyebrow.textContent = 'Prioridades e alertas';
        if (heading) heading.textContent = 'Atenção da direção';
      }
      const attendanceValue = kpis[3]?.querySelector('strong')?.textContent?.trim() || '—';
      const extra = document.createElement('div');
      extra.className = 'bfr-direction-command-grid';
      extra.innerHTML = `<section class="bfr-direction-command-panel" data-direction-academic-panel><div class="bfr-direction-panel-head"><div><div class="eyebrow">Indicadores acadêmicos</div><h2>Acompanhamento acadêmico</h2></div><span class="bfr-direction-panel-badge">dados disponíveis</span></div><div class="bfr-direction-data-strip"><div><span>Presenças registradas hoje</span><strong>${esc(attendanceValue)}</strong></div><div><span>Frequência percentual</span><strong>—</strong></div></div><div class="bfr-direction-empty"><strong>Indicador percentual não disponível</strong><span>O painel mantém o espaço preparado sem criar uma média fictícia.</span></div></section><section class="bfr-direction-command-panel" data-direction-class-panel><div class="bfr-direction-panel-head"><div><div class="eyebrow">Estrutura escolar</div><h2>Visão das turmas</h2></div><span class="bfr-direction-panel-badge">dados reais</span></div><div data-direction-class-content>${emptyState('Carregando turmas','Consultando os dados autorizados da escola.')}</div></section><section class="bfr-direction-command-panel"><div class="bfr-direction-panel-head"><div><div class="eyebrow">Compromissos</div><h2>Agenda da direção</h2></div><span class="bfr-direction-panel-badge">agenda</span></div>${emptyState('Nenhum compromisso carregado','Os eventos disponíveis para este perfil aparecerão aqui quando cadastrados.') }<div class="bfr-direction-actions"><button type="button" data-direction-open="horarios">Abrir horários</button></div></section><section class="bfr-direction-command-panel"><div class="bfr-direction-panel-head"><div><div class="eyebrow">Comunicação escolar</div><h2>Comunicação</h2></div><span class="bfr-direction-panel-badge">acompanhamento</span></div>${emptyState('Nenhum dado disponível no momento','Comunicados e mensagens autorizados para a direção serão exibidos nesta área.')}</section><section class="bfr-direction-command-panel"><div class="bfr-direction-panel-head"><div><div class="eyebrow">Gestão e análise</div><h2>Relatórios de gestão</h2></div><span class="bfr-direction-panel-badge">estrutura pronta</span></div>${emptyState('Nenhum relatório disponível no momento','Não há exportação de gestão conectada a este painel nesta versão.') }<div class="bfr-direction-actions"><button type="button" data-direction-open="atividades">Abrir atividades</button></div></section>`;
       const academicPanel = extra.querySelector('[data-direction-academic-panel]');
       if (academicPanel) {
         academicPanel.querySelector('.bfr-direction-data-strip')?.remove();
         academicPanel.querySelectorAll('.bfr-direction-empty').forEach(item => item.remove());
         const chart = document.createElement('div');
         chart.dataset.directionAcademicChart = 'true';
         chart.innerHTML = emptyState('Dados insuficientes para gerar este gráfico','São necessários registros acadêmicos reais para responder como está a frequência ou o desempenho.');
         academicPanel.appendChild(chart);
       }
       renderDirectionAlertChart(panel);
       panel.appendChild(extra);
       extra.insertAdjacentHTML('beforeend','<section class="bfr-direction-command-panel bfr-direction-quick-access"><div class="bfr-direction-panel-head"><div><div class="eyebrow">Acesso rápido</div><h2>Atalhos administrativos</h2></div><span class="bfr-direction-panel-badge">áreas existentes</span></div><div class="bfr-direction-quick-links"><button type="button" data-direction-open="horarios">Horários</button><button type="button" data-direction-open="atividades">Central de atividades</button><button type="button" data-direction-open="experiencias">Experiências</button></div></section>');
       normalizeEmptyAttention(panel);
       loadRealClasses(panel);
       setupDirectionChartRealtime(panel);
    }

     function setupDirectionChartRealtime(panel) {
       if (!panel || panel.dataset.directionChartRealtime || typeof supabaseClient === 'undefined' || !supabaseClient?.channel) return;
       panel.dataset.directionChartRealtime = 'true';
       let refreshTimer = null;
       const refresh = () => { clearTimeout(refreshTimer); refreshTimer = setTimeout(() => loadRealClasses(panel), 250); };
       supabaseClient.channel('bfr-direction-visuals').on('postgres_changes',{event:'*',schema:'public',table:'attendance'},refresh).on('postgres_changes',{event:'*',schema:'public',table:'grades'},refresh).on('postgres_changes',{event:'*',schema:'public',table:'students'},refresh).on('postgres_changes',{event:'*',schema:'public',table:'classes'},refresh).subscribe();
     }
     async function loadRealClasses(panel) {
      const target = panel.querySelector('[data-direction-class-content]');
      if (!target || typeof supabaseClient === 'undefined' || !supabaseClient) return;
      try {
        const [classesResult, studentsResult, attendanceResult, gradesResult] = await Promise.all([
          supabaseClient.from('classes').select('id,year,class_code').order('year').order('class_code'),
          supabaseClient.from('students').select('id,class_id,active').eq('active',true),
          supabaseClient.from('attendance').select('student_id,attendance_date,status').order('attendance_date',{ascending:true}).limit(5000),
          supabaseClient.from('grades').select('student_id,subject,assessment,score,created_at').order('created_at',{ascending:true}).limit(5000)
        ]);
        if (classesResult.error || studentsResult.error) { target.innerHTML = emptyState('Nenhum dado disponível no momento','A distribuição por turma não pôde ser carregada com as permissões desta conta.'); return; }
        const students = studentsResult.data || [];
        const rows = (classesResult.data || []).map(item => ({...item,total:students.filter(student => student.class_id === item.id).length}));
        const attendance = attendanceResult.error ? [] : attendanceResult.data || [];
        const grades = gradesResult.error ? [] : gradesResult.data || [];
        if (!rows.length) {
          target.innerHTML = emptyState('Nenhuma turma cadastrada','A estrutura será preenchida quando houver turmas cadastradas.');
          const classBadge = panel.querySelector('[data-direction-class-panel] .bfr-direction-panel-badge');
          if (classBadge) classBadge.textContent = 'aguardando dados';
          renderDirectionCharts(panel,{students,attendance,grades});
          return;
        }
        const classBadge = panel.querySelector('[data-direction-class-panel] .bfr-direction-panel-badge');
        if (classBadge) classBadge.textContent = rows.some(item => item.total > 0) ? 'dados reais' : 'aguardando dados';
        const studentClass = new Map(students.map(item => [item.id,item.class_id]));
        const classAttendance = new Map();
        attendance.forEach(item => { const classId = studentClass.get(item.student_id); if (!classId) return; const row = classAttendance.get(classId) || {total:0,present:0}; row.total += 1; if (item.status === 'present' || item.status === 'late') row.present += 1; classAttendance.set(classId,row); });
        const frequencyRows = rows.filter(item => (classAttendance.get(item.id)?.total || 0) > 0).map(item => ({label:`${item.year}º ${item.class_code}`,value:classAttendance.get(item.id).present / classAttendance.get(item.id).total * 100,display:`${(classAttendance.get(item.id).present / classAttendance.get(item.id).total * 100).toFixed(1).replace('.',',')}%`}));
        const activeRows = rows.filter(item => item.total > 0).map(item => ({label:`${item.year}º ${item.class_code}`,value:item.total,display:String(item.total)}));
        const chartRows = frequencyRows.length >= 2 ? frequencyRows : activeRows;
        const chartTitle = frequencyRows.length >= 2 ? 'Frequência por turma' : 'Alunos ativos por turma';
        const chartNote = frequencyRows.length >= 2 ? 'Qual turma apresenta maior necessidade de atenção? Comparação baseada nos registros reais de frequência.' : 'Comparação estrutural baseada no cadastro real de alunos ativos.';
        const chart = chartRows.length >= 2 ? `<div class="bfr-direction-chart" data-direction-class-chart><div class="bfr-direction-chart-head"><strong>Comparação entre turmas</strong><span>${chartTitle}</span></div>${directionBarRows(chartRows,frequencyRows.length >= 2 ? 100 : Math.max(...chartRows.map(item => item.value),1))}<div class="bfr-direction-chart-note">${chartNote}</div></div>` : emptyState('Dados insuficientes para comparar turmas','É necessário haver dados reais em pelo menos duas turmas.');
        target.innerHTML = `<div class="bfr-direction-table-wrap"><table class="bfr-direction-table"><thead><tr><th>Turma</th><th>Alunos ativos</th><th>Situação</th></tr></thead><tbody>${rows.map(item => `<tr><td><strong>${esc(item.year)}º ano ${esc(item.class_code)}</strong></td><td>${item.total}</td><td><span class="bfr-direction-status-pill">${item.total ? 'Regular' : 'Sem alunos ativos'}</span></td></tr>`).join('')}</tbody></table></div>${chart}`;
        renderDirectionCharts(panel,{students,attendance,grades});
      } catch { target.innerHTML = emptyState('Nenhum dado disponível no momento','A distribuição por turma não pôde ser carregada agora.'); }
    }

     const observeDirectionView = view => {
       if (!view) return;
       new MutationObserver(() => addCommandPanels(document.getElementById('bfrDirectionPanel'))).observe(view,{childList:true,subtree:true});
     };
     observeDirectionView(document.getElementById('directorView'));
     observeDirectionView(document.getElementById('adminView'));
    addCommandPanels(document.getElementById('bfrDirectionPanel'));
  })();
</script>
<script id="bfr-director-routine-runtime">
  (() => {
    const allowedRoles = ['director','developer'];
    const state = { items: [], loading: false, loaded: false, error: '' };
    const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const db = () => typeof supabaseClient !== 'undefined' ? supabaseClient : null;
    const user = () => typeof currentUser !== 'undefined' ? currentUser : null;
    const role = () => typeof currentProfile !== 'undefined' ? currentProfile?.role || '' : '';
    const today = () => new Date().toISOString().slice(0, 10);
    const dateLabel = value => value ? new Date(`${value}T12:00:00`).toLocaleDateString('pt-BR',{day:'2-digit',month:'short',year:'numeric'}).replace('.', '') : 'Sem prazo';
    const timeLabel = value => value ? String(value).slice(0, 5) : '';
    const typeLabel = { task:'Tarefa', commitment:'Compromisso', reminder:'Lembrete' };
    const priorityLabel = { low:'Baixa', normal:'Normal', high:'Alta' };
    const itemStatus = item => {
      if (item.is_done) return { label:'Concluída', className:'done' };
      if (item.due_date && item.due_date < today()) return { label:'Atrasada', className:'late' };
      if (item.due_date === today()) return { label:'Hoje', className:'today' };
      return { label:'Pendente', className:'pending' };
    };
    const sortItems = items => [...items].sort((a,b) => Number(a.is_done) - Number(b.is_done) || String(a.due_date || '9999-12-31').localeCompare(String(b.due_date || '9999-12-31')) || String(a.due_time || '99:99').localeCompare(String(b.due_time || '99:99')) || String(b.created_at || '').localeCompare(String(a.created_at || '')));

    function injectStyles() {
      if (document.getElementById('bfr-director-routine-style')) return;
      const style = document.createElement('style');
      style.id = 'bfr-director-routine-style';
      style.textContent = `
        .bfr-routine-panel{grid-column:1/-1;margin-top:14px;padding:18px;border:1px solid #dbe6f3;border-radius:16px;background:#fff;box-shadow:0 9px 23px rgba(43,67,115,.055)}
        .bfr-routine-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}
        .bfr-routine-head h2{margin:4px 0 0;color:#173b79;font:700 21px 'Playfair Display',serif}
        .bfr-routine-head p{margin:6px 0 0;color:#71809a;font-size:11px;line-height:1.45}
        .bfr-routine-private{border-radius:999px;padding:6px 9px;color:#1769d2;background:#edf5ff;font:9px 'DM Mono',monospace;white-space:nowrap;text-transform:uppercase}
        .bfr-routine-layout{display:grid;grid-template-columns:minmax(240px,.75fr) minmax(0,1.25fr);gap:14px;margin-top:15px;align-items:start}
        .bfr-routine-form{display:grid;gap:9px;padding:14px;border:1px solid #e1eaf4;border-radius:13px;background:#f8fbff}
        .bfr-routine-form label{display:grid;gap:5px;color:#526b88;font-size:10px;font-weight:700}
        .bfr-routine-form input,.bfr-routine-form select,.bfr-routine-form textarea{width:100%;min-width:0;border:1px solid #dbe5f1;border-radius:8px;padding:9px 10px;color:#243856;background:#fff;font:11px 'DM Sans',sans-serif}
        .bfr-routine-form textarea{min-height:66px;resize:vertical}
        .bfr-routine-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
        .bfr-routine-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
        .bfr-routine-primary,.bfr-routine-secondary{border-radius:9px;padding:9px 11px;font-size:10px;font-weight:800;cursor:pointer}
        .bfr-routine-primary{border:1px solid #1769d2;color:#fff;background:#1769d2}
        .bfr-routine-secondary{border:1px solid #cfe0fb;color:#1769d2;background:#fff}
        .bfr-routine-status{color:#71809a;font-size:10px;line-height:1.35}
        .bfr-routine-list-wrap{min-width:0}
        .bfr-routine-list-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:9px}
        .bfr-routine-list-head strong{color:#243856;font-size:12px}
        .bfr-routine-count{color:#71809a;font:9px 'DM Mono',monospace}
        .bfr-routine-list{display:grid;gap:8px}
        .bfr-routine-item{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:start;padding:11px;border:1px solid #e1eaf4;border-radius:11px;background:#fbfdff}
        .bfr-routine-item.is-done{opacity:.7;background:#f7fafb}
        .bfr-routine-check{width:27px;height:27px;border:1px solid #cfe0fb;border-radius:8px;color:#1769d2;background:#edf5ff;font-size:13px;cursor:pointer}
        .bfr-routine-item.is-done .bfr-routine-check{color:#fff;background:#16a37d;border-color:#16a37d}
        .bfr-routine-item strong{display:block;color:#243856;font-size:12px;line-height:1.35}
        .bfr-routine-item.is-done strong{text-decoration:line-through}
        .bfr-routine-details{margin-top:4px;color:#71809a;font-size:10px;line-height:1.4;white-space:pre-wrap}
        .bfr-routine-meta{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px;color:#71809a;font:9px 'DM Mono',monospace}
        .bfr-routine-meta span{border-radius:999px;padding:4px 6px;background:#f0f5fb}
        .bfr-routine-meta .late{color:#a24f3d;background:#fff0eb}.bfr-routine-meta .today{color:#9b6d13;background:#fff4d5}.bfr-routine-meta .done{color:#16826f;background:#e8f7ef}
        .bfr-routine-priority{color:#1769d2!important;background:#edf5ff!important}.bfr-routine-priority.high{color:#a24f3d!important;background:#fff0eb!important}
        .bfr-routine-item-actions{display:flex;gap:5px}
        .bfr-routine-item-actions button{border:0;border-radius:7px;padding:6px 7px;color:#1769d2;background:#edf5ff;font-size:9px;cursor:pointer}
        .bfr-routine-item-actions button[data-routine-delete]{color:#a24f3d;background:#fff0eb}
        .bfr-routine-empty{padding:18px;border:1px dashed #cbd9ea;border-radius:11px;color:#71809a;background:#f8fbff;font-size:10px;line-height:1.45;text-align:center}
        @media(max-width:780px){.bfr-routine-head{display:block}.bfr-routine-private{display:inline-flex;margin-top:10px}.bfr-routine-layout{grid-template-columns:1fr}.bfr-routine-panel{padding:14px}.bfr-routine-item{grid-template-columns:auto minmax(0,1fr)}.bfr-routine-item-actions{grid-column:2}}
      `;
      document.head.appendChild(style);
    }

    function markup() {
      return `<section class="bfr-routine-panel" data-director-routine><div class="bfr-routine-head"><div><div class="eyebrow">Espaço privado da direção</div><h2>Minha Rotina</h2><p>Organize tarefas, compromissos e lembretes que somente sua conta pode visualizar.</p></div><span class="bfr-routine-private">privado · sincronizado</span></div><div class="bfr-routine-layout"><form class="bfr-routine-form" data-routine-form><input type="hidden" name="id"><label>O que precisa ser feito?<input name="title" required maxlength="160" placeholder="Ex.: Revisar reunião pedagógica"></label><div class="bfr-routine-form-grid"><label>Tipo<select name="item_type"><option value="task">Tarefa</option><option value="commitment">Compromisso</option><option value="reminder">Lembrete</option></select></label><label>Prioridade<select name="priority"><option value="normal">Normal</option><option value="high">Alta</option><option value="low">Baixa</option></select></label><label>Data<input name="due_date" type="date"></label><label>Horário<input name="due_time" type="time"></label></div><label>Detalhes<textarea name="details" maxlength="800" placeholder="Observações opcionais"></textarea></label><div class="bfr-routine-actions"><button class="bfr-routine-primary" type="submit" data-routine-submit>Adicionar à rotina</button><button class="bfr-routine-secondary hidden" type="button" data-routine-cancel>Cancelar edição</button><span class="bfr-routine-status" data-routine-status></span></div></form><div class="bfr-routine-list-wrap"><div class="bfr-routine-list-head"><strong>Itens da sua rotina</strong><span class="bfr-routine-count" data-routine-count>carregando</span></div><div class="bfr-routine-list" data-routine-list><div class="bfr-routine-empty">Carregando seus itens privados...</div></div></div></div></section>`;
    }

    function render(panel) {
      const list = panel.querySelector('[data-routine-list]');
      const count = panel.querySelector('[data-routine-count]');
      if (!list || !count) return;
      const items = sortItems(state.items);
      const open = items.filter(item => !item.is_done).length;
      count.textContent = `${open} pendente${open === 1 ? '' : 's'} · ${items.length} total`;
      if (state.error) { list.innerHTML = `<div class="bfr-routine-empty">${esc(state.error)}</div>`; return; }
      if (!items.length) { list.innerHTML = '<div class="bfr-routine-empty"><strong>Nenhum item salvo ainda.</strong><br>Use o formulário para registrar a primeira tarefa, reunião ou lembrança.</div>'; return; }
      list.innerHTML = items.map(item => {
        const status = itemStatus(item);
        const when = item.due_date ? `${dateLabel(item.due_date)}${timeLabel(item.due_time) ? ` · ${timeLabel(item.due_time)}` : ''}` : 'Sem prazo';
        return `<article class="bfr-routine-item ${item.is_done ? 'is-done' : ''}" data-routine-item="${esc(item.id)}"><button class="bfr-routine-check" type="button" data-routine-toggle="${esc(item.id)}" aria-label="${item.is_done ? 'Reabrir item' : 'Concluir item'}">${item.is_done ? '✓' : '○'}</button><div><strong>${esc(item.title)}</strong>${item.details ? `<div class="bfr-routine-details">${esc(item.details)}</div>` : ''}<div class="bfr-routine-meta"><span class="${status.className}">${status.label}</span><span>${esc(typeLabel[item.item_type] || 'Tarefa')}</span><span class="bfr-routine-priority ${item.priority === 'high' ? 'high' : ''}">${esc(priorityLabel[item.priority] || 'Normal')}</span><span>${esc(when)}</span></div></div><div class="bfr-routine-item-actions"><button type="button" data-routine-edit="${esc(item.id)}">Editar</button><button type="button" data-routine-delete="${esc(item.id)}">Excluir</button></div></article>`;
      }).join('');
    }

    async function load(panel) {
      if (!db() || !user() || !allowedRoles.includes(role())) return;
      state.loading = true; state.error = ''; render(panel);
      const result = await db().from('director_routine_items').select('id,owner_id,title,details,item_type,priority,due_date,due_time,is_done,completed_at,created_at,updated_at').eq('owner_id',user().id).order('is_done',{ascending:true}).order('due_date',{ascending:true,nullsFirst:false}).order('due_time',{ascending:true,nullsFirst:false}).order('created_at',{ascending:false});
      state.loading = false; state.loaded = true;
      if (result.error) { state.items = []; state.error = 'Não foi possível carregar sua rotina. Verifique a conexão e tente novamente.'; render(panel); return; }
      state.items = result.data || []; render(panel);
    }

    function resetForm(panel) {
      const form = panel.querySelector('[data-routine-form]');
      if (!form) return;
      form.reset(); form.id.value = '';
      panel.querySelector('[data-routine-submit]').textContent = 'Adicionar à rotina';
      panel.querySelector('[data-routine-cancel]').classList.add('hidden');
      panel.querySelector('[data-routine-status]').textContent = '';
    }

    function editItem(panel, item) {
      const form = panel.querySelector('[data-routine-form]');
      if (!form) return;
      form.id.value = item.id; form.title.value = item.title || ''; form.item_type.value = item.item_type || 'task'; form.priority.value = item.priority || 'normal'; form.due_date.value = item.due_date || ''; form.due_time.value = timeLabel(item.due_time); form.details.value = item.details || '';
      panel.querySelector('[data-routine-submit]').textContent = 'Salvar alterações';
      panel.querySelector('[data-routine-cancel]').classList.remove('hidden');
      form.title.focus();
    }

    async function saveItem(form, panel) {
      const data = new FormData(form); const id = String(data.get('id') || '');
      const payload = { title:String(data.get('title') || '').trim(), details:String(data.get('details') || '').trim() || null, item_type:data.get('item_type'), priority:data.get('priority'), due_date:data.get('due_date') || null, due_time:data.get('due_time') || null, updated_at:new Date().toISOString() };
      if (!payload.title) return;
      const button = panel.querySelector('[data-routine-submit]'); const status = panel.querySelector('[data-routine-status]'); button.disabled = true; status.textContent = 'Salvando...';
      const result = id ? await db().from('director_routine_items').update(payload).eq('id',id).eq('owner_id',user().id) : await db().from('director_routine_items').insert({...payload,owner_id:user().id}).select().single();
      button.disabled = false;
      if (result.error) { status.textContent = 'Não foi possível salvar este item.'; return; }
      resetForm(panel); await load(panel);
    }

    async function toggleItem(panel, item) {
      const result = await db().from('director_routine_items').update({is_done:!item.is_done,completed_at:item.is_done ? null : new Date().toISOString(),updated_at:new Date().toISOString()}).eq('id',item.id).eq('owner_id',user().id);
      if (result.error) { panel.querySelector('[data-routine-status]').textContent = 'Não foi possível atualizar o item.'; return; }
      await load(panel);
    }

    async function deleteItem(panel, item) {
      if (!window.confirm(`Excluir “${item.title}” da sua rotina?`)) return;
      const result = await db().from('director_routine_items').delete().eq('id',item.id).eq('owner_id',user().id);
      if (result.error) { panel.querySelector('[data-routine-status]').textContent = 'Não foi possível excluir o item.'; return; }
      await load(panel);
    }

    function setup(panel) {
      if (!panel || panel.dataset.routineReady || !allowedRoles.includes(role())) return;
      panel.dataset.routineReady = 'true'; injectStyles(); panel.insertAdjacentHTML('beforeend',markup()); load(panel);
    }

    document.addEventListener('submit', event => { const form = event.target.closest('[data-routine-form]'); if (!form) return; event.preventDefault(); const panel = form.closest('[data-director-routine]'); if (panel) saveItem(form,panel); });
    document.addEventListener('click', event => {
      const panel = event.target.closest('[data-director-routine]'); if (!panel) return;
      const id = event.target.closest('[data-routine-toggle],[data-routine-edit],[data-routine-delete]')?.dataset.routineToggle || event.target.closest('[data-routine-edit]')?.dataset.routineEdit || event.target.closest('[data-routine-delete]')?.dataset.routineDelete;
      if (event.target.closest('[data-routine-cancel]')) { resetForm(panel); return; }
      if (!id) return;
      const item = state.items.find(entry => entry.id === id); if (!item) return;
      if (event.target.closest('[data-routine-toggle]')) toggleItem(panel,item);
      else if (event.target.closest('[data-routine-edit]')) editItem(panel,item);
      else if (event.target.closest('[data-routine-delete]')) deleteItem(panel,item);
    });

     const ensure = () => { const panel = document.querySelector('#bfrDirectionPanel'); if (panel) setup(panel); };
     [document.getElementById('directorView'),document.getElementById('adminView')].filter(Boolean).forEach(view => new MutationObserver(ensure).observe(view,{childList:true,subtree:true}));
    let tries = 0; const timer = setInterval(() => { tries++; ensure(); if (tries > 180) clearInterval(timer); }, 1200);
  })();
</script>
<style id="bfr-global-layout-fix">
  :root { --bfr-sidebar-width: 236px; }
  html:has(#appShell.ready), body:has(#appShell.ready) { height: 100%; }
  body:has(#appShell.ready) { overflow: hidden; }
  #appShell.ready { display: block !important; width: 100%; height: 100vh; min-height: 100vh; overflow: visible !important; }
  #appShell.ready .sidebar { position: fixed !important; top: 0 !important; right: auto !important; bottom: auto !important; left: 0 !important; z-index: 20; width: var(--bfr-sidebar-width) !important; height: 100vh !important; min-height: 100vh !important; max-height: 100vh; overflow-x: hidden !important; overflow-y: auto !important; flex-shrink: 0; }
  #appShell.ready main { display: block; width: calc(100% - var(--bfr-sidebar-width)); height: 100vh; min-width: 0; min-height: 0; margin-left: var(--bfr-sidebar-width); overflow-x: hidden; overflow-y: auto; overscroll-behavior-y: contain; }
  #appShell.ready .topbar { position: sticky; top: 0; z-index: 4; width: 100%; }
  #appShell.ready .content { width: 100% !important; max-width: none !important; min-width: 0; margin: 0; }
  #appShell.ready .content > * { min-width: 0; }
  @media (max-width:1100px) and (min-width:801px) {
    :root { --bfr-sidebar-width: 208px; }
  }
  @media (max-width:800px) {
    html:has(#appShell.ready), body:has(#appShell.ready) { height: auto; }
    body:has(#appShell.ready) { overflow-x: hidden; overflow-y: auto; }
    #appShell.ready { height: auto; min-height: 100vh; overflow: visible !important; }
    #appShell.ready .sidebar { top: auto !important; right: 0 !important; bottom: 0 !important; left: 0 !important; width: auto !important; height: 78px !important; min-height: 78px !important; max-height: none; overflow: visible !important; }
    #appShell.ready main { width: 100%; height: auto; min-height: 0; margin-left: 0; overflow: visible; }
    #appShell.ready .content { width: 100% !important; max-width: none !important; }
  }
</style>
<script id="bfr-global-scroll-bridge">
  (() => {
    const nativeScrollTo = window.scrollTo.bind(window);
    window.scrollTo = (...args) => {
      const main = document.querySelector('#appShell.ready > main');
      if (!main) return nativeScrollTo(...args);
      const options = typeof args[0] === 'object' ? args[0] : { left:args[0] || 0, top:args[1] || 0 };
      main.scrollTo({ left:options.left || 0, top:options.top || 0, behavior:options.behavior === 'smooth' ? 'smooth' : 'auto' });
    };
    if (document.querySelector('#appShell.ready')) nativeScrollTo(0, 0);
  })();
</script>
<script id="bfr-agenda-copy">
  (() => {
    const updateAgendaCopy = () => {
      const panel = [...document.querySelectorAll('#bfrDirectionPanel .bfr-direction-command-panel')]
        .find(section => section.querySelector('h2')?.textContent.trim() === 'Agenda da direção');
      if (!panel) return;
      panel.querySelector('.eyebrow').textContent = 'Eventos oficiais';
      panel.querySelector('h2').textContent = 'Agenda escolar';
      panel.querySelector('.bfr-direction-panel-badge').textContent = 'eventos compartilhados';
      panel.querySelectorAll('strong').forEach(node => {
        if (node.textContent.trim() === 'Nenhum compromisso carregado') node.textContent = 'Nenhum evento oficial carregado';
      });
      panel.querySelectorAll('span').forEach(node => {
        if (node.textContent.trim() === 'Os eventos disponíveis para este perfil aparecerão aqui quando cadastrados.') {
          node.textContent = 'Os eventos oficiais da escola aparecerão aqui quando cadastrados.';
        }
      });
    };
    updateAgendaCopy();
  })();
</script>
