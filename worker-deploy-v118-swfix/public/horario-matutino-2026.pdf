     .login-form #googleLogin:hover, .login-form #googleLogin:focus, .login-form #googleLogin:focus-visible, .login-form #googleLogin:active { outline:none !important; box-shadow:none !important; -webkit-tap-highlight-color:transparent !important; }
     .login-form #publicScheduleBtn { position:absolute !important; display:flex !important; visibility:visible !important; z-index:5 !important; left:53.3% !important; top:62.4% !important; width:42.5% !important; height:2.8% !important; margin:0 !important; padding:0 !important; border:0 !important; background:transparent !important; color:#1769d2 !important; font-size:11px !important; font-weight:700 !important; justify-content:center !important; align-items:center !important; }
     .login-form #publicScheduleBtn span { display:none !important; }
    .login-footer { display:none !important; }
  }
  @keyframes bfrCardFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-3px); } }
  @keyframes bfrLogoFloat { 0%,100% { transform:translateY(0) scale(1); } 50% { transform:translateY(-4px) scale(1.012); } }
  @keyframes bfrIllustrationFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-7px); } }
  @keyframes bfrBenefitIn { from { opacity:0; transform:translateX(-14px); } to { opacity:1; transform:translateX(0); } }
  @keyframes bfrButtonSheen { 0%,55% { transform:translateX(-160%) skewX(-18deg); opacity:0; } 68% { opacity:1; } 82%,100% { transform:translateX(420%) skewX(-18deg); opacity:0; } }
  @media (min-width:801px) and (min-aspect-ratio:0.81) {
     .login-message:after { height:28% !important; background:none !important; animation:bfrIllustrationFloat 8s ease-in-out infinite !important; }
    .login-form { animation:bfrCardFloat 8s ease-in-out infinite; }
    .login-product-logo { animation:bfrLogoFloat 8s ease-in-out infinite; }
    .login-benefits > span { opacity:0; animation:bfrBenefitIn .65s cubic-bezier(.22,.8,.32,1) forwards; }
    .login-benefits > span:nth-child(1) { animation-delay:.08s; }
    .login-benefits > span:nth-child(2) { animation-delay:.18s; }
    .login-benefits > span:nth-child(3) { animation-delay:.28s; }
    .login-benefits > span:nth-child(4) { animation-delay:.38s; }
    .google-button { flex:0 0 94px !important; min-height:94px !important; overflow:hidden !important; }
    .google-button > * { position:relative; z-index:1; }
    .google-button:after { content:''; position:absolute; inset:0 auto 0 -30%; width:22%; background:linear-gradient(90deg,transparent,rgba(255,255,255,.68),transparent); transform:skewX(-18deg); animation:bfrButtonSheen 5.5s ease-in-out infinite; pointer-events:none; }
    .google-button:hover:after { animation:none; }
  }
  @media (min-width:801px) and (min-aspect-ratio:0.81) {
    .login-layout { height:100vh !important; min-height:100vh !important; }
