            .metric-card { min-height:126px; padding:14px; }
            .metric-value strong { font-size:27px; }
            .panel { border-radius:14px; padding:17px 15px; }
            .main-grid, .class-layout { grid-template-columns:1fr; }
            .login-screen { min-height:100svh; padding:0; place-items:stretch; }
