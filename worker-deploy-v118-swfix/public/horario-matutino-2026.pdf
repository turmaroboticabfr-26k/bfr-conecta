       let firebaseMessaging = null;
       const deferredScriptLoads = new Map();
         function loadExternalScript(src, globalName) {
          if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
          if (deferredScriptLoads.has(src)) return deferredScriptLoads.get(src);
          const existing = [...document.scripts].find(item => item.src === src);
          if (existing) {
            const promise = new Promise((resolve, reject) => {
              const finish = () => globalName && !window[globalName] ? reject(new Error('Biblioteca indisponível.')) : resolve(window[globalName]);
              existing.addEventListener('load', finish, { once:true });
              existing.addEventListener('error', () => reject(new Error('Não foi possível carregar este recurso.')), { once:true });
              if (globalName && window[globalName]) finish();
            });
            deferredScriptLoads.set(src, promise);
            return promise;
          }
          const promise = new Promise((resolve, reject) => {
           const script = document.createElement('script');
           script.src = src;
           script.async = true;
           script.onload = () => globalName && !window[globalName] ? reject(new Error('Biblioteca indisponível.')) : resolve(window[globalName]);
           script.onerror = () => reject(new Error('Não foi possível carregar este recurso.'));
           document.head.appendChild(script);
         });
         deferredScriptLoads.set(src, promise);
          return promise;
        }
