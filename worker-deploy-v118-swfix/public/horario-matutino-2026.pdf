            if (!detail || !group) { detail?.classList.add('hidden'); return; }
            detail.classList.remove('hidden');
            const students = teacherProfessionalState.students.filter(item => item.class_id === group.id);
            const ids = new Set(students.map(item => item.id));
            const grades = teacherProfessionalState.grades.filter(item => ids.has(item.student_id));
            const attendance = teacherProfessionalState.attendance.filter(item => ids.has(item.student_id));
            const averageValues = grades.map(item => Number(item.score)).filter(Number.isFinite);
            const average = averageValues.length ? (averageValues.reduce((sum,value) => sum + value, 0) / averageValues.length).toFixed(1).replace('.', ',') : '—';
            const tab = teacherProfessionalState.classTab;
            let body = '';
            if (tab === 'alunos') body = students.length ? `<div class="teacher-pro-student-list">${students.map(student => { const rate = teacherStudentAttendance(student.id); const avg = teacherStudentAverage(student.id); const warning = (rate !== null && rate < 75) || (avg !== null && avg < 6); return `<article class="teacher-pro-student-row"><span class="avatar">${escapeHtml(teacherInitials(student.official_name))}</span><div><strong>${escapeHtml(student.official_name)}</strong><span>${rate === null ? 'Frequência sem registros' : `${rate}% frequência`} · ${avg === null ? 'média sem notas' : `${avg.toFixed(1).replace('.', ',')} média`}</span></div><span class="teacher-pro-status ${warning ? 'warn' : ''}">${warning ? 'Atenção' : 'Acompanhado'}</span><button class="teacher-pro-inline-button" type="button" data-teacher-student="${escapeHtml(student.id)}">Ficha</button></article>`; }).join('')}</div>` : '<div class="teacher-pro-empty">Nenhum aluno ativo nesta turma.</div>';
            if (tab === 'frequencia') body = students.length ? `<div class="teacher-pro-student-list">${students.map(student => `<article class="teacher-pro-student-row"><span class="avatar">${escapeHtml(teacherInitials(student.official_name))}</span><div><strong>${escapeHtml(student.official_name)}</strong><span>${teacherStudentAttendance(student.id) === null ? 'Sem registros de frequência' : `${teacherStudentAttendance(student.id)}% de presença`}</span></div><button class="teacher-pro-inline-button" type="button" data-teacher-go="frequencia">Registrar chamada</button></article>`).join('')}</div>` : '<div class="teacher-pro-empty">Nenhum aluno ativo nesta turma.</div>';
            if (tab === 'notas') body = grades.length ? `<div class="teacher-pro-list">${students.map(student => { const avg = teacherStudentAverage(student.id); return `<article><div><strong>${escapeHtml(student.official_name)}</strong><span>${avg === null ? 'Sem notas lançadas' : `Média ${avg.toFixed(1).replace('.', ',')}`}</span></div><span class="teacher-pro-status">${grades.filter(item => item.student_id === student.id).length} lançamento(s)</span></article>`; }).join('')}</div>` : '<div class="teacher-pro-empty">Nenhuma nota lançada para esta turma.</div>';
            if (tab === 'atividades') { const activities = teacherProfessionalState.activities.filter(item => !item.class_id || item.class_id === group.id); body = activities.length ? `<div class="teacher-pro-list">${activities.map(item => `<article><div><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.subject || 'Atividade')} · ${item.due_date ? `prazo ${new Date(`${item.due_date}T12:00:00`).toLocaleDateString('pt-BR')}` : 'sem prazo'}</span></div><span class="teacher-pro-status">publicada</span></article>`).join('')}</div>` : '<div class="teacher-pro-empty">Nenhuma atividade publicada para esta turma.</div>'; }
            if (tab === 'avaliacoes') body = grades.length ? `<div class="teacher-pro-list">${[...new Map(grades.map(item => [`${item.assessment || 'Avaliação'}|${item.subject || ''}`,item])).values()].map(item => `<article><div><strong>${escapeHtml(item.assessment || 'Avaliação')}</strong><span>${escapeHtml(item.subject || 'Componente não informado')} · ${item.term ? `${item.term}º bimestre` : 'bimestre não informado'}</span></div><span class="teacher-pro-status">lançada</span></article>`).join('')}</div>` : '<div class="teacher-pro-empty">Nenhuma avaliação lançada para esta turma.</div>';
            if (tab === 'acompanhamento') { const lowAttendance = students.filter(student => { const rate = teacherStudentAttendance(student.id); return rate !== null && rate < 75; }).length; const lowGrades = students.filter(student => { const avg = teacherStudentAverage(student.id); return avg !== null && avg < 6; }).length; body = `<div class="teacher-pro-list"><article><div><strong>Frequência média</strong><span>Alunos com registros de presença: ${attendance.length ? students.filter(student => teacherStudentAttendance(student.id) !== null).length : 0}</span></div><span class="teacher-pro-status ${lowAttendance ? 'warn' : ''}">${lowAttendance} atenção</span></article><article><div><strong>Desempenho</strong><span>Alunos com notas lançadas: ${students.filter(student => teacherStudentAverage(student.id) !== null).length}</span></div><span class="teacher-pro-status ${lowGrades ? 'warn' : ''}">${lowGrades} atenção</span></article></div>`; }
            detail.innerHTML = `<div class="teacher-pro-section-head"><div><div class="eyebrow">Central da turma</div><h2>${escapeHtml(teacherClassLabel(group))}</h2><p>${students.length} alunos · ${grades.length} notas · ${attendance.length} registros de frequência</p></div><button class="teacher-pro-inline-button" type="button" data-teacher-go="turmas">Voltar às turmas</button></div><div class="teacher-pro-tabs">${[['alunos','👥 Alunos'],['frequencia','✓ Frequência'],['notas','📊 Notas'],['atividades','📝 Atividades'],['avaliacoes','📋 Avaliações'],['acompanhamento','📈 Acompanhamento']].map(([value,label]) => `<button type="button" class="${tab === value ? 'active' : ''}" data-teacher-class-tab="${value}">${label}</button>`).join('')}</div><div data-teacher-class-content>${body}</div>`;
          }
          function teacherRenderActivities() { const list = teacherView?.querySelector('[data-teacher-activities]'); if (!list) return; list.innerHTML = teacherProfessionalState.activities.length ? teacherProfessionalState.activities.map(item => `<article><div><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.subject || 'Atividade')} · ${escapeHtml(activityClassLabel(item))}${item.due_date ? ` · prazo ${new Date(`${item.due_date}T12:00:00`).toLocaleDateString('pt-BR')}` : ''}</span></div><button type="button" class="teacher-pro-inline-button" data-teacher-class-id="${escapeHtml(item.class_id || '')}">Abrir turma</button></article>`).join('') : '<div class="teacher-pro-empty">Nenhuma atividade criada.</div>'; }
          function teacherRenderAssessments() { const list = teacherView?.querySelector('[data-teacher-assessments]'); if (!list) return; const grouped = [...new Map(teacherProfessionalState.grades.map(item => [`${item.assessment || 'Avaliação'}|${item.subject || ''}|${item.student_id}`,item])).values()]; list.innerHTML = grouped.length ? grouped.slice(0,30).map(item => `<article><div><strong>${escapeHtml(item.assessment || 'Avaliação')}</strong><span>${escapeHtml(item.subject || 'Componente não informado')} · ${item.term ? `${item.term}º bimestre` : 'bimestre não informado'}</span></div><span class="teacher-pro-status">nota ${Number(item.score).toFixed(1).replace('.', ',')}</span></article>`).join('') : '<div class="teacher-pro-empty">Nenhuma avaliação lançada.</div>'; }
          function teacherRenderAlerts() { const list = teacherView?.querySelector('[data-teacher-alert-list]'); if (!list) return; const lowAttendance = teacherProfessionalState.students.filter(student => { const rate = teacherStudentAttendance(student.id); return rate !== null && rate < 75; }).length; const lowGrades = teacherProfessionalState.students.filter(student => { const avg = teacherStudentAverage(student.id); return avg !== null && avg < 6; }).length; const items = []; if (lowAttendance) items.push(`<article><div><strong>${lowAttendance} aluno${lowAttendance === 1 ? '' : 's'} com baixa frequência</strong><span>Consulte a central da turma para acompanhar os registros.</span></div><span class="teacher-pro-status warn">atenção</span></article>`); if (lowGrades) items.push(`<article><div><strong>${lowGrades} aluno${lowGrades === 1 ? '' : 's'} com média abaixo de 6</strong><span>Verifique notas e atividades antes do próximo lançamento.</span></div><span class="teacher-pro-status warn">atenção</span></article>`); list.innerHTML = items.length ? items.join('') : '<div class="teacher-pro-empty">Nenhuma situação exige atenção no momento.</div>'; }
           function teacherScheduleTime(entry) { const times = window.BFR_TEACHER_SCHEDULE?.periods?.[entry[0]]?.[entry[1]]?.[entry[2] - 1]; return times ? `${times[0]}–${times[1]}` : `Período ${entry[2]} · horário não informado`; }
           function teacherScheduleDayLabel(day) { return { segunda:'Segunda-feira', terca:'Terça-feira', quarta:'Quarta-feira', quinta:'Quinta-feira', sexta:'Sexta-feira' }[day] || day; }
           function teacherRenderSchedule() { const list = teacherView?.querySelector('[data-teacher-schedule-list]'); if (!list) return; const entries = teacherProfessionalState.scheduleEntries || []; if (!entries.length) { list.innerHTML = `<div class="teacher-pro-empty">${escapeHtml(teacherProfessionalState.error || 'Nenhuma aula vinculada ao seu nome na grade oficial de 2026.')}</div>`; return; } const order = ['segunda','terca','quarta','quinta','sexta']; const groups = order.map(day => [day, entries.filter(entry => entry[1] === day).sort((a,b) => a[2] - b[2] || a[3].localeCompare(b[3],'pt-BR'))]).filter(([,items]) => items.length); list.innerHTML = groups.map(([day,items]) => `<article><div><strong>${teacherScheduleDayLabel(day)}</strong><span>${items.length} aula${items.length === 1 ? '' : 's'} vinculada${items.length === 1 ? '' : 's'}</span></div><div class="teacher-pro-list">${items.map(entry => `<article><div><strong>${escapeHtml(entry[3])} · ${escapeHtml(entry[5] || 'Componente não informado')}</strong><span>${escapeHtml(teacherScheduleTime(entry))}${entry[4] ? ` · ${escapeHtml(entry[4])}` : ' · professor não identificado na fonte'}</span></div><span class="teacher-pro-status">${entry[0] === 'matutino' ? 'matutino' : 'vespertino'}</span></article>`).join('')}</div></article>`).join(''); }
           function teacherRenderTodaySchedule() { const list = teacherView?.querySelector('[data-teacher-today-list]'); if (!list) return; const days = ['domingo','segunda','terca','quarta','quinta','sexta','sabado']; const day = days[new Date().getDay()]; const entries = (teacherProfessionalState.scheduleEntries || []).filter(entry => entry[1] === day).sort((a,b) => a[2] - b[2] || a[3].localeCompare(b[3],'pt-BR')); list.innerHTML = entries.length ? entries.map(entry => `<article><div><strong>${escapeHtml(entry[3])} · ${escapeHtml(entry[5] || 'Componente não informado')}</strong><span>${escapeHtml(teacherScheduleTime(entry))}</span></div><span class="teacher-pro-status">${entry[0] === 'matutino' ? 'matutino' : 'vespertino'}</span></article>`).join('') : '<div class="teacher-pro-empty">Nenhuma aula vinculada para hoje.</div>'; }
           function teacherRenderProfessional() { teacherRenderMetrics(); teacherRenderClassList(); teacherRenderClassDetail(); teacherRenderActivities(); teacherRenderAssessments(); teacherRenderAlerts(); teacherRenderSchedule(); teacherRenderTodaySchedule(); const list = teacherView?.querySelector('[data-teacher-todo-list]'); if (list) list.innerHTML = '<div class="teacher-pro-empty">Nenhuma pendência de entrega ou avaliação disponível.</div>'; }
          function setProfessionalTeacherSection(section = 'inicio') { const root = teacherView?.querySelector('[data-teacher-professional]'); if (!root) return false; const key = String(section).replace(/^professor-/, ''); const target = root.querySelector(`[data-teacher-screen="${key}"]`); if (!target) return false; document.querySelectorAll('#appShell .content').forEach(view => view.classList.add('hidden')); teacherView.classList.remove('hidden'); root.querySelectorAll('[data-teacher-screen]').forEach(view => view.classList.toggle('hidden', view !== target)); document.querySelectorAll('[data-teacher-nav-tab]').forEach(item => item.classList.toggle('active', item.dataset.teacherNavTab === key)); document.querySelector('.breadcrumb b').textContent = { inicio:'Início', turmas:'Minhas turmas', atividades:'Atividades', avaliacoes:'Avaliações', frequencia:'Frequência', agenda:'Agenda', biblioteca:'Biblioteca', comunicacao:'Comunicação', espaco:'Meu espaço' }[key] || 'Início'; if (key === 'turmas') teacherRenderClassDetail(); return true; }
          async function loadProfessionalTeacherData(force = false) { if (teacherProfessionalState.loading || (teacherProfessionalState.loaded && !force)) { teacherRenderProfessional(); return; } teacherProfessionalState.loading = true; teacherProfessionalState.error = ''; teacherRenderProfessional(); if (!supabaseClient || !currentUser) { teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherProfessionalState.error = 'Os dados aparecerão após o login escolar.'; teacherRenderProfessional(); return; } const classesResult = await supabaseClient.from('classes').select('id,year,class_code,shift').order('year').order('class_code'); if (classesResult.error) { teacherProfessionalState.classes = []; teacherProfessionalState.error = 'Não foi possível carregar as turmas autorizadas.'; teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherRenderProfessional(); return; } teacherProfessionalState.classes = classesResult.data || []; const classIds = teacherProfessionalState.classes.map(item => item.id); const studentQuery = classIds.length ? supabaseClient.from('students').select('id,official_name,class_id').in('class_id',classIds).eq('active',true).order('official_name') : Promise.resolve({data:[],error:null}); const studentsResult = await studentQuery; teacherProfessionalState.students = studentsResult.data || []; const studentIds = teacherProfessionalState.students.map(item => item.id); const [gradesResult, attendanceResult, activitiesResult] = await Promise.all([studentIds.length ? supabaseClient.from('grades').select('student_id,subject,assessment,score,term,created_at').in('student_id',studentIds).order('created_at',{ascending:false}) : Promise.resolve({data:[],error:null}), studentIds.length ? supabaseClient.from('attendance').select('student_id,attendance_date,status').in('student_id',studentIds).order('attendance_date',{ascending:false}) : Promise.resolve({data:[],error:null}), supabaseClient.from('school_activities').select('id,title,subject,description,due_date,published_at,class_id,classes(year,class_code)').order('published_at',{ascending:false}).limit(60)]); teacherProfessionalState.grades = gradesResult.data || []; teacherProfessionalState.attendance = attendanceResult.data || []; teacherProfessionalState.activities = (activitiesResult.data || []).filter(item => !item.class_id || classIds.includes(item.class_id)); teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherRenderProfessional(); }
          function setupProfessionalTeacherView() { if (!teacherView?.querySelector('[data-teacher-professional]')) return; if (!document.body.dataset.teacherProfessionalReady) { document.body.dataset.teacherProfessionalReady = 'true'; document.addEventListener('click', event => { const go = event.target.closest('[data-teacher-go]'); if (go) { const target = go.dataset.teacherGo; if (target === 'chat') { document.querySelector('[data-section="chat-interno"]')?.click(); return; } navigateToSection(`professor-${target}`); return; } const classButton = event.target.closest('[data-teacher-class-id]'); if (classButton && classButton.dataset.teacherClassId) { teacherProfessionalState.selectedClassId = classButton.dataset.teacherClassId; teacherProfessionalState.classTab = 'alunos'; navigateToSection('professor-turmas'); return; } const tab = event.target.closest('[data-teacher-class-tab]'); if (tab) { teacherProfessionalState.classTab = tab.dataset.teacherClassTab; teacherRenderClassDetail(); return; } const student = event.target.closest('[data-teacher-student]'); if (student) { const record = teacherProfessionalState.students.find(item => item.id === student.dataset.teacherStudent); const detail = teacherView.querySelector('[data-teacher-class-detail]'); if (record && detail) detail.insertAdjacentHTML('beforeend', `<section class="panel" data-teacher-student-profile><div class="teacher-pro-section-head"><div><div class="eyebrow">Ficha pedagógica</div><h2>${escapeHtml(record.official_name)}</h2><p>Somente informações necessárias ao acompanhamento escolar.</p></div></div><div class="teacher-pro-list"><article><div><strong>Frequência</strong><span>${teacherStudentAttendance(record.id) === null ? 'Sem registros' : `${teacherStudentAttendance(record.id)}%`}</span></div></article><article><div><strong>Média</strong><span>${teacherStudentAverage(record.id) === null ? 'Sem notas' : teacherStudentAverage(record.id).toFixed(1).replace('.', ',')}</span></div></article></div></section>`); } }); }
           setProfessionalTeacherSection(teacherProfessionalState.loaded ? 'inicio' : 'inicio'); loadProfessionalTeacherData(); }
           function teacherScheduleNormalize(value) { return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('pt-BR').replace(/[^a-z0-9]+/g,' ').replace(/\bjonathann\b/g,'jonathan').replace(/\bjacuaminn\b/g,'jacuamin').trim(); }
           function teacherScheduleClassCode(group) { const code = String(group?.class_code || '').trim().toUpperCase(); return /^\d/.test(code) ? code : `${group?.year || ''}${code}`; }
           function teacherScheduleEntriesForCurrentUser() { const entries = window.BFR_TEACHER_SCHEDULE?.entries || []; if (currentProfile?.role === 'developer') return entries; const identities = [currentProfile?.full_name, currentUser?.user_metadata?.full_name, currentUser?.email?.split('@')[0]].map(teacherScheduleNormalize).filter(Boolean); return entries.filter(entry => entry[4] && identities.some(identity => { const teacher = teacherScheduleNormalize(entry[4]); return identity === teacher || identity.includes(teacher) || teacher.includes(identity) || identity.split(' ').includes(teacher); })); }
           async function loadProfessionalTeacherData(force = false) { if (teacherProfessionalState.loading || (teacherProfessionalState.loaded && !force)) { teacherRenderProfessional(); return; } teacherProfessionalState.loading = true; teacherProfessionalState.error = ''; teacherRenderProfessional(); if (!supabaseClient || !currentUser) { teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherProfessionalState.error = 'Os dados aparecerão após o login escolar.'; teacherRenderProfessional(); return; } const scheduleEntries = teacherScheduleEntriesForCurrentUser(); teacherProfessionalState.scheduleEntries = scheduleEntries; if (!scheduleEntries.length) { teacherProfessionalState.classes = []; teacherProfessionalState.students = []; teacherProfessionalState.grades = []; teacherProfessionalState.attendance = []; teacherProfessionalState.activities = []; teacherProfessionalState.error = 'Seu nome ainda não foi identificado na grade oficial de 2026.'; teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherRenderProfessional(); return; } const scheduleCodes = new Set(scheduleEntries.map(entry => entry[3])); const classesResult = await supabaseClient.from('classes').select('id,year,class_code,shift').eq('year',2026).order('year').order('class_code'); if (classesResult.error) { teacherProfessionalState.classes = []; teacherProfessionalState.error = 'Não foi possível carregar as turmas de 2026 autorizadas.'; teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherRenderProfessional(); return; } teacherProfessionalState.classes = (classesResult.data || []).filter(group => scheduleCodes.has(teacherScheduleClassCode(group))); if (!teacherProfessionalState.classes.length) { teacherProfessionalState.error = 'A grade foi localizada, mas nenhuma turma correspondente está cadastrada no banco escolar.'; teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherRenderProfessional(); return; } const classIds = teacherProfessionalState.classes.map(item => item.id); const studentQuery = classIds.length ? supabaseClient.from('students').select('id,official_name,class_id').in('class_id',classIds).eq('active',true).order('official_name') : Promise.resolve({data:[],error:null}); const studentsResult = await studentQuery; teacherProfessionalState.students = studentsResult.data || []; const studentIds = teacherProfessionalState.students.map(item => item.id); const [gradesResult, attendanceResult, activitiesResult] = await Promise.all([studentIds.length ? supabaseClient.from('grades').select('student_id,subject,assessment,score,term,created_at').in('student_id',studentIds).order('created_at',{ascending:false}) : Promise.resolve({data:[],error:null}), studentIds.length ? supabaseClient.from('attendance').select('student_id,attendance_date,status').in('student_id',studentIds).order('attendance_date',{ascending:false}) : Promise.resolve({data:[],error:null}), supabaseClient.from('school_activities').select('id,title,subject,description,due_date,published_at,class_id,classes(year,class_code)').order('published_at',{ascending:false}).limit(60)]); teacherProfessionalState.grades = gradesResult.data || []; teacherProfessionalState.attendance = attendanceResult.data || []; teacherProfessionalState.activities = (activitiesResult.data || []).filter(item => !item.class_id || classIds.includes(item.class_id)); teacherProfessionalState.loaded = true; teacherProfessionalState.loading = false; teacherRenderProfessional(); }
           document.addEventListener('click', event => { if (event.target.closest('#teacherOpenGrade')) document.getElementById('addGradeBtn')?.click(); const library = event.target.closest('[data-teacher-library]'); if (library && typeof window.bfrOpenReadingLibrary === 'function') window.bfrOpenReadingLibrary(); });
          function schoolGreeting(date = new Date()) {
          const hour = Number(new Intl.DateTimeFormat('en-US', { timeZone:schoolTimeZone, hour:'2-digit', hour12:false }).format(date));
          return hour < 5 ? 'Boa noite' : hour < 12 ? 'Bom dia' : hour < 18 ? 'Boa tarde' : 'Boa noite';
        }
        function updateLiveClock() {
          const now = new Date();
          const dateLabel = schoolDateParts(now).replace(/^./, letter => letter.toUpperCase());
           const greeting = schoolGreeting(now);
           const displayName = preferredDisplayName();
          document.querySelectorAll('[data-live-date]').forEach(element => { element.textContent = dateLabel; });
          document.querySelectorAll('[data-live-short-date]').forEach(element => { element.textContent = schoolShortDate(now); });
          document.querySelectorAll('[data-live-year]').forEach(element => { element.textContent = new Intl.DateTimeFormat('en-US', { timeZone:schoolTimeZone, year:'numeric' }).format(now); });
           document.querySelectorAll('[data-live-greeting], #studentView .welcome h1').forEach(element => { element.textContent = displayName && window.BFR_CURRENT_PROFILE ? `Olá, ${displayName}!` : `${greeting}${element.dataset.greetingRole ? `, ${element.dataset.greetingRole}` : ''}!`; });
          document.querySelectorAll('[data-live-clock]').forEach(element => { element.textContent = `Atualizado às ${schoolClock(now)}`; });
          document.querySelectorAll('[data-live-time]').forEach(element => { element.textContent = schoolClock(now); });
        }
        updateLiveClock();
        setInterval(updateLiveClock, 60000);
        const weatherLabels = {
          0:['☀','Céu limpo'], 1:['☼','Predominantemente limpo'], 2:['⛅','Parcialmente nublado'], 3:['☁','Nublado'],
          45:['≋','Neblina'], 48:['≋','Neblina'], 51:['☂','Garoa leve'], 53:['☂','Garoa'], 55:['☂','Garoa forte'],
          61:['☂','Chuva leve'], 63:['☂','Chuva'], 65:['☂','Chuva forte'], 80:['☂','Pancadas de chuva'], 81:['☂','Pancadas de chuva'], 82:['☂','Pancadas fortes'],
          95:['⚡','Tempestade'], 96:['⚡','Tempestade com granizo'], 99:['⚡','Tempestade com granizo']
        };
        async function loadWeather() {
          const widget = document.getElementById('weatherWidget');
          if (!widget) return;
          try {
            const response = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-9.74&longitude=-36.50&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code&timezone=America%2FMaceio', { cache:'no-store' });
            if (!response.ok) throw new Error('weather request failed');
            const data = await response.json();
            const current = data.current || {};
            const condition = weatherLabels[current.weather_code] || ['☼','Condição atual'];
            widget.querySelector('[data-weather-icon]').textContent = condition[0];
            widget.querySelector('[data-weather-temp]').textContent = Number.isFinite(current.temperature_2m) ? `${Math.round(current.temperature_2m)}°C` : '--°C';
            widget.querySelector('[data-weather-summary]').textContent = condition[1];
            widget.querySelector('[data-weather-feels]').textContent = Number.isFinite(current.apparent_temperature) ? `sensação ${Math.round(current.apparent_temperature)}°C · umidade ${current.relative_humidity_2m ?? '--'}%` : 'Dados atuais da região';
            widget.querySelector('[data-weather-updated]').textContent = `Atualizado às ${schoolClock()}`;
            widget.classList.remove('is-error');
          } catch (error) {
            widget.querySelector('[data-weather-icon]').textContent = '☼';
            widget.querySelector('[data-weather-temp]').textContent = '--°C';
            widget.querySelector('[data-weather-summary]').textContent = 'Previsão indisponível agora';
            widget.querySelector('[data-weather-feels]').textContent = 'Tente novamente em instantes';
            widget.querySelector('[data-weather-updated]').textContent = 'Serviço temporariamente indisponível';
            widget.classList.add('is-error');
          }
        }
         (window.requestIdleCallback || (callback => setTimeout(callback, 700)))(loadWeather);
        setInterval(loadWeather, 900000);
        const monitorState = { students:[], classes:[], records:[] };
      async function setupRoster() {
       if (rosterReady || !document.getElementById('rosterPanel')) return;
      const yearFilter = document.getElementById('yearFilter');
      const classFilter = document.getElementById('classFilter');
      const studentSearch = document.getElementById('studentSearch');
      const renderRoster = () => {
        const year = yearFilter.value;
        const turma = classFilter.value;
        const search = studentSearch.value.trim().toLocaleLowerCase('pt-BR');
        const groups = schoolRoster.classes.filter(group => (year === 'all' || String(group.year) === year) && (turma === 'all' || group.class === turma));
        const matched = groups.map(group => ({ ...group, students: group.students.filter(student => !search || student.name.toLocaleLowerCase('pt-BR').includes(search)) })).filter(group => group.students.length);
        const total = matched.reduce((sum, group) => sum + group.students.length, 0);
        document.getElementById('rosterMeta').textContent = `${matched.length} turma${matched.length === 1 ? '' : 's'} encontrada${matched.length === 1 ? '' : 's'} · ${total} aluno${total === 1 ? '' : 's'}`;
         document.getElementById('rosterGroups').innerHTML = matched.length ? matched.map(group => `<details class="roster-group" ${matched.length === 1 ? 'open' : ''}><summary>${escapeHtml(group.label)}<span>${group.students.length} alunos · ${escapeHtml(group.shift || 'turno não informado')}</span></summary><div class="roster-list">${group.students.map((student, index) => `<div class="roster-student"><b>${String(index + 1).padStart(2, '0')}</b>${escapeHtml(student.name)}</div>`).join('')}</div></details>`).join('') : '<div class="roster-empty">Nenhum aluno encontrado com esses filtros.</div>';
      };
       [yearFilter, classFilter, studentSearch].forEach(input => input.addEventListener('input', renderRoster));
       renderRoster();
        rosterReady = true;
       if (!supabaseClient || !['pedagogical','developer'].includes(currentProfile?.role)) return;
       const [{ data: classes, error: classesError }, { data: students, error: studentsError }] = await Promise.all([
         supabaseClient.from('classes').select('id,year,class_code,shift').order('year').order('class_code'),
          supabaseClient.from('students').select('official_name,class_id').eq('active',true).order('official_name')
       ]);
       if (classesError || studentsError || !classes?.length || !students) return;
       const studentsByClass = new Map(classes.map(group => [group.id, []]));
        students.forEach(student => studentsByClass.get(student.class_id)?.push({ name:student.official_name }));
       schoolRoster.classes = classes.map(group => ({ year:Number(group.year), class:group.class_code, shift:group.shift, label:`${group.year}º ano ${group.class_code}`, students:studentsByClass.get(group.id) || [] }));
       renderRoster();
      }
       function normalizePersonName(value) { return value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('pt-BR').trim(); }
       function renderMonitorStudentMatch() {
         const input = document.getElementById('monitorStudentInput');
         const studentId = document.getElementById('monitorStudentId');
         const selectedName = document.getElementById('monitorSelectedName');
         const classInput = document.getElementById('monitorClassInput');
         if (!input || !studentId || !selectedName || !classInput) return null;
         const previousStudent = studentId.value;
         const student = monitorState.students.find(item => normalizePersonName(item.official_name) === normalizePersonName(input.value));
         const classData = monitorState.classes.find(item => item.id === student?.class_id);
         studentId.value = student?.id || '';
         selectedName.textContent = student?.official_name || 'Nenhum aluno selecionado';
         classInput.value = classData ? `${classData.year}º ano ${classData.class_code}` : '';
         if (student && student.id !== previousStudent) loadMonitorGuardianContact(student);
         if (!student) { const contact = document.getElementById('monitorGuardianContact'); contact?.classList.add('hidden'); }
         return student && classData ? { student, classData } : null;
       }
       async function loadMonitorGuardianContact(student) {
         const contact = document.getElementById('monitorGuardianContact');
         if (!contact || !supabaseClient) return;
         contact.classList.remove('hidden');
         contact.innerHTML = '<span>Contato do responsável</span><a>Buscando telefone cadastrado...</a>';
         const { data:guardians, error } = await supabaseClient.rpc('get_student_guardians', { target_student:student.id });
         if (error || !guardians?.length) { contact.innerHTML = '<span>Contato do responsável</span><a>Não há telefone cadastrado</a>'; return; }
         const guardian = guardians.find(item => String(item.phone || '').replace(/\D/g,'').length >= 10);
         if (!guardian) { contact.innerHTML = '<span>Contato do responsável</span><a>Não há telefone cadastrado</a>'; return; }
         const phone = String(guardian.phone).trim();
         const rawDigits = phone.replace(/\D/g,'').replace(/^0/,'');
         const digits = rawDigits.startsWith('55') ? rawDigits : `55${rawDigits}`;
         const message = encodeURIComponent(`Olá. Aqui é da Escola Benício Ferreira Reis sobre ${student.official_name}.`);
         contact.innerHTML = `<span>Responsável cadastrado</span><a href="https://wa.me/${digits}?text=${message}" target="_blank" rel="noreferrer">${escapeHtml(guardian.full_name || 'Responsável')} · ${escapeHtml(phone)} ↗</a>`;
       }
       function renderMonitorHistory() {
         const panel = document.getElementById('monitorHistory');
         const list = document.getElementById('monitorHistoryList');
         if (!panel || !list) return;
         panel.classList.toggle('hidden', !monitorState.records.length);
         list.innerHTML = monitorState.records.map(record => `<div class="monitor-history-item"><strong>${escapeHtml(record.student)} · ${escapeHtml(record.classLabel)}</strong><span>${escapeHtml(record.description)} · ${new Date(record.createdAt).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}</span></div>`).join('');
       }
       async function setupMonitorView() {
         const form = document.getElementById('routeIncidentForm');
         if (!form || form.dataset.ready) return;
         form.dataset.ready = 'true';
         const input = document.getElementById('monitorStudentInput');
         input.addEventListener('input', renderMonitorStudentMatch);
         form.addEventListener('submit', submitRouteIncident);
         if (!supabaseClient || !['monitor','developer'].includes(currentProfile?.role)) return;
         const [{ data:students, error:studentsError }, { data:classes, error:classesError }] = await Promise.all([
           supabaseClient.from('students').select('id,official_name,class_id').eq('active',true).order('official_name'),
           supabaseClient.from('classes').select('id,year,class_code').order('year').order('class_code')
         ]);
         if (studentsError || classesError || !students || !classes) { document.getElementById('routeIncidentStatus').textContent = 'Não foi possível carregar a lista oficial.'; return; }
         monitorState.students = students;
         monitorState.classes = classes;
         document.getElementById('monitorStudentOptions').innerHTML = students.map(student => `<option value="${escapeHtml(student.official_name)}"></option>`).join('');
        }
        function ensureGateAlertView() {
          if (!monitorView || monitorView.querySelector('[data-gate-alert-panel]')) return;
          const panel = document.createElement('section');
          panel.className = 'panel gate-alert-panel hidden';
          panel.dataset.gateAlertPanel = 'true';
          panel.innerHTML = '<div class="panel-heading"><div><div class="eyebrow" style="color:#a24f3d">Aviso imediato · portaria</div><h2 style="margin-top:4px">Entradas que precisam de atenção</h2></div><span class="occurrence-status">monitor</span></div><p class="agenda-intro">A portaria será avisada quando um QR indicar que o aluno só pode entrar com responsável presente.</p><div data-gate-alert-list><div class="project-empty">Nenhum alerta de entrada.</div></div>';
          monitorView.querySelector('.monitor-layout')?.before(panel);
        }
        const gateAlertState = { items:[], loaded:false, loading:false, refreshTimer:null, channel:null };
        function renderGateAlerts() {
          const panel = monitorView?.querySelector('[data-gate-alert-panel]');
          const list = panel?.querySelector('[data-gate-alert-list]');
          if (!panel || !list) return;
          panel.classList.toggle('hidden', !gateAlertState.items.length);
          list.innerHTML = gateAlertState.items.length ? gateAlertState.items.map(item => {
            const student = Array.isArray(item.students) ? item.students[0] : item.students;
            const resolved = Boolean(item.resolved_at);
            const acknowledged = Boolean(item.acknowledged_at);
            const when = new Date(item.created_at).toLocaleString('pt-BR', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
            return `<article class="gate-alert-item ${resolved ? 'is-resolved' : ''}"><strong>${resolved ? 'Entrada liberada com responsável' : 'Entrada bloqueada · responsável obrigatório'}</strong><div><b>${escapeHtml(student?.official_name || 'Aluno')}</b><p>${escapeHtml(item.reason)}</p></div><small>Registrado ${when}${acknowledged ? ' · recebido pelo monitor' : ''}</small><div class="gate-alert-actions">${!acknowledged ? `<button class="text-button" type="button" data-ack-gate-alert="${item.id}">Confirmar recebimento</button>` : ''}</div></article>`;
          }).join('') : '<div class="project-empty">Nenhum alerta de entrada.</div>';
        }
        async function loadGateAlerts(force = false) {
          if (!monitorView || !supabaseClient || !currentUser || !['monitor','developer'].includes(currentProfile?.role) || (!force && (gateAlertState.loaded || gateAlertState.loading))) { renderGateAlerts(); return; }
          gateAlertState.loading = true;
           const { data, error } = await supabaseClient.from('gate_entry_alerts').select('id,student_id,reason,created_at,acknowledged_at,resolved_at,students(official_name)').is('resolved_at',null).order('created_at',{ascending:false}).limit(20);
          gateAlertState.loading = false;
          gateAlertState.loaded = true;
          gateAlertState.items = error ? [] : data || [];
          renderGateAlerts();
        }
        async function acknowledgeGateAlert(alertId) {
          if (!supabaseClient || !currentUser || !alertId) return;
          const { error } = await supabaseClient.from('gate_entry_alerts').update({ acknowledged_at:new Date().toISOString(), acknowledged_by:currentUser.id }).eq('id',alertId);
          if (!error) { gateAlertState.loaded = false; await loadGateAlerts(true); }
        }
        function setupGateEntryAlerts() {
          if (!monitorView) return;
          ensureGateAlertView();
          if (!document.body.dataset.gateAlertActions) {
            document.body.dataset.gateAlertActions = 'true';
            document.addEventListener('click', event => { const button = event.target.closest('[data-ack-gate-alert]'); if (button) acknowledgeGateAlert(button.dataset.ackGateAlert); });
          }
          loadGateAlerts();
          if (!gateAlertState.channel && supabaseClient.channel) {
             gateAlertState.channel = subscribeWithRecovery('bfr-gate-entry-alerts', channel => channel.on('postgres_changes', { event:'*', schema:'public', table:'gate_entry_alerts' }, () => loadGateAlerts(true)));
          }
          if (!gateAlertState.refreshTimer) gateAlertState.refreshTimer = setInterval(() => loadGateAlerts(true), 5000);
        }
        const entryRestrictionState = { students:[], items:[], loaded:false, loading:false };
        function renderEntryRestrictionControls() {
          const panel = adminView?.querySelector('#coordinationRestrictionPanel');
          if (!panel) return;
          const select = panel.querySelector('[data-entry-restriction-student]');
          const list = panel.querySelector('[data-entry-restriction-list]');
          select.innerHTML = entryRestrictionState.students.length ? `<option value="">Selecione um aluno</option>${entryRestrictionState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)} · ${escapeHtml(badgeClassLabel(student))}</option>`).join('')}` : '<option value="">Lista indisponível</option>';
          list.innerHTML = entryRestrictionState.items.length ? entryRestrictionState.items.map(item => { const student = Array.isArray(item.students) ? item.students[0] : item.students; return `<article class="restriction-item"><strong>${escapeHtml(student?.official_name || 'Aluno')}</strong><p>${escapeHtml(item.reason)}</p><small>Ativo desde ${new Date(item.created_at).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</small><button class="text-button" type="button" data-resolve-entry-restriction="${item.id}">Liberar entrada</button></article>`; }).join('') : '<div class="project-empty">Nenhuma pendência ativa.</div>';
        }
        async function loadEntryRestrictions(force = false) {
          if (!adminView || !supabaseClient || !currentUser || currentProfile?.role !== 'developer' || (!force && (entryRestrictionState.loaded || entryRestrictionState.loading))) { renderEntryRestrictionControls(); return; }
          entryRestrictionState.loading = true;
          const [{ data:students, error:studentsError }, { data:items, error:itemsError }] = await Promise.all([
            supabaseClient.from('students').select('id,official_name,class_id,classes(year,class_code)').eq('active',true).order('official_name'),
            supabaseClient.from('entry_restrictions').select('id,student_id,reason,created_at,students(official_name,classes(year,class_code))').eq('active',true).order('created_at',{ascending:false})
          ]);
          entryRestrictionState.loading = false;
          entryRestrictionState.loaded = true;
          entryRestrictionState.students = studentsError ? [] : students || [];
          entryRestrictionState.items = itemsError ? [] : items || [];
          renderEntryRestrictionControls();
        }
        async function createEntryRestriction(event) {
          event.preventDefault();
          const form = event.currentTarget;
          const status = form.querySelector('[data-entry-restriction-status]');
          const studentId = form.querySelector('[data-entry-restriction-student]').value;
          const reason = form.querySelector('[data-entry-restriction-reason]').value.trim();
          if (!studentId || !reason || !supabaseClient || currentProfile?.role !== 'developer') { status.textContent = 'Selecione um aluno e informe o motivo.'; return; }
          status.textContent = 'Salvando pendência...';
          const { error } = await supabaseClient.from('entry_restrictions').insert({ student_id:studentId, reason, created_by:currentUser.id });
          if (error) { status.textContent = 'Não foi possível salvar a pendência. Confira se a atualização do banco foi executada.'; return; }
          form.reset();
          status.textContent = 'Entrada bloqueada. O próximo QR lido gerará um alerta para o monitor.';
          entryRestrictionState.loaded = false;
          await loadEntryRestrictions(true);
        }
        async function resolveEntryRestriction(restrictionId) {
          if (!supabaseClient || !currentUser || currentProfile?.role !== 'developer' || !restrictionId) return;
          const { error } = await supabaseClient.from('entry_restrictions').update({ active:false, resolved_at:new Date().toISOString(), resolved_by:currentUser.id }).eq('id',restrictionId);
          if (!error) { entryRestrictionState.loaded = false; await loadEntryRestrictions(true); }
        }
        function setupEntryRestrictions() {
          const panel = adminView?.querySelector('#coordinationRestrictionPanel');
          const form = panel?.querySelector('[data-entry-restriction-form]');
          if (!form) return;
          if (!form.dataset.ready) { form.dataset.ready = 'true'; form.addEventListener('submit', createEntryRestriction); }
          if (!document.body.dataset.entryRestrictionActions) {
            document.body.dataset.entryRestrictionActions = 'true';
            document.addEventListener('click', event => { const button = event.target.closest('[data-resolve-entry-restriction]'); if (button) resolveEntryRestriction(button.dataset.resolveEntryRestriction); });
          }
          loadEntryRestrictions();
        }
        function ensureStudentLinkView() {
          const anchor = adminView?.querySelector('#coordinationRestrictionPanel');
          if (!anchor || adminView.querySelector('#studentAccountLinkPanel')) return;
          const panel = document.createElement('section');
          panel.className = 'panel';
          panel.id = 'studentAccountLinkPanel';
           panel.innerHTML = '<div class="panel-heading"><div><div class="eyebrow">Cadastro escolar · acesso do aluno</div><h2 style="margin-top:4px">Vincular conta de estudante</h2></div><span class="paperless-tag">● ADMIN</span></div><p class="agenda-intro">Associe a conta Google do estudante ao nome oficial da lista. Depois do vínculo, ele verá e poderá gerar o próprio crachá.</p><form class="publish-form" data-student-link-form><label>Conta do estudante<select data-student-account required><option value="">Carregando contas...</option></select></label><label>Aluno da lista oficial<select data-student-account-student required><option value="">Carregando alunos...</option></select></label><button class="primary-button" type="submit">Vincular conta</button><p class="publish-status" data-student-link-status></p></form><div class="restriction-list" data-student-link-list><div class="project-empty">Nenhum vínculo cadastrado.</div></div>';
           anchor.after(panel);
         }
         function ensureStudentLinkSearch() {
           const panel = adminView?.querySelector('#studentAccountLinkPanel');
           const select = panel?.querySelector('[data-student-account-student]');
           const label = select?.closest('label');
           if (!panel || !select || !label || panel.querySelector('[data-student-name-search]')) return;
           const searchLabel = document.createElement('label');
           searchLabel.innerHTML = '<span>Buscar aluno pelo nome</span><div class="search-control"><span aria-hidden="true">⌕</span><input type="search" data-student-name-search list="studentLinkNameOptions" placeholder="Digite o nome do aluno" autocomplete="off"></div><datalist id="studentLinkNameOptions" data-student-name-options></datalist>';
           label.before(searchLabel);
         }
         function syncStudentLinkSearch() {
           const panel = adminView?.querySelector('#studentAccountLinkPanel');
           const input = panel?.querySelector('[data-student-name-search]');
           const select = panel?.querySelector('[data-student-account-student]');
           if (!panel || !input || !select) return;
           const query = normalizePersonName(input.value || '');
           const exact = studentLinkState.students.find(student => normalizePersonName(student.official_name) === query);
           const matches = query ? studentLinkState.students.filter(student => normalizePersonName(student.official_name).includes(query)) : [];
           if (exact) select.value = exact.id;
           else if (matches.length === 1) select.value = matches[0].id;
           else if (input.value.trim()) select.value = '';
           select.querySelectorAll('option').forEach(option => {
             if (!option.value) return;
             const student = studentLinkState.students.find(item => item.id === option.value);
             option.hidden = Boolean(query && student && !normalizePersonName(student.official_name).includes(query));
           });
          }
          const studentLinkState = { profiles:[], students:[], links:[], loaded:false, loading:false };
        function renderStudentLinkControls() {
          const panel = adminView?.querySelector('#studentAccountLinkPanel');
          if (!panel) return;
          const profileSelect = panel.querySelector('[data-student-account]');
           const studentSelect = panel.querySelector('[data-student-account-student]');
           const list = panel.querySelector('[data-student-link-list]');
           profileSelect.innerHTML = studentLinkState.profiles.length ? `<option value="">Selecione a conta Google</option>${studentLinkState.profiles.map(profile => `<option value="${profile.id}">${escapeHtml(profile.full_name || 'Estudante')} · ${escapeHtml(profile.email || '')}</option>`).join('')}` : '<option value="">Nenhuma conta com perfil estudante</option>';
           studentSelect.innerHTML = studentLinkState.students.length ? `<option value="">Selecione o aluno</option>${studentLinkState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)} · ${escapeHtml(badgeClassLabel(student))}</option>`).join('')}` : '<option value="">Lista indisponível</option>';
           const nameOptions = panel.querySelector('[data-student-name-options]');
           if (nameOptions) nameOptions.innerHTML = studentLinkState.students.map(student => `<option value="${escapeHtml(student.official_name)}"></option>`).join('');
           list.innerHTML = studentLinkState.links.length ? studentLinkState.links.map(link => { const profile = Array.isArray(link.profiles) ? link.profiles[0] : link.profiles; const student = Array.isArray(link.students) ? link.students[0] : link.students; return `<article class="restriction-item"><strong>${escapeHtml(student?.official_name || 'Aluno')}</strong><p>${escapeHtml(profile?.full_name || profile?.email || 'Conta estudante')}</p><small>${escapeHtml(profile?.email || '')} · ${escapeHtml(badgeClassLabel(student || {}))}</small><button class="text-button" type="button" data-remove-student-link="${link.profile_id}|${link.student_id}">Desvincular conta</button></article>`; }).join('') : '<div class="project-empty">Nenhum vínculo cadastrado.</div>';
           syncStudentLinkSearch();
        }
        async function loadStudentLinks(force = false) {
          if (!adminView || !supabaseClient || !currentUser || currentProfile?.role !== 'developer' || (!force && (studentLinkState.loaded || studentLinkState.loading))) { renderStudentLinkControls(); return; }
          studentLinkState.loading = true;
          const [{ data:profiles, error:profilesError }, { data:students, error:studentsError }, { data:links, error:linksError }] = await Promise.all([
            supabaseClient.from('profiles').select('id,full_name,email').eq('role','student').order('full_name'),
            supabaseClient.from('students').select('id,official_name,class_id,classes(year,class_code)').eq('active',true).order('official_name'),
            supabaseClient.from('guardian_students').select('profile_id,student_id,profiles(full_name,email),students(official_name,classes(year,class_code))').order('student_id')
          ]);
          studentLinkState.loading = false;
          studentLinkState.loaded = true;
          studentLinkState.profiles = profilesError ? [] : profiles || [];
          studentLinkState.students = studentsError ? [] : students || [];
          studentLinkState.links = linksError ? [] : links || [];
          renderStudentLinkControls();
        }
        async function createStudentLink(event) {
          event.preventDefault();
           const form = event.currentTarget;
           const status = form.querySelector('[data-student-link-status]');
           const profileId = form.querySelector('[data-student-account]').value;
           const typedName = form.querySelector('[data-student-name-search]')?.value || '';
           const typedStudent = studentLinkState.students.find(student => normalizePersonName(student.official_name) === normalizePersonName(typedName));
           const studentId = form.querySelector('[data-student-account-student]').value || typedStudent?.id;
          if (!profileId || !studentId || !supabaseClient || currentProfile?.role !== 'developer') { status.textContent = 'Selecione a conta e o aluno.'; return; }
          status.textContent = 'Salvando vínculo...';
          const { error } = await supabaseClient.from('guardian_students').insert({ profile_id:profileId, student_id:studentId, relationship:'aluno' });
          if (error) { status.textContent = error.code === '23505' ? 'Essa conta já está vinculada a este aluno.' : 'Não foi possível salvar o vínculo.'; return; }
          form.reset();
          status.textContent = 'Conta vinculada. O aluno já pode acessar e gerar o próprio crachá.';
          studentLinkState.loaded = false;
          await loadStudentLinks(true);
        }
        async function removeStudentLink(value) {
          const [profileId, studentId] = String(value || '').split('|');
          if (!profileId || !studentId || !supabaseClient || currentProfile?.role !== 'developer') return;
          const { error } = await supabaseClient.from('guardian_students').delete().eq('profile_id',profileId).eq('student_id',studentId);
          if (!error) { studentLinkState.loaded = false; await loadStudentLinks(true); }
        }
         function setupStudentLinks() {
           ensureStudentLinkView();
           ensureStudentLinkSearch();
           const form = adminView?.querySelector('[data-student-link-form]');
           if (!form) return;
           if (!form.dataset.ready) { form.dataset.ready = 'true'; form.addEventListener('submit', createStudentLink); }
           const search = adminView.querySelector('[data-student-name-search]');
           const studentSelect = adminView.querySelector('[data-student-account-student]');
           if (search && !search.dataset.ready) { search.dataset.ready = 'true'; search.addEventListener('input', syncStudentLinkSearch); }
           if (studentSelect && !studentSelect.dataset.searchReady) { studentSelect.dataset.searchReady = 'true'; studentSelect.addEventListener('change', () => { const student = studentLinkState.students.find(item => item.id === studentSelect.value); if (search) search.value = student?.official_name || ''; syncStudentLinkSearch(); }); }
          if (!document.body.dataset.studentLinkActions) {
            document.body.dataset.studentLinkActions = 'true';
            document.addEventListener('click', event => { const button = event.target.closest('[data-remove-student-link]'); if (button) removeStudentLink(button.dataset.removeStudentLink); });
          }
          loadStudentLinks();
        }
        async function submitRouteIncident(event) {
         event.preventDefault();
         const status = document.getElementById('routeIncidentStatus');
         const match = renderMonitorStudentMatch();
         const type = document.getElementById('routeIncidentType').value;
         const description = document.getElementById('routeIncidentDescription').value.trim();
         if (!match) { status.textContent = 'Selecione um aluno da lista para preencher a turma.'; return; }
         if (!description) { status.textContent = 'Descreva o que aconteceu durante o percurso.'; return; }
         status.textContent = 'Registrando e avisando o responsável...';
         const payload = { student_id:match.student.id, class_id:match.classData.id, monitor_id:currentUser.id, incident_type:type, description, occurred_at:new Date().toISOString() };
         const { data:incident, error:incidentError } = await supabaseClient.from('route_incidents').insert(payload).select('id,created_at').single();
         if (incidentError) { status.textContent = 'Não foi possível registrar. Confira se a estrutura do monitor foi aplicada no banco.'; return; }
         const { data:guardians, error:guardiansError } = await supabaseClient.from('guardian_students').select('profile_id').eq('student_id',match.student.id);
         let notified = 0;
         if (!guardiansError && guardians?.length) {
           const body = `Alerta durante o percurso do ônibus.\nAluno: ${match.student.official_name}\nTurma: ${match.classData.year}º ano ${match.classData.class_code}\nTipo: ${type}\n\n${description}`;
           const { data:messages, error:messagesError } = await supabaseClient.from('student_messages').insert(guardians.map(item => ({ student_id:match.student.id, sender_id:currentUser.id, recipient_id:item.profile_id, category:'general', body }))).select('id');
           if (!messagesError) notified = messages?.length || guardians.length;
         }
         await supabaseClient.from('route_incidents').update({ notification_status:notified ? 'sent' : 'pending_guardian', notified_at:notified ? new Date().toISOString() : null }).eq('id',incident.id);
         monitorState.records.unshift({ student:match.student.official_name, classLabel:`${match.classData.year}º ano ${match.classData.class_code}`, description, createdAt:incident.created_at || new Date().toISOString() });
         renderMonitorHistory();
         event.currentTarget.reset();
         renderMonitorStudentMatch();
         status.textContent = notified ? 'Registro salvo. O responsável recebeu a notificação.' : 'Registro salvo. Ainda não há responsável vinculado a este aluno.';
       }
        async function setupRouteNotifications() {
         const panel = document.getElementById('routeNotificationPanel');
         const list = document.getElementById('routeNotificationList');
         if (!panel || !list || !supabaseClient || !currentUser || !['parent','developer'].includes(currentProfile?.role)) return;
         const { data:messages, error } = await supabaseClient.from('student_messages').select('body,created_at').eq('recipient_id',currentUser.id).eq('category','general').ilike('body','Alerta durante o percurso do ônibus.%').order('created_at',{ascending:false}).limit(5);
         if (error || !messages?.length) { panel.classList.add('hidden'); return; }
         panel.classList.remove('hidden');
          list.innerHTML = messages.map(message => `<div class="route-notification"><strong>Monitor escolar · ${new Date(message.created_at).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.','')}</strong><span>${escapeHtml(message.body).replaceAll('\n','<br>')}</span></div>`).join('');
        }
         const badgeState = { students:[], badges:[], loaded:false, loading:false };
         const studentPhotoUrlCache = new Map();
         const studentPhotoDataCache = new Map();
         function studentPhotoPath(student) { return student?.student_profile?.photo_path || student?.profile?.photo_path || student?.photo_path || ''; }
         async function loadStudentProfiles(studentIds = []) {
           const ids = [...new Set((studentIds || []).filter(Boolean))];
           if (!supabaseClient || !ids.length) return [];
           const batches = [];
           for (let index = 0; index < ids.length; index += 80) batches.push(ids.slice(index,index + 80));
           const results = await Promise.all(batches.map(async batch => {
             let result = await supabaseClient.from('student_school_profiles').select('student_id,birth_date,photo_path,address_line,guardian_name,guardian_phone,emergency_contact,inclusion_needs,inclusion_plan,inclusion_observations,updated_at').in('student_id',batch).order('updated_at',{ascending:false});
             if (result.error) result = await supabaseClient.from('student_school_profiles').select('student_id,birth_date,photo_path,address_line,guardian_name,guardian_phone,emergency_contact,inclusion_needs,inclusion_plan,inclusion_observations').in('student_id',batch);
             return result.error ? [] : result.data || [];
           }));
           return results.flat();
         }
         async function loadStudentProfile(studentId) {
           const profiles = await loadStudentProfiles(studentId ? [studentId] : []);
           return profiles[0] || null;
         }
         async function getStudentPhotoUrl(path) {
           if (!path || !supabaseClient) return null;
           if (studentPhotoUrlCache.has(path)) return studentPhotoUrlCache.get(path);
           const pending = supabaseClient.storage.from('student-photos').createSignedUrl(path, 600).then(({ data, error }) => error || !data?.signedUrl ? null : data.signedUrl).catch(() => null);
           studentPhotoUrlCache.set(path, pending);
           return pending;
         }
          async function normalizeStudentPhoto(blob) {
            try {
              let source;
              if (window.createImageBitmap) {
                try { source = await createImageBitmap(blob, { imageOrientation:'from-image' }); } catch {}
              }
              if (!source) {
                source = await new Promise((resolve, reject) => { const image = new Image(); image.onload = () => resolve(image); image.onerror = reject; image.src = URL.createObjectURL(blob); });
              }
              const width = source.width || source.naturalWidth;
              const height = source.height || source.naturalHeight;
              if (!width || !height) return null;
              const scale = Math.min(1, 1400 / width, 1400 / height);
              const canvas = document.createElement('canvas');
              canvas.width = Math.max(1, Math.round(width * scale));
              canvas.height = Math.max(1, Math.round(height * scale));
              canvas.getContext('2d').drawImage(source, 0, 0, canvas.width, canvas.height);
              source.close?.();
              return canvas.toDataURL('image/jpeg', .9);
            } catch { return null; }
          }
          async function getStudentPhotoDataUrl(path) {
            if (!path) return null;
            if (studentPhotoDataCache.has(path)) return studentPhotoDataCache.get(path);
            const pending = getStudentPhotoUrl(path).then(async url => {
              if (!url) return null;
              try {
                const response = await fetch(url);
                if (!response.ok) return null;
                const blob = await response.blob();
                return await normalizeStudentPhoto(blob);
              } catch { return null; }
            });
           studentPhotoDataCache.set(path, pending);
           return pending;
         }
         function mergeStudentProfiles(students, profiles) {
           const byStudent = new Map();
           (profiles || []).forEach(profile => { if (!byStudent.has(profile.student_id)) byStudent.set(profile.student_id, profile); });
           return (students || []).map(student => ({ ...student, student_profile:byStudent.get(student.id) || null }));
         }
         function ensureBadgeViews() {
           if (parentView && !parentView.querySelector('[data-badge-panel]')) parentView.insertAdjacentHTML('beforeend', badgeMarkup);
            if (studentView?.querySelector('.welcome') && !studentView.querySelector('[data-badge-panel]')) studentView.insertAdjacentHTML('beforeend', badgeMarkup);
           if (teacherView?.innerHTML && !teacherView.querySelector('[data-staff-badge-panel]')) teacherView.insertAdjacentHTML('beforeend', staffBadgeMarkup + gateCoordinationMarkup);
            if (adminView?.innerHTML && !adminView.querySelector('[data-staff-badge-panel]')) adminView.insertAdjacentHTML('beforeend', staffBadgeMarkup + gateCoordinationMarkup);
            ensureBadgeShareControls();
            ensureBadgePhotoControls();
          }
         function ensureBadgeShareControls() {
           document.querySelectorAll('.student-badge').forEach(card => {
             if (card.querySelector('[data-badge-share]')) return;
             const share = document.createElement('div');
             share.className = 'badge-share';
             share.dataset.badgeShare = 'true';
               share.innerHTML = '<label>WhatsApp do responsável (com DDD)<input type="tel" data-badge-whatsapp inputmode="tel" placeholder="(82) 99999-9999" autocomplete="tel"></label><button type="button" data-send-badge-whatsapp>Baixar QR e abrir WhatsApp</button><small>A imagem do QR será baixada e a conversa será aberta para você anexar o PNG.</small>';
              card.appendChild(share);
            });
          }
          function ensureBadgePhotoControls() {
            document.querySelectorAll('.student-badge').forEach(card => {
              if (card.querySelector('[data-badge-photo]')) return;
              const photo = document.createElement('div');
              photo.className = 'student-badge-photo';
              photo.dataset.badgePhoto = 'true';
              photo.textContent = 'Foto não cadastrada';
              const copy = card.querySelector('.student-badge-copy');
              if (copy) { const identity = document.createElement('div'); identity.className = 'student-badge-identity'; identity.append(photo, copy); card.insertBefore(identity, card.firstChild); }
              else card.insertBefore(photo, card.firstChild);
            });
          }
         function badgeClassLabel(student) {
           const classData = Array.isArray(student?.classes) ? student.classes[0] : student?.classes;
           if (!classData && student?.classLabel) return String(student.classLabel);
           const year = classData?.year ?? student?.year ?? student?.class_year;
           const code = classData?.class_code ?? student?.class_code;
           return year != null && code ? `${year}º ano ${code}` : 'Turma não informada';
         }
        function badgeForStudent(studentId) { return badgeState.badges.find(item => item.student_id === studentId && item.active !== false); }
         function paintBadgeQr(host, token) {
           host.innerHTML = '';
           if (!window.QRCode) {
             host.textContent = 'Carregando QR...';
             loadExternalScript('https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js','QRCode').then(() => paintBadgeQr(host, token)).catch(() => { host.textContent = 'QR indisponível'; });
             return;
           }
          if (typeof window.QRCode.toCanvas === 'function') {
            window.QRCode.toCanvas(token, { width:140, margin:1, errorCorrectionLevel:'M' }, (error, canvas) => {
              if (error) { host.textContent = 'Não foi possível gerar o QR.'; return; }
              host.appendChild(canvas);
            });
            return;
          }
          new window.QRCode(host, { text:token, width:140, height:140, correctLevel:window.QRCode.CorrectLevel?.M || 0 });
        }
         async function renderBadgePhoto(card, student) {
           const host = card?.querySelector('[data-badge-photo]');
           let path = studentPhotoPath(student);
           if (!path && student?.id) { student.student_profile = await loadStudentProfile(student.id); path = studentPhotoPath(student); }
           card.dataset.badgePhotoPath = path;
           if (!host) return;
            const url = await getStudentPhotoDataUrl(path);
            if (!url) { host.textContent = 'Foto não cadastrada'; return; }
            host.innerHTML = `<img src="${escapeHtml(url)}" alt="Foto de ${escapeHtml(student.official_name || 'aluno')}">`;
         }
         function renderBadgeCard(card, nameSelector, classSelector, qrSelector, student, badge) {
           if (!card || !student || !badge) return;
           ensureBadgePhotoControls();
           card.classList.remove('hidden');
          card.querySelector(nameSelector).textContent = student.official_name;
          card.querySelector(classSelector).textContent = badgeClassLabel(student);
          card.dataset.badgeToken = badge.badge_token;
          card.dataset.badgeName = student.official_name;
           card.dataset.badgeClass = badgeClassLabel(student);
           paintBadgeQr(card.querySelector(qrSelector), badge.badge_token);
           renderBadgePhoto(card, student);
         }
         function renderStaffBadgeOptions(panel) {
           const select = panel?.querySelector('[data-staff-badge-select]');
           const classFilter = panel?.querySelector('[data-staff-badge-class-filter]');
           const search = normalizePersonName(panel?.querySelector('[data-staff-badge-search]')?.value || '');
           if (!select) return;
           if (classFilter && classFilter.options.length === 1) {
             [...new Set(badgeState.students.map(badgeClassLabel))].sort((a,b) => a.localeCompare(b,'pt-BR')).forEach(label => classFilter.insertAdjacentHTML('beforeend', `<option value="${escapeHtml(label)}">${escapeHtml(label)}</option>`));
           }
           const classValue = classFilter?.value || 'all';
           const items = badgeState.students.filter(student => (!search || normalizePersonName(student.official_name).includes(search)) && (classValue === 'all' || badgeClassLabel(student) === classValue));
           const selected = select.value;
           select.innerHTML = items.length ? `<option value="">Selecione um aluno</option>${items.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)} · ${escapeHtml(badgeClassLabel(student))}</option>`).join('')}` : '<option value="">Nenhum aluno encontrado</option>';
           if (items.some(student => student.id === selected)) select.value = selected;
         }
         function renderBadgeControls() {
          document.querySelectorAll('[data-badge-panel]').forEach(panel => {
            const select = panel.querySelector('[data-badge-student-select]');
            if (!select) return;
            select.innerHTML = badgeState.students.length ? badgeState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)} · ${escapeHtml(badgeClassLabel(student))}</option>`).join('') : '<option value="">Nenhum aluno vinculado</option>';
            panel.querySelector('[data-badge-status]').textContent = badgeState.students.length ? '' : 'A escola ainda não vinculou um aluno a esta conta.';
          });
          document.querySelectorAll('[data-staff-badge-panel]').forEach(panel => {
            const select = panel.querySelector('[data-staff-badge-select]');
            if (!select) return;
             renderStaffBadgeOptions(panel);
          });
        }
        async function loadBadgeData(force = false) {
          if (!supabaseClient || !currentUser || (!force && (badgeState.loaded || badgeState.loading))) { renderBadgeControls(); return; }
          const staff = ['pedagogical','developer'].includes(currentProfile?.role);
          if (!staff && !['parent','student'].includes(currentProfile?.role)) return;
          badgeState.loading = true;
          let studentIds = null;
          if (!staff) {
            const { data:links } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id',currentUser.id);
            studentIds = (links || []).map(item => item.student_id);
          }
          const studentsQuery = supabaseClient.from('students').select('id,official_name,class_id,classes(year,class_code)').eq('active',true).order('official_name');
          if (studentIds) studentsQuery.in('id', studentIds.length ? studentIds : ['00000000-0000-0000-0000-000000000000']);
           const [{ data:students, error:studentsError }, { data:badges, error:badgesError }] = await Promise.all([
             studentsQuery,
             staff ? supabaseClient.from('gate_badges').select('student_id,badge_token,active') : supabaseClient.from('gate_badges').select('student_id,badge_token,active').in('student_id', studentIds?.length ? studentIds : ['00000000-0000-0000-0000-000000000000'])
           ]);
           const profiles = await loadStudentProfiles((students || []).map(student => student.id));
           badgeState.loading = false;
           badgeState.loaded = true;
           badgeState.students = studentsError ? [] : mergeStudentProfiles(students, profiles);
          badgeState.badges = badgesError ? [] : badges || [];
          renderBadgeControls();
        }
        async function ensureStudentBadge(studentId) {
          let badge = badgeForStudent(studentId);
           if (badge || !supabaseClient || !['parent','student','pedagogical','developer'].includes(currentProfile?.role)) return badge;
          const { data, error } = await supabaseClient.from('gate_badges').insert({ student_id:studentId }).select('student_id,badge_token,active').single();
          if (error) return null;
          badge = data;
          badgeState.badges.push(badge);
          return badge;
        }
        async function showParentBadge(event) {
          const panel = event.currentTarget.closest('[data-badge-panel]');
          const student = badgeState.students.find(item => item.id === panel.querySelector('[data-badge-student-select]').value);
          const status = panel.querySelector('[data-badge-status]');
           const badge = student && await ensureStudentBadge(student.id);
          if (!student || !badge) { status.textContent = 'Este aluno ainda não possui crachá emitido.'; return; }
          renderBadgeCard(panel.querySelector('[data-badge-card]'),'[data-badge-name]','[data-badge-class]','[data-badge-qr]',student,badge);
          status.textContent = 'Crachá pronto para apresentação.';
        }
        async function showStaffBadge(event) {
          const panel = event.currentTarget.closest('[data-staff-badge-panel]');
          const student = badgeState.students.find(item => item.id === panel.querySelector('[data-staff-badge-select]').value);
          const status = panel.querySelector('[data-staff-badge-status]');
          if (!student) { status.textContent = 'Selecione um aluno.'; return; }
          status.textContent = 'Gerando QR...';
          const badge = await ensureStudentBadge(student.id);
          if (!badge) { status.textContent = 'Não foi possível emitir o crachá.'; return; }
          renderBadgeCard(panel.querySelector('[data-staff-badge-card]'),'[data-staff-badge-name]','[data-staff-badge-class]','[data-staff-badge-qr]',student,badge);
          status.textContent = 'Crachá gerado. Imprima ou salve como PDF.';
        }
          function saveBlob(blob, filename) {
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            link.remove();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
          }
          async function getPdfConstructor() {
            await loadExternalScript('https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js','jspdf');
            const JsPDF = window.jspdf?.jsPDF;
            if (!JsPDF) throw new Error('A biblioteca de PDF ainda não carregou.');
            return JsPDF;
          }
          function safePdfName(value, fallback = 'aluno') {
            return String(value || fallback).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'').toLowerCase() || fallback;
          }
           let schoolLogoDataUrl = null;
           async function getSchoolLogoDataUrl() {
             if (schoolLogoDataUrl) return schoolLogoDataUrl;
             try {
                  const response = await fetch('bfr-app-logo.webp');
               if (!response.ok) return null;
               const blob = await response.blob();
               schoolLogoDataUrl = await new Promise(resolve => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = () => resolve(null); reader.readAsDataURL(blob); });
               return schoolLogoDataUrl;
             } catch { return null; }
           }
           async function badgePdfBlob(card) {
             const canvas = card?.querySelector('canvas');
             if (!canvas) throw new Error('Gere o QR do crachá antes de baixar o PDF.');
             const JsPDF = await getPdfConstructor();
             const doc = new JsPDF({ unit:'mm', format:[105,148] });
             const name = card.dataset.badgeName || 'Aluno';
             const classLabel = card.dataset.badgeClass || 'Turma não informada';
             const logo = await getSchoolLogoDataUrl();
              doc.setFillColor(16,41,95);
              doc.rect(0,0,105,148,'F');
              doc.setTextColor(255,255,255);
              doc.setFont('helvetica','bold');
              doc.setFontSize(12);
              doc.text('BFR CONECTA',52.5,14,{align:'center'});
              doc.setFillColor(255,255,255);
              doc.roundedRect(8,20,89,118,5,5,'F');
              if (logo) doc.addImage(logo,'JPEG',42.5,23,20,20);
               const photo = await getStudentPhotoDataUrl(card.dataset.badgePhotoPath || '');
               if (photo) {
                 const properties = doc.getImageProperties(photo);
                 const scale = Math.min(54 / properties.width, 38 / properties.height);
                 const photoWidth = properties.width * scale;
                 const photoHeight = properties.height * scale;
                 doc.addImage(photo, 'JPEG', 52.5 - photoWidth / 2, 46 + (38 - photoHeight) / 2, photoWidth, photoHeight);
               }
               doc.setTextColor(23,33,31);
               doc.setFont('helvetica','bold');
               doc.setFontSize(10);
               const nameLines = doc.splitTextToSize(name,78);
               const nameY = 90;
               doc.text(nameLines,52.5,nameY,{align:'center'});
               doc.setTextColor(22,86,167);
               doc.setFontSize(9);
               const classY = nameY + (nameLines.length * 4.2) + 2.5;
               doc.text(classLabel,52.5,classY,{align:'center'});
               const qrSize = 26;
               const qrY = classY + 5;
               doc.addImage(canvas.toDataURL('image/png'),'PNG',52.5 - qrSize / 2,qrY,qrSize,qrSize);
               doc.setTextColor(115,129,126);
               doc.setFont('helvetica','normal');
               doc.setFontSize(7.5);
               doc.text('Apresente este QR na portaria',52.5,136,{align:'center'});
              doc.setTextColor(255,255,255);
              doc.setFontSize(7);
              doc.text('Crachá escolar · Entrada segura',52.5,145,{align:'center'});
             return doc.output('blob');
           }
           async function downloadBadgePdf(card) {
             const name = card?.dataset.badgeName || 'aluno';
             const filename = `cracha-bfr-${safePdfName(name)}.pdf`;
             const blob = await badgePdfBlob(card);
             saveBlob(blob,filename);
             return { blob, filename };
           }
          function badgeQrBlob(card) {
            const canvas = card?.querySelector('canvas');
            if (!canvas) throw new Error('Gere o QR do crachá antes de baixar a imagem.');
            const dataUrl = canvas.toDataURL('image/png');
            const [metadata, encoded] = dataUrl.split(',');
            const binary = atob(encoded);
            const bytes = Uint8Array.from(binary,character => character.charCodeAt(0));
            return new Blob([bytes],{type:metadata.match(/data:([^;]+)/)?.[1] || 'image/png'});
          }
          async function downloadBadgeQr(card) {
            const name = card?.dataset.badgeName || 'aluno';
            const filename = `qr-bfr-${safePdfName(name)}.png`;
            const blob = await badgeQrBlob(card);
            saveBlob(blob,filename);
            return { blob, filename };
          }
          async function printBadge(card) {
            const status = card.closest('.badge-panel')?.querySelector('.publish-status');
            try {
              await downloadBadgePdf(card);
              if (status) status.textContent = 'PDF do crachá baixado com o QR Code.';
            } catch (error) {
              if (status) status.textContent = error.message || 'Não foi possível gerar o PDF do crachá.';
            }
          }
          async function sendBadgeWhatsApp(button) {
            const card = button.closest('.student-badge');
            const input = card?.querySelector('[data-badge-whatsapp]');
            const status = card?.closest('.badge-panel')?.querySelector('.publish-status');
           const typed = String(input?.value || '').replace(/\D/g,'');
            const phone = typed.length === 10 || typed.length === 11 ? `55${typed}` : typed;
            if (![12,13].includes(phone.length)) { if (status) status.textContent = 'Digite um número de WhatsApp válido com DDD.'; input?.focus(); return; }
            const name = card?.dataset.badgeName || 'aluno';
            const classLabel = card?.dataset.badgeClass || 'turma não informada';
            const originalLabel = button.textContent;
            button.disabled = true;
             button.textContent = 'Preparando imagem...';
            try {
              await downloadBadgeQr(card);
              const message = `Olá! O QR Code do crachá escolar de ${name} (${classLabel}) foi baixado como imagem PNG. Anexe a imagem nesta conversa.`;
              const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
              const popup = window.open(url, '_blank', 'noopener,noreferrer');
              if (!popup) window.location.href = url;
              if (status) status.textContent = 'Imagem do QR baixada. Anexe o PNG na conversa do WhatsApp que foi aberta.';
            } catch (error) {
              if (status) status.textContent = error.message || 'Não foi possível gerar o PDF do crachá.';
            } finally {
              button.disabled = false;
              button.textContent = originalLabel;
            }
          }
         function setupBadgeViews() {
            ensureBadgeViews();
            ensureBadgeRevokeControls();
            document.querySelectorAll('[data-staff-badge-panel]').forEach(panel => {
              if (panel.dataset.badgeFilterReady) return;
              panel.dataset.badgeFilterReady = 'true';
              panel.querySelector('[data-staff-badge-search]')?.addEventListener('input', () => renderStaffBadgeOptions(panel));
              panel.querySelector('[data-staff-badge-class-filter]')?.addEventListener('change', () => renderStaffBadgeOptions(panel));
            });
            if (!document.body.dataset.badgeActions) {
            document.body.dataset.badgeActions = 'true';
            document.addEventListener('click', event => {
              if (event.target.closest('[data-show-badge]')) showParentBadge({ currentTarget:event.target.closest('[data-show-badge]') });
                if (event.target.closest('[data-staff-generate-badge]')) showStaffBadge({ currentTarget:event.target.closest('[data-staff-generate-badge]') });
                const revokeButton = event.target.closest('[data-revoke-badge]');
                if (revokeButton) revokeStudentBadge(revokeButton);
               const printButton = event.target.closest('[data-print-badge]');
               if (printButton) printBadge(printButton.closest('.student-badge'));
               const whatsAppButton = event.target.closest('[data-send-badge-whatsapp]');
               if (whatsAppButton) sendBadgeWhatsApp(whatsAppButton);
             });
          }
           loadBadgeData();
         }
         const secretaryState = { students:[], requests:[], documents:[], messages:[], events:[], profiles:[], selectedRequestId:null, step:1, familyLoaded:false, staffLoaded:false, loading:false };
         const secretaryStatusLabels = { received:'Recebida', reviewing:'Em análise', waiting_information:'Aguardando informação', preparing:'Documento em preparação', ready:'Pronta para baixar', closed:'Concluída', cancelled:'Cancelada' };
         const secretaryStatusRank = { received:1, reviewing:2, waiting_information:2, preparing:3, ready:4, closed:5, cancelled:5 };
         function secretaryStatusLabel(status) { return secretaryStatusLabels[status] || 'Em atendimento'; }
         function secretaryStatusClass(status) { return status === 'ready' || status === 'closed' ? 'is-ready' : status === 'waiting_information' ? 'is-warning' : status === 'cancelled' ? 'is-danger' : ''; }
         function secretaryDate(value, withTime = false) { if (!value) return '—'; return new Date(value).toLocaleDateString('pt-BR', withTime ? { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' } : { day:'2-digit', month:'short', year:'numeric' }).replace('.', ''); }
         function secretaryStudentName(request) { const student = Array.isArray(request?.students) ? request.students[0] : request?.students; return student?.official_name || secretaryState.students.find(item => item.id === request?.student_id)?.official_name || 'Aluno não informado'; }
         function secretaryProtocol(request) { return request?.protocol || `BFR-${String(request?.id || '').slice(0,8).toUpperCase()}`; }
         function secretaryDeadline(request) { return request?.deadline_at ? secretaryDate(request.deadline_at) : 'até 5 dias úteis'; }
         function secretaryTimelineMarkup(request) {
           const events = secretaryState.events.filter(item => item.request_id === request.id).sort((a,b) => new Date(a.created_at) - new Date(b.created_at));
           const fallback = [{ status:'received', note:'Solicitação recebida pela secretaria.', created_at:request.created_at }];
           const items = events.length ? events : fallback;
           return items.map((item,index) => `<div class="secretary-timeline-item ${index < items.length - 1 ? 'is-done' : 'is-current'}"><span class="secretary-timeline-dot"></span><div><strong>${escapeHtml(secretaryStatusLabel(item.status))}</strong><small>${secretaryDate(item.created_at,true)}${item.note ? ` · ${escapeHtml(item.note)}` : ''}</small></div></div>`).join('');
         }
         function secretaryRequestCard(request, staff = false) {
           const statusClass = secretaryStatusClass(request.status);
           const action = request.status === 'waiting_information' ? '<span class="secretary-request-meta" style="color:#9b6d13">Ação necessária do responsável</span>' : '';
           return `<article class="secretary-request-card" data-secretary-request-id="${request.id}"><div class="secretary-request-top"><div><strong>${escapeHtml(request.request_type || 'Solicitação')}</strong><div class="secretary-request-meta"><span>${escapeHtml(secretaryProtocol(request))}</span><span>${secretaryDate(request.created_at)}</span></div></div><span class="secretary-status ${statusClass}">${escapeHtml(secretaryStatusLabel(request.status))}</span></div><p>${escapeHtml(request.description || request.details || 'Solicitação enviada pelo responsável.')}</p><div class="secretary-request-meta"><span>Aluno: ${escapeHtml(secretaryStudentName(request))}</span><span>Prazo: ${escapeHtml(secretaryDeadline(request))}</span></div>${action}${staff ? '<button class="text-button" type="button" data-secretary-select-request style="margin-top:10px;padding-left:0">Abrir protocolo →</button>' : `<div class="secretary-timeline">${secretaryTimelineMarkup(request)}</div>`}</article>`;
         }
         function renderSecretaryFamily() {
           if (!secretaryView) return;
           const list = secretaryView.querySelector('[data-secretary-request-list]');
           if (list) list.innerHTML = secretaryState.requests.length ? secretaryState.requests.map(request => secretaryRequestCard(request)).join('') : '<div class="project-empty">Nenhuma solicitação enviada. Comece por um documento ou serviço.</div>';
           const docs = secretaryView.querySelector('[data-secretary-document-list]');
           if (docs) docs.innerHTML = secretaryState.documents.length ? secretaryState.documents.map(item => `<article class="secretary-document-card"><strong>📄 ${escapeHtml(item.title)}</strong><span>${escapeHtml(item.category || 'Documento escolar')} · ${secretaryDate(item.created_at)}</span><button class="text-button" type="button" data-secretary-document-path="${escapeHtml(item.storage_path)}">Abrir documento →</button></article>`).join('') : '<div class="project-empty">Nenhum documento disponível ainda.</div>';
           const messages = secretaryView.querySelector('[data-secretary-message-list]');
           if (messages) messages.innerHTML = secretaryState.messages.length ? secretaryState.messages.slice(0,8).map(item => `<article class="growth-item"><div class="growth-item-top"><strong>${item.sender_id === currentUser?.id ? 'Você' : 'Secretaria'}</strong><small>${secretaryDate(item.created_at,true)}</small></div><p>${escapeHtml(item.body)}</p></article>`).join('') : '<div class="project-empty">Nenhuma conversa iniciada.</div>';
           const open = secretaryState.requests.filter(item => !['closed','cancelled'].includes(item.status)).length;
           const ready = secretaryState.documents.length;
           const action = secretaryState.requests.filter(item => item.status === 'waiting_information').length;
           secretaryView.querySelector('#secretaryOpenCount')?.replaceChildren(document.createTextNode(String(open)));
           secretaryView.querySelector('#secretaryReadyCount')?.replaceChildren(document.createTextNode(String(ready)));
           secretaryView.querySelector('#secretaryActionCount')?.replaceChildren(document.createTextNode(String(action)));
           const select = secretaryView.querySelector('[data-secretary-student]');
           if (select) select.innerHTML = secretaryState.students.length ? `<option value="">Selecione o aluno</option>${secretaryState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)} · ${escapeHtml(badgeClassLabel(student))}</option>`).join('')}` : '<option value="">Nenhum aluno vinculado</option>';
         }
         async function loadSecretaryStudents() {
           if (!supabaseClient || !currentUser) return;
           const { data:links, error:linksError } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id', currentUser.id);
           if (linksError) return;
           const ids = (links || []).map(item => item.student_id).filter(Boolean);
           if (!ids.length) { secretaryState.students = []; return; }
           const { data, error } = await supabaseClient.from('students').select('id,official_name,class_id,classes(year,class_code)').in('id', ids).eq('active',true).order('official_name');
           secretaryState.students = error ? [] : data || [];
         }
         async function loadSecretaryFamily() {
           if (!supabaseClient || !currentUser || secretaryState.loading) return;
           secretaryState.loading = true;
           try {
             await loadSecretaryStudents();
             let requestResult = await supabaseClient.from('secretary_requests').select('id,protocol,requester_id,student_id,request_type,description,purpose,details,receiving_method,status,deadline_at,admin_note,created_at,updated_at,students(official_name,classes(year,class_code))').eq('requester_id',currentUser.id).order('created_at',{ascending:false});
             if (requestResult.error) requestResult = await supabaseClient.from('secretary_requests').select('id,requester_id,student_id,request_type,description,status,admin_note,created_at,updated_at,students(official_name,classes(year,class_code))').eq('requester_id',currentUser.id).order('created_at',{ascending:false});
             secretaryState.requests = requestResult.error ? [] : requestResult.data || [];
             const ids = secretaryState.requests.map(item => item.id);
             const eventsResult = ids.length ? await supabaseClient.from('secretary_request_events').select('id,request_id,status,note,created_at').in('request_id',ids).order('created_at') : { data:[], error:null };
             secretaryState.events = eventsResult.error ? [] : eventsResult.data || [];
              const documentScope = query => ids.length ? query.or(`recipient_id.eq.${currentUser.id},request_id.in.(${ids.join(',')})`) : query.eq('recipient_id',currentUser.id);
              let documentResult = documentScope(supabaseClient.from('school_documents').select('id,title,category,description,storage_path,student_id,request_id,recipient_id,published,created_at').order('created_at',{ascending:false}));
              if (documentResult.error) documentResult = documentScope(supabaseClient.from('school_documents').select('id,title,category,description,storage_path,created_at').order('created_at',{ascending:false}));
             secretaryState.documents = documentResult.error ? [] : documentResult.data || [];
             const messagesResult = ids.length ? await supabaseClient.from('secretary_request_messages').select('id,request_id,sender_id,recipient_id,body,created_at,read_at').or(`sender_id.eq.${currentUser.id},recipient_id.eq.${currentUser.id}`).order('created_at',{ascending:false}).limit(40) : { data:[], error:null };
             secretaryState.messages = messagesResult.error ? [] : messagesResult.data || [];
             secretaryState.familyLoaded = true;
             renderSecretaryFamily();
           } finally { secretaryState.loading = false; }
         }
          function updateSecretaryWizard() {
            const form = secretaryView?.querySelector('#secretaryRequestForm');
            if (!form) return;
            form.querySelectorAll('[data-secretary-step]').forEach(step => step.classList.toggle('active', Number(step.dataset.secretaryStep) === secretaryState.step));
            const setWizardText = (selector, value) => { const element = form.querySelector(selector); if (element) element.textContent = value; };
            setWizardText('[data-secretary-step-label]', secretaryState.step);
            form.querySelector('[data-secretary-prev]')?.classList.toggle('hidden', secretaryState.step === 1);
            form.querySelector('[data-secretary-next]')?.classList.toggle('hidden', secretaryState.step === 5);
            form.querySelector('[data-secretary-submit]')?.classList.toggle('hidden', secretaryState.step !== 5);
            const student = secretaryState.students.find(item => item.id === form.student_id?.value);
            setWizardText('[data-secretary-review-student]', student?.official_name || '—');
            setWizardText('[data-secretary-review-type]', form.request_type?.value || '—');
            setWizardText('[data-secretary-review-purpose]', form.purpose?.value || '—');
            setWizardText('[data-secretary-review-receiving]', form.receiving_method?.selectedOptions?.[0]?.textContent || '—');
            setWizardText('[data-secretary-review-details]', form.details?.value || 'Nenhum detalhe adicional');
          }
         function openSecretaryWizard() { const panel = secretaryView?.querySelector('#secretaryWizardPanel'); const requests = secretaryView?.querySelector('#secretaryRequestsPanel'); if (!panel || !requests) return; panel.classList.remove('hidden'); requests.classList.add('hidden'); secretaryState.step = 1; updateSecretaryWizard(); panel.scrollIntoView({ behavior:'smooth', block:'start' }); }
         function closeSecretaryWizard() { secretaryView?.querySelector('#secretaryWizardPanel')?.classList.add('hidden'); secretaryView?.querySelector('#secretaryRequestsPanel')?.classList.remove('hidden'); }
         async function submitSecretaryRequest(event) {
           event.preventDefault();
           const form = event.currentTarget;
           const status = form.querySelector('[data-secretary-form-status]');
           const data = new FormData(form);
           const studentId = String(data.get('student_id') || '');
           const requestType = String(data.get('request_type') || '');
           const purpose = String(data.get('purpose') || '');
           const details = String(data.get('details') || '').trim();
           if (!studentId || !requestType || !purpose) { status.textContent = 'Complete as etapas anteriores antes de enviar.'; return; }
           status.textContent = 'Enviando para a secretaria...';
           const protocol = `BFR-${new Date().getFullYear()}-${Math.random().toString(36).slice(2,8).toUpperCase()}`;
           const deadline = new Date(Date.now() + 5 * 86400000).toISOString();
           const modernPayload = { protocol, requester_id:currentUser.id, student_id:studentId, request_type:requestType, description:details || `Solicitação de ${requestType}. Finalidade: ${purpose}.`, purpose, details:details || null, receiving_method:data.get('receiving_method'), status:'received', deadline_at:deadline };
           let result = await supabaseClient.from('secretary_requests').insert(modernPayload).select('id,protocol,requester_id,student_id,request_type,description,purpose,details,receiving_method,status,deadline_at,created_at,students(official_name,classes(year,class_code))').single();
           if (result.error) result = await supabaseClient.from('secretary_requests').insert({ requester_id:currentUser.id, student_id:studentId, request_type:requestType, description:modernPayload.description, status:'received' }).select('id,requester_id,student_id,request_type,description,status,created_at,students(official_name,classes(year,class_code))').single();
           if (result.error || !result.data) { status.textContent = 'Não foi possível registrar. Tente novamente.'; return; }
           const request = { ...result.data, protocol:result.data.protocol || protocol, deadline_at:result.data.deadline_at || deadline };
              const eventResult = await supabaseClient.from('secretary_request_events').insert({ request_id:request.id, status:'received', note:'Solicitação recebida pela secretaria.', created_by:currentUser.id });
              const file = data.get('attachment');
              let attachmentMessage = '';
              if (file?.size) {
                const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]+/g,'-').slice(-90) || 'anexo';
                const path = `${currentUser.id}/${request.id}/${crypto.randomUUID()}-${safeName}`;
                const upload = await supabaseClient.storage.from('secretary-attachments').upload(path,file,{contentType:file.type || 'application/octet-stream',upsert:false});
                if (upload.error) attachmentMessage = ' O anexo não foi enviado; a solicitação foi registrada sem ele.';
                else {
                  const attachment = await supabaseClient.from('secretary_request_attachments').insert({ request_id:request.id, uploaded_by:currentUser.id, storage_path:path, file_name:file.name, content_type:file.type || null });
                  if (attachment.error) { await supabaseClient.storage.from('secretary-attachments').remove([path]); attachmentMessage = ' O anexo não foi associado; a solicitação foi registrada sem ele.'; }
                }
              }
            form.reset(); secretaryState.step = 1; closeSecretaryWizard(); status.textContent = `${eventResult.error ? 'Solicitação enviada. O histórico detalhado será atualizado quando a secretaria responder.' : 'Solicitação enviada com sucesso.'}${attachmentMessage}`; secretaryState.familyLoaded = false; await loadSecretaryFamily();
         }
         function setupSecretaryFamily() {
           if (!secretaryView || secretaryView.querySelector('[data-secretary-staff-list]')) return;
           if (!document.body.dataset.secretaryFamilyActions) {
             document.body.dataset.secretaryFamilyActions = 'true';
             document.addEventListener('click', event => {
               if (event.target.closest('[data-secretary-open-wizard]')) openSecretaryWizard();
               if (event.target.closest('[data-secretary-close-wizard]')) closeSecretaryWizard();
               if (event.target.closest('[data-secretary-document-path]')) openGrowthDocument(event.target.closest('[data-secretary-document-path]').dataset.secretaryDocumentPath);
               const option = event.target.closest('[data-secretary-type]');
               if (option) { const form = secretaryView?.querySelector('#secretaryRequestForm'); form.request_type.value = option.dataset.secretaryType; form.querySelectorAll('[data-secretary-type]').forEach(item => item.classList.toggle('is-selected', item === option)); updateSecretaryWizard(); }
               if (event.target.closest('[data-secretary-prev]')) { secretaryState.step = Math.max(1, secretaryState.step - 1); updateSecretaryWizard(); }
               if (event.target.closest('[data-secretary-next]')) { const form = secretaryView?.querySelector('#secretaryRequestForm'); if (secretaryState.step === 1 && !form.student_id.value) { form.querySelector('[data-secretary-form-status]').textContent = 'Selecione o aluno.'; return; } if (secretaryState.step === 2 && !form.request_type.value) { form.querySelector('[data-secretary-form-status]').textContent = 'Escolha um serviço.'; return; } if (secretaryState.step === 3 && !form.purpose.value) { form.querySelector('[data-secretary-form-status]').textContent = 'Informe a finalidade.'; return; } secretaryState.step = Math.min(5, secretaryState.step + 1); updateSecretaryWizard(); }
             });
           }
           const form = secretaryView.querySelector('#secretaryRequestForm');
           if (form && !form.dataset.ready) { form.dataset.ready = 'true'; form.addEventListener('input', updateSecretaryWizard); form.addEventListener('change', updateSecretaryWizard); form.addEventListener('submit', submitSecretaryRequest); }
           const messageForm = secretaryView.querySelector('[data-secretary-message-form]');
           if (messageForm && !messageForm.dataset.ready) { messageForm.dataset.ready = 'true'; messageForm.addEventListener('submit', async event => { event.preventDefault(); const status = messageForm.querySelector('[data-secretary-message-status]'); const body = messageForm.body.value.trim(); if (!body) return; status.textContent = 'Enviando...'; const requestId = secretaryState.requests[0]?.id || null; let result = await supabaseClient.from('secretary_request_messages').insert({ request_id:requestId, sender_id:currentUser.id, recipient_id:null, body }); if (result.error) { const studentId = secretaryState.students[0]?.id; result = studentId ? await supabaseClient.from('student_messages').insert({ student_id:studentId, sender_id:currentUser.id, recipient_id:null, category:'general', body }) : result; } status.textContent = result.error ? 'Não foi possível enviar a mensagem.' : 'Mensagem enviada para a secretaria.'; if (!result.error) { messageForm.reset(); await loadSecretaryFamily(); } }); }
           const profileForm = secretaryView.querySelector('[data-secretary-profile-form]');
           if (profileForm && !profileForm.dataset.ready) { profileForm.dataset.ready = 'true'; profileForm.addEventListener('submit', async event => { event.preventDefault(); const status = profileForm.querySelector('[data-secretary-profile-status]'); const payload = { phone:profileForm.phone.value.trim(), email:profileForm.email.value.trim(), address:profileForm.address.value.trim(), emergency:profileForm.emergency.value.trim() }; status.textContent = 'Enviando para aprovação...'; const result = await supabaseClient.from('secretary_profile_change_requests').insert({ requester_id:currentUser.id, student_id:secretaryState.students[0]?.id || null, requested_changes:payload, status:'pending' }); status.textContent = result.error ? 'Não foi possível registrar a atualização.' : 'Atualização enviada. A secretaria fará a conferência.'; if (!result.error) profileForm.reset(); }); }
           loadSecretaryFamily();
         }
         function renderSecretaryStaffList() {
           const list = secretaryView?.querySelector('[data-secretary-staff-list]');
           if (!list) return;
           const filter = secretaryView.querySelector('[data-secretary-staff-filter]')?.value || 'all';
           const search = String(secretaryView.querySelector('[data-secretary-staff-search]')?.value || '').toLocaleLowerCase('pt-BR');
           const items = secretaryState.requests.filter(item => (filter === 'all' || item.status === filter) && (!search || secretaryProtocol(item).toLocaleLowerCase().includes(search) || secretaryStudentName(item).toLocaleLowerCase().includes(search)));
           list.innerHTML = items.length ? items.map(item => secretaryRequestCard(item,true)).join('') : '<div class="project-empty">Nenhuma solicitação encontrada.</div>';
           secretaryView.querySelectorAll('[data-secretary-staff-count]').forEach(item => { const value = item.dataset.secretaryStaffCount === 'waiting' ? secretaryState.requests.filter(request => request.status === 'waiting_information').length : item.dataset.secretaryStaffCount === 'closed' ? secretaryState.requests.filter(request => ['closed','cancelled'].includes(request.status)).length : secretaryState.requests.filter(request => !['closed','cancelled'].includes(request.status)).length; item.textContent = String(value); });
         }
         function renderSecretaryStaffDetail() {
           const request = secretaryState.requests.find(item => item.id === secretaryState.selectedRequestId);
           const detail = secretaryView?.querySelector('[data-secretary-detail]');
           if (!detail || !request) return;
           detail.querySelector('[data-secretary-detail-title]').textContent = `${request.request_type || 'Solicitação'} · ${secretaryProtocol(request)}`;
           detail.querySelector('[data-secretary-detail-badge]').textContent = secretaryStatusLabel(request.status);
           detail.querySelector('[data-secretary-detail-badge]').className = `secretary-status ${secretaryStatusClass(request.status)}`;
           detail.querySelector('[data-secretary-detail-student]').textContent = secretaryStudentName(request);
           const profile = secretaryState.profiles.find(item => item.id === request.requester_id);
           detail.querySelector('[data-secretary-detail-requester]').textContent = profile?.full_name || profile?.email || 'Responsável';
           const student = Array.isArray(request.students) ? request.students[0] : request.students;
           const classData = Array.isArray(student?.classes) ? student.classes[0] : student?.classes;
           detail.querySelector('[data-secretary-detail-class]').textContent = classData ? `${classData.year}º ano ${classData.class_code}` : '—';
           detail.querySelector('[data-secretary-detail-purpose]').textContent = request.purpose || '—';
           detail.querySelector('[data-secretary-detail-date]').textContent = secretaryDate(request.created_at,true);
           detail.querySelector('[data-secretary-detail-deadline]').textContent = secretaryDeadline(request);
           detail.querySelector('[data-secretary-detail-status]').value = request.status || 'received';
           detail.querySelector('[data-secretary-detail-note]').value = request.admin_note || '';
           detail.querySelector('[data-secretary-detail-timeline]').innerHTML = secretaryTimelineMarkup(request);
         }
         async function loadSecretaryStaff() {
           if (!supabaseClient || !currentUser || secretaryState.loading) return;
           secretaryState.loading = true;
           try {
             let result = await supabaseClient.from('secretary_requests').select('id,protocol,requester_id,student_id,request_type,description,purpose,details,receiving_method,status,deadline_at,admin_note,created_at,updated_at,students(official_name,classes(year,class_code))').order('created_at',{ascending:false});
             if (result.error) result = await supabaseClient.from('secretary_requests').select('id,requester_id,student_id,request_type,description,status,admin_note,created_at,updated_at,students(official_name,classes(year,class_code))').order('created_at',{ascending:false});
             secretaryState.requests = result.error ? [] : result.data || [];
             const requesterIds = [...new Set(secretaryState.requests.map(item => item.requester_id).filter(Boolean))];
             const profiles = requesterIds.length ? await supabaseClient.from('profiles').select('id,full_name,email').in('id',requesterIds) : { data:[], error:null };
             secretaryState.profiles = profiles.error ? [] : profiles.data || [];
             const ids = secretaryState.requests.map(item => item.id);
             const events = ids.length ? await supabaseClient.from('secretary_request_events').select('id,request_id,status,note,created_at').in('request_id',ids).order('created_at') : { data:[], error:null };
             secretaryState.events = events.error ? [] : events.data || [];
             secretaryState.staffLoaded = true;
             renderSecretaryStaffList();
             renderSecretaryStaffDetail();
           } finally { secretaryState.loading = false; }
         }
         async function saveSecretaryStaffDetail() {
           const request = secretaryState.requests.find(item => item.id === secretaryState.selectedRequestId);
           const detail = secretaryView?.querySelector('[data-secretary-detail]');
           if (!request || !detail) return;
           const statusText = detail.querySelector('[data-secretary-detail-note]');
           const nextStatus = detail.querySelector('[data-secretary-detail-status]').value;
           const note = statusText.value.trim();
           const button = detail.querySelector('[data-secretary-save-detail]');
           button.disabled = true;
           let result = await supabaseClient.from('secretary_requests').update({ status:nextStatus, admin_note:note || null, reviewed_by:currentUser.id, updated_at:new Date().toISOString() }).eq('id',request.id);
           if (!result.error) { const eventResult = await supabaseClient.from('secretary_request_events').insert({ request_id:request.id, status:nextStatus, note:note || secretaryStatusLabel(nextStatus), created_by:currentUser.id }); if (eventResult.error) result = eventResult; }
            const file = detail.querySelector('[data-secretary-detail-file]')?.files?.[0];
            let attachmentError = '';
            if (!result.error && file?.size) { const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]+/g,'-').slice(-90) || 'documento'; const path = `requests/${request.id}/${crypto.randomUUID()}-${safeName}`; const upload = await supabaseClient.storage.from('secretary-attachments').upload(path,file,{contentType:file.type || 'application/octet-stream',upsert:false}); if (upload.error) attachmentError = ' O anexo não foi enviado.'; else { const attachment = await supabaseClient.from('secretary_request_attachments').insert({ request_id:request.id, uploaded_by:currentUser.id, storage_path:path, file_name:file.name, content_type:file.type || null }); if (attachment.error) { await supabaseClient.storage.from('secretary-attachments').remove([path]); attachmentError = ' O anexo não foi associado.'; } } }
            button.disabled = false;
            const label = detail.querySelector('[data-secretary-detail-badge]');
            label.textContent = result.error ? 'Erro ao salvar' : attachmentError ? `Atualizado.${attachmentError}` : 'Atualizado';
            if (!result.error) { request.status = nextStatus; request.admin_note = note; renderSecretaryStaffList(); renderSecretaryStaffDetail(); }
         }
         async function generateSecretaryDocument() {
           const request = secretaryState.requests.find(item => item.id === secretaryState.selectedRequestId);
           if (!request) return;
           const JsPDF = await getPdfConstructor();
           const doc = new JsPDF({ unit:'mm', format:'a4' });
           const logo = await getSchoolLogoDataUrl();
           if (logo) doc.addImage(logo,'JPEG',20,17,22,22);
           doc.setTextColor(22,86,167); doc.setFont('helvetica','bold'); doc.setFontSize(18); doc.text('BFR CONECTA',48,28);
           doc.setTextColor(23,33,31); doc.setFontSize(16); doc.text(request.request_type || 'Declaração escolar',20,58);
           doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.text(`Protocolo: ${secretaryProtocol(request)}`,20,69); doc.text(`Aluno: ${secretaryStudentName(request)}`,20,79); doc.text(`Emitido em: ${secretaryDate(new Date(),true)}`,20,89);
           const body = `A Escola Benício Ferreira Reis declara, para os devidos fins, que o atendimento referente a ${request.request_type || 'esta solicitação'} foi preparado pela Secretaria Digital BFR Conecta. Finalidade informada: ${request.purpose || 'não informada'}.`;
           doc.splitTextToSize(body,170).forEach((line,index) => doc.text(line,20,108 + index * 6));
           doc.setTextColor(115,129,126); doc.setFontSize(9); doc.text('Documento emitido digitalmente pela secretaria escolar.',20,260);
           const blob = doc.output('blob'); saveBlob(blob,`documento-${safePdfName(secretaryProtocol(request))}.pdf`);
           const path = `requests/${request.id}/documento-${crypto.randomUUID()}.pdf`;
            const upload = await supabaseClient.storage.from('school-documents').upload(path,blob,{contentType:'application/pdf',upsert:false});
            const detail = secretaryView?.querySelector('[data-secretary-detail]');
            const label = detail?.querySelector('[data-secretary-detail-badge]');
            if (upload.error) { if (label) label.textContent = 'PDF baixado, mas não publicado'; return; }
            let saved = await supabaseClient.from('school_documents').insert({ title:request.request_type || 'Documento escolar', category:'Documentos emitidos', description:`Documento do protocolo ${secretaryProtocol(request)}.`, storage_path:path, student_id:request.student_id, request_id:request.id, recipient_id:request.requester_id, published:false, created_by:currentUser.id });
            if (saved.error) saved = await supabaseClient.from('school_documents').insert({ title:request.request_type || 'Documento escolar', category:'Documentos emitidos', description:`Documento do protocolo ${secretaryProtocol(request)}.`, storage_path:path, published:false, created_by:currentUser.id });
            if (saved.error) { await supabaseClient.storage.from('school-documents').remove([path]); if (label) label.textContent = 'PDF baixado, mas não publicado'; return; }
            await supabaseClient.from('secretary_requests').update({ status:'ready', updated_at:new Date().toISOString(), reviewed_by:currentUser.id }).eq('id',request.id); await supabaseClient.from('secretary_request_events').insert({ request_id:request.id, status:'ready', note:'Documento gerado e disponibilizado para download.', created_by:currentUser.id });
           await loadSecretaryStaff();
         }
         function setupSecretaryStaff() {
           if (!secretaryView || !secretaryView.querySelector('[data-secretary-staff-list]')) return;
           if (!document.body.dataset.secretaryStaffActions) { document.body.dataset.secretaryStaffActions = 'true'; document.addEventListener('click', event => { const card = event.target.closest('[data-secretary-request-id]'); if (card && event.target.closest('[data-secretary-select-request]')) { secretaryState.selectedRequestId = card.dataset.secretaryRequestId; renderSecretaryStaffDetail(); secretaryView?.querySelector('[data-secretary-detail]')?.scrollIntoView({behavior:'smooth',block:'start'}); } if (event.target.closest('[data-secretary-save-detail]')) saveSecretaryStaffDetail(); if (event.target.closest('[data-secretary-generate-document]')) generateSecretaryDocument(); }); }
           const filter = secretaryView.querySelector('[data-secretary-staff-filter]'); const search = secretaryView.querySelector('[data-secretary-staff-search]');
           if (filter && !filter.dataset.ready) { filter.dataset.ready = 'true'; filter.addEventListener('change', renderSecretaryStaffList); }
           if (search && !search.dataset.ready) { search.dataset.ready = 'true'; search.addEventListener('input', renderSecretaryStaffList); }
           const messageForm = secretaryView.querySelector('[data-secretary-staff-message-form]');
           if (messageForm && !messageForm.dataset.ready) { messageForm.dataset.ready = 'true'; messageForm.addEventListener('submit', async event => { event.preventDefault(); const request = secretaryState.requests.find(item => item.id === secretaryState.selectedRequestId); const status = messageForm.querySelector('[data-secretary-staff-message-status]'); const body = messageForm.body.value.trim(); if (!request || !body) { status.textContent = 'Selecione uma solicitação e escreva uma mensagem.'; return; } let result = await supabaseClient.from('secretary_request_messages').insert({ request_id:request.id, sender_id:currentUser.id, recipient_id:request.requester_id, body }); if (result.error) { const resultStudent = request.student_id ? await supabaseClient.from('student_messages').insert({ student_id:request.student_id, sender_id:currentUser.id, recipient_id:request.requester_id, category:'general', body }) : result; result = resultStudent; } status.textContent = result.error ? 'Não foi possível enviar.' : 'Mensagem enviada ao responsável.'; if (!result.error) { messageForm.reset(); await loadSecretaryStaff(); } }); }
           loadSecretaryStaff();
         }
         function ensureSecretaryViews() {
           if (!secretaryView || !currentProfile) return;
           const staff = currentProfile.role === 'secretary' || (currentProfile.role === 'developer' && activeView === 'secretary');
           if (staff && !secretaryView.querySelector('[data-secretary-staff-list]')) secretaryView.innerHTML = secretaryStaffMarkup();
           if (!staff && !secretaryView.querySelector('[data-secretary-request-list]')) secretaryView.innerHTML = secretaryFamilyMarkup();
         }
          function setupSecretaryView() { ensureSecretaryViews(); if (secretaryView?.querySelector('[data-secretary-staff-list]')) setupSecretaryStaff(); else setupSecretaryFamily(); }
           const secretaryNetworkState = { students:[], classes:[], profiles:[], teachers:[], activities:[], requests:[], requestEvents:[], announcements:[], events:[], attendance:[], grades:[], documents:[], checkins:[], loaded:false, loading:false, error:'', selectedSchoolId:'bfr-current-school', selectedSection:'overview', selectedRequestId:null, selectedStudentId:null };
          function secretaryStaffMarkup() { return `
            <section class="secretary-hero secretary-network-hero"><div><div class="eyebrow">Secretaria · gestão municipal</div><h1>Centro de Gestão da Educação.</h1><p>Uma visão operacional para acompanhar a unidade escolar, organizar solicitações, comunicar a comunidade e exportar os dados realmente disponíveis.</p></div><div class="secretary-actions"><button class="primary-button" type="button" data-secretary-refresh>Atualizar dados</button><button class="text-button" type="button" data-secretary-export-csv>Baixar CSV ↓</button><button class="text-button" type="button" data-secretary-export-pdf>Relatório PDF ↓</button></div></section>
            <nav class="secretary-network-tabs" role="tablist" aria-label="Seções da Secretaria"><button class="secretary-network-tab is-active" type="button" role="tab" aria-selected="true" data-secretary-tab="overview">Visão geral</button><button class="secretary-network-tab" type="button" role="tab" aria-selected="false" data-secretary-tab="schools">Escolas</button><button class="secretary-network-tab" type="button" role="tab" aria-selected="false" data-secretary-tab="requests">Solicitações</button><button class="secretary-network-tab" type="button" role="tab" aria-selected="false" data-secretary-tab="communications">Comunicação</button><button class="secretary-network-tab" type="button" role="tab" aria-selected="false" data-secretary-tab="reports">Relatórios</button><button class="secretary-network-tab" type="button" role="tab" aria-selected="false" data-secretary-tab="notifications">Notificações</button><button class="secretary-network-tab" type="button" role="tab" aria-selected="false" data-secretary-tab="search">Busca global</button></nav>
            <p class="secretary-network-status" data-secretary-network-status>Carregando dados sincronizados...</p>
            <section class="secretary-network-screen" data-secretary-screen="overview"><div class="secretary-network-card-grid"><article class="secretary-network-card"><span>Escolas</span><strong data-secretary-network-metric="schools">—</strong><small>Unidades no escopo atual. O cadastro municipal de escolas ainda não está disponível no banco.</small></article><article class="secretary-network-card"><span>Alunos ativos</span><strong data-secretary-network-metric="students">—</strong><small>Cadastro oficial sincronizado com a escola.</small></article><article class="secretary-network-card"><span>Turmas</span><strong data-secretary-network-metric="classes">—</strong><small>Turmas encontradas no ano letivo atual.</small></article><article class="secretary-network-card"><span>Equipe escolar</span><strong data-secretary-network-metric="staff">—</strong><small>Profissionais localizados no diretório e nos perfis.</small></article></div><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Visão da rede</div><h2>Resumo operacional</h2><p>Os números abaixo são calculados a partir dos registros disponíveis agora.</p></div><span class="secretary-filter-chip">dados reais</span></div><div class="secretary-network-list" data-secretary-overview-activity-list><div class="secretary-network-empty">Carregando atividade da escola...</div></div></section><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Participação</div><h2>Participação da rede</h2><p>O banco ainda não possui registros de participação por escola.</p></div></div><div class="secretary-network-empty"><strong>—</strong><br>Métrica indisponível até a publicação da estrutura de participação.</div><div class="secretary-network-panel-head" style="margin-top:18px"><div><div class="eyebrow">Evolução</div><h2>Série histórica</h2><p>Sem lançamentos de notas ou frequência para comparar.</p></div></div><div class="secretary-network-empty">Nenhuma série histórica disponível.</div></section></div><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Acompanhamento</div><h2>Alertas e prioridades</h2><p>Prioridades calculadas por status e prazo das solicitações.</p></div><button class="text-button" type="button" data-secretary-tab="requests">Abrir fila →</button></div><div class="secretary-network-list" data-secretary-overview-alert-list><div class="secretary-network-empty">Nenhuma prioridade carregada.</div></div></section><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Atalhos</div><h2>Acesso rápido</h2></div></div><div class="secretary-network-list"><button class="secretary-network-search-result" type="button" data-secretary-tab="schools"><strong>Gestão de escolas</strong><span>Consulte a unidade e seus indicadores cadastrados.</span></button><button class="secretary-network-search-result" type="button" data-secretary-tab="reports"><strong>Relatórios</strong><span>Baixe um resumo em CSV ou PDF.</span></button><div class="secretary-network-locked">Publicação de comunicados permanece restrita à policy atual do banco.</div></div></section></div></section>
            <section class="secretary-network-screen hidden" data-secretary-screen="schools"><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Cadastro disponível</div><h2>Escolas</h2><p>Esta instalação possui uma unidade escolar identificada no escopo do aplicativo; não há tabela municipal de escolas para expandir a rede.</p></div><span class="secretary-filter-chip" data-secretary-school-count>— unidade</span></div><div class="secretary-school-toolbar"><input type="search" data-secretary-school-search placeholder="Buscar escola" aria-label="Buscar escola"><select data-secretary-school-status aria-label="Filtrar status da escola"><option value="all">Todos os status</option><option value="active">Ativas</option></select></div><div class="secretary-school-list" data-secretary-school-list><div class="secretary-network-empty">Carregando escolas...</div></div></section><section class="panel secretary-school-detail" data-secretary-school-detail><div class="secretary-network-panel-head"><div><div class="eyebrow">Detalhe da escola</div><h2 data-secretary-school-detail-title>Selecione uma escola</h2><p data-secretary-school-detail-subtitle>Os detalhes aparecerão depois da sincronização.</p></div><span class="secretary-status is-ready" data-secretary-school-detail-status>—</span></div><dl><dt>Direção</dt><dd data-secretary-school-detail-director>—</dd><dt>Alunos</dt><dd data-secretary-school-detail-students>—</dd><dt>Turmas</dt><dd data-secretary-school-detail-classes>—</dd><dt>Professores</dt><dd data-secretary-school-detail-teachers>—</dd><dt>Atividades</dt><dd data-secretary-school-detail-activities>—</dd><dt>Última atividade</dt><dd data-secretary-school-detail-last-activity>—</dd></dl><div class="secretary-network-empty" data-secretary-school-detail-note>Dados de participação, evolução e vínculo de diretores por unidade ainda não estão disponíveis.</div></section></div></section>
            <section class="secretary-network-screen hidden" data-secretary-screen="requests"><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Atendimento por protocolo</div><h2>Central de solicitações</h2><p>Fila única com status, prioridade calculada e prazo real quando preenchido.</p></div><span class="agenda-count" data-secretary-staff-updated>sincronizando</span></div><div class="secretary-request-toolbar"><select data-secretary-staff-filter aria-label="Filtrar solicitações"><option value="all">Todos os status</option><option value="pending">Pendentes</option><option value="reviewing">Em análise</option><option value="approved">Aprovadas / prontas</option><option value="closed">Concluídas</option></select><select data-secretary-priority-filter aria-label="Filtrar prioridade"><option value="all">Todas as prioridades</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option></select><input type="search" data-secretary-staff-search placeholder="Buscar protocolo, aluno ou solicitante" aria-label="Buscar solicitação"></div><div class="secretary-list" data-secretary-staff-list><div class="secretary-network-empty">Carregando solicitações...</div></div></section><section class="panel secretary-detail" data-secretary-detail><div class="secretary-network-panel-head"><div><div class="eyebrow">Protocolo selecionado</div><h2 data-secretary-detail-title>Selecione uma solicitação</h2><p data-secretary-detail-subtitle>Abra um protocolo para consultar o histórico e atuar no atendimento.</p></div><span class="secretary-status" data-secretary-detail-badge>—</span></div><div data-secretary-detail-empty class="secretary-network-empty">Nenhum protocolo selecionado.</div><div data-secretary-detail-content class="hidden"><dl><dt>Aluno</dt><dd data-secretary-detail-student>—</dd><dt>Responsável</dt><dd data-secretary-detail-requester>—</dd><dt>Turma</dt><dd data-secretary-detail-class>—</dd><dt>Finalidade</dt><dd data-secretary-detail-purpose>—</dd><dt>Aberto em</dt><dd data-secretary-detail-date>—</dd><dt>Prazo</dt><dd data-secretary-detail-deadline>—</dd></dl><label class="secretary-form" style="margin-top:0">Status<select data-secretary-detail-status><option value="received">Recebida</option><option value="reviewing">Em análise</option><option value="waiting_information">Aguardando informação</option><option value="preparing">Documento em preparação</option><option value="ready">Pronta para baixar</option><option value="closed">Concluída</option><option value="cancelled">Cancelada</option></select></label><label class="secretary-form">Nota interna<textarea data-secretary-detail-note maxlength="1000" placeholder="Registre uma orientação ou observação do atendimento."></textarea></label><label class="secretary-form">Anexar documento<input type="file" data-secretary-detail-file accept="application/pdf,image/*"></label><div class="secretary-staff-actions"><button class="primary-button" type="button" data-secretary-save-detail>Salvar atendimento</button><button class="text-button" type="button" data-secretary-generate-document>Gerar PDF padrão</button></div><div class="secretary-timeline" data-secretary-detail-timeline></div><form class="secretary-form" data-secretary-staff-message-form><label>Mensagem ao responsável<textarea name="body" maxlength="1000" placeholder="Escreva uma orientação objetiva."></textarea></label><button class="text-button" type="submit">Enviar mensagem</button><p class="publish-status" data-secretary-staff-message-status></p></form></div></section></div></section>
            <section class="secretary-network-screen hidden" data-secretary-screen="communications"><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Comunicação institucional</div><h2>Comunicados publicados</h2><p>Consulte o que já foi publicado para a comunidade escolar.</p></div><span class="agenda-count" data-secretary-communication-count>—</span></div><div class="secretary-network-list" data-secretary-communications-list><div class="secretary-network-empty">Carregando comunicados...</div></div></section><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Próximos eventos</div><h2>Agenda institucional</h2></div></div><div class="secretary-network-list" data-secretary-events-list><div class="secretary-network-empty">Carregando eventos...</div></div><div class="secretary-network-locked" style="margin-top:14px">Novo comunicado e novo evento não aparecem como ações disponíveis porque a permissão de publicação da Secretaria não está confirmada no backend atual.</div></section></div></section>
            <section class="secretary-network-screen hidden" data-secretary-screen="reports"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Prestação de contas</div><h2>Relatórios operacionais</h2><p>Exporte apenas os registros carregados nesta sessão. Indicadores acadêmicos sem dados permanecem vazios.</p></div></div><div class="secretary-network-card-grid"><article class="secretary-network-card"><span>Base de alunos</span><strong data-secretary-report-metric="students">—</strong><small>Alunos ativos na lista oficial.</small></article><article class="secretary-network-card"><span>Solicitações</span><strong data-secretary-report-metric="requests">—</strong><small>Protocolos encontrados.</small></article><article class="secretary-network-card is-neutral"><span>Notas lançadas</span><strong>—</strong><small>Nenhum lançamento disponível no banco consultado.</small></article><article class="secretary-network-card is-neutral"><span>Frequência</span><strong>—</strong><small>Nenhum registro disponível no banco consultado.</small></article></div><div class="secretary-report-actions"><button class="primary-button" type="button" data-secretary-export-csv>Baixar base CSV</button><button class="text-button" type="button" data-secretary-export-pdf>Baixar resumo PDF</button></div><p class="publish-status" data-secretary-report-status></p></section></section>
            <section class="secretary-network-screen hidden" data-secretary-screen="notifications"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Centro de notificações</div><h2>Alertas e avisos</h2><p>Itens derivados de solicitações prioritárias, comunicados e eventos sincronizados.</p></div><span class="agenda-count" data-secretary-notification-count>—</span></div><div class="secretary-network-list" data-secretary-notifications-list><div class="secretary-network-empty">Carregando notificações...</div></div></section></section>
            <section class="secretary-network-screen hidden" data-secretary-screen="search"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Pesquisa rápida</div><h2>Busca global</h2><p>Pesquise nos dados já carregados de alunos, turmas, protocolos, comunicados e atividades.</p></div></div><input class="global-search-input" type="search" data-secretary-global-search placeholder="Digite nome, protocolo, turma ou título" aria-label="Busca global da Secretaria"><div class="secretary-network-search-results" data-secretary-global-results><div class="secretary-network-empty">Digite algo para iniciar a busca.</div></div></section></section>`; }
          function secretaryNetworkSchool() {
            const director = secretaryNetworkState.profiles.find(item => ['director','direction'].includes(item.role));
            const activity = secretaryNetworkState.activities[0];
            return { id:'bfr-current-school', name:'Escola Benício Ferreira Reis', status:'active', director:director?.full_name || 'Não informado', students:secretaryNetworkState.students.length, classes:secretaryNetworkState.classes.length, teachers:secretaryNetworkState.teachers.length, activities:secretaryNetworkState.activities.length, lastActivity:activity?.title || 'Nenhuma atividade publicada' };
          }
          function secretaryNetworkSchools() { return [secretaryNetworkSchool()]; }
          function secretaryNetworkClassLabel(item) { return item ? `${item.year || '—'}º ano ${item.class_code || ''}`.trim() : 'Turma não informada'; }
          function secretaryNetworkPriority(request) {
            const closed = ['closed','cancelled'].includes(request?.status);
            const overdue = request?.deadline_at && new Date(request.deadline_at) < new Date() && !closed;
            if (overdue || request?.status === 'waiting_information') return { key:'high', label:'Alta' };
            if (request?.status === 'reviewing' || request?.status === 'preparing') return { key:'medium', label:'Média' };
            return { key:'low', label:'Baixa' };
          }
          function secretaryNetworkRequestMatchesStatus(request, filter) {
            if (filter === 'all') return true;
            if (filter === 'pending') return ['received','waiting_information','preparing'].includes(request.status);
            if (filter === 'reviewing') return request.status === 'reviewing';
            if (filter === 'approved') return request.status === 'ready';
            if (filter === 'closed') return ['closed','cancelled'].includes(request.status);
            return request.status === filter;
          }
          function secretaryNetworkRequestCard(request) {
            const priority = secretaryNetworkPriority(request);
            const requester = secretaryNetworkState.profiles.find(item => item.id === request.requester_id);
            return `<article class="secretary-request-card" data-secretary-request-id="${escapeHtml(request.id)}"><div class="secretary-request-top"><div><strong>${escapeHtml(request.request_type || 'Solicitação')}</strong><div class="secretary-request-meta"><span>${escapeHtml(secretaryProtocol(request))}</span><span>${secretaryDate(request.created_at)}</span></div></div><div style="display:flex;flex-wrap:wrap;justify-content:flex-end;gap:5px"><span class="secretary-status ${secretaryStatusClass(request.status)}">${escapeHtml(secretaryStatusLabel(request.status))}</span><span class="secretary-priority ${priority.key === 'high' ? 'is-high' : priority.key === 'medium' ? 'is-medium' : ''}">${priority.label}</span></div></div><p>${escapeHtml(request.description || request.details || 'Solicitação enviada para atendimento.')}</p><div class="secretary-request-meta"><span>Aluno: ${escapeHtml(secretaryStudentName(request))}</span><span>Solicitante: ${escapeHtml(requester?.full_name || requester?.email || 'Não informado')}</span><span>Prazo: ${escapeHtml(secretaryDeadline(request))}</span></div><button class="text-button" type="button" data-secretary-select-request style="margin-top:10px;padding-left:0">Abrir protocolo →</button></article>`;
          }
          function renderSecretaryNetworkStatus(message = '', isError = false) { const status = secretaryView?.querySelector('[data-secretary-network-status]'); if (!status) return; status.textContent = message; status.classList.toggle('is-error', isError); }
          function renderSecretaryStaffList() {
            const list = secretaryView?.querySelector('[data-secretary-staff-list]');
            if (!list) return;
            const filter = secretaryView.querySelector('[data-secretary-staff-filter]')?.value || 'all';
            const priorityFilter = secretaryView.querySelector('[data-secretary-priority-filter]')?.value || 'all';
            const search = String(secretaryView.querySelector('[data-secretary-staff-search]')?.value || '').toLocaleLowerCase('pt-BR').trim();
            const items = secretaryNetworkState.requests.filter(request => { const priority = secretaryNetworkPriority(request); const requester = secretaryNetworkState.profiles.find(item => item.id === request.requester_id); const haystack = [secretaryProtocol(request), secretaryStudentName(request), requester?.full_name, requester?.email, request.request_type, request.description].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR'); return secretaryNetworkRequestMatchesStatus(request, filter) && (priorityFilter === 'all' || priority.key === priorityFilter) && (!search || haystack.includes(search)); });
            list.innerHTML = items.length ? items.map(secretaryNetworkRequestCard).join('') : '<div class="secretary-network-empty">Nenhuma solicitação corresponde aos filtros atuais.</div>';
            secretaryView.querySelector('[data-secretary-staff-updated]')?.replaceChildren(document.createTextNode(secretaryNetworkState.loaded ? `atualizado ${secretaryDate(new Date(),true)}` : 'sincronizando'));
            const counts = { pending:secretaryNetworkState.requests.filter(item => secretaryNetworkRequestMatchesStatus(item,'pending')).length, waiting:secretaryNetworkState.requests.filter(item => item.status === 'waiting_information').length, closed:secretaryNetworkState.requests.filter(item => secretaryNetworkRequestMatchesStatus(item,'closed')).length };
            secretaryView.querySelectorAll('[data-secretary-staff-count]').forEach(item => { item.textContent = String(counts[item.dataset.secretaryStaffCount] ?? counts.pending); });
          }
          function renderSecretaryStaffDetail() {
            const detail = secretaryView?.querySelector('[data-secretary-detail]');
            if (!detail) return;
            const request = secretaryNetworkState.requests.find(item => item.id === secretaryNetworkState.selectedRequestId);
            const empty = detail.querySelector('[data-secretary-detail-empty]');
            const content = detail.querySelector('[data-secretary-detail-content]');
            if (!request) { empty?.classList.remove('hidden'); content?.classList.add('hidden'); detail.querySelector('[data-secretary-detail-title]').textContent = 'Selecione uma solicitação'; detail.querySelector('[data-secretary-detail-badge]').textContent = '—'; return; }
            empty?.classList.add('hidden'); content?.classList.remove('hidden');
            const profile = secretaryNetworkState.profiles.find(item => item.id === request.requester_id);
            const student = Array.isArray(request.students) ? request.students[0] : request.students;
            const classData = Array.isArray(student?.classes) ? student.classes[0] : student?.classes;
            detail.querySelector('[data-secretary-detail-title]').textContent = `${request.request_type || 'Solicitação'} · ${secretaryProtocol(request)}`;
            detail.querySelector('[data-secretary-detail-badge]').textContent = secretaryStatusLabel(request.status);
            detail.querySelector('[data-secretary-detail-badge]').className = `secretary-status ${secretaryStatusClass(request.status)}`;
            detail.querySelector('[data-secretary-detail-student]').textContent = secretaryStudentName(request);
            detail.querySelector('[data-secretary-detail-requester]').textContent = profile?.full_name || profile?.email || 'Não informado';
            detail.querySelector('[data-secretary-detail-class]').textContent = classData ? secretaryNetworkClassLabel(classData) : secretaryNetworkState.classes.find(item => item.id === request.class_id) ? secretaryNetworkClassLabel(secretaryNetworkState.classes.find(item => item.id === request.class_id)) : '—';
            detail.querySelector('[data-secretary-detail-purpose]').textContent = request.purpose || '—';
            detail.querySelector('[data-secretary-detail-date]').textContent = secretaryDate(request.created_at,true);
            detail.querySelector('[data-secretary-detail-deadline]').textContent = secretaryDeadline(request);
            detail.querySelector('[data-secretary-detail-status]').value = request.status || 'received';
            detail.querySelector('[data-secretary-detail-note]').value = request.admin_note || '';
            detail.querySelector('[data-secretary-detail-timeline]').innerHTML = secretaryTimelineMarkup(request);
          }
          function renderSecretaryNetworkOverview() {
            const school = secretaryNetworkSchool();
            const values = { schools:secretaryNetworkSchools().length, students:school.students, classes:school.classes, staff:school.teachers + secretaryNetworkState.profiles.filter(item => ['director','coordinator','secretary','pedagogical','aee','monitor','gatekeeper'].includes(item.role)).length };
            secretaryView?.querySelectorAll('[data-secretary-network-metric]').forEach(item => { item.textContent = String(values[item.dataset.secretaryNetworkMetric] ?? '—'); });
            secretaryView?.querySelector('[data-secretary-overview-activity-list]').replaceChildren(...(secretaryNetworkState.activities.length ? secretaryNetworkState.activities.slice(0,5).map(activity => { const item = document.createElement('div'); item.className = 'secretary-network-list-item'; item.innerHTML = `<div><strong>${escapeHtml(activity.title || 'Atividade escolar')}</strong><span>${escapeHtml(activity.subject || 'Componente não informado')} · ${secretaryDate(activity.published_at || activity.created_at)}</span></div><span class="secretary-status is-ready">publicada</span>`; return item; }) : [Object.assign(document.createElement('div'), { className:'secretary-network-empty', textContent:'Nenhuma atividade publicada no banco escolar.' })]));
            const alerts = secretaryNetworkState.requests.filter(item => secretaryNetworkPriority(item).key === 'high' && !['closed','cancelled'].includes(item.status)).slice(0,5);
            const alertList = secretaryView?.querySelector('[data-secretary-overview-alert-list]');
            if (alertList) alertList.innerHTML = alerts.length ? alerts.map(item => `<div class="secretary-network-list-item"><div><strong>${escapeHtml(item.request_type || 'Solicitação')}</strong><span>${escapeHtml(secretaryProtocol(item))} · ${escapeHtml(secretaryStudentName(item))}</span></div><span class="secretary-priority is-high">alta</span></div>`).join('') : '<div class="secretary-network-empty">Nenhuma prioridade alta encontrada.</div>';
            secretaryView?.querySelector('[data-secretary-report-metric="students"]')?.replaceChildren(document.createTextNode(String(values.students)));
            secretaryView?.querySelector('[data-secretary-report-metric="requests"]')?.replaceChildren(document.createTextNode(String(secretaryNetworkState.requests.length)));
          }
          function renderSecretaryNetworkSchools() {
            const list = secretaryView?.querySelector('[data-secretary-school-list]');
            if (!list) return;
            const search = String(secretaryView.querySelector('[data-secretary-school-search]')?.value || '').toLocaleLowerCase('pt-BR').trim();
            const status = secretaryView.querySelector('[data-secretary-school-status]')?.value || 'all';
            const schools = secretaryNetworkSchools().filter(item => (!search || item.name.toLocaleLowerCase('pt-BR').includes(search)) && (status === 'all' || item.status === status));
            list.innerHTML = schools.length ? schools.map(item => `<article class="secretary-school-row ${item.id === secretaryNetworkState.selectedSchoolId ? 'is-selected' : ''}" data-secretary-school-id="${item.id}"><div><strong>${escapeHtml(item.name)}</strong><small>${item.status === 'active' ? 'Unidade ativa no escopo atual' : 'Status não informado'}</small></div><div><span class="secretary-school-value">${item.students}<span>alunos</span></span></div><div><span class="secretary-school-value">${item.classes}<span>turmas</span></span></div><div><span class="secretary-school-value">${item.teachers || '—'}<span>professores</span></span></div><button class="text-button" type="button" data-secretary-school-open>Ver detalhe →</button></article>`).join('') : '<div class="secretary-network-empty">Nenhuma escola corresponde aos filtros atuais.</div>';
            secretaryView.querySelector('[data-secretary-school-count]')?.replaceChildren(document.createTextNode(`${schools.length} unidade${schools.length === 1 ? '' : 's'}`));
            renderSecretarySchoolDetail();
          }
          function renderSecretarySchoolDetail() {
            const detail = secretaryView?.querySelector('[data-secretary-school-detail]');
            const school = secretaryNetworkSchools().find(item => item.id === secretaryNetworkState.selectedSchoolId) || secretaryNetworkSchools()[0];
            if (!detail || !school) return;
            detail.querySelector('[data-secretary-school-detail-title]').textContent = school.name;
            detail.querySelector('[data-secretary-school-detail-subtitle]').textContent = 'Unidade escolar atualmente representada pelo aplicativo.';
            detail.querySelector('[data-secretary-school-detail-status]').textContent = school.status === 'active' ? 'ativa' : 'status não informado';
            detail.querySelector('[data-secretary-school-detail-director]').textContent = school.director;
            detail.querySelector('[data-secretary-school-detail-students]').textContent = String(school.students);
            detail.querySelector('[data-secretary-school-detail-classes]').textContent = String(school.classes);
            detail.querySelector('[data-secretary-school-detail-teachers]').textContent = school.teachers ? String(school.teachers) : '—';
            detail.querySelector('[data-secretary-school-detail-activities]').textContent = String(school.activities);
            detail.querySelector('[data-secretary-school-detail-last-activity]').textContent = school.lastActivity;
          }
          function renderSecretaryNetworkCommunications() {
            const communications = secretaryView?.querySelector('[data-secretary-communications-list]');
            if (communications) communications.innerHTML = secretaryNetworkState.announcements.length ? secretaryNetworkState.announcements.map(item => `<article class="secretary-request-card"><div class="secretary-request-top"><strong>${escapeHtml(item.title || 'Comunicado')}</strong><small>${secretaryDate(item.published_at || item.created_at,true)}</small></div><p>${escapeHtml(item.body || 'Sem mensagem publicada.')}</p>${item.important ? '<span class="secretary-priority is-high">importante</span>' : ''}</article>`).join('') : '<div class="secretary-network-empty">Nenhum comunicado publicado.</div>';
            secretaryView?.querySelector('[data-secretary-communication-count]')?.replaceChildren(document.createTextNode(String(secretaryNetworkState.announcements.length)));
            const events = secretaryView?.querySelector('[data-secretary-events-list]');
            if (events) events.innerHTML = secretaryNetworkState.events.length ? secretaryNetworkState.events.map(item => `<article class="secretary-request-card"><div class="secretary-request-top"><strong>${escapeHtml(item.title || 'Evento')}</strong><small>${secretaryDate(item.starts_at,true)}</small></div><p>${escapeHtml(item.description || 'Evento institucional')}${item.location ? ` · ${escapeHtml(item.location)}` : ''}</p></article>`).join('') : '<div class="secretary-network-empty">Nenhum evento futuro publicado.</div>';
          }
          function renderSecretaryNetworkNotifications() {
            const items = [];
            secretaryNetworkState.requests.filter(item => secretaryNetworkPriority(item).key === 'high' && !['closed','cancelled'].includes(item.status)).forEach(item => items.push({ title:'Solicitação prioritária', body:`${secretaryProtocol(item)} · ${secretaryStudentName(item)}`, date:item.updated_at || item.created_at, tone:'high' }));
            secretaryNetworkState.announcements.slice(0,5).forEach(item => items.push({ title:item.important ? 'Comunicado importante' : 'Novo comunicado', body:item.title, date:item.published_at || item.created_at, tone:item.important ? 'high' : 'normal' }));
            secretaryNetworkState.events.slice(0,5).forEach(item => items.push({ title:'Evento próximo', body:item.title, date:item.starts_at, tone:'normal' }));
            const list = secretaryView?.querySelector('[data-secretary-notifications-list]');
             if (list) list.innerHTML = items.length ? items.slice(0,12).map(item => `<div class="secretary-network-list-item"><div><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.body)} · ${secretaryDate(item.date,true)}</span></div><span class="secretary-priority ${item.tone === 'high' ? 'is-high' : ''}">${item.tone === 'high' ? 'atenção' : 'informativo'}</span></div>`).join('') : '<div class="secretary-network-empty">Nenhuma notificação disponível.</div>';
             secretaryView?.querySelector('[data-secretary-notification-count]')?.replaceChildren(document.createTextNode(String(items.length)));
             secretaryView?.querySelector('[data-secretary-side-notification-count]')?.replaceChildren(document.createTextNode(String(items.length)));
           }
          function renderSecretaryNetworkSearch() {
            const query = String(secretaryView?.querySelector('[data-secretary-global-search]')?.value || '').toLocaleLowerCase('pt-BR').trim();
            const host = secretaryView?.querySelector('[data-secretary-global-results]');
            if (!host) return;
            if (!query) { host.innerHTML = '<div class="secretary-network-empty">Digite algo para iniciar a busca.</div>'; return; }
            const results = [];
            secretaryNetworkState.students.forEach(item => { if (String(item.official_name || '').toLocaleLowerCase('pt-BR').includes(query)) results.push({ title:item.official_name, meta:`Aluno · ${secretaryNetworkClassLabel(secretaryNetworkState.classes.find(row => row.id === item.class_id))}` }); });
            secretaryNetworkState.classes.forEach(item => { if (`${item.year} ${item.class_code}`.toLocaleLowerCase('pt-BR').includes(query)) results.push({ title:secretaryNetworkClassLabel(item), meta:'Turma cadastrada' }); });
            secretaryNetworkState.requests.forEach(item => { const haystack = [secretaryProtocol(item), item.request_type, item.description, secretaryStudentName(item)].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR'); if (haystack.includes(query)) results.push({ title:secretaryProtocol(item), meta:`Solicitação · ${secretaryStatusLabel(item.status)}`, action:'requests', id:item.id }); });
            secretaryNetworkState.announcements.forEach(item => { if ([item.title,item.body].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)) results.push({ title:item.title, meta:'Comunicado publicado', action:'communications' }); });
            secretaryNetworkState.activities.forEach(item => { if ([item.title,item.subject,item.description].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)) results.push({ title:item.title, meta:`Atividade · ${item.subject || 'componente não informado'}`, action:'overview' }); });
            host.innerHTML = results.length ? results.slice(0,20).map(item => `<button class="secretary-network-search-result" type="button" data-secretary-search-action="${item.action || ''}" data-secretary-search-id="${item.id || ''}"><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.meta)}</span></button>`).join('') : '<div class="secretary-network-empty">Nenhum resultado encontrado nos dados carregados.</div>';
          }
          function renderSecretaryNetwork() { renderSecretaryNetworkStatus(secretaryNetworkState.error || (secretaryNetworkState.loaded ? `Atualizado em ${secretaryDate(new Date(),true)} · fonte: Supabase` : 'Carregando dados sincronizados...'), Boolean(secretaryNetworkState.error)); renderSecretaryNetworkOverview(); renderSecretaryNetworkSchools(); renderSecretaryStaffList(); renderSecretaryStaffDetail(); renderSecretaryNetworkCommunications(); renderSecretaryNetworkNotifications(); renderSecretaryNetworkSearch(); }
          async function secretaryNetworkFetch(query) { try { return await query; } catch (error) { return { data:[], error }; } }
          async function loadSecretaryStaff(force = false) {
            if (!supabaseClient || !currentUser || !['secretary','developer'].includes(currentProfile?.role)) return;
            if (secretaryNetworkState.loading || (!force && secretaryNetworkState.loaded)) { renderSecretaryNetwork(); return; }
            secretaryNetworkState.loading = true; secretaryNetworkState.error = ''; renderSecretaryNetworkStatus('Carregando dados sincronizados...');
            try {
              const results = await Promise.all([
                secretaryNetworkFetch(supabaseClient.from('secretary_requests').select('id,protocol,requester_id,student_id,request_type,description,purpose,details,receiving_method,status,deadline_at,admin_note,created_at,updated_at,students(official_name,classes(year,class_code))').order('created_at',{ascending:false}).limit(200)),
                secretaryNetworkFetch(supabaseClient.from('profiles').select('id,full_name,email,role').limit(500)),
                secretaryNetworkFetch(supabaseClient.from('students').select('id,official_name,class_id,active').eq('active',true).order('official_name').limit(1200)),
                secretaryNetworkFetch(supabaseClient.from('classes').select('id,year,class_code,shift').order('year').order('class_code')),
                secretaryNetworkFetch(supabaseClient.from('bfr_teacher_directory').select('id').limit(500)),
                secretaryNetworkFetch(supabaseClient.from('school_activities').select('id,title,subject,description,due_date,published_at,class_id').order('published_at',{ascending:false}).limit(100)),
                secretaryNetworkFetch(supabaseClient.from('announcements').select('id,title,body,published_at,important').order('published_at',{ascending:false}).limit(50)),
                secretaryNetworkFetch(supabaseClient.from('school_events').select('title,description,starts_at,location').gte('starts_at',new Date().toISOString()).order('starts_at',{ascending:true}).limit(50)),
                secretaryNetworkFetch(supabaseClient.from('attendance').select('student_id,attendance_date,status').limit(1000)),
                secretaryNetworkFetch(supabaseClient.from('grades').select('student_id,subject,score,term,created_at').limit(1000)),
                secretaryNetworkFetch(supabaseClient.from('school_documents').select('id,title,category,description,storage_path,student_id,request_id,recipient_id,published,created_at').order('created_at',{ascending:false}).limit(100))
              ]);
              const [requests,profiles,students,classes,teachers,activities,announcements,events,attendance,grades,documents] = results;
              secretaryNetworkState.requests = requests.error ? [] : requests.data || [];
              secretaryNetworkState.profiles = profiles.error ? [] : profiles.data || [];
              secretaryNetworkState.students = students.error ? [] : students.data || [];
              secretaryNetworkState.classes = classes.error ? [] : classes.data || [];
              secretaryNetworkState.teachers = teachers.error ? [] : teachers.data || [];
              secretaryNetworkState.activities = activities.error ? [] : activities.data || [];
              secretaryNetworkState.announcements = announcements.error ? [] : announcements.data || [];
              secretaryNetworkState.events = events.error ? [] : events.data || [];
              secretaryNetworkState.attendance = attendance.error ? [] : attendance.data || [];
              secretaryNetworkState.grades = grades.error ? [] : grades.data || [];
              secretaryNetworkState.documents = documents.error ? [] : documents.data || [];
              const ids = secretaryNetworkState.requests.map(item => item.id).filter(Boolean);
              const eventResult = ids.length ? await secretaryNetworkFetch(supabaseClient.from('secretary_request_events').select('id,request_id,status,note,created_at').in('request_id',ids).order('created_at')) : { data:[], error:null };
              secretaryNetworkState.requestEvents = eventResult.error ? [] : eventResult.data || [];
              secretaryState.requests = secretaryNetworkState.requests;
              secretaryState.events = secretaryNetworkState.requestEvents;
              secretaryState.profiles = secretaryNetworkState.profiles;
              if (!secretaryNetworkState.selectedRequestId && secretaryNetworkState.requests[0]) secretaryNetworkState.selectedRequestId = secretaryNetworkState.requests[0].id;
              secretaryState.selectedRequestId = secretaryNetworkState.selectedRequestId;
              secretaryNetworkState.loaded = true;
              renderSecretaryNetwork();
            } catch (error) { secretaryNetworkState.error = 'Não foi possível carregar a visão da Secretaria. Tente atualizar novamente.'; secretaryNetworkState.loaded = true; renderSecretaryNetwork(); }
            finally { secretaryNetworkState.loading = false; }
          }
          function setSecretaryNetworkSection(section) {
             const allowed = ['overview','schools','students','professionals','classes','enrollments','requests','communications','calendar','notifications','indicators','reports','documents','administration','search'];
            secretaryNetworkState.selectedSection = allowed.includes(section) ? section : 'overview';
            secretaryView?.querySelectorAll('[data-secretary-tab]').forEach(button => { const active = button.dataset.secretaryTab === secretaryNetworkState.selectedSection; button.classList.toggle('is-active', active); button.setAttribute('aria-selected', String(active)); });
             secretaryView?.querySelectorAll('[data-secretary-screen]').forEach(screen => screen.classList.toggle('hidden', screen.dataset.secretaryScreen !== secretaryNetworkState.selectedSection));
             secretaryView?.querySelector('[data-secretary-sidebar]')?.classList.remove('is-open');
             const labels = { overview:'Visão geral', schools:'Escolas', students:'Alunos', professionals:'Profissionais', classes:'Turmas', enrollments:'Matrículas', requests:'Solicitações', communications:'Comunicados', calendar:'Agenda institucional', notifications:'Notificações', indicators:'Indicadores', reports:'Relatórios', documents:'Documentos', administration:'Administração', search:'Busca global' };
            if (activeView === 'secretary') document.querySelector('.breadcrumb b')?.replaceChildren(document.createTextNode(labels[secretaryNetworkState.selectedSection] || 'Secretaria digital'));
            if (secretaryNetworkState.selectedSection === 'requests') renderSecretaryStaffList();
          }
          function secretaryNetworkCsvCell(value) { return `"${String(value ?? '').replace(/"/g,'""').replace(/\r?\n/g,' ')}"`; }
          function secretaryNetworkCsvRows() {
            const rows = [['Tipo','Identificador','Status','Prioridade','Aluno ou assunto','Solicitante','Data','Prazo']];
            secretaryNetworkState.requests.forEach(item => { const profile = secretaryNetworkState.profiles.find(row => row.id === item.requester_id); const priority = secretaryNetworkPriority(item); rows.push(['Solicitação',secretaryProtocol(item),secretaryStatusLabel(item.status),priority.label,secretaryStudentName(item),profile?.full_name || profile?.email || 'Não informado',secretaryDate(item.created_at),secretaryDeadline(item)]); });
            secretaryNetworkState.announcements.forEach(item => rows.push(['Comunicado','',item.important ? 'Importante' : 'Publicado','',item.title || '', '', secretaryDate(item.published_at || item.created_at),'']));
            return rows;
          }
          function downloadSecretaryNetworkCsv() { const csv = secretaryNetworkCsvRows().map(row => row.map(secretaryNetworkCsvCell).join(';')).join('\n'); saveBlob(new Blob([`\ufeff${csv}`],{type:'text/csv;charset=utf-8'}),`secretaria-bfr-${new Date().toISOString().slice(0,10)}.csv`); secretaryView?.querySelector('[data-secretary-report-status]')?.replaceChildren(document.createTextNode('CSV gerado com os dados carregados.')); }
          async function downloadSecretaryNetworkPdf() {
            const status = secretaryView?.querySelector('[data-secretary-report-status]');
            if (status) status.textContent = 'Preparando relatório PDF...';
            try {
              const JsPDF = await getPdfConstructor();
              const doc = new JsPDF({ unit:'mm', format:'a4' });
              doc.setTextColor(22,86,167); doc.setFont('helvetica','bold'); doc.setFontSize(17); doc.text('BFR CONECTA',20,22);
              doc.setTextColor(23,33,31); doc.setFontSize(14); doc.text('Relatório operacional da Secretaria',20,34);
              doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(100,116,139); doc.text(`Gerado em ${secretaryDate(new Date(),true)} · dados carregados do Supabase`,20,42);
              const school = secretaryNetworkSchool();
              const summary = [`Escola no escopo atual: ${school.name}`,`Alunos ativos: ${school.students}`,`Turmas: ${school.classes}`,`Professores no diretório: ${school.teachers}`,`Solicitações: ${secretaryNetworkState.requests.length}`,`Comunicados publicados: ${secretaryNetworkState.announcements.length}`,`Notas: sem registros disponíveis`, `Frequência: sem registros disponíveis`];
              doc.setTextColor(36,50,83); doc.setFontSize(11); doc.text('Resumo',20,56); doc.setFont('helvetica','normal'); doc.setFontSize(10); summary.forEach((line,index) => doc.text(line,24,66 + index * 7));
              let y = 132; doc.setFont('helvetica','bold'); doc.text('Solicitações recentes',20,y); y += 9; doc.setFont('helvetica','normal'); doc.setFontSize(9);
              const requests = secretaryNetworkState.requests.slice(0,8);
              if (!requests.length) doc.text('Nenhuma solicitação encontrada.',24,y);
              requests.forEach(item => { const line = `${secretaryProtocol(item)} · ${secretaryStatusLabel(item.status)} · ${secretaryStudentName(item)}`; doc.splitTextToSize(line,165).forEach((part,index) => doc.text(part,24,y + index * 5)); y += 7; });
              saveBlob(doc.output('blob'),`relatorio-secretaria-bfr-${new Date().toISOString().slice(0,10)}.pdf`);
              if (status) status.textContent = 'Relatório PDF baixado.';
            } catch (error) { if (status) status.textContent = error.message || 'Não foi possível gerar o relatório PDF.'; }
          }
          function setupSecretaryStaff() {
            if (!secretaryView || !secretaryView.querySelector('[data-secretary-staff-list]')) return;
            secretaryView.querySelector('#bfrHomeDock')?.remove();
            if (!document.body.dataset.secretaryNetworkActions) {
              document.body.dataset.secretaryNetworkActions = 'true';
              document.addEventListener('click', event => {
                if (event.target.closest('[data-secretary-mobile-menu]')) { secretaryView.querySelector('[data-secretary-sidebar]')?.classList.toggle('is-open'); return; }
                const tab = event.target.closest('[data-secretary-tab]');
                if (tab) { event.preventDefault(); setSecretaryNetworkSection(tab.dataset.secretaryTab); return; }
                if (event.target.closest('[data-secretary-refresh]')) { loadSecretaryStaff(true); return; }
                if (event.target.closest('[data-secretary-export-csv]')) { downloadSecretaryNetworkCsv(); return; }
                if (event.target.closest('[data-secretary-export-pdf]')) { downloadSecretaryNetworkPdf(); return; }
                const schoolRow = event.target.closest('[data-secretary-school-id]');
                if (schoolRow && (event.target.closest('[data-secretary-school-open]') || !event.target.closest('button'))) { secretaryNetworkState.selectedSchoolId = schoolRow.dataset.secretarySchoolId; renderSecretaryNetworkSchools(); setSecretaryNetworkSection('schools'); return; }
                const card = event.target.closest('[data-secretary-request-id]');
                if (card && event.target.closest('[data-secretary-select-request]')) { secretaryNetworkState.selectedRequestId = card.dataset.secretaryRequestId; secretaryState.selectedRequestId = secretaryNetworkState.selectedRequestId; renderSecretaryStaffDetail(); secretaryView?.querySelector('[data-secretary-detail]')?.scrollIntoView({behavior:'smooth',block:'start'}); return; }
                if (event.target.closest('[data-secretary-save-detail]')) { saveSecretaryStaffDetail(); return; }
                if (event.target.closest('[data-secretary-generate-document]')) { generateSecretaryDocument(); return; }
                const studentRow = event.target.closest('[data-secretary-student-id]');
                if (studentRow) { secretaryNetworkState.selectedStudentId = studentRow.dataset.secretaryStudentId; renderSecretaryNetworkStudents(); return; }
                const documentButton = event.target.closest('[data-secretary-document-path]');
                if (documentButton) { openGrowthDocument(documentButton.dataset.secretaryDocumentPath); return; }
                const result = event.target.closest('[data-secretary-search-action]');
                if (result?.dataset.secretarySearchAction) { setSecretaryNetworkSection(result.dataset.secretarySearchAction); if (result.dataset.secretarySearchId) { secretaryNetworkState.selectedRequestId = result.dataset.secretarySearchId; secretaryState.selectedRequestId = result.dataset.secretarySearchId; renderSecretaryStaffDetail(); } }
              });
            }
            const filter = secretaryView.querySelector('[data-secretary-staff-filter]'); const priority = secretaryView.querySelector('[data-secretary-priority-filter]'); const search = secretaryView.querySelector('[data-secretary-staff-search]'); const schoolSearch = secretaryView.querySelector('[data-secretary-school-search]'); const schoolStatus = secretaryView.querySelector('[data-secretary-school-status]'); const globalSearch = secretaryView.querySelector('[data-secretary-global-search]'); const headerSearch = secretaryView.querySelector('[data-secretary-header-search]'); const studentSearch = secretaryView.querySelector('[data-secretary-student-search]'); const studentClass = secretaryView.querySelector('[data-secretary-student-class]'); const studentStatus = secretaryView.querySelector('[data-secretary-student-status]'); const professionalSearch = secretaryView.querySelector('[data-secretary-professional-search]'); const professionalRole = secretaryView.querySelector('[data-secretary-professional-role]'); const classSearch = secretaryView.querySelector('[data-secretary-class-search]'); const classShift = secretaryView.querySelector('[data-secretary-class-shift]'); const documentSearch = secretaryView.querySelector('[data-secretary-document-search]'); const documentCategory = secretaryView.querySelector('[data-secretary-document-category]');
            if (filter && !filter.dataset.ready) { filter.dataset.ready = 'true'; filter.addEventListener('change', renderSecretaryStaffList); }
            if (priority && !priority.dataset.ready) { priority.dataset.ready = 'true'; priority.addEventListener('change', renderSecretaryStaffList); }
            if (search && !search.dataset.ready) { search.dataset.ready = 'true'; search.addEventListener('input', renderSecretaryStaffList); }
            if (schoolSearch && !schoolSearch.dataset.ready) { schoolSearch.dataset.ready = 'true'; schoolSearch.addEventListener('input', renderSecretaryNetworkSchools); }
            if (schoolStatus && !schoolStatus.dataset.ready) { schoolStatus.dataset.ready = 'true'; schoolStatus.addEventListener('change', renderSecretaryNetworkSchools); }
            if (globalSearch && !globalSearch.dataset.ready) { globalSearch.dataset.ready = 'true'; globalSearch.addEventListener('input', renderSecretaryNetworkSearch); }
            if (headerSearch && !headerSearch.dataset.ready) { headerSearch.dataset.ready = 'true'; headerSearch.addEventListener('keydown', event => { if (event.key !== 'Enter') return; event.preventDefault(); if (globalSearch) { globalSearch.value = headerSearch.value; renderSecretaryNetworkSearch(); } setSecretaryNetworkSection('search'); }); }
            if (studentSearch && !studentSearch.dataset.ready) { studentSearch.dataset.ready = 'true'; studentSearch.addEventListener('input', renderSecretaryNetworkStudents); }
            if (studentClass && !studentClass.dataset.ready) { studentClass.dataset.ready = 'true'; studentClass.addEventListener('change', renderSecretaryNetworkStudents); }
            if (studentStatus && !studentStatus.dataset.ready) { studentStatus.dataset.ready = 'true'; studentStatus.addEventListener('change', renderSecretaryNetworkStudents); }
            if (professionalSearch && !professionalSearch.dataset.ready) { professionalSearch.dataset.ready = 'true'; professionalSearch.addEventListener('input', renderSecretaryNetworkProfessionals); }
            if (professionalRole && !professionalRole.dataset.ready) { professionalRole.dataset.ready = 'true'; professionalRole.addEventListener('change', renderSecretaryNetworkProfessionals); }
            if (classSearch && !classSearch.dataset.ready) { classSearch.dataset.ready = 'true'; classSearch.addEventListener('input', renderSecretaryNetworkClasses); }
            if (classShift && !classShift.dataset.ready) { classShift.dataset.ready = 'true'; classShift.addEventListener('change', renderSecretaryNetworkClasses); }
            if (documentSearch && !documentSearch.dataset.ready) { documentSearch.dataset.ready = 'true'; documentSearch.addEventListener('input', renderSecretaryNetworkDocuments); }
            if (documentCategory && !documentCategory.dataset.ready) { documentCategory.dataset.ready = 'true'; documentCategory.addEventListener('change', renderSecretaryNetworkDocuments); }
            const messageForm = secretaryView.querySelector('[data-secretary-staff-message-form]');
            if (messageForm && !messageForm.dataset.ready) { messageForm.dataset.ready = 'true'; messageForm.addEventListener('submit', async event => { event.preventDefault(); const request = secretaryNetworkState.requests.find(item => item.id === secretaryNetworkState.selectedRequestId); const status = messageForm.querySelector('[data-secretary-staff-message-status]'); const body = messageForm.body.value.trim(); if (!request || !body) { status.textContent = 'Selecione uma solicitação e escreva uma mensagem.'; return; } let result = await supabaseClient.from('secretary_request_messages').insert({ request_id:request.id, sender_id:currentUser.id, recipient_id:request.requester_id, body }); if (result.error) { result = request.student_id ? await supabaseClient.from('student_messages').insert({ student_id:request.student_id, sender_id:currentUser.id, recipient_id:request.requester_id, category:'general', body }) : result; } status.textContent = result.error ? 'Não foi possível enviar.' : 'Mensagem enviada ao responsável.'; if (!result.error) { messageForm.reset(); await loadSecretaryStaff(true); } }); }
            setSecretaryNetworkSection(secretaryNetworkState.selectedSection); loadSecretaryStaff();
          }
          function secretaryStaffMarkup() { return `<div class="secretary-workspace"><aside class="secretary-sidebar" data-secretary-sidebar><div class="secretary-sidebar-head"><span class="secretary-sidebar-mark">▥</span><div><strong>Secretaria de Educação</strong><span>Centro de gestão</span></div></div><div class="secretary-sidebar-group"><span class="secretary-sidebar-label">Início</span><button class="secretary-sidebar-link is-active" type="button" data-secretary-tab="overview">Visão geral <small>⌂</small></button></div><div class="secretary-sidebar-group"><span class="secretary-sidebar-label">Gestão da rede</span><button class="secretary-sidebar-link" type="button" data-secretary-tab="schools">Escolas <small>01</small></button><button class="secretary-sidebar-link" type="button" data-secretary-tab="students">Alunos</button><button class="secretary-sidebar-link" type="button" data-secretary-tab="professionals">Profissionais</button><button class="secretary-sidebar-link" type="button" data-secretary-tab="classes">Turmas</button><button class="secretary-sidebar-link" type="button" data-secretary-tab="enrollments">Matrículas</button></div><div class="secretary-sidebar-group"><span class="secretary-sidebar-label">Comunicação</span><button class="secretary-sidebar-link" type="button" data-secretary-tab="communications">Comunicados</button><button class="secretary-sidebar-link" type="button" data-secretary-tab="calendar">Agenda institucional</button><button class="secretary-sidebar-link" type="button" data-secretary-tab="notifications">Notificações <small data-secretary-side-notification-count>—</small></button></div><div class="secretary-sidebar-group"><span class="secretary-sidebar-label">Dados e acompanhamento</span><button class="secretary-sidebar-link" type="button" data-secretary-tab="indicators">Indicadores</button><button class="secretary-sidebar-link" type="button" data-secretary-tab="reports">Relatórios</button></div><div class="secretary-sidebar-group"><span class="secretary-sidebar-label">Documentos</span><button class="secretary-sidebar-link" type="button" data-secretary-tab="documents">Documentos</button></div><div class="secretary-sidebar-group"><span class="secretary-sidebar-label">Administração</span><button class="secretary-sidebar-link is-locked" type="button" data-secretary-tab="administration" disabled>Usuários e permissões <small>restrito</small></button><button class="secretary-sidebar-link is-locked" type="button" disabled>Configurações <small>restrito</small></button></div></aside><main class="secretary-module-main"><header class="secretary-hero secretary-network-hero secretary-module-header"><div><div class="eyebrow">Secretaria de Educação · BFR Conecta</div><h1>Centro de Gestão da Educação.</h1><p>Controle administrativo, acompanhamento da rede, comunicação institucional e documentos em um só lugar.</p></div><div class="secretary-module-actions"><button class="secretary-sidebar-toggle" type="button" data-secretary-mobile-menu>☰ Menu</button><label class="secretary-header-search"><span>⌕</span><input type="search" data-secretary-header-search placeholder="Buscar na Secretaria" aria-label="Buscar na Secretaria"></label><button class="text-button" type="button" data-secretary-tab="notifications">Notificações <span data-secretary-notification-count>—</span></button><button class="primary-button" type="button" data-secretary-refresh>Atualizar</button></div></header><p class="secretary-network-status" data-secretary-network-status>Carregando dados sincronizados...</p><section class="secretary-network-screen" data-secretary-screen="overview"><div class="secretary-network-card-grid"><article class="secretary-network-card"><span>Escolas</span><strong data-secretary-network-metric="schools">—</strong><small>Unidades cadastradas no escopo atual.</small></article><article class="secretary-network-card"><span>Alunos</span><strong data-secretary-network-metric="students">—</strong><small>Alunos ativos no cadastro oficial.</small></article><article class="secretary-network-card"><span>Profissionais</span><strong data-secretary-network-metric="staff">—</strong><small>Diretório e perfis localizados.</small></article><article class="secretary-network-card"><span>Turmas</span><strong data-secretary-network-metric="classes">—</strong><small>Turmas do ano letivo atual.</small></article><article class="secretary-network-card"><span>Matrículas</span><strong data-secretary-network-metric="enrollments">—</strong><small>Representadas pelos alunos ativos.</small></article><article class="secretary-network-card is-neutral"><span>Pendências</span><strong data-secretary-network-metric="pending">—</strong><small>Solicitações que precisam de atenção.</small></article></div><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Acesso rápido</div><h2>Principais funções</h2><p>Atalhos para as rotinas administrativas mais utilizadas.</p></div></div><div class="secretary-quick-grid"><button class="secretary-quick-link" type="button" data-secretary-tab="schools"><strong>Escolas</strong><span>Pesquisar unidades e consultar detalhes.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="students"><strong>Alunos</strong><span>Consultar cadastro, turma e situação.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="professionals"><strong>Profissionais</strong><span>Ver equipe e categorias cadastradas.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="classes"><strong>Turmas</strong><span>Consultar ano, turno e composição.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="enrollments"><strong>Matrículas</strong><span>Acompanhar a base ativa.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="communications"><strong>Comunicados</strong><span>Consultar comunicação institucional.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="reports"><strong>Relatórios</strong><span>Exportar um resumo operacional.</span></button><button class="secretary-quick-link" type="button" data-secretary-tab="documents"><strong>Documentos</strong><span>Pesquisar arquivos publicados.</span></button></div></section><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Atenção necessária</div><h2>Prioridades da Secretaria</h2><p>Somente situações calculadas a partir de status e prazos reais.</p></div><button class="text-button" type="button" data-secretary-tab="requests">Abrir fila →</button></div><div class="secretary-network-list" data-secretary-overview-alert-list><div class="secretary-network-empty">Carregando prioridades...</div></div></section><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Registro operacional</div><h2>Atividades recentes</h2><p>Últimas atividades e publicações disponíveis no sistema.</p></div></div><div class="secretary-network-list" data-secretary-overview-activity-list><div class="secretary-network-empty">Carregando atividade da escola...</div></div></section></div><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Participação</div><h2>Participação da rede</h2><p>Sem estrutura de participação publicada no banco atual.</p></div></div><div class="secretary-network-empty"><strong>—</strong><br>A métrica aparecerá aqui quando houver registros por escola.</div></section><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Evolução</div><h2>Série histórica</h2><p>Notas e frequência ainda não possuem lançamentos para comparação.</p></div></div><div class="secretary-network-empty">Nenhuma série histórica disponível.</div></section></div></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="schools"><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Gestão da rede</div><h2>Escolas</h2><p>Consulte a unidade escolar disponível e seus indicadores cadastrados.</p></div><span class="secretary-filter-chip" data-secretary-school-count>— unidade</span></div><div class="secretary-school-toolbar"><input type="search" data-secretary-school-search placeholder="Buscar escola" aria-label="Buscar escola"><select data-secretary-school-status aria-label="Filtrar status da escola"><option value="all">Todos os status</option><option value="active">Ativas</option></select></div><div class="secretary-school-list" data-secretary-school-list><div class="secretary-network-empty">Carregando escolas...</div></div></section><section class="panel secretary-school-detail" data-secretary-school-detail><div class="secretary-network-panel-head"><div><div class="eyebrow">Detalhe da escola</div><h2 data-secretary-school-detail-title>Selecione uma escola</h2><p data-secretary-school-detail-subtitle>Os detalhes aparecerão após a sincronização.</p></div><span class="secretary-status is-ready" data-secretary-school-detail-status>—</span></div><dl><dt>Direção</dt><dd data-secretary-school-detail-director>—</dd><dt>Alunos</dt><dd data-secretary-school-detail-students>—</dd><dt>Turmas</dt><dd data-secretary-school-detail-classes>—</dd><dt>Professores</dt><dd data-secretary-school-detail-teachers>—</dd><dt>Atividades</dt><dd data-secretary-school-detail-activities>—</dd><dt>Última atividade</dt><dd data-secretary-school-detail-last-activity>—</dd></dl><div class="secretary-network-empty">O banco atual não possui cadastro municipal de unidades nem vínculo de direção por escola.</div></section></div></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="students"><div class="secretary-entity-layout"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Gestão da rede</div><h2>Alunos</h2><p>Consulta administrativa sem exibir informações sensíveis desnecessárias.</p></div></div><div class="secretary-school-toolbar"><input type="search" data-secretary-student-search placeholder="Buscar aluno pelo nome" aria-label="Buscar aluno"><select data-secretary-student-class aria-label="Filtrar aluno por turma"><option value="all">Todas as turmas</option></select><select data-secretary-student-status aria-label="Filtrar aluno por situação"><option value="active">Ativos</option><option value="all">Todos</option></select></div><div class="secretary-entity-list" data-secretary-student-list><div class="secretary-network-empty">Carregando alunos...</div></div></section><section class="panel secretary-entity-detail" data-secretary-student-detail><div class="secretary-network-panel-head"><div><div class="eyebrow">Ficha administrativa</div><h2 data-secretary-student-detail-title>Selecione um aluno</h2><p>Dados essenciais para consulta da Secretaria.</p></div></div><dl><dt>Escola</dt><dd>Escola Benício Ferreira Reis</dd><dt>Turma</dt><dd data-secretary-student-detail-class>—</dd><dt>Situação</dt><dd data-secretary-student-detail-status>—</dd><dt>ID interno</dt><dd data-secretary-student-detail-id>—</dd></dl><div class="secretary-network-empty">Notas, frequência, endereço e contatos permanecem fora desta ficha quando não houver permissão ou dado disponível.</div></section></div></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="professionals"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Gestão da rede</div><h2>Profissionais</h2><p>Equipe escolar organizada por categoria, sem expor dados pessoais além do necessário.</p></div><span class="secretary-filter-chip" data-secretary-professional-count>— registros</span></div><div class="secretary-school-toolbar"><input type="search" data-secretary-professional-search placeholder="Buscar profissional" aria-label="Buscar profissional"><select data-secretary-professional-role aria-label="Filtrar categoria profissional"><option value="all">Todas as categorias</option><option value="director">Direção</option><option value="coordinator">Coordenação</option><option value="secretary">Secretaria</option><option value="pedagogical">Pedagógico</option><option value="aee">AEE</option><option value="monitor">Monitor</option><option value="gatekeeper">Portaria</option></select></div><div class="secretary-data-table-wrap"><table class="secretary-data-table"><thead><tr><th>Profissional</th><th>Categoria</th><th>Contato institucional</th><th>Origem</th></tr></thead><tbody data-secretary-professional-list><tr><td colspan="4"><div class="secretary-network-empty">Carregando profissionais...</div></td></tr></tbody></table></div><p class="field-hint" style="margin-top:10px">O diretório de professores informa a quantidade disponível, mas não está associado a nomes e escola nesta consulta.</p></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="classes"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Gestão da rede</div><h2>Turmas</h2><p>Consulte escola, ano, turno e quantidade de alunos por turma.</p></div><span class="secretary-filter-chip" data-secretary-class-count>— turmas</span></div><div class="secretary-school-toolbar"><input type="search" data-secretary-class-search placeholder="Buscar turma" aria-label="Buscar turma"><select data-secretary-class-shift aria-label="Filtrar turno"><option value="all">Todos os turnos</option><option value="morning">Matutino</option><option value="afternoon">Vespertino</option></select></div><div class="secretary-data-table-wrap"><table class="secretary-data-table"><thead><tr><th>Turma</th><th>Ano</th><th>Turno</th><th>Alunos</th><th>Professor responsável</th></tr></thead><tbody data-secretary-class-list><tr><td colspan="5"><div class="secretary-network-empty">Carregando turmas...</div></td></tr></tbody></table></div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="enrollments"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Gestão da rede</div><h2>Matrículas</h2><p>A base atual usa students.active como representação de matrícula ativa; não há tabela separada de matrículas disponível.</p></div></div><div class="secretary-network-card-grid"><article class="secretary-network-card"><span>Matrículas ativas</span><strong data-secretary-enrollment-metric="active">—</strong><small>Alunos com cadastro ativo.</small></article><article class="secretary-network-card is-neutral"><span>Inativas</span><strong>—</strong><small>Histórico de matrícula não disponível.</small></article><article class="secretary-network-card is-neutral"><span>Transferências</span><strong>—</strong><small>Fluxo específico não disponível.</small></article><article class="secretary-network-card is-neutral"><span>Por escola</span><strong>—</strong><small>Cadastro municipal de unidades pendente.</small></article></div><div class="secretary-network-empty" style="margin-top:15px">Quando a estrutura de matrículas for disponibilizada, esta área poderá receber filtros por escola, ano, situação e período letivo sem alterar a navegação atual.</div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="requests"><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Atendimento por protocolo</div><h2>Solicitações</h2><p>Fila única com status, prioridade calculada e prazo real quando preenchido.</p></div><span class="agenda-count" data-secretary-staff-updated>sincronizando</span></div><div class="secretary-request-toolbar"><select data-secretary-staff-filter aria-label="Filtrar solicitações"><option value="all">Todos os status</option><option value="pending">Pendentes</option><option value="reviewing">Em análise</option><option value="approved">Aprovadas / prontas</option><option value="closed">Concluídas</option></select><select data-secretary-priority-filter aria-label="Filtrar prioridade"><option value="all">Todas as prioridades</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option></select><input type="search" data-secretary-staff-search placeholder="Buscar protocolo, aluno ou solicitante" aria-label="Buscar solicitação"></div><div class="secretary-list" data-secretary-staff-list><div class="secretary-network-empty">Carregando solicitações...</div></div></section><section class="panel secretary-detail" data-secretary-detail><div class="secretary-network-panel-head"><div><div class="eyebrow">Protocolo selecionado</div><h2 data-secretary-detail-title>Selecione uma solicitação</h2><p>Abra um protocolo para consultar o histórico e atuar no atendimento.</p></div><span class="secretary-status" data-secretary-detail-badge>—</span></div><div data-secretary-detail-empty class="secretary-network-empty">Nenhum protocolo selecionado.</div><div data-secretary-detail-content class="hidden"><dl><dt>Aluno</dt><dd data-secretary-detail-student>—</dd><dt>Responsável</dt><dd data-secretary-detail-requester>—</dd><dt>Turma</dt><dd data-secretary-detail-class>—</dd><dt>Finalidade</dt><dd data-secretary-detail-purpose>—</dd><dt>Aberto em</dt><dd data-secretary-detail-date>—</dd><dt>Prazo</dt><dd data-secretary-detail-deadline>—</dd></dl><label class="secretary-form" style="margin-top:0">Status<select data-secretary-detail-status><option value="received">Recebida</option><option value="reviewing">Em análise</option><option value="waiting_information">Aguardando informação</option><option value="preparing">Documento em preparação</option><option value="ready">Pronta para baixar</option><option value="closed">Concluída</option><option value="cancelled">Cancelada</option></select></label><label class="secretary-form">Nota interna<textarea data-secretary-detail-note maxlength="1000" placeholder="Registre uma orientação ou observação do atendimento."></textarea></label><label class="secretary-form">Anexar documento<input type="file" data-secretary-detail-file accept="application/pdf,image/*"></label><div class="secretary-staff-actions"><button class="primary-button" type="button" data-secretary-save-detail>Salvar atendimento</button><button class="text-button" type="button" data-secretary-generate-document>Gerar PDF padrão</button></div><div class="secretary-timeline" data-secretary-detail-timeline></div><form class="secretary-form" data-secretary-staff-message-form><label>Mensagem ao responsável<textarea name="body" maxlength="1000" placeholder="Escreva uma orientação objetiva."></textarea></label><button class="text-button" type="submit">Enviar mensagem</button><p class="publish-status" data-secretary-staff-message-status></p></form></div></section></div></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="communications"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Comunicação institucional</div><h2>Comunicados</h2><p>Consulte os comunicados publicados para a comunidade escolar. A publicação só aparece quando a policy do backend autoriza.</p></div><span class="agenda-count" data-secretary-communication-count>—</span></div><div class="secretary-network-list" data-secretary-communications-list><div class="secretary-network-empty">Carregando comunicados...</div></div><div class="secretary-network-locked" style="margin-top:14px">A publicação de comunicados permanece restrita à permissão de publicação existente.</div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="calendar"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Comunicação institucional</div><h2>Agenda institucional</h2><p>Eventos futuros publicados pela escola, sem misturar agenda institucional e atividades pedagógicas.</p></div></div><div class="secretary-network-list" data-secretary-calendar-list><div class="secretary-network-empty">Carregando agenda...</div></div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="notifications"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Centro de notificações</div><h2>Alertas e avisos</h2><p>Itens derivados de solicitações prioritárias, comunicados e eventos sincronizados.</p></div><span class="agenda-count" data-secretary-notification-count>—</span></div><div class="secretary-network-list" data-secretary-notifications-list><div class="secretary-network-empty">Carregando notificações...</div></div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="indicators"><div class="secretary-network-grid"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Dados e acompanhamento</div><h2>Indicadores da rede</h2><p>Resumo visual calculado apenas com os dados consultados nesta sessão.</p></div></div><div class="secretary-indicator-list" data-secretary-indicator-list><div class="secretary-network-empty">Carregando indicadores...</div></div></section><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Disponibilidade</div><h2>O que já está conectado</h2></div></div><div class="secretary-network-list"><div class="secretary-network-list-item"><div><strong>Alunos e turmas</strong><span>Cadastro ativo e composição por turma.</span></div><span class="secretary-status is-ready">disponível</span></div><div class="secretary-network-list-item"><div><strong>Profissionais</strong><span>Perfis e contagem do diretório docente.</span></div><span class="secretary-status is-ready">disponível</span></div><div class="secretary-network-list-item"><div><strong>Frequência e notas</strong><span>Nenhum lançamento retornado na auditoria atual.</span></div><span class="secretary-status is-warning">sem dados</span></div><div class="secretary-network-list-item"><div><strong>Cadastro de escolas</strong><span>Uma unidade no escopo atual; tabela municipal ainda não existe.</span></div><span class="secretary-status is-warning">parcial</span></div></div></section></div></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="reports"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Dados e acompanhamento</div><h2>Relatórios</h2><p>Exporte somente os registros carregados. PDF e CSV ficam disponíveis para rotinas que já têm dados.</p></div></div><div class="secretary-network-card-grid"><article class="secretary-network-card"><span>Base de alunos</span><strong data-secretary-report-metric="students">—</strong><small>Alunos ativos na lista oficial.</small></article><article class="secretary-network-card"><span>Solicitações</span><strong data-secretary-report-metric="requests">—</strong><small>Protocolos encontrados.</small></article><article class="secretary-network-card is-neutral"><span>Notas lançadas</span><strong>—</strong><small>Nenhum lançamento disponível.</small></article><article class="secretary-network-card is-neutral"><span>Frequência</span><strong>—</strong><small>Nenhum registro disponível.</small></article></div><div class="secretary-report-actions"><button class="primary-button" type="button" data-secretary-export-csv>Baixar base CSV</button><button class="text-button" type="button" data-secretary-export-pdf>Baixar resumo PDF</button></div><p class="publish-status" data-secretary-report-status></p></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="documents"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Documentos</div><h2>Documentos institucionais</h2><p>Arquivos publicados e documentos associados a protocolos, com busca por título e categoria.</p></div><span class="agenda-count" data-secretary-document-count>—</span></div><div class="secretary-school-toolbar"><input type="search" data-secretary-document-search placeholder="Buscar documento" aria-label="Buscar documento"><select data-secretary-document-category aria-label="Filtrar categoria"><option value="all">Todas as categorias</option></select></div><div class="secretary-list" data-secretary-document-list><div class="secretary-network-empty">Carregando documentos...</div></div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="administration"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Administração do sistema</div><h2>Usuários, permissões e configurações</h2><p>Área separada para perfis autorizados a administrar o sistema.</p></div><span class="secretary-status is-warning">restrito</span></div><div class="secretary-network-locked"><strong>Permissão não disponível para este perfil.</strong><br>A gestão de usuários, perfis, permissões e configurações permanece na área Administração, sem criar uma segunda rotina dentro da Secretaria.</div><div class="secretary-network-list" style="margin-top:14px"><div class="secretary-network-list-item"><div><strong>Usuários</strong><span>Gerenciamento de contas e aprovação de acesso.</span></div><span class="secretary-status">restrito</span></div><div class="secretary-network-list-item"><div><strong>Permissões</strong><span>Definição de papéis e escopos de acesso.</span></div><span class="secretary-status">restrito</span></div><div class="secretary-network-list-item"><div><strong>Configurações</strong><span>Parâmetros gerais e integrações do sistema.</span></div><span class="secretary-status">restrito</span></div></div></section></section>
          <section class="secretary-network-screen hidden" data-secretary-screen="search"><section class="panel"><div class="secretary-network-panel-head"><div><div class="eyebrow">Pesquisa rápida</div><h2>Busca global</h2><p>Pesquise nos dados carregados de escolas, alunos, profissionais, turmas, documentos, comunicados e protocolos.</p></div></div><input class="global-search-input" type="search" data-secretary-global-search placeholder="Digite nome, protocolo, turma ou título" aria-label="Busca global da Secretaria"><div class="secretary-network-search-results" data-secretary-global-results><div class="secretary-network-empty">Digite algo para iniciar a busca.</div></div></section></section>`; }
          function secretaryNetworkRoleLabel(role) { return { director:'Direção', coordinator:'Coordenação', secretary:'Secretaria', pedagogical:'Equipe pedagógica', aee:'AEE', monitor:'Monitoria', gatekeeper:'Portaria', developer:'Administração' }[role] || 'Equipe escolar'; }
          function secretaryNetworkInitials(name) { return String(name || '—').split(/\s+/).filter(Boolean).map(item => item[0]).slice(0,2).join('').toUpperCase(); }
          function secretaryNetworkClassRows() {
            const search = String(secretaryView?.querySelector('[data-secretary-class-search]')?.value || '').toLocaleLowerCase('pt-BR').trim();
            const shift = secretaryView?.querySelector('[data-secretary-class-shift]')?.value || 'all';
            return secretaryNetworkState.classes.filter(item => { const label = secretaryNetworkClassLabel(item).toLocaleLowerCase('pt-BR'); return (!search || label.includes(search)) && (shift === 'all' || item.shift === shift); });
          }
          function renderSecretaryNetworkStudents() {
            const list = secretaryView?.querySelector('[data-secretary-student-list]');
            if (!list) return;
            const classSelect = secretaryView.querySelector('[data-secretary-student-class]');
            if (classSelect && classSelect.options.length === 1) classSelect.insertAdjacentHTML('beforeend', secretaryNetworkState.classes.map(item => `<option value="${escapeHtml(item.id)}">${escapeHtml(secretaryNetworkClassLabel(item))}</option>`).join(''));
            const query = String(secretaryView.querySelector('[data-secretary-student-search]')?.value || '').toLocaleLowerCase('pt-BR').trim();
            const classId = classSelect?.value || 'all'; const status = secretaryView.querySelector('[data-secretary-student-status]')?.value || 'active';
            const rows = secretaryNetworkState.students.filter(item => (!query || String(item.official_name || '').toLocaleLowerCase('pt-BR').includes(query)) && (classId === 'all' || item.class_id === classId) && (status === 'all' || item.active));
            list.innerHTML = rows.length ? rows.map(item => { const selected = item.id === secretaryNetworkState.selectedStudentId; const classData = secretaryNetworkState.classes.find(row => row.id === item.class_id); return `<button class="secretary-entity-row ${selected ? 'is-selected' : ''}" type="button" data-secretary-student-id="${escapeHtml(item.id)}"><span class="secretary-entity-avatar">${escapeHtml(secretaryNetworkInitials(item.official_name))}</span><span><strong>${escapeHtml(item.official_name || 'Aluno sem nome')}</strong><span>${escapeHtml(secretaryNetworkClassLabel(classData))}</span></span><span class="secretary-status is-ready">${item.active ? 'ativo' : 'inativo'}</span></button>`; }).join('') : '<div class="secretary-network-empty">Nenhum aluno corresponde aos filtros atuais.</div>';
            const selected = secretaryNetworkState.students.find(item => item.id === secretaryNetworkState.selectedStudentId) || rows[0];
            if (selected && !secretaryNetworkState.selectedStudentId) secretaryNetworkState.selectedStudentId = selected.id;
            const detail = secretaryView.querySelector('[data-secretary-student-detail]');
            if (detail && selected) { const classData = secretaryNetworkState.classes.find(item => item.id === selected.class_id); detail.querySelector('[data-secretary-student-detail-title]').textContent = selected.official_name || 'Aluno sem nome'; detail.querySelector('[data-secretary-student-detail-class]').textContent = secretaryNetworkClassLabel(classData); detail.querySelector('[data-secretary-student-detail-status]').textContent = selected.active ? 'Matrícula ativa' : 'Inativo'; detail.querySelector('[data-secretary-student-detail-id]').textContent = selected.id || '—'; }
          }
          function renderSecretaryNetworkProfessionals() {
            const list = secretaryView?.querySelector('[data-secretary-professional-list]');
            if (!list) return;
            const query = String(secretaryView.querySelector('[data-secretary-professional-search]')?.value || '').toLocaleLowerCase('pt-BR').trim(); const roleFilter = secretaryView.querySelector('[data-secretary-professional-role]')?.value || 'all';
            const roles = ['director','coordinator','secretary','pedagogical','aee','monitor','gatekeeper','developer'];
            const people = secretaryNetworkState.profiles.filter(item => roles.includes(item.role) && (roleFilter === 'all' || item.role === roleFilter) && (!query || [item.full_name,item.role].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)));
            const directory = secretaryNetworkState.teachers.length && (roleFilter === 'all' || roleFilter === 'pedagogical') && (!query || 'professores diretório'.includes(query)) ? `<tr><td><strong>Professores do diretório</strong><small>${secretaryNetworkState.teachers.length} registros sem perfil nominal</small></td><td>Professores</td><td>—</td><td>BFR teacher directory</td></tr>` : '';
             const peopleMarkup = people.map(item => `<tr><td><strong>${escapeHtml(item.full_name || 'Nome não informado')}</strong><small>Perfil autorizado</small></td><td>${escapeHtml(secretaryNetworkRoleLabel(item.role))}</td><td>${escapeHtml(item.email || 'Contato não exibido')}</td><td>Perfis</td></tr>`).join('');
             list.innerHTML = people.length || directory ? directory + peopleMarkup : '<tr><td colspan="4"><div class="secretary-network-empty">Nenhum profissional corresponde aos filtros atuais.</div></td></tr>';
            secretaryView.querySelector('[data-secretary-professional-count]')?.replaceChildren(document.createTextNode(`${people.length + (directory ? 1 : 0)} registros`));
          }
          function renderSecretaryNetworkClasses() {
            const list = secretaryView?.querySelector('[data-secretary-class-list]');
            if (!list) return;
            const rows = secretaryNetworkClassRows();
            list.innerHTML = rows.length ? rows.map(item => { const count = secretaryNetworkState.students.filter(student => student.class_id === item.id).length; const shiftLabel = item.shift === 'afternoon' ? 'Vespertino' : item.shift === 'morning' ? 'Matutino' : 'Não informado'; return `<tr><td><strong>${escapeHtml(secretaryNetworkClassLabel(item))}</strong><small>Escola Benício Ferreira Reis</small></td><td>${escapeHtml(String(item.year || '—'))}º ano</td><td>${shiftLabel}</td><td>${count}</td><td>Não informado</td></tr>`; }).join('') : '<tr><td colspan="5"><div class="secretary-network-empty">Nenhuma turma corresponde aos filtros atuais.</div></td></tr>';
            secretaryView.querySelector('[data-secretary-class-count]')?.replaceChildren(document.createTextNode(`${rows.length} turma${rows.length === 1 ? '' : 's'}`));
          }
          function renderSecretaryNetworkDocuments() {
            const list = secretaryView?.querySelector('[data-secretary-document-list]');
            if (!list) return;
            const query = String(secretaryView.querySelector('[data-secretary-document-search]')?.value || '').toLocaleLowerCase('pt-BR').trim(); const category = secretaryView.querySelector('[data-secretary-document-category]')?.value || 'all';
            const categories = [...new Set(secretaryNetworkState.documents.map(item => item.category).filter(Boolean))]; const categorySelect = secretaryView.querySelector('[data-secretary-document-category]');
            if (categorySelect && categorySelect.options.length === 1) categorySelect.insertAdjacentHTML('beforeend', categories.map(item => `<option value="${escapeHtml(item)}">${escapeHtml(item)}</option>`).join(''));
            const rows = secretaryNetworkState.documents.filter(item => (!query || [item.title,item.description,item.category].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)) && (category === 'all' || item.category === category));
            list.innerHTML = rows.length ? rows.map(item => `<article class="secretary-document-card"><strong>▤ ${escapeHtml(item.title || 'Documento sem título')}</strong><span>${escapeHtml(item.category || 'Documento institucional')} · ${secretaryDate(item.created_at)}</span><p>${escapeHtml(item.description || 'Sem descrição adicional.')}</p>${item.storage_path ? `<button class="text-button" type="button" data-secretary-document-path="${escapeHtml(item.storage_path)}">Abrir documento →</button>` : '<span>Arquivo não associado</span>'}</article>`).join('') : '<div class="secretary-network-empty">Nenhum documento corresponde aos filtros atuais.</div>';
            secretaryView.querySelector('[data-secretary-document-count]')?.replaceChildren(document.createTextNode(`${rows.length} documento${rows.length === 1 ? '' : 's'}`));
          }
          function renderSecretaryNetworkIndicators() {
            const host = secretaryView?.querySelector('[data-secretary-indicator-list]');
            if (!host) return;
            const values = [{label:'Alunos ativos',value:secretaryNetworkState.students.length,source:'students.active'},{label:'Turmas',value:secretaryNetworkState.classes.length,source:'classes'},{label:'Professores no diretório',value:secretaryNetworkState.teachers.length,source:'bfr_teacher_directory'},{label:'Solicitações abertas',value:secretaryNetworkState.requests.filter(item => !['closed','cancelled'].includes(item.status)).length,source:'secretary_requests'},{label:'Notas lançadas',value:secretaryNetworkState.grades.length,source:'grades'},{label:'Registros de frequência',value:secretaryNetworkState.attendance.length,source:'attendance'}];
            const max = Math.max(...values.map(item => item.value),1); host.innerHTML = values.map(item => `<div class="secretary-indicator-row"><div><strong>${item.label}</strong><span>Fonte: ${item.source}</span></div><div class="secretary-indicator-bar" style="--indicator-width:${item.value ? Math.max(4,(item.value / max) * 100) : 0}%"><i></i></div><b class="secretary-indicator-value">${item.value || '—'}</b></div>`).join('');
          }
          function renderSecretaryNetworkCommunications() {
            const communications = secretaryView?.querySelector('[data-secretary-communications-list]');
            if (communications) communications.innerHTML = secretaryNetworkState.announcements.length ? secretaryNetworkState.announcements.map(item => `<article class="secretary-request-card"><div class="secretary-request-top"><strong>${escapeHtml(item.title || 'Comunicado')}</strong><small>${secretaryDate(item.published_at,true)}</small></div><p>${escapeHtml(item.body || 'Sem mensagem publicada.')}</p>${item.important ? '<span class="secretary-priority is-high">importante</span>' : ''}</article>`).join('') : '<div class="secretary-network-empty">Nenhum comunicado publicado.</div>';
            secretaryView?.querySelector('[data-secretary-communication-count]')?.replaceChildren(document.createTextNode(String(secretaryNetworkState.announcements.length)));
            const calendar = secretaryView?.querySelector('[data-secretary-calendar-list]');
            if (calendar) calendar.innerHTML = secretaryNetworkState.events.length ? secretaryNetworkState.events.map(item => `<article class="secretary-request-card"><div class="secretary-request-top"><strong>${escapeHtml(item.title || 'Evento')}</strong><small>${secretaryDate(item.starts_at,true)}</small></div><p>${escapeHtml(item.description || 'Evento institucional')}${item.location ? ` · ${escapeHtml(item.location)}` : ''}</p></article>`).join('') : '<div class="secretary-network-empty">Nenhum evento futuro publicado.</div>';
          }
          function renderSecretaryNetworkOverview() {
            const school = secretaryNetworkSchool(); const staff = school.teachers + secretaryNetworkState.profiles.filter(item => ['director','coordinator','secretary','pedagogical','aee','monitor','gatekeeper','developer'].includes(item.role)).length; const pending = secretaryNetworkState.requests.filter(item => !['closed','cancelled'].includes(item.status)).length;
            const values = { schools:secretaryNetworkSchools().length, students:school.students, staff, classes:school.classes, enrollments:school.students, pending };
            secretaryView?.querySelectorAll('[data-secretary-network-metric]').forEach(item => { item.textContent = String(values[item.dataset.secretaryNetworkMetric] ?? '—'); });
            secretaryView?.querySelector('[data-secretary-enrollment-metric="active"]')?.replaceChildren(document.createTextNode(String(values.enrollments)));
            secretaryView?.querySelector('[data-secretary-overview-activity-list]')?.replaceChildren(...(secretaryNetworkState.activities.length || secretaryNetworkState.announcements.length ? [...secretaryNetworkState.activities.slice(0,3).map(item => ({title:item.title || 'Atividade escolar',meta:`Atividade · ${item.subject || 'componente não informado'}`,date:item.published_at})), ...secretaryNetworkState.announcements.slice(0,3).map(item => ({title:item.title || 'Comunicado',meta:'Comunicado institucional',date:item.published_at}))].slice(0,5).map(item => { const host=document.createElement('div'); host.className='secretary-network-list-item'; host.innerHTML=`<div><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.meta)} · ${secretaryDate(item.date)}</span></div><span class="secretary-status is-ready">registrado</span>`; return host; }) : [Object.assign(document.createElement('div'),{className:'secretary-network-empty',textContent:'Nenhuma atividade recente registrada.'})]));
            const alerts = secretaryNetworkState.requests.filter(item => secretaryNetworkPriority(item).key === 'high' && !['closed','cancelled'].includes(item.status)).slice(0,5); const alertList = secretaryView?.querySelector('[data-secretary-overview-alert-list]');
            if (alertList) alertList.innerHTML = alerts.length ? alerts.map(item => `<div class="secretary-network-list-item"><div><strong>${escapeHtml(item.request_type || 'Solicitação')}</strong><span>${escapeHtml(secretaryProtocol(item))} · ${escapeHtml(secretaryStudentName(item))}</span></div><span class="secretary-priority is-high">alta</span></div>`).join('') : '<div class="secretary-network-empty"><strong>Tudo em ordem</strong><br>Nenhuma pendência prioritária foi encontrada.</div>';
            secretaryView?.querySelector('[data-secretary-report-metric="students"]')?.replaceChildren(document.createTextNode(String(values.students))); secretaryView?.querySelector('[data-secretary-report-metric="requests"]')?.replaceChildren(document.createTextNode(String(secretaryNetworkState.requests.length)));
          }
          function renderSecretaryNetworkSearch() {
            const query = String(secretaryView?.querySelector('[data-secretary-global-search]')?.value || '').toLocaleLowerCase('pt-BR').trim(); const host = secretaryView?.querySelector('[data-secretary-global-results]'); if (!host) return;
            if (!query) { host.innerHTML = '<div class="secretary-network-empty">Digite algo para iniciar a busca.</div>'; return; }
            const results = []; const school = secretaryNetworkSchool(); if (school.name.toLocaleLowerCase('pt-BR').includes(query)) results.push({title:school.name,meta:'Escola · unidade atual',action:'schools'});
            secretaryNetworkState.students.forEach(item => { if (String(item.official_name || '').toLocaleLowerCase('pt-BR').includes(query)) results.push({title:item.official_name,meta:`Aluno · ${secretaryNetworkClassLabel(secretaryNetworkState.classes.find(row => row.id === item.class_id))}`,action:'students',id:item.id}); });
            secretaryNetworkState.profiles.filter(item => ['director','coordinator','secretary','pedagogical','aee','monitor','gatekeeper','developer'].includes(item.role)).forEach(item => { if ([item.full_name,item.email,item.role].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)) results.push({title:item.full_name || 'Profissional',meta:`Profissional · ${secretaryNetworkRoleLabel(item.role)}`,action:'professionals'}); });
            secretaryNetworkState.classes.forEach(item => { if (`${item.year} ${item.class_code}`.toLocaleLowerCase('pt-BR').includes(query)) results.push({title:secretaryNetworkClassLabel(item),meta:'Turma cadastrada',action:'classes'}); });
            secretaryNetworkState.requests.forEach(item => { const haystack=[secretaryProtocol(item),item.request_type,item.description,secretaryStudentName(item)].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR'); if(haystack.includes(query))results.push({title:secretaryProtocol(item),meta:`Solicitação · ${secretaryStatusLabel(item.status)}`,action:'requests',id:item.id}); });
            secretaryNetworkState.documents.forEach(item => { if ([item.title,item.description,item.category].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)) results.push({title:item.title || 'Documento',meta:`Documento · ${item.category || 'institucional'}`,action:'documents'}); });
            secretaryNetworkState.announcements.forEach(item => { if ([item.title,item.body].filter(Boolean).join(' ').toLocaleLowerCase('pt-BR').includes(query)) results.push({title:item.title,meta:'Comunicado publicado',action:'communications'}); });
            host.innerHTML = results.length ? results.slice(0,30).map(item => `<button class="secretary-network-search-result" type="button" data-secretary-search-action="${item.action || ''}" data-secretary-search-id="${item.id || ''}"><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.meta)}</span></button>`).join('') : '<div class="secretary-network-empty">Nenhum resultado encontrado nos dados carregados.</div>';
          }
          function renderSecretaryNetwork() { renderSecretaryNetworkStatus(secretaryNetworkState.error || (secretaryNetworkState.loaded ? `Atualizado em ${secretaryDate(new Date(),true)} · fonte: Supabase` : 'Carregando dados sincronizados...'), Boolean(secretaryNetworkState.error)); renderSecretaryNetworkOverview(); renderSecretaryNetworkSchools(); renderSecretaryNetworkStudents(); renderSecretaryNetworkProfessionals(); renderSecretaryNetworkClasses(); renderSecretaryStaffList(); renderSecretaryStaffDetail(); renderSecretaryNetworkCommunications(); renderSecretaryNetworkIndicators(); renderSecretaryNetworkDocuments(); renderSecretaryNetworkNotifications(); renderSecretaryNetworkSearch(); }
           const gateState = { records:[], pending:null, scanner:null, scanning:false, processing:false, loaded:false, refreshTimer:null };
        function gateDirectionLabel(direction) { return direction === 'exit' ? 'Saída' : 'Entrada'; }
         function gateRecordView(record) {
           const student = Array.isArray(record.students) ? record.students[0] : record.students;
           const classData = Array.isArray(record.classes) ? record.classes[0] : record.classes;
           return { ...record, studentName:record.official_name || student?.official_name || 'Aluno', classLabel:record.class_label || (classData ? `${classData.year}º ano ${classData.class_code}` : 'Turma não informada'), blocked:record.entry_status === 'blocked' || record.entry_allowed === false };
         }
        function renderGateHistory() {
          document.querySelectorAll('[data-gate-history-list],[data-gate-coordination-list]').forEach(list => {
             list.innerHTML = gateState.records.length ? gateState.records.slice(0,20).map(record => { const item = gateRecordView(record); const date = new Date(item.checked_at); return `<div class="gate-history-item"><span class="gate-history-time">${date.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}</span><div><strong>${escapeHtml(item.studentName)}</strong><span>${escapeHtml(item.classLabel)} · ${date.toLocaleDateString('pt-BR')}${item.restriction_reason ? ` · ${escapeHtml(item.restriction_reason)}` : ''}</span></div><b class="gate-direction-pill ${item.blocked ? 'is-blocked' : ''}">${item.blocked ? 'Bloqueada' : gateDirectionLabel(item.direction)}</b></div>`; }).join('') : '<div class="project-empty">Nenhuma leitura registrada.</div>';
          });
        }
        async function loadGateCheckins(force = false) {
          if (!supabaseClient || !currentUser || (!force && gateState.loaded)) { renderGateHistory(); return; }
           const allowed = ['gatekeeper','pedagogical','coordinator','developer'].includes(currentProfile?.role);
          if (!allowed) return;
           const { data, error } = await supabaseClient.from('gate_checkins').select('id,student_id,direction,checked_at,entry_status,restriction_reason,guardian_present,guardian_confirmed_at,students(official_name),classes(year,class_code)').order('checked_at',{ascending:false}).limit(30);
          gateState.loaded = true;
          gateState.records = error ? [] : data || [];
          renderGateHistory();
        }
          async function loadGateStudentPhoto(path, host) {
            if (!host || !supabaseClient) return;
            let photoPath = path || '';
            if (!photoPath && host.dataset.gateStudentId) {
              const { data } = await supabaseClient.from('student_school_profiles').select('photo_path').eq('student_id',host.dataset.gateStudentId).maybeSingle();
              photoPath = data?.photo_path || '';
            }
            const url = await getStudentPhotoUrl(photoPath);
            if (url) host.innerHTML = `<img class="gate-student-photo" src="${escapeHtml(url)}" alt="Foto para conferência de ${escapeHtml(host.dataset.gateStudentName || 'aluno')}">`;
         }
         function renderGateLastCheckin(item) {
           const box = document.querySelector('[data-gate-last-checkin]');
           if (!box || !item) return;
           const record = gateRecordView(item);
           box.classList.remove('hidden');
            const time = new Date(record.checked_at).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
            box.style.background = record.blocked ? '#fff0eb' : '#eaf6ef';
            box.style.color = record.blocked ? '#a24f3d' : '#35755e';
            if (record.entry_status === 'pending_visual') {
              box.innerHTML = `<div class="gate-photo-wrap" data-gate-photo-wrap data-gate-student-id="${escapeHtml(record.student_id || '')}" data-gate-student-name="${escapeHtml(record.studentName)}">Foto não cadastrada</div><strong>Confira a identidade antes de registrar</strong><br>${escapeHtml(record.studentName)} · ${escapeHtml(record.classLabel)}<br>${gateDirectionLabel(record.direction)} · ${time}<label class="gate-visual-check"><input type="checkbox" data-gate-visual-check> Confirmei visualmente a foto e o nome apresentados.</label><button class="primary-button" type="button" data-confirm-gate-visual disabled style="margin-top:10px">Confirmar conferência</button>`;
              const photoHost = box.querySelector('[data-gate-photo-wrap]');
              if (photoHost) loadGateStudentPhoto(record.photo_path,photoHost);
            } else if (record.blocked) {
               box.innerHTML = `<div class="gate-photo-wrap" data-gate-photo-wrap data-gate-student-id="${escapeHtml(record.student_id || '')}" data-gate-student-name="${escapeHtml(record.studentName)}">Foto não cadastrada</div><strong>Atenção: entrada bloqueada</strong><br>${escapeHtml(record.studentName)} · ${escapeHtml(record.classLabel)}<br>${escapeHtml(record.restriction_reason || 'Responsável obrigatório')}<br>Registrado às ${time}. O monitor foi notificado.${record.guardian_present ? '<br>Responsável confirmado: entrada liberada.' : `<br><button class="text-button" type="button" data-confirm-guardian-entry="${record.checkin_id || record.id}">Confirmar responsável presente</button>`}`;
              const photoHost = box.querySelector('[data-gate-photo-wrap]');
              if (photoHost) loadGateStudentPhoto(record.photo_path,photoHost);
            } else {
               box.innerHTML = `<div class="gate-photo-wrap" data-gate-photo-wrap data-gate-student-id="${escapeHtml(record.student_id || '')}" data-gate-student-name="${escapeHtml(record.studentName)}">Foto não cadastrada</div><strong>Leitura confirmada</strong><br>${escapeHtml(record.studentName)} · ${escapeHtml(record.classLabel)}<br>${gateDirectionLabel(record.direction)} às ${time}`;
              const photoHost = box.querySelector('[data-gate-photo-wrap]');
              if (photoHost) loadGateStudentPhoto(record.photo_path,photoHost);
            }
         }
        async function registerGateCheckin(token, source = 'manual') {
          const status = document.querySelector('[data-gate-scan-status]');
          const direction = document.querySelector('[data-gate-direction]')?.value || 'entry';
          const normalized = String(token || '').trim();
          if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(normalized)) { if (status) status.textContent = 'QR inválido. Leia um crachá emitido pela escola.'; return; }
          if (status) status.textContent = 'Registrando passagem...';
           const { data, error } = await supabaseClient.rpc('register_gate_checkin', { target_badge_token:normalized, gate_direction:direction, visual_confirmation:false });
          if (error) { if (status) status.textContent = error.message.includes('Crachá') ? error.message : 'Não foi possível registrar a passagem.'; return; }
          const item = Array.isArray(data) ? data[0] : data;
          if (!item) { if (status) status.textContent = 'O portão não retornou os dados do aluno.'; return; }
           if (item.entry_status === 'pending_visual') {
             gateState.pending = { ...item, badge_token:normalized, gate_direction:direction };
             renderGateLastCheckin(gateState.pending);
             if (status) status.textContent = `Confira a foto e o nome de ${item.official_name} antes de confirmar.`;
             return;
           }
           gateState.records = [item, ...gateState.records.filter(record => record.id !== item.checkin_id && record.id !== item.id)];
           gateState.loaded = true;
          renderGateLastCheckin(item);
          renderGateHistory();
           if (status) status.textContent = item.entry_status === 'blocked' || item.entry_allowed === false ? `ATENÇÃO: entrada bloqueada para ${item.official_name}. ${item.restriction_reason || 'Responsável obrigatório'}. O monitor foi notificado.` : `${gateDirectionLabel(item.direction)} registrada para ${item.official_name}.`;
            if (source === 'manual') document.querySelector('[data-gate-token]').value = '';
          }
          async function confirmVisualGateCheckin() {
            const pending = gateState.pending;
            const status = document.querySelector('[data-gate-scan-status]');
            if (!pending || !supabaseClient) return;
            if (status) status.textContent = 'Registrando após a conferência visual...';
            const { data, error } = await supabaseClient.rpc('register_gate_checkin', { target_badge_token:pending.badge_token, gate_direction:pending.gate_direction, visual_confirmation:true });
            if (error) { if (status) status.textContent = 'Não foi possível confirmar a passagem. Tente ler o QR novamente.'; return; }
            const item = Array.isArray(data) ? data[0] : data;
            if (!item) { if (status) status.textContent = 'A portaria não retornou o registro confirmado.'; return; }
            gateState.pending = null;
            gateState.records = [item, ...gateState.records.filter(record => record.id !== item.checkin_id && record.id !== item.id)];
            gateState.loaded = true;
            renderGateLastCheckin(item);
            renderGateHistory();
            if (status) status.textContent = item.entry_status === 'blocked' || item.entry_allowed === false ? `Entrada bloqueada para ${item.official_name}. ${item.restriction_reason || 'Responsável obrigatório'}.` : `${gateDirectionLabel(item.direction)} confirmada para ${item.official_name}.`;
            const manualInput = document.querySelector('[data-gate-token]');
            if (manualInput) manualInput.value = '';
          }
         async function confirmGuardianEntry(checkinId) {
           const status = document.querySelector('[data-gate-scan-status]');
           if (!supabaseClient || !currentUser || !checkinId) return;
           if (status) status.textContent = 'Confirmando a presença do responsável...';
           const { data, error } = await supabaseClient.rpc('confirm_guardian_entry', { target_checkin:checkinId });
           if (error || !data) { if (status) status.textContent = 'Não foi possível liberar a entrada. Confirme a presença do responsável e tente novamente.'; return; }
           const item = Array.isArray(data) ? data[0] : data;
           gateState.records = gateState.records.map(record => (record.id === checkinId || record.checkin_id === checkinId) ? { ...record, entry_status:'guardian_present', guardian_present:true, guardian_confirmed_at:item.guardian_confirmed_at } : record);
           renderGateLastCheckin({ ...item, checkin_id:checkinId });
           renderGateHistory();
           if (status) status.textContent = 'Responsável confirmado. Entrada liberada e monitor atualizado.';
         }
         async function startGateScanner() {
           const button = document.querySelector('[data-start-gate-scanner]');
           const status = document.querySelector('[data-gate-scan-status]');
           if (!window.Html5Qrcode) {
             if (status) status.textContent = 'Carregando leitor de câmera...';
              try { await loadExternalScript('https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js','Html5Qrcode'); }
             catch { if (status) status.textContent = 'Leitor de câmera indisponível. Use a leitura manual.'; return; }
           }
          if (gateState.scanning) return;
          try {
            gateState.scanner = new window.Html5Qrcode('qrReader');
            await gateState.scanner.start({ facingMode:'environment' }, { fps:10, qrbox:{ width:220, height:220 } }, text => {
              if (gateState.processing) return;
              gateState.processing = true;
              registerGateCheckin(text, 'qr').finally(() => setTimeout(() => { gateState.processing = false; }, 1800));
            }, () => {});
            gateState.scanning = true;
            button.textContent = 'Câmera ativa';
            status.textContent = 'Aponte a câmera para o QR do aluno.';
          } catch (error) { status.textContent = 'Não foi possível acessar a câmera. Verifique a permissão ou use a leitura manual.'; }
        }
        function setupGatekeeperView() {
          const view = gatekeeperView;
          const form = view?.querySelector('[data-gate-manual-form]');
          if (!form || form.dataset.ready) return;
          form.dataset.ready = 'true';
           view.querySelector('[data-start-gate-scanner]').addEventListener('click', startGateScanner);
           form.addEventListener('submit', event => { event.preventDefault(); registerGateCheckin(view.querySelector('[data-gate-token]').value, 'manual'); });
           view.querySelector('[data-gate-last-checkin]').addEventListener('click', event => { const check = event.target.closest('[data-gate-visual-check]'); if (check) view.querySelector('[data-confirm-gate-visual]')?.toggleAttribute('disabled', !check.checked); const visualButton = event.target.closest('[data-confirm-gate-visual]'); if (visualButton && !visualButton.disabled) confirmVisualGateCheckin(); const guardianButton = event.target.closest('[data-confirm-guardian-entry]'); if (guardianButton) confirmGuardianEntry(guardianButton.dataset.confirmGuardianEntry); });
           loadGateCheckins(true);
        }
          function setupGateCoordination() {
            if (!document.querySelector('[data-gate-coordination]')) return;
            loadGateCheckins();
            if (!gateState.refreshTimer) gateState.refreshTimer = setInterval(() => loadGateCheckins(true), 15000);
          }
          const experienceState = { active:'music', birthdays:[], loaded:false, loading:false };
          const experienceContent = {
            music: { title:'Aula de Música', summary:'Escuta, ritmo e criação coletiva para desenvolver expressão e confiança.', cards:[['Escuta ativa','Reconhecer sons, silêncios e ritmos presentes na comunidade.'],['Criação coletiva','Compor pequenas sequências usando voz, corpo e instrumentos.'],['Apresentação','Compartilhar uma produção com respeito e alegria.']] },
            entrepreneurship: { title:'Empreendedorismo', summary:'Ideias que viram soluções para a escola e para o território.', cards:[['Observar','Identificar desafios reais do cotidiano escolar.'],['Planejar','Organizar recursos, etapas e responsabilidades.'],['Apresentar','Defender uma solução com clareza e colaboração.']] },
            inclusive_education: { title:'Educação Inclusiva', summary:'Uma escola acessível, acolhedora e atenta a cada percurso.', cards:[['Acolher','Construir convivência com respeito às diferenças.'],['Adaptar','Ajustar estratégias, materiais e tempos quando necessário.'],['Participar','Garantir que cada estudante tenha voz e pertencimento.']] },
            robotics: { title:'Robótica', summary:'Construção, programação e pensamento computacional para aprender fazendo.', cards:[['Montar','Construir protótipos com materiais e peças disponíveis.'],['Programar','Testar lógica, sensores e comandos em desafios progressivos.'],['Aprender com erros','Documentar tentativas e melhorar em equipe.']] }
          };
          function renderExperiencePanel(panel, slug = experienceState.active) {
            const content = panel?.querySelector('[data-experience-content]');
            if (!content) return;
            experienceState.active = slug;
            panel.dataset.experienceActive = slug;
            panel.querySelectorAll('[data-experience-tab]').forEach(button => { const active = button.dataset.experienceTab === slug; button.classList.toggle('is-active',active); button.setAttribute('aria-selected',String(active)); });
             if (slug === 'birthdays') {
               const month = new Intl.DateTimeFormat('pt-BR',{month:'long'}).format(new Date());
               content.innerHTML = `<h3>Aniversariantes de ${escapeHtml(month)}</h3><p>Uma celebração simples para valorizar cada estudante. A escola publica somente nome, turma e dia do aniversário.</p><div class="birthday-grid">${experienceState.birthdays.length ? experienceState.birthdays.map(item => { const day = String(item.birthday_day).padStart(2,'0'); return `<article class="birthday-card"><span class="birthday-day" aria-label="Aniversário em ${day} de ${escapeHtml(month)}">${day}</span><div><strong>${escapeHtml(item.official_name)}</strong><span>${day} de ${escapeHtml(month)} · ${escapeHtml(item.class_label || 'Turma não informada')}</span></div></article>`; }).join('') : '<div class="project-empty">Nenhum aniversário publicado para este mês.</div>'}</div>`;
               if (!experienceState.loaded && !experienceState.loading) loadExperienceBirthdays();
               return;
            }
            const item = experienceContent[slug] || experienceContent.music;
            content.innerHTML = `<h3>${escapeHtml(item.title)}</h3><p>${escapeHtml(item.summary)}</p><div class="experience-grid">${item.cards.map(card => `<article class="experience-card"><strong>${escapeHtml(card[0])}</strong><span>${escapeHtml(card[1])}</span></article>`).join('')}</div>`;
          }
          function renderExperiencePanels() { document.querySelectorAll('[data-experience-panel]').forEach(panel => renderExperiencePanel(panel,panel.dataset.experienceActive || experienceState.active)); }
          async function loadExperienceBirthdays() {
            if (!supabaseClient || !currentUser || experienceState.loading) return;
            experienceState.loading = true;
            try {
              const { data, error } = await supabaseClient.rpc('list_current_month_birthdays',{ target_month:new Date().getMonth() + 1 });
              experienceState.birthdays = error ? [] : data || [];
              experienceState.loaded = true;
              renderExperiencePanels();
            } finally { experienceState.loading = false; }
          }
          function ensureExperienceViews() {
             [parentView,teacherView,studentView,adminView,directorView,coordinatorView,secretaryView,monitorView,gatekeeperView].filter(view => view?.innerHTML).forEach(view => { if (!view.querySelector('[data-experience-panel]')) view.insertAdjacentHTML('beforeend',experienceMarkup); });
          }
          function setupExperiences() {
            ensureExperienceViews();
            renderExperiencePanels();
            if (!document.body.dataset.experienceActions) { document.body.dataset.experienceActions = 'true'; document.addEventListener('click', event => { const button = event.target.closest('[data-experience-tab]'); if (button) renderExperiencePanel(button.closest('[data-experience-panel]'),button.dataset.experienceTab); }); }
          }
          const coordinatorState = { students:[], classes:[], checkins:[], attendance:[], alerts:[], loaded:false, loading:false, channel:null, refreshTimer:null };
         function coordinatorClassLabel(student) {
           const classData = coordinatorState.classes.find(item => item.id === student?.class_id);
           return classData ? `${classData.year}º ano ${classData.class_code}` : 'Turma não informada';
         }
         function coordinatorLatestCheckins() {
           const latest = new Map();
           [...coordinatorState.checkins].sort((a,b) => new Date(b.checked_at) - new Date(a.checked_at)).forEach(item => { if (item.student_id && !latest.has(item.student_id)) latest.set(item.student_id, item); });
           return latest;
         }
         function coordinatorRows() {
           const latest = coordinatorLatestCheckins();
           const attendance = new Map(coordinatorState.attendance.map(item => [item.student_id, item]));
           const panel = coordinatorView?.querySelector('[data-coordinator-attendance]');
           const query = normalizePersonName(panel?.querySelector('[data-coordinator-search]')?.value || '');
           const classId = panel?.querySelector('[data-coordinator-class]')?.value || 'all';
            return coordinatorState.students.filter(student => (!query || normalizePersonName(student.official_name).includes(query)) && (classId === 'all' || student.class_id === classId)).map(student => {
              const classData = coordinatorState.classes.find(item => item.id === student.class_id);
              const checkin = latest.get(student.id);
              const official = attendance.get(student.id);
             const blocked = checkin && (checkin.entry_status === 'blocked' || checkin.entry_allowed === false);
             const status = blocked ? 'Atenção' : checkin?.direction === 'exit' ? 'Saiu' : checkin?.direction === 'entry' ? 'Chegou' : official?.status === 'present' ? 'Presente' : official?.status === 'late' ? 'Atrasado' : official?.status === 'absent' ? 'Falta' : official?.status === 'justified' ? 'Justificada' : 'Aguardando';
             const statusClass = blocked ? 'is-blocked' : ['Chegou','Presente','Atrasado'].includes(status) ? '' : 'is-pending';
             const time = checkin?.checked_at ? new Date(checkin.checked_at).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) : '--:--';
              return { student, checkin, official, status, statusClass, time, classLabel:classData ? `${classData.year}º ano ${classData.class_code}` : 'Turma não informada', classCode:classData?.class_code || '—', year:classData?.year ? `${classData.year}º` : '—', direction:checkin ? gateDirectionLabel(checkin.direction) : '—' };
           });
         }
         function renderCoordinatorView() {
           if (!coordinatorView) return;
           const rows = coordinatorRows();
           const latest = coordinatorLatestCheckins();
           const arrived = [...latest.values()].filter(item => item.direction === 'entry' && item.entry_status !== 'blocked' && item.entry_allowed !== false).length;
           const entries = coordinatorState.checkins.filter(item => item.direction === 'entry').length;
           const openAlerts = coordinatorState.alerts.filter(item => !item.resolved_at).length;
           const classesWithArrivals = new Set([...latest.values()].filter(item => item.direction === 'entry').map(item => coordinatorState.students.find(student => student.id === item.student_id)?.class_id).filter(Boolean));
           const present = coordinatorView.querySelector('#coordinatorPresentCount');
           const presentRate = coordinatorView.querySelector('#coordinatorPresentRate');
           const checkinCount = coordinatorView.querySelector('#coordinatorCheckinCount');
           const alertCount = coordinatorView.querySelector('#coordinatorAlertCount');
           if (present) present.textContent = String(arrived);
           if (presentRate) presentRate.textContent = coordinatorState.students.length ? `${Math.round((arrived / coordinatorState.students.length) * 100)}% da lista` : '—';
           if (checkinCount) checkinCount.textContent = String(entries);
           if (alertCount) alertCount.textContent = String(openAlerts);
           coordinatorView.querySelector('#coordinatorStudentCount')?.replaceChildren(document.createTextNode(String(coordinatorState.students.length)));
           coordinatorView.querySelector('#coordinatorClassCount')?.replaceChildren(document.createTextNode(String(classesWithArrivals.size)));
           const list = coordinatorView.querySelector('[data-coordinator-list]');
            if (list) list.innerHTML = rows.length ? rows.map(item => `<div class="coordinator-row" role="row"><span class="coordinator-time">${item.time}</span><div class="coordinator-student"><strong>${escapeHtml(item.student.official_name)}</strong><span>${item.official ? `Frequência: ${escapeHtml(item.official.status)}` : 'Sem registro pedagógico'}</span></div><span class="coordinator-student"><span>${escapeHtml(item.classCode)}</span></span><span class="coordinator-student"><span>${escapeHtml(item.year)} ano</span></span><span class="coordinator-status ${item.statusClass}">${item.status}</span><span class="coordinator-student"><span>${escapeHtml(item.direction)}</span></span></div>`).join('') : '<div class="coordinator-empty">Nenhum aluno encontrado com estes filtros.</div>';
           const alerts = coordinatorView.querySelector('[data-coordinator-alert-list]');
           const openItems = coordinatorState.alerts.filter(item => !item.resolved_at);
           if (alerts) alerts.innerHTML = openItems.length ? openItems.map(item => { const student = Array.isArray(item.students) ? item.students[0] : item.students; return `<article class="coordinator-alert"><strong>${escapeHtml(student?.official_name || 'Aluno')} · Entrada que precisa de atenção</strong><p>${escapeHtml(item.reason || 'Responsável deve ser confirmado antes da entrada.')}</p><small>${new Date(item.created_at).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</small></article>`; }).join('') : '<div class="coordinator-empty">Nenhum alerta aberto.</div>';
         }
         async function loadCoordinatorData(force = false) {
           if (!coordinatorView || !supabaseClient || !currentUser || !['coordinator','developer'].includes(currentProfile?.role)) return;
           if (coordinatorState.loading && !force) return;
           coordinatorState.loading = true;
           const status = coordinatorView.querySelector('[data-coordinator-status]');
           if (status) status.textContent = 'Atualizando lista...';
           const today = schoolTodayIso();
           const start = new Date(`${today}T00:00:00-03:00`).toISOString();
           const end = new Date(`${today}T23:59:59-03:00`).toISOString();
           const [studentsResult, classesResult, checkinsResult, attendanceResult, alertsResult] = await Promise.all([
             supabaseClient.from('students').select('id,official_name,class_id').eq('active',true).order('official_name'),
              supabaseClient.from('classes').select('id,year,class_code,shift').order('year').order('class_code'),
             supabaseClient.from('gate_checkins').select('id,student_id,direction,checked_at,entry_status,restriction_reason,students(official_name)').gte('checked_at',start).lte('checked_at',end).order('checked_at',{ascending:false}).limit(300),
             supabaseClient.from('attendance').select('student_id,attendance_date,status').eq('attendance_date',today),
             supabaseClient.from('gate_entry_alerts').select('id,student_id,reason,created_at,acknowledged_at,resolved_at,students(official_name)').eq('resolved_at',null).order('created_at',{ascending:false}).limit(50)
           ]);
           coordinatorState.students = studentsResult.error ? [] : studentsResult.data || [];
           coordinatorState.classes = classesResult.error ? [] : classesResult.data || [];
           coordinatorState.checkins = checkinsResult.error ? [] : checkinsResult.data || [];
           coordinatorState.attendance = attendanceResult.error ? [] : attendanceResult.data || [];
           coordinatorState.alerts = alertsResult.error ? [] : alertsResult.data || [];
           coordinatorState.loaded = true;
           coordinatorState.loading = false;
           const classSelect = coordinatorView.querySelector('[data-coordinator-class]');
           if (classSelect && classSelect.options.length === 1) classSelect.insertAdjacentHTML('beforeend', coordinatorState.classes.map(item => `<option value="${item.id}">${escapeHtml(item.year)}º ano ${escapeHtml(item.class_code)}</option>`).join(''));
           renderCoordinatorView();
           coordinatorView.querySelector('[data-coordinator-updated]')?.replaceChildren(document.createTextNode(`Atualizado às ${schoolClock()}`));
           if (status) status.textContent = `${coordinatorRows().length} aluno(s) na lista · atualização automática ativa`;
         }
          function downloadCoordinatorCsv() {
            const rows = coordinatorRows();
            const values = [['Horário','Aluno','Turma','Ano','Situação','Passagem','Frequência oficial'], ...rows.map(item => [item.time,item.student.official_name,item.classCode,item.year,item.status,item.direction,item.official?.status || 'Não registrada'])];
            const csv = values.map(row => row.map(value => `"${String(value).replace(/"/g,'""')}"`).join(';')).join('\n');
            saveBlob(new Blob([`\ufeff${csv}`],{type:'text/csv;charset=utf-8'}),`frequencia-chegada-bfr-${schoolTodayIso()}.csv`);
          }
           async function downloadCoordinatorPdf() {
            const status = coordinatorView?.querySelector('[data-coordinator-status]');
            try {
              const JsPDF = await getPdfConstructor();
              const doc = new JsPDF({ unit:'mm', format:'a4', orientation:'landscape' });
              const rows = coordinatorRows();
              const margin = 12;
              const widths = [18,80,45,22,32,33,43];
              const headers = ['Horário','Aluno','Turma','Ano','Situação','Passagem','Frequência'];
              let y = 14;
              doc.setTextColor(23,35,63);
              doc.setFont('helvetica','bold');
              doc.setFontSize(16);
              doc.text('BFR Conecta · Chegadas da portaria', margin, y);
              y += 7;
              doc.setFont('helvetica','normal');
              doc.setFontSize(9);
              doc.setTextColor(100,116,139);
              doc.text(`Relatório administrativo · ${new Date(`${schoolTodayIso()}T12:00:00`).toLocaleDateString('pt-BR')}`, margin, y);
              y += 8;
              const drawHeader = () => {
                doc.setFillColor(237,243,255);
                doc.setTextColor(37,99,235);
                doc.rect(margin, y, widths.reduce((sum,width) => sum + width, 0), 8, 'F');
                doc.setFont('helvetica','bold');
                doc.setFontSize(8);
                let x = margin;
                headers.forEach((header,index) => { doc.text(header, x + 2, y + 5.2); x += widths[index]; });
                y += 8;
              };
              const drawRow = values => {
                if (y > 187) { doc.addPage(); y = 14; drawHeader(); }
                let x = margin;
                doc.setTextColor(40,54,84);
                doc.setFont('helvetica','normal');
                doc.setFontSize(8);
                values.forEach((value,index) => { doc.text(String(value), x + 2, y + 5.2, { maxWidth: widths[index] - 4 }); x += widths[index]; });
                doc.setDrawColor(231,235,243);
                doc.line(margin, y + 8, margin + widths.reduce((sum,width) => sum + width, 0), y + 8);
                y += 8;
              };
              drawHeader();
              if (rows.length) rows.forEach(item => drawRow([item.time,item.student.official_name,item.classCode,item.year,item.status,item.direction,item.official?.status || 'Não registrada']));
              else drawRow(['—','Nenhum aluno encontrado','—','—','—','—','—']);
              doc.save(`frequencia-chegada-bfr-${schoolTodayIso()}.pdf`);
            } catch (error) {
              if (status) status.textContent = error.message || 'Não foi possível gerar o PDF.';
            }
          }
          function setupCoordinatorView() {
           if (!coordinatorView) return;
           if (!coordinatorView.dataset.coordinatorReady) {
             coordinatorView.dataset.coordinatorReady = 'true';
             coordinatorView.querySelector('[data-coordinator-search]')?.addEventListener('input', renderCoordinatorView);
              coordinatorView.querySelector('[data-coordinator-class]')?.addEventListener('change', renderCoordinatorView);
              coordinatorView.querySelectorAll('[data-coordinator-refresh]').forEach(button => button.addEventListener('click', () => loadCoordinatorData(true)));
              coordinatorView.querySelector('[data-coordinator-export]')?.addEventListener('click', downloadCoordinatorCsv);
              coordinatorView.querySelector('[data-coordinator-pdf]')?.addEventListener('click', downloadCoordinatorPdf);
            }
            loadCoordinatorData(true);
             if (!coordinatorState.channel && supabaseClient?.channel) coordinatorState.channel = subscribeWithRecovery('bfr-coordinator-live', channel => channel.on('postgres_changes',{event:'*',schema:'public',table:'gate_checkins'},() => loadCoordinatorData(true)).on('postgres_changes',{event:'*',schema:'public',table:'attendance'},() => loadCoordinatorData(true)).on('postgres_changes',{event:'*',schema:'public',table:'gate_entry_alerts'},() => loadCoordinatorData(true)), channelStatus => { const live = coordinatorView.querySelector('[data-coordinator-live-status]'); if (!live) return; live.textContent = channelStatus === 'SUBSCRIBED' ? '● ao vivo' : '○ reconectando'; live.classList.toggle('is-reconnecting', channelStatus !== 'SUBSCRIBED'); });
           if (!coordinatorState.refreshTimer) coordinatorState.refreshTimer = setInterval(() => loadCoordinatorData(true), 10000);
         }
          const activityState = { items:[], classes:[], loaded:false, loading:false };
          function ensureStudentJourneyStyles() {
            if (document.getElementById('studentJourneyStyles')) return;
            const style = document.createElement('style');
            style.id = 'studentJourneyStyles';
            style.textContent = `
              #studentView .student-journey{margin:18px 0;padding:22px;border:1px solid #d8e4f3;border-radius:18px;background:linear-gradient(135deg,#f7fbff,#fff 58%,#f5f2ff);box-shadow:0 12px 28px rgba(38,76,132,.07)}
              #studentView .student-journey-intro{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
              #studentView .student-journey h2{margin:4px 0 0;color:#173b79;font:700 24px 'Playfair Display',serif}
              #studentView .student-journey-copy{max-width:650px;margin-top:7px;color:#65758f;font-size:12px;line-height:1.5}
              #studentView .student-journey-score{min-width:136px;padding:12px 14px;border:1px solid #d7e6fb;border-radius:14px;background:#fff;text-align:right}
              #studentView .student-journey-score strong{display:block;color:#1558dc;font:700 28px 'DM Mono',monospace;line-height:1}
              #studentView .student-journey-score small{display:block;margin-top:5px;color:#73839b;font-size:9px}
              #studentView .student-journey-sync{display:block;max-width:120px;margin-top:6px;color:#73839b;font-size:8px;line-height:1.25}
              #studentView .student-journey-sync.is-error{color:#b65d4e}
              #studentView .student-journey-grid{display:grid;grid-template-columns:1.25fr .9fr .95fr;gap:12px;margin-top:17px}
              #studentView .student-journey-card{min-width:0;padding:16px;border:1px solid #e0e8f2;border-radius:14px;background:rgba(255,255,255,.86)}
              #studentView .student-journey-card h3{margin:6px 0;color:#20385d;font-size:17px}
              #studentView .student-card-label{color:#7485a0;font:10px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase}
              #studentView .student-card-subject{display:inline-flex;margin-top:13px;padding:5px 8px;border-radius:999px;color:#1558dc;background:#eaf2ff;font:10px 'DM Mono',monospace}
              #studentView .student-journey-card p{margin:7px 0;color:#66768c;font-size:11px;line-height:1.45}
              #studentView .student-card-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px}
              #studentView .student-card-meta{color:#8290a3;font-size:10px}
              #studentView .student-journey-button{border:0;border-radius:9px;padding:9px 11px;color:#fff;background:#1558dc;font-size:10px;font-weight:700;cursor:pointer}
              #studentView .student-journey-button:hover{background:#0e45b2}
              #studentView .student-journey-link{display:block;margin-top:12px;padding:0;color:#1558dc}
              #studentView .student-achievement-summary{display:flex;align-items:center;gap:12px;margin-top:13px}
              #studentView .student-achievement-summary strong{color:#9b6d13;font:700 28px 'DM Mono',monospace}
              #studentView .student-achievement-summary span{color:#74839a;font-size:10px;line-height:1.35}
              #studentView .student-achievement-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
              #studentView .student-achievement-chip{padding:6px 8px;border:1px solid #f0deb2;border-radius:999px;color:#8c6818;background:#fffaf0;font-size:9px}
              #studentView .student-achievement-empty{color:#8b98aa;font-size:10px}
              #studentView .student-map-line{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:16px}
              #studentView .student-map-line:before{content:'';position:absolute;left:13%;right:13%;top:17px;height:2px;background:#dbe7f4}
              #studentView .student-map-node{position:relative;z-index:1;display:grid;justify-items:center;gap:5px;border:0;background:transparent;color:#7b899c;cursor:pointer;text-align:center}
              #studentView .student-map-node span{display:grid;place-items:center;width:34px;height:34px;border:2px solid #dbe7f4;border-radius:50%;background:#fff;color:#8a98ab;font:700 10px 'DM Mono',monospace}
              #studentView .student-map-node b{font-size:10px;color:#385274}
              #studentView .student-map-node small{font-size:9px;line-height:1.2}
              #studentView .student-map-node.is-done span,#studentView .student-map-node.is-active span{border-color:#1558dc;color:#fff;background:#1558dc;box-shadow:0 0 0 4px rgba(21,88,220,.11)}
              #studentView .student-map-node.is-done b,#studentView .student-map-node.is-active b{color:#1558dc}
              #studentView .student-map-progress{height:6px;margin-top:14px;border-radius:99px;background:#edf1f6;overflow:hidden}
              #studentView .student-map-progress i{display:block;height:100%;width:28%;border-radius:inherit;background:linear-gradient(90deg,#1558dc,#24b7a1);transition:width .3s ease}
              #studentView .student-map-caption{display:flex;justify-content:space-between;gap:8px;margin-top:7px;color:#77879e;font-size:9px}
              #studentView [data-games-panel].student-games-panel .game-subjects{grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
              #studentView [data-games-panel].student-games-panel .game-subject{display:flex;flex-direction:column;align-items:flex-start;gap:7px;min-height:78px;padding:12px;border:1px solid #dfe7f2;border-radius:12px;background:#fff;text-align:left;transition:transform .18s,border-color .18s,box-shadow .18s}
              #studentView [data-games-panel].student-games-panel .game-subject:hover,#studentView [data-games-panel].student-games-panel .game-subject.active{transform:translateY(-2px);border-color:#8db3e9;box-shadow:0 8px 16px rgba(38,76,132,.09)}
              #studentView [data-games-panel].student-games-panel .game-subject b{color:#253f66;font-size:11px}
              #studentView [data-games-panel].student-games-panel .game-subject span:not(.game-subject-group){color:#1558dc;font-size:9px}
              #studentView [data-games-panel].student-games-panel .game-subject-group{color:#8796aa;font:9px 'DM Mono',monospace;letter-spacing:.04em;text-transform:uppercase}
              @media(max-width:900px){#studentView .student-journey-grid{grid-template-columns:1fr 1fr}#studentView .student-journey-card:first-child{grid-column:1/-1}}
              @media(max-width:650px){#studentView .student-journey{padding:16px}#studentView .student-journey-intro{display:block}#studentView .student-journey-score{display:inline-block;margin-top:14px;text-align:left}#studentView .student-journey-grid{grid-template-columns:1fr}#studentView .student-journey-card:first-child{grid-column:auto}#studentView [data-games-panel].student-games-panel .game-subjects{grid-template-columns:repeat(2,minmax(0,1fr))}#studentView .student-card-footer{align-items:flex-start;flex-direction:column}}
            `;
            document.head.appendChild(style);
          }
          const studentJourneyState = { studentId:null, loaded:false, loading:false, error:'', points:0, sessions:0, subjects:[], badges:[] };
          function resetStudentJourney() {
            Object.assign(studentJourneyState, { studentId:null, loaded:false, loading:false, error:'', points:0, sessions:0, subjects:[], badges:[] });
          }
          function readStudentJourney() {
            return { points:studentJourneyState.points, sessions:studentJourneyState.sessions, subjects:studentJourneyState.subjects, badges:studentJourneyState.badges };
          }
          async function loadStudentJourney(studentId) {
            if (!supabaseClient || !currentUser || !studentId) { resetStudentJourney(); renderStudentJourney(); return; }
            studentJourneyState.loading = true;
            studentJourneyState.error = '';
            const { data, error } = await supabaseClient.from('student_game_sessions').select('subject,score,total,points,completed_at').eq('student_id', studentId).order('completed_at',{ascending:false}).limit(200);
            if (error) {
              Object.assign(studentJourneyState, { studentId, loaded:true, loading:false, error:'A jornada ainda não foi sincronizada com a escola.', points:0, sessions:0, subjects:[], badges:[] });
              renderStudentJourney();
              return;
            }
            const rows = data || [];
            const subjects = [...new Set(rows.map(item => item.subject).filter(Boolean))];
            const badges = [];
            if (rows.length >= 1) badges.push('Primeiro passo');
            if (rows.length >= 3) badges.push('Ritmo de estudo');
            if (subjects.length >= 3) badges.push('Explorador de ideias');
            if (rows.some(item => Number(item.total) > 0 && Number(item.score) === Number(item.total))) badges.push('Desafio perfeito');
            Object.assign(studentJourneyState, { studentId, loaded:true, loading:false, error:'', points:rows.reduce((sum,item) => sum + Number(item.points || (Number(item.score || 0) * 10 + 5)), 0), sessions:rows.length, subjects, badges });
            renderStudentJourney();
          }
          function recommendedStudentSubject() {
            const scores = new Map();
            (studentDataState.grades || []).forEach(item => {
              if (!gameQuestionBank[item.subject] || !Number.isFinite(Number(item.score))) return;
              const row = scores.get(item.subject) || { total:0, count:0 };
              row.total += Number(item.score); row.count += 1; scores.set(item.subject, row);
            });
            return [...scores.entries()].sort((a,b) => (a[1].total / a[1].count) - (b[1].total / b[1].count))[0]?.[0] || 'Matemática';
          }
          function renderStudentJourney() {
            const panel = studentView?.querySelector('[data-student-journey]');
            if (!panel) return;
            const data = readStudentJourney();
            const subject = recommendedStudentSubject();
            const total = gameQuestionBank[subject]?.length || 4;
            const sessions = Number(data.sessions) || 0;
            const badges = Array.isArray(data.badges) ? data.badges : [];
            const step = sessions >= 3 ? 3 : sessions ? 2 : 1;
            const status = panel.querySelector('[data-student-journey-status]');
            if (status) { status.textContent = studentJourneyState.error || (studentJourneyState.loaded ? 'Progresso sincronizado com a escola.' : 'Carregando seu progresso...'); status.classList.toggle('is-error', Boolean(studentJourneyState.error)); }
            panel.querySelector('[data-student-points]').textContent = String(Number(data.points) || 0);
            panel.querySelector('[data-student-recommendation-subject]').textContent = subject;
            panel.querySelector('[data-student-recommendation-title]').textContent = `Desafio rápido · ${subject}`;
            panel.querySelector('[data-student-recommendation-copy]').textContent = studentDataState.grades?.length ? 'Uma revisão curta para praticar o componente em que você pode avançar um pouco mais.' : 'Comece com quatro perguntas e descubra qual tema combina com seu ritmo de hoje.';
            panel.querySelector('[data-student-recommendation-meta]').textContent = `${total} perguntas · prática individual`;
            panel.querySelector('[data-student-start-recommendation]').dataset.studentSubject = subject;
            panel.querySelector('[data-student-badge-count]').textContent = String(badges.length);
            panel.querySelector('[data-student-session-count]').textContent = `${sessions} desafio${sessions === 1 ? '' : 's'} concluído${sessions === 1 ? '' : 's'}`;
            panel.querySelector('[data-student-achievement-list]').innerHTML = badges.length ? badges.map(item => `<span class="student-achievement-chip">${escapeHtml(item)}</span>`).join('') : '<span class="student-achievement-empty">Conclua um desafio para liberar sua primeira conquista.</span>';
            panel.querySelector('[data-student-map-progress]').textContent = `${step} de 3 passos`;
            panel.querySelector('[data-student-map-fill]').style.width = `${step === 1 ? 28 : step === 2 ? 66 : 100}%`;
            panel.querySelectorAll('[data-student-map-node]').forEach((node,index) => { node.classList.toggle('is-done', index < step - 1); node.classList.toggle('is-active', index === step - 1); });
          }
          async function recordStudentGameResult() {
            if (activeView !== 'student' || !gameState.subject || !currentUser || !supabaseClient || !studentDataState.student) return;
            const total = gameQuestionBank[gameState.subject]?.length || 0;
            if (!total) return;
            const { error } = await supabaseClient.from('student_game_sessions').insert({ student_id:studentDataState.student.id, profile_id:currentUser.id, subject:gameState.subject, score:Math.max(0,Math.min(total,Number(gameState.score) || 0)), total }).select('id').single();
            if (error) { studentJourneyState.error = 'O desafio terminou, mas não foi possível sincronizar o resultado.'; renderStudentJourney(); return; }
            await loadStudentJourney(studentDataState.student.id);
          }
          function decorateStudentGamePanel() {
            const panel = studentView?.querySelector('[data-games-panel]');
            if (!panel) return;
            panel.classList.add('student-games-panel');
            panel.querySelector('.agenda-intro').textContent = 'Escolha uma trilha, pratique no seu ritmo e acompanhe seu próprio avanço.';
            const groups = { 'Língua Portuguesa':'Linguagens', Matemática:'Raciocínio', Ciências:'Natureza', História:'Humanidades', Geografia:'Humanidades', 'Língua Inglesa':'Linguagens', Arte:'Expressão', 'Educação Física':'Corpo e movimento', 'Ensino Religioso':'Convivência' };
            panel.querySelectorAll('[data-game-subject]').forEach(button => { if (!button.querySelector('[data-game-group]')) button.insertAdjacentHTML('afterbegin', `<em class="game-subject-group" data-game-group>${groups[button.dataset.gameSubject] || 'Trilha'}</em>`); });
          }
          function ensureStudentExperienceView() {
            if (!studentView?.querySelector('.welcome')) return;
            ensureStudentJourneyStyles();
            if (!studentView.querySelector('[data-student-journey]')) studentView.querySelector('.welcome').insertAdjacentHTML('afterend', `<section class="student-journey" data-student-journey><div class="student-journey-intro"><div><div class="eyebrow">Minha Jornada · aprendizagem individual</div><h2>Aprender no seu ritmo, avançar do seu jeito.</h2><p class="student-journey-copy">Uma visão simples para escolher o próximo passo, praticar e reconhecer cada pequena conquista. Seus pontos de prática ficam salvos neste dispositivo.</p></div><div class="student-journey-score"><strong data-student-points>0</strong><small>pontos de prática</small></div></div><div class="student-journey-grid"><article class="student-journey-card student-recommendation"><div class="student-card-label">Desafio recomendado</div><div class="student-card-subject" data-student-recommendation-subject>Matemática</div><h3 data-student-recommendation-title>Desafio rápido · Matemática</h3><p data-student-recommendation-copy>Comece com quatro perguntas e descubra qual tema combina com seu ritmo de hoje.</p><div class="student-card-footer"><span class="student-card-meta" data-student-recommendation-meta>4 perguntas · prática individual</span><button class="student-journey-button" type="button" data-student-start-recommendation>Começar desafio</button></div><button class="text-button student-journey-link" type="button" data-lia-open>Pedir uma dica à LIA →</button></article><article class="student-journey-card"><div class="student-card-label">Pontos e conquistas</div><div class="student-achievement-summary"><strong data-student-badge-count>0</strong><span>conquistas construídas<br><b data-student-session-count>0 desafios concluídos</b></span></div><div class="student-achievement-list" data-student-achievement-list><span class="student-achievement-empty">Conclua um desafio para liberar sua primeira conquista.</span></div><button class="text-button student-journey-link" type="button" data-student-open-achievements>Ver conquistas →</button></article><article class="student-journey-card"><div class="student-card-label">Mapa de aprendizagem</div><p>Três passos para transformar curiosidade em prática.</p><div class="student-map-line"><button class="student-map-node is-active" type="button" data-student-map-node data-student-path="boletim"><span>01</span><b>Acompanhar</b><small>Notas e frequência</small></button><button class="student-map-node" type="button" data-student-map-node data-student-path="jogos"><span>02</span><b>Praticar</b><small>Desafios por matéria</small></button><button class="student-map-node" type="button" data-student-map-node data-student-path="achievements"><span>03</span><b>Reconhecer</b><small>Conquistas pessoais</small></button></div><div class="student-map-progress"><i data-student-map-fill></i></div><div class="student-map-caption"><span>Seu próximo passo</span><b data-student-map-progress>1 de 3 passos</b></div></article></div></section>`);
            const journeyStatus = studentView.querySelector('[data-student-journey] .student-journey-score');
            if (journeyStatus && !journeyStatus.querySelector('[data-student-journey-status]')) journeyStatus.insertAdjacentHTML('beforeend','<span class="student-journey-sync" data-student-journey-status>Carregando seu progresso...</span>');
            const journeyCopy = studentView.querySelector('[data-student-journey] .student-journey-copy');
            if (journeyCopy) journeyCopy.textContent = 'Uma visão simples para escolher o próximo passo, praticar e acompanhar seu progresso sincronizado com a conta escolar.';
            decorateStudentGamePanel();
            renderStudentJourney();
          }
         function ensureLearningViews() {
           if (parentView && !parentView.querySelector('[data-school-activities-panel]')) parentView.insertAdjacentHTML('beforeend', schoolActivitiesMarkup);
           if (studentView?.querySelector('.welcome') && !studentView.querySelector('[data-school-activities-panel]')) studentView.insertAdjacentHTML('beforeend', currentSchoolYearMarkup(reportDownloadMarkup) + schoolActivitiesMarkup + gamesMarkup);
           if (teacherView?.innerHTML && !teacherView.querySelector('[data-school-activities-panel]')) teacherView.insertAdjacentHTML('beforeend', schoolActivitiesMarkup + gamesMarkup);
           ensureStudentExperienceView();
         }
        function activityClassLabel(activity) {
          const classData = Array.isArray(activity.classes) ? activity.classes[0] : activity.classes;
          return classData ? `${classData.year}º ano ${classData.class_code}` : 'Todas as turmas';
        }
         function renderSchoolActivities() {
           const canPublish = ['pedagogical','developer'].includes(currentProfile?.role);
           document.querySelectorAll('[data-open-activity]').forEach(button => button.classList.toggle('hidden', !canPublish));
           const activeStudent = (parentDataState.students || []).find(item => item.id === parentDataState.activeStudentId) || parentDataState.students?.[0];
           const visibleActivities = currentProfile?.role === 'parent'
             ? activityState.items.filter(item => activeStudent?.class_id && (!item.class_id || item.class_id === activeStudent.class_id))
             : activityState.items;
            document.querySelectorAll('[data-school-activities-list]').forEach(list => {
              list.innerHTML = visibleActivities.length ? visibleActivities.slice(0,3).map(activity => {
               const due = activity.due_date ? ` · entrega ${new Date(`${activity.due_date}T12:00:00`).toLocaleDateString('pt-BR')}` : '';
               const file = activity.attachment_path ? `<a href="#" data-activity-download="${escapeHtml(activity.attachment_path)}">Anexo: ${escapeHtml(activity.attachment_name || 'abrir arquivo')} ↗</a>` : '';
               return `<article class="school-activity"><div class="school-activity-top"><strong>${escapeHtml(activity.title)}</strong><small>${escapeHtml(activity.subject)}</small></div><p>${escapeHtml(activity.description)}<br><span>${escapeHtml(activityClassLabel(activity))}${due}</span></p>${file}</article>`;
              }).join('') : '<div class="project-empty">Nenhuma atividade vinculada a este aluno.</div>';
            });
            const activityCard = parentView.querySelector('.overview-grid .metric-card:nth-child(3)');
            if (activityCard) {
              const openActivities = visibleActivities.filter(item => !item.due_date || item.due_date >= schoolTodayIso());
              activityCard.querySelector('.metric-value strong').textContent = openActivities.length ? String(openActivities.length).padStart(2, '0') : '—';
              activityCard.querySelector('.metric-value span').textContent = openActivities.length ? 'para ver' : 'aguardando atividades';
             activityCard.querySelector('.metric-foot').textContent = openActivities.length ? 'Dados sincronizados com a escola' : 'Nenhuma atividade publicada';
           }
         }
        async function loadActivityClasses() {
          const select = document.getElementById('activityClass');
          if (!select || !supabaseClient || activityState.classes.length) return;
          const { data, error } = await supabaseClient.from('classes').select('id,year,class_code').order('year').order('class_code');
          if (error || !data?.length) { select.innerHTML = '<option value="">Turmas indisponíveis</option>'; return; }
          activityState.classes = data;
          select.innerHTML = data.map(item => `<option value="${item.id}">${item.year}º ano ${escapeHtml(item.class_code)}</option>`).join('');
        }
        async function loadSchoolActivities(force = false) {
          if (!supabaseClient || (!force && (activityState.loaded || activityState.loading))) { renderSchoolActivities(); return; }
          activityState.loading = true;
          const { data, error } = await supabaseClient.from('school_activities').select('id,title,subject,description,due_date,attachment_path,attachment_name,published_at,class_id,classes(year,class_code)').order('published_at',{ascending:false}).limit(30);
          activityState.loading = false;
          activityState.loaded = true;
          if (error) { activityState.items = []; document.querySelectorAll('[data-school-activities-list]').forEach(list => { list.innerHTML = '<div class="project-empty">Atividades serão liberadas após a atualização do sistema escolar.</div>'; }); return; }
          activityState.items = data || [];
          renderSchoolActivities();
        }
        async function publishSchoolActivity(event) {
          event.preventDefault();
          const form = event.currentTarget;
          const status = document.getElementById('activityPublishStatus');
          if (!supabaseClient || !currentUser || !['pedagogical','developer'].includes(currentProfile?.role)) { status.textContent = 'Apenas professores autorizados podem publicar.'; return; }
          const data = new FormData(form);
          const file = data.get('attachment');
          if (file?.size > 15 * 1024 * 1024) { status.textContent = 'O anexo precisa ter até 15 MB.'; return; }
          status.textContent = 'Publicando atividade...';
          const payload = { title:String(data.get('title')).trim(), subject:String(data.get('subject')).trim(), class_id:data.get('class_id'), description:String(data.get('description')).trim(), due_date:data.get('due_date') || null, published_by:currentUser.id };
          const { data:activity, error } = await supabaseClient.from('school_activities').insert(payload).select('id').single();
          if (error) { status.textContent = 'Não foi possível publicar. Confira se a atualização do banco foi executada.'; return; }
           if (file?.size) {
             const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]+/g,'-').slice(-100) || 'anexo';
             const path = `${currentUser.id}/${activity.id}-${safeName}`;
             const upload = await supabaseClient.storage.from('activity-media').upload(path,file,{contentType:file.type || 'application/octet-stream',upsert:false});
             if (upload.error) { await supabaseClient.from('school_activities').delete().eq('id',activity.id); status.textContent = 'A atividade não foi salva porque o anexo falhou.'; return; }
             const update = await supabaseClient.from('school_activities').update({ attachment_path:path, attachment_name:file.name }).eq('id',activity.id);
             if (update.error) { await supabaseClient.storage.from('activity-media').remove([path]); status.textContent = 'Atividade salva, mas o anexo não foi associado.'; }
           }
           form.reset();
           if (!status.textContent.includes('anexo não foi associado')) status.textContent = 'Atividade publicada para a turma.';
          activityState.loaded = false;
          await loadSchoolActivities(true);
        }
        async function openActivityAttachment(path) {
          if (!supabaseClient) return;
          const { data, error } = await supabaseClient.storage.from('activity-media').createSignedUrl(path, 3600);
          if (error || !data?.signedUrl) return;
          window.open(data.signedUrl, '_blank', 'noopener,noreferrer');
        }
        function setupActivityPublishing() {
          const modal = document.getElementById('activityPublishModal');
          const form = document.getElementById('activityPublishForm');
          if (!modal || !form || form.dataset.ready) return;
          form.dataset.ready = 'true';
          document.getElementById('closeActivityPublish').addEventListener('click', () => modal.classList.add('hidden'));
          modal.addEventListener('click', event => { if (event.target === modal) modal.classList.add('hidden'); });
         form.addEventListener('submit', publishSchoolActivity);
           loadActivityClasses();
         }
         function setupSchoolActivities() {
           ensureLearningViews();
          setupActivityPublishing();
          if (!document.body.dataset.activityActions) {
            document.body.dataset.activityActions = 'true';
            document.addEventListener('click', event => {
              const openButton = event.target.closest('#addActivityBtn,[data-open-activity]');
              if (openButton) { setupActivityPublishing(); document.getElementById('activityPublishModal')?.classList.remove('hidden'); loadActivityClasses(); }
              const download = event.target.closest('[data-activity-download]');
              if (download) { event.preventDefault(); openActivityAttachment(download.dataset.activityDownload); }
            });
          }
          loadSchoolActivities();
        }
        const gameQuestionBank = {
