         const coordinationRestrictionMarkup = `<section class="panel" id="coordinationRestrictionPanel"><div class="panel-heading"><div><div class="eyebrow">Coordenação · controle de entrada</div><h2 style="margin-top:4px">Pendências que exigem responsável</h2></div><span class="paperless-tag">● ADMIN</span></div><p class="agenda-intro">Marque um aluno que não pode entrar sozinho. Na leitura do QR, a portaria verá o bloqueio e o monitor será avisado automaticamente.</p><form class="publish-form" data-entry-restriction-form><label>Aluno<select data-entry-restriction-student required><option value="">Carregando lista oficial...</option></select></label><label>Motivo da pendência<textarea data-entry-restriction-reason required maxlength="500" placeholder="Ex.: Saída somente com responsável presente."></textarea></label><button class="primary-button" type="submit">Bloquear entrada</button><p class="publish-status" data-entry-restriction-status></p></form><div class="restriction-list" data-entry-restriction-list><div class="project-empty">Nenhuma pendência ativa.</div></div></section>`;
        const scheduleMarkup = `<section class="panel schedule-panel" data-schedule-panel><div class="panel-heading"><div><div class="eyebrow">Organização escolar · <span data-live-year>2026</span></div><h2 style="margin-top:4px">Horários das aulas</h2></div><span class="agenda-count">consulta livre</span></div><p class="agenda-intro">Consulte o horário completo por turno. Toque na imagem para ampliar ou abra o PDF original.</p><div class="schedule-switch" role="tablist" aria-label="Escolha o turno"><button class="schedule-shift active" type="button" role="tab" aria-selected="true" data-schedule-shift="morning">Matutino</button><button class="schedule-shift" type="button" role="tab" aria-selected="false" data-schedule-shift="afternoon">Vespertino</button></div><div class="schedule-view active" data-schedule-view="morning"><div class="schedule-frame"><img class="schedule-image" src="horario-matutino-2026.png" alt="Horário matutino 2026, com as aulas de segunda a sexta para as turmas do 6º ao 9º ano" tabindex="0" role="button" loading="lazy"></div><div class="schedule-caption"><span>Horário matutino · 2026</span><a href="horario-matutino-2026.pdf" target="_blank" rel="noreferrer">Abrir PDF original ↗</a></div></div><div class="schedule-view" data-schedule-view="afternoon"><div class="schedule-frame"><img class="schedule-image" src="horario-vespertino-2026.png" alt="Horário vespertino do documento enviado, com as aulas de segunda a sexta para as turmas do 6º ao 9º ano" tabindex="0" role="button" loading="lazy"></div><div class="schedule-caption"><span>Turno vespertino · 2026</span><a href="horario-vespertino-2026.pdf" target="_blank" rel="noreferrer">Abrir PDF original ↗</a></div></div></section>`;
        const projectsMarkup = `<section class="panel projects-panel" data-projects-panel><div class="panel-heading"><div><div class="eyebrow">Projetos da escola · 2026</div><h2 style="margin-top:4px">Aprender também é participar</h2></div><span class="agenda-count">4 projetos</span></div><p class="agenda-intro">Conheça as ações da escola, acompanhe as informações e veja os registros publicados.</p>${projectTabsMarkup}<div class="project-summary"><div><h3 data-project-title>Carregando projeto...</h3><p data-project-summary></p></div><div class="project-info" data-project-information></div></div><div class="project-sources hidden" data-project-sources></div><div class="project-photos" data-project-photos></div><div class="project-podium hidden" data-project-podium><h4>Resultados dos Jogos escolares</h4><div class="podium-list" data-project-podium-list></div></div><div class="project-ranking hidden" data-project-ranking><h4>Classificação da Carroceata</h4><div data-project-ranking-levels></div></div></section>`;
       const adminProjectsMarkup = `<section class="panel projects-panel" data-projects-panel id="adminProjectsPanel"><div class="panel-heading"><div><div class="eyebrow">Projetos da escola · Administração</div><h2 style="margin-top:4px">Editar projetos</h2></div><span class="paperless-tag">● ADMIN</span></div><p class="agenda-intro">Escolha uma aba para editar as informações, adicionar fotos e registrar os resultados.</p>${projectTabsMarkup}<form class="project-admin-form" data-project-admin-form><label>Título<input name="title" required maxlength="120"></label><label>Resumo<input name="summary" required maxlength="240"></label><label>Informações<textarea name="information" required maxlength="2000"></textarea></label><label>Adicionar fotos<input name="photo" type="file" accept="image/*" multiple><small class="field-hint">Você pode selecionar várias fotos de uma vez.</small></label><label>Legenda das fotos<input name="caption" maxlength="160" placeholder="Ex.: Oficina realizada em maio"></label><button class="primary-button" type="submit">Salvar alterações</button><p class="publish-status" data-project-save-status></p></form><div class="photo-order-hint">Arraste as fotos para mudar a ordem. No celular, use os botões ↑ e ↓.</div><div class="project-photo-list" data-admin-project-photos></div><div class="podium-editor hidden" data-podium-editor><h4>Classificação dos Jogos escolares</h4><p class="agenda-intro">Escolha o aluno e confirme a turma de cada colocação.</p><datalist id="projectStudentOptions"></datalist><div data-podium-rows></div><button class="primary-button" type="button" data-save-podium>Salvar pódio</button><p class="publish-status" data-podium-status></p></div><div class="carroceata-editor hidden" data-carroceata-editor><h4>Classificação da Carroceata</h4><p class="agenda-intro">Cadastre a colocação, a turma, o tema da equipe e uma foto para cada nível. Deixe uma colocação vazia se ela ainda não estiver definida.</p><div data-carroceata-levels></div><button class="primary-button" type="button" data-save-carroceata>Salvar classificação</button><p class="publish-status" data-carroceata-status></p></div></section>`;
       const reportDownloadMarkup = `<section class="panel report-panel" data-student-report><div class="panel-heading"><div><div class="eyebrow">Desempenho escolar</div><h2 style="margin-top:4px">Boletim Escolar</h2></div><div class="report-average"><strong>—</strong><span>média geral</span></div></div><div class="report-table"><div class="report-row report-header"><span>Componente</span><span>1º bim.</span><span>2º bim.</span><span>3º bim.</span><span>4º bim.</span><span>Média</span></div><div class="data-empty-inline">Nenhuma nota lançada pela escola.</div></div><p class="agenda-intro">As notas são exibidas somente depois do lançamento pela escola.</p><button class="primary-button" type="button" data-download-report>Baixar boletim ↓</button></section>`;
        const badgeMarkup = `<section class="panel badge-panel" data-badge-panel><div class="panel-heading"><div><div class="eyebrow">Entrada segura</div><h2 style="margin-top:4px">Meu crachá escolar</h2></div><span class="agenda-count">QR pessoal</span></div><p class="agenda-intro">Gere seu crachá quando precisar. Mostre este código no celular ou baixe o PDF; o porteiro fará a leitura na entrada.</p><div class="badge-controls"><select data-badge-student-select aria-label="Escolher aluno"><option value="">Carregando aluno...</option></select><button class="text-button" type="button" data-show-badge>Gerar / exibir QR</button></div><div class="student-badge hidden" data-badge-card><div class="student-badge-copy"><span class="eyebrow">BFR Conecta · Entrada escolar</span><strong data-badge-name></strong><span data-badge-class></span><small>Apresente este QR na portaria</small></div><div class="badge-qr" data-badge-qr></div><button class="primary-button" type="button" data-print-badge>Baixar crachá em PDF</button></div><p class="publish-status" data-badge-status></p></section>`;
        const staffBadgeMarkup = `<section class="panel badge-panel" data-staff-badge-panel><div class="panel-heading"><div><div class="eyebrow">Emissão escolar</div><h2 style="margin-top:4px">Crachás dos alunos</h2></div><span class="paperless-tag">● ADMINISTRAÇÃO</span></div><p class="agenda-intro">Pesquise o aluno, confira a foto e a turma e gere o QR individual em PDF para enviar à família.</p><div class="badge-controls badge-staff-controls"><input type="search" data-staff-badge-search placeholder="Procurar aluno pelo nome" aria-label="Procurar aluno para crachá" autocomplete="off"><select data-staff-badge-class-filter aria-label="Filtrar crachá por turma"><option value="all">Todas as turmas</option></select><select data-staff-badge-select aria-label="Selecionar aluno para crachá"><option value="">Carregando lista oficial...</option></select><button class="primary-button" type="button" data-staff-generate-badge>Gerar crachá</button></div><div class="student-badge hidden" data-staff-badge-card><div class="student-badge-copy"><span class="eyebrow">BFR Conecta · Entrada escolar</span><strong data-staff-badge-name></strong><span data-staff-badge-class></span><small>Apresente este QR na portaria</small></div><div class="badge-qr" data-staff-badge-qr></div><button class="primary-button" type="button" data-print-badge>Baixar crachá em PDF</button></div><p class="publish-status" data-staff-badge-status></p></section>`;
         const gatekeeperMarkup = `<section class="gate-welcome"><div><div class="eyebrow">Portaria · presença de chegada</div><h1>Leitura do crachá.</h1><p>Escaneie o QR do aluno. Confira a foto e o nome antes de confirmar a passagem; a coordenação receberá o registro automaticamente.</p></div><div class="date-chip">● &nbsp; PORTARIA ONLINE</div></section><div class="gate-layout"><section class="panel gate-scanner-panel"><div class="panel-heading"><div><div class="eyebrow">Leitor de entrada</div><h2 style="margin-top:4px">Aponte para o QR</h2></div><span class="online-dot">● pronto</span></div><div class="gate-direction"><label>Sentido<select data-gate-direction><option value="entry">Entrada</option><option value="exit">Saída</option></select></label><button class="primary-button" type="button" data-start-gate-scanner>Ativar câmera</button></div><div id="qrReader" class="qr-reader"></div><form class="gate-manual-form" data-gate-manual-form><label>Leitura manual (se necessário)<input data-gate-token placeholder="Cole o identificador do crachá" autocomplete="off"></label><button class="text-button" type="submit">Registrar leitura manual →</button></form><p class="publish-status" data-gate-scan-status></p><div class="gate-last-checkin hidden" data-gate-last-checkin></div></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">Últimas leituras</div><h2 style="margin-top:4px">Acompanhamento</h2></div><span class="agenda-count">hoje</span></div><div class="gate-history-list" data-gate-history-list><div class="project-empty">Nenhuma leitura nesta sessão.</div></div></section></div>`;
