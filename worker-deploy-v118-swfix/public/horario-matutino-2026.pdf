       const familyRegistrationState = { requestedRole:'parent' };
       function normalizeCpfDigits(value) { return String(value || '').replace(/\D/g,''); }
       function validCpfDigits(value) {
         const digits = normalizeCpfDigits(value);
         if (digits.length !== 11 || /^([0-9])\1{10}$/.test(digits)) return false;
         let sum = 0;
         for (let index = 0; index < 9; index += 1) sum += Number(digits[index]) * (10 - index);
         let check = (sum * 10) % 11;
         if (check === 10) check = 0;
         if (check !== Number(digits[9])) return false;
         sum = 0;
         for (let index = 0; index < 10; index += 1) sum += Number(digits[index]) * (11 - index);
         check = (sum * 10) % 11;
         if (check === 10) check = 0;
         return check === Number(digits[10]);
       }
       async function hashCpf(value) {
         const data = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(normalizeCpfDigits(value)));
         return [...new Uint8Array(data)].map(byte => byte.toString(16).padStart(2,'0')).join('');
       }
      function openResponsibleRegistration(requestedRole = 'parent') {
        let modal = document.getElementById('responsibleRegistrationModal');
        if (!modal) {
          modal = document.createElement('div');
           modal.id = 'responsibleRegistrationModal';
           modal.className = 'modal';
           modal.setAttribute('role','dialog');
           modal.setAttribute('aria-modal','true');
           modal.setAttribute('aria-labelledby','responsibleRegistrationTitle');
           modal.setAttribute('aria-describedby','responsibleRegistrationDescription');
          document.body.appendChild(modal);
          modal.addEventListener('click', event => { if (event.target === modal || event.target.closest('[data-close-responsible-registration]')) modal.classList.add('hidden'); });
        }
         familyRegistrationState.requestedRole = requestedRole === 'student' ? 'student' : 'parent';
         const copy = familyRegistrationState.requestedRole === 'student' ? 'Confirme sua identificação escolar com os dados já cadastrados pela escola.' : 'Indique o aluno pelo qual você é responsável e confirme os dados oficiais.';
         modal.innerHTML = `<div class="modal-card responsible-registration-card"><button class="modal-close" type="button" data-close-responsible-registration aria-label="Fechar cadastro">×</button><div class="eyebrow">Acesso da família</div><h2>Confirme seu cadastro</h2><p>${copy} O CPF é usado somente para conferir o vínculo e não fica exposto no aplicativo.</p><form data-responsible-registration-form><label>Nome completo do aluno<input type="text" name="student_name" maxlength="160" autocomplete="off" required placeholder="Nome igual ao cadastro escolar"></label><label>Data de nascimento do aluno<input type="date" name="student_birth_date" required></label><label>Nome completo do responsável<input type="text" name="guardian_name" maxlength="160" autocomplete="name" required placeholder="Nome igual ao cadastro escolar"></label><label>CPF do responsável<input type="text" name="guardian_cpf" inputmode="numeric" maxlength="14" autocomplete="off" required placeholder="000.000.000-00"></label><button class="primary-button" type="submit">Confirmar e entrar no app</button><p class="publish-status" data-responsible-registration-status></p></form></div>`;
        modal.querySelector('[data-responsible-registration-form]').addEventListener('submit', completeFamilyRegistration);
        modal.querySelector('[name="guardian_cpf"]').addEventListener('input', event => { const digits = normalizeCpfDigits(event.currentTarget.value).slice(0,11); event.currentTarget.value = digits.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2'); });
        document.documentElement.classList.remove('auth-restoring');
        modal.classList.remove('hidden');
        modal.querySelector('[name="student_name"]').focus();
      }
      async function completeFamilyRegistration(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const status = form.querySelector('[data-responsible-registration-status]');
        const cpf = normalizeCpfDigits(form.guardian_cpf.value);
        if (!form.student_name.value.trim() || !form.student_birth_date.value || !form.guardian_name.value.trim()) { status.textContent = 'Preencha todos os dados para confirmar o cadastro.'; return; }
        if (!validCpfDigits(cpf)) { status.textContent = 'Informe um CPF válido.'; form.guardian_cpf.focus(); return; }
        status.textContent = 'Conferindo os dados com o cadastro da escola...';
        form.querySelector('button[type="submit"]').disabled = true;
        const { data:role, error } = await supabaseClient.rpc('complete_family_registration', { requested_role:familyRegistrationState.requestedRole, student_name:form.student_name.value.trim(), student_birth_date:form.student_birth_date.value, guardian_name:form.guardian_name.value.trim(), guardian_cpf:cpf });
        if (error) { status.textContent = error.message || 'Os dados não conferem com o cadastro escolar.'; form.querySelector('button[type="submit"]').disabled = false; return; }
         currentProfile = { ...currentProfile, role:role || familyRegistrationState.requestedRole };
         window.BFR_CURRENT_PROFILE = currentProfile;
        document.getElementById('responsibleRegistrationModal')?.classList.add('hidden');
        enterApp(role || familyRegistrationState.requestedRole);
        syncPushSubscription();
      }
      async function needsFamilyRegistration(profile, requestedRole = profile?.role) {
         if (!['parent','student'].includes(profile?.role) || !['parent','student'].includes(requestedRole)) return false;
        const { data:links, error } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id',currentUser.id).limit(1);
        if (error) { showAuthStatus('Não foi possível verificar o vínculo escolar. Tente novamente.', 'pending'); return true; }
        if (!links?.length) { openResponsibleRegistration(requestedRole); return true; }
        return false;
      }
       async function loadProfile(user) {
        if (profileLoadingId === user.id) return;
        profileLoadingId = user.id;
        currentUser = user;
        try {
              let { data: profileRows, error } = await supabaseClient.from('profiles').select('role,full_name,email,phone,display_name_custom').eq('id', user.id).limit(1);
             let profile = profileRows?.[0] || null;
             if (error) {
               document.documentElement.classList.remove('auth-restoring');
               showAuthStatus(`Não foi possível carregar o seu perfil (${error.code || 'erro de acesso'}).`, 'pending');
               return;
            }
           const selectedRole = sessionStorage.getItem('bfr-login-role');
            if (profile && selectedRole === 'student' && profile.role === 'parent') {
              const { data: chosenRole, error: roleChoiceError } = await supabaseClient.rpc('choose_initial_role', { requested_role:'student' });
              if (!roleChoiceError && chosenRole) profile = { ...profile, role:chosenRole };
            }
             if (profile?.role === 'admin' || profile?.role === 'administrator' || profile?.role === 'adm') profile = { ...profile, role:'developer' };
             if (profile?.role === 'direction' || profile?.role === 'direcao') profile = { ...profile, role:'director' };
             if (profile && selectedRole) sessionStorage.removeItem('bfr-login-role');
                currentProfile = profile;
                window.BFR_CURRENT_USER = currentUser;
                window.BFR_CURRENT_PROFILE = currentProfile;
                let appWasEntered = false;
                if (profile && profile.role !== 'pending' && !normalizePreferredName(profile.display_name_custom) && preferredNameState.skippedUserId !== user.id) {
                  enterApp(profile.role);
                  appWasEntered = true;
                  await openPreferredNameModal();
                }
                const requestedFamilyRole = ['parent','student'].includes(selectedRole) ? selectedRole : (['parent','student'].includes(profile?.role) ? profile.role : null);
               if (requestedFamilyRole && await needsFamilyRegistration(profile, requestedFamilyRole)) {
                 if (profile?.role !== 'pending' && !appWasEntered) enterApp(profile.role);
                 return;
              }
              if (!profile || profile.role === 'pending') {
                document.documentElement.classList.remove('auth-restoring');
                showAuthStatus(profile ? 'Cadastro de equipe recebido. Aguarde a aprovação da escola para acessar o portal.' : 'Seu cadastro ainda está sendo preparado. Tente novamente em instantes.', 'pending');
                return;
              }
            if (!appWasEntered) enterApp(profile.role);
            syncPushSubscription();
          } catch (error) {
            document.documentElement.classList.remove('auth-restoring');
            showAuthStatus(`Não foi possível abrir o seu perfil (${error?.code || 'erro inesperado'}).`, 'pending');
         } finally {
           profileLoadingId = null;
         }
      }
      const loginRoleStorageKey = 'bfr-login-role';
       function openLoginRoleChoice() {
        let modal = document.getElementById('loginRoleModal');
        if (!modal) {
          modal = document.createElement('div');
          modal.id = 'loginRoleModal';
          modal.className = 'modal hidden';
          modal.setAttribute('role','dialog');
          modal.setAttribute('aria-modal','true');
          document.body.appendChild(modal);
          modal.addEventListener('click', event => { if (event.target === modal || event.target.closest('[data-close-login-role]')) modal.classList.add('hidden'); });
        }
         modal.innerHTML = '<div class="modal-card login-role-choice"><button class="modal-close" type="button" data-close-login-role aria-label="Fechar escolha de perfil">×</button><div class="eyebrow">Primeiro acesso</div><h2>Como você vai usar o portal?</h2><p>Alunos e responsáveis confirmam os dados do cadastro escolar. Professores e funcionários passam por aprovação da escola.</p><div class="login-role-choice-grid"><button type="button" data-login-role="student"><strong>Sou aluno</strong><span>Vou acompanhar minhas notas, atividades e crachá.</span></button><button type="button" data-login-role="parent"><strong>Sou responsável</strong><span>Vou acompanhar um ou mais alunos da família.</span></button></div></div>';
        modal.querySelectorAll('[data-login-role]').forEach(button => button.addEventListener('click', () => startGoogleLogin(button.dataset.loginRole)));
        modal.classList.remove('hidden');
         modal.querySelector('[data-login-role="parent"]')?.focus();
       }
        async function withAuthTimeout(operation, timeoutMs) {
          let timer;
          const timeout = new Promise((_, reject) => { timer = setTimeout(() => reject(Object.assign(new Error('auth_timeout'), { code:'auth_timeout' })), timeoutMs); });
          try { return await Promise.race([Promise.resolve().then(operation), timeout]); }
          finally { clearTimeout(timer); }
        }
        async function exchangeOAuthCode(code) {
          const attempt = async client => {
            const result = await client.auth.exchangeCodeForSession(code);
            if (result.error) throw result.error;
            return result;
          };
          const callbackClient = window.supabase?.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, { auth:{ autoRefreshToken:true, persistSession:true, detectSessionInUrl:false, flowType:'pkce' } });
          if (!callbackClient) throw new Error('auth_client_unavailable');
          supabaseClient = callbackClient;
          return await withAuthTimeout(() => attempt(callbackClient), 15000);
        }
       async function startGoogleLogin(role) {
         sessionStorage.setItem(loginRoleStorageKey, role);
         try { await ensureSupabaseClient(); } catch {
           sessionStorage.removeItem(loginRoleStorageKey);
           showAuthStatus('O serviço de login não carregou. Verifique sua conexão e recarregue a página.', 'pending');
           return;
         }
        document.getElementById('loginRoleModal')?.classList.add('hidden');
        googleLogin.disabled = true;
        document.getElementById('googleLabel').textContent = 'Abrindo Google...';
         const redirectTo = `${APP_ORIGIN}/`;
        const { error } = await supabaseClient.auth.signInWithOAuth({ provider:'google', options:{ redirectTo, queryParams:{ prompt:'select_account' } } });
        if (error) {
          sessionStorage.removeItem(loginRoleStorageKey);
          googleLogin.disabled = false;
          document.getElementById('googleLabel').textContent = 'Continuar com Google';
          showAuthStatus(`Login indisponível: ${error.message}`, 'pending');
         }
      }
      googleLogin.addEventListener('click', openLoginRoleChoice);
      document.querySelectorAll('[data-logout]').forEach(button => button.addEventListener('click', async event => {
        const button = event.currentTarget;
        button.disabled = true;
        button.textContent = 'Saindo...';
        const { error } = await supabaseClient.auth.signOut();
        if (error) {
          button.disabled = false;
          button.innerHTML = button.id === 'logoutBtn' ? '<span class="nav-icon">↪</span>Sair da conta' : 'Sair';
          showAuthStatus('Não foi possível sair agora. Tente novamente.', 'pending');
          return;
        }
        window.location.replace(`${APP_ORIGIN}/`);
      }));
        async function restoreAuthSession() {
          try { await ensureSupabaseClient(); } catch { showAuthStatus('O serviço de login não carregou. Recarregue a página e tente novamente.', 'pending'); return; }
         const params = new URLSearchParams(location.search);
         const hashParams = new URLSearchParams(location.hash.replace(/^#/, ''));
         const oauthError = params.get('error_description') || params.get('error') || hashParams.get('error_description') || hashParams.get('error');
         if (oauthError) {
           sessionStorage.removeItem(loginRoleStorageKey);
           showAuthStatus(`Não foi possível concluir o login: ${oauthError}`, 'pending');
            history.replaceState({}, document.title, `${location.origin}${location.pathname}${location.hash}`);
           return;
         }
          const code = params.get('code');
          const accessToken = hashParams.get('access_token');
          const refreshToken = hashParams.get('refresh_token');
           if (code || (accessToken && refreshToken)) {
             document.documentElement.classList.add('auth-restoring');
             authCallbackPending = true;
            showAuthStatus('Concluindo o login com o Google...', 'pending');
             history.replaceState({}, document.title, `${location.origin}${location.pathname}`);
            try {
              const result = code
                ? await exchangeOAuthCode(code)
                : await supabaseClient.auth.setSession({ access_token:accessToken, refresh_token:refreshToken });
              if (result.error) throw result.error;
             if (result.data?.session?.user) {
               authCallbackPending = false;
               loadProfile(result.data.session.user);
               return;
             }
            } catch (error) {
              authCallbackPending = false;
              sessionStorage.removeItem(loginRoleStorageKey);
              document.documentElement.classList.remove('auth-restoring');
              showAuthStatus(`Não foi possível concluir o login (${error?.code || 'erro de autenticação'}).`, 'pending');
             return;
           }
            authCallbackPending = false;
            sessionStorage.removeItem(loginRoleStorageKey);
            document.documentElement.classList.remove('auth-restoring');
            showAuthStatus('O Google não devolveu uma sessão para este acesso. Tente novamente.', 'pending');
         }
       }
        let authListenerReady = false;
        function setupAuthListener() {
          if (!supabaseClient || authListenerReady) return;
          authListenerReady = true;
          supabaseClient.auth.onAuthStateChange((_, session) => {
            if (session?.user) {
              authCallbackPending = false;
              setTimeout(() => loadProfile(session.user), 0);
            }
          });
        }
        ensureSupabaseClient().then(() => { setupAuthListener(); return restoreAuthSession(); }).catch(() => { document.documentElement.classList.remove('auth-restoring'); showAuthStatus('Não foi possível concluir o login. Recarregue a página e tente novamente.', 'pending'); });
       function gradeAverage(values) {
         const numbers = values.map(Number).filter(Number.isFinite);
         return numbers.length ? numbers.reduce((sum, value) => sum + value, 0) / numbers.length : null;
       }
       function gradeDisplay(value) { return value == null ? '—' : Number(value).toFixed(1).replace('.', ','); }
       function renderRealGradeReport(host, grades, averageHost) {
         if (!host) return;
         const grouped = new Map();
         (grades || []).forEach(grade => {
           const subject = String(grade.subject || 'Componente não informado');
           const term = Number(grade.term) || 0;
           if (!grouped.has(subject)) grouped.set(subject, { terms:new Map(), scores:[] });
           const item = grouped.get(subject);
           const score = Number(grade.score);
           if (!Number.isFinite(score)) return;
           item.scores.push(score);
           if (!item.terms.has(term)) item.terms.set(term, []);
           item.terms.get(term).push(score);
         });
         const order = typeof officialSubjects !== 'undefined' ? officialSubjects : [];
         const subjects = [...grouped.keys()].sort((a,b) => (order.indexOf(a) - order.indexOf(b)) || a.localeCompare(b, 'pt-BR'));
          host.innerHTML = `<div class="report-row report-header"><span>Componente</span><span>1º bim.</span><span>2º bim.</span><span>3º bim.</span><span>4º bim.</span><span>Média</span></div>` + (subjects.length ? subjects.map(subject => {
            const item = grouped.get(subject);
            return `<div class="report-row"><b>${escapeHtml(subject)}</b>${[1,2,3,4].map(term => `<span>${gradeDisplay(gradeAverage(item.terms.get(term) || []))}</span>`).join('')}<strong>${gradeDisplay(gradeAverage(item.scores))}</strong></div>`;
         }).join('') : '<div class="data-empty-inline">Nenhuma nota lançada pela escola.</div>');
         if (averageHost) averageHost.textContent = gradeDisplay(gradeAverage((grades || []).map(item => item.score)));
       }
       function ensureDataStatus(view, attribute, message) {
         if (!view) return null;
         let status = view.querySelector(`[${attribute}]`);
         if (!status) {
           status = document.createElement('p');
           status.className = 'publish-status';
           status.setAttribute(attribute, 'true');
           view.querySelector('.welcome, .teacher-welcome, .gate-welcome')?.after(status);
         }
         status.textContent = message || '';
         status.classList.toggle('hidden', !message);
         return status;
       }
       function syncParentStudentSelector() {
         const child = parentView?.querySelector('.child-card');
         const students = parentDataState.students || [];
         if (!child) return;
         let selector = child.querySelector('[data-parent-student-select]');
          if (students.length) {
           if (!selector) {
             const label = document.createElement('label');
             label.className = 'parent-student-switcher';
             label.innerHTML = '<span>Aluno selecionado</span><select data-parent-student-select aria-label="Escolher aluno"></select>';
             child.querySelector('.child-info')?.after(label);
             selector = label.querySelector('select');
             selector.addEventListener('change', () => {
                parentDataState.activeStudentId = selector.value;
             renderParentStudentData();
             window.BFRParentDashboard?.render();
             renderParentOccurrences(parentDataState.occurrences.filter(item => item.student_id === parentDataState.activeStudentId));
             });
           }
           selector.innerHTML = students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)}</option>`).join('');
            selector.value = parentDataState.activeStudentId || students[0].id;
            selector.disabled = false;
         } else if (selector) selector.closest('.parent-student-switcher')?.remove();
       }
       function renderParentStudentData() {
         const student = (parentDataState.students || []).find(item => item.id === parentDataState.activeStudentId) || parentDataState.students?.[0];
          if (!student) return;
          parentDataState.activeStudentId = student.id;
          syncParentStudentSelector();
         const classes = parentDataState.classes || [];
         const classData = classes.find(item => item.id === student.class_id);
         const grades = (parentDataState.grades || []).filter(item => item.student_id === student.id);
         const attendance = (parentDataState.attendance || []).filter(item => item.student_id === student.id);
         const child = parentView?.querySelector('.child-card');
         if (child) {
            child.querySelector('.child-info strong').textContent = student.official_name;
            child.querySelector('.child-info span').textContent = classData ? `${classData.year}º ano ${classData.class_code} · Ensino Fundamental` : 'Turma ainda não informada';
            child.querySelector('[data-child-school-status]')?.replaceChildren(document.createTextNode('Matrícula ativa'));
            child.querySelector('[data-child-school-status]')?.classList.remove('hidden');
            child.querySelector('.avatar').textContent = student.official_name.split(/\s+/).map(part => part[0]).slice(0,2).join('').toUpperCase();
           const today = attendance.find(item => item.attendance_date === schoolTodayIso());
           child.querySelector('[data-live-attendance-status]').textContent = { present:'Presente', late:'Atrasado', absent:'Falta', justified:'Justificada' }[today?.status] || '—';
         }
         const cards = parentView?.querySelectorAll('.overview-grid .metric-card') || [];
         const present = attendance.filter(item => item.status === 'present' || item.status === 'late').length;
         const attendanceRate = attendance.length ? `${((present / attendance.length) * 100).toFixed(1).replace('.', ',')}%` : '—';
         if (cards[0]) {
           cards[0].querySelector('.metric-value strong').textContent = attendanceRate;
           cards[0].querySelector('.metric-value span').textContent = attendance.length ? 'registro atualizado' : 'sem registros';
           cards[0].querySelector('.metric-foot').textContent = attendance.length ? `Presente em ${present} de ${attendance.length} dias` : 'A escola ainda não registrou frequência';
         }
         if (cards[1]) {
           cards[1].querySelector('.metric-value strong').textContent = gradeDisplay(gradeAverage(grades.map(item => item.score)));
           cards[1].querySelector('.metric-value span').textContent = grades.length ? 'média atual' : 'sem lançamentos';
           cards[1].querySelector('.metric-foot').textContent = grades.length ? `${grades.length} lançamento${grades.length === 1 ? '' : 's'} no boletim` : 'A escola ainda não lançou notas';
         }
         renderRealGradeReport(parentView?.querySelector('#boletimPanel .report-table'), grades, parentView?.querySelector('#boletimPanel .report-average strong'));
       }
       async function setupParentRealtime(force = false) {
          if (!supabaseClient || !currentUser || !['parent','developer'].includes(currentProfile?.role) || parentDataState.loading || (!force && parentDataState.loaded)) return;
         parentDataState.loading = true;
         try {
           parentView?.querySelector('#noticiasPanel')?.classList.remove('hidden');
            parentView?.querySelector('#enquetesPanel')?.classList.add('hidden');
            setEmptyContent(parentView?.querySelector('#photoStrip'), 'Nenhuma foto publicada pela escola.');
           const { data:links, error:linksError } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id', currentUser.id);
           if (linksError) { showParentDataStatus('Não foi possível carregar o vínculo escolar. Tente novamente.'); return; }
           const studentIds = (links || []).map(item => item.student_id).filter(Boolean);
           if (!studentIds.length) { parentDataState.loaded = true; showParentDataStatus('A escola ainda não vinculou um aluno a esta conta.'); return; }
           const [{ data:students, error:studentsError }, { data:classes, error:classesError }, { data:grades, error:gradesError }, { data:attendance, error:attendanceError }, { data:occurrences, error:occurrencesError }] = await Promise.all([
              supabaseClient.from('students').select('id,official_name,class_id').in('id', studentIds).eq('active', true).order('official_name'),
              supabaseClient.from('classes').select('id,year,class_code,shift').order('year').order('class_code'),
             supabaseClient.from('grades').select('student_id,subject,assessment,score,term,created_at').in('student_id', studentIds).order('created_at',{ascending:false}),
             supabaseClient.from('attendance').select('student_id,attendance_date,status').in('student_id', studentIds).order('attendance_date',{ascending:false}),
              supabaseClient.from('occurrences').select('id,student_id,title,description,occurred_at,acknowledged_at').in('student_id', studentIds).order('occurred_at',{ascending:false}).limit(50)
           ]);
           if (studentsError || classesError || gradesError || attendanceError || !students?.length) { showParentDataStatus('Não foi possível carregar os dados escolares. Tente novamente.'); return; }
           parentDataState.students = students;
           growthState.studentIds = studentIds;
            parentDataState.classes = classes || [];
            parentDataState.grades = grades || [];
            parentDataState.attendance = attendance || [];
            parentDataState.occurrences = occurrencesError ? [] : (occurrences || []);
            ensureParentScheduleSummary();
            ensureParentEntryLivePanel();
            renderParentScheduleSummary();
            syncParentStudentSelector();
            renderParentStudentData();
            renderParentOccurrences(parentDataState.occurrences.filter(item => item.student_id === parentDataState.activeStudentId));
            parentDataState.loaded = true;
            showParentDataStatus('');
             startParentGateRealtime();
             loadParentGateCheckins(true);
             window.BFRParentDashboard?.render();
             window.BFRParentAreaRefinement?.render();
             setTimeout(setupGrowthFeatures, 0);
         } finally { parentDataState.loading = false; }
       }
       const studentDataState = { loaded:false, loading:false, student:null, grades:[], attendance:[] };
       async function setupStudentRealtime(force = false) {
         if (!studentView || !supabaseClient || !currentUser || currentProfile?.role !== 'student' || studentDataState.loading || (!force && studentDataState.loaded)) return;
         ensureLearningViews();
         studentDataState.loading = true;
         try {
           const { data:links, error:linksError } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id', currentUser.id);
            if (linksError || !links?.length) { resetStudentJourney(); renderStudentJourney(); ensureDataStatus(studentView, 'data-student-status', 'A escola ainda não vinculou este login ao cadastro de um aluno.'); return; }
           const studentId = links[0].student_id;
           const [{ data:students, error:studentsError }, { data:grades, error:gradesError }, { data:attendance, error:attendanceError }] = await Promise.all([
             supabaseClient.from('students').select('id,official_name,class_id').eq('id', studentId).eq('active', true).maybeSingle(),
             supabaseClient.from('grades').select('student_id,subject,assessment,score,term,created_at').eq('student_id', studentId).order('created_at',{ascending:false}),
             supabaseClient.from('attendance').select('student_id,attendance_date,status').eq('student_id', studentId).order('attendance_date',{ascending:false})
           ]);
           if (studentsError || gradesError || attendanceError || !students) { ensureDataStatus(studentView, 'data-student-status', 'Não foi possível carregar seus dados escolares.'); return; }
           studentDataState.student = students;
           growthState.studentIds = [studentId];
            studentDataState.grades = grades || [];
            studentDataState.attendance = attendance || [];
            await loadStudentJourney(studentId);
           const cards = studentView.querySelectorAll('.overview-grid .metric-card');
           const average = gradeAverage(studentDataState.grades.map(item => item.score));
           const present = studentDataState.attendance.filter(item => item.status === 'present' || item.status === 'late').length;
           const rate = studentDataState.attendance.length ? `${((present / studentDataState.attendance.length) * 100).toFixed(1).replace('.', ',')}%` : '—';
           if (cards[0]) { cards[0].querySelector('.metric-value strong').textContent = gradeDisplay(average); cards[0].querySelector('.metric-value span').textContent = average == null ? 'sem lançamentos' : 'média atual'; cards[0].querySelector('.metric-foot').textContent = average == null ? 'A escola ainda não lançou notas' : `${studentDataState.grades.length} lançamento${studentDataState.grades.length === 1 ? '' : 's'} no boletim`; }
           if (cards[1]) { cards[1].querySelector('.metric-value strong').textContent = rate; cards[1].querySelector('.metric-value span').textContent = studentDataState.attendance.length ? 'registro atualizado' : 'sem registros'; cards[1].querySelector('.metric-foot').textContent = studentDataState.attendance.length ? `Presente em ${present} de ${studentDataState.attendance.length} dias` : 'A escola ainda não registrou frequência'; }
            const name = studentDataState.student.official_name;
            studentView.querySelector('h1').textContent = `Olá, ${name.split(/\s+/)[0]}!`;
            renderRealGradeReport(studentView.querySelector('[data-student-report] .report-table'), studentDataState.grades, studentView.querySelector('[data-student-report] .report-average strong'));
            renderStudentJourney();
            studentDataState.loaded = true;
           ensureDataStatus(studentView, 'data-student-status', '');
           setTimeout(setupGrowthFeatures, 0);
         } finally { studentDataState.loading = false; }
       }
       async function downloadStudentReport(button) {
         const originalLabel = button.textContent;
         button.textContent = 'Preparando boletim...';
         let studentIds = [];
         if (currentProfile?.role === 'parent' || currentProfile?.role === 'student') {
           const { data:links } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id', currentUser.id);
           studentIds = (links || []).map(item => item.student_id).filter(Boolean);
         }
         if (currentProfile?.role === 'student' && studentDataState.student) studentIds = [studentDataState.student.id];
         const [{ data:students }, { data:grades }] = studentIds.length ? await Promise.all([
           supabaseClient.from('students').select('id,official_name').in('id', studentIds),
           supabaseClient.from('grades').select('student_id,subject,assessment,score,term').in('student_id', studentIds).order('term')
         ]) : [{ data:[] }, { data:[] }];
         const names = new Map((students || []).map(item => [item.id, item.official_name]));
         const rows = [['Aluno','Componente curricular','Avaliação','Nota','Bimestre']];
         (grades || []).forEach(grade => rows.push([names.get(grade.student_id) || 'Aluno', grade.subject || 'Componente não informado', grade.assessment || 'Avaliação', gradeDisplay(grade.score), `${grade.term || '—'}º bimestre`]));
         if (rows.length === 1) rows.push(['Nenhuma nota lançada','','','','']);
         try { saveBlob(reportPdfBlob(rows), `boletim-bfr-${new Date().toISOString().slice(0,10)}.pdf`); button.textContent = 'Boletim baixado ✓'; }
         catch { button.textContent = 'Não foi possível gerar o PDF'; }
         setTimeout(() => { button.textContent = originalLabel; }, 2500);
       }
       async function loadAcademicClass(classId) {
         const panel = document.getElementById('academicPanel');
         const selected = academicState.classes.find(item => item.id === classId);
         if (!panel || !selected || !supabaseClient) return;
         academicState.classId = selected.id;
         panel.querySelector('.panel-heading h2').textContent = `Notas e frequência · ${selected.year}º ano ${selected.class_code}`;
         panel.querySelector('.agenda-intro').textContent = 'Notas e frequência reais da turma. Professores podem lançar notas e registrar a presença do dia.';
         const status = document.getElementById('academicStatus');
         status.textContent = 'carregando';
         const { data:students, error:studentsError } = await supabaseClient.from('students').select('id,official_name').eq('class_id', selected.id).eq('active', true).order('official_name');
         const ids = (students || []).map(item => item.id);
         const gradesQuery = ids.length ? supabaseClient.from('grades').select('student_id,subject,assessment,score,term,created_at').in('student_id', ids).order('created_at',{ascending:false}) : Promise.resolve({ data:[], error:null });
         const attendanceQuery = ids.length ? supabaseClient.from('attendance').select('student_id,attendance_date,status').in('student_id', ids).order('attendance_date',{ascending:false}) : Promise.resolve({ data:[], error:null });
         const [{ data:grades, error:gradesError }, { data:attendance, error:attendanceError }] = await Promise.all([gradesQuery, attendanceQuery]);
         if (studentsError || gradesError || attendanceError) { status.textContent = 'erro de conexão'; return; }
         academicState.students = students || [];
         academicState.grades = grades || [];
         academicState.attendance = attendance || [];
         status.textContent = `${academicState.students.length} alunos · ${academicState.grades.length} notas`;
         const today = schoolTodayIso();
         const todayAttendance = academicState.attendance.filter(item => item.attendance_date === today);
         const presentToday = todayAttendance.filter(item => item.status === 'present' || item.status === 'late').length;
         const classAverage = gradeAverage(academicState.grades.map(item => item.score));
         const metrics = teacherView?.querySelectorAll('.teacher-metric strong') || [];
         if (metrics[0]) metrics[0].innerHTML = `${presentToday} <small style="font:11px 'DM Sans';color:#7e928b">/ ${academicState.students.length}</small>`;
         if (metrics[1]) metrics[1].textContent = gradeDisplay(classAverage);
         const gradeStudent = document.getElementById('gradeStudent');
         if (gradeStudent) gradeStudent.innerHTML = academicState.students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)}</option>`).join('');
         renderAcademicTable();
         loadTeacherInbox();
       }
       async function setupAcademicPanel() {
         const panel = document.getElementById('academicPanel');
         if (!panel || !supabaseClient || !['pedagogical','developer'].includes(currentProfile?.role)) return;
         const { data:classes, error } = await supabaseClient.from('classes').select('id,year,class_code,shift').order('year').order('class_code');
         if (error || !classes?.length) { document.getElementById('academicStatus').textContent = 'turmas indisponíveis'; return; }
         academicState.classes = classes;
         let picker = panel.querySelector('[data-academic-class-picker]');
         if (!picker) {
           panel.querySelector('.class-tabs')?.insertAdjacentHTML('beforebegin', '<label data-academic-class-picker style="display:block;max-width:260px;margin:0 0 10px;font-size:10px;color:var(--muted)">Turma<select id="academicClassSelector" style="display:block;width:100%;margin-top:5px;border:1px solid var(--line);border-radius:8px;padding:9px;background:#fff;color:var(--ink)"></select></label>');
           picker = panel.querySelector('[data-academic-class-picker]');
           const select = picker.querySelector('select');
           select.innerHTML = classes.map(item => `<option value="${item.id}">${item.year}º ano ${escapeHtml(item.class_code)} · ${escapeHtml(item.shift || 'turno não informado')}</option>`).join('');
           select.addEventListener('change', () => loadAcademicClass(select.value));
         }
         const preferred = classes.find(item => Number(item.year) === 6 && item.class_code === 'A') || classes[0];
         picker.querySelector('select').value = preferred.id;
         if (!panel.dataset.academicControls) {
           panel.dataset.academicControls = 'true';
           panel.querySelector('.class-tabs').insertAdjacentHTML('afterend', '<div id="attendanceControls" class="hidden" style="display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin:14px 0 4px;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fbfdfb"><label style="margin:0;flex:0 0 160px">Data<input id="attendanceDate" type="date" style="margin-top:5px"></label><button class="primary-button" id="saveAttendanceBtn" type="button">Salvar frequência</button><span id="attendanceSaveStatus" style="font-size:11px;color:var(--muted)"></span></div>');
           document.getElementById('attendanceDate').value = schoolTodayIso();
           document.getElementById('attendanceDate').addEventListener('change', renderAcademicTable);
           document.getElementById('saveAttendanceBtn').addEventListener('click', saveAttendance);
           panel.querySelectorAll('[data-academic-tab]').forEach(button => button.addEventListener('click', () => { academicState.tab = button.dataset.academicTab; panel.querySelectorAll('[data-academic-tab]').forEach(item => item.classList.toggle('active', item === button)); renderAcademicTable(); }));
         }
         setupGradeForm();
         ensureTeacherInboxView();
         await loadAcademicClass(preferred.id);
       }
       function ensureTeacherInboxView() {
         if (!teacherView || teacherView.querySelector('[data-teacher-inbox]')) return;
         teacherView.insertAdjacentHTML('beforeend', '<section class="panel" data-teacher-inbox><div class="panel-heading"><div><div class="eyebrow">Comunicação com as famílias</div><h2 style="margin-top:4px">Recados recebidos</h2></div><span class="agenda-count" data-teacher-inbox-count>0</span></div><p class="agenda-intro">Mensagens vinculadas à turma selecionada. Respostas ficam registradas no histórico do aluno.</p><div data-teacher-inbox-list><div class="project-empty">Carregando recados...</div></div></section>');
         if (!document.body.dataset.teacherInboxActions) {
           document.body.dataset.teacherInboxActions = 'true';
           document.addEventListener('submit', async event => {
             const form = event.target.closest('[data-teacher-reply-form]');
             if (!form) return;
             event.preventDefault();
             const body = form.querySelector('textarea').value.trim();
             const status = form.querySelector('[data-teacher-reply-status]');
             if (!body || !currentUser) return;
             status.textContent = 'Enviando...';
             const { error } = await supabaseClient.from('student_messages').insert({ student_id:form.dataset.studentId, sender_id:currentUser.id, recipient_id:form.dataset.recipientId || null, category:'general', body });
             if (error) { status.textContent = 'Não foi possível enviar.'; return; }
             form.reset();
             status.textContent = 'Resposta enviada.';
           });
         }
       }
       function renderTeacherInbox(items) {
         const panel = teacherView?.querySelector('[data-teacher-inbox]');
         const list = panel?.querySelector('[data-teacher-inbox-list]');
         if (!panel || !list) return;
         panel.querySelector('[data-teacher-inbox-count]').textContent = String(items.length);
         list.innerHTML = items.length ? items.map(item => `<article style="padding:12px 0;border-top:1px solid var(--line)"><div style="display:flex;justify-content:space-between;gap:10px"><strong>${escapeHtml(item.studentName || 'Aluno')}</strong><small style="color:var(--muted)">${new Date(item.created_at).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</small></div><p style="margin:6px 0;color:var(--muted);font-size:11px">${escapeHtml(item.body)}</p><small style="color:var(--muted)">${escapeHtml(item.category || 'Recado geral')}</small>${item.sender_id ? `<form data-teacher-reply-form data-student-id="${item.student_id}" data-recipient-id="${item.sender_id}" style="display:flex;gap:6px;margin-top:9px"><textarea required rows="2" placeholder="Responder à família" style="flex:1;resize:vertical;border:1px solid var(--line);border-radius:8px;padding:8px;font-size:10px"></textarea><button class="text-button" type="submit">Responder</button><span data-teacher-reply-status style="font-size:10px;color:var(--muted);align-self:end"></span></form>` : ''}</article>`).join('') : '<div class="project-empty">Nenhum recado para a turma selecionada.</div>';
       }
       async function loadTeacherInbox() {
         ensureTeacherInboxView();
         const ids = (academicState.students || []).map(item => item.id);
         if (!supabaseClient || !ids.length) { renderTeacherInbox([]); return; }
         const [directResult, schoolResult] = await Promise.all([
           supabaseClient.from('student_messages').select('id,student_id,sender_id,recipient_id,category,body,created_at').eq('recipient_id', currentUser.id).in('student_id', ids).order('created_at',{ascending:false}),
           supabaseClient.from('student_messages').select('id,student_id,sender_id,recipient_id,category,body,created_at').is('recipient_id', null).in('student_id', ids).order('created_at',{ascending:false})
         ]);
         const messages = [...(directResult.data || []), ...(schoolResult.data || [])].sort((a,b) => new Date(b.created_at) - new Date(a.created_at));
         const names = new Map((academicState.students || []).map(item => [item.id, item.official_name]));
         renderTeacherInbox(messages.map(item => ({ ...item, studentName:names.get(item.student_id) })));
       }
       function ensureBadgeRevokeControls() {
         document.querySelectorAll('[data-staff-badge-card]').forEach(card => {
           if (card.querySelector('[data-revoke-badge]')) return;
           const button = document.createElement('button');
           button.type = 'button';
           button.className = 'text-button';
           button.dataset.revokeBadge = 'true';
           button.textContent = 'Revogar e gerar novo QR';
           button.style.marginTop = '8px';
           card.appendChild(button);
         });
       }
       async function revokeStudentBadge(button) {
         const panel = button.closest('[data-staff-badge-panel]');
         const studentId = panel?.querySelector('[data-staff-badge-select]')?.value;
         const student = badgeState.students.find(item => item.id === studentId);
         const status = panel?.querySelector('[data-staff-badge-status]');
         if (!student || !supabaseClient || currentProfile?.role !== 'developer') { if (status) status.textContent = 'Somente a administração pode revogar um crachá.'; return; }
         if (!window.confirm(`Revogar o QR atual de ${student.official_name} e gerar outro? O código antigo deixará de funcionar.`)) return;
         button.disabled = true;
         if (status) status.textContent = 'Revogando QR anterior...';
         const { data, error } = await supabaseClient.from('gate_badges').update({ badge_token:crypto.randomUUID(), active:true }).eq('student_id',student.id).select('student_id,badge_token,active').single();
         button.disabled = false;
         if (error || !data) { if (status) status.textContent = 'Não foi possível revogar o crachá. Verifique a permissão da tabela.'; return; }
         badgeState.badges = badgeState.badges.filter(item => item.student_id !== student.id).concat(data);
         renderBadgeCard(panel.querySelector('[data-staff-badge-card]'),'[data-staff-badge-name]','[data-staff-badge-class]','[data-staff-badge-qr]',student,data);
         if (status) status.textContent = 'QR anterior revogado. Novo crachá gerado.';
       }
        const growthState = { studentIds:[], notifications:[], calendar:[], messages:[], loaded:false, calendarLoaded:false, messagesLoaded:false, requestsLoaded:false, documentsLoaded:false, achievementsLoaded:false, profilesLoaded:false, indicatorsLoaded:false, timer:null, idleScheduled:false };
       function ensureGrowthStyles() {
         if (document.getElementById('growthStyles')) return;
         const style = document.createElement('style');
         style.id = 'growthStyles';
         style.textContent = `.growth-hub{background:linear-gradient(135deg,#edf4ff,#fff);border-color:#cfe0f5}.growth-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.growth-action{border:1px solid #d8e4f3;background:#fff;border-radius:10px;color:#245ccf;padding:9px 11px;font-size:10px}.growth-action:hover{border-color:#8db3e9;background:#f5f9ff}.growth-list{display:grid;gap:0}.growth-item{padding:12px 0;border-top:1px solid var(--line)}.growth-item:first-child{border-top:0}.growth-item-top{display:flex;justify-content:space-between;gap:10px}.growth-item small,.growth-muted{color:var(--muted);font-size:10px}.growth-item p{margin-top:5px;color:#61708b;font-size:11px;line-height:1.45}.growth-filter{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}.growth-filter select,.growth-form input,.growth-form select,.growth-form textarea{width:100%;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);padding:9px;font-size:10px}.growth-form{display:grid;gap:9px}.growth-form label{display:grid;gap:5px;color:var(--muted);font-size:10px}.growth-form button{justify-self:start}.growth-status{min-height:16px;margin-top:8px;color:var(--muted);font-size:10px}.growth-metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.growth-metric{padding:13px;border:1px solid var(--line);border-radius:11px;background:#fbfcff}.growth-metric strong{display:block;margin-top:6px;color:#1558dc;font-size:24px}.growth-profile-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.growth-profile{padding:14px;border:1px solid var(--line);border-radius:12px;background:#fff}.growth-profile h3{font-size:14px;color:#1e2d4c}.growth-profile p{margin-top:6px;color:var(--muted);font-size:10px;line-height:1.5}.growth-badge-list{display:flex;flex-wrap:wrap;gap:9px}.growth-badge{min-width:170px;padding:12px;border:1px solid #e5dd9c;border-radius:11px;background:#fffbed}.growth-badge b{font-size:21px}.growth-badge strong{display:block;margin-top:4px;font-size:11px}.growth-badge span{display:block;margin-top:3px;color:#7f7651;font-size:10px}@media(max-width:700px){.growth-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.tap-target{min-height:44px!important;touch-action:manipulation;-webkit-tap-highlight-color:rgba(37,99,235,.18)}.project-tab,.class-tab,.schedule-shift,.game-subject,.growth-action{min-height:44px}.project-tab,.class-tab{padding-left:14px;padding-right:14px}.growth-action{display:inline-flex;align-items:center;justify-content:center}`;
         style.textContent += '}';
         document.head.appendChild(style);
       }
        function growthHubMarkup(role = 'parent') { const actions = [['notifications','🔔 Notificações'],['calendar','📅 Calendário']]; if (['parent','student','admin'].includes(role)) actions.push(['documents','📁 Documentos']); if (role === 'parent') actions.splice(1,0,['messages','💬 Comunicação com a escola']); if (role === 'parent') actions.push(['requests','📝 Atendimento escolar']); if (['parent','student'].includes(role)) actions.push(['profile','👤 Perfil do aluno']); return `<section class="panel growth-hub" data-growth-hub><div class="eyebrow">BFR Conecta · próximos passos</div><h2 style="margin-top:5px">Tudo o que a escola precisa, em um só lugar</h2><p class="agenda-intro">Acesse rapidamente notificações, calendário e serviços disponíveis para o seu perfil.</p><div class="growth-actions">${actions.map(([target,label]) => `<button class="growth-action" type="button" data-growth-target="growth-${target}">${label}</button>`).join('')}</div></section>`; }
        function growthNotificationsMarkup() { return `<section class="panel" data-growth-notifications id="growth-notifications"><div class="panel-heading"><div><div class="eyebrow">Atualizações importantes</div><h2 style="margin-top:4px">Notificações</h2></div><span class="agenda-count" data-growth-notification-count>0</span></div><p class="agenda-intro">Notas, faltas, atividades, comunicados, eventos e mensagens recentes. Após autorizar, o push pode chegar mesmo com o portal fechado.</p><div class="growth-actions"><button class="growth-action" type="button" data-enable-browser-alerts>Ativar alertas deste navegador</button></div><div class="growth-status" data-growth-notification-status></div><div class="growth-list" data-growth-notification-list><div class="project-empty">Carregando atualizações...</div></div></section>`; }
       function growthCalendarMarkup() { return `<section class="panel" data-growth-calendar id="growth-calendar"><div class="panel-heading"><div><div class="eyebrow">Organização escolar</div><h2 style="margin-top:4px">Calendário BFR</h2></div><span class="agenda-count">próximos itens</span></div><p class="agenda-intro">Eventos da escola e atividades com prazo, reunidos em uma única agenda.</p><div class="growth-filter"><select data-growth-calendar-filter aria-label="Filtrar calendário"><option value="all">Todos</option><option value="event">Eventos</option><option value="activity">Atividades</option></select></div><div class="growth-list" data-growth-calendar-list><div class="project-empty">Carregando calendário...</div></div></section>`; }
       function growthMessagesMarkup() { return `<section class="panel" data-growth-messages id="growth-messages"><div class="panel-heading"><div><div class="eyebrow">Comunicação com a escola</div><h2 style="margin-top:4px">Mensagens</h2></div><span class="agenda-count" data-growth-message-count>0</span></div><p class="agenda-intro">Envie um recado para a equipe escolar e acompanhe o histórico vinculado ao aluno.</p><div class="growth-list" data-growth-message-list><div class="project-empty">Carregando mensagens...</div></div><form class="growth-form" data-growth-message-form><label>Aluno<select name="student_id" data-growth-message-student required><option value="">Carregando alunos...</option></select></label><label>Mensagem<textarea name="body" rows="3" maxlength="2000" required placeholder="Escreva seu recado para a escola."></textarea></label><button class="primary-button" type="submit">Enviar mensagem</button><div class="growth-status" data-growth-message-status></div></form></section>`; }
       function growthSchoolMarkup() { return `<section class="panel" data-growth-school id="growth-school"><div class="panel-heading"><div><div class="eyebrow">Identidade institucional</div><h2 style="margin-top:4px">Minha escola</h2></div><span class="agenda-count">BFR</span></div><div class="growth-profile"><h3>Escola Benício Ferreira Reis</h3><p>Escola Municipal de Educação Básica Prefeito Benício Ferreira Reis, no Distrito Pé Leve, em Limoeiro de Anadia, Alagoas.</p><p>O BFR Conecta aproxima famílias, estudantes e equipe escolar com comunicação clara, acompanhamento pedagógico e valorização dos projetos da comunidade.</p><p class="growth-muted">Endereço, contatos da secretaria e horários de atendimento serão publicados pela administração quando confirmados.</p></div></section>`; }
        function growthDocumentsMarkup(isAdmin = false) { return `<section class="panel" data-growth-documents id="growth-documents"><div class="panel-heading"><div><div class="eyebrow">Atendimento da Secretaria</div><h2 style="margin-top:4px">Documentos da Secretaria</h2></div><span class="agenda-count" data-growth-document-count>0</span></div><p class="agenda-intro">Declarações, históricos, autorizações e documentos emitidos pela Secretaria.</p><div class="growth-actions"><button class="growth-action" type="button" data-growth-target="growth-requests">Solicitar documento à Secretaria</button></div><div class="growth-list" data-growth-document-list><div class="project-empty">Carregando documentos...</div></div>${isAdmin ? '<form class="growth-form" data-growth-document-form style="margin-top:16px"><label>Título<input name="title" required maxlength="140" placeholder="Ex.: Regimento escolar"></label><label>Categoria<select name="category"><option>Documentos escolares</option><option>Calendário letivo</option><option>Autorizações</option><option>Guias para famílias</option><option>Declarações</option></select></label><label>Descrição<textarea name="description" rows="2" maxlength="500"></textarea></label><label>Arquivo PDF<input name="file" type="file" accept=".pdf,.doc,.docx" required></label><button class="primary-button" type="submit">Publicar documento</button><div class="growth-status" data-growth-document-status></div></form>' : ''}</section>`; }
       function growthRequestsMarkup(isAdmin = false) { return `<section class="panel" data-growth-requests id="growth-requests"><div class="panel-heading"><div><div class="eyebrow">Atendimento escolar</div><h2 style="margin-top:4px">Solicitações à secretaria</h2></div><span class="agenda-count" data-growth-request-count>0</span></div><p class="agenda-intro">Peça documentos ou atendimento e acompanhe cada etapa sem depender de papel.</p>${isAdmin ? '<div class="growth-list" data-growth-request-list><div class="project-empty">Carregando solicitações...</div></div>' : '<form class="growth-form" data-growth-request-form><label>Aluno<select name="student_id" data-growth-request-student required><option value="">Carregando alunos...</option></select></label><label>Solicitação<select name="request_type"><option>Declaração escolar</option><option>Declaração de matrícula</option><option>Segunda via</option><option>Histórico escolar</option><option>Atendimento</option><option>Atualização cadastral</option></select></label><label>Detalhes<textarea name="description" rows="3" maxlength="1500" required placeholder="Explique o que você precisa."></textarea></label><button class="primary-button" type="submit">Enviar solicitação</button><div class="growth-status" data-growth-request-status></div></form><div class="growth-list" data-growth-request-list><div class="project-empty">Nenhuma solicitação enviada.</div></div>'}</section>`; }
       function growthProfileMarkup() { return `<section class="panel" data-growth-profile id="growth-profile"><div class="panel-heading"><div><div class="eyebrow">Acompanhamento individual</div><h2 style="margin-top:4px">Perfil do estudante</h2></div><span class="agenda-count">dados vinculados</span></div><p class="agenda-intro">Resumo do cadastro escolar, frequência, notas, atividades e ocorrências disponíveis para este vínculo.</p><div class="growth-profile-grid" data-growth-profile-list><div class="project-empty">Carregando perfil...</div></div></section>`; }
       function growthAchievementsMarkup(isAdmin = false) { return `<section class="panel" data-growth-achievements id="growth-achievements"><div class="panel-heading"><div><div class="eyebrow">Reconhecimento</div><h2 style="margin-top:4px">Conquistas BFR</h2></div><span class="agenda-count" data-growth-achievement-count>0</span></div><p class="agenda-intro">Medalhas registradas pela equipe escolar para valorizar participação, leitura, aprendizagem e projetos.</p><div class="growth-badge-list" data-growth-achievement-list><div class="project-empty">Nenhuma conquista publicada ainda.</div></div>${isAdmin ? '<form class="growth-form" data-growth-achievement-form style="margin-top:16px"><label>Aluno<select name="student_id" data-growth-achievement-student required><option value="">Carregando alunos...</option></select></label><label>Conquista<input name="title" required maxlength="100" placeholder="Ex.: Leitor do mês"></label><label>Descrição<textarea name="description" rows="2" maxlength="300"></textarea></label><label>Ícone<input name="icon" maxlength="3" value="★"></label><button class="primary-button" type="submit">Registrar conquista</button><div class="growth-status" data-growth-achievement-status></div></form>' : ''}</section>`; }
       function growthIndicatorsMarkup() { return `<section class="panel" data-growth-indicators id="growth-indicators"><div class="panel-heading"><div><div class="eyebrow">Gestão BFR</div><h2 style="margin-top:4px">Indicadores da direção</h2></div><span class="agenda-count">dados reais</span></div><p class="agenda-intro">Visão operacional para apoiar decisões da escola. Os números respeitam as permissões do administrador.</p><div class="growth-metric-grid" data-growth-indicator-grid><div class="growth-metric"><span class="growth-muted">Alunos ativos</span><strong>—</strong></div><div class="growth-metric"><span class="growth-muted">Frequência média</span><strong>—</strong></div><div class="growth-metric"><span class="growth-muted">Baixa frequência</span><strong>—</strong></div><div class="growth-metric"><span class="growth-muted">Notas lançadas</span><strong>—</strong></div></div><div class="growth-status" data-growth-indicator-status></div></section>`; }
       async function getGrowthStudentIds() {
         if (!currentUser || !supabaseClient) return [];
         if (['parent','student'].includes(currentProfile?.role)) {
           const { data } = await supabaseClient.from('guardian_students').select('student_id').eq('profile_id', currentUser.id);
           return (data || []).map(item => item.student_id).filter(Boolean);
         }
         return (academicState.students || []).map(item => item.id).filter(Boolean);
       }
        function growthReadKeys() { try { return new Set(JSON.parse(localStorage.getItem(accountStorageKey('bfr-notification-read')) || '[]')); } catch { return new Set(); } }
        function renderGrowthNotifications() {
         const read = growthReadKeys();
         document.querySelectorAll('[data-growth-notification-list]').forEach(list => { list.innerHTML = growthState.notifications.length ? growthState.notifications.map(item => `<article class="growth-item ${read.has(item.key) ? '' : 'is-unread'}"><div class="growth-item-top"><strong>${escapeHtml(item.icon)} ${escapeHtml(item.title)}</strong><small>${new Date(item.at).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</small></div><p>${escapeHtml(item.body)}</p><button class="growth-action" type="button" data-growth-read="${escapeHtml(item.key)}">${read.has(item.key) ? 'Lida' : 'Marcar como lida'}</button></article>`).join('') : '<div class="project-empty">Nenhuma atualização recente.</div>'; });
         const unread = growthState.notifications.filter(item => !read.has(item.key)).length;
         document.querySelectorAll('[data-growth-notification-count]').forEach(item => { item.textContent = String(unread); });
         document.querySelector('#notificationBtn .dot')?.classList.toggle('hidden', !unread);
         const modalList = document.querySelector('#noticeModal .modal-items');
          if (modalList) modalList.innerHTML = growthState.notifications.length ? growthState.notifications.slice(0,12).map(item => `<div><b>${escapeHtml(item.title)}</b><span>${escapeHtml(item.body)}</span></div>`).join('') : '<div><span>Nenhuma atualização recente.</span></div>';
        }
         async function sendExternalNotification(item) {
          if (!supabaseClient || !currentUser || !item) return;
          const preferences = readPreferences();
          if (!preferences.emailAlerts && !preferences.whatsappAlerts) return;
          const { data: { session } } = await supabaseClient.auth.getSession();
          if (!session?.access_token) return;
          fetch(`${SUPABASE_URL}/functions/v1/send-school-notification`, { method:'POST', headers:{ Authorization:`Bearer ${session.access_token}`, apikey:SUPABASE_PUBLISHABLE_KEY, 'Content-Type':'application/json' }, body:JSON.stringify({ title:item.title, body:item.body }) }).catch(() => {});
        }
        async function loadGrowthNotifications() {
         if (!currentUser || !supabaseClient || currentProfile?.role === 'pending') return;
         const wasLoaded = growthState.loaded;
         const previousKeys = new Set(growthState.notifications.map(item => item.key));
         const ids = await getGrowthStudentIds();
         growthState.studentIds = ids;
         const linked = ids.length;
         const requests = [
           supabaseClient.from('announcements').select('id,title,body,published_at').order('published_at',{ascending:false}).limit(6),
           supabaseClient.from('school_events').select('title,description,starts_at,location').gte('starts_at',new Date().toISOString()).order('starts_at',{ascending:true}).limit(6)
         ];
          if (linked) requests.push(supabaseClient.from('grades').select('student_id,subject,score,created_at').in('student_id',ids).order('created_at',{ascending:false}).limit(6), supabaseClient.from('attendance').select('student_id,attendance_date,status').in('student_id',ids).order('attendance_date',{ascending:false}).limit(6), supabaseClient.from('occurrences').select('id,title,description,occurred_at').in('student_id',ids).order('occurred_at',{ascending:false}).limit(6), supabaseClient.from('student_messages').select('id,body,created_at').eq('recipient_id',currentUser.id).in('student_id',ids).order('created_at',{ascending:false}).limit(6), supabaseClient.from('gate_checkins').select('id,student_id,direction,checked_at,entry_status,entry_allowed,restriction_reason').in('student_id',ids).order('checked_at',{ascending:false}).limit(10));
          const results = await Promise.all(requests);
          const [announcements=[],events=[],grades=[],attendance=[],occurrences=[],messages=[],gateCheckins=[]] = results.map(result => result?.data || []);
         const items = [];
         announcements.forEach(item => items.push({ key:`announcement-${item.id}`, icon:'📢', title:'Novo comunicado', body:item.title, at:item.published_at }));
         events.forEach(item => items.push({ key:`event-${item.title}-${item.starts_at}`, icon:'📅', title:'Evento da escola', body:`${item.title} · ${item.location || 'local a confirmar'}`, at:item.starts_at }));
         grades.forEach(item => items.push({ key:`grade-${item.student_id}-${item.subject}-${item.created_at}`, icon:'⭐', title:'Nova nota lançada', body:`${item.subject}: ${gradeDisplay(item.score)}`, at:item.created_at }));
         attendance.forEach(item => items.push({ key:`attendance-${item.student_id}-${item.attendance_date}`, icon:item.status === 'absent' ? '⚠️' : '✓', title:item.status === 'absent' ? 'Falta registrada' : 'Frequência atualizada', body:`Registro de ${item.attendance_date}`, at:`${item.attendance_date}T12:00:00` }));
          occurrences.forEach(item => items.push({ key:`occurrence-${item.id}`, icon:'⚠️', title:'Nova ocorrência', body:item.title || item.description, at:item.occurred_at }));
          messages.forEach(item => items.push({ key:`message-${item.id}`, icon:'💬', title:'Mensagem da escola', body:item.body, at:item.created_at }));
          gateCheckins.forEach(item => { const student = parentDataState.students.find(child => child.id === item.student_id); const blocked = item.entry_status === 'blocked' || item.entry_allowed === false; const direction = item.direction === 'exit' ? 'saiu' : 'entrou'; items.push({ key:`gate-checkin-${item.id}`, icon:blocked ? '⚠️' : item.direction === 'exit' ? '🚪' : '✅', title:blocked ? 'Entrada pendente de conferência' : item.direction === 'exit' ? 'Saída registrada' : 'Entrada na escola confirmada', body:blocked ? `${student?.official_name || 'Aluno'}: ${item.restriction_reason || 'a portaria registrou uma pendência.'}` : `${student?.official_name || 'Aluno'} ${direction} na escola às ${schoolClock(new Date(item.checked_at))}.`, at:item.checked_at, external:false }); });
         growthState.notifications = items.filter(item => item.at).sort((a,b) => new Date(b.at) - new Date(a.at)).slice(0,20);
         growthState.loaded = true;
          const { data:readRows } = await supabaseClient.from('school_notification_reads').select('notification_key').eq('profile_id',currentUser.id).limit(200);
           if (readRows?.length) { const keys = new Set([...growthReadKeys(), ...readRows.map(item => item.notification_key)]); localStorage.setItem(accountStorageKey('bfr-notification-read'), JSON.stringify([...keys].slice(-100))); }
           const freshItems = growthState.notifications.filter(item => !previousKeys.has(item.key)).slice(0,3);
            if (wasLoaded) freshItems.filter(item => item.external !== false).forEach(sendExternalNotification);
           if (wasLoaded && readPreferences().pushAlerts && 'Notification' in window && Notification.permission === 'granted') freshItems.forEach(item => new Notification(item.title, { body:item.body }));
          renderGrowthNotifications();
       }
       async function loadGrowthCalendar() {
         if (!supabaseClient || growthState.calendarLoaded) return;
         const [eventsResult, activitiesResult] = await Promise.all([
           supabaseClient.from('school_events').select('title,description,starts_at,location,event_type').gte('starts_at',new Date().toISOString()).order('starts_at',{ascending:true}).limit(40),
           supabaseClient.from('school_activities').select('id,title,description,due_date,subject').not('due_date','is',null).gte('due_date',schoolTodayIso()).order('due_date',{ascending:true}).limit(40)
         ]);
         growthState.calendar = [
           ...(eventsResult.data || []).map(item => ({ kind:'event', title:item.title, description:item.description || 'Evento da escola', at:item.starts_at, meta:`${item.location || 'Local a confirmar'} · evento` })),
           ...(activitiesResult.data || []).map(item => ({ kind:'activity', title:item.title, description:item.description || 'Atividade publicada pela escola', at:`${item.due_date}T12:00:00`, meta:`${item.subject || 'Atividade'} · entrega ${new Date(`${item.due_date}T12:00:00`).toLocaleDateString('pt-BR')}` }))
         ].sort((a,b) => new Date(a.at) - new Date(b.at));
         growthState.calendarLoaded = true;
         renderGrowthCalendar();
       }
       function renderGrowthCalendar() {
         document.querySelectorAll('[data-growth-calendar-list]').forEach(list => {
           const filter = list.closest('[data-growth-calendar]')?.querySelector('[data-growth-calendar-filter]')?.value || 'all';
           const items = growthState.calendar.filter(item => filter === 'all' || item.kind === filter);
           list.innerHTML = items.length ? items.map(item => `<article class="growth-item"><div class="growth-item-top"><strong>${item.kind === 'event' ? '📅' : '📚'} ${escapeHtml(item.title)}</strong><small>${new Date(item.at).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}).replace('.','')}</small></div><p>${escapeHtml(item.description)}</p><small>${escapeHtml(item.meta)}</small></article>`).join('') : '<div class="project-empty">Nenhum item encontrado para este filtro.</div>';
         });
       }
        function setupGrowthCalendar() {
          document.querySelectorAll('[data-growth-calendar]').forEach(panel => { if (panel.dataset.ready) return; panel.dataset.ready = 'true'; panel.querySelector('[data-growth-calendar-filter]')?.addEventListener('change', renderGrowthCalendar); });
       }
       function renderGrowthMessages() {
         document.querySelectorAll('[data-growth-message-list]').forEach(list => { list.innerHTML = growthState.messages.length ? growthState.messages.map(item => `<article class="growth-item"><div class="growth-item-top"><strong>${item.sender_id === currentUser?.id ? 'Você' : 'Escola'}</strong><small>${new Date(item.created_at).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</small></div><p>${escapeHtml(item.body)}</p><small>${escapeHtml(item.category || 'Recado geral')}</small></article>`).join('') : '<div class="project-empty">Nenhuma mensagem neste vínculo.</div>'; });
         document.querySelectorAll('[data-growth-message-count]').forEach(item => { item.textContent = String(growthState.messages.length); });
       }
        async function loadGrowthMessages() {
          if (!supabaseClient || !currentUser || !['parent','developer'].includes(currentProfile?.role)) return;
         const ids = growthState.studentIds.length ? growthState.studentIds : await getGrowthStudentIds();
          const result = ids.length ? await supabaseClient.from('student_messages').select('id,student_id,sender_id,recipient_id,category,body,created_at').in('student_id',ids).or(`recipient_id.eq.${currentUser.id},sender_id.eq.${currentUser.id}`).order('created_at',{ascending:false}).limit(40) : { data:[], error:null };
          growthState.messages = result.error ? [] : (result.data || []);
          growthState.messagesLoaded = true;
          renderGrowthMessages();
       }
       function setupGrowthMessages() {
         document.querySelectorAll('[data-growth-messages]').forEach(panel => {
           if (panel.dataset.ready) return;
           panel.dataset.ready = 'true';
           const select = panel.querySelector('[data-growth-message-student]');
           select.innerHTML = growthState.studentIds.length ? growthState.studentIds.map(id => { const student = (parentDataState.students || []).find(item => item.id === id) || (studentDataState.student?.id === id ? studentDataState.student : null); return `<option value="${id}">${escapeHtml(student?.official_name || 'Aluno vinculado')}</option>`; }).join('') : '<option value="">Vínculo ainda não carregado</option>';
           panel.querySelector('[data-growth-message-form]')?.addEventListener('submit', async event => {
             event.preventDefault();
             const form = event.currentTarget;
             const status = form.querySelector('[data-growth-message-status]');
             const body = form.querySelector('textarea[name="body"]').value.trim();
             if (!form.student_id.value || !body || !currentUser) { status.textContent = 'Escolha um aluno e escreva a mensagem.'; return; }
             form.querySelector('button').disabled = true;
             status.textContent = 'Enviando...';
             const { error } = await supabaseClient.from('student_messages').insert({ student_id:form.student_id.value, sender_id:currentUser.id, recipient_id:null, category:'general', body });
             form.querySelector('button').disabled = false;
             if (error) { status.textContent = 'Não foi possível enviar. Verifique as permissões da escola.'; return; }
             form.reset();
             status.textContent = 'Mensagem enviada para a equipe escolar.';
             await loadGrowthMessages();
           });
          });
       }
       async function openGrowthDocument(path) {
         if (!path || !supabaseClient) return;
         const { data, error } = await supabaseClient.storage.from('school-documents').createSignedUrl(path, 3600);
         if (!error && data?.signedUrl) window.open(data.signedUrl, '_blank', 'noopener,noreferrer');
       }
        async function loadGrowthDocuments() {
          if (!supabaseClient || !currentUser) return;
          const result = await supabaseClient.from('school_documents').select('id,title,category,description,storage_path,created_at').eq('published',true).order('created_at',{ascending:false});
          growthState.documentsLoaded = true;
          const documents = (result.data || []).filter(item => !String(item.category || '').toLocaleLowerCase('pt-BR').startsWith('biblioteca'));
          document.querySelectorAll('[data-growth-document-list]').forEach(list => { list.innerHTML = result.error ? '<div class="project-empty">A central de documentos ainda não foi configurada.</div>' : documents.length ? documents.map(item => `<article class="growth-item"><div class="growth-item-top"><strong>📄 ${escapeHtml(item.title)}</strong><small>${escapeHtml(item.category)}</small></div><p>${escapeHtml(item.description || 'Documento publicado pela escola.')}</p><button class="growth-action" type="button" data-growth-document-path="${escapeHtml(item.storage_path)}">Abrir documento</button></article>`).join('') : '<div class="project-empty">Nenhum documento publicado ainda.</div>'; });
          document.querySelectorAll('[data-growth-document-count]').forEach(item => { item.textContent = String(result.error ? 0 : documents.length); });
       }
         function schoolBookDescription(title) { const value = String(title || '').toLocaleLowerCase('pt-BR'); if (value.includes('droga da obediência') || value.includes('droga da obediencia')) return 'Temas: Mistério, Investigação, Trabalho em equipe e Ética · uma leitura sobre escolhas e responsabilidade.'; if (value.includes('pântano') || value.includes('pantano')) return 'Temas: Mistério, Investigação, Coragem e Trabalho em equipe · uma aventura para desvendar pistas.'; if (value.includes('borboleta atíria') || value.includes('borboleta atiria')) return 'Temas: Mistério, Investigação e Coragem · uma história para observar detalhes e formular hipóteses.'; if (value.includes('sherlock')) return 'Temas: Investigação, Ética, Trabalho em equipe e Coragem · um convite ao pensamento crítico.'; if (value.includes('centro da terra')) return 'Temas: Aventura, Coragem e Trabalho em equipe · uma viagem para explorar o desconhecido.'; if (value.includes('volta ao mundo')) return 'Temas: Aventura, Coragem, Ética e Trabalho em equipe · uma jornada por diferentes culturas.'; if (value.includes('robin hood')) return 'Temas: Aventura, Ética, Coragem e Trabalho em equipe · uma história sobre justiça e solidariedade.'; if (value.includes('escaravelho')) return 'Temas: Mistério, Investigação e Coragem · uma leitura para acompanhar uma investigação.'; if (value.includes('marcelo') || value.includes('marmelo')) return 'Tema: Respeito e identidade · uma leitura para conversar sobre convivência e escolhas.'; if (value.includes('mágico') || value.includes('magico')) return 'Temas: Amizade, coragem e sonhos · uma aventura para imaginar novos caminhos.'; if (value.includes('maluquinho')) return 'Temas: Amizade, Família e Imaginação · uma leitura leve sobre crescer e conviver.'; if (value.includes('pequeno príncipe') || value.includes('pequeno principe')) return 'Temas: Amizade, Respeito e Sonhos · uma história para olhar o mundo com cuidado.'; if (value.includes('ilha')) return 'Temas: Sonhos, coragem e aventura · uma jornada de descobertas.'; if (value.includes('bolsa amarela')) return 'Temas: Família, sonhos e identidade · uma leitura para reconhecer desejos e sentimentos.'; if (value.includes('alice')) return 'Temas: Imaginação e descoberta · uma viagem para fazer perguntas e criar possibilidades.'; if (value.includes('tom sawyer')) return 'Temas: Amizade, aventura e responsabilidade · uma história de escolhas e aprendizados.'; return 'Temas: Amizade, Família, Respeito, Sonhos e Imaginação · leitura da biblioteca escolar.'; }
        function setupGrowthDocuments() {
         document.querySelectorAll('[data-growth-documents]').forEach(panel => {
           if (panel.dataset.ready) return;
           panel.dataset.ready = 'true';
           panel.querySelector('[data-growth-document-form]')?.addEventListener('submit', async event => {
             event.preventDefault();
             const form = event.currentTarget;
             const status = form.querySelector('[data-growth-document-status]');
             const file = form.file.files[0];
             if (!file || file.size > 15 * 1024 * 1024) { status.textContent = 'Escolha um arquivo de até 15 MB.'; return; }
             status.textContent = 'Publicando documento...';
             const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]+/g,'-').slice(-100) || 'documento';
             const path = `${currentUser.id}/${crypto.randomUUID()}-${safeName}`;
             const upload = await supabaseClient.storage.from('school-documents').upload(path,file,{contentType:file.type || 'application/octet-stream',upsert:false});
             if (upload.error) { status.textContent = 'Não foi possível enviar o arquivo.'; return; }
                const description = form.description.value.trim() || (form.category.value.startsWith('Biblioteca · ') ? schoolBookDescription(form.title.value) : null);
               const { error } = await supabaseClient.from('school_documents').insert({ title:form.title.value.trim(), category:form.category.value, description, storage_path:path, published:true, created_by:currentUser.id });
             if (error) { await supabaseClient.storage.from('school-documents').remove([path]); status.textContent = 'O documento não foi salvo.'; return; }
             form.reset(); status.textContent = 'Documento publicado.'; await loadGrowthDocuments();
           });
          });
       }
       function requestStatusLabel(status) { return { received:'Recebida', reviewing:'Em análise', ready:'Pronta', closed:'Encerrada' }[status] || status; }
       function renderGrowthRequests(items, admin = false) {
         document.querySelectorAll('[data-growth-request-list]').forEach(list => { list.innerHTML = items.length ? items.map(item => `<article class="growth-item"><div class="growth-item-top"><strong>${escapeHtml(item.request_type)}</strong><small>${new Date(item.created_at).toLocaleDateString('pt-BR')}</small></div><p>${escapeHtml(item.description)}</p><small>${admin && item.students ? escapeHtml(Array.isArray(item.students) ? item.students[0]?.official_name : item.students.official_name) : ''}</small>${admin ? `<select data-growth-request-status data-request-id="${item.id}" style="margin-top:8px;width:100%;border:1px solid var(--line);border-radius:8px;padding:8px;font-size:10px"><option value="received" ${item.status === 'received' ? 'selected' : ''}>Recebida</option><option value="reviewing" ${item.status === 'reviewing' ? 'selected' : ''}>Em análise</option><option value="ready" ${item.status === 'ready' ? 'selected' : ''}>Pronta</option><option value="closed" ${item.status === 'closed' ? 'selected' : ''}>Encerrada</option></select>` : `<div class="growth-status">Status: ${requestStatusLabel(item.status)}</div>`}</article>`).join('') : '<div class="project-empty">Nenhuma solicitação registrada.</div>'; });
         document.querySelectorAll('[data-growth-request-count]').forEach(item => { item.textContent = String(items.filter(request => request.status !== 'closed').length); });
       }
        async function loadGrowthRequests() {
          if (!supabaseClient || !currentUser || !['parent','developer'].includes(currentProfile?.role)) return;
         const admin = currentProfile?.role === 'developer';
         const query = admin ? supabaseClient.from('secretary_requests').select('id,requester_id,student_id,request_type,description,status,created_at,students(official_name)').order('created_at',{ascending:false}) : supabaseClient.from('secretary_requests').select('id,student_id,request_type,description,status,created_at').eq('requester_id',currentUser.id).order('created_at',{ascending:false});
          const { data, error } = await query;
          if (error) { growthState.requestsLoaded = true; renderGrowthRequests([]); return; }
          growthState.requestsLoaded = true;
          renderGrowthRequests(data || [], admin);
       }
       function setupGrowthRequests() {
         document.querySelectorAll('[data-growth-requests]').forEach(panel => {
           if (panel.dataset.ready) return;
           panel.dataset.ready = 'true';
           const select = panel.querySelector('[data-growth-request-student]');
           if (select) select.innerHTML = growthState.studentIds.length ? growthState.studentIds.map(id => { const student = (parentDataState.students || []).find(item => item.id === id) || (studentDataState.student?.id === id ? studentDataState.student : null); return `<option value="${id}">${escapeHtml(student?.official_name || 'Aluno vinculado')}</option>`; }).join('') : '<option value="">Vínculo ainda não carregado</option>';
           panel.querySelector('[data-growth-request-form]')?.addEventListener('submit', async event => {
             event.preventDefault();
             const form = event.currentTarget;
             const status = form.querySelector('[data-growth-request-status]');
             status.textContent = 'Enviando solicitação...';
              if (!['parent','developer'].includes(currentProfile?.role)) { status.textContent = 'Somente responsáveis podem abrir solicitações à secretaria.'; return; }
              const { error } = await supabaseClient.from('secretary_requests').insert({ requester_id:currentUser.id, student_id:form.student_id.value, request_type:form.request_type.value, description:form.description.value.trim() });
             if (error) { status.textContent = 'Não foi possível enviar a solicitação.'; return; }
             form.reset(); status.textContent = 'Solicitação recebida pela secretaria.'; await loadGrowthRequests();
           });
         });
         if (!document.body.dataset.growthRequestActions) {
           document.body.dataset.growthRequestActions = 'true';
           document.addEventListener('change', async event => {
             const select = event.target.closest('[data-growth-request-status]');
             if (!select || currentProfile?.role !== 'developer') return;
             const { error } = await supabaseClient.from('secretary_requests').update({ status:select.value, reviewed_by:currentUser.id, updated_at:new Date().toISOString() }).eq('id',select.dataset.requestId);
             select.style.borderColor = error ? '#d27862' : '#71b496';
           });
          }
       }
       async function loadGrowthAchievements() {
         if (!supabaseClient || !currentUser) return;
         const ids = ['parent','student'].includes(currentProfile?.role) ? growthState.studentIds : null;
         let query = supabaseClient.from('student_achievements').select('id,student_id,title,description,icon,awarded_at,students(official_name)').order('awarded_at',{ascending:false});
         if (ids) query = query.in('student_id',ids.length ? ids : ['00000000-0000-0000-0000-000000000000']);
         const { data, error } = await query;
          const items = error ? [] : (data || []);
          growthState.achievementsLoaded = true;
         document.querySelectorAll('[data-growth-achievement-list]').forEach(list => { list.innerHTML = items.length ? items.map(item => `<article class="growth-badge"><b>${escapeHtml(item.icon || '★')}</b><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.description || '')}${currentProfile?.role === 'developer' && item.students ? ` · ${escapeHtml(Array.isArray(item.students) ? item.students[0]?.official_name : item.students.official_name)}` : ''}</span></article>`).join('') : '<div class="project-empty">Nenhuma conquista publicada ainda.</div>'; });
         document.querySelectorAll('[data-growth-achievement-count]').forEach(item => { item.textContent = String(items.length); });
       }
       function setupGrowthAchievements() {
         document.querySelectorAll('[data-growth-achievements]').forEach(panel => {
           if (panel.dataset.ready) return;
           panel.dataset.ready = 'true';
           const select = panel.querySelector('[data-growth-achievement-student]');
           if (select) supabaseClient.from('students').select('id,official_name').eq('active',true).order('official_name').then(({data}) => { select.innerHTML = (data || []).map(item => `<option value="${item.id}">${escapeHtml(item.official_name)}</option>`).join(''); });
           panel.querySelector('[data-growth-achievement-form]')?.addEventListener('submit', async event => {
             event.preventDefault(); const form = event.currentTarget; const status = form.querySelector('[data-growth-achievement-status]'); status.textContent = 'Registrando...';
             const { error } = await supabaseClient.from('student_achievements').insert({ student_id:form.student_id.value, title:form.title.value.trim(), description:form.description.value.trim() || null, icon:form.icon.value.trim() || '★', awarded_by:currentUser.id });
             status.textContent = error ? 'Não foi possível registrar a conquista.' : 'Conquista publicada.'; if (!error) { form.reset(); await loadGrowthAchievements(); }
           });
          });
       }
       async function loadGrowthProfiles() {
         if (!supabaseClient || !currentUser) return;
         const ids = await getGrowthStudentIds();
         if (!ids.length) { document.querySelectorAll('[data-growth-profile-list]').forEach(list => { list.innerHTML = '<div class="project-empty">Nenhum aluno vinculado a esta conta.</div>'; }); return; }
         const [{ data:students }, { data:classes }, { data:grades }, { data:attendance }] = await Promise.all([
           supabaseClient.from('students').select('id,official_name,class_id').in('id',ids),
           supabaseClient.from('classes').select('id,year,class_code').order('year'),
           supabaseClient.from('grades').select('student_id,score').in('student_id',ids),
           supabaseClient.from('attendance').select('student_id,status').in('student_id',ids)
         ]);
          document.querySelectorAll('[data-growth-profile-list]').forEach(list => { list.innerHTML = (students || []).map(student => { const classData = (classes || []).find(item => item.id === student.class_id); const studentGrades = (grades || []).filter(item => item.student_id === student.id); const studentAttendance = (attendance || []).filter(item => item.student_id === student.id); const present = studentAttendance.filter(item => item.status === 'present' || item.status === 'late').length; const rate = studentAttendance.length ? `${((present / studentAttendance.length) * 100).toFixed(1).replace('.',',')}%` : '—'; return `<article class="growth-profile"><h3>${escapeHtml(student.official_name)}</h3><p>${classData ? `${classData.year}º ano ${escapeHtml(classData.class_code)}` : 'Turma não informada'}</p><p><b>Média:</b> ${gradeDisplay(gradeAverage(studentGrades.map(item => item.score)))} · <b>Frequência:</b> ${rate}</p><p>Notas, atividades, ocorrências e documentos são exibidos conforme o vínculo e as permissões da conta.</p></article>`; }).join('') || '<div class="project-empty">Cadastro do aluno indisponível.</div>'; });
          growthState.profilesLoaded = true;
       }
       async function loadGrowthIndicators() {
         if (!supabaseClient || currentProfile?.role !== 'developer') return;
         const status = document.querySelector('[data-growth-indicator-status]');
         const [{ count:studentsCount }, { data:attendance }, { data:grades }] = await Promise.all([
           supabaseClient.from('students').select('id',{count:'exact',head:true}).eq('active',true),
           supabaseClient.from('attendance').select('status'),
           supabaseClient.from('grades').select('score')
         ]);
         const records = attendance || [];
         const present = records.filter(item => item.status === 'present' || item.status === 'late').length;
         const rate = records.length ? `${((present / records.length) * 100).toFixed(1).replace('.',',')}%` : '—';
         const low = records.length ? `${Math.round((records.filter(item => item.status === 'absent').length / records.length) * 100)}%` : '—';
          document.querySelectorAll('[data-growth-indicator-grid] .growth-metric strong').forEach((item,index) => { item.textContent = [studentsCount ?? '—', rate, low, String((grades || []).length)][index]; });
          growthState.indicatorsLoaded = true;
         if (status) status.textContent = 'Atualizado com os registros disponíveis no banco escolar.';
       }
       function refreshGrowthStudentSelectors() {
         const students = growthState.studentIds.map(id => (parentDataState.students || []).find(item => item.id === id) || (studentDataState.student?.id === id ? studentDataState.student : null)).filter(Boolean);
         document.querySelectorAll('[data-growth-message-student],[data-growth-request-student]').forEach(select => { select.innerHTML = students.length ? students.map(student => `<option value="${student.id}">${escapeHtml(student.official_name)}</option>`).join('') : '<option value="">Nenhum aluno vinculado</option>'; });
       }
       function ensureMobileTapTargets() {
         document.querySelectorAll('.nav-item[data-section],.mobile-more-option,.project-tab,.class-tab,.schedule-shift,.game-subject,.growth-action,[data-section-link]').forEach(button => button.classList.add('tap-target'));
       }
        function syncRoleNavigation(role) {
          const viewRole = role === 'developer' ? 'admin' : role === 'pedagogical' ? 'teacher' : role;
              const allowed = roleSectionAccess[viewRole] || roleSectionAccess.parent;
               document.querySelectorAll('.sidebar .nav-item[data-section],.mobile-more-option[data-section]').forEach(item => item.classList.toggle('hidden', !allowed.includes(item.dataset.section)));
          document.querySelector('[data-mobile-more]')?.classList.remove('hidden');
         const active = document.querySelector('.sidebar .nav-item[data-section].active');
         if (active?.classList.contains('hidden')) { document.querySelectorAll('.sidebar .nav-item[data-section]').forEach(item => item.classList.remove('active')); document.querySelector(`.sidebar .nav-item[data-section="${allowed[0]}"]`)?.classList.add('active'); }
       }
         function ensureUniqueGrowthIds() {
           const seen = new Set();
           document.querySelectorAll('[id^="growth-"]').forEach(element => {
             if (seen.has(element.id)) element.removeAttribute('id');
             else seen.add(element.id);
           });
         }
         function ensureGrowthViews() {
         ensureGrowthStyles();
         const views = [parentView,studentView,teacherView,adminView].filter(view => view?.innerHTML);
          views.forEach(view => {
            const isAdmin = view.id === 'adminView';
            const isFamily = view.id === 'parentView' || view.id === 'studentView';
            const growthRole = view.id === 'parentView' ? 'parent' : view.id === 'studentView' ? 'student' : isAdmin ? 'admin' : 'staff';
             if (!view.querySelector('[data-growth-hub]')) view.querySelector('.welcome,.teacher-welcome')?.insertAdjacentHTML('afterend', growthHubMarkup(growthRole));
            if (!view.querySelector('[data-growth-notifications]')) view.insertAdjacentHTML('beforeend', growthNotificationsMarkup());
            if (!view.querySelector('[data-growth-calendar]')) view.insertAdjacentHTML('beforeend', growthCalendarMarkup());
            if (!view.querySelector('[data-growth-school]')) view.insertAdjacentHTML('beforeend', growthSchoolMarkup());
            if (view.id === 'parentView' && !view.querySelector('[data-growth-messages]')) view.insertAdjacentHTML('beforeend', growthMessagesMarkup());
            if (isFamily && !view.querySelector('[data-growth-documents]')) view.insertAdjacentHTML('beforeend', growthDocumentsMarkup());
            if (view.id === 'parentView' && !view.querySelector('[data-growth-requests]')) view.insertAdjacentHTML('beforeend', growthRequestsMarkup());
           if (isFamily && !view.querySelector('[data-growth-profile]')) view.insertAdjacentHTML('beforeend', growthProfileMarkup());
           if (isFamily && !view.querySelector('[data-growth-achievements]')) view.insertAdjacentHTML('beforeend', growthAchievementsMarkup());
           if (isAdmin && !view.querySelector('[data-growth-documents]')) view.insertAdjacentHTML('beforeend', growthDocumentsMarkup(true));
           if (isAdmin && !view.querySelector('[data-growth-requests]')) view.insertAdjacentHTML('beforeend', growthRequestsMarkup(true));
           if (isAdmin && !view.querySelector('[data-growth-achievements]')) view.insertAdjacentHTML('beforeend', growthAchievementsMarkup(true));
           if (isAdmin && !view.querySelector('[data-growth-indicators]')) view.insertAdjacentHTML('beforeend', growthIndicatorsMarkup());
           });
           ensureUniqueGrowthIds();
         }
        function loadGrowthTarget(target) {
          const loaders = { notifications:loadGrowthNotifications, calendar:loadGrowthCalendar, messages:loadGrowthMessages, documents:loadGrowthDocuments, requests:loadGrowthRequests, profile:loadGrowthProfiles, achievements:loadGrowthAchievements };
          loaders[target]?.();
        }
         function setupGrowthFeatures() {
           if (!currentUser || !currentProfile || currentProfile.role === 'pending' || activeView === 'coordinator') return;
           ensureGrowthViews();
           setupGrowthCollapsibles();
          refreshGrowthStudentSelectors();
          ensureMobileTapTargets();
          setupGrowthCalendar(); setupGrowthMessages(); setupGrowthDocuments(); setupGrowthRequests(); setupGrowthAchievements();
          if (!growthState.idleScheduled) {
            growthState.idleScheduled = true;
            const schedule = window.requestIdleCallback || (callback => setTimeout(callback, 1200));
            schedule(() => { loadGrowthNotifications(); if (currentProfile?.role === 'developer') loadGrowthIndicators(); });
          }
          if (!growthState.timer) growthState.timer = setInterval(() => { if (growthState.loaded) loadGrowthNotifications(); if (growthState.calendarLoaded) loadGrowthCalendar(); if (growthState.messagesLoaded) loadGrowthMessages(); if (growthState.requestsLoaded) loadGrowthRequests(); }, 60000);
        }
        function scrollGrowthTarget(target) {
          const scroller = target?.closest('main');
          if (!scroller) { target?.scrollIntoView({behavior:'smooth',block:'start'}); return; }
          const top = target.getBoundingClientRect().top - scroller.getBoundingClientRect().top + scroller.scrollTop - 20;
          scroller.scrollTo({top:Math.max(0,top),behavior:'smooth'});
        }
        function setupGrowthCollapsibles() {
          const selectors = '[data-growth-notifications],[data-growth-calendar],[data-growth-messages],[data-growth-school],[data-growth-documents],[data-growth-requests],[data-growth-profile],[data-growth-achievements],[data-growth-indicators]';
          let collapsed = new Set();
          try { collapsed = new Set(JSON.parse(localStorage.getItem(accountStorageKey('bfr-growth-collapsed')) || '[]')); } catch {}
          if (!document.getElementById('growth-collapse-styles')) {
            const style = document.createElement('style');
            style.id = 'growth-collapse-styles';
            style.textContent = '.growth-panel-heading-tools{display:flex;align-items:center;gap:8px}.growth-collapse{border:1px solid var(--line);border-radius:8px;background:#fff;color:#245ccf;padding:6px 9px;font:inherit;font-size:10px;cursor:pointer}.growth-collapse:hover{background:#f5f9ff;border-color:#8db3e9}.growth-panel-body[hidden]{display:none!important}';
            document.head.appendChild(style);
          }
          document.querySelectorAll(selectors).forEach(panel => {
            if (panel.dataset.collapseReady || !panel.id) return;
            const heading = panel.querySelector(':scope > .panel-heading');
            if (!heading) return;
            const tools = document.createElement('div');
            tools.className = 'growth-panel-heading-tools';
            const existing = heading.lastElementChild;
            if (existing && existing !== heading.firstElementChild) tools.append(existing);
            const toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'growth-collapse';
            toggle.dataset.growthCollapse = 'true';
            toggle.textContent = 'Recolher';
            toggle.setAttribute('aria-expanded', 'true');
            tools.append(toggle);
            heading.append(tools);
            const body = document.createElement('div');
            body.className = 'growth-panel-body';
            body.id = `${panel.id}-body`;
            while (heading.nextElementSibling) body.append(heading.nextElementSibling);
            panel.append(body);
            toggle.setAttribute('aria-controls', body.id);
            panel.dataset.collapseReady = 'true';
            const apply = isCollapsed => { body.hidden = isCollapsed; toggle.textContent = isCollapsed ? 'Expandir' : 'Recolher'; toggle.setAttribute('aria-expanded', String(!isCollapsed)); };
            apply(collapsed.has(panel.id));
            toggle.addEventListener('click', () => {
              const isCollapsed = !body.hidden;
              if (isCollapsed) collapsed.add(panel.id); else collapsed.delete(panel.id);
              try { localStorage.setItem(accountStorageKey('bfr-growth-collapsed'), JSON.stringify([...collapsed])); } catch {}
              apply(isCollapsed);
            });
          });
        }
        document.addEventListener('click', event => {
          const startStudentChallenge = event.target.closest('[data-student-start-recommendation]');
          if (startStudentChallenge) {
            const subject = startStudentChallenge.dataset.studentSubject || 'Matemática';
            const button = [...(studentView?.querySelectorAll('[data-game-subject]') || [])].find(item => item.dataset.gameSubject === subject);
            if (button) { button.click(); button.closest('[data-games-panel]')?.scrollIntoView({behavior:'smooth',block:'start'}); }
          }
          const studentPath = event.target.closest('[data-student-path]');
          if (studentPath) {
            if (studentPath.dataset.studentPath === 'achievements') { loadGrowthTarget('achievements'); studentView?.querySelector('[data-growth-achievements]')?.scrollIntoView({behavior:'smooth',block:'start'}); }
            else navigateToSection(studentPath.dataset.studentPath);
          }
          const openStudentAchievements = event.target.closest('[data-student-open-achievements]');
          if (openStudentAchievements) { loadGrowthTarget('achievements'); studentView?.querySelector('[data-growth-achievements]')?.scrollIntoView({behavior:'smooth',block:'start'}); }
           const target = event.target.closest('[data-growth-target]');
             if (target) { event.preventDefault(); const targetName = target.dataset.growthTarget.replace('growth-',''); loadGrowthTarget(targetName); const destination = target.closest('.content')?.querySelector(`[data-growth-${targetName}]`); if (destination) { destination.classList.remove('parent-detail-hidden'); delete destination.dataset.parentDetailHidden; const body = destination.querySelector('.growth-panel-body'); const toggle = destination.querySelector('[data-growth-collapse]'); if (body?.hidden) { body.hidden = false; if (toggle) { toggle.textContent = 'Recolher'; toggle.setAttribute('aria-expanded','true'); } try { const key = accountStorageKey('bfr-growth-collapsed'); const saved = JSON.parse(localStorage.getItem(key) || '[]').filter(id => id !== destination.id); localStorage.setItem(key, JSON.stringify(saved)); } catch {} } } scrollGrowthTarget(destination); }
         const read = event.target.closest('[data-growth-read]');
          if (read) { const key = read.dataset.growthRead; const keys = growthReadKeys(); keys.add(key); localStorage.setItem(accountStorageKey('bfr-notification-read'), JSON.stringify([...keys].slice(-100))); if (supabaseClient && currentUser) supabaseClient.from('school_notification_reads').upsert({profile_id:currentUser.id,notification_key:key},{onConflict:'profile_id,notification_key'}); renderGrowthNotifications(); }
         const doc = event.target.closest('[data-growth-document-path]');
         if (doc) openGrowthDocument(doc.dataset.growthDocumentPath);
           if (event.target.closest('[data-enable-browser-alerts]')) { registerPushSubscription(true).then(message => { document.querySelector('[data-growth-notification-status]').textContent = message; if (message === 'Push ativado neste dispositivo.') { const next = { ...readPreferences(), pushAlerts:true }; localStorage.setItem(accountStorageKey('bfr-preferences'), JSON.stringify(next)); saveNotificationPreferences(next); } }); }
         if (event.target.closest('#notificationBtn,#allNoticesBtn')) { loadGrowthNotifications(); }
       });
       roleButtons.forEach(button => button.addEventListener('click', () => setTimeout(setupGrowthFeatures, 0)));
       ensureMobileTapTargets();
       setTimeout(setupGrowthFeatures, 0);
       setupAccountTools();
        setupPublicSchedule();

        // Prefer the published Supabase schedule for teacher operations.
        function teacherScheduleTime(entry) {
          if (entry?.[6] && entry?.[7]) return `${entry[6]}–${entry[7]}`;
          const times = window.BFR_TEACHER_SCHEDULE?.periods?.[entry?.[0]]?.[entry?.[1]]?.[Number(entry?.[2]) - 1];
          return times ? `${times[0]}–${times[1]}` : `Período ${entry?.[2] || '—'} · horário não informado`;
        }
        async function loadProfessionalTeacherData(force = false) {
          if (teacherProfessionalState.loading || (teacherProfessionalState.loaded && !force)) { teacherRenderProfessional(); return; }
          teacherProfessionalState.loading = true;
          teacherProfessionalState.error = '';
          teacherRenderProfessional();
          if (!supabaseClient || !currentUser) {
            teacherProfessionalState.loaded = true;
            teacherProfessionalState.loading = false;
            teacherProfessionalState.error = 'Os dados aparecerão após o login escolar.';
            teacherRenderProfessional();
            return;
          }
          const versionResult = await supabaseClient.from('bfr_schedule_versions').select('id').eq('school_year', 2026).eq('status', 'published').maybeSingle();
          if (versionResult.error || !versionResult.data) {
            teacherProfessionalState.loaded = true;
            teacherProfessionalState.loading = false;
            teacherProfessionalState.error = 'A grade oficial publicada ainda não está disponível.';
            teacherRenderProfessional();
            return;
          }
          const scheduleResult = await supabaseClient.from('bfr_schedule_entries').select('shift,weekday,period,grade_label,class_id,subject_name,start_time,end_time,source_status,bfr_teacher_directory(display_name)').eq('version_id', versionResult.data.id).order('weekday').order('period');
          if (scheduleResult.error) {
            teacherProfessionalState.loaded = true;
            teacherProfessionalState.loading = false;
            teacherProfessionalState.error = 'Não foi possível carregar seus vínculos oficiais.';
            teacherRenderProfessional();
            return;
          }
           const scheduleRows = (scheduleResult.data || []).filter(item => {
             const teacher = teacherScheduleNormalize(item.bfr_teacher_directory?.display_name || '');
             const subject = teacherScheduleNormalize(item.subject_name || '');
             const classCode = String(item.grade_label || '').toUpperCase().replace(/[^A-Z0-9]/g,'').replace(/^6ANO/,'6');
             return !(teacher.includes('raul') && subject === 'historia' && ['6B','6C','6D'].includes(classCode));
           });
          teacherProfessionalState.scheduleEntries = scheduleRows.map(item => [item.shift, item.weekday, item.period, item.grade_label, item.bfr_teacher_directory?.display_name || '', item.subject_name, item.start_time ? String(item.start_time).slice(0,5) : '', item.end_time ? String(item.end_time).slice(0,5) : '']);
          if (scheduleRows.length) currentProfile = { ...currentProfile, subjects:[...new Set(scheduleRows.map(item => item.subject_name).filter(Boolean))].join(', ') };
          const classIds = [...new Set(scheduleRows.map(item => item.class_id).filter(Boolean))];
          if (!classIds.length) {
            teacherProfessionalState.classes = [];
            teacherProfessionalState.students = [];
            teacherProfessionalState.grades = [];
            teacherProfessionalState.attendance = [];
            teacherProfessionalState.activities = [];
            teacherProfessionalState.loaded = true;
            teacherProfessionalState.loading = false;
            teacherProfessionalState.error = 'Seu perfil ainda não está vinculado a uma turma na grade oficial.';
            teacherRenderProfessional();
            return;
          }
          const classesResult = await supabaseClient.from('classes').select('id,year,class_code,shift').in('id', classIds).order('year').order('class_code');
          if (classesResult.error) {
            teacherProfessionalState.classes = [];
            teacherProfessionalState.error = 'Não foi possível carregar as turmas autorizadas.';
            teacherProfessionalState.loaded = true;
            teacherProfessionalState.loading = false;
            teacherRenderProfessional();
            return;
          }
          teacherProfessionalState.classes = classesResult.data || [];
          const studentsResult = await supabaseClient.from('students').select('id,official_name,class_id').in('class_id', classIds).eq('active', true).order('official_name');
          teacherProfessionalState.students = studentsResult.data || [];
          const studentIds = teacherProfessionalState.students.map(item => item.id);
          const [gradesResult, attendanceResult, activitiesResult] = await Promise.all([
            studentIds.length ? supabaseClient.from('grades').select('student_id,subject,assessment,score,term,created_at').in('student_id', studentIds).order('created_at', { ascending:false }) : Promise.resolve({ data:[], error:null }),
            studentIds.length ? supabaseClient.from('attendance').select('student_id,attendance_date,status').in('student_id', studentIds).order('attendance_date', { ascending:false }) : Promise.resolve({ data:[], error:null }),
            supabaseClient.from('school_activities').select('id,title,subject,description,due_date,attachment_path,attachment_name,published_at,class_id,classes(year,class_code)').in('class_id', classIds).order('published_at', { ascending:false }).limit(60)
          ]);
          teacherProfessionalState.grades = gradesResult.data || [];
          teacherProfessionalState.attendance = attendanceResult.data || [];
          teacherProfessionalState.activities = activitiesResult.data || [];
          teacherProfessionalState.loaded = true;
          teacherProfessionalState.loading = false;
          teacherRenderProfessional();
        }
    </script>


<style id="bfr-reference-login-final">
  body:has(#appShell.ready) #loginScreen { display:none !important; visibility:hidden !important; pointer-events:none !important; }
