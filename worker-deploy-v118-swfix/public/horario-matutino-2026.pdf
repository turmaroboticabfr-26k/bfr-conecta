<script id="bfr-lia-logo-asset">
  (() => {
    const logoPath = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><rect width="128" height="128" rx="28" fill="#1769d2"/><circle cx="64" cy="64" r="43" fill="#fff"/><text x="64" y="75" text-anchor="middle" font-family="Arial,sans-serif" font-size="27" font-weight="700" fill="#1769d2">LIA</text></svg>');
    const selector = '.lia-fab-avatar img,.lia-avatar img,.lia-home-icon img,.lia-message-avatar img';
    const applyLiaLogo = () => document.querySelectorAll(selector).forEach(image => {
      if (image.getAttribute('src') !== logoPath) image.setAttribute('src', logoPath);
      image.alt = 'Logo da LIA';
    });
    applyLiaLogo();
  })();
</script>
<script id="bfr-director-safe-actions">
  (() => {
    const available = new Set(['atividades']);
    const syncDirectorActions = () => {
      const directorView = document.querySelector('#directorView');
      if (!directorView || directorView.classList.contains('hidden')) return;
      let keptActivities = false;
      directorView.querySelectorAll('#bfrDirectionPanel [data-direction-open]').forEach(button => {
        if (!available.has(button.dataset.directionOpen) || (button.dataset.directionOpen === 'atividades' && keptActivities)) {
          button.remove();
          return;
        }
        keptActivities = true;
        if (button.textContent.trim() !== 'Abrir Central de Atividades') button.textContent = 'Abrir Central de Atividades';
      });
    };
    syncDirectorActions();
  })();
</script>
