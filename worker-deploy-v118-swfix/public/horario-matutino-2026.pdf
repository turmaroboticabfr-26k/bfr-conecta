            .login-layout { min-height:100svh; display:flex; flex-direction:column; border-radius:0; }
            .login-message { flex:1; min-height:56svh; padding:38px 28px 24px; }
            .login-message h1 { max-width:330px; font-size:38px; }
            .login-message > p { max-width:310px; font-size:14px; }
            .login-message > .school-symbol-wrap { width:190px; height:124px; margin:22px auto 0; }
             .login-benefits { margin-top:auto; grid-template-columns:repeat(2,minmax(0,1fr)); font-size:12px; }
             .login-form { flex:0 0 auto; padding:27px 28px 30px; }
             .login-product-logo { width:min(100%,300px); max-height:300px; margin-bottom:16px; }
            .login-form > .eyebrow, .login-form > h2, .login-form > p, .login-privacy { display:none; }
            .schedule-public-button { order:1; width:calc(100% - 56px); margin:0 28px 12px; font-size:14px; }
            .google-button { order:2; margin-top:0; font-size:14px; }
            .login-footer { display:none; }
          }
          @media (max-width:430px) {
            .login-benefits { grid-template-columns:1fr 1fr; }
            .login-benefits span { font-size:10px; }
            .child-card { padding:17px; }
            .content { padding-left:13px; padding-right:13px; }
