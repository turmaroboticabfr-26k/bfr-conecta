</style>

<script id="bfr-parent-teachers-script">
  (() => {
    const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const classLabel = item => item ? `${item.year || '—'}º ano ${item.class_code || ''}`.trim() : 'Turma não informada';
    const normalized = value => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
    const excludedRaulAssignment = (classData, entry) => {
      const classCode = `${classData?.year || ''}${classData?.class_code || ''}`.toUpperCase();
      return normalized(entry.bfr_teacher_directory?.display_name).includes('raul') && normalized(entry.subject_name) === 'historia' && ['6B','6C','6D'].includes(classCode);
    };
    let loading = false;

    function ensurePanel() {
      const view = document.getElementById('parentView');
      const child = view?.querySelector('.child-card');
      if (!view || view.classList.contains('hidden') || !child || view.querySelector('[data-parent-teachers-panel]')) return;
      child.insertAdjacentHTML('afterend', `<section class="bfr-parent-teachers-panel" data-parent-teachers-panel><div class="bfr-parent-teachers-head"><div><div class="eyebrow">Equipe da turma</div><h2>Professores do seu filho</h2><p>Mostramos somente as turmas vinculadas à sua conta.</p></div><span class="agenda-count">2026</span></div><div class="bfr-parent-teachers-list" data-parent-teachers-list><div class="bfr-parent-teachers-empty">Carregando os vínculos da turma...</div></div></section>`);
    }

    async function loadTeachers() {
      const client = window.BFR_SUPABASE_CLIENT;
      const panel = document.querySelector('#parentView:not(.hidden) [data-parent-teachers-panel]');
      const list = panel?.querySelector('[data-parent-teachers-list]');
      if (!client || !panel || !list || loading) return;
      loading = true;
      try {
        const { data:{ user } = {} } = await client.auth.getUser();
        if (!user) return;
        const linksResult = await client.from('guardian_students').select('student_id').eq('profile_id', user.id);
        const studentIds = (linksResult.data || []).map(item => item.student_id).filter(Boolean);
        if (linksResult.error || !studentIds.length) { list.innerHTML = '<div class="bfr-parent-teachers-empty">A escola ainda não vinculou um aluno a esta conta.</div>'; return; }
        const studentsResult = await client.from('students').select('id,class_id').in('id', studentIds).eq('active', true);
        const classIds = [...new Set((studentsResult.data || []).map(item => item.class_id).filter(Boolean))];
        if (studentsResult.error || !classIds.length) { list.innerHTML = '<div class="bfr-parent-teachers-empty">A turma do aluno ainda não está informada.</div>'; return; }
        const [classesResult, versionResult] = await Promise.all([
          client.from('classes').select('id,year,class_code,shift').in('id', classIds),
          client.from('bfr_schedule_versions').select('id').eq('school_year', 2026).eq('status', 'published').maybeSingle()
        ]);
        if (classesResult.error || versionResult.error || !versionResult.data) { list.innerHTML = '<div class="bfr-parent-teachers-empty">A grade oficial ainda não está disponível para esta conta.</div>'; return; }
        const entriesResult = await client.from('bfr_schedule_entries').select('class_id,subject_name,bfr_teacher_directory(display_name)').eq('version_id', versionResult.data.id).in('class_id', classIds).order('subject_name');
        if (entriesResult.error) { list.innerHTML = '<div class="bfr-parent-teachers-empty">Os professores da turma ainda não puderam ser carregados.</div>'; return; }
        const classMap = new Map((classesResult.data || []).map(item => [item.id, item]));
        const byClass = new Map();
        for (const entry of entriesResult.data || []) {
          const teacher = entry.bfr_teacher_directory?.display_name;
          if (!teacher || !classMap.has(entry.class_id) || excludedRaulAssignment(classMap.get(entry.class_id), entry)) continue;
          const key = `${entry.class_id}|${entry.subject_name || 'Componente'}`;
          if (!byClass.has(key)) byClass.set(key, { classId:entry.class_id, subject:entry.subject_name || 'Componente não informado', teacher });
        }
        const groups = [...classMap.values()].map(item => ({ classData:item, teachers:[...byClass.values()].filter(row => row.classId === item.id) })).filter(item => item.teachers.length);
        if (!groups.length) { list.innerHTML = '<div class="bfr-parent-teachers-empty">A escola ainda não publicou professores para esta turma.</div>'; return; }
        list.innerHTML = groups.map(group => `<article class="bfr-parent-teacher-class"><strong>${esc(classLabel(group.classData))}</strong><small>${esc(group.classData.shift || 'Turno não informado')}</small>${group.teachers.map(row => `<div class="bfr-parent-teacher-row"><span>${esc(row.subject)}</span><b>${esc(row.teacher)}</b></div>`).join('')}</article>`).join('');
      } finally { loading = false; }
    }

    let attempts = 0;
    const timer = setInterval(() => { ensurePanel(); loadTeachers(); if (++attempts > 120) clearInterval(timer); }, 1000);
    document.addEventListener('click', event => { if (event.target.closest('[data-role="parent"]')) setTimeout(() => { ensurePanel(); loadTeachers(); }, 500); });
  })();
</script>

<div id="bfr-platform-toast" role="status" class="">🏅 Conquista desbloqueada</div>
<script>
  (() => {
    const modalMeta = {
      noticeModal: ['noticeModalTitle', 'Fechar atualizações'],
      activityModal: ['activityModalTitle', 'Fechar atividade'],
      activityPublishModal: ['activityPublishModalTitle', 'Fechar publicação'],
      occurrenceModal: ['occurrenceModalTitle', 'Fechar ocorrência']
    };
    Object.entries(modalMeta).forEach(([id, [titleId, closeLabel]]) => {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      const heading = modal.querySelector('h2');
      if (heading) {
        heading.id = titleId;
        modal.setAttribute('aria-labelledby', titleId);
      }
      const close = modal.querySelector('.modal-close');
      if (close) {
        close.type = 'button';
        close.setAttribute('aria-label', closeLabel);
      }
    });
    const normalizeCalendarLink = () => {
      const calendar = [...document.querySelectorAll('.login-form .school-links a')].find(link => !link.href.includes('instagram.com'));
      if (!calendar) return;
      if (calendar.getAttribute('href') !== 'calendario-letivo-2026.pdf') calendar.setAttribute('href', 'calendario-letivo-2026.pdf');
      calendar.removeAttribute('aria-disabled');
      calendar.removeAttribute('tabindex');
      if (calendar.textContent.trim() !== 'Calendário letivo 2026 ↗') calendar.textContent = 'Calendário letivo 2026 ↗';
    };
    normalizeCalendarLink();
    const normalizeScheduleLinks = (root = document) => {
      root.querySelectorAll('a[href*="horario-matutino-2026.pdf"], a[href*="horario-vespertino-2026.pdf"]').forEach(link => {
        const href = link.getAttribute('href') || '';
        const normalizedHref = href.replace(/\.pdf(?:#.*)?$/, '.png');
        if (normalizedHref !== href) link.setAttribute('href', normalizedHref);
        const text = link.textContent.replace('PDF original', 'imagem do horário');
        if (text !== link.textContent) link.textContent = text;
      });
    };
    normalizeScheduleLinks();
    new MutationObserver(() => { normalizeScheduleLinks(); normalizeCalendarLink(); }).observe(document.body, { childList: true, subtree: true });
    const restoreScheduleVisibility = () => {
      if (document.getElementById('bfr-schedule-visibility-override')) return;
      const style = document.createElement('style');
      style.id = 'bfr-schedule-visibility-override';
      style.textContent = 'html body .schedule-panel .schedule-frame { display:block !important; } html body .schedule-panel .schedule-caption { display:flex !important; }';
      document.head.appendChild(style);
    };
    restoreScheduleVisibility();
    new MutationObserver(restoreScheduleVisibility).observe(document.head, { childList: true });
    const syncRegistration = () => {
      const registration = document.getElementById('responsibleRegistrationModal');
      if (!registration) return;
      registration.setAttribute('role', 'dialog');
      registration.setAttribute('aria-modal', 'true');
      registration.setAttribute('aria-labelledby', 'responsibleRegistrationTitle');
      registration.setAttribute('aria-describedby', 'responsibleRegistrationDescription');
      const heading = registration.querySelector('h2');
      const description = registration.querySelector('.modal-card > p');
      if (heading) heading.id = 'responsibleRegistrationTitle';
      if (description) description.id = 'responsibleRegistrationDescription';
    };
    syncRegistration();
    const syncAccountTool = () => {
      const account = document.getElementById('accountToolModal');
      if (!account) return;
      account.setAttribute('role', 'dialog');
      account.setAttribute('aria-modal', 'true');
      const heading = account.querySelector('h2');
      if (heading) {
        heading.id = 'accountToolTitle';
        account.setAttribute('aria-labelledby', 'accountToolTitle');
        account.removeAttribute('aria-describedby');
      }
    };
    syncAccountTool();
     new MutationObserver(() => { syncRegistration(); syncAccountTool(); }).observe(document.body, { childList: true, subtree: true });
      window.BFR_TEACHER_RUNTIME = {
       get client() { return supabaseClient; },
       get user() { return currentUser; },
       get profile() { return currentProfile; },
       get state() { return teacherProfessionalState; },
       render: () => teacherRenderProfessional(),
       go: section => setProfessionalTeacherSection(section),
        get academicState() { return academicState; }
      };
      window.BFR_APP_RUNTIME = {
        get client() { return supabaseClient; },
        get user() { return currentUser; },
        get profile() { return currentProfile; },
        get activeView() { return activeView; },
        get roleSectionAccess() { return roleSectionAccess; },
        navigate: section => navigateToSection(section),
        setRole: role => setRole(role),
        refresh: () => { updateLiveClock(); }
      };
     if (typeof loadProfessionalTeacherData === 'function') {
       const legacyTeacherLoader = loadProfessionalTeacherData;
       loadProfessionalTeacherData = async force => currentProfile?.role === 'pedagogical' && typeof window.BFR_SECURE_TEACHER_LOADER === 'function' ? window.BFR_SECURE_TEACHER_LOADER(force) : legacyTeacherLoader(force);
     }
     if (typeof setupAcademicPanel === 'function') {
       const legacyAcademicSetup = setupAcademicPanel;
       setupAcademicPanel = async () => currentProfile?.role === 'pedagogical' && typeof window.BFR_SECURE_ACADEMIC_SETUP === 'function' ? window.BFR_SECURE_ACADEMIC_SETUP() : legacyAcademicSetup();
     }
     if (typeof loadAcademicClass === 'function') {
       const legacyAcademicClassLoader = loadAcademicClass;
       loadAcademicClass = async classId => currentProfile?.role === 'pedagogical' && typeof window.BFR_SECURE_ACADEMIC_CLASS === 'function' ? window.BFR_SECURE_ACADEMIC_CLASS(classId, legacyAcademicClassLoader) : legacyAcademicClassLoader(classId);
     }
  })();
</script>
 <script src="bfr-professor-secure.js"></script>
