     #appShell.ready .panel:hover, #appShell.ready .metric-card:hover, #appShell.ready .teacher-metric:hover, #appShell.ready .side-highlight:hover, #appShell.ready .notice:hover, #appShell.ready .activity:hover, #appShell.ready .project:hover, #appShell.ready .growth-badge:hover { box-shadow:0 18px 42px rgba(25,64,115,.13); }
     #appShell.ready .panel:after, #appShell.ready .metric-card:after, #appShell.ready .teacher-metric:after, #appShell.ready .side-highlight:after { content:''; position:absolute; inset:0; border-radius:inherit; pointer-events:none; opacity:0; background:linear-gradient(120deg,rgba(255,255,255,.34),transparent 38%); transition:opacity .3s ease; }
     #appShell.ready .panel:hover:after, #appShell.ready .metric-card:hover:after, #appShell.ready .teacher-metric:hover:after, #appShell.ready .side-highlight:hover:after { opacity:1; }
