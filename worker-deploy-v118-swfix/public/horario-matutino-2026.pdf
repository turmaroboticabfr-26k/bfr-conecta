    .login-privacy:before { content:'✓' !important; display:grid !important; place-items:center !important; flex:0 0 60px !important; width:60px !important; height:72px !important; border:4px solid #5b83b7 !important; border-radius:16px 16px 27px 27px !important; color:#5b83b7 !important; font-size:32px !important; font-weight:800 !important; }
    .login-footer { display:none !important; }
  }
