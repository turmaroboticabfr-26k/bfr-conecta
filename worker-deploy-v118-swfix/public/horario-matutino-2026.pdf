     const photoLightbox = document.getElementById('photoLightbox');
     const photoLightboxImage = document.getElementById('photoLightboxImage');
     const photoLightboxCaption = document.getElementById('photoLightboxCaption');
     const closePhotoLightbox = () => { photoLightbox.classList.add('hidden'); document.body.classList.remove('photo-lightbox-open'); };
     const openPhotoLightbox = target => {
       const src = target.tagName === 'IMG' ? (target.currentSrc || target.src) : target.dataset.photoSrc;
       if (!src) return;
       photoLightboxImage.src = src;
       photoLightboxImage.alt = target.alt || 'Foto ampliada';
       photoLightboxCaption.textContent = target.alt || '';
       photoLightbox.classList.remove('hidden');
       document.body.classList.add('photo-lightbox-open');
       document.getElementById('closePhotoLightbox').focus();
     };
     document.getElementById('closePhotoLightbox').addEventListener('click', closePhotoLightbox);
     photoLightbox.addEventListener('click', event => { if (event.target === photoLightbox) closePhotoLightbox(); });
     document.addEventListener('click', event => {
        const target = event.target.closest('.project-photo img, .admin-project-photo img, .project-photo-list img, .schedule-image, .photo[data-photo-src]');
       if (!target || event.target.closest('[data-photo-move]')) return;
       openPhotoLightbox(target);
     });
     document.addEventListener('keydown', event => {
       if (event.key === 'Escape' && !photoLightbox.classList.contains('hidden')) closePhotoLightbox();
        if ((event.key === 'Enter' || event.key === ' ') && event.target.closest('.project-photo img, .admin-project-photo img, .project-photo-list img, .schedule-image, .photo[data-photo-src]')) {
          event.preventDefault();
