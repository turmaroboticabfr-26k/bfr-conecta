             .sidebar .brand, .sidebar .school-switch, .sidebar .nav-label, .sidebar .sidebar-foot, .sidebar > .bfr-legacy-nav { display:none; }
            .sidebar > .nav-list:first-of-type { width:100%; height:60px; display:grid; grid-template-columns:repeat(4,1fr); gap:2px; overflow:visible; padding:0; }
            .sidebar > .nav-list:first-of-type .nav-item { display:none; width:auto; min-height:58px; padding:6px 2px; border-radius:12px; place-items:center; align-content:center; gap:3px; text-align:center; font-size:9px; }
            .sidebar > .nav-list:first-of-type .nav-item[data-section="inicio"], .sidebar > .nav-list:first-of-type .nav-item[data-section="notas"], .sidebar > .nav-list:first-of-type .nav-item[data-section="comunicados"], .sidebar > .nav-list:first-of-type .mobile-more-item { display:grid; }
            .sidebar > .nav-list:first-of-type .nav-icon { display:block; width:auto; font-size:17px; }
            .sidebar > .nav-list:first-of-type .nav-item[data-section="notas"], .sidebar > .nav-list:first-of-type .nav-item[data-section="comunicados"] { font-size:0; }
