     .bfr-motion-ready :is(.primary-button,.google-button,.logout-top-button,.logout-button,.text-button,.icon-button,.nav-item,.mobile-more-option,.project-tab,.class-tab,.schedule-shift,.experience-tab,.game-subject,.growth-action):before { content:''; position:absolute; inset:0; background:linear-gradient(115deg,transparent 25%,rgba(255,255,255,.2),transparent 70%); transform:translateX(-120%); transition:transform .55s var(--bfr-motion-ease); pointer-events:none; z-index:0; }
     .bfr-motion-ready :is(.primary-button,.google-button,.logout-top-button,.logout-button,.text-button,.icon-button,.nav-item,.mobile-more-option,.project-tab,.class-tab,.schedule-shift,.experience-tab,.game-subject,.growth-action):hover:before { transform:translateX(120%); }
     .bfr-motion-ready :is(.primary-button,.google-button,.logout-top-button,.logout-button,.text-button,.icon-button,.nav-item,.mobile-more-option,.project-tab,.class-tab,.schedule-shift,.experience-tab,.game-subject,.growth-action) > * { position:relative; z-index:1; }
     .bfr-motion-ready :is(.primary-button,.google-button,.logout-top-button,.logout-button,.icon-button,.nav-item,.mobile-more-option,.project-tab,.class-tab,.schedule-shift,.experience-tab,.game-subject,.growth-action):active { transform:translateY(1px) scale(.985); }
     .bfr-motion-ready .nav-item .nav-icon, .bfr-motion-ready .metric-icon, .bfr-motion-ready .school-link-icon, .bfr-motion-ready .project-arrow { transition:transform .3s var(--bfr-motion-ease),color .3s ease; }
