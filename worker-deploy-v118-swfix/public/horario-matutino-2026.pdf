<html lang="pt-BR"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com https://*.cloudflareinsights.com https://*.googleapis.com https://fcm.googleapis.com https://api.open-meteo.com; worker-src 'self' blob:; manifest-src 'self'; form-action 'self' https://accounts.google.com https://*.supabase.co">
  <meta name="referrer" content="no-referrer">
  <script>if (window.top !== window.self) { try { window.top.location.href = window.location.href; } catch { document.documentElement.replaceChildren(); } }</script>
  <base href="/">
  <script src="bfr-vespertino-schedule.js"></script>
  <script src="bfr-admin-schedule-central-v5.js"></script>
  <title>BFR Conecta | Escola Benício Ferreira Reis</title>
  <meta name="author" content="Raull Macedo">
  <meta name="theme-color" content="#10295f">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" type="image/png" href="bfr-app-logo.png">
  <link rel="apple-touch-icon" href="bfr-app-logo.png">
  <meta name="description" content="Portal escolar da Escola Benício Ferreira Reis para acompanhar aprendizagem, comunicação e rotina escolar.">
  <link rel="canonical" href="https://bfr-conecta-aee.pages.dev/">
  <meta property="og:title" content="BFR Conecta | Escola Benício Ferreira Reis">
  <meta property="og:description" content="Portal escolar para acompanhar aprendizagem, comunicação e rotina escolar.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://bfr-conecta-aee.pages.dev/">
  <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>(function(){function label(){document.querySelector('#photoInput')?.setAttribute('aria-label','Adicionar foto da turma');document.querySelector('#globalStudentSearch')?.setAttribute('aria-label','Buscar aluno por nome');}document.addEventListener('DOMContentLoaded',label,{once:true});})();</script>
  <script>(function(){const nativeFetch=window.fetch;const fix=function(value){return typeof value==='string'?value.replaceAll('bfr-app-logo.webp','bfr-app-logo.png'):value};if(nativeFetch)window.fetch=function(input,...args){return nativeFetch.call(this,fix(input),...args)};const normalize=function(){document.querySelectorAll('img[src*="bfr-app-logo.webp"],source[srcset*="bfr-app-logo.webp"]').forEach(el=>{if(el.src)el.src=fix(el.src);if(el.srcset)el.srcset=fix(el.srcset)});};new MutationObserver(normalize).observe(document.documentElement,{subtree:true,childList:true,attributes:true,attributeFilter:['src','srcset']});document.addEventListener('DOMContentLoaded',normalize);})();</script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');
    :root {
       --ink: #17233f;
       --muted: #71809a;
       --line: #e4eaf3;
       --paper: #f5f7fb;
       --white: #ffffff;
       --teal: #2563eb;
       --teal-deep: #10295f;
       --mint: #e8f1ff;
       --coral: #f2994a;
       --sun: #ffd166;
       --lavender: #eee9ff;
       --shadow: 0 16px 38px rgba(43, 67, 115, .08);
    }
    * { box-sizing: border-box; }
    body { margin: 0; color: var(--ink); background: var(--paper); font-family: 'DM Sans', sans-serif; }
    button, input { font: inherit; }
    button { cursor: pointer; }
    .app-shell { min-height: 100vh; display: grid; grid-template-columns: 244px 1fr; }
    .sidebar { background: var(--teal-deep); color: #d9ece7; padding: 27px 18px 18px; display: flex; flex-direction: column; }
    .brand { display: flex; align-items: center; gap: 11px; padding: 0 12px 32px; color: #fff; }
    .brand-mark { width: 34px; height: 34px; background: linear-gradient(145deg,#1eb6a1,#1e65bf); border-radius: 11px 11px 11px 3px; position: relative; transform: rotate(-8deg); display:grid; place-items:center; }
    .brand-mark:after { content: 'BFR'; position: absolute; color:#fff; font:700 8px 'DM Mono',monospace; letter-spacing:-.08em; transform:rotate(8deg); }
    .brand-name { font-family: 'Playfair Display', serif; font-size: 20px; letter-spacing: -.5px; }
    .app-logo { width: 44px; height: 44px; object-fit: contain; border-radius: 10px; background: #fff; flex-shrink: 0; }
    .school-switch { border: 1px solid rgba(219, 239, 232, .16); border-radius: 13px; padding: 12px 13px; margin: 0 3px 27px; background: rgba(255,255,255,.05); }
    .eyebrow { font-family: 'DM Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
    .sidebar .eyebrow { color: #87b5aa; }
    .school-switch strong { display: block; color: #fff; font-size: 13px; margin: 5px 0 2px; }
    .school-switch span { font-size: 11px; color: #9ac3ba; }
    .nav-label { color: #77a69c; font: 10px 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .12em; padding: 0 13px 10px; }
    .nav-list { display: grid; gap: 3px; }
    .nav-item { border: 0; width: 100%; color: #acd0c7; background: transparent; display: flex; gap: 12px; align-items: center; text-align: left; padding: 11px 13px; border-radius: 10px; font-size: 13px; transition: .2s; }
    .nav-item:hover, .nav-item.active { color: #fff; background: rgba(255,255,255,.12); }
    .nav-icon { font-size: 16px; width: 19px; text-align: center; opacity: .9; }
    .nav-badge { margin-left: auto; font-size: 10px; background: var(--coral); color: #fff; border-radius: 20px; padding: 2px 7px; }
     .sidebar-foot { margin-top: auto; border-top: 1px solid rgba(219, 239, 232, .14); padding: 18px 10px 0; }
     .creator-credit { display: block; margin-top: 14px; color: #7ea9a0; font-size: 10px; line-height: 1.35; }
     .login-creator-credit { margin-top: 22px; color: #14469c; text-align: center; }
     .login-legal-links { display:flex; justify-content:center; flex-wrap:wrap; gap:12px; margin-top:12px; }
     .login-legal-links button, .legal-link-button { border:0; padding:3px; color:#14469c; background:transparent; font-size:10px; text-decoration:underline; }
     .login-legal-links button:hover, .legal-link-button:hover { color:#0b55a6; }
     .mini-person { display: flex; gap: 9px; align-items: center; }
     .logout-button { margin-top: 14px; width: 100%; border: 1px solid rgba(219,239,232,.18); border-radius: 9px; padding: 9px 10px; display: flex; align-items: center; gap: 10px; color: #acd0c7; background: transparent; font-size: 11px; text-align: left; }
     .logout-button:hover { color: #fff; background: rgba(255,255,255,.1); }
    .avatar { border-radius: 50%; object-fit: cover; flex-shrink: 0; display: grid; place-items: center; font-weight: 700; }
    .avatar.small { width: 29px; height: 29px; background: #efb4a4; color: #713b33; font-size: 11px; }
    .mini-person strong { display: block; color: #fff; font-size: 12px; font-weight: 600; }
    .mini-person span { color: #8db9ae; font-size: 10px; }
    main { min-width: 0; }
    .topbar { height: 75px; background: rgba(255,255,255,.82); border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; padding: 0 43px; position: sticky; top: 0; z-index: 3; backdrop-filter: blur(14px); }
    .breadcrumb { color: var(--muted); font-size: 12px; }
    .breadcrumb b { color: var(--ink); font-weight: 600; }
    .top-actions { display: flex; align-items: center; gap: 14px; }
    .role-toggle { display: flex; gap: 2px; background: #edf2ef; padding: 3px; border-radius: 10px; }
    .role-toggle button { border: 0; padding: 7px 12px; border-radius: 8px; color: var(--muted); background: transparent; font-size: 11px; }
    .role-toggle button.active { background: #fff; color: var(--teal); box-shadow: 0 2px 7px rgba(20,61,50,.1); font-weight: 700; }
    .admin-shortcut { border: 1px solid #93c5fd; border-radius: 10px; padding: 8px 11px; color: #1d4ed8; background: #eff6ff; font-size: 11px; font-weight: 800; white-space: nowrap; }
    .admin-shortcut:hover { border-color: #2563eb; background: #dbeafe; }
     .icon-button { border: 1px solid var(--line); width: 34px; height: 34px; border-radius: 10px; color: var(--teal); background: #fff; position: relative; }
     .logout-top-button { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; color: var(--teal); background: #fff; font-size: 11px; }
     .logout-top-button:hover { background: #f1f7f4; }
    .dot { position: absolute; width: 6px; height: 6px; background: var(--coral); border: 1px solid white; border-radius: 50%; right: 6px; top: 6px; }
    .content { padding: 35px 43px 48px; max-width: 1500px; }
    .welcome { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 28px; }
    h1, h2, h3, p { margin: 0; }
    h1 { font-family: 'Playfair Display', serif; font-size: clamp(32px, 3.5vw, 48px); line-height: 1.03; letter-spacing: -1.8px; font-weight: 700; }
    .welcome p { margin-top: 9px; color: var(--muted); font-size: 13px; }
    .date-chip { color: var(--teal); background: var(--mint); border-radius: 9px; padding: 10px 13px; font: 11px 'DM Mono', monospace; white-space: nowrap; }
    .child-card { background: var(--teal); color: white; border-radius: 18px; padding: 21px 24px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; box-shadow: var(--shadow); position: relative; overflow: hidden; }
     .child-card:after { content: ''; position: absolute; width: 180px; height: 180px; border: 1px solid rgba(255,255,255,.13); border-radius: 50%; right: 50px; top: -110px; box-shadow: 0 0 0 25px rgba(255,255,255,.04), 0 0 0 50px rgba(255,255,255,.03); }
     .parent-student-switcher { display:flex; flex-direction:column; gap:4px; position:relative; z-index:1; min-width:170px; margin:0 20px; color:#b6d8d1; font:10px 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.04em; }
      .parent-student-switcher select { width:100%; border:1px solid rgba(255,255,255,.3); border-radius:8px; padding:8px 9px; color:#fff; background:rgba(0,0,0,.12); font:600 11px 'DM Sans',sans-serif; text-transform:none; letter-spacing:0; cursor:pointer; pointer-events:auto; }
     .parent-student-switcher option { color:#17233f; background:#fff; }
    .child-info { display: flex; align-items: center; gap: 13px; position: relative; z-index: 1; }
    .avatar.child { width: 52px; height: 52px; font-size: 17px; background: #f5c7aa; color: #774f40; border: 3px solid rgba(255,255,255,.3); }
    .child-info strong { display: block; font: 600 18px 'Playfair Display', serif; }
    .child-info span { color: #b6d8d1; font-size: 11px; }
    .child-meta { display: flex; gap: 30px; position: relative; z-index: 1; }
    .child-stat { padding-left: 20px; border-left: 1px solid rgba(255,255,255,.2); }
    .child-stat b { display: block; font-size: 19px; font-weight: 600; }
    .child-stat span { font: 10px 'DM Mono', monospace; color: #acd0c7; text-transform: uppercase; }
    .overview-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 14px; margin-bottom: 18px; }
    .metric-card { background: var(--white); border: 1px solid var(--line); border-radius: 15px; padding: 18px 19px; min-height: 145px; }
    .metric-head { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: 11px; }
    .metric-icon { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; font-size: 13px; }
    .metric-icon.mint { background: var(--mint); color: var(--teal); }
    .metric-icon.sun { background: #fff1ca; color: #9b6d13; }
    .metric-icon.lav { background: var(--lavender); color: #6f5a9d; }
    .metric-value { margin: 21px 0 7px; display: flex; align-items: baseline; gap: 7px; }
    .metric-value strong { font: 700 32px 'Playfair Display', serif; letter-spacing: -1px; }
    .metric-value span { color: #15937c; font-size: 11px; font-weight: 600; }
    .metric-foot { font-size: 11px; color: var(--muted); }
    .metric-foot em { color: var(--ink); font-style: normal; font-weight: 600; }
    .main-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .85fr); gap: 18px; align-items: start; }
    .panel { background: var(--white); border: 1px solid var(--line); border-radius: 15px; padding: 21px; }
    .panel + .panel { margin-top: 18px; }
    .panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 19px; }
    .panel-heading h2 { font: 600 18px 'Playfair Display', serif; letter-spacing: -.3px; }
    .panel-heading a, .text-button { color: var(--teal); border: 0; background: transparent; font-size: 11px; padding: 3px; }
    .panel-heading a:hover, .text-button:hover { text-decoration: underline; }
    .attendance-chart { display: flex; height: 141px; gap: 11px; align-items: flex-end; padding: 3px 7px 0; border-bottom: 1px solid var(--line); }
    .bar-col { height: 100%; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 7px; }
    .bar { width: min(25px, 72%); background: var(--mint); border-radius: 6px 6px 2px 2px; position: relative; transition: .2s; }
    .bar:hover { background: var(--coral); }
    .bar.today { background: var(--teal); }
    .bar-col span { font: 9px 'DM Mono', monospace; color: var(--muted); }
    .chart-legend { display: flex; justify-content: space-between; color: var(--muted); font-size: 10px; padding-top: 12px; }
    .legend-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); margin-right: 5px; }
    .legend-dot.light { background: var(--mint); }
    .activity-list { display: grid; gap: 0; }
    .activity { display: grid; grid-template-columns: 32px 1fr auto; gap: 11px; padding: 13px 0; border-top: 1px solid #edf1ef; align-items: center; }
    .activity:first-child { border-top: 0; padding-top: 0; }
    .activity:last-child { padding-bottom: 0; }
    .activity-symbol { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 10px; font-size: 14px; }
    .activity-symbol.coral { background: #fff0eb; color: #d36b51; }
    .activity-symbol.blue { background: #eaf1f7; color: #537d9c; }
    .activity-symbol.gold { background: #fff4d5; color: #ae7e1e; }
    .activity strong { display: block; font-size: 12px; font-weight: 600; }
    .activity p { color: var(--muted); font-size: 11px; margin-top: 3px; line-height: 1.35; }
    .activity time { color: #a2afac; font: 10px 'DM Mono', monospace; align-self: start; padding-top: 2px; }
    .notice { border-radius: 12px; background: #fff5e3; padding: 13px 14px; display: flex; gap: 11px; margin-bottom: 16px; }
    .notice-mark { width: 24px; height: 24px; border-radius: 8px; background: var(--sun); color: #6e5017; display: grid; place-items: center; flex-shrink: 0; font-weight: 700; font-size: 12px; }
    .notice strong { display: block; font-size: 11px; margin-bottom: 3px; }
    .notice p { color: #8a7651; font-size: 10px; line-height: 1.45; }
    .project-list { display: grid; gap: 11px; }
    .project { display: grid; grid-template-columns: 42px 1fr auto; align-items: center; gap: 10px; }
    .project-date { width: 42px; height: 42px; border-radius: 10px; background: var(--lavender); display: grid; place-items: center; text-align: center; color: #69558f; line-height: 1; }
    .project-date b { display: block; font: 700 17px 'Playfair Display', serif; }
    .project-date span { display: block; font: 9px 'DM Mono', monospace; text-transform: uppercase; margin-top: 3px; }
    .project strong { font-size: 11px; display: block; }
    .project p { color: var(--muted); font-size: 10px; margin-top: 3px; }
    .project-arrow { color: #a0b3ad; font-size: 18px; }
    .photo-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .photo { height: 78px; border-radius: 9px; overflow: hidden; position: relative; background: #d6e8de; }
    .photo:before, .photo:after { content: ''; position: absolute; }
    .photo.one { background: linear-gradient(145deg, #c7ded3, #f2c2a6); }
    .photo.one:before { width: 55px; height: 55px; border-radius: 50%; background: #ebaf8a; left: 26px; top: 14px; box-shadow: 18px 7px 0 -2px #7a9c88; }
    .photo.one:after { width: 85px; height: 30px; background: #477564; left: 7px; bottom: -12px; border-radius: 50% 50% 0 0; }
    .photo.two { background: linear-gradient(145deg, #e9d4a5, #a3c9c4); }
    .photo.two:before { width: 100px; height: 30px; background: #e1aa67; transform: rotate(-10deg); left: -10px; bottom: 14px; border-radius: 5px; box-shadow: 42px 4px 0 #efc379; }
    .photo.two:after { width: 21px; height: 21px; border-radius: 50%; background: #e8a581; left: 32px; top: 18px; box-shadow: 37px 3px 0 #d78c6e; }
    .photo.three { background: linear-gradient(145deg, #b8c9e0, #f2d6b2); }
    .photo.three:before { width: 60px; height: 60px; background: #edf4f1; transform: rotate(18deg); left: 19px; top: 17px; border-radius: 5px; box-shadow: 20px -8px 0 -7px #e9b675; }
    .photo-count { position: absolute; right: 7px; bottom: 6px; border-radius: 10px; padding: 3px 6px; background: rgba(24,45,40,.75); color: #fff; font-size: 9px; z-index: 1; }
    .hidden { display: none !important; }
     #appShell { display:none; }
     #appShell.ready { display:grid; }
     html.auth-restoring #loginScreen { visibility:hidden; opacity:0; pointer-events:none; }
     html.auth-restoring::before { content:'Concluindo o login com o Google...'; position:fixed; inset:0; z-index:9999; display:grid; place-items:center; padding:24px; background:#f7f9ff; color:#123c91; font:600 18px 'DM Sans',sans-serif; text-align:center; }
   </style>
<style id="bfr-reference-login">
  @media (min-width:801px) {
    body:has(#loginScreen:not(.hidden)) { overflow:hidden; }
    .login-screen { height:100vh; min-height:700px; padding:0; display:block; overflow:hidden; background:linear-gradient(135deg,#063b93 0%,#0755c7 62%,#0785eb 100%); }
    .login-card { width:100%; height:100%; padding:0; border:0; border-radius:0; background:transparent; box-shadow:none; }
    .login-layout { width:100%; height:100%; min-height:100vh; grid-template-columns:50% 50%; gap:0; border-radius:0; overflow:visible; background:transparent; box-shadow:none; }
    .login-message { min-width:0; padding:14vh 46px 0; color:#fff; background:radial-gradient(circle at -4% -6%,rgba(23,123,244,.7) 0 135px,transparent 136px),linear-gradient(135deg,#063b93 0%,#0755c7 62%,#0785eb 100%); }
    .login-message:before { width:260px; height:260px; left:-150px; top:-150px; border:0; background:none; box-shadow:none; opacity:1; animation:none; }
     .login-message:after { content:''; z-index:0; left:0; right:0; bottom:0; width:auto; height:34%; border:0; border-radius:0; background:none; box-shadow:none; opacity:1; animation:none; }
    .login-message > * { position:relative; z-index:1; }
    .login-message > .eyebrow, .login-message > .school-symbol-wrap { display:none !important; }
    .login-message h1 { order:1; max-width:470px; margin:0; color:#fff; font-family:'DM Sans',sans-serif; font-size:clamp(46px,6.6vw,70px); font-weight:800; line-height:1.02; letter-spacing:-.055em; }
    .login-message > p { order:2; max-width:470px; margin-top:22px; color:#fff; font-size:clamp(19px,2.7vw,30px); line-height:1.34; }
    .login-benefits { order:3; display:grid; grid-template-columns:1fr; gap:14px; max-width:480px; margin-top:25px; padding:0; color:#fff; font-size:clamp(16px,1.9vw,22px); }
    .login-benefits > span { display:flex !important; align-items:center; min-height:75px; padding:0; border:0; border-radius:0; background:transparent; color:#fff; }
    .login-benefits > span:hover { transform:none; background:transparent; border-color:transparent; }
    .login-benefits > span > span { display:block !important; min-width:0; }
    .login-benefits b { display:grid; place-items:center; flex:0 0 75px; width:75px; height:75px; margin:0 18px 0 0; border:0; border-radius:50%; color:#fff; background:#159af3; font-size:0; }
    .login-benefits b:after { font-family:Arial,sans-serif; font-size:35px; font-weight:700; color:#fff; }
    .login-benefits > span:nth-child(1) b { background:#159af3; }
    .login-benefits > span:nth-child(2) b { background:#10bb60; }
    .login-benefits > span:nth-child(3) b { background:#ffbe12; }
    .login-benefits > span:nth-child(4) b { background:#7d2be5; }
    .login-benefits > span:nth-child(1) b:after { content:'♟'; }
    .login-benefits > span:nth-child(2) b:after { content:'▣'; }
    .login-benefits > span:nth-child(3) b:after { content:'⚑'; }
    .login-benefits > span:nth-child(4) b:after { content:'▤'; }
    .login-benefits strong, .login-benefits small { display:block; }
    .login-benefits strong { color:#fff; font-size:1em; line-height:1.2; font-weight:800; }
    .login-benefits small { margin-top:3px; color:#fff; font-size:.82em; line-height:1.25; }
    .login-form { min-width:0; margin:64px 10px 68px 0; padding:0 36px 40px; border-radius:24px; background:#fff; overflow:auto; justify-content:flex-start; }
    .login-form:before { display:none; }
    .login-form > .eyebrow { display:none; }
    .login-product-logo { display:block; width:min(100%,465px,40vh); max-height:none; aspect-ratio:1; object-fit:contain; align-self:center; margin:0 auto clamp(30px,8vh,128px); }
    .login-form h2 { margin:0; color:#10298b; font-family:'DM Sans',sans-serif; font-size:clamp(32px,4.5vw,48px); font-weight:800; line-height:1.1; letter-spacing:-.045em; }
    .login-form > p { max-width:440px; margin:12px 0 0; color:#10298b; font-size:clamp(22px,2.8vw,31px); line-height:1.28; }
    .login-form > p strong { color:#159545; font-weight:800; }
    .google-button { height:94px; margin-top:38px; padding:16px 20px; border:2px solid #b6cef0; border-radius:14px; background:#fff !important; color:#10298b !important; font-size:clamp(22px,2.8vw,32px); box-shadow:none; }
    .google-button:hover { border-color:#2563eb; background:#f7faff !important; }
    .google-g { font-size:50px; line-height:1; background:conic-gradient(from -45deg,#4285f4 0 25%,#34a853 25% 46%,#fbbc05 46% 67%,#ea4335 67% 82%,#4285f4 82%); -webkit-background-clip:text; background-clip:text; color:transparent; }
     .schedule-public-button { display:flex !important; align-items:center !important; justify-content:center !important; gap:6px !important; width:100% !important; margin:12px 0 0 !important; padding:4px 0 !important; border:0 !important; background:transparent !important; color:#1769d2 !important; font-size:14px !important; font-weight:700 !important; }
     .login-privacy { display:flex !important; align-items:center; gap:23px; max-width:440px; margin:30px 0 0; color:#14469c; font-size:clamp(18px,2vw,27px); line-height:1.34; }
     .login-privacy:before { content:'✓'; display:grid; place-items:center; flex:0 0 60px; width:60px; height:72px; border:4px solid #5b83b7; border-radius:16px 16px 27px 27px; color:#5b83b7; font-size:32px; font-weight:800; }
     .school-links { display:flex; flex-wrap:wrap; gap:14px; margin-top:12px; }
     .school-links a { font-size:clamp(13px,1.25vw,17px); }
     .login-footer { display:none; }
  }
    @media (max-width:800px) {
    .login-screen { min-height:100svh; height:auto; padding:0; display:block; overflow:hidden; }
    .login-card { width:100%; min-height:100svh; padding:0; border:0; border-radius:0; box-shadow:none; }
    .login-layout { min-height:100svh; display:flex; flex-direction:column; border-radius:0; background:transparent; }
    .login-message { min-height:620px; padding:58px 26px 30px; background:linear-gradient(145deg,#063b93,#0755c7 64%,#0785eb); }
    .login-message:before { display:none; }
    .login-message:after { height:250px; background-size:200% auto; }
    .login-message > .eyebrow, .login-message > .school-symbol-wrap { display:none !important; }
    .login-message h1 { max-width:330px; font-size:40px; }
    .login-message > p { max-width:330px; margin-top:18px; font-size:20px; }
    .login-benefits { gap:10px; max-width:none; margin-top:25px; font-size:15px; }
    .login-benefits > span { min-height:62px; }
    .login-benefits b { flex-basis:62px; width:62px; height:62px; margin-right:13px; }
    .login-benefits b:after { font-size:28px; }
    .login-form { display:flex !important; min-height:520px; margin:0; padding:34px 26px 48px; border-radius:0; overflow:visible; justify-content:flex-start; }
    .login-form:before { display:none; }
    .login-form > .eyebrow { display:none; }
    .login-product-logo { width:min(100%,300px); margin:0 auto 28px; }
    .login-form h2 { font-size:32px; }
    .login-form > p { font-size:22px; }
    .google-button { height:72px; margin-top:28px; font-size:21px; }
    .google-g { font-size:38px; }
     .schedule-public-button { display:flex !important; align-items:center !important; justify-content:center !important; gap:6px !important; width:100% !important; margin:12px 0 0 !important; padding:4px 0 !important; border:0 !important; background:transparent !important; color:#1769d2 !important; font-size:14px !important; font-weight:700 !important; }
    .login-privacy { gap:15px; margin-top:34px; font-size:18px; }
    .login-privacy:before { flex-basis:48px; width:48px; height:58px; border-width:3px; font-size:25px; }
    .login-footer { display:none; }
  }
</style>
<script>
  (() => {
    const params = new URLSearchParams(location.search);
    const hash = new URLSearchParams(location.hash.replace(/^#/, ''));
    if (params.has('code') || hash.has('access_token')) document.documentElement.classList.add('auth-restoring');
    const isOAuthCallback = params.has('code') || hash.has('access_token') || params.has('error') || hash.has('error');
    const pathname = location.pathname.replace(/\/+$/, '') || '/';
    if (pathname !== '/' && !isOAuthCallback) history.replaceState({}, document.title, `/${location.search}${location.hash}`);
  })();
</script>
<style id="teacher-professional-style">
  #appShell.teacher-mode .bfr-platform-nav,
  #appShell.teacher-mode .bfr-legacy-label,
  #appShell.teacher-mode .bfr-legacy-nav { display:none !important; }
  #appShell.teacher-mode .teacher-command-nav { display:grid !important; gap:4px; }
  #appShell.teacher-mode .teacher-command-nav .nav-item { color:#334155 !important; background:transparent !important; }
  #appShell.teacher-mode .teacher-command-nav .nav-item:hover { color:#1d4ed8 !important; background:#eff6ff !important; }
  #appShell.teacher-mode .teacher-command-nav .nav-item.active { color:#fff !important; background:linear-gradient(135deg,#172554,#2563eb 65%,#0ea5a4) !important; box-shadow:0 8px 18px rgba(37,99,235,.18); }
  #teacherView > :not([data-teacher-professional]) { display:none !important; }
  .teacher-command-nav { border-bottom:1px solid var(--line); padding-bottom:12px; margin-bottom:12px; }
  .teacher-command-nav .nav-item { min-height:38px; }
  .teacher-pro-shell { display:grid; gap:18px; padding-bottom:34px; }
  .teacher-pro-hero { display:flex; align-items:flex-end; justify-content:space-between; gap:22px; padding:28px; border-radius:22px; color:#fff; background:linear-gradient(135deg,#172554,#2563eb 58%,#0ea5a4); box-shadow:0 18px 38px rgba(37,99,235,.16); }
  .teacher-pro-hero h1 { margin:7px 0 8px; color:#fff; font:800 clamp(28px,4vw,46px) 'DM Sans',sans-serif; letter-spacing:-.055em; }
  .teacher-pro-hero p { max-width:650px; color:#dbeafe; font-size:13px; line-height:1.55; }
  .teacher-pro-hero .eyebrow { color:#bfdbfe; }
  .teacher-pro-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
  .teacher-pro-actions button { border:1px solid rgba(255,255,255,.34); border-radius:10px; padding:10px 13px; color:#fff; background:rgba(255,255,255,.13); font-size:11px; font-weight:800; white-space:nowrap; }
  .teacher-pro-actions button:first-child { border-color:#fff; color:#172554; background:#fff; }
  .teacher-pro-metrics { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; }
  .teacher-pro-metric { min-width:0; padding:16px; border:1px solid var(--line); border-radius:16px; background:#fff; box-shadow:var(--shadow); }
  .teacher-pro-metric span { display:block; color:#64748b; font-size:10px; font-weight:700; }
  .teacher-pro-metric strong { display:block; margin-top:8px; color:#1d4ed8; font:800 28px 'DM Sans',sans-serif; }
  .teacher-pro-metric small { display:block; margin-top:5px; color:#94a3b8; font-size:9px; }
  .teacher-pro-section-head { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:12px; }
  .teacher-pro-section-head h2 { color:#172554; font-size:19px; }
  .teacher-pro-section-head p { margin-top:4px; color:#64748b; font-size:11px; }
  .teacher-pro-quick-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
  .teacher-pro-quick { display:grid; gap:5px; min-height:82px; padding:14px; border:1px solid #dbeafe; border-radius:15px; color:#1e3a8a; background:#eff6ff; text-align:left; }
  .teacher-pro-quick:hover { border-color:#60a5fa; background:#dbeafe; }
  .teacher-pro-quick strong { font-size:12px; }
  .teacher-pro-quick span { color:#64748b; font-size:10px; }
  .teacher-pro-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr); gap:14px; }
  .teacher-pro-list { display:grid; gap:8px; }
  .teacher-pro-list article { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 0; border-top:1px solid #edf2f7; }
  .teacher-pro-list article:first-child { border-top:0; padding-top:0; }
  .teacher-pro-list strong { display:block; color:#243b63; font-size:12px; }
  .teacher-pro-list span { display:block; margin-top:4px; color:#64748b; font-size:10px; line-height:1.4; }
  .teacher-pro-list button, .teacher-pro-inline-button { flex-shrink:0; border:1px solid #cfe0fb; border-radius:9px; padding:8px 10px; color:#1d4ed8; background:#eff6ff; font-size:10px; font-weight:800; }
  .teacher-pro-empty { padding:22px 14px; border:1px dashed #cbd5e1; border-radius:12px; color:#64748b; background:#f8fafc; font-size:11px; line-height:1.5; }
  .teacher-pro-screen { display:grid; gap:14px; }
  .teacher-pro-class-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .teacher-pro-class-card { display:grid; gap:8px; padding:16px; border:1px solid #dbe5f1; border-radius:15px; background:#fff; box-shadow:0 8px 22px rgba(43,67,115,.05); }
  .teacher-pro-class-card h3 { color:#1e3a8a; font-size:15px; }
  .teacher-pro-class-card p { color:#64748b; font-size:10px; }
  .teacher-pro-class-card .teacher-pro-class-stats { display:flex; flex-wrap:wrap; gap:7px; color:#475569; font-size:9px; }
  .teacher-pro-class-card .teacher-pro-class-stats b { color:#1d4ed8; }
  .teacher-pro-class-card button { justify-self:start; border:0; padding:0; color:#2563eb; background:transparent; font-size:10px; font-weight:800; }
  .teacher-pro-tabs { display:flex; gap:6px; overflow:auto; padding-bottom:2px; }
  .teacher-pro-tabs button { flex-shrink:0; border:1px solid #dbe5f1; border-radius:999px; padding:8px 11px; color:#64748b; background:#fff; font-size:10px; font-weight:800; }
  .teacher-pro-tabs button.active { border-color:#93c5fd; color:#1d4ed8; background:#eff6ff; }
  .teacher-pro-student-list { display:grid; gap:7px; }
  .teacher-pro-student-row { display:grid; grid-template-columns:34px minmax(0,1fr) auto auto; gap:10px; align-items:center; padding:11px 0; border-top:1px solid #edf2f7; }
  .teacher-pro-student-row:first-child { border-top:0; }
  .teacher-pro-student-row .avatar { width:30px; height:30px; font-size:10px; }
  .teacher-pro-student-row strong { display:block; color:#243b63; font-size:11px; }
  .teacher-pro-student-row span { display:block; margin-top:3px; color:#64748b; font-size:9px; }
  .teacher-pro-status { border-radius:999px; padding:5px 8px; color:#166534; background:#ecfdf5; font-size:9px; font-weight:800; }
  .teacher-pro-status.warn { color:#a16207; background:#fef3c7; }
  .teacher-pro-data-panel { display:none !important; }
  #teacherView .teacher-pro-screen[data-teacher-screen="frequencia"] .teacher-pro-data-panel { display:block !important; }
  @media(max-width:1050px) { .teacher-pro-metrics { grid-template-columns:repeat(3,minmax(0,1fr)); } .teacher-pro-class-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:800px) { .teacher-pro-hero { display:block; padding:20px; } .teacher-pro-actions { justify-content:flex-start; margin-top:16px; } .teacher-pro-metrics,.teacher-pro-quick-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .teacher-pro-grid { grid-template-columns:1fr; } .teacher-pro-class-grid { grid-template-columns:1fr; } }
  @media(max-width:430px) { .teacher-pro-metrics { grid-template-columns:1fr 1fr; } .teacher-pro-metric { padding:13px; } .teacher-pro-metric strong { font-size:24px; } .teacher-pro-student-row { grid-template-columns:30px minmax(0,1fr); } .teacher-pro-student-row > :nth-child(n+3) { grid-column:2; } }
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.50.0/dist/umd/supabase.min.js" async=""></script><style id="lia-avatar-fallback-style">.login-message:before{background-image:url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20256%20256%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22bg%22%20x1%3D%2228%22%20y1%3D%2220%22%20x2%3D%22228%22%20y2%3D%22238%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%3Cstop%20stop-color%3D%22%2324b7a1%22%2F%3E%3Cstop%20offset%3D%22.58%22%20stop-color%3D%22%231769d2%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23745bd4%22%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%22face%22%20x1%3D%2286%22%20y1%3D%2274%22%20x2%3D%22171%22%20y2%3D%22188%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%3Cstop%20stop-color%3D%22%23fff%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23dbeaff%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Ccircle%20cx%3D%22128%22%20cy%3D%22128%22%20r%3D%22124%22%20fill%3D%22%2310295f%22%2F%3E%3Ccircle%20cx%3D%22128%22%20cy%3D%22128%22%20r%3D%22111%22%20fill%3D%22url(%23bg)%22%2F%3E%3Cpath%20d%3D%22M66%20119c0-39%2028-67%2062-67s62%2028%2062%2067v19c0%2043-27%2072-62%2072s-62-29-62-72v-19Z%22%20fill%3D%22url(%23face)%22%2F%3E%3Cpath%20d%3D%22M74%20112c4-41%2029-66%2061-66%2034%200%2057%2025%2061%2066-17-16-34-23-59-23-25%200-43%207-63%2023Z%22%20fill%3D%22%2310295f%22%2F%3E%3Ccircle%20cx%3D%22105%22%20cy%3D%22132%22%20r%3D%227%22%20fill%3D%22%2310295f%22%2F%3E%3Ccircle%20cx%3D%22151%22%20cy%3D%22132%22%20r%3D%227%22%20fill%3D%22%2310295f%22%2F%3E%3Cpath%20d%3D%22M107%20161c12%2010%2026%2010%2041%200%22%20fill%3D%22none%22%20stroke%3D%22%231769d2%22%20stroke-linecap%3D%22round%22%20stroke-width%3D%227%22%2F%3E%3Cpath%20d%3D%22M128%2045V27%22%20fill%3D%22none%22%20stroke%3D%22%23dffbff%22%20stroke-linecap%3D%22round%22%20stroke-width%3D%227%22%2F%3E%3Ccircle%20cx%3D%22128%22%20cy%3D%2220%22%20r%3D%229%22%20fill%3D%22%23facc15%22%2F%3E%3Ccircle%20cx%3D%2248%22%20cy%3D%2296%22%20r%3D%229%22%20fill%3D%22%23facc15%22%2F%3E%3Ccircle%20cx%3D%22208%22%20cy%3D%2296%22%20r%3D%229%22%20fill%3D%22%23facc15%22%2F%3E%3Cpath%20d%3D%22M48%2096h18M190%2096h18%22%20stroke%3D%22%23dffbff%22%20stroke-linecap%3D%22round%22%20stroke-width%3D%225%22%2F%3E%3Cpath%20d%3D%22M84%20207c13%2010%2028%2015%2044%2015s31-5%2044-15%22%20fill%3D%22none%22%20stroke%3D%22%23dffbff%22%20stroke-linecap%3D%22round%22%20stroke-width%3D%226%22%2F%3E%3C%2Fsvg%3E') !important}</style><style id="bfr-parent-navigation-v2-style">.parent-detail-hidden{display:none!important}#appShell.ready[data-parent-nav="true"] .bfr-legacy-label,#appShell.ready[data-parent-nav="true"] .bfr-legacy-nav{display:none!important}.bfr-parent-area-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(138px,1fr));gap:8px;margin-top:16px}.bfr-parent-area-link{display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:9px 11px;border:1px solid #cfe0fb;border-radius:9px;color:#1d4ed8;background:linear-gradient(180deg,#fbfdff,#eff6ff);box-shadow:0 3px 9px rgba(37,99,235,.06);font-size:10px;font-weight:800;line-height:1.2;text-align:left;transition:transform .18s,border-color .18s,background .18s}.bfr-parent-area-link:hover,.bfr-parent-area-link:focus-visible{transform:translateY(-1px);border-color:#93c5fd;background:#e8f1ff}.bfr-parent-area-link span{color:#1769d2;font-size:13px;line-height:1;opacity:.78}@media(max-width:600px){.bfr-parent-area-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.bfr-parent-area-link{min-height:38px;padding:9px 10px;font-size:9px}}</style><style id="bfr-parent-refinement-style">
          #parentView{display:flex;flex-direction:column}
          #parentView>*{order:100}
          #parentView>.welcome{order:10}
          #parentView>.child-card{order:20}
          #parentView>[data-parent-focus-heading]{order:30}
          #parentView>.overview-grid{order:40}
          #parentView>[data-parent-data-status]{order:45}
          #parentView>.main-grid{order:50}
          #parentView>.communication-grid{order:60}
          #parentView>#weatherWidget,#parentView>.lia-home-card,#parentView>#bfrHomeDock,#parentView>.growth-hub,#parentView>[data-bfr-reading-panel],#parentView>[data-bfr-reading-assist-usage],#parentView>[data-bfr-birthdays],#parentView>[data-schedule-panel],#parentView>[data-school-activities-panel],#parentView>[data-games-panel],#parentView>[data-badge-panel],#parentView>[data-projects-panel],#parentView>[data-experience-panel],#parentView>[data-growth-notifications],#parentView>[data-growth-calendar],#parentView>[data-growth-school],#parentView>[data-growth-messages],#parentView>[data-growth-documents],#parentView>[data-growth-requests],#parentView>[data-growth-profile],#parentView>[data-growth-achievements]{order:100}
          #parentView .parent-focus-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 12px;padding:0 2px}
          #parentView .parent-focus-heading h2{margin:4px 0 0;color:#173b79;font:700 20px 'Playfair Display',serif}
          #parentView .parent-focus-heading>span{color:#8290a3;font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.04em}
          #parentView>.child-card{margin-bottom:12px}
          #parentView>.child-card .child-info small{display:block;margin-top:5px;color:#d8f4e9;font:9px 'DM Mono',monospace;letter-spacing:.03em}
          #parentView>.overview-grid{margin-top:0}
          #parentView>.overview-grid .metric-card{min-height:112px;padding:14px}
          #parentView .data-empty-inline,#parentView .roster-empty,#parentView .project-empty{min-height:0;margin:0;padding:10px 12px;border:1px dashed #d6e2ef;border-radius:10px;color:#7b899c;background:#fbfdff;font-size:10px;line-height:1.4}
          #parentView .attendance-chart:has(.data-empty-inline){display:block;height:auto;min-height:0;padding:0;border:0}
          #parentView .notice:has(.data-empty-inline),#parentView .activity-list:has(.data-empty-inline){min-height:0;padding:0}
          #parentView .panel:has(>.data-empty-inline),#parentView .panel:has(.project-list>.data-empty-inline),#parentView .panel:has(.activity-list>.data-empty-inline){min-height:0}
          #parentView>.lia-home-card{margin-top:14px}
          #parentView>.growth-hub,#parentView>#bfrHomeDock{margin-top:14px}
          @media(max-width:700px){#parentView .parent-focus-heading{display:block}#parentView .parent-focus-heading>span{display:block;margin-top:7px}#parentView>.overview-grid .metric-card{min-height:0;padding:12px}#parentView>.child-card .child-info small{color:#187b68}}
         </style><style id="bfr-published-asset-fix">.login-message:before,.login-message:after,.login-form,.login-layout,.school-symbol-wrap{background-image:none!important}</style><script>(function(){const fix=function(value){return typeof value==='string'?value.replace(/bfr-app-logo\\.webp/gi,'bfr-app-logo.png'):value};const nativeFetch=window.fetch;if(nativeFetch)window.fetch=function(input,...args){return nativeFetch.call(this,fix(input),...args)};const normalize=function(){document.querySelectorAll('img[src$=".webp"],source[srcset*=".webp"]').forEach(el=>{if(el.src)el.src=fix(el.src);if(el.srcset)el.srcset=fix(el.srcset)});document.querySelectorAll('#teacherMessageForm textarea:not([aria-label])').forEach(el=>el.setAttribute('aria-label','Recado para a professora da turma'));document.querySelectorAll('a[href="horario-matutino-2026.pdf"]').forEach(el=>{el.href='horario-matutino-2026.png';el.textContent='Abrir imagem do horário matutino ↗'});document.querySelectorAll('a[href="horario-vespertino-2026.pdf"]').forEach(el=>{el.href='horario-vespertino-2026.png';el.textContent='Abrir imagem do horário vespertino ↗'});};new MutationObserver(normalize).observe(document.documentElement,{subtree:true,childList:true,attributes:true,attributeFilter:['src','srcset']});document.addEventListener('DOMContentLoaded',normalize);})();</script></head>
<body class="bfr-motion-ready">
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-brand"><img class="login-logo" src="bfr-app-logo.webp" alt="Logo BFR Conecta"><div><strong>BFR Conecta</strong><span>Escola Benício Ferreira Reis</span></div></div>
      <div class="login-layout">
