            {q:'A Lei Áurea, que aboliu oficialmente a escravidão no Brasil, foi assinada em:',o:['1822','1888','1930'],a:1},
            {q:'Uma consequência marcante da Revolução Industrial foi:',o:['A expansão das fábricas e da urbanização','O fim do comércio internacional','A redução do uso de máquinas'],a:0},
            {q:'A Guerra Fria foi principalmente uma disputa política e ideológica entre:',o:['Brasil e Argentina','França e Alemanha','Estados Unidos e União Soviética'],a:2}
          ],
