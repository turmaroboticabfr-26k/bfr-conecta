        <script>
          (() => {
             const loginMessage = document.querySelector('.login-message');
             const loginForm = document.querySelector('.login-form');
            document.querySelectorAll('.login-logo,.school-symbol,.app-logo').forEach(image => { image.src = 'bfr-app-logo.webp'; image.removeAttribute('srcset'); });
           const schoolSwitch = document.querySelector('.school-switch');
           if (schoolSwitch && !schoolSwitch.querySelector('.school-social-link')) schoolSwitch.insertAdjacentHTML('beforeend', '<a class="school-social-link" href="https://www.instagram.com/ebenicioferreirareis/" target="_blank" rel="noopener noreferrer"><span class="school-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></span>Instagram da escola ↗</a>');
            const loginTitle = loginForm?.querySelector('h2');
            const loginIntro = loginForm?.querySelector(':scope > p');
            if (loginMessage?.querySelector('h1')) loginMessage.querySelector('h1').textContent = 'A escola mais próxima de cada família.';
            if (loginTitle) loginTitle.textContent = 'Bem-vindo de volta!';
            if (loginIntro) loginIntro.innerHTML = 'Entre para gerenciar e<br><strong>fazer a diferença!</strong>';
             if (loginForm && !loginForm.querySelector('.login-product-logo')) {
              const logo = document.createElement('img');
              logo.className = 'login-product-logo';
              logo.src = 'bfr-app-logo.webp';
              logo.alt = 'BFR Conecta · Escola Benício Ferreira Reis';
               loginForm.prepend(logo);
             }
             if (loginForm && !loginForm.querySelector('.school-links')) loginForm.insertAdjacentHTML('beforeend', '<div class="school-links"><a href="https://www.instagram.com/ebenicioferreirareis/" target="_blank" rel="noopener noreferrer"><span class="school-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></span><span>Instagram da escola ↗</span></a><a href="calendario-letivo-2026.pdf" target="_blank" rel="noopener noreferrer"><span class="school-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18"></path><path d="M7 14h2M11 14h2M15 14h2M7 17h2M11 17h2"></path></svg></span><span>Calendário letivo 2026 ↗</span></a></div>');
            const benefits = document.querySelector('.login-benefits');
            if (benefits) benefits.innerHTML = [
              ['♟','Alunos','Seu futuro, nossa prioridade.'],
              ['▦','Pais e Responsáveis','Mais conexão, mais confiança.'],
              ['✎','Professores','Informação e apoio no dia a dia.'],
              ['▤','Coordenação Pedagógica','Gestão e organização para melhores resultados.']
            ].map(([icon,title,text]) => `<span><b aria-hidden="true">${icon}</b><span><strong>${title}</strong><small>${text}</small></span></span>`).join('');
          })();
        </script>
