    .login-message { display:flex !important; min-width:0; padding:14vh 46px 0 !important; color:#fff !important; background:radial-gradient(circle at -4% -6%,rgba(23,123,244,.7) 0 135px,transparent 136px),linear-gradient(135deg,#063b93 0%,#0755c7 62%,#0785eb 100%) !important; }
    .login-message:before { width:260px !important; height:260px !important; left:-150px !important; top:-150px !important; border:0 !important; background:none !important; box-shadow:none !important; opacity:1 !important; animation:none !important; }
      .login-message:after { content:'' !important; z-index:0 !important; left:0 !important; right:0 !important; bottom:0 !important; width:auto !important; height:34% !important; border:0 !important; border-radius:0 !important; background:none !important; box-shadow:none !important; opacity:1 !important; animation:none !important; }
    .login-message > * { position:relative !important; z-index:1 !important; }
    .login-message > .eyebrow, .login-message > .school-symbol-wrap { display:none !important; }
    .login-message h1 { order:1 !important; max-width:470px !important; margin:0 !important; color:#fff !important; font-family:'DM Sans',sans-serif !important; font-size:clamp(46px,6.6vw,70px) !important; font-weight:800 !important; line-height:1.02 !important; letter-spacing:-.055em !important; }
    .login-message > p { order:2 !important; max-width:470px !important; margin-top:22px !important; color:#fff !important; font-size:clamp(19px,2.7vw,30px) !important; line-height:1.34 !important; }
    .login-benefits { order:3 !important; display:grid !important; grid-template-columns:1fr !important; gap:14px !important; max-width:480px !important; margin-top:25px !important; padding:0 !important; color:#fff !important; font-size:clamp(16px,1.9vw,22px) !important; }
    .login-benefits > span { display:flex !important; align-items:center !important; min-height:75px !important; padding:0 !important; border:0 !important; border-radius:0 !important; background:transparent !important; color:#fff !important; }
    .login-benefits > span:hover { transform:none !important; background:transparent !important; border-color:transparent !important; }
    .login-benefits > span > span { display:block !important; min-width:0 !important; }
    .login-benefits b { display:grid !important; place-items:center !important; flex:0 0 75px !important; width:75px !important; height:75px !important; margin:0 18px 0 0 !important; border:0 !important; border-radius:50% !important; color:#fff !important; background:#159af3 !important; font-size:0 !important; }
    .login-benefits b:after { font-family:Arial,sans-serif !important; font-size:35px !important; font-weight:700 !important; color:#fff !important; }
    .login-benefits > span:nth-child(1) b { background:#159af3 !important; }
    .login-benefits > span:nth-child(2) b { background:#10bb60 !important; }
    .login-benefits > span:nth-child(3) b { background:#ffbe12 !important; }
    .login-benefits > span:nth-child(4) b { background:#7d2be5 !important; }
    .login-benefits > span:nth-child(1) b:after { content:'♟' !important; }
    .login-benefits > span:nth-child(2) b:after { content:'▣' !important; }
    .login-benefits > span:nth-child(3) b:after { content:'⚑' !important; }
    .login-benefits > span:nth-child(4) b:after { content:'▤' !important; }
    .login-benefits strong, .login-benefits small { display:block !important; }
    .login-benefits strong { color:#fff !important; font-size:1em !important; line-height:1.2 !important; font-weight:800 !important; }
    .login-benefits small { margin-top:3px !important; color:#fff !important; font-size:.82em !important; line-height:1.25 !important; }
    .login-form { display:flex !important; min-width:0; margin:64px 10px 68px 0 !important; padding:0 36px 40px !important; border-radius:24px !important; background:#fff !important; overflow:auto !important; justify-content:flex-start !important; }
    .login-form:before { display:none !important; }
    .login-form > .eyebrow { display:none !important; }
    .login-product-logo { display:block !important; width:min(100%,465px,40vh) !important; max-height:none !important; aspect-ratio:1; object-fit:contain; align-self:center; margin:0 auto clamp(30px,8vh,128px) !important; }
    .login-form h2 { margin:0 !important; color:#10298b !important; font-family:'DM Sans',sans-serif !important; font-size:clamp(32px,4.5vw,48px) !important; font-weight:800 !important; line-height:1.1 !important; letter-spacing:-.045em !important; }
    .login-form > p { max-width:440px !important; margin:12px 0 0 !important; color:#10298b !important; font-size:clamp(22px,2.8vw,31px) !important; line-height:1.28 !important; }
    .login-form > p strong { color:#159545 !important; font-weight:800 !important; }
    .google-button { height:94px !important; margin-top:38px !important; padding:16px 20px !important; border:2px solid #b6cef0 !important; border-radius:14px !important; background:#fff !important; color:#10298b !important; font-size:clamp(22px,2.8vw,32px) !important; box-shadow:none !important; }
    .google-button:hover { border-color:#2563eb !important; background:#f7faff !important; }
