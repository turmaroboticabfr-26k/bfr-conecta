            let result;
            try { result = await savePreferredName(name); } catch (error) { result = { error }; }
           if (result.error) { button.disabled = false; status.textContent = result.error.message || 'Não foi possível salvar agora. Tente novamente.'; return; }
           resolve(finish(true));
         }, { once:true });
         form.display_name_custom.focus();
       });
