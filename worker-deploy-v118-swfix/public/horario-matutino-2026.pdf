            {q:'O crescimento urbano sem planejamento pode provocar principalmente:',o:['Mais áreas verdes preservadas','Problemas de moradia, trânsito e saneamento','A diminuição da concentração populacional'],a:1}
          ],
          'Língua Inglesa':[
            {q:'Complete: “If I had more time, I ___ more.”',o:['study','would study','studied'],a:1},
            {q:'Complete: “She has lived here ___ 2019.”',o:['since','for','during'],a:0},
            {q:'Em “Although it was raining, they continued the game”, a palavra “although” indica:',o:['Causa','Condição','Contraste'],a:2},
            {q:'A frase “The book was written by Ana” está na:',o:['Voz ativa','Voz passiva','Forma interrogativa'],a:1}
          ],
          'Arte':[
            {q:'Na perspectiva de um ponto de fuga, as linhas que se afastam parecem:',o:['Convergir para um ponto no horizonte','Ficar sempre paralelas ao observador','Desaparecer apenas nas cores escuras'],a:0},
            {q:'A Semana de Arte Moderna, marco do modernismo brasileiro, ocorreu em:',o:['1822','1922','1964'],a:1},
            {q:'Qual é a cor complementar do azul no círculo cromático?',o:['Verde','Violeta','Laranja'],a:2},
            {q:'Em fotografia, contraste é principalmente a diferença entre:',o:['Áreas claras e escuras','Tamanhos de arquivos','Velocidades de impressão'],a:0}
          ],
          'Educação Física':[
