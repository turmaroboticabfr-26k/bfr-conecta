            {q:'O treinamento aeróbico desenvolve principalmente:',o:['Flexibilidade dos dedos','Resistência cardiorrespiratória','Velocidade de reação visual'],a:1},
            {q:'Para reduzir o risco de lesões, é mais adequado:',o:['Ignorar sinais de dor','Aumentar a carga de uma vez','Aquecer e progredir com orientação'],a:2},
            {q:'No esporte, fair play significa:',o:['Respeitar regras, adversários e decisões','Vencer a qualquer custo','Evitar cooperar com a equipe'],a:0}
          ],
          'Ensino Religioso':[
            {q:'Um Estado laico:',o:['Escolhe uma religião oficial','Garante liberdade de crença sem religião oficial','Proíbe manifestações religiosas'],a:1},
            {q:'O diálogo inter-religioso deve começar por:',o:['Respeito às diferenças e escuta','Tentativa de impor uma crença','Evitar qualquer conversa'],a:0},
            {q:'Os direitos humanos são considerados universais porque:',o:['Valem apenas para cidadãos de um país','Dependem da religião de cada pessoa','Devem proteger todas as pessoas'],a:2},
            {q:'A pluralidade religiosa em uma sociedade democrática exige:',o:['Exclusão de grupos minoritários','Convivência com respeito e igualdade','Que todos sigam a mesma tradição'],a:1}
