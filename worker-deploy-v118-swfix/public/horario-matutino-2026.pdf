   <style>
    .login-screen { min-height:100vh; background:linear-gradient(135deg,#e7f3ee 0%,#f8faf7 54%,#e8eef9 100%); display:grid; place-items:center; padding:24px; }
    .login-card { width:min(100%,980px); background:#fff; border:1px solid rgba(15,98,88,.12); border-radius:24px; padding:25px; box-shadow:0 25px 80px rgba(17,71,57,.13); }
    .login-brand { display:flex; align-items:center; gap:11px; color:var(--teal-deep); padding:2px 4px 22px; }
    .login-logo { width:54px; height:54px; object-fit:contain; border-radius:11px; background:#fff; border:1px solid #e8edeb; }
    .login-brand .brand-mark { width:38px; height:38px; }
    .login-brand strong { display:block; font:700 22px 'Playfair Display',serif; }
    .login-brand span { display:block; color:var(--muted); font-size:10px; margin-top:2px; }
    .login-layout { display:grid; grid-template-columns:1.15fr .85fr; min-height:430px; border-radius:17px; overflow:hidden; background:var(--teal-deep); }
    .login-message { padding:56px 52px; color:#fff; background:radial-gradient(circle at 85% 16%,rgba(67,184,159,.24),transparent 27%),var(--teal-deep); position:relative; overflow:hidden; }
    .login-message:after { content:''; position:absolute; width:290px; height:290px; border:1px solid rgba(255,255,255,.12); border-radius:50%; right:-125px; bottom:-160px; box-shadow:0 0 0 28px rgba(255,255,255,.035),0 0 0 55px rgba(255,255,255,.025); }
    .login-message .eyebrow { color:#8fc9ba; }
    .school-symbol-wrap { display:flex; align-items:center; gap:10px; margin-top:17px; }
    .school-symbol { width:54px; height:54px; object-fit:contain; border-radius:12px; background:#fff; padding:4px; }
    .school-symbol-wrap span { color:#f3d916; font:9px 'DM Mono',monospace; letter-spacing:.08em; }
    .login-message h1 { max-width:420px; font-size:clamp(36px,4.5vw,56px); margin-top:13px; }
    .login-message > p { color:#c0ded6; max-width:400px; line-height:1.55; font-size:13px; margin-top:17px; }
    .login-benefits { display:grid; gap:13px; margin-top:35px; color:#d9eee8; font-size:11px; }
    .login-benefits span { display:flex; align-items:center; gap:10px; }
    .login-benefits b { display:grid; place-items:center; width:25px; height:25px; border:1px solid rgba(255,255,255,.25); border-radius:8px; color:var(--sun); font:9px 'DM Mono',monospace; }
    .login-form { background:#fff; padding:57px 46px; display:flex; flex-direction:column; justify-content:center; }
    .login-form h2 { font:600 27px 'Playfair Display',serif; margin-top:9px; }
    .login-form > p { color:var(--muted); font-size:12px; line-height:1.5; margin-top:8px; max-width:280px; }
    .google-button { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; background:#fff; border:1px solid #cad7d2; border-radius:10px; color:#30453f; padding:12px; margin-top:24px; font-size:12px; font-weight:700; box-shadow:0 3px 9px rgba(25,65,52,.06); }
    .google-button:hover { border-color:var(--teal); background:#f7fbf8; }
    .google-g { color:#4285f4; font:700 20px Arial,sans-serif; }
    .auth-status { border-radius:9px; padding:10px; font-size:10px; line-height:1.4; margin-top:10px; }
    .auth-status.pending { color:#956a13; background:#fff5db; }
    .auth-status.approved { color:#16826f; background:#eaf6ef; }
    .login-divider { display:flex; align-items:center; gap:10px; color:#a3b0ab; font:9px 'DM Mono',monospace; margin:22px 0 13px; }
    .login-divider:before, .login-divider:after { content:''; height:1px; background:var(--line); flex:1; }
     .developer-link { border:0; background:transparent; color:var(--teal); text-align:left; padding:0; font-size:11px; font-weight:700; }
     .developer-link span { float:right; font-size:17px; line-height:10px; }
     .schedule-public-button { border:0; background:transparent; color:var(--teal); text-align:left; padding:13px 0 0; font-size:11px; font-weight:700; cursor:pointer; }
      .schedule-public-button span { float:right; font-size:16px; line-height:10px; }
      .schedule-public-button:hover { color:var(--teal-deep); }
      .school-links { display:grid; gap:7px; margin-top:15px; }
       .school-links a, .school-resource-links a { display:inline-flex; align-items:center; gap:7px; color:var(--teal); font-size:11px; font-weight:700; text-decoration:none; }
       .school-links a:hover, .school-resource-links a:hover { color:var(--teal-deep); text-decoration:underline; }
       .school-link-icon { display:inline-grid; place-items:center; flex:0 0 19px; width:19px; height:19px; }
       .school-link-icon svg { display:block; width:19px; height:19px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
       .school-resource-links { margin:-3px 0 14px; }
       .school-social-link { display:inline-flex; align-items:center; gap:6px; margin-top:9px; color:#9ac3ba; font-size:10px; font-weight:700; text-decoration:none; }
      .school-social-link:hover { color:#fff; text-decoration:underline; }
      @media (min-width:801px) { .school-links { display:flex; flex-wrap:wrap; gap:14px; margin-top:12px; } .school-links a { font-size:clamp(13px,1.25vw,17px); } }
      .login-privacy { color:#9baaa5; line-height:1.45; font-size:9px; margin-top:22px; }
    .login-footer { display:flex; justify-content:space-between; gap:16px; color:#91a09a; font-size:9px; padding:18px 4px 0; }
    .approval-card { width:min(100%,620px); }
    .approval-card h2 { margin-bottom:8px; }
    .approval-intro { color:var(--muted); font-size:11px; line-height:1.45; margin-bottom:17px; }
    .request-row { border:1px solid var(--line); border-radius:11px; padding:13px; display:grid; grid-template-columns:1fr 155px auto; gap:9px; align-items:center; }
    .request-email strong, .request-email span { display:block; }
    .request-email strong { font-size:11px; }
    .request-email span { color:var(--muted); font-size:9px; margin-top:4px; }
    .request-row select { border:1px solid var(--line); border-radius:8px; padding:9px 8px; color:var(--ink); background:#fbfcfb; font-size:10px; }
     .approve-button { border:0; border-radius:8px; background:var(--teal); color:#fff; padding:10px 12px; font-size:10px; font-weight:700; }
     .approve-button:hover { background:var(--teal-deep); }
     .role-management-list { display:grid; gap:8px; margin-top:14px; }
     .role-management-row { display:grid; grid-template-columns:minmax(0,1fr) 190px 145px; gap:10px; align-items:center; padding:12px; border:1px solid var(--line); border-radius:11px; background:#fbfdfb; }
     .role-management-account strong, .role-management-account span { display:block; }
     .role-management-account strong { color:var(--ink); font-size:11px; }
     .role-management-account span { margin-top:4px; color:var(--muted); font-size:9px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
     .role-management-row select { width:100%; border:1px solid var(--line); border-radius:8px; padding:9px 8px; color:var(--ink); background:#fff; font-size:10px; }
     .role-management-row select:disabled { opacity:.65; cursor:not-allowed; }
     .role-management-status { min-height:14px; color:var(--muted); font-size:9px; }
     .role-management-status.is-success { color:#16826f; }
     .role-management-status.is-error { color:#b65e4b; }
     .approval-foot { border-top:1px solid var(--line); color:var(--muted); font-size:9px; padding-top:14px; margin-top:17px; line-height:1.5; }
      @media (max-width:800px) { .login-layout { grid-template-columns:1fr; } .login-message { padding:35px 28px; min-height:340px; } .login-form { padding:32px 28px 36px; } .login-footer { flex-direction:column; } .request-row { grid-template-columns:1fr; } .role-management-row { grid-template-columns:1fr; gap:8px; } }
     .login-screen { position:relative; overflow:hidden; isolation:isolate; background:radial-gradient(circle at 12% 15%,rgba(31,185,163,.24),transparent 27%),radial-gradient(circle at 88% 82%,rgba(37,100,198,.2),transparent 30%),linear-gradient(135deg,#e8f6f0,#f8faf7 52%,#e8eefb); }
     .login-screen:before, .login-screen:after { content:''; position:absolute; border-radius:50%; pointer-events:none; z-index:-1; }
     .login-screen:before { width:430px; height:430px; left:-190px; top:-170px; border:1px solid rgba(22,86,167,.13); box-shadow:0 0 0 28px rgba(22,86,167,.04),0 0 0 58px rgba(22,86,167,.025); animation:orbit 18s linear infinite; }
     .login-screen:after { width:300px; height:300px; right:-120px; bottom:-130px; background:radial-gradient(circle,rgba(230,154,53,.2),transparent 64%); animation:breathe 5s ease-in-out infinite; }
     .login-card { animation:cardReveal .7s cubic-bezier(.2,.8,.2,1) both; }
     .login-layout { min-height:480px; box-shadow:0 22px 55px rgba(6,39,89,.18); }
      .login-message { background:radial-gradient(circle at 88% 8%,rgba(51,180,160,.24),transparent 24%),linear-gradient(118deg,#071b43 0%,#10295f 52%,#0c597e 100%); }
      .login-message:before { content:''; position:absolute; width:150px; height:150px; right:26px; top:18px; border:1px solid rgba(255,255,255,.3); border-radius:23px; background:url('bfr-conecta-cover.jpg') center/cover; opacity:.3; mix-blend-mode:screen; transform:rotate(5deg); box-shadow:0 18px 40px rgba(0,0,0,.2); animation:coverFloat 6s ease-in-out infinite; }
     .login-message:after { z-index:0; animation:orbit 16s linear infinite; }
     .login-message > * { position:relative; z-index:1; }
     .login-form { position:relative; overflow:hidden; }
     .login-form:before { content:''; position:absolute; width:180px; height:180px; right:-70px; top:-80px; border-radius:50%; background:rgba(220,239,233,.6); filter:blur(2px); }
     .login-form > * { position:relative; z-index:1; }
     .login-brand, .login-form, .login-message, .panel, .metric-card, .teacher-metric, .side-highlight { transition:transform .28s ease,box-shadow .28s ease,border-color .28s ease; }
     .panel:hover, .metric-card:hover, .teacher-metric:hover, .side-highlight:hover { transform:translateY(-4px); box-shadow:0 18px 38px rgba(29,60,51,.12); border-color:#c9ddd5; }
     .project-tab { transition:color .2s ease,transform .2s ease,border-color .2s ease; }
     .project-tab:hover { color:var(--teal); transform:translateY(-2px); }
     .primary-button, .google-button, .logout-top-button, .logout-button { transition:transform .2s ease,box-shadow .2s ease,background .2s ease,border-color .2s ease; }
     .primary-button:hover, .google-button:hover { transform:translateY(-2px); box-shadow:0 12px 24px rgba(22,86,167,.16); }
     #appShell.ready .content > * { animation:contentRise .55s cubic-bezier(.2,.8,.2,1) both; }
     #appShell.ready .content > *:nth-child(2) { animation-delay:.06s; }
     #appShell.ready .content > *:nth-child(3) { animation-delay:.12s; }
     #appShell.ready .content > *:nth-child(4) { animation-delay:.18s; }
     @keyframes cardReveal { from { opacity:0; transform:translateY(18px) scale(.985); } to { opacity:1; transform:translateY(0) scale(1); } }
     @keyframes contentRise { from { opacity:0; transform:translateY(13px); } to { opacity:1; transform:translateY(0); } }
     @keyframes coverFloat { 0%,100% { transform:rotate(5deg) translateY(0); } 50% { transform:rotate(2deg) translateY(-9px); } }
     @keyframes breathe { 0%,100% { transform:scale(.92); opacity:.7; } 50% { transform:scale(1.08); opacity:1; } }
     @keyframes orbit { to { transform:rotate(360deg); } }
      @media (max-width:800px) { .login-message:before { width:108px; height:108px; right:18px; top:18px; border-radius:18px; opacity:.28; } .login-message h1 { max-width:calc(100% - 18px); padding-right:72px; } }
      @media (max-width:430px) { .login-message:before { width:86px; height:86px; right:14px; top:14px; } .login-message h1 { padding-right:54px; } }
      @media (prefers-reduced-motion:reduce) { *, *:before, *:after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; } }
    .modal { position: fixed; inset: 0; background: rgba(15,42,37,.48); z-index: 5; display: grid; place-items: center; padding: 20px; }
    .modal-card { width: min(420px,100%); background: #fff; border-radius: 17px; padding: 26px; position: relative; box-shadow: 0 25px 70px rgba(0,0,0,.2); }
    .modal-card h2 { font: 600 24px 'Playfair Display',serif; margin: 7px 0 20px; }
    .modal-close { position: absolute; right: 17px; top: 13px; border: 0; background: transparent; color: var(--muted); font-size: 24px; }
    .modal-items { display: grid; gap: 0; }
    .modal-items div { border-top: 1px solid var(--line); padding: 13px 0; }
    .modal-items b, .modal-items span { display: block; }
    .modal-items b { font-size: 11px; color: var(--teal); }
    .modal-items span { font-size: 12px; margin-top: 4px; color: var(--muted); }
    .modal-card label { display:block; color:var(--muted); font-size:10px; margin-top:12px; }
     .modal-card input, .modal-card select, .modal-card textarea { display:block; width:100%; border:1px solid var(--line); background:#fbfcfb; border-radius:8px; padding:10px; margin-top:5px; color:var(--ink); font-size:12px; }
     .modal-card textarea { min-height:90px; resize:vertical; }
     .modal-card input[type=file] { padding:8px; font-size:10px; }
     .public-schedule-card { width:min(1120px,96vw); max-height:92vh; overflow:auto; padding:18px; }
     .public-schedule-card .schedule-panel { margin:0; box-shadow:none; border:0; }
     .schedule-fallback { padding:22px; color:var(--muted); text-align:center; font-size:11px; }
     .schedule-fallback a { display:inline-block; margin-top:8px; color:var(--teal); font-weight:700; }
    .report-average { text-align:right; }
    .report-average strong { display:block; color:var(--teal); font:700 24px 'Playfair Display',serif; }
    .report-average span { color:var(--muted); font-size:9px; }
    .report-table { border-top:1px solid var(--line); }
    .report-row { display:grid; grid-template-columns:minmax(125px,1.4fr) repeat(5, .6fr); align-items:center; gap:8px; padding:10px 5px; border-bottom:1px solid #edf1ef; font-size:11px; }
    .report-row:last-child { border-bottom:0; }
    .report-row span { color:var(--muted); }
    .report-row strong { color:var(--teal); font-weight:700; }
    .report-header { color:#91a09b; font:9px 'DM Mono',monospace; text-transform:uppercase; padding-top:9px; }
    .occurrence-status { color:#b65e4b; background:#fff0eb; font:10px 'DM Mono',monospace; text-transform:uppercase; border-radius:20px; padding:5px 8px; }
    .occurrence-body, .occurrence-detail { display:flex; gap:11px; background:#fff6f2; border-radius:11px; padding:13px; }
    .occurrence-symbol { width:25px; height:25px; display:grid; place-items:center; border-radius:8px; flex-shrink:0; background:#f5c6b8; color:#a24f3d; font-weight:700; }
    .occurrence-body strong, .occurrence-detail strong { font-size:11px; }
    .occurrence-body p { margin-top:3px; color:#b8644f; font:9px 'DM Mono',monospace; }
    .occurrence-body span, .occurrence-detail p { display:block; color:#896c65; font-size:10px; line-height:1.45; margin-top:8px; }
    .online-dot { color:#16826f; font:10px 'DM Mono',monospace; }
    .gate-person { display:flex; gap:9px; align-items:center; padding-bottom:13px; border-bottom:1px solid #edf1ef; }
    .gate-person strong { display:block; font-size:11px; }
    .gate-person p { color:var(--muted); font-size:10px; margin-top:3px; }
    .boarding-status { display:flex; gap:9px; align-items:flex-start; margin:14px 0; }
    .status-light { width:8px; height:8px; border-radius:50%; background:#56b78f; box-shadow:0 0 0 4px #e1f3e9; margin:4px 2px 0 4px; }
    .boarding-status strong { display:block; font-size:11px; }
    .boarding-status p { color:var(--muted); font-size:10px; line-height:1.4; margin-top:3px; }
    .gate-input { display:flex; gap:6px; }
    .gate-input input { min-width:0; flex:1; border:1px solid var(--line); border-radius:8px; padding:9px 10px; font-size:10px; color:var(--ink); background:#fbfcfb; }
    .gate-input button { border:0; border-radius:8px; color:#fff; background:var(--teal); font-size:10px; padding:0 12px; }
     .gate-input button:hover { background:var(--teal-deep); }
      .gate-sent { color:#16826f; background:#eaf6ef; border-radius:8px; padding:9px; font-size:10px; margin-top:8px; }
      .monitor-welcome { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:28px; gap:20px; }
      .monitor-welcome h1 { max-width:620px; }
      .monitor-welcome p { color:var(--muted); font-size:12px; line-height:1.5; margin-top:9px; max-width:620px; }
      .monitor-layout { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(270px,.85fr); gap:18px; align-items:start; }
      .monitor-form { display:grid; gap:11px; }
      .monitor-form label { display:grid; gap:5px; color:var(--muted); font-size:10px; }
      .monitor-form input, .monitor-form select, .monitor-form textarea { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); padding:10px; font-size:11px; }
      .monitor-form textarea { min-height:105px; resize:vertical; }
      .monitor-form input[readonly] { background:#f0f7f2; color:#56766b; font-weight:700; }
      .monitor-selected { display:grid; grid-template-columns:1fr 150px; gap:8px; padding:11px; border-radius:10px; background:#f7faf8; border:1px solid var(--line); }
      .monitor-selected span { display:block; color:var(--muted); font:9px 'DM Mono',monospace; text-transform:uppercase; }
      .monitor-selected strong { display:block; margin-top:4px; font-size:11px; }
      .monitor-guardian { border:1px solid #dcebe1; border-radius:9px; background:#f0f7f2; padding:10px; }
      .monitor-guardian span { display:block; color:var(--muted); font:9px 'DM Mono',monospace; text-transform:uppercase; }
      .monitor-guardian a { display:inline-block; color:#16826f; font-size:11px; font-weight:700; margin-top:4px; text-decoration:none; }
      .monitor-guardian a:hover { text-decoration:underline; }
      .monitor-help { background:var(--teal-deep); color:#fff; border-radius:15px; padding:22px; }
      .monitor-help .eyebrow { color:#8fc9ba; }
      .monitor-help h2 { font:600 22px 'Playfair Display',serif; line-height:1.15; margin:8px 0 15px; }
      .monitor-help p, .monitor-help li { color:#c0ded6; font-size:11px; line-height:1.5; }
      .monitor-help ol { padding-left:18px; margin:15px 0 0; display:grid; gap:8px; }
      .monitor-history { margin-top:18px; }
      .monitor-history h3 { font:600 16px 'Playfair Display',serif; margin-bottom:9px; }
      .monitor-history-item { padding:11px 0; border-top:1px solid #edf1ef; }
      .monitor-history-item strong { display:block; font-size:11px; }
      .monitor-history-item span { display:block; color:var(--muted); font-size:10px; line-height:1.4; margin-top:3px; }
      .route-notification-panel { border-color:#f1d8ad; background:#fffaf0; }
      .route-notification { border-top:1px solid #f2e4cc; padding:11px 0; }
      .route-notification:first-child { border-top:0; padding-top:0; }
      .route-notification strong { display:block; font-size:11px; }
      .route-notification span { display:block; color:#896f4f; font-size:10px; line-height:1.45; margin-top:4px; }
      .teacher-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
      .secondary-action { background:var(--teal) !important; }
      .school-activities-panel { margin-top:18px; }
      .school-activities-list { display:grid; gap:9px; }
      .school-activity { border:1px solid var(--line); border-radius:10px; padding:12px; background:#fbfdfb; }
      .school-activity-top { display:flex; justify-content:space-between; gap:10px; align-items:start; }
      .school-activity strong { font-size:12px; }
      .school-activity small { color:var(--teal); font:9px 'DM Mono',monospace; text-transform:uppercase; }
      .school-activity p { color:var(--muted); font-size:10px; line-height:1.45; margin-top:6px; white-space:pre-line; }
      .school-activity a { display:inline-block; color:var(--teal); font-size:10px; font-weight:700; margin-top:8px; text-decoration:none; }
      .school-activity a:hover { text-decoration:underline; }
      .games-panel { margin-top:18px; }
      .game-subjects { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
      .game-subject { border:1px solid var(--line); border-radius:10px; background:#fbfdfb; color:var(--ink); padding:11px 8px; text-align:left; font-size:10px; transition:.2s; }
      .game-subject:hover, .game-subject.active { color:var(--teal); border-color:#8ac5b4; background:#f1faf6; transform:translateY(-2px); }
      .game-subject b { display:block; font:600 13px 'Playfair Display',serif; margin-bottom:4px; }
      .game-subject span { color:var(--muted); font-size:9px; }
      .game-play { margin-top:14px; padding:15px; border-radius:11px; background:#f0f7f2; border:1px solid #dcebe1; }
      .game-play h3 { font:600 20px 'Playfair Display',serif; }
      .game-score { color:var(--teal); font:10px 'DM Mono',monospace; margin-top:4px; }
      .game-question { font:600 14px 'Playfair Display',serif; line-height:1.35; margin-top:13px; }
      .game-options { display:grid; gap:7px; margin-top:11px; }
      .game-option { border:1px solid var(--line); border-radius:8px; padding:10px; background:#fff; color:var(--ink); text-align:left; font-size:10px; }
      .game-option:hover { border-color:var(--teal); }
      .game-option.correct { border-color:#6eb997; background:#eaf6ef; color:#16826f; }
      .game-option.wrong { border-color:#e6a18f; background:#fff0eb; color:#b65e4b; }
       .game-feedback { min-height:17px; color:var(--muted); font-size:10px; margin-top:9px; }
       .game-next { display:none; margin-top:7px; }
       .badge-controls { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
       .badge-controls select { min-width:220px; flex:1; border:1px solid var(--line); border-radius:8px; background:#fbfcfb; color:var(--ink); padding:10px; font-size:10px; }
       .student-badge { display:grid; grid-template-columns:1fr 150px; gap:14px; align-items:center; margin-top:15px; padding:15px; border:1px solid #cfe3d9; border-radius:13px; background:linear-gradient(135deg,#f0f8f3,#fff); }
       .student-badge-copy { display:grid; gap:5px; }
       .student-badge-copy strong { font:600 21px 'Playfair Display',serif; line-height:1.05; }
       .student-badge-copy > span:not(.eyebrow) { color:var(--teal); font-size:11px; font-weight:700; }
        .student-badge-copy small { color:var(--muted); font-size:9px; margin-top:8px; }
        .badge-qr { min-height:132px; display:grid; place-items:center; padding:5px; background:#fff; border-radius:9px; }
        .badge-qr canvas { display:block; max-width:100%; height:auto; }
        .student-badge > .primary-button { grid-column:1 / -1; justify-self:start; }
        .badge-share { grid-column:1 / -1; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:end; padding-top:11px; border-top:1px solid #dcebe1; }
        .badge-share label { display:grid; gap:5px; color:var(--muted); font-size:10px; }
        .badge-share input { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); padding:9px 10px; font-size:10px; }
        .badge-share button { border:1px solid #b9d8ca; border-radius:8px; padding:9px 11px; color:#16826f; background:#eaf6ef; font-size:10px; font-weight:700; white-space:nowrap; }
        .badge-share button:hover { background:#dcefe5; }
        .badge-share small { grid-column:1 / -1; color:var(--muted); font-size:9px; }
       .gate-welcome { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:28px; gap:20px; }
       .gate-welcome h1 { max-width:620px; }
       .gate-welcome p { color:var(--muted); font-size:12px; line-height:1.5; margin-top:9px; max-width:620px; }
       .gate-layout { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr); gap:18px; align-items:start; }
       .gate-direction { display:flex; gap:9px; align-items:end; margin-bottom:12px; }
       .gate-direction label { color:var(--muted); font-size:10px; flex:1; }
       .gate-direction select { display:block; width:100%; border:1px solid var(--line); border-radius:8px; background:#fbfcfb; color:var(--ink); padding:10px; margin-top:5px; font-size:11px; }
       .qr-reader { width:100%; min-height:230px; display:grid; place-items:center; border:1px dashed #b9d7c9; border-radius:12px; background:#f4faf6; overflow:hidden; }
       .qr-reader:empty:before { content:'A câmera ficará aqui'; color:#86a095; font:10px 'DM Mono',monospace; text-transform:uppercase; }
       .qr-reader video { width:100% !important; border-radius:10px; }
       .gate-manual-form { display:grid; gap:5px; margin-top:12px; }
       .gate-manual-form label { color:var(--muted); font-size:10px; }
       .gate-manual-form input { display:block; width:100%; border:1px solid var(--line); border-radius:8px; background:#fbfcfb; color:var(--ink); padding:10px; margin-top:5px; font-size:10px; }
       .gate-last-checkin { margin-top:12px; border-radius:10px; padding:12px; background:#eaf6ef; color:#35755e; font-size:11px; line-height:1.45; }
       .gate-history-list { display:grid; gap:0; }
       .gate-history-item { display:grid; grid-template-columns:38px 1fr auto; gap:9px; align-items:center; border-top:1px solid #edf1ef; padding:10px 0; }
       .gate-history-item:first-child { border-top:0; padding-top:0; }
       .gate-history-time { color:var(--teal); font:10px 'DM Mono',monospace; }
       .gate-history-item strong { display:block; font-size:11px; }
       .gate-history-item span { display:block; color:var(--muted); font-size:9px; margin-top:3px; }
         .gate-direction-pill { color:#35755e; background:#eaf6ef; border-radius:20px; padding:4px 7px; font:9px 'DM Mono',monospace; text-transform:uppercase; }
         .gate-direction-pill.is-blocked { color:#a24f3d; background:#fff0eb; }
         .coordinator-welcome { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:28px; gap:20px; }
         .coordinator-welcome h1 { max-width:680px; }
         .coordinator-welcome p { color:var(--muted); font-size:12px; line-height:1.5; margin-top:9px; max-width:680px; }
         .coordinator-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
         .coordinator-layout { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr); gap:18px; align-items:start; }
         .coordinator-filters { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(150px,.8fr); gap:8px; margin-bottom:14px; }
         .coordinator-filters input, .coordinator-filters select { width:100%; border:1px solid var(--line); border-radius:8px; background:#fbfcfb; color:var(--ink); padding:10px; font-size:10px; }
         .coordinator-list { display:grid; gap:0; }
         .coordinator-row { display:grid; grid-template-columns:42px minmax(0,1fr) 118px 92px; gap:9px; align-items:center; border-top:1px solid #edf1ef; padding:11px 0; }
         .coordinator-row:first-child { border-top:0; padding-top:0; }
         .coordinator-time { color:var(--teal); font:10px 'DM Mono',monospace; }
         .coordinator-student strong { display:block; font-size:11px; }
         .coordinator-student span { display:block; color:var(--muted); font-size:9px; margin-top:3px; }
         .coordinator-status { justify-self:start; border-radius:20px; padding:4px 7px; color:#35755e; background:#eaf6ef; font:9px 'DM Mono',monospace; text-transform:uppercase; }
         .coordinator-status.is-pending { color:#897047; background:#fff5df; }
         .coordinator-status.is-blocked { color:#a24f3d; background:#fff0eb; }
         .coordinator-summary { display:grid; gap:10px; }
         .coordinator-summary-card { border:1px solid var(--line); border-radius:11px; padding:13px; background:#fbfcff; }
         .coordinator-summary-card strong { display:block; color:var(--teal-deep); font:700 26px 'Playfair Display',serif; margin-top:5px; }
         .coordinator-summary-card span { color:var(--muted); font-size:10px; }
         .coordinator-alert-list { display:grid; gap:8px; }
         .coordinator-alert { border:1px solid #f0ddd6; border-radius:9px; padding:10px; background:#fffaf8; }
         .coordinator-alert strong { display:block; font-size:11px; }
         .coordinator-alert p { color:#765b55; font-size:10px; line-height:1.4; margin-top:4px; }
         .coordinator-alert small { display:block; color:var(--muted); font-size:9px; margin-top:5px; }
         .coordinator-empty { color:var(--muted); font-size:10px; padding:10px 0; }
         .gate-alert-panel { border-color:#efc8bc; background:#fffaf8; }
        .gate-alert-item { border-top:1px solid #f2ddd6; padding:12px 0; display:grid; gap:7px; }
        .gate-alert-item:first-child { border-top:0; padding-top:0; }
        .gate-alert-item strong { color:#a24f3d; font-size:11px; }
        .gate-alert-item p { color:#765b55; font-size:10px; line-height:1.45; }
        .gate-alert-item small { color:var(--muted); font-size:9px; }
        .gate-alert-item.is-resolved { opacity:.65; }
        .gate-alert-actions { display:flex; gap:8px; flex-wrap:wrap; }
        .restriction-list { display:grid; gap:8px; margin-top:14px; }
        .restriction-item { border:1px solid #f0ddd6; border-radius:9px; padding:10px; background:#fffaf8; }
        .restriction-item strong { display:block; font-size:11px; }
        .restriction-item p { color:#765b55; font-size:10px; line-height:1.4; margin-top:4px; }
        .restriction-item small { display:block; color:var(--muted); font-size:9px; margin-top:5px; }
        .restriction-item button { margin-top:8px; }
        .search-control { display:flex; align-items:center; gap:7px; border:1px solid var(--line); border-radius:8px; background:#fff; padding:0 9px; }
        .search-control span { color:var(--teal); font-size:17px; line-height:1; }
        .search-control input { min-width:0; flex:1; width:100%; border:0 !important; padding:9px 0 !important; outline:0; }
        .account-tool-card { width:min(100%,560px); }
        .account-tool-card h2 { margin-bottom:8px; }
        .account-tool-card p { color:var(--muted); font-size:11px; line-height:1.5; }
         .account-tool-card form { display:grid; gap:10px; margin-top:16px; }
         .preference-section { display:grid; gap:8px; margin-top:16px; }
         .preference-section > .field-hint { margin:0; }
         .preference-row { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:12px; border:1px solid var(--line); border-radius:9px; color:var(--ink); font-size:11px; }
         .preference-row span { display:grid; gap:3px; color:var(--ink); }
          .preference-row small { color:var(--muted); font-size:9px; }
          .preference-row input { width:18px; height:18px; accent-color:var(--teal); }
          .preferred-name-card .field-hint { display:block; margin-top:5px; color:var(--muted); font-size:9px; line-height:1.4; }
          .preferred-name-actions { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:16px; }
          .preferred-name-actions .text-button { padding-left:0; }
        .help-list { display:grid; gap:9px; margin-top:16px; }
        .help-item { padding:11px 12px; border:1px solid var(--line); border-radius:9px; background:#fbfdfb; }
        .help-item strong { display:block; font-size:11px; }
        .help-item p { margin-top:4px; font-size:10px; }
        .login-role-choice { width:min(100%,520px); }
        .login-role-choice h2 { margin-bottom:8px; }
        .login-role-choice-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:18px; }
        .login-role-choice button { border:1px solid var(--line); border-radius:11px; padding:15px; background:#fbfdfb; color:var(--ink); text-align:left; }
        .login-role-choice button:hover { border-color:var(--teal); background:#f1faf6; transform:translateY(-1px); }
        .login-role-choice button strong, .login-role-choice button span { display:block; }
        .login-role-choice button strong { font-size:13px; }
        .login-role-choice button span { color:var(--muted); font-size:10px; line-height:1.4; margin-top:5px; }
        .responsible-registration-card { width:min(100%,560px); }
        .responsible-registration-card h2 { margin-bottom:8px; }
        .responsible-registration-card > p { color:var(--muted); font-size:11px; line-height:1.5; }
         .responsible-registration-card form { display:grid; gap:10px; margin-top:16px; }
         .responsible-registration-card label { display:grid; gap:5px; color:var(--muted); font-size:10px; }
         .responsible-registration-card input, .responsible-registration-card select { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); padding:9px 10px; font-size:10px; }
         .responsible-registration-filters { display:grid; grid-template-columns:1.25fr .9fr; gap:8px; }
        .registration-results { display:grid; gap:5px; max-height:170px; overflow:auto; }
        .registration-result { display:block; width:100%; padding:9px 10px; border:1px solid var(--line); border-radius:8px; background:#fbfdfb; color:var(--ink); text-align:left; }
        .registration-result:hover, .registration-result.selected { border-color:var(--teal); background:#f1faf6; }
        .registration-result strong, .registration-result span { display:block; }
        .registration-result strong { font-size:10px; }
        .registration-result span { color:var(--muted); font-size:9px; margin-top:3px; }
        .reduced-motion *, .reduced-motion *::before, .reduced-motion *::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; }
       @media (max-width:430px) { .game-subjects { grid-template-columns:repeat(2,1fr); } .teacher-actions { justify-content:flex-start; } }
        @media (max-width:800px) { .monitor-layout, .gate-layout, .coordinator-layout { grid-template-columns:1fr; } .monitor-selected { grid-template-columns:1fr; } .gate-welcome, .coordinator-welcome { align-items:flex-start; flex-direction:column; } .coordinator-actions { justify-content:flex-start; } .coordinator-row { grid-template-columns:38px minmax(0,1fr) 92px; } .coordinator-row > :last-child { grid-column:2 / -1; } .student-badge { grid-template-columns:1fr; } .badge-qr { justify-self:start; } .badge-share { grid-template-columns:1fr; } .badge-share button { width:100%; } .login-role-choice-grid { grid-template-columns:1fr; } }
      .communication-grid { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(280px,.85fr); gap:18px; margin-top:18px; }
     .paperless-tag, .poll-tag, .agenda-count { border-radius:20px; padding:5px 8px; font:9px 'DM Mono',monospace; text-transform:uppercase; white-space:nowrap; }
     .paperless-tag { color:#16826f; background:#eaf6ef; }
     .poll-tag { color:#806aa8; background:#f0ebfb; }
     .agenda-count { color:#9b6d13; background:#fff4d5; }
     .digital-note { border:1px solid #d8e9e1; background:#f3faf5; border-radius:12px; padding:14px; }
     .digital-note-top, .digital-note-foot, .news-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; }
     .digital-note-top { color:#9aaba4; font:9px 'DM Mono',monospace; text-transform:uppercase; }
     .note-type { color:#16826f; }
     .digital-note h3 { font:600 16px 'Playfair Display',serif; margin-top:9px; }
     .digital-note > p { color:var(--muted); font-size:11px; line-height:1.45; margin-top:5px; }
     .digital-note-foot { border-top:1px solid #deece4; margin-top:13px; padding-top:11px; color:#6d8d7c; font-size:10px; }
     .digital-note-foot .text-button { font-size:10px; }
     .news-block { margin-top:21px; }
     .news-heading { margin-bottom:10px; }
     .news-heading h3 { font:600 15px 'Playfair Display',serif; }
     .news-item { display:grid; grid-template-columns:26px 1fr auto; gap:9px; align-items:start; border-top:1px solid #edf1ef; padding:11px 0; }
     .news-item:last-child { padding-bottom:0; }
     .news-bullet { width:25px; height:25px; border-radius:8px; display:grid; place-items:center; font-size:11px; }
     .blue-bullet { color:#527ca2; background:#eaf1f7; }
     .green-bullet { color:#4e8667; background:#e5f1e8; }
     .news-item strong { font-size:11px; }
     .news-item p { color:var(--muted); font-size:10px; line-height:1.35; margin-top:3px; }
     .news-item time { color:#a2afac; font:9px 'DM Mono',monospace; }
     .poll-question { font:600 13px 'Playfair Display',serif; line-height:1.35; margin:5px 0 12px; }
     .poll-option { display:flex; align-items:center; gap:8px; border:1px solid var(--line); border-radius:8px; padding:9px 10px; margin-top:7px; font-size:10px; color:#60736d; cursor:pointer; transition:.2s; }
     .poll-option:has(input:checked) { border-color:#8ac5b4; color:var(--teal); background:#f1faf6; }
     .poll-option input { accent-color:var(--teal); }
     .poll-result { color:#16826f; background:#eaf6ef; border-radius:8px; padding:10px; font-size:10px; margin-top:12px; }
     .agenda-intro { color:var(--muted); font-size:10px; line-height:1.45; margin:5px 0 12px; }
      .agenda-student select, .agenda-student textarea { width:100%; border:1px solid var(--line); border-radius:8px; background:#fbfcfb; color:var(--ink); padding:9px 10px; font-size:10px; margin-bottom:7px; }
      .agenda-student textarea { min-height:54px; resize:vertical; }
      .publish-form { display:grid; gap:8px; align-content:start; padding:15px; border:1px solid var(--line); border-radius:12px; background:#fbfdfb; }
      .publish-form h3 { font:600 16px 'Playfair Display',serif; margin-bottom:3px; }
      .publish-form label { display:grid; gap:5px; color:var(--muted); font-size:10px; }
      .publish-form input, .publish-form textarea { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); padding:9px 10px; font-size:10px; }
      .publish-form textarea { min-height:68px; resize:vertical; }
      .publish-check { display:flex !important; align-items:center; gap:7px; }
      .publish-check input { width:auto; accent-color:var(--teal); }
      .publish-status { min-height:14px; color:#16826f; font-size:10px; }
      .project-tabs { display:flex; gap:6px; overflow-x:auto; border-bottom:1px solid var(--line); margin:14px 0 18px; }
      .project-tab { border:0; background:transparent; color:var(--muted); padding:8px 10px 11px; white-space:nowrap; font-size:10px; border-bottom:2px solid transparent; }
       .project-tab.active { color:var(--teal); border-bottom-color:var(--teal); font-weight:700; }
       .schedule-switch { display:flex; gap:7px; margin:14px 0 16px; }
       .schedule-shift { border:1px solid var(--line); border-radius:10px; padding:9px 14px; background:#f8fbfa; color:var(--muted); font-size:11px; cursor:pointer; }
       .schedule-shift.active { background:var(--teal); border-color:var(--teal); color:#fff; font-weight:700; }
       .schedule-view { display:none; }
       .schedule-view.active { display:block; }
       .schedule-frame { overflow:auto; border:1px solid var(--line); border-radius:12px; background:#fff; }
       .schedule-image { display:block; width:100%; min-width:900px; height:auto; cursor:zoom-in; }
       .schedule-caption { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:10px; color:var(--muted); font-size:10px; line-height:1.45; }
       .schedule-caption a { color:var(--teal); font-weight:700; white-space:nowrap; }
       .schedule-clock-card { margin-top:14px; padding:14px; border:1px solid #dcebe1; border-radius:12px; background:#f6fbf8; }
       .schedule-clock-card h3 { color:var(--teal-deep); font-size:13px; }
       .schedule-clock-card > p { color:var(--muted); font-size:10px; line-height:1.45; margin-top:5px; }
       .schedule-clock-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px; }
       .schedule-clock-day { padding:10px; border-radius:9px; background:#fff; border:1px solid #e1eee6; }
       .schedule-clock-day strong { display:block; color:var(--teal); font-size:10px; }
       .schedule-clock-day table { width:100%; margin-top:6px; border-collapse:collapse; font-size:10px; }
       .schedule-clock-day td { padding:4px 0; border-top:1px solid #edf3ef; }
       .schedule-clock-day td:last-child { text-align:right; font-weight:700; color:var(--ink); }
       .schedule-clock-note { color:var(--muted); font-size:9px; margin-top:10px; }
       @media (max-width:600px) { .schedule-clock-grid { grid-template-columns:1fr; } }
      .project-summary { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(230px,.9fr); gap:18px; align-items:start; }
      .project-summary h3 { font:600 25px 'Playfair Display',serif; line-height:1.1; }
      .project-summary p { color:var(--muted); font-size:11px; line-height:1.5; margin-top:8px; }
       .project-info { padding:14px; border-radius:11px; background:#f0f7f2; color:#56766b; font-size:11px; line-height:1.55; white-space:pre-line; }
       .project-sources { margin-top:14px; color:var(--muted); font-size:10px; line-height:1.5; }
       .project-sources strong { display:block; color:var(--ink); font-size:11px; margin-bottom:5px; }
       .project-sources a { color:var(--teal); text-decoration:none; }
       .project-sources a:hover { text-decoration:underline; }
      .project-photos { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:18px; }
      .project-photo { min-height:82px; overflow:hidden; border-radius:9px; background:#e5f0eb; }
      .project-photo img { display:block; width:100%; height:100%; min-height:82px; object-fit:cover; }
      .project-empty { color:var(--muted); font-size:10px; padding:12px; border:1px dashed var(--line); border-radius:9px; }
       .project-podium, .project-ranking { margin-top:18px; }
       .project-podium h4, .project-ranking h4 { font:600 16px 'Playfair Display',serif; margin-bottom:10px; }
      .podium-list { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
      .podium-place { padding:12px 10px; border:1px solid var(--line); border-radius:10px; background:#fbfdfb; text-align:center; }
       .podium-place b { display:block; font:700 22px 'Playfair Display',serif; color:var(--teal); }
       .podium-place strong { display:block; font-size:10px; margin-top:5px; }
       .podium-place span { display:block; color:var(--muted); font-size:9px; margin-top:3px; }
       .podium-place img { display:block; width:100%; height:88px; object-fit:cover; border-radius:7px; margin-top:9px; }
       .ranking-level { margin-top:14px; }
       .ranking-level-title { color:var(--teal); font:600 15px 'Playfair Display',serif; margin-bottom:8px; }
      .project-admin-form { display:grid; gap:9px; }
      .project-admin-form label { display:grid; gap:5px; color:var(--muted); font-size:10px; }
      .project-admin-form input, .project-admin-form textarea, .project-admin-form select { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); padding:9px 10px; font-size:10px; }
       .project-admin-form textarea { min-height:72px; resize:vertical; }
        .field-hint { color:var(--muted); font-size:9px; }
        .import-warning { color:#986b13; display:block; margin-top:10px; }
       .project-photo-list { display:flex; gap:7px; flex-wrap:wrap; margin-top:5px; }
       .project-photo-list img { width:54px; height:42px; object-fit:cover; border-radius:6px; }
       .photo-order-hint { color:var(--muted); font-size:10px; margin-top:14px; }
       .project-photo-list.orderable { display:grid; grid-template-columns:repeat(3,1fr); gap:9px; }
       .admin-project-photo { position:relative; min-width:0; border:1px solid var(--line); border-radius:10px; padding:6px; background:#fbfdfb; cursor:grab; transition:.2s; }
       .admin-project-photo:active { cursor:grabbing; }
       .admin-project-photo.dragging { opacity:.45; border-color:var(--teal); }
       .admin-project-photo img { display:block; width:100%; height:105px; object-fit:cover; border-radius:7px; }
       .admin-project-photo-foot { display:flex; align-items:center; justify-content:space-between; gap:5px; margin-top:6px; }
       .admin-project-photo-foot span { color:var(--muted); font:9px 'DM Mono',monospace; }
       .photo-move-buttons { display:flex; gap:3px; }
       .photo-move-buttons button { border:1px solid var(--line); border-radius:6px; background:#fff; color:var(--teal); width:25px; height:24px; font-size:12px; line-height:1; }
       .photo-move-buttons button:hover { background:var(--mint); }
      .podium-editor { margin-top:15px; padding-top:14px; border-top:1px solid var(--line); }
       .podium-editor h4 { font:600 16px 'Playfair Display',serif; margin-bottom:9px; }
       .podium-editor-row { display:grid; grid-template-columns:34px 1fr 1fr; gap:7px; align-items:center; margin-top:7px; }
       .podium-editor-row > b { display:grid; place-items:center; width:27px; height:27px; border-radius:8px; background:#f9e6bb; color:#946c25; font:700 13px 'Playfair Display',serif; }
       .carroceata-editor { margin-top:15px; padding-top:14px; border-top:1px solid var(--line); }
       .carroceata-editor h4 { font:600 16px 'Playfair Display',serif; margin-bottom:9px; }
       .carroceata-level-editor { margin-top:13px; padding:11px; border:1px solid var(--line); border-radius:10px; background:#fbfdfb; }
       .carroceata-level-editor h5 { color:var(--teal); font:600 14px 'Playfair Display',serif; }
       .carroceata-editor-head, .carroceata-editor-row { display:grid; grid-template-columns:34px minmax(110px,1fr) minmax(140px,1.2fr) minmax(120px,.8fr) 72px; gap:7px; align-items:center; }
       .carroceata-editor-head { color:#91a09b; text-transform:uppercase; font:9px 'DM Mono',monospace; margin-top:10px; }
       .carroceata-editor-row { margin-top:7px; }
       .carroceata-editor-row > b { display:grid; place-items:center; width:27px; height:27px; border-radius:8px; background:#f9e6bb; color:#946c25; font:700 13px 'Playfair Display',serif; }
       .carroceata-editor-row input { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); padding:9px 8px; font-size:10px; }
       .carroceata-editor-row input[type=file] { padding:7px 5px; font-size:9px; }
       .ranking-photo-note { color:var(--muted); font-size:9px; line-height:1.3; }
       .ranking-photo-note img { display:block; width:54px; height:38px; object-fit:cover; border-radius:6px; margin-bottom:4px; }
       .ranking-remove-photo { display:flex; align-items:center; gap:4px; color:var(--muted); font-size:9px; margin-top:4px; }
       .ranking-remove-photo input { width:auto; accent-color:var(--coral); }
       @media (max-width:800px) { .project-summary { grid-template-columns:1fr; } .project-photos { grid-template-columns:repeat(2,1fr); } .project-photo-list.orderable { grid-template-columns:repeat(2,1fr); } .admin-project-photo img { height:110px; } .podium-list { grid-template-columns:1fr; } .carroceata-editor-head { display:none; } .carroceata-editor-row { grid-template-columns:34px 1fr; } .carroceata-editor-row input, .carroceata-editor-row .ranking-photo-note { grid-column:span 1; } }
     @media (max-width:800px) { .communication-grid { grid-template-columns:1fr; } .digital-note-foot { align-items:flex-start; flex-direction:column; } }
      @media (max-width:800px) { .directory-controls { grid-template-columns:1fr 1fr; } .directory-controls input { grid-column:span 2; } .roster-list { grid-template-columns:1fr; } }
      @media (max-width:430px) { .report-row { grid-template-columns:minmax(110px,1.4fr) repeat(5,.55fr); gap:4px; font-size:10px; } .paperless-tag { font-size:8px; } }
       :root { --paper:#f5f7fb; --line:#e4eaf3; --teal:#2563eb; --teal-deep:#10295f; --mint:#e8f1ff; --lavender:#eee9ff; --coral:#f2994a; --shadow:0 16px 38px rgba(43,67,115,.08); }
      body { background:var(--paper); }
      .sidebar { background:linear-gradient(180deg,#062f70 0%,#05265c 100%); }
      .topbar { background:rgba(255,255,255,.94); box-shadow:0 4px 18px rgba(13,62,126,.05); }
      .panel, .metric-card, .teacher-metric { border-color:var(--line); box-shadow:0 8px 24px rgba(13,62,126,.045); }
      .panel:hover, .metric-card:hover, .teacher-metric:hover, .side-highlight:hover { box-shadow:0 14px 30px rgba(13,62,126,.1); border-color:#bfd4ec; }
      .child-card { background:linear-gradient(135deg,#0b55a6,#083c82); }
      .primary-button { background:var(--teal-deep) !important; box-shadow:0 7px 16px rgba(5,47,111,.2); }
      .primary-button:hover { background:#0b55a6 !important; }
      .login-screen { background:radial-gradient(circle at 10% 10%,rgba(69,157,240,.2),transparent 28%),linear-gradient(135deg,#eaf3ff,#f8fbff 54%,#e8f0fc); }
      .login-card { border-color:rgba(11,85,166,.16); box-shadow:0 25px 80px rgba(5,47,111,.14); }
      .login-message { background:radial-gradient(circle at 88% 8%,rgba(51,180,160,.24),transparent 24%),linear-gradient(118deg,#071b43 0%,#0b3f86 52%,#0b5e91 100%); }
      .date-chip, .agenda-count { background:#e7f0ff; color:var(--teal); }
      .live-clock { margin-left:10px; color:var(--muted); font:10px 'DM Mono',monospace; }
      .live-clock:before { content:'●'; color:#18a77e; margin-right:5px; }
      .class-tab.active, .project-tab.active { color:var(--teal); border-color:var(--teal); }
      .login-benefits span:not(:first-child) { display:none; }
      @media (max-width:800px) {
        .login-screen { min-height:100svh; padding:0; place-items:stretch; }
        .login-card { width:100%; min-height:100svh; padding:0; border:0; border-radius:0; background:transparent; box-shadow:none; }
        .login-brand, .login-footer { display:none; }
        .login-layout { min-height:100svh; border-radius:0; display:flex; flex-direction:column; background:var(--teal-deep); }
        .login-message { flex:1; min-height:0; padding:56px 30px 24px; display:flex; flex-direction:column; }
        .login-message h1 { max-width:270px; padding-right:0; font:700 31px/1.06 'DM Sans',sans-serif; letter-spacing:-.04em; }
        .login-message > p { font-size:12px; max-width:250px; }
        .login-benefits { margin-top:auto; padding-top:32px; }
        .login-form { display:contents; }
        .login-form > .eyebrow, .login-form > h2, .login-form > p, .login-privacy { display:none; }
        .google-button { order:2; width:calc(100% - 60px); margin:0 30px 22px; padding:13px; background:#fff; }
        .auth-status { order:3; margin:0 30px 18px; }
        .app-shell { display:block; padding-bottom:72px; }
        .sidebar { position:fixed; z-index:20; left:0; right:0; bottom:0; min-height:64px; height:64px; padding:0 9px; border-radius:18px 18px 0 0; box-shadow:0 -8px 24px rgba(5,47,111,.18); display:flex; }
        .sidebar .brand, .sidebar .school-switch, .sidebar .nav-label, .sidebar .sidebar-foot, .sidebar > .bfr-legacy-nav { display:none; }
        .sidebar > .nav-list:first-of-type { width:100%; height:64px; display:flex; align-items:stretch; justify-content:space-around; gap:2px; overflow:hidden; }
        .sidebar > .nav-list:first-of-type .nav-item { display:grid; place-items:center; align-content:center; gap:2px; width:auto; flex:1; padding:6px 3px; text-align:center; font-size:9px; }
        .sidebar > .nav-list:first-of-type .nav-icon { display:block; width:auto; font-size:15px; }
        .sidebar > .nav-list:first-of-type .nav-item:nth-child(n+6) { display:none; }
        .topbar { height:62px; padding:0 17px; }
        .content { padding:22px 14px 30px; }
        .panel, .metric-card, .teacher-metric { border-radius:14px; }
         .child-card { border-radius:16px; }
         .tap-target { min-height:44px; }
         .project-tab.tap-target, .class-tab.tap-target { padding-top:13px; padding-bottom:13px; }
         .schedule-shift.tap-target, .growth-action.tap-target, [data-section-link].tap-target { display:inline-flex; align-items:center; justify-content:center; min-height:44px; }
         .mobile-more-option.tap-target { min-height:52px; }
       }
      .teacher-welcome { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:28px; gap:20px; }
    .teacher-welcome .primary-button, .primary-button { border:0; color:#fff; background:var(--coral); border-radius:10px; padding:11px 15px; font-size:11px; font-weight:700; box-shadow:0 7px 16px rgba(241,139,113,.22); }
    .teacher-welcome .primary-button:hover, .primary-button:hover { background:#dc765e; transform:translateY(-1px); }
    .teacher-metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:18px; }
    .teacher-metric { background:#fff; border:1px solid var(--line); border-radius:14px; padding:17px 18px; }
    .teacher-metric strong { display:block; font:700 28px 'Playfair Display',serif; margin-top:11px; }
    .teacher-metric span { color:var(--muted); font-size:10px; }
    .teacher-metric .trend { color:#16826f; font-weight:700; margin-left:5px; }
    .class-layout { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(270px,.75fr); gap:18px; align-items:start; }
    .class-tabs { display:flex; gap:6px; border-bottom:1px solid var(--line); margin-bottom:12px; }
    .class-tab { border:0; background:transparent; padding:7px 10px 11px; font-size:11px; color:var(--muted); border-bottom:2px solid transparent; }
    .class-tab.active { color:var(--teal); border-bottom-color:var(--teal); font-weight:700; }
    .student-table { width:100%; border-collapse:collapse; }
    .student-table th { text-align:left; color:#91a09b; text-transform:uppercase; font:10px 'DM Mono',monospace; padding:9px 8px; border-bottom:1px solid var(--line); }
    .student-table td { padding:12px 8px; border-bottom:1px solid #edf1ef; font-size:11px; }
    .student-table tr:last-child td { border-bottom:0; }
    .student-name { display:flex; align-items:center; gap:8px; font-weight:600; }
    .student-table .avatar { width:27px; height:27px; font-size:9px; background:#f0c8b5; color:#7b4b3a; }
    .grade { font-weight:700; color:var(--teal); background:var(--mint); border-radius:6px; padding:4px 7px; }
    .attendance-pill { font-size:10px; color:#567d68; background:#eaf5eb; border-radius:20px; padding:4px 7px; }
    .side-highlight { background:var(--teal); color:#fff; border-radius:15px; padding:21px; }
    .side-highlight .eyebrow { color:#91c2b6; }
    .side-highlight h2 { font:600 22px 'Playfair Display',serif; line-height:1.16; margin:8px 0 18px; }
    .side-highlight p { color:#b8d8d0; font-size:11px; line-height:1.5; }
    .progress-row { display:flex; align-items:center; justify-content:space-between; font-size:10px; margin-top:19px; color:#c9e4dc; }
    .progress-track { height:6px; background:rgba(255,255,255,.18); border-radius:10px; margin-top:8px; overflow:hidden; }
    .progress-track i { display:block; width:72%; height:100%; background:var(--sun); border-radius:inherit; }
    .teacher-project { display:flex; gap:10px; align-items:center; padding:11px 0; border-top:1px solid #edf1ef; }
    .teacher-project:first-child { border-top:0; padding-top:0; }
    .teacher-project .project-date { width:37px; height:37px; }
    .teacher-project .project-date b { font-size:15px; }
    .teacher-project strong { font-size:11px; }
    .teacher-project p { margin-top:3px; font-size:10px; color:var(--muted); }
    .directory-controls { display:grid; grid-template-columns:150px 150px 1fr; gap:8px; margin:13px 0; }
    .directory-controls select, .directory-controls input { min-width:0; border:1px solid var(--line); border-radius:8px; background:#fbfcfb; color:var(--ink); padding:9px 10px; font-size:10px; }
    .directory-meta { color:var(--muted); font-size:10px; margin-bottom:12px; }
    .roster-groups { display:grid; gap:8px; }
    .roster-group { border:1px solid var(--line); border-radius:10px; overflow:hidden; }
    .roster-group summary { cursor:pointer; list-style:none; display:flex; align-items:center; justify-content:space-between; gap:10px; background:#f7faf8; padding:10px 12px; font-size:11px; font-weight:700; }
    .roster-group summary::-webkit-details-marker { display:none; }
    .roster-group summary:after { content:'+'; color:var(--teal); font-size:16px; font-weight:400; }
    .roster-group[open] summary:after { content:'−'; }
    .roster-group summary span { color:var(--muted); font:9px 'DM Mono',monospace; font-weight:400; margin-left:auto; }
    .roster-list { display:grid; grid-template-columns:repeat(3,1fr); gap:0 18px; padding:6px 12px 10px; }
    .roster-student { border-top:1px solid #edf1ef; padding:7px 0; color:#526660; font-size:10px; }
    .roster-student b { color:var(--teal); font:9px 'DM Mono',monospace; margin-right:6px; }
    .roster-empty { color:var(--muted); font-size:11px; padding:13px 0; }
    @media (max-width: 1050px) {
      .app-shell { grid-template-columns: 208px 1fr; }
      .topbar, .content { padding-left:28px; padding-right:28px; }
      .child-meta { gap:15px; }
      .overview-grid { grid-template-columns:repeat(3,1fr); }
    }
       @media (max-width: 800px) {
      .app-shell { display:block; }
      .sidebar { min-height:auto; padding:17px 16px 12px; display:block; }
      .brand { padding:0 8px 16px; }
      .school-switch, .nav-label, .sidebar-foot { display:none; }
      .nav-list { display:flex; overflow-x:auto; gap:5px; padding-bottom:3px; }
      .nav-item { width:auto; white-space:nowrap; padding:8px 10px; font-size:11px; }
      .nav-icon { display:none; }
      .topbar { height:62px; padding:0 17px; }
      .breadcrumb { font-size:11px; }
      .top-actions { gap:7px; }
      .role-toggle button { padding:6px 8px; font-size:10px; }
       .top-actions > .avatar { display:none; }
       .logout-top-button { padding:7px 9px; }
      .content { padding:25px 17px 35px; }
      .welcome { align-items:flex-start; flex-direction:column; margin-bottom:20px; }
      h1 { font-size:36px; }
      .date-chip { font-size:9px; }
       .child-card { align-items:flex-start; flex-direction:column; gap:18px; padding:18px; }
       .parent-student-switcher { width:100%; min-width:0; margin:0; }
      .child-meta { width:100%; }
      .child-stat:first-child { padding-left:0; border-left:0; }
      .overview-grid { grid-template-columns:1fr 1fr; }
      .overview-grid .metric-card:first-child { grid-column:span 2; }
      .main-grid, .class-layout { grid-template-columns:1fr; }
      .teacher-metrics { grid-template-columns:1fr 1fr; }
    }
    @media (max-width: 430px) {
      .overview-grid { gap:9px; }
      .metric-card { padding:14px; min-height:130px; }
      .metric-value { margin-top:16px; }
      .metric-value strong { font-size:27px; }
      .panel { padding:17px 15px; }
      .attendance-chart { gap:5px; }
      .teacher-welcome { flex-direction:column; align-items:flex-start; }
      .teacher-metrics { gap:9px; }
      .student-table th, .student-table td { padding-left:3px; padding-right:3px; }
       .student-table th:nth-child(3), .student-table td:nth-child(3) { display:none; }
     }
      .weather-card { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:18px; padding:17px 20px; border:1px solid #cfe0f2; border-radius:16px; background:linear-gradient(110deg,#edf5ff,#fff); box-shadow:0 8px 22px rgba(13,62,126,.05); }
      .weather-main { display:flex; align-items:center; gap:12px; margin-top:8px; }
      .weather-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:#dbeaff; color:#0b55a6; font-size:25px; }
      .weather-main strong { display:block; font:700 27px 'DM Sans',sans-serif; color:var(--teal-deep); letter-spacing:-1px; }
      .weather-main span:last-child { display:block; margin-top:2px; color:var(--muted); font-size:11px; }
      .weather-details { display:grid; gap:6px; text-align:right; color:var(--muted); font:10px 'DM Mono',monospace; }
      .weather-card.is-error { background:#f8fbff; }
      .mobile-more-item, .mobile-more-menu { display:none; }
      @media (max-width:800px) {
        html, body { overflow-x:hidden; }
        #appShell.ready { display:block; }
        .topbar { min-width:0; padding:0 12px; }
        .breadcrumb { min-width:0; font-size:0; white-space:nowrap; }
        .breadcrumb b { font-size:11px; }
        .live-clock { margin-left:5px; font-size:8px; }
        .top-actions { min-width:0; gap:4px; }
        .role-toggle button { padding:6px 6px; }
        .icon-button { width:30px; height:30px; }
        .logout-top-button { font-size:10px; padding:7px 8px; }
        .weather-card { align-items:flex-start; flex-direction:column; gap:12px; padding:15px; }
        .weather-details { width:100%; display:flex; justify-content:space-between; text-align:left; gap:8px; }
      }
      @media (max-width:800px) {
        #appShell.ready { padding-bottom:0; }
        #appShell.ready .sidebar { position:sticky; top:0; left:auto; right:auto; bottom:auto; z-index:20; height:auto; min-height:0; padding:12px 12px 10px; border-radius:0 0 18px 18px; display:block; box-shadow:0 8px 22px rgba(5,47,111,.18); }
        #appShell.ready .sidebar .brand { display:flex; padding:0 5px 11px; }
        #appShell.ready .sidebar .brand-name { font-size:18px; }
        #appShell.ready .sidebar .school-switch, #appShell.ready .sidebar .nav-label, #appShell.ready .sidebar .sidebar-foot, #appShell.ready .sidebar > .bfr-legacy-nav { display:none; }
        #appShell.ready .sidebar > .nav-list:first-of-type { height:auto; width:100%; display:flex; align-items:stretch; justify-content:flex-start; gap:7px; overflow-x:auto; overflow-y:hidden; padding:0 2px 2px; scroll-snap-type:x proximity; }
        #appShell.ready .sidebar > .nav-list:first-of-type::-webkit-scrollbar { display:none; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item { position:relative; flex:0 0 auto; min-width:88px; width:auto; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:4px; padding:10px 11px 9px; border:1px solid rgba(255,255,255,.1); border-radius:13px; background:rgba(255,255,255,.07); color:#b8d5ef; text-align:center; font-size:10px; line-height:1.15; scroll-snap-align:start; transition:transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item:hover { transform:translateY(-2px); background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.24); }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item:active { transform:scale(.96); }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active { color:#fff; background:linear-gradient(145deg,#1b68c5,#0b4793); border-color:#4a93ea; box-shadow:0 7px 16px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.18); }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active:after { content:''; position:absolute; left:50%; bottom:-3px; width:22px; height:3px; border-radius:4px; background:#79c4ff; transform:translateX(-50%); }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-icon { display:block; width:auto; font-size:19px; line-height:1; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-badge { position:absolute; top:5px; right:6px; margin:0; padding:2px 5px; font-size:8px; }
        #appShell.ready main { min-width:0; }
        #appShell.ready .topbar { position:relative; top:auto; }
        #appShell.ready .content { padding:22px 14px 32px; }
      }
      @media (max-width:800px) {
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item:not([data-section="inicio"]):not([data-section="notas"]):not([data-section="agenda"]):not([data-section="horarios"]):not([data-section="comunicados"]):not(.mobile-more-item) { display:none !important; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="inicio"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="notas"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="agenda"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="horarios"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="comunicados"], #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { display:flex !important; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="inicio"] { order:1; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="comunicados"] { order:2; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="agenda"] { order:3; }
          #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="horarios"] { order:4; }
          #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="notas"] { order:5; }
          #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { order:6; }
        #appShell.ready .sidebar > .nav-list:first-of-type .nav-item { min-width:82px; }
        #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { background:rgba(121,196,255,.12); border-color:rgba(121,196,255,.34); }
        #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item.active { background:linear-gradient(145deg,#1b68c5,#0b4793); border-color:#4a93ea; color:#fff; }
        .mobile-more-menu { position:fixed; z-index:30; left:12px; right:12px; top:112px; max-height:calc(100vh - 128px); overflow:auto; padding:15px; border:1px solid #d4e2f1; border-radius:18px; background:#fff; box-shadow:0 18px 45px rgba(5,47,111,.25); }
        .mobile-more-menu:not(.hidden) { display:block !important; animation:menuDrop .22s ease both; }
        .mobile-more-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
        .mobile-more-heading strong { display:block; margin-top:3px; color:var(--teal-deep); font-size:16px; }
        .mobile-more-close { width:30px; height:30px; border:1px solid var(--line); border-radius:9px; background:#f6f9fd; color:var(--teal); font-size:20px; line-height:1; }
        .mobile-more-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
        .mobile-more-option { min-height:54px; display:flex; align-items:center; gap:8px; padding:9px; border:1px solid var(--line); border-radius:11px; background:#f8fbff; color:var(--teal-deep); text-align:left; font-size:10px; transition:transform .18s ease,background .18s ease,border-color .18s ease; }
         .mobile-more-option span { color:var(--teal); font-size:17px; }
         .mobile-logout-option { color:#a24f3d; background:#fff6f2; border-color:#f0d4ca; }
         .mobile-logout-option span { color:#b65e4b; }
         .mobile-more-option:hover, .mobile-more-option:active { transform:translateY(-2px); background:#edf5ff; border-color:#9fc5ec; }
       }
       @media (max-width:800px) {
         #appShell.ready .sidebar { padding:10px 10px 8px; }
         #appShell.ready .sidebar .brand { padding:0 5px 8px; }
          #appShell.ready .sidebar > .nav-list:first-of-type { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:2px; width:100%; padding:3px; overflow:visible; border:1px solid rgba(255,255,255,.12); border-radius:12px; background:rgba(255,255,255,.06); }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item { min-width:0; width:100%; padding:7px 2px 6px; border:0; border-radius:9px; gap:3px; font-size:8px; line-height:1; white-space:nowrap; overflow:hidden; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-icon { font-size:15px; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-badge { top:2px; right:3px; padding:1px 4px; font-size:7px; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active:after { bottom:1px; width:17px; height:2px; }
         #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { background:transparent; border-color:transparent; }
         #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item.active { background:linear-gradient(145deg,#1b68c5,#0b4793); border-color:transparent; }
       }
       @keyframes menuDrop { from { opacity:0; transform:translateY(-8px) scale(.98); } to { opacity:1; transform:translateY(0) scale(1); } }
       .content > * { scroll-margin-top:90px; }
       @media (max-width:800px) { .content > * { scroll-margin-top:130px; } }
       .project-photo img, .admin-project-photo img, .project-photo-list img, .photo[data-photo-src] { cursor:zoom-in; }
       .photo-lightbox { position:fixed; inset:0; z-index:100; display:grid; place-items:center; padding:24px; background:rgba(8,25,38,.78); backdrop-filter:blur(5px); }
       .photo-lightbox.hidden { display:none; }
       .photo-lightbox-figure { display:grid; justify-items:center; gap:10px; max-width:min(1100px,94vw); max-height:90vh; margin:0; }
       .photo-lightbox-figure img { display:block; max-width:94vw; max-height:78vh; border:1px solid rgba(255,255,255,.28); border-radius:14px; background:#eef5f1; object-fit:contain; box-shadow:0 24px 80px rgba(0,0,0,.38); }
       .photo-lightbox-figure figcaption { max-width:80vw; color:#f6fbf8; font-size:11px; text-align:center; }
       .photo-lightbox-close { position:absolute; top:18px; right:20px; width:38px; height:38px; border:1px solid rgba(255,255,255,.35); border-radius:50%; background:rgba(255,255,255,.12); color:#fff; font-size:26px; line-height:1; cursor:pointer; }
       .photo-lightbox-close:hover, .photo-lightbox-close:focus-visible { background:rgba(255,255,255,.25); outline:2px solid #fff; outline-offset:2px; }
       body.photo-lightbox-open { overflow:hidden; }
       /* Reference visual system: soft workspace, clear blue actions and compact cards. */
       body { background:#f5f7fb; color:var(--ink); }
       .app-shell { grid-template-columns:230px minmax(0,1fr); background:#f5f7fb; }
       .sidebar { background:#fff; color:#5c6b88; padding:23px 14px 16px; border-right:1px solid #e5eaf2; box-shadow:8px 0 28px rgba(44,67,112,.04); }
       .brand { gap:10px; padding:0 9px 23px; color:#17233f; }
       .brand-name { font-family:'DM Sans',sans-serif; font-size:18px; font-weight:800; letter-spacing:-.65px; }
       .app-logo { width:42px; height:42px; border:1px solid #e3e9f3; }
       .school-switch { border:0; margin:0 2px 23px; padding:12px; background:#f7f9fd; border-radius:13px; }
       .sidebar .eyebrow { color:#8b98ad; }
       .school-switch strong { color:#1c2b4a; font-size:12px; }
       .school-switch span { color:#8290a8; font-size:10px; }
       .nav-label { color:#9aa6b9; padding:0 11px 8px; font-size:9px; }
       .nav-list { gap:4px; }
       .nav-item { color:#63718e; padding:9px 10px; border-radius:10px; gap:10px; font-size:11px; font-weight:600; }
       .nav-item:hover, .nav-item.active { color:#1f5fe2; background:#edf3ff; }
       .nav-icon { color:inherit; font-size:15px; }
       .nav-badge { background:#e8efff; color:#2563eb; font-size:9px; padding:2px 6px; }
       .sidebar-foot { border-top:1px solid #e8edf4; }
       .mini-person strong { color:#233253; }
       .mini-person span { color:#8290a8; }
       .logout-button { border-color:#e3e9f2; color:#63718e; }
       .logout-button:hover { color:#2563eb; background:#f1f5ff; }
       .topbar { height:70px; background:rgba(255,255,255,.92); border-bottom-color:#e6ebf3; padding:0 35px; }
       .breadcrumb { color:#8b97aa; font-size:11px; }
       .breadcrumb b { color:#243253; }
       .role-toggle { background:#f0f3f8; }
       .role-toggle button.active { color:#2563eb; }
       .icon-button, .logout-top-button { border-color:#e1e8f2; color:#2563eb; }
       .logout-top-button:hover { background:#f1f5ff; }
       .content { padding:30px 35px 55px; max-width:1440px; }
       .welcome { margin-bottom:19px; }
       h1, h2, h3, .panel-heading h2, .modal-card h2 { font-family:'DM Sans',sans-serif; letter-spacing:-.55px; }
       h1 { font-size:clamp(28px,3vw,38px); color:#17233f; letter-spacing:-1.25px; }
       .welcome p { color:#7d8aa0; font-size:12px; }
       .date-chip { color:#2563eb; background:#eaf1ff; border-radius:10px; padding:9px 12px; font-size:9px; }
       .weather-card { border-color:#dce6f5; background:linear-gradient(110deg,#f1f6ff,#fff); box-shadow:0 8px 22px rgba(37,99,235,.06); }
       .child-card { color:#1e2d4c; background:#fff; border:1px solid #e2e9f3; border-radius:16px; box-shadow:var(--shadow); }
       .child-card:after { display:none; }
       .child-info strong { font-family:'DM Sans',sans-serif; font-size:16px; font-weight:700; }
       .child-info span { color:#7c8ba3; }
       .child-meta { gap:20px; }
       .child-stat { border-left-color:#e7edf5; }
       .child-stat b { color:#2563eb; font-size:18px; }
       .child-stat span { color:#8591a7; }
       .overview-grid { gap:11px; }
       .metric-card, .teacher-metric { border-color:#e3e9f2; border-radius:14px; box-shadow:0 7px 20px rgba(43,67,115,.045); }
       .metric-card { min-height:126px; padding:16px; }
       .metric-head { color:#7d8aa0; font-size:10px; }
       .metric-value strong, .report-average strong { font-family:'DM Sans',sans-serif; color:#1558dc; }
       .metric-value strong { font-size:30px; }
       .metric-foot { color:#8793a7; font-size:10px; }
       .main-grid { gap:15px; }
       .panel { border-color:#e3e9f2; border-radius:15px; padding:19px; box-shadow:0 8px 22px rgba(43,67,115,.045); }
       .panel-heading { margin-bottom:16px; }
       .panel-heading h2 { color:#1e2d4c; font-size:16px; }
       .panel-heading a, .text-button { color:#2563eb; font-size:10px; }
       .data-empty-inline { width:100%; padding:18px 8px; color:#8290a8; font-size:10px; text-align:center; }
       .activity { border-top-color:#edf1f6; }
       .activity strong, .project strong { color:#283654; }
       .activity p, .project p { color:#8190a7; }
       .project-date { background:#eeeaff; color:#6657a6; }
       .side-highlight { background:linear-gradient(135deg,#2563eb,#3978f2); border-radius:15px; box-shadow:0 10px 24px rgba(37,99,235,.16); }
       .primary-button { background:#2563eb !important; border-radius:9px; box-shadow:0 7px 16px rgba(37,99,235,.14); }
       .primary-button:hover { background:#1e54c8 !important; }
       .class-tab, .project-tab { color:#77859d; }
       .class-tab.active, .project-tab.active { color:#2563eb; border-color:#2563eb; }
       .student-table th { color:#8b97aa; }
       .student-table td { border-color:#edf1f6; }
       .login-screen { background:radial-gradient(circle at 12% 15%,rgba(37,99,235,.12),transparent 27%),linear-gradient(135deg,#f2f7ff,#fbfcff 54%,#edf4ff); }
       .login-card { border-color:#e2e9f3; box-shadow:0 25px 80px rgba(43,67,115,.13); }
       .login-layout { background:#10295f; }
       .login-message h1 { color:#fff; font-family:'DM Sans',sans-serif; }
       .login-form h2 { font-family:'DM Sans',sans-serif; color:#17233f; }
       .google-button { background:#2563eb; border-color:#2563eb; color:#fff; box-shadow:0 8px 18px rgba(37,99,235,.18); }
       .google-button:hover { background:#1e54c8; border-color:#1e54c8; }
       .google-g { padding:1px 4px; border-radius:4px; background:#fff; }
       .modal-card { border:1px solid #e2e9f3; }
       @media (max-width:1100px) and (min-width:801px) {
         .app-shell { grid-template-columns:205px minmax(0,1fr); }
         .content, .topbar { padding-left:25px; padding-right:25px; }
       }
       @media (max-width:800px) {
         #appShell.ready { display:block; background:#f5f7fb; }
         #appShell.ready .sidebar { position:fixed; top:auto; right:0; bottom:0; left:0; z-index:50; height:68px; min-height:0; padding:6px 8px 7px; border:1px solid #e1e7f0; border-bottom:0; border-radius:16px 16px 0 0; box-shadow:0 -8px 24px rgba(43,67,115,.12); }
          #appShell.ready .sidebar .brand, #appShell.ready .sidebar .school-switch, #appShell.ready .sidebar .nav-label, #appShell.ready .sidebar .sidebar-foot, #appShell.ready .sidebar > .bfr-legacy-nav { display:none; }
          #appShell.ready .sidebar > .nav-list:first-of-type { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:2px; width:100%; height:55px; padding:2px; overflow:visible; border:0; background:transparent; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item { display:none !important; min-width:0; width:100%; height:52px; padding:6px 2px 5px; border:0; border-radius:10px; color:#71809a; background:transparent; gap:3px; font-size:8px; line-height:1; white-space:nowrap; }
          #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="inicio"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="notas"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="agenda"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="horarios"], #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="comunicados"], #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { display:flex !important; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="inicio"] { order:1; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="comunicados"] { order:2; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="agenda"] { order:3; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="horarios"] { order:4; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item[data-section="notas"] { order:5; }
         #appShell.ready .sidebar > .nav-list:first-of-type .mobile-more-item { order:6; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item:hover { transform:none; background:#f1f5ff; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active { color:#2563eb; background:#edf3ff; box-shadow:none; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-item.active:after { bottom:1px; width:17px; height:2px; background:#2563eb; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-icon { display:block; width:auto; color:inherit; font-size:15px; }
         #appShell.ready .sidebar > .nav-list:first-of-type .nav-badge { top:2px; right:3px; padding:1px 4px; background:#e8efff; color:#2563eb; font-size:7px; }
         #appShell.ready main { min-width:0; }
         #appShell.ready .topbar { position:sticky; top:0; z-index:4; height:62px; padding:0 14px; }
         #appShell.ready .breadcrumb { font-size:0; }
         #appShell.ready .breadcrumb b { font-size:10px; }
         #appShell.ready .live-clock { font-size:8px; }
          #appShell.ready .role-toggle { display:none; }
         #appShell.ready .top-actions { gap:6px; }
         #appShell.ready .top-actions > .avatar { display:grid; }
         #appShell.ready .icon-button { width:30px; height:30px; }
         #appShell.ready .content { padding:21px 14px 92px; }
         #appShell.ready .welcome { align-items:flex-start; margin-bottom:16px; }
         #appShell.ready h1 { font-size:30px; }
         #appShell.ready .welcome p { font-size:11px; }
         #appShell.ready .date-chip { margin-top:10px; }
         #appShell.ready .weather-card { padding:14px; gap:10px; }
         #appShell.ready .child-card { padding:16px; gap:15px; }
         #appShell.ready .overview-grid { gap:9px; }
         #appShell.ready .metric-card { min-height:125px; padding:14px; }
         #appShell.ready .panel { padding:16px 14px; }
         #appShell.ready .mobile-more-menu { top:auto; bottom:76px; max-height:calc(100vh - 94px); border-color:#e0e7f2; box-shadow:0 18px 45px rgba(43,67,115,.22); }
       }
        @media (max-width:430px) {
          #appShell.ready .content { padding-left:14px; padding-right:14px; }
          #appShell.ready .weather-details { font-size:9px; }
          #appShell.ready .metric-value strong { font-size:27px; }
        }
        .coordinator-admin-badge { display:inline-flex; align-items:center; gap:6px; color:#2563eb; background:#edf3ff; border:1px solid #d7e5ff; border-radius:20px; padding:6px 9px; font:9px 'DM Mono',monospace; text-transform:uppercase; white-space:nowrap; }
        .coordinator-actions .text-button { border:1px solid #d7e5ff; border-radius:9px; padding:10px 12px; background:#fff; }
        .coordinator-actions .text-button:hover { background:#edf3ff; }
        .coordinator-table-wrap { overflow-x:auto; border-top:1px solid #edf1f6; }
        .coordinator-table { min-width:720px; }
        .coordinator-row { grid-template-columns:58px minmax(165px,1.5fr) 105px 72px 92px 105px; }
        .coordinator-row-head { border-top:0; padding:0 0 8px; color:#8b97aa; font:9px 'DM Mono',monospace; text-transform:uppercase; }
        .coordinator-row-head span { color:inherit; font:inherit; }
        .coordinator-live-status { color:#16826f; font:9px 'DM Mono',monospace; text-transform:uppercase; }
        .coordinator-live-status.is-reconnecting { color:#9b6d13; }
        .coordinator-admin-note { margin-top:12px; padding:10px 12px; border:1px solid #dce8f8; border-radius:10px; background:#f7faff; color:#64748b; font-size:10px; line-height:1.5; }
        .class-tabs .class-tab.active, .project-tabs .project-tab.active { color:#2563eb; border-color:#2563eb; }
        @media (max-width:800px) {
          #appShell.ready .coordinator-welcome p { font-size:12px; }
          #appShell.ready .coordinator-actions .primary-button, #appShell.ready .coordinator-actions .text-button { font-size:11px; padding:10px 11px; }
          #appShell.ready .coordinator-filters input, #appShell.ready .coordinator-filters select { font-size:11px; padding:11px 10px; }
          #appShell.ready .coordinator-row { font-size:11px; padding:12px 0; }
          #appShell.ready .coordinator-student strong { font-size:12px; }
          #appShell.ready .coordinator-student span, #appShell.ready .coordinator-time, #appShell.ready .coordinator-status { font-size:10px; }
          #appShell.ready .coordinator-admin-note { font-size:11px; }
        }
        .secretary-hero { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:22px; }
        .secretary-hero h1 { max-width:720px; }
        .secretary-hero p { max-width:700px; margin-top:9px; color:var(--muted); font-size:12px; line-height:1.5; }
        .secretary-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; }
        .secretary-grid { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(270px,.8fr); gap:18px; align-items:start; }
        .secretary-summary-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:18px; }
        .secretary-stat { border:1px solid #dce7f6; border-radius:13px; padding:14px; background:linear-gradient(145deg,#f7faff,#fff); }
        .secretary-stat span { color:#7d8aa0; font-size:10px; }
        .secretary-stat strong { display:block; margin-top:7px; color:#1558dc; font:700 27px 'DM Sans',sans-serif; }
        .secretary-stat small { display:block; margin-top:4px; color:#8793a7; font-size:9px; }
        .secretary-service-card { display:flex; align-items:center; gap:12px; border:1px solid #dce7f6; border-radius:12px; padding:14px; background:#fff; }
        .secretary-service-icon { display:grid; place-items:center; flex:0 0 42px; height:42px; border-radius:12px; color:#2563eb; background:#eaf1ff; font-size:20px; }
        .secretary-service-card strong { display:block; color:#1e2d4c; font-size:12px; }
        .secretary-service-card p { margin-top:4px; color:var(--muted); font-size:10px; line-height:1.4; }
        .secretary-service-card button { margin-left:auto; flex:0 0 auto; }
        .secretary-list { display:grid; gap:9px; }
        .secretary-request-card { border:1px solid #e2e9f3; border-radius:11px; padding:13px; background:#fff; }
        .secretary-request-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
        .secretary-request-top strong { color:#243253; font-size:12px; }
        .secretary-request-top small { color:#8491a7; font:9px 'DM Mono',monospace; white-space:nowrap; }
        .secretary-request-card p { margin-top:6px; color:#687791; font-size:10px; line-height:1.45; }
        .secretary-request-meta { display:flex; flex-wrap:wrap; gap:6px 12px; margin-top:8px; color:#8491a7; font-size:9px; }
        .secretary-status { display:inline-flex; border-radius:20px; padding:4px 7px; color:#2563eb; background:#edf3ff; font:9px 'DM Mono',monospace; text-transform:uppercase; white-space:nowrap; }
        .secretary-status.is-ready { color:#16826f; background:#eaf6ef; }
        .secretary-status.is-warning { color:#9b6d13; background:#fff4d5; }
        .secretary-status.is-danger { color:#a24f3d; background:#fff0eb; }
        .secretary-wizard { display:grid; gap:13px; margin-top:16px; }
        .secretary-step { display:none; border:1px solid #e2e9f3; border-radius:12px; padding:14px; background:#fbfcff; }
        .secretary-step.active { display:grid; gap:10px; }
        .secretary-step h3 { color:#243253; font-size:13px; }
        .secretary-step p { color:var(--muted); font-size:10px; line-height:1.45; }
        .secretary-option-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
        .secretary-option { display:grid; gap:4px; min-height:68px; border:1px solid #dce7f6; border-radius:10px; padding:10px; background:#fff; color:#243253; text-align:left; }
        .secretary-option:hover, .secretary-option.is-selected { border-color:#6fa0eb; background:#edf3ff; }
        .secretary-option strong { font-size:10px; }
        .secretary-option span { color:#7d8aa0; font-size:9px; line-height:1.35; }
        .secretary-step label, .secretary-form label { display:grid; gap:5px; color:#70809b; font-size:10px; }
        .secretary-step input, .secretary-step select, .secretary-step textarea, .secretary-form input, .secretary-form select, .secretary-form textarea { width:100%; border:1px solid #dce4f0; border-radius:8px; padding:10px; color:#243253; background:#fff; font:inherit; }
        .secretary-step textarea, .secretary-form textarea { min-height:76px; resize:vertical; }
        .secretary-step input[type=radio] { width:auto; accent-color:#2563eb; }
        .secretary-wizard-actions { display:flex; justify-content:space-between; gap:8px; }
        .secretary-wizard-actions .secretary-next { margin-left:auto; }
        .secretary-review { display:grid; gap:7px; padding:11px; border:1px solid #dce7f6; border-radius:9px; background:#fff; color:#61708b; font-size:10px; }
        .secretary-review b { color:#243253; }
        .secretary-timeline { display:grid; gap:0; margin-top:10px; }
        .secretary-timeline-item { position:relative; display:grid; grid-template-columns:20px 1fr; gap:8px; padding:0 0 14px; }
        .secretary-timeline-item:last-child { padding-bottom:0; }
        .secretary-timeline-item:before { content:''; position:absolute; left:8px; top:16px; bottom:0; width:1px; background:#dce7f6; }
        .secretary-timeline-item:last-child:before { display:none; }
        .secretary-timeline-dot { z-index:1; width:17px; height:17px; border:4px solid #dbe8fb; border-radius:50%; background:#2563eb; }
        .secretary-timeline-item.is-done .secretary-timeline-dot { border-color:#d8f0e4; background:#16826f; }
        .secretary-timeline-item.is-current .secretary-timeline-dot { border-color:#ffe8ae; background:#e0a521; }
        .secretary-timeline-item strong { display:block; color:#243253; font-size:10px; }
        .secretary-timeline-item small { display:block; margin-top:3px; color:#8491a7; font-size:9px; }
        .secretary-document-card { display:grid; gap:7px; border:1px solid #dce7f6; border-radius:10px; padding:11px; background:#fbfcff; }
        .secretary-document-card strong { color:#243253; font-size:11px; }
        .secretary-document-card span { color:#8491a7; font-size:9px; }
        .secretary-form { display:grid; gap:10px; margin-top:12px; }
        .secretary-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:9px; }
        .secretary-staff-toolbar { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
        .secretary-staff-toolbar select, .secretary-staff-toolbar input { min-width:160px; flex:1; border:1px solid #dce4f0; border-radius:8px; padding:9px; color:#243253; background:#fff; font-size:10px; }
        .secretary-staff-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:18px; align-items:start; }
        .secretary-detail { position:sticky; top:86px; }
        .secretary-detail dl { display:grid; grid-template-columns:100px 1fr; gap:8px; margin:13px 0; font-size:10px; }
        .secretary-detail dt { color:#8491a7; }
        .secretary-detail dd { color:#243253; font-weight:600; }
        .secretary-staff-actions { display:flex; flex-wrap:wrap; gap:7px; margin-top:12px; }
        .secretary-staff-actions button { flex:1; min-width:125px; }
        .secretary-staff-note { min-height:68px; width:100%; border:1px solid #dce4f0; border-radius:8px; padding:9px; font-size:10px; resize:vertical; }
         .secretary-filter-chip { color:#2563eb; background:#edf3ff; border-radius:20px; padding:5px 8px; font:9px 'DM Mono',monospace; text-transform:uppercase; }
         .secretary-network-tabs { display:flex; flex-wrap:wrap; gap:7px; margin:0 0 18px; padding:6px; border:1px solid #dce7f6; border-radius:14px; background:#f7faff; }
         .secretary-network-hero .text-button { border:1px solid rgba(255,255,255,.35); border-radius:9px; padding:10px 12px; color:#fff; background:rgba(255,255,255,.1); }
         .secretary-network-hero .text-button:hover { color:#10295f; background:#fff; }
         .secretary-network-tab { border:1px solid transparent; border-radius:9px; padding:10px 12px; color:#6d7d98; background:transparent; font-size:10px; font-weight:600; }
         .secretary-network-tab:hover, .secretary-network-tab.is-active { border-color:#c9daf5; color:#1558dc; background:#fff; box-shadow:0 4px 12px rgba(37,99,235,.08); }
         .secretary-network-status { min-height:20px; margin:-5px 0 14px; color:#73839d; font:9px 'DM Mono',monospace; }
         .secretary-network-status.is-error { color:#a24f3d; }
         .secretary-network-screen { display:grid; gap:18px; }
         .secretary-network-screen.hidden { display:none; }
         .secretary-network-card-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
         .secretary-network-card { min-height:128px; border:1px solid #dce7f6; border-radius:13px; padding:14px; background:linear-gradient(145deg,#f7faff,#fff); }
         .secretary-network-card span { display:block; color:#7d8aa0; font-size:10px; }
         .secretary-network-card strong { display:block; margin-top:9px; color:#1558dc; font:700 28px 'DM Sans',sans-serif; }
         .secretary-network-card small { display:block; margin-top:5px; color:#8793a7; font-size:9px; line-height:1.35; }
         .secretary-network-card.is-neutral strong { color:#62728d; }
         .secretary-network-grid { display:grid; grid-template-columns:minmax(0,1.18fr) minmax(270px,.82fr); gap:18px; align-items:start; }
         .secretary-network-panel-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:13px; }
         .secretary-network-panel-head h2 { margin-top:4px; }
         .secretary-network-panel-head p { margin-top:5px; color:var(--muted); font-size:10px; line-height:1.45; }
         .secretary-network-list { display:grid; gap:8px; }
         .secretary-network-list-item { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:11px 0; border-top:1px solid #edf1f6; }
         .secretary-network-list-item:first-child { padding-top:0; border-top:0; }
         .secretary-network-list-item strong { display:block; color:#243253; font-size:11px; }
         .secretary-network-list-item span { display:block; margin-top:4px; color:#8491a7; font-size:9px; line-height:1.35; }
         .secretary-network-empty { padding:17px 12px; border:1px dashed #cbd8ea; border-radius:10px; color:#8190a7; background:#fbfcff; font-size:10px; line-height:1.45; text-align:center; }
         .secretary-school-toolbar, .secretary-request-toolbar { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
         .secretary-school-toolbar input, .secretary-school-toolbar select, .secretary-request-toolbar input, .secretary-request-toolbar select { min-width:150px; flex:1; border:1px solid #dce4f0; border-radius:8px; padding:10px; color:#243253; background:#fff; font-size:10px; }
         .secretary-school-list { display:grid; gap:9px; }
         .secretary-school-row { display:grid; grid-template-columns:minmax(0,1.35fr) repeat(3,minmax(80px,.55fr)) auto; gap:10px; align-items:center; padding:13px; border:1px solid #e2e9f3; border-radius:11px; background:#fff; }
         .secretary-school-row.is-selected { border-color:#79a5e8; background:#f7faff; box-shadow:0 5px 15px rgba(37,99,235,.07); }
         .secretary-school-row strong { display:block; color:#243253; font-size:11px; }
         .secretary-school-row small { display:block; margin-top:4px; color:#8491a7; font-size:9px; }
         .secretary-school-value { color:#243253; font-size:12px; font-weight:700; }
         .secretary-school-value span { display:block; margin-top:3px; color:#8491a7; font-size:8px; font-weight:400; }
         .secretary-school-detail { position:sticky; top:86px; }
         .secretary-school-detail dl { display:grid; grid-template-columns:105px 1fr; gap:8px; margin:14px 0; font-size:10px; }
         .secretary-school-detail dt { color:#8491a7; }
         .secretary-school-detail dd { color:#243253; font-weight:600; }
         .secretary-priority { display:inline-flex; border-radius:20px; padding:4px 7px; color:#687791; background:#f1f4f8; font:9px 'DM Mono',monospace; text-transform:uppercase; white-space:nowrap; }
         .secretary-priority.is-high { color:#a24f3d; background:#fff0eb; }
         .secretary-priority.is-medium { color:#9b6d13; background:#fff4d5; }
         .secretary-network-locked { padding:12px; border:1px dashed #cbd8ea; border-radius:10px; color:#74839a; background:#fbfcff; font-size:10px; line-height:1.45; }
         .secretary-network-search-results { display:grid; gap:7px; margin-top:12px; }
         .secretary-network-search-result { display:block; width:100%; padding:10px; border:1px solid #e2e9f3; border-radius:9px; color:#243253; background:#fff; text-align:left; }
         .secretary-network-search-result:hover { border-color:#79a5e8; background:#f7faff; }
         .secretary-network-search-result strong, .secretary-network-search-result span { display:block; }
         .secretary-network-search-result span { margin-top:3px; color:#8491a7; font-size:9px; }
         .secretary-report-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
         .secretary-workspace { display:grid; grid-template-columns:214px minmax(0,1fr); gap:18px; align-items:start; }
         .secretary-sidebar { position:sticky; top:86px; display:grid; gap:15px; padding:14px; border:1px solid #dce7f6; border-radius:15px; background:#fff; box-shadow:0 8px 22px rgba(43,67,115,.045); }
         .secretary-sidebar-head { display:flex; align-items:center; gap:9px; padding:2px 3px 4px; }
         .secretary-sidebar-mark { display:grid; place-items:center; width:31px; height:31px; border-radius:10px; color:#fff; background:linear-gradient(145deg,#10295f,#1769d2); font-size:14px; }
         .secretary-sidebar-head strong { display:block; color:#243253; font-size:11px; }
         .secretary-sidebar-head span { display:block; margin-top:2px; color:#8491a7; font-size:8px; }
         .secretary-sidebar-group { display:grid; gap:3px; }
         .secretary-sidebar-label { padding:5px 8px; color:#9aa6b9; font:8px 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
         .secretary-sidebar-link { display:flex; align-items:center; justify-content:space-between; gap:6px; width:100%; border:1px solid transparent; border-radius:8px; padding:8px 9px; color:#63718e; background:transparent; font-size:10px; text-align:left; }
         .secretary-sidebar-link:hover, .secretary-sidebar-link.is-active { border-color:#d7e5ff; color:#1558dc; background:#edf3ff; }
         .secretary-sidebar-link.is-locked { color:#a8b2c2; cursor:not-allowed; }
         .secretary-sidebar-link small { color:inherit; font:8px 'DM Mono',monospace; }
         .secretary-module-main { min-width:0; }
         .secretary-module-header { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:14px; }
         .secretary-module-header h1 { margin-top:5px; color:#17233f; font-size:clamp(27px,3vw,37px); }
         .secretary-module-header p { max-width:670px; margin-top:7px; color:var(--muted); font-size:11px; line-height:1.45; }
         .secretary-module-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; align-items:center; gap:7px; }
         .secretary-header-search { display:flex; align-items:center; gap:6px; min-width:190px; border:1px solid #dce4f0; border-radius:9px; padding:8px 10px; color:#8290a8; background:#fff; }
         .secretary-header-search input { width:100%; min-width:0; border:0; outline:0; color:#243253; background:transparent; font:10px inherit; }
         .secretary-sidebar-toggle { display:none; border:1px solid #dce4f0; border-radius:9px; padding:9px 11px; color:#2563eb; background:#fff; font-size:10px; }
         .secretary-quick-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
         .secretary-quick-link { display:grid; gap:4px; min-height:71px; border:1px solid #dce7f6; border-radius:10px; padding:11px; color:#243253; background:#fbfcff; text-align:left; }
         .secretary-quick-link:hover { border-color:#79a5e8; background:#f7faff; }
         .secretary-quick-link strong { color:#243253; font-size:10px; }
         .secretary-quick-link span { color:#8491a7; font-size:9px; line-height:1.3; }
         .secretary-data-table-wrap { overflow:auto; border:1px solid #e2e9f3; border-radius:10px; }
         .secretary-data-table { width:100%; min-width:620px; border-collapse:collapse; font-size:10px; }
         .secretary-data-table th { padding:10px; color:#8491a7; background:#f7faff; font:8px 'DM Mono',monospace; letter-spacing:.04em; text-align:left; text-transform:uppercase; }
         .secretary-data-table td { padding:11px 10px; border-top:1px solid #edf1f6; color:#596a87; vertical-align:top; }
         .secretary-data-table td strong { color:#243253; font-size:10px; }
         .secretary-data-table td small { display:block; margin-top:3px; color:#8491a7; font-size:8px; }
         .secretary-entity-layout { display:grid; grid-template-columns:minmax(0,1.18fr) minmax(270px,.82fr); gap:18px; align-items:start; }
         .secretary-entity-list { display:grid; gap:7px; max-height:620px; overflow:auto; }
         .secretary-entity-row { display:grid; grid-template-columns:34px minmax(0,1fr) auto; gap:9px; align-items:center; width:100%; border:1px solid #e2e9f3; border-radius:10px; padding:10px; color:#243253; background:#fff; text-align:left; }
         .secretary-entity-row:hover, .secretary-entity-row.is-selected { border-color:#79a5e8; background:#f7faff; }
         .secretary-entity-avatar { display:grid; place-items:center; width:32px; height:32px; border-radius:9px; color:#1558dc; background:#eaf1ff; font:700 10px 'DM Mono',monospace; }
         .secretary-entity-row strong, .secretary-entity-row span { display:block; }
         .secretary-entity-row strong { color:#243253; font-size:10px; }
         .secretary-entity-row span { margin-top:3px; color:#8491a7; font-size:9px; }
         .secretary-entity-detail { position:sticky; top:86px; }
         .secretary-entity-detail dl { display:grid; grid-template-columns:105px 1fr; gap:8px; margin:14px 0; font-size:10px; }
         .secretary-entity-detail dt { color:#8491a7; }
         .secretary-entity-detail dd { color:#243253; font-weight:600; }
         .secretary-indicator-list { display:grid; gap:9px; }
         .secretary-indicator-row { display:grid; grid-template-columns:minmax(0,1fr) 145px 55px; gap:10px; align-items:center; padding:10px 0; border-top:1px solid #edf1f6; }
         .secretary-indicator-row:first-child { border-top:0; }
         .secretary-indicator-row strong { display:block; color:#243253; font-size:10px; }
         .secretary-indicator-row span { display:block; margin-top:3px; color:#8491a7; font-size:9px; }
         .secretary-indicator-bar { height:7px; border-radius:99px; background:#edf1f6; overflow:hidden; }
         .secretary-indicator-bar i { display:block; height:100%; width:var(--indicator-width,0%); border-radius:inherit; background:linear-gradient(90deg,#1558dc,#24b7a1); }
         .secretary-indicator-value { color:#1558dc; font:700 12px 'DM Sans',sans-serif; text-align:right; }
         @media (max-width:1000px) { .secretary-network-card-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .secretary-school-row { grid-template-columns:minmax(0,1.2fr) repeat(3,minmax(70px,.55fr)); } .secretary-school-row > button { grid-column:1 / -1; justify-self:start; } }
         @media (max-width:800px) { .secretary-workspace { display:block; } .secretary-sidebar { display:none; position:fixed; top:74px; right:14px; left:14px; z-index:20; max-height:calc(100vh - 160px); overflow:auto; box-shadow:0 18px 45px rgba(43,67,115,.2); } .secretary-sidebar.is-open { display:grid; } .secretary-sidebar-toggle { display:inline-flex; } .secretary-module-header { align-items:flex-start; flex-direction:column; } .secretary-module-actions { width:100%; justify-content:flex-start; } .secretary-header-search { flex:1; min-width:180px; } .secretary-quick-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .secretary-network-card-grid { gap:8px; } .secretary-network-card { min-height:112px; padding:12px; } .secretary-network-card strong { font-size:24px; } .secretary-network-grid, .secretary-entity-layout { grid-template-columns:1fr; } .secretary-school-detail, .secretary-entity-detail { position:static; } .secretary-school-row { grid-template-columns:1fr 1fr; gap:9px; } .secretary-school-row > div:first-child { grid-column:1 / -1; } .secretary-school-row > button { grid-column:1 / -1; width:100%; } .secretary-network-tabs { display:none; } .secretary-indicator-row { grid-template-columns:1fr 55px; } .secretary-indicator-bar { grid-column:1 / -1; order:3; } }
         @media (max-width:800px) { .secretary-hero { align-items:flex-start; flex-direction:column; } .secretary-actions { justify-content:flex-start; } .secretary-grid, .secretary-staff-layout { grid-template-columns:1fr; } .secretary-summary-grid { gap:8px; } .secretary-stat { padding:11px; } .secretary-stat strong { font-size:24px; } .secretary-option-grid, .secretary-form-grid { grid-template-columns:1fr; } .secretary-detail { position:static; } .secretary-service-card { align-items:flex-start; flex-wrap:wrap; } .secretary-service-card button { margin-left:54px; } }
       </style>
       <style>
         .experience-hero { display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:24px; }
         .experience-hero h1 { max-width:700px; }
         .experience-hero p { max-width:690px; color:var(--muted); font-size:12px; line-height:1.5; margin-top:9px; }
         .experience-tabs { display:flex; flex-wrap:wrap; gap:7px; margin:15px 0; }
         .experience-tab { border:1px solid #d4e4db; border-radius:22px; padding:9px 12px; color:#39725e; background:#f7fbf8; font-size:10px; }
         .experience-tab:hover, .experience-tab.is-active { color:#fff; background:var(--teal); border-color:var(--teal); }
         .experience-content { min-height:150px; }
         .experience-content h3 { color:var(--ink); font:600 24px 'Playfair Display',serif; }
         .experience-content > p { max-width:720px; color:var(--muted); font-size:12px; line-height:1.55; margin-top:8px; }
         .experience-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:17px; }
         .experience-card { padding:14px; border:1px solid #dcebe1; border-radius:12px; background:#fbfefc; }
         .experience-card strong { display:block; color:var(--teal-deep); font-size:11px; }
         .experience-card span { display:block; color:var(--muted); font-size:10px; line-height:1.45; margin-top:6px; }
         .birthday-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(205px,1fr)); gap:10px; margin-top:16px; }
         .birthday-card { display:flex; align-items:center; gap:11px; padding:12px; border:1px solid #f0deb2; border-radius:12px; background:#fffaf0; }
         .birthday-day { display:grid; place-items:center; flex:0 0 42px; height:42px; border-radius:12px; color:#9b6d13; background:#ffe9aa; font:700 18px 'DM Mono',monospace; }
         .birthday-card strong { display:block; color:#6c5324; font-size:11px; }
         .birthday-card span { display:block; color:#967b4a; font-size:9px; margin-top:4px; }
         .admin-student-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(330px,.95fr); gap:18px; align-items:start; }
         .admin-student-toolbar { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
         .admin-student-toolbar input, .admin-student-toolbar select { min-width:160px; flex:1; border:1px solid var(--line); border-radius:8px; padding:9px; color:var(--ink); background:#fff; font-size:10px; }
         .admin-student-list { display:grid; gap:8px; max-height:640px; overflow:auto; }
         .admin-student-row { display:grid; grid-template-columns:38px minmax(0,1fr) auto; gap:9px; align-items:center; padding:10px; border:1px solid var(--line); border-radius:10px; background:#fbfdfb; text-align:left; }
         .admin-student-row.is-selected { border-color:#79a996; background:#eff8f2; }
         .admin-student-row strong, .admin-student-row span { display:block; }
         .admin-student-row strong { color:var(--ink); font-size:11px; }
         .admin-student-row span { color:var(--muted); font-size:9px; margin-top:4px; }
          .admin-student-avatar { display:grid; place-items:center; width:32px; height:32px; border-radius:50%; color:#236451; background:#dcefe4; font-size:10px; font-weight:700; }
          .admin-student-avatar.has-photo { overflow:hidden; background:#eaf1ff; }
          .admin-student-avatar img { display:block; width:100%; height:100%; object-fit:cover; }
          .student-badge-photo { display:grid; place-items:center; width:86px; height:104px; overflow:hidden; border:1px solid #cfe3d9; border-radius:12px; background:#eaf6ef; color:#5c8c76; font-size:9px; text-align:center; }
          .student-badge-photo img { display:block; width:100%; height:100%; object-fit:cover; }
          .student-badge-identity { display:flex; align-items:center; gap:12px; grid-column:1 / -1; }
          .student-profile-summary { display:grid; grid-template-columns:92px minmax(0,1fr); gap:13px; align-items:start; margin-bottom:13px; padding:12px; border:1px solid #dbe7f3; border-radius:13px; background:linear-gradient(135deg,#f7fbff,#fff); }
          .student-profile-photo { display:grid; place-items:center; width:92px; height:112px; overflow:hidden; border:1px solid #dbe7f3; border-radius:12px; background:#edf4ff; color:#56749c; font-size:9px; text-align:center; }
          .student-profile-photo img { display:block; width:100%; height:100%; object-fit:cover; }
          .student-profile-summary h4 { margin:0; color:#172554; font-size:15px; }
          .student-profile-summary > div:last-child > p { margin-top:4px; color:#64748b; font-size:10px; line-height:1.45; }
          .student-profile-data { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px 12px; grid-column:1 / -1; padding-top:10px; border-top:1px solid #e7eef6; }
          .student-profile-data span { display:block; color:#8492a8; font-size:9px; }
          .student-profile-data strong { display:block; margin-top:2px; color:#263756; font-size:10px; font-weight:600; }
          .global-search-card { width:min(100%,720px); max-height:min(88vh,760px); overflow:auto; }
          .global-search-intro { margin-top:6px; color:var(--muted); font-size:11px; line-height:1.45; }
          .global-search-input { margin-top:16px; min-height:42px; }
          .global-search-filters { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px; }
          .global-search-filters select { width:100%; border:1px solid var(--line); border-radius:8px; padding:10px; color:var(--ink); background:#fff; font:inherit; }
          .global-search-results { display:grid; gap:8px; max-height:260px; overflow:auto; margin-top:14px; }
          .global-search-result { display:grid; grid-template-columns:38px minmax(0,1fr) auto; gap:10px; align-items:center; width:100%; padding:10px; border:1px solid var(--line); border-radius:11px; background:#fbfdff; color:var(--ink); text-align:left; }
          .global-search-result:hover, .global-search-result.is-selected { border-color:#9fc5ec; background:#edf5ff; }
          .global-search-result strong, .global-search-result span { display:block; }
          .global-search-result strong { font-size:11px; }
          .global-search-result span { margin-top:3px; color:var(--muted); font-size:9px; }
          .global-search-result > b { color:#2563eb; font-size:10px; }
          .global-student-profile { margin-top:14px; }
          .global-student-profile .student-profile-summary { margin-bottom:0; }
          .admin-student-form { display:grid; gap:10px; }
         .admin-student-form label { display:grid; gap:5px; color:var(--muted); font-size:10px; }
         .admin-student-form input, .admin-student-form select, .admin-student-form textarea { width:100%; border:1px solid var(--line); border-radius:8px; padding:9px; color:var(--ink); background:#fff; font:inherit; }
         .admin-student-form textarea { min-height:62px; resize:vertical; }
         .admin-student-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:9px; }
         .admin-program-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; }
         .admin-program-option { display:flex !important; align-items:center; gap:7px; padding:8px; border:1px solid var(--line); border-radius:8px; background:#fbfdfb; }
         .admin-program-option input { width:auto; accent-color:var(--teal); }
         .admin-photo-preview { width:88px; height:88px; object-fit:cover; border-radius:14px; border:1px solid #d4e4db; background:#eff8f2; }
         .gate-photo-wrap { display:grid; place-items:center; width:92px; height:92px; margin-bottom:10px; overflow:hidden; border:1px solid #cfe3d9; border-radius:14px; color:#5c8c76; background:#eaf6ef; font-size:9px; text-align:center; }
         .gate-student-photo { width:100%; height:100%; object-fit:cover; }
         .gate-visual-check { display:flex; align-items:flex-start; gap:7px; margin-top:10px; color:#6b5d45; font-size:10px; line-height:1.4; }
         .gate-visual-check input { flex:0 0 auto; margin-top:1px; accent-color:var(--teal); }
         @media (max-width:800px) { .experience-hero { align-items:flex-start; flex-direction:column; } .experience-grid, .admin-student-form-grid, .admin-program-grid { grid-template-columns:1fr; } .admin-student-layout { grid-template-columns:1fr; } }
        </style>
        <style id="bfr-visual-refresh">
          :root {
            --ink:#172033;
            --muted:#64748b;
            --line:#e2e8f0;
            --paper:#f8fafc;
            --white:#fff;
            --teal:#2563eb;
            --teal-deep:#172554;
            --mint:#ecfdf5;
            --coral:#ef4444;
            --sun:#facc15;
            --lavender:#f5f3ff;
            --shadow:0 12px 32px rgba(15,23,42,.06);
          }
          html { background:var(--paper); }
          body { color:var(--ink); background:var(--paper); }
          h1, h2, h3, .brand-name, .child-info strong, .metric-value strong { font-family:'DM Sans',sans-serif; }
          h1 { font-weight:800; letter-spacing:-.055em; }
          h2, h3 { letter-spacing:-.025em; }
          .app-shell { grid-template-columns:236px minmax(0,1fr); }
          .sidebar { background:#fff; color:#475569; border-right:1px solid var(--line); padding:22px 14px 18px; }
          .brand { color:var(--teal-deep); padding:0 10px 25px; }
          .brand-name { font-size:18px; font-weight:800; letter-spacing:-.04em; }
          .app-logo { border:1px solid var(--line); border-radius:12px; }
          .sidebar .eyebrow, .nav-label { color:#94a3b8; }
          .school-switch { margin:0 2px 24px; background:#f8fafc; border-color:#e2e8f0; }
          .school-switch strong { color:var(--teal-deep); }
          .school-switch span { color:#94a3b8; }
          .nav-item { color:#475569; border-radius:12px; padding:10px 12px; font-size:14px; }
          .nav-item:hover, .nav-item.active { color:#1d4ed8; background:#eff6ff; }
          .nav-icon { color:currentColor; }
          .sidebar-foot { border-color:var(--line); }
          .mini-person strong { color:var(--ink); }
          .mini-person span { color:var(--muted); }
          .logout-button { color:#64748b; border-color:var(--line); }
          .logout-button:hover { color:#1d4ed8; background:#eff6ff; }
          .topbar { height:72px; padding:0 38px; background:rgba(255,255,255,.92); border-color:var(--line); box-shadow:0 4px 18px rgba(15,23,42,.04); }
          .breadcrumb { color:#94a3b8; font-size:13px; }
          .breadcrumb b { color:var(--ink); }
          .role-toggle { background:#f1f5f9; }
          .role-toggle button.active { color:var(--teal); box-shadow:0 2px 8px rgba(15,23,42,.08); }
          .icon-button, .logout-top-button { border-color:var(--line); color:var(--teal); }
          .logout-top-button:hover { background:#eff6ff; }
          .content { padding:32px 38px 54px; max-width:1480px; }
          .welcome { margin-bottom:24px; }
          .welcome p { color:var(--muted); }
          .date-chip { color:#1d4ed8; background:#eff6ff; }
          .child-card { color:var(--ink); background:#fff; border:1px solid #dbeafe; box-shadow:var(--shadow); }
          .child-card:after { border-color:#dbeafe; box-shadow:0 0 0 25px rgba(37,99,235,.035),0 0 0 50px rgba(37,99,235,.02); }
          .child-info strong { font-size:18px; font-weight:750; }
          .child-info span { color:var(--muted); }
          .child-stat { border-color:var(--line); }
          .child-stat b { color:var(--teal); }
          .child-stat span { color:var(--muted); }
          .overview-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
          .metric-card, .panel, .teacher-metric { border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); }
          .metric-card { min-height:132px; padding:17px; position:relative; overflow:hidden; }
          .metric-card:before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--metric-color,var(--teal)); }
          .metric-card:nth-child(1) { --metric-color:#16a34a; }
          .metric-card:nth-child(2) { --metric-color:#2563eb; }
          .metric-card:nth-child(3) { --metric-color:#7c3aed; }
          .metric-card:nth-child(4) { --metric-color:#ef4444; }
          .metric-icon.mint { color:#16a34a; background:#ecfdf5; }
          .metric-icon.sun { color:#b45309; background:#fef3c7; }
          .metric-icon.lav { color:#7c3aed; background:#f5f3ff; }
          .metric-value strong { color:var(--metric-color,var(--teal)); font-size:30px; }
          .panel:hover, .metric-card:hover, .teacher-metric:hover, .side-highlight:hover { transform:translateY(-2px); box-shadow:0 16px 36px rgba(15,23,42,.1); border-color:#bfdbfe; }
          .panel-heading h2 { font-family:'DM Sans',sans-serif; font-weight:750; }
          .panel-heading a, .text-button { color:var(--teal); }
          .main-grid { gap:16px; }
          .activity-symbol.blue, .activity-symbol.coral, .activity-symbol.gold { background:#eff6ff; color:var(--teal); }
          .primary-button { background:var(--teal) !important; border-radius:10px; box-shadow:0 8px 18px rgba(37,99,235,.2); }
          .primary-button:hover { background:#1d4ed8 !important; }
          .side-highlight { background:linear-gradient(135deg,#2563eb,#4f46e5); }
          .date-chip, .agenda-count { border-radius:999px; }
          .occurrence-panel { border-color:#fecaca; }
          .occurrence-status { color:#dc2626; background:#fef2f2; }
          .login-screen { padding:18px; background:#f8fafc; }
          .login-card { width:min(1180px,100%); padding:0; background:transparent; border:0; box-shadow:none; }
          .login-brand { display:none; }
          .login-layout { min-height:620px; grid-template-columns:1.05fr .95fr; border-radius:24px; background:#fff; box-shadow:0 24px 70px rgba(23,37,84,.16); }
          .login-message { display:flex; flex-direction:column; padding:62px 60px; background:linear-gradient(145deg,#172554 0%,#1d4ed8 62%,#4f46e5 100%); }
          .login-message .eyebrow { color:#bfdbfe; }
          .login-message > .eyebrow { order:1; font-size:11px; }
          .login-message h1 { order:2; max-width:430px; font-size:clamp(42px,4.8vw,64px); line-height:1.02; }
          .login-message > p { order:3; color:#dbeafe; font-size:14px; }
            .login-message > .school-symbol-wrap { order:4; width:260px; height:158px; margin:28px 0 0; padding:0; border:1px solid rgba(255,255,255,.35); border-radius:18px; background:#fff url('bfr-app-logo.webp') center/contain no-repeat; box-shadow:0 18px 34px rgba(8,24,75,.2); }
          .school-symbol-wrap .school-symbol, .school-symbol-wrap span { display:none; }
          .login-message:before { width:330px; height:330px; right:-100px; top:40px; border:1px solid rgba(255,255,255,.2); background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.25) 0 3px,transparent 4px),radial-gradient(circle at 70% 60%,rgba(255,255,255,.18) 0 4px,transparent 5px); opacity:.8; }
          .login-message:after { right:-90px; bottom:-170px; border-color:rgba(255,255,255,.24); }
          .login-message > * { position:relative; z-index:1; }
          .school-symbol { border-radius:14px; }
           .login-benefits { order:5; margin-top:auto; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; font-size:12px; }
           .login-benefits > span { display:flex !important; align-items:center; min-height:54px; padding:9px 10px; border:1px solid rgba(255,255,255,.2); border-radius:13px; background:rgba(255,255,255,.09); color:#e0e7ff; transition:transform .2s ease,background .2s ease,border-color .2s ease; }
           .login-benefits > span:hover { transform:translateY(-3px); background:rgba(255,255,255,.16); border-color:rgba(255,255,255,.4); }
           .login-benefits > span > span { display:block !important; min-width:0; }
           .login-benefits strong, .login-benefits small { display:block; }
           .login-benefits strong { color:#fff; font-size:12px; line-height:1.15; }
           .login-benefits small { margin-top:3px; color:#c7d2fe; font-size:10px; line-height:1.2; }
          .login-benefits b { display:grid; place-items:center; flex:0 0 30px; width:30px; height:30px; margin-right:8px; border:0; border-radius:9px; background:rgba(255,255,255,.18); color:#fff; font-size:0; }
          .login-benefits b:after { font-size:15px; font-weight:800; }
          .login-benefits span:nth-child(1) b:after { content:'✓'; }
          .login-benefits span:nth-child(2) b:after { content:'⌁'; }
          .login-benefits span:nth-child(3) b:after { content:'◈'; }
           .login-form { padding:64px 58px; }
           .login-product-logo { display:block; width:min(100%,445px); max-height:445px; aspect-ratio:1; object-fit:contain; align-self:center; margin:0 auto 18px; }
          .login-form h2 { font-family:'DM Sans',sans-serif; font-size:32px; font-weight:800; }
          .login-form > p { color:var(--muted); font-size:14px; }
          .google-button { background:#fff !important; border-color:#cbd5e1; color:var(--ink) !important; border-radius:12px; box-shadow:0 5px 16px rgba(15,23,42,.06); font-size:14px; padding:14px; }
          .google-button:hover { border-color:var(--teal); background:#eff6ff !important; }
          .login-privacy { color:#94a3b8; font-size:11px; }
          .schedule-public-button { display:flex; align-items:center; justify-content:space-between; width:100%; margin-top:18px; padding:14px 15px; border:1px solid #bfdbfe; border-radius:12px; background:#eff6ff; color:#1d4ed8; font-size:14px; }
          .schedule-public-button:hover { background:#dbeafe; }
          .mobile-more-menu { border:1px solid var(--line); box-shadow:0 22px 50px rgba(15,23,42,.18); }
          :focus-visible { outline:3px solid rgba(37,99,235,.28); outline-offset:2px; }
          @media (max-width:1050px) {
            .app-shell { grid-template-columns:208px minmax(0,1fr); }
            .topbar, .content { padding-left:28px; padding-right:28px; }
