  "funcoes": [
    {
      "nome": "bfr_subject_matches",
      "args": "p_schedule_subject text, p_requested_subject text",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_subject_matches(p_schedule_subject text, p_requested_subject text)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\nAS $function$\n  select lower(trim(coalesce(p_schedule_subject,'')))=lower(trim(coalesce(p_requested_subject,'')))\n    or (lower(trim(p_schedule_subject))='português' and lower(trim(p_requested_subject))='língua portuguesa')\n    or (lower(trim(p_schedule_subject))='inglês' and lower(trim(p_requested_subject))='língua inglesa')\n    or (lower(trim(p_schedule_subject))='artes' and lower(trim(p_requested_subject))='arte')\n$function$\n"
    }
  ],
