  "ok_nomeado": "selecao do utilizador 18/11: «DDL municipal + calendario» (ferramenta de escolha) — as tres pecas (a)(b)(c)",
  "pecas": {
    "b": "ALTER VIEW public.bfr_municipal_school_stats SET (security_invoker = true);",
    "c": "REVOKE EXECUTE ON FUNCTION public.bfr_municipal_network_totals() FROM PUBLIC, anon;\nREVOKE EXECUTE ON FUNCTION public.bfr_has_municipal_grant(uuid) FROM PUBLIC, anon;"
  },
  "aviso_de_redacao": "o REVOKE nomeia PUBLIC e anon; só `FROM anon` deixava o privilégio herdado de PUBLIC no sítio",
  "reversao_planeada": {
    "vista": "ALTER VIEW public.bfr_municipal_school_stats RESET (security_invoker); — RESET devolve reloptions a NULL, o estado medido antes; SET false deixaria {security_invoker=false} no catálogo",
    "funcoes": [
      "GRANT EXECUTE ON FUNCTION public.bfr_municipal_network_totals() TO PUBLIC, anon;",
      "GRANT EXECUTE ON FUNCTION public.bfr_has_municipal_grant(uuid) TO PUBLIC, anon;"
    ]
  },
  "vista": {
    "nome": "bfr_municipal_school_stats",
    "modo": "sem-opcao-null",
    "reloptions": null,
    "dono": "postgres",
    "dono_bypassrls": true,
    "acl": "postgres=arwdDxtm/postgres | anon=arwdDxtm/postgres | authenticated=arwdDxtm/postgres | service_role=arwdDxtm/postgres",
    "anon_sel": true,
    "auth_sel": true,
    "def": " SELECT id AS school_id,\n    name AS school_name,\n    city,\n    zone,\n    operating_status,\n    municipality_id,\n    ( SELECT count(*)::integer AS count\n           FROM students st\n          WHERE st.school_id = s.id) AS students_total,\n    ( SELECT count(*)::integer AS count\n           FROM classes cl\n          WHERE cl.school_id = s.id) AS classes_total,\n    ( SELECT count(*)::integer AS count\n           FROM bfr_school_key_map m\n             JOIN staff_schools ss ON ss.school_id = m.sports_school_id\n          WHERE m.school_id = s.id) AS staff_links_total\n   FROM schools s\n  WHERE bfr_school_in_municipal_scope(id) OR bfr_is_platform_admin();"
  },
