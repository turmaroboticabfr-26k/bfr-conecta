  "funcoes": [
    {
      "nome": "bfr_is_education_supervisor",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_is_education_supervisor()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT COALESCE(\n    (SELECT true FROM public.profiles \n     WHERE id = auth.uid() AND role = 'education_supervisor'::account_role),\n    false\n  );\n$function$\n"
    },
    {
      "nome": "bfr_is_schedule_manager",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_is_schedule_manager()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select coalesce(public.current_role()::text in ('developer','coordinator','director','secretary'),false)\n$function$\n"
    },
    {
      "nome": "bfr_pedagogical_can_manage_student",
      "args": "p_student_id uuid, p_subject text",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_pedagogical_can_manage_student(p_student_id uuid, p_subject text DEFAULT NULL::text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1\n    from public.students s\n    join public.bfr_teacher_class_subjects link\n      on link.class_id = s.class_id\n     and link.profile_id = auth.uid()\n     and link.active\n    where s.id = p_student_id\n      and s.active\n      and (\n        p_subject is null\n        or public.bfr_subject_matches(link.subject, p_subject)\n      )\n  )\n$function$\n"
    },
    {
      "nome": "bfr_teacher_can_manage_student",
      "args": "p_student_id uuid, p_subject text",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_teacher_can_manage_student(p_student_id uuid, p_subject text DEFAULT NULL::text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1 from public.students s\n    join public.bfr_schedule_entries e on e.class_id=s.class_id\n    join public.bfr_schedule_versions v on v.id=e.version_id and v.status='published'\n    join public.bfr_teacher_directory t on t.id=e.teacher_id and t.profile_id=auth.uid() and t.active\n    where s.id=p_student_id and s.active\n      and (p_subject is null or public.bfr_subject_matches(e.subject_name,p_subject))\n  )\n$function$\n"
    },
    {
      "nome": "is_aee",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.is_aee()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n                    select coalesce(public.current_role() = 'aee', false)\r\n                    $function$\n"
    }
  ],
