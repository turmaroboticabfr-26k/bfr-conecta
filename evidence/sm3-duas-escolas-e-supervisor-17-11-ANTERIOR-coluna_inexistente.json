     "funcao": "is_developer",
     "definicao": "CREATE OR REPLACE FUNCTION public.is_developer()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$ select coalesce(public.current_role() = 'developer', false) $function$\n"
