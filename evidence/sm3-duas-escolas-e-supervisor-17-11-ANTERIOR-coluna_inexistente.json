     "definicao": "CREATE OR REPLACE FUNCTION public.bfr_is_education_supervisor()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT COALESCE(\n    (SELECT true FROM public.profiles \n     WHERE id = auth.uid() AND role = 'education_supervisor'::account_role),\n    false\n  );\n$function$\n"
    },
    {
     "funcao": "bfr_rls_is_developer",
     "definicao": "CREATE OR REPLACE FUNCTION public.bfr_rls_is_developer()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  -- Delega na função viva: a resposta é a mesma; o que muda é que quem chama o wrapper não precisa de\n  -- privilégio nenhum sobre a função interior.\n  select coalesce(public.is_developer(), false)\n$function$\n"
    },
    {
     "funcao": "bfr_rls_session_role",
     "definicao": "CREATE OR REPLACE FUNCTION public.bfr_rls_session_role()\n RETURNS account_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  -- Responde o mesmo que public.\"current_role\"() (que já é SECURITY DEFINER e faz exactamente isto):\n  -- para o anon, auth.uid() é NULL → 0 linhas → NULL, e a qualificação fica falsa por lógica própria\n  -- em vez de por 42501.\n  select role from public.profiles where id = auth.uid()\n$function$\n"
    },
    {
     "funcao": "current_role",
     "definicao": "CREATE OR REPLACE FUNCTION public.\"current_role\"()\n RETURNS account_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$ select role from public.profiles where id = auth.uid() $function$\n"
    },
