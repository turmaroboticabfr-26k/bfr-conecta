   director_dashboard_read_profiles: (("current_role"())::text = 'director'::text)
   profiles_chat_staff_directory_read: (internal_chat_is_staff() AND (role = ANY (ARRAY['pedagogical'::account_role, 'aee'::account_role, 'coordinator'::account_role, 'director'::account_role, 'secretary'::account_role, 'developer'::account_role])))
   profiles_hide_test_accounts: ((id = auth.uid()) OR ((email !~~ '%@bfr-conecta.test'::text) AND (email !~~ 'bfr.qa.email.%'::text)))
   profiles_read: ((id = auth.uid()) OR is_developer() OR bfr_profile_in_my_schools(id))
   profiles_staff_update: is_developer()
   profiles_update_self: (id = auth.uid())

