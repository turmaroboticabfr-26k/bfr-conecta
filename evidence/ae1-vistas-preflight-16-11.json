      "relname": "sports_public_athletes",
      "def": " SELECT id,\n    team_id,\n    name,\n    jersey_number,\n    \"position\",\n    status\n   FROM sports_athletes\n  WHERE sports_role_allowed(ARRAY['developer'::text, 'director'::text, 'coordinator'::text, 'secretary'::text, 'pedagogical'::text, 'aee'::text]);",
      "anon_sel": "false",
      "auth_sel": "true",
      "modo": "sem-opcao",
      "base": "public.sports_public_athletes"
    },
    {
      "relname": "sports_public_match_events",
      "def": " SELECT id,\n    match_id,\n    team_id,\n    athlete_id,\n    event_type,\n    points,\n    period,\n    clock_seconds,\n    description,\n    created_at\n   FROM sports_match_events\n  WHERE sports_role_allowed(ARRAY['developer'::text, 'director'::text, 'coordinator'::text]);",
      "anon_sel": "false",
      "auth_sel": "true",
      "modo": "sem-opcao",
      "base": "public.sports_public_match_events"
    },
    {
      "relname": "sports_public_matches",
      "def": " SELECT id,\n    championship_id,\n    sport,\n    category,\n    gender,\n    home_team_id,\n    away_team_id,\n    scheduled_at,\n    venue,\n    phase,\n    status,\n    home_score,\n    away_score,\n    period,\n    clock_seconds,\n    started_at,\n    finished_at\n   FROM sports_matches\n  WHERE sports_role_allowed(ARRAY['developer'::text, 'director'::text, 'coordinator'::text, 'secretary'::text, 'pedagogical'::text, 'aee'::text]);",
      "anon_sel": "false",
      "auth_sel": "true",
      "modo": "sem-opcao",
      "base": "public.sports_public_matches"
    },
    {
      "relname": "sports_public_schools",
      "def": " SELECT id,\n    name,\n    city,\n    logo_url\n   FROM sports_schools\n  WHERE sports_role_allowed(ARRAY['developer'::text, 'director'::text, 'coordinator'::text, 'secretary'::text]);",
      "anon_sel": "false",
      "auth_sel": "true",
      "modo": "sem-opcao",
      "base": "public.sports_public_schools"
    },
    {
      "relname": "sports_public_teams",
      "def": " SELECT t.id,\n    t.school_id,\n    s.name AS school_name,\n    t.name,\n    t.sport,\n    t.category,\n    t.gender,\n    t.crest_url,\n    t.active\n   FROM (sports_teams t\n     JOIN sports_schools s ON ((s.id = t.school_id)))\n  WHERE (bfr_is_schedule_manager() OR is_staff());",
      "anon_sel": "false",
      "auth_sel": "true",
      "modo": "sem-opcao",
      "base": "public.sports_public_teams"
    }
