    "trigger_fns": [
      {
        "proname": "bfr_supervision_audit_log",
        "def": "CREATE OR REPLACE FUNCTION public.bfr_supervision_audit_log()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  v_id uuid := coalesce(new.id, old.id);\nbegin\n  insert into public.supervision_audit (profile_id, action, entity_type, entity_id, detail)\n  values (coalesce(auth.uid(), new.created_by), tg_op, tg_table_name, v_id,\n          jsonb_build_object('em', now()));\n  return coalesce(new, old);\nend $function$\n"
      },
      {
        "proname": "bfr_supervision_response_notify",
        "def": "CREATE OR REPLACE FUNCTION public.bfr_supervision_response_notify()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  update public.supervision_requests\n     set status = 'Respondida', updated_at = now()\n   where id = new.request_id\n     and status in ('Pendente de resposta','Aguardando complementação','Prazo vencido');\n  return new;\nend $function$\n"
      },
      {
        "proname": "staff_schools_updated_at",
        "def": "CREATE OR REPLACE FUNCTION public.staff_schools_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
      }
    ],
