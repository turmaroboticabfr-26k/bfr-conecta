  "funcoes": [
    {
      "nome": "bfr_is_schedule_manager",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_is_schedule_manager()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select coalesce(public.current_role()::text in ('developer','coordinator','director','secretary'),false)\n$function$\n"
    },
    {
      "nome": "bfr_rls_director_manages_student",
      "args": "p_student_id uuid",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_rls_director_manages_student(p_student_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  -- Corpo = o EXISTS vivo de occurrences_director_select (lido do catálogo), só com\n  -- occurrences.student_id trocado pelo parâmetro. O SELECT em staff_schools passa a ser feito pelo\n  -- dono da função, por isso a policy deixa de precisar de privilégio sobre ela.\n  select EXISTS ( SELECT 1\n   FROM ((profiles p\n     JOIN staff_schools ss ON ((ss.profile_id = p.id)))\n     JOIN students st ON ((st.school_id = ss.school_id)))\n  WHERE ((p.id = auth.uid()) AND (p.role = 'director'::account_role) AND (st.id = p_student_id)))\n$function$\n"
    },
    {
      "nome": "bfr_rls_is_developer",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_rls_is_developer()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  -- Delega na função viva: a resposta é a mesma; o que muda é que quem chama o wrapper não precisa de\n  -- privilégio nenhum sobre a função interior.\n  select coalesce(public.is_developer(), false)\n$function$\n"
    },
    {
      "nome": "bfr_rls_session_role",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_rls_session_role()\n RETURNS account_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  -- Responde o mesmo que public.\"current_role\"() (que já é SECURITY DEFINER e faz exactamente isto):\n  -- para o anon, auth.uid() é NULL → 0 linhas → NULL, e a qualificação fica falsa por lógica própria\n  -- em vez de por 42501.\n  select role from public.profiles where id = auth.uid()\n$function$\n"
    },
    {
      "nome": "bfr_staff_can_manage_student_scope",
      "args": "p_student_id uuid, p_subject text",
      "def": "CREATE OR REPLACE FUNCTION public.bfr_staff_can_manage_student_scope(p_student_id uuid, p_subject text DEFAULT NULL::text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select (\n    (\n      public.bfr_is_schedule_manager()\n      and public.current_role()::text <> 'pedagogical'\n    )\n    or (\n      public.current_role()::text = 'pedagogical'\n      and public.bfr_pedagogical_can_manage_student(p_student_id, p_subject)\n    )\n    or (\n      public.is_aee()\n      and public.bfr_teacher_can_manage_student(p_student_id, p_subject)\n    )\n  )\n$function$\n"
    },
    {
      "nome": "current_role",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.\"current_role\"()\n RETURNS account_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$ select role from public.profiles where id = auth.uid() $function$\n"
    },
    {
      "nome": "is_developer",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.is_developer()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$ select coalesce(public.current_role() = 'developer', false) $function$\n"
    },
    {
      "nome": "is_staff",
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.is_staff()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n                  select coalesce(public.current_role() in ('pedagogical','aee','developer'), false)\r\n                  $function$\n"
    },
    {
      "nome": "sports_role_allowed",
      "args": "allowed_roles text[]",
      "def": "CREATE OR REPLACE FUNCTION public.sports_role_allowed(allowed_roles text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1 from public.profiles\n     where id = auth.uid() and role::text = any(allowed_roles)\n  );\n$function$\n"
    }
  ],
